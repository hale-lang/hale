{
  "uid": "hale-containers",
  "title": "Containers",
  "description": "What runs where: every container on the habitat's machines, as their container exporters read them.",
  "tags": [
    "habitat"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "habitat-senses"
        },
        "query": {
          "query": "label_values(container_last_seen{job=\"containers\"}, host)",
          "refId": "hosts"
        },
        "definition": "label_values(container_last_seen{job=\"containers\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Hosts",
      "type": "link",
      "url": "/grafana/d/hale-hosts"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running",
      "description": "Containers each machine runs now, as its container exporter last saw them.",
      "datasource": {
        "type": "prometheus",
        "uid": "habitat-senses"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "count by (host) (container_last_seen{job=\"containers\", host=~\"$host\", name!=\"\"})",
          "legendFormat": "{{host}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Running now",
      "description": "What runs where: each container with its compose project and service (a habitat's project and an organism's role), its image, and how long it has been up.",
      "datasource": {
        "type": "prometheus",
        "uid": "habitat-senses"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "max by (host, container_label_com_docker_compose_project, container_label_com_docker_compose_service, name, image) (time() - container_start_time_seconds{job=\"containers\", host=~\"$host\", name!=\"\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "container_label_com_docker_compose_project": 1,
              "container_label_com_docker_compose_service": 2,
              "name": 3,
              "image": 4,
              "Value": 5
            },
            "renameByName": {
              "container_label_com_docker_compose_project": "project",
              "container_label_com_docker_compose_service": "service",
              "name": "container",
              "Value": "up for"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "host"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU",
      "description": "Cores each container keeps busy (1 = one core).",
      "datasource": {
        "type": "prometheus",
        "uid": "habitat-senses"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "sum by (host, name) (rate(container_cpu_usage_seconds_total{job=\"containers\", host=~\"$host\", name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory",
      "description": "Each container's working set: what the kernel would not reclaim from it.",
      "datasource": {
        "type": "prometheus",
        "uid": "habitat-senses"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "max by (host, name) (container_memory_working_set_bytes{job=\"containers\", host=~\"$host\", name!=\"\"})",
          "legendFormat": "{{host}} {{name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network",
      "description": "In above the line, out below. A container on its host's network shows none of its own.",
      "datasource": {
        "type": "prometheus",
        "uid": "habitat-senses"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "sum by (host, name) (rate(container_network_receive_bytes_total{job=\"containers\", host=~\"$host\", name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{name}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "-sum by (host, name) (rate(container_network_transmit_bytes_total{job=\"containers\", host=~\"$host\", name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{name}} out"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Restarts and OOM kills in the window",
      "description": "Containers that started again, or that the kernel killed for memory, within the dashboard's time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "habitat-senses"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "sum by (host, name) (changes(container_start_time_seconds{job=\"containers\", host=~\"$host\", name!=\"\"}[$__range])) > 0",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "habitat-senses"
          },
          "expr": "sum by (host, name) (increase(container_oom_events_total{job=\"containers\", host=~\"$host\", name!=\"\"}[$__range])) > 0",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "container",
              "Value #A": "restarts",
              "Value #B": "OOM kills"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          },
          "decimals": 0
        },
        "overrides": []
      }
    }
  ]
}
