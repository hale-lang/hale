// dna/operations/memory_tail.hl — the record applied into memory (GH #583
// K1). It lives in operations, not the core, and runs on the host's tick
// (GH #985). Any number of projectors may run it over one record at once
// (GH #1026): each record row is one transaction that moves the stamp by
// compare-and-swap before its effects, so they converge on one graph.
//
// The projection is a CONSUMER of the record: it reads `knowledge.*` rows
// from the store's watermark on, resolves each ratified digest to its
// receipt (the canonical document), and upserts by digest. Git is the
// sole authority: nothing in the store becomes ratified except from a
// `knowledge.ratified` row, and after a crash the tail resumes from
// the watermark and converges. The proposed and declined tiers are
// kept too, so the graph shows what was asked and what was refused.

type ProjectionApplied {
    rows: Int = 0; // rows walked by this projector (a row that failed among them)
    ratified: Int = 0;
    proposed: Int = 0;
    declined: Int = 0;
    retired: Int = 0; // ideas retired by a ratified supersession (GH #596 C)
    structure: Int = 0; // structure rows projected (K3)
    signals: Int = 0; // pressure and concern rows projected (K3)
    watermark: Int = 0; // the next seq to apply
    yielded: Bool = false; // another projector was past this one; it stopped
    error: String = "";
}

// The document a digest names, as an Idea whose id IS the digest.
fn idea_of(digest: String, doc: String, provenance: String, accepted: Bool, revision: Int) -> dna::Idea {
    return dna::Idea {
        id: digest,
        kind: dna::native_json_string(doc, "kind"),
        text: dna::native_json_string(doc, "text"),
        author: dna::native_json_string(doc, "author"),
        provenance: provenance, revision: revision, accepted: accepted,
        name: dna::native_json_string(doc, "name"),
        supersedes: dna::native_json_string(doc, "supersedes")
    };
}

// Apply the record's rows from the store's watermark to the record's end,
// one transaction per row: the stamp moves first, by compare-and-swap,
// then the row's effects, then both land together. A row another
// projector is already past ends this pass (`yielded`), having written
// nothing; a row whose effects fail lands nothing, and the next pass
// begins it again. Bounded by the record.
@unbounded
fn apply_record(store: dna::KnowledgeStore, j: dna::Journal, receipts: dna::Receipts) -> ProjectionApplied {
    let mut out = ProjectionApplied { watermark: store.watermark() };
    let n = j.revision();
    let mut i = out.watermark;
    while i < n {
        let e = j.read(i);
        let prev = if i == 0 { "" } else { j.read(i - 1).digest };
        let won = store.begin_row(i, prev, e.digest);
        if won < 0 { out.error = store.last_error(); return out; }
        if won == 0 { out.yielded = true; return out; }
        out.rows = out.rows + 1;
        let r = apply_row(store, j, receipts, e, i);
        if len(r.error) > 0 { store.abort_row(); out.error = r.error; return out; }
        if !store.commit_row() { out.error = store.last_error(); return out; }
        out.ratified = out.ratified + r.ratified;
        out.proposed = out.proposed + r.proposed;
        out.declined = out.declined + r.declined;
        out.retired = out.retired + r.retired;
        out.structure = out.structure + r.structure;
        out.signals = out.signals + r.signals;
        i = i + 1;
        out.watermark = i;
    }
    return out;
}

// One record row's effects on the graph, inside the row's transaction.
@unbounded
fn apply_row(store: dna::KnowledgeStore, j: dna::Journal, receipts: dna::Receipts, e: dna::Event, i: Int) -> ProjectionApplied {
    let mut out = ProjectionApplied { };
    // K3: the code's structure as the record observed it (init's
    // rows: loci, topics, bindings, effect classes, claims), keyed by
    // kind and name, the latest row winning; and the operational
    // signals, counted per (kind, source, what)
    if e.kind == "structure.observed" {
        let kind = std::json::find_string_field(e.body, "kind");
        let name = std::json::find_string_field(e.body, "name");
        let colon = std::str::index_of(e.entity, ":");
        let named = if len(name) > 0 { name } else if colon >= 0 { e.entity[(colon + 1)..len(e.entity)] } else { e.entity };
        if !store.put_structure(if len(kind) > 0 { kind } else { "row" }, named, i, e.body) { out.error = store.last_error(); return out; }
        out.structure = out.structure + 1;
    }
    if e.kind == "pressure.raised" || e.kind == "concern.raised" {
        // A concern is a row of its own (GH #689 review): its words are
        // a field, not the part of a sentence before " x". Pressure is
        // still `<what> x<n>`, and so is a concern from before that
        // rule, which carries no field to read.
        let named = if e.kind == "concern.raised" { dna::concern_what(e.body) } else { "" };
        let x = std::str::index_of(e.body, " x");
        let what = if len(named) > 0 { named } else if x > 0 { e.body[0..x] } else { e.body };
        if !store.put_signal(e.kind[0..(len(e.kind) - 7)], e.entity, what, i) { out.error = store.last_error(); return out; }
        out.signals = out.signals + 1;
    }
    if e.kind == "knowledge.ratified" || e.kind == "knowledge.proposed" || e.kind == "knowledge.declined" {
        let digest = e.entity;
        let raw = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
        let doc = receipts.read(raw);
        if len(doc) == 0 && redacted_in(j, digest) {
            // GH #606: a redacted receipt is an idea with no body left —
            // retired, never an error that stops the whole projection
            if !store.retire(digest, i) { out.error = store.last_error(); return out; }
            out.retired = out.retired + 1;
            return out;
        }
        if len(doc) == 0 {
            out.error = "no receipt for " + digest + " (row " + to_string(i) + ")";
            return out;
        }
        let target = dna::native_json_string(doc, "target");
        let class = std::json::find_string_field(e.body, "class");
        if e.kind == "knowledge.ratified" {
            // a retirement proposal carries no idea of its own: its
            // effect is the `knowledge.retired` row that follows
            if dna::native_json_string(doc, "kind") != "retirement" {
                if !store.upsert(idea_of(digest, doc, "ratified", true, i), i) { out.error = store.last_error(); return out; }
                if !store.bind(dna::KnowledgeBinding { idea: digest, target: target, author: dna::native_json_string(doc, "author"), class: class }) { out.error = store.last_error(); return out; }
            }
            out.ratified = out.ratified + 1;
        } else if e.kind == "knowledge.proposed" {
            let have = store.idea(digest);
            // a proposal never overwrites its own ratification (replay order is the record's, but be safe)
            if !have.present || !have.idea.accepted {
                if !store.upsert(idea_of(digest, doc, "proposed", false, i), 0) { out.error = store.last_error(); return out; }
            }
            out.proposed = out.proposed + 1;
        } else {
            let have = store.idea(digest);
            if !have.present || !have.idea.accepted {
                if !store.upsert(idea_of(digest, doc, "declined", false, i), 0) { out.error = store.last_error(); return out; }
            }
            out.declined = out.declined + 1;
        }
    }
    // GH #596 C: a retired idea leaves every package; the row is
    // the Board's decision, appended when a superseding proposal
    // was ratified
    if e.kind == "knowledge.retired" {
        if !store.retire(e.entity, i) { out.error = store.last_error(); return out; }
        out.retired = out.retired + 1;
    }
    if e.kind == "knowledge.edge.linked" || e.kind == "knowledge.edge.unlinked" {
        // Admission committed the effect and its exact command together.
        // The graph is only a projection: validate the whole fact before
        // applying, and replay the same tuple if a crash lost the watermark.
        // Receipt restrictions remain the graph reader's policy; projecting
        // an edge never independently makes either endpoint visible.
        let codec = KnowledgeCommandCodec { };
        let fact = codec.decode_fact(e);
        if !fact.valid || fact.context.application_id != j.read(0).digest {
            out.error = "invalid knowledge edge fact (row " + to_string(i) + ")";
            return out;
        }
        let c = fact.command;
        let edge = dna::KnowledgeEdge { from: c.from_id, to: c.to_id, rel: c.rel };
        let applied = if e.kind == "knowledge.edge.linked" { store.link(edge) } else { store.unlink(edge) };
        if !applied {
            let error = store.last_error();
            out.error = if len(error) > 0 { error } else { "knowledge edge projection failed (row " + to_string(i) + ")" };
            return out;
        }
    }
    if e.kind == "knowledge.binding.bound" || e.kind == "knowledge.binding.unbound" {
        let codec = dna::KnowledgeBindingCodec { }; let outer = KnowledgeBindingCommandCodec { };
        let effect = codec.effect_of(j, e); let r = effect.request;
        let incoming = codec.fact(j, "knowledge.binding.requested", r.request_id, e.seq);
        let admitted = outer.decode_fact(incoming);
        if !effect.ok || !admitted.valid || admitted.context.application_id != j.read(0).digest || codec.started(admitted.binding) != codec.started(r) {
            out.error = "invalid knowledge binding effect (row " + to_string(i) + ")"; return out;
        }
        let basis = codec.basis(j, receipts, r, e.seq);
        if !basis.ok || basis.event_id != r.binding_basis {
            out.error = "invalid knowledge binding basis (row " + to_string(i) + ")"; return out;
        }
        let subject = codec.subject_at(j, receipts, r.idea_id, e.seq);
        if !subject.ok || !subject.ratified || (e.kind == "knowledge.binding.bound" && !subject.active) {
            out.error = "invalid knowledge binding subject (row " + to_string(i) + ")"; return out;
        }
        let binding = dna::KnowledgeBinding { idea: r.idea_id, target: r.target, author: r.author, class: dna::classify_binding(r.author, r.target) };
        let applied = if e.kind == "knowledge.binding.bound" { store.bind(binding) } else { store.unbind(binding) };
        if !applied { out.error = "knowledge binding projection failed (row " + to_string(i) + ")"; return out; }
    }
    if e.kind == "knowledge.edge.reviewed_linked" || e.kind == "knowledge.edge.reviewed_unlinked" {
        let codec = dna::KnowledgeEdgeCodec { }; let outer = KnowledgeEdgeCommandCodec { }; let direct = StrictKnowledgeDirectEdgeFacts { };
        let effect = codec.effect_of(j, e); let r = effect.request;
        let incoming = codec.fact(j, "knowledge.edge.requested", r.request_id, e.seq);
        let admitted = outer.decode_fact(incoming);
        if !effect.ok || !admitted.valid || admitted.context.application_id != j.read(0).digest || codec.started(admitted.edge) != codec.started(r) {
            out.error = "invalid reviewed knowledge edge effect (row " + to_string(i) + ")"; return out;
        }
        let basis = codec.basis(j, receipts, direct, r, e.seq);
        if !basis.ok || basis.event_id != r.edge_basis {
            out.error = "invalid reviewed knowledge edge basis (row " + to_string(i) + ")"; return out;
        }
        let endpoints = codec.endpoints(j, receipts, r, e.seq);
        if !endpoints.ok || !endpoints.ratified || (e.kind == "knowledge.edge.reviewed_linked" && !endpoints.active) {
            out.error = "invalid reviewed knowledge edge endpoints (row " + to_string(i) + ")"; return out;
        }
        let edge = dna::KnowledgeEdge { from: r.from_id, to: r.to_id, rel: r.rel };
        let applied = if e.kind == "knowledge.edge.reviewed_linked" { store.link(edge) } else { store.unlink(edge) };
        if !applied { out.error = "reviewed knowledge edge projection failed (row " + to_string(i) + ")"; return out; }
    }
    return out;
}

// Whether the record redacted `digest` (GH #606).
@unbounded
fn redacted_in(j: dna::Journal, digest: String) -> Bool {
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "receipt.redacted" && e.entity == digest { return true; }
        i = i + 1;
    }
    return false;
}

// A graph read never discloses a protected body implicitly. Build this index
// once per read, in the service that owns both memories, before filtering nodes,
// edges, labels or counts. The caller must check unchanged() before publishing
// the result. This is receipt visibility, not authentication or position grants.
type KnowledgeVisibilityBasis {
    available: Bool = false;
    record_head: String = "";
    record_revision: Int = 0;
    ledger_head: String = "";
    ledger_revision: Int = 0;
    checkpoint: String = "";
    routing: Int = 0;
    error: String = "knowledge_visibility_unavailable";
}

type KnowledgeRestriction { id: String = ""; }

// Supplied by the service composition (operations::OrganizationJson satisfies
// this contract): complete JSON syntax, unique literal keys, valid UTF-8, and
// bounded nesting. Permissive stdlib field lookup alone cannot establish policy.
interface KnowledgePolicySyntax { fn valid(text: String) -> Bool; }
locus NoKnowledgePolicySyntax {
    params { }
    fn valid(text: String) -> Bool { return false; }
}

@form(hashmap)
locus KnowledgeRestrictions {
    capacity { pool rows of KnowledgeRestriction indexed_by id; }
}

fn knowledge_receipt_id(id: String) -> String {
    if len(id) != 64 && len(id) != 71 { return ""; }
    let canonical = if len(id) == 64 { "sha256:" + id } else { id };
    return if dna::digest_well_formed(canonical) { canonical } else { "" };
}

locus KnowledgeVisibility {
    params {
        record: dna::Journal = dna::MemJournal { };
        ledger: dna::LedgerView = dna::PqLedger { };
        syntax: KnowledgePolicySyntax = NoKnowledgePolicySyntax { };
        restrictions: KnowledgeRestrictions = KnowledgeRestrictions { };
        basis: KnowledgeVisibilityBasis = KnowledgeVisibilityBasis { };
        captured: Bool = false;
        max_rows: Int = 10000;
        max_bytes: Int = 8388608;
        scanned_bytes: Int = 0;
    }
    fn refuse(code: String) -> KnowledgeVisibilityBasis {
        self.basis.available = false;
        self.basis.error = code;
        return self.basis;
    }
    fn inspect(e: dna::Event) -> Bool {
        let size = len(e.kind) + len(e.entity) + len(e.body);
        if size > self.max_bytes - self.scanned_bytes { return false; }
        self.scanned_bytes = self.scanned_bytes + size;
        if e.kind != "receipt.redacted" && e.kind != "receipt.classified" && e.kind != "receipt.withheld" && e.kind != "receipt.filed" { return true; }
        let id = knowledge_receipt_id(e.entity);
        if len(id) == 0 { self.basis.error = "knowledge_visibility_unavailable"; return false; }
        if !self.syntax.valid(e.body) || !std::str::starts_with(std::str::trim(e.body), "{") { self.basis.error = "knowledge_visibility_unavailable"; return false; }
        let class = std::json::find_field_raw(e.body, "class");
        // Restriction is sticky within a captured view: a later public label
        // does not undo a redaction, return a withheld body or grant disclosure.
        if e.kind == "receipt.redacted" || e.kind == "receipt.withheld" || (class != "\"public\"" && class != "\"internal\"") {
            self.restrictions.set(KnowledgeRestriction { id: id });
        }
        return true;
    }
    fn load() -> KnowledgeVisibilityBasis {
        // The index is a request child. Reusing it would mix policy snapshots.
        if self.captured { return self.refuse("knowledge_visibility_unavailable"); }
        self.captured = true;
        if self.max_rows < 1 || self.max_bytes < 1 { return self.refuse("knowledge_read_limit"); }
        let moved = self.record.refresh();
        self.basis.record_head = self.record.head();
        self.basis.record_revision = self.record.revision();
        // GitJournal's legacy refresh has no error channel and may represent a
        // failed read as empty genesis. That cannot authorize cached graph rows.
        if self.basis.record_revision == 0 || self.basis.record_head == "genesis" || len(self.basis.record_head) == 0 { return self.refuse("knowledge_visibility_unavailable"); }
        if self.basis.record_revision < 0 || self.basis.record_revision > self.max_rows { return self.refuse("knowledge_read_limit"); }
        let mut i = 0;
        while i < self.basis.record_revision {
            let e = self.record.read(i);
            self.basis.error = "knowledge_read_limit";
            if e.seq != i { return self.refuse("knowledge_visibility_unavailable"); }
            if !self.inspect(e) { return self.refuse(self.basis.error); }
            if e.kind == "ledger.abandoned" {
                // Abandonment destroys old dna::Ledger restrictions; switching back
                // to Record does not establish their absence.
                return self.refuse("knowledge_visibility_unavailable");
            }
            if e.kind == "ledger.adopted" {
                if !self.syntax.valid(e.body) || !std::str::starts_with(std::str::trim(e.body), "{") || std::json::find_field_raw(e.body, "routing") != to_string(dna::ROUTING_VERSION) { return self.refuse("knowledge_visibility_unavailable"); }
                let raw_checkpoint = std::json::find_field_raw(e.body, "checkpoint");
                if len(raw_checkpoint) < 2 || !std::str::starts_with(raw_checkpoint, "\"") { return self.refuse("knowledge_visibility_unavailable"); }
                self.basis.routing = std::json::find_int_field(e.body, "routing");
                self.basis.checkpoint = std::json::find_string_field(e.body, "checkpoint");
                if self.basis.routing != dna::ROUTING_VERSION || len(self.basis.checkpoint) == 0 { return self.refuse("knowledge_visibility_unavailable"); }
            }
            i = i + 1;
        }
        if !self.record.verify_chain() { return self.refuse("knowledge_visibility_unavailable"); }
        if self.basis.routing > 0 {
            let refreshed = self.ledger.refresh();
            let cut = self.ledger.checkpoint();
            if len(self.ledger.last_error()) > 0 || !cut.adopted || cut.routing != self.basis.routing || cut.checkpoint != self.basis.checkpoint { return self.refuse("knowledge_visibility_unavailable"); }
            self.basis.ledger_head = self.ledger.head();
            self.basis.ledger_revision = self.ledger.revision();
            if self.basis.ledger_revision < 0 || self.basis.ledger_revision > self.max_rows - self.basis.record_revision { return self.refuse("knowledge_read_limit"); }
            if cut.copied < 0 || cut.copied > self.basis.ledger_revision { return self.refuse("knowledge_visibility_unavailable"); }
            i = 0;
            while i < self.basis.ledger_revision {
                let e = self.ledger.read(i);
                self.basis.error = "knowledge_read_limit";
                if e.seq != i { return self.refuse("knowledge_visibility_unavailable"); }
                if !self.inspect(e) { return self.refuse(self.basis.error); }
                i = i + 1;
            }
            if !self.ledger.verify_chain() { return self.refuse("knowledge_visibility_unavailable"); }
        }
        self.basis.available = true;
        self.basis.error = "";
        if !self.unchanged() { return self.basis; }
        return self.basis;
    }
    fn visible(digest: String) -> Bool {
        if !self.basis.available { return false; }
        let id = knowledge_receipt_id(digest);
        if len(id) == 0 { return false; }
        let restricted = self.restrictions.get(id) or KnowledgeRestriction { };
        return len(restricted.id) == 0;
    }
    fn unchanged() -> Bool {
        if !self.basis.available { return false; }
        let moved = self.record.refresh();
        if self.record.head() != self.basis.record_head || self.record.revision() != self.basis.record_revision {
            let refused = self.refuse("snapshot_changed");
            return false;
        }
        if self.basis.routing > 0 {
            let refreshed = self.ledger.refresh();
            let cut = self.ledger.checkpoint();
            if len(self.ledger.last_error()) > 0 {
                let refused = self.refuse("knowledge_visibility_unavailable");
                return false;
            }
            if !cut.adopted || cut.routing != self.basis.routing || cut.checkpoint != self.basis.checkpoint || self.ledger.head() != self.basis.ledger_head || self.ledger.revision() != self.basis.ledger_revision {
                let refused = self.refuse("snapshot_changed");
                return false;
            }
        }
        return true;
    }
}

// ---- the projection, as the spine runs it (GH #985, #1026) ----------------
//
// The graph is the spine's projection of the record: a host that runs a
// body applies the record into it on its tick, as the record's spine role
// (HALE_DNA_MEMORY_DSN_SPINE), so the projection advances without anyone
// asking. Every node may: the store serializes them, one row at a time. It lives here, beside the command codecs it decodes admitted facts
// with, rather than in the core those codecs are written against.
locus MemoryProjection {
    params {
        root: String = ".";
        dsn_env: String = dna::SPINE_DSN_ENV;
        store: dna::Pq = dna::Pq { };
        j: dna::GitJournal = dna::GitJournal { repo: ".", author: "spine" };
        receipts: dna::GitReceipts = dna::GitReceipts { repo: "." };
        applied: Int = 0;
        last_error: String = "";
        opened: Bool = false;
    }
    birth() {
        self.j.repo = self.root;
        self.j.record.repo = self.root;
        self.receipts.repo = self.root;
        self.store.dsn_env = self.dsn_env;
    }
    fn ready() -> Bool { return dna::dsn_set(self.dsn_env); }
    // Opened on the first request, not at birth: a database that is
    // down or slow to answer must not hold the HTTP surface closed —
    // the surface is where an operator reads that it is down. Kept
    // open once it opens, and retried while it will not, so a database
    // that comes up late needs no restart.
    fn ensure_open() -> Bool {
        // An open that succeeded once is not a connection that still
        // answers. A database restart, or anything else that drops the
        // session, left this true forever: the summary said `open`, the
        // record tail failed, and `/context` answered 200 with an empty
        // package and a normal-looking digest until someone restarted
        // the service by hand (the review's second round, finding 4).
        // The connection is asked on each request, and a dead one is
        // re-established here rather than reported as knowledge.
        // The store is scoped by the record's identity, its first
        // commit (GH #613): a record that had no rows when the store
        // opened, and has some now, moves to its own schema here.
        let scope = self.j.genesis();
        if self.opened && scope != self.store.record() {
            eprintln("hale dna: memory: the record has its first row; the store is scoped to record ", scope);
            self.opened = false;
        }
        if self.opened && self.store.healthy() { return true; }
        if self.opened { eprintln("hale dna: memory: the store's connection is gone (", self.store.last_error(), "); dialling again"); }
        self.opened = false;
        self.store.scope(scope);
        if self.store.reopen() {
            self.opened = true;
            self.last_error = "";
            return true;
        }
        self.last_error = "the store is not open: " + self.store.last_error();
        return false;
    }
    // Tail the record: fetch is the host's job; this reads what the
    // repository has now (another process — the organization, a CLI —
    // may have moved the ref since the last read). Any number of
    // projectors may tail one record at once.
    fn apply() -> ProjectionApplied {
        // read the record before opening the store: the scope is the
        // record's identity as loaded, and what is applied is the same
        // loaded record
        let moved = self.j.refresh();
        return self.project(false);
    }
    fn projection_refused(why: String) -> ProjectionApplied {
        self.last_error = "the Knowledge projection cannot proceed over this Record: " + why;
        // Which check refused, on stderr: the fixtures dump it, and an
        // operator reading the service log sees the numbers, not a riddle.
        eprintln("hale dna: memory: projection refused: ", why, " (record ", to_string(self.j.revision()), " head ", self.j.head(), ")");
        return ProjectionApplied { error: "knowledge_projection_unavailable" };
    }
    // Where this clone's record stands to memory's stamp, by ancestry
    // (GH #1026). The record's rows are its commits, so a stamp is a
    // commit and every clone can place it:
    //   `descends` — nothing is stamped, or the stamped head is this
    //     clone's row at the stamp: the rows after it are the delta;
    //   `behind`   — this clone's head is an ancestor of the stamped head,
    //     or the stamped head is a commit this clone has not received:
    //     another projector is ahead, and there is nothing here to project
    //     until the record is received (the host receives it every tick). A
    //     head it cannot place is never taken for a replaced chain: two
    //     nodes that append rows before they share them would otherwise
    //     each rebuild the other's projection until they synced;
    //   `replaced` — neither: the chain was rebuilt beneath the projection
    //     (a reconcile re-appends local rows, each with a new digest, GH
    //     #603), so the graph is rebuilt from row 0. The graph is derived.
    fn fence(basis: dna::GraphProjection, revision: Int) -> String {
        if basis.watermark == 0 { return "descends"; }
        if basis.watermark <= revision && self.j.read(basis.watermark - 1).digest == basis.head { return "descends"; }
        let r = self.j.record;
        if !r.holds(basis.head) { return "behind"; }
        if revision == 0 || r.precedes(self.j.head(), basis.head) { return "behind"; }
        return "replaced";
    }
    fn project(bounded: Bool) -> ProjectionApplied { return self.project_once(bounded, false); }
    fn project_once(bounded: Bool, rebuilt: Bool) -> ProjectionApplied {
        if !self.ensure_open() { return ProjectionApplied { error: self.last_error }; }
        let basis = self.store.projection_basis();
        if !basis.ok { return self.projection_refused("memory holds no valid projection stamp (" + self.store.last_error() + "); `hale dna memory migrate` sets one"); }
        let revision = self.j.revision();
        let target = if revision > 0 { self.j.read(revision - 1).digest } else { "" };
        if revision > 0 && target != self.j.head() { return self.projection_refused("the record head `" + self.j.head() + "` is not its last row `" + target + "`"); }
        let place = self.fence(basis, revision);
        if place == "behind" { return ProjectionApplied { watermark: basis.watermark, yielded: true }; }
        if place == "replaced" {
            eprintln("hale dna: memory: the stamped head `", basis.head, "` at row ", to_string(basis.watermark), " is neither this clone's row there nor ahead of it (record ", to_string(revision), " head ", self.j.head(), "): the chain was rebuilt beneath the projection (a reconcile); rebuilding the projection from row 0");
            // once per pass: a second projector over another chain moves
            // it back on its own pass, until the reconcile ends the race
            if rebuilt { return ProjectionApplied { watermark: basis.watermark, yielded: true }; }
            if !self.store.rebuild(basis.watermark, basis.head) {
                if len(self.store.last_error()) == 0 { return ProjectionApplied { watermark: basis.watermark, yielded: true }; }
                return self.projection_refused("the store could not rebuild its projection: " + self.store.last_error());
            }
            return self.project_once(bounded, true);
        }
        self.store.forget_error();
        let receipts = GraphReceipts { source: self.receipts };
        let mut r = if bounded { apply_record(self.store, self.j, receipts) } else { apply_record(self.store, self.j, self.receipts) };
        if len(receipts.error) > 0 { r.error = receipts.error; }
        self.applied = self.applied + r.ratified + r.proposed + r.declined;
        self.last_error = r.error;
        return r;
    }
}

// Projection reads pin each receipt ref to a blob and inspect its size before
// transporting its body. A read must not trigger unlimited catch-up work before
// the graph query's own row/byte bounds can run. This adapter never writes.
locus GraphReceipts {
    params { source: dna::GitReceipts; remaining: Int = 8388608; error: String = ""; }
    fn kind() -> String { return "git"; }
    fn store(text: String) -> String { self.error = "knowledge_projection_unavailable"; return ""; }
    fn erase(digest: String) -> Bool { self.error = "knowledge_projection_unavailable"; return false; }
    fn read(digest: String) -> String {
        if len(self.error) > 0 { return ""; }
        if len(digest) != 64 || !dna::digest_well_formed("sha256:" + digest) { self.error = "knowledge_projection_unavailable"; return ""; }
        let record = self.source.record;
        let object = record.git_out("rev-parse\n-q\n--verify\n" + record.ref_of("receipts/" + digest));
        if len(object) == 0 { return ""; }
        // cat-file with an expected type can peel a tag. Size and body must
        // refer to the exact same blob, never a small tag over a large body.
        let kind = record.git("cat-file\n-t\n" + object);
        if kind.code != 0 || dna::trim_nl(kind.stdout) != "blob" { self.error = "knowledge_projection_unavailable"; return ""; }
        let sized = record.git("cat-file\n-s\n" + object);
        let size = std::str::parse_int(dna::trim_nl(sized.stdout)) or - 1;
        if sized.code != 0 || size < 0 { self.error = "knowledge_projection_unavailable"; return ""; }
        if size > self.remaining { self.error = "knowledge_read_limit"; return ""; }
        let body = record.git("cat-file\nblob\n" + object);
        if body.code != 0 || len(body.stdout) != size || dna::digest_of(body.stdout) != "sha256:" + digest { self.error = "knowledge_projection_unavailable"; return ""; }
        self.remaining = self.remaining - size;
        return body.stdout;
    }
}
