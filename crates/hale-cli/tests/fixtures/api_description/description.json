{
  "app": "Shop",
  "commands": [
    {
      "keyed_by": null,
      "name": "Audits",
      "payload": "Audit",
      "reply": null,
      "role": null,
      "subject": "shop.audit"
    },
    {
      "keyed_by": null,
      "name": "Refunds",
      "payload": "Refund",
      "reply": "RefundResult",
      "role": null,
      "subject": "shop.refund"
    },
    {
      "keyed_by": "order_id",
      "name": "Ticks",
      "payload": "Tick",
      "reply": null,
      "role": null,
      "subject": "shop.tick"
    }
  ],
  "hale_api": 1,
  "notes": {
    "gates": "a role gate is a boundary check at the binding, never a proof over the program's internal call paths",
    "reads": "a read is a snapshot taken on the locus's own pool, carried with an as_of digest; a live view is a stream"
  },
  "reads": [
    {
      "name": "billing.ledger",
      "role": null,
      "snapshot": true,
      "type": "Ledger"
    },
    {
      "name": "uptime",
      "role": null,
      "snapshot": true,
      "type": "Uptime"
    }
  ],
  "schemas": {
    "Audit": {
      "properties": {
        "line": {
          "type": "string"
        }
      },
      "required": [
        "line"
      ],
      "type": "object"
    },
    "Ledger": {
      "properties": {
        "balance": {
          "type": "integer"
        },
        "entries": {
          "type": "integer"
        }
      },
      "required": [
        "balance",
        "entries"
      ],
      "type": "object"
    },
    "Money": {
      "properties": {
        "amount": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "Refund": {
      "properties": {
        "money": {
          "$ref": "#/schemas/Money"
        },
        "order_id": {
          "type": "integer"
        }
      },
      "required": [
        "order_id",
        "money"
      ],
      "type": "object"
    },
    "RefundResult": {
      "properties": {
        "note": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "note"
      ],
      "type": "object"
    },
    "Tick": {
      "properties": {
        "n": {
          "type": "integer"
        },
        "order_id": {
          "type": "integer"
        }
      },
      "required": [
        "order_id",
        "n"
      ],
      "type": "object"
    },
    "Uptime": {
      "properties": {
        "seconds": {
          "type": "integer"
        }
      },
      "required": [
        "seconds"
      ],
      "type": "object"
    }
  },
  "streams": [
    {
      "name": "Moved",
      "payload": "Ledger",
      "role": null,
      "subject": "shop.moved"
    }
  ]
}
