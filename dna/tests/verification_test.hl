// dna/tests/verification_test.hl — GH #529 D3: evidence collection.
//
// A genome (one program) with its baseline artifact; a candidate
// worktree holding a change that adds a locus and reaches a declared
// effect class. HaleVerification runs the real toolchain over it and
// leaves receipts: one content-addressed output per step under the
// evidence dir, one `evidence.<step>` event per step on the candidate
// in the Journal, the semantic diff as files, and the magnitude
// vector read from that diff. A candidate that does not check has
// no artifact, no diff and default magnitude — and says so.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn sh(argv: String) -> dna::RunResult { return dna::run_tool(argv); }

const BASE: String = "effect mail;
type Ping { n: Int = 0; }
topic Pings { payload: Ping; subject: \"t.pings\"; }
locus A { params { seen: Int = 0; } bus { subscribe Pings as on_ping; } fn on_ping(p: Ping) { self.seen = self.seen + 1; } }
main locus App { params { a: A = A { }; } bus { publish Pings; } run() { Pings <- Ping { n: 1 }; } }
fn main() { App { }; }
";
const CANDIDATE: String = "effect mail;
type Ping { n: Int = 0; }
topic Pings { payload: Ping; subject: \"t.pings\"; }
locus A { params { seen: Int = 0; } bus { subscribe Pings as on_ping; } fn on_ping(p: Ping) { self.seen = self.seen + 1; } }
locus Mailer { bus { subscribe Pings as on_ping; } @effects(is: { mail }) fn on_ping(p: Ping) { } }
main locus App { params { a: A = A { }; m: Mailer = Mailer { }; } bus { publish Pings; } run() { Pings <- Ping { n: 1 }; } }
fn main() { App { }; }
";

main locus App {
    params {
        journal: dna::Journal = dna::MemJournal { };
        v: dna::HaleVerification = dna::HaleVerification { };
    }
    run() {
        let root = "/tmp/dna-verify-" + to_string(std::process::pid());
        std::io::fs::mkdir(root) or discard;
        std::io::fs::mkdir(root + "/genome") or discard;
        std::io::fs::mkdir(root + "/wt") or discard;
        std::io::fs::write_file(root + "/genome/main.hl", BASE) or discard;
        std::io::fs::write_file(root + "/wt/main.hl", CANDIDATE) or discard;
        let base = sh(toolchain() + "\ncheck\n" + root + "/genome\n--dump-topology=" + root + "/baseline.topology");
        std::test::assert_eq_int(base.code, 0, "baseline artifact: " + base.stderr);
        self.v = dna::HaleVerification { hale_bin: toolchain(), receipts: dna::FileReceipts { dir: root + "/evidence" }, scratch: root + "/scratch" };

        // ---- a candidate that checks ---------------------------------------
        let r = self.v.verify(self.journal, dna::Mutation { id: "m1", worktree: root + "/wt", candidate_commit: "cand1" }, root + "/baseline.topology");
        std::test::assert_eq_str(r.steps, "fmt=0 check=0 verify=0 test=0 diff=0 rollback=-1", "every step ran clean (no base commit: no rehearsal): " + r.steps);
        std::test::assert(r.evidence.check_clean && r.evidence.verify_clean, "check and verify evidence");
        std::test::assert(!r.evidence.tests_pass, "no tests is no test evidence");
        std::test::assert(!r.evidence.replay_ok, "no recording is no replay evidence");
        std::test::assert_eq_int(len(r.candidate_shape), 16, "candidate shape hash: " + r.candidate_shape);
        std::test::assert_eq_int(r.magnitude.loci, 1, "one locus added");
        std::test::assert(r.magnitude.effects_widened, "a new subscriber reaches effects");
        std::test::assert_eq_int(r.magnitude.external_blast, 2, "a declared effect class is external blast");
        std::test::assert(!r.magnitude.law_touched, "no law in the fixture");
        std::test::assert_eq_int(r.magnitude.novelty, 3, "nothing applied in this lineage yet");
        let dj = self.v.receipts.read(r.diff_json);
        std::test::assert(std::str::contains(dj, "\"classification\""), "diff json is a receipt");
        let dt = self.v.receipts.read(r.diff_text);
        std::test::assert(std::str::contains(dt, "Mailer"), "diff text names the new locus: " + dt);

        // ---- receipts: journal events on the candidate, outputs by digest --
        let mut evidence_events = 0;
        let mut i = 0;
        let n = self.journal.revision();
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "evidence.check" {
                std::test::assert_eq_str(e.entity, "cand1", "evidence is tied to the candidate");
                let d = std::json::find_string_field(e.body, "output_digest");
                let text = std::io::fs::read_file(root + "/evidence/" + d + ".txt") or "MISSING";
                std::test::assert_eq_str(dna::hex(std::crypto::sha256(std::bytes::from_string(text))), d, "the receipt is content-addressed");
            }
            if e.kind == "evidence.magnitude" {
                std::test::assert(std::str::contains(e.body, "\"external_blast\": 2"), "magnitude journaled: " + e.body);
            }
            if std::str::contains(e.kind, "evidence.") { evidence_events = evidence_events + 1; }
            i = i + 1;
        }
        std::test::assert_eq_int(evidence_events, 6, "fmt check verify test diff magnitude");
        std::test::assert(self.journal.verify_chain(), "chain intact");

        // ---- a candidate that does not check ------------------------------
        std::io::fs::write_file(root + "/wt/main.hl", "fn main() { let x: Int = \"no\"; }\n") or discard;
        let bad = self.v.verify(self.journal, dna::Mutation { id: "m2", worktree: root + "/wt", candidate_commit: "cand2" }, root + "/baseline.topology");
        std::test::assert(!bad.evidence.check_clean, "check failed");
        std::test::assert_eq_str(bad.diff_json, "", "no artifact, no diff");
        std::test::assert_eq_str(bad.candidate_shape, "", "no shape");
        std::test::assert_eq_int(bad.magnitude.loci, 0, "default magnitude");
        std::test::assert(std::str::contains(bad.steps, "check=1"), "the exit code is in the steps: " + bad.steps);
        std::test::assert(std::str::contains(bad.steps, "diff=-1"), "diff did not run: " + bad.steps);
    }
}
fn main() { App { }; }
