// Case 7, second half: the seed's only `main locus` is inside a
// module. It is not the entry, so the check refuses the seed, and it is
// still the table's root, with `is_entry` false, so every other rule
// judges it.
locus Worker { }

module app {
    main locus App {
        params {
            w: Worker = Worker { };
        }
        placement {
            w: pinned;
        }
    }
}

fn main() { app::App { }; }
