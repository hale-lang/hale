// Decision line 19, a started run that publishes back to the thread
// reclaiming its child, on an async_io pool (Run, Cancellation): the
// reclaim's wait for the run hold services that thread's queue, as a
// yield does.
//
// As `l19_started_run_publishes_back.hl`, with `side` an async_io pool:
// the old child's run() is a coroutine that parks in its sleeps, then
// publishes to App on main and parks until App's handler answers. The
// wait on main drains main's queue between its sleeps, so the handler
// runs and the coroutine returns.
//
// Expected terminal outcome: App hears the note before the
// reassignment completes, both children's runs read their own names,
// and each child is torn down once, judged by the harness:
// `answered-in-wait`.

type Note { tag: Int; }
topic Notes { payload: Note; subject: "lifecycle.l19.started.async"; }

fn gate(what: String) -> String {
    return "/tmp/hale-l19-publish-async-" + what + "-" + to_string(std::process::pid());
}

interface RowAccess { fn add(value: Int); fn count() -> Int; }

@form(vec)
locus Rows {
    capacity { heap values of Int; }
    fn add(value: Int) { self.push(value); }
    fn count() -> Int { return self.len(); }
}

locus Kid {
    params { tag: Int = 0; name: String = ""; rows: RowAccess = Rows { }; }
    bus { publish Notes; }
    birth() { self.name = "kid-" + to_string(self.tag) + "-name"; self.rows.add(7); }
    run() {
        if self.tag == 0 {
            std::io::fs::write_file(gate("started"), "go") or discard;
            std::time::sleep(50ms);
            Notes <- Note { tag: self.tag };
            while !std::io::fs::file_exists(gate("heard")) {
                std::time::sleep(1ms);
            }
        }
        println("ev rows " + to_string(self.tag) + " " + to_string(self.rows.count()));
        println("ev kid-run " + to_string(self.tag) + " " + self.name);
    }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag)); }
}

main locus App {
    params { k: Kid = Kid { tag: 0 }; }
    placement { k: cooperative(pool = side) where async_io; }
    bus { subscribe Notes as on_note; }
    fn on_note(n: Note) {
        println("ev heard " + to_string(n.tag));
        std::io::fs::write_file(gate("heard"), "go") or discard;
    }
    run() {
        while !std::io::fs::file_exists(gate("started")) {
            std::time::sleep(1ms);
        }
        self.k = Kid { tag: 1 };
        println("ev replaced");
    }
    dissolve() {
        std::io::fs::unlink(gate("started")) or discard;
        std::io::fs::unlink(gate("heard")) or discard;
    }
}

fn main() { App { }; }
