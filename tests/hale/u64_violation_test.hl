// tests/hale/u64_violation_test.hl — `U64` (GH #2121): an operator never
// wraps. An overflow of `+`, `-` or `*`, a division or a remainder by
// zero, a negative `Int` made a `U64`, and a shift by a count outside 0
// through 63 are each a violation where they happen: the process prints
// what happened and exits 1, and nothing after the operator runs.
// (`U64::checked_*` fail instead and `U64::wrapping_*` wrap; those are
// `u64_arith_test.hl`'s.) One program, built once, runs each case by name.

fn app_source() -> String {
    return """
        fn ask(x: U64) -> U64 {
            return x;
        }

        fn main() {
            let what = std::env::arg_or(1, "");
            let m = ask(U64::max());
            let zero = ask(0);
            println("before");
            if what == "add" {
                println(m + 1);
            } else if what == "sub" {
                println(zero - 1);
            } else if what == "mul" {
                println(ask(1 << 32) * ask(1 << 32));
            } else if what == "div" {
                println(m / zero);
            } else if what == "rem" {
                println(m % zero);
            } else if what == "neg" {
                println(U64::from_int(std::env::args_count() - 10));
            } else if what == "shl" {
                println(m << (std::env::args_count() + 62));
            } else if what == "shr" {
                println(m >> (std::env::args_count() - 3));
            } else if what == "fine" {
                println(m - 1 + 1);
            }
            println("after");
        }
        """;
}

fn expect(bin: String, what: String, want: String) {
    let out = std::process::run(bin + "\n" + what)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(out.code, 1, what + " exits 1: " + out.stderr);
    std::test::assert(std::str::contains(out.stdout, "before"), what + " ran up to the operator");
    std::test::assert(
        !std::str::contains(out.stdout, "after"),
        what + " ran nothing after it: " + out.stdout,
    );
    std::test::assert(
        std::str::contains(out.stderr, want),
        what + " says `" + want + "`: " + out.stderr,
    );
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let src = std::io::fs::mktemp("/tmp/hale-2121-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source()) or discard;
    let built = std::process::run(hale + "\nbuild\n" + src)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(built.code, 0, "the program builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];

    expect(
        bin,
        "add",
        "violation: U64 `+` overflows: the result is outside U64's range, 0 through 2^64 - 1 (U64::checked_add fails instead, and U64::wrapping_add wraps)",
    );
    expect(bin, "sub", "violation: U64 `-` overflows");
    expect(bin, "mul", "violation: U64 `*` overflows");
    expect(bin, "div", "violation: U64 division by zero");
    expect(bin, "rem", "violation: U64 remainder by zero");
    expect(bin, "neg", "violation: U64::from_int of a negative Int");
    expect(bin, "shl", "violation: U64 shift by a count outside 0 through 63");
    expect(bin, "shr", "violation: U64 shift by a count outside 0 through 63");

    let fine = std::process::run(bin + "\nfine")
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(fine.code, 0, "an operator in range runs on: " + fine.stderr);
    std::test::assert(
        std::str::contains(fine.stdout, "18446744073709551615"),
        "max - 1 + 1: " + fine.stdout,
    );
    std::test::assert(std::str::contains(fine.stdout, "after"), "and what follows runs");

    std::io::fs::unlink(src) or discard;
    std::io::fs::unlink(bin) or discard;
}
