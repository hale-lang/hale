// Actual generic Knowledge proposals and Reviews over disposable Git Records.
// Only incoming requests are supplied; the Body authors every output fact.
import "../core" as dna;

locus NodeStageJournal {
    params {
        inner: dna::GitJournal = dna::GitJournal { };
        stage: String = "";
        blocked: Bool = false;
        lost_reply: Bool = false;
        faults: Int = 0;
    }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn read(i: Int) -> dna::Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if self.blocked && kind == self.stage { self.faults = self.faults + 1; return dna::AppendResult { error: "io" }; }
        return self.inner.append(expected, kind, entity, body);
    }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if self.blocked && kind == self.stage { self.faults = self.faults + 1; return dna::AppendResult { error: "io" }; }
        let result = self.inner.append_exact(expected, kind, entity, body);
        if self.lost_reply && kind == self.stage && result.ok {
            self.faults = self.faults + 1; self.lost_reply = false;
            return dna::AppendResult { error: "io" };
        }
        return result;
    }
}

@unbounded
fn event(j: dna::Journal, kind: String, entity: String) -> dna::Event {
    let mut i = 0;
    while i < j.revision() { let e = j.read(i); if e.kind == kind && e.entity == entity { return e; } i = i + 1; }
    return dna::Event { };
}
@unbounded
fn count(j: dna::Journal, kind: String, entity: String) -> Int {
    let mut i = 0; let mut n = 0;
    while i < j.revision() { let e = j.read(i); if e.kind == kind && e.entity == entity { n = n + 1; } i = i + 1; }
    return n;
}
fn exact_text() -> String {
    let b = std::bytes::BytesBuilder { };
    b.append_str("A concept — équipe 🧭 <literal>\\n\r\n");
    let mut i = 1; while i < 32 { b.append_u8(i); i = i + 1; }
    return std::str::from_bytes(b.snapshot());
}
fn request(id: String, operation: String, kind: String, text: String, old: String) -> dna::KnowledgeNodeRequest {
    let codec = dna::KnowledgeNodeRequestCodec { };
    let mut r = dna::KnowledgeNodeRequest {
        request_id: id, operation: "dna.knowledge.node." + operation,
        kind: kind, name: "knowledge/example", text: text,
        author: "org", target: "org", supersedes: old, by: "riley",
        because: if operation == "retire" { text } else { "Keep the exact native knowledge." }
    };
    r.candidate_digest = dna::digest_of(codec.document(r));
    return r;
}
fn record_request(j: dna::Journal, r: dna::KnowledgeNodeRequest) {
    let codec = dna::KnowledgeNodeRequestCodec { };
    let result = j.append_exact(j.revision(), "knowledge.node.requested", r.request_id, codec.started(r));
    std::test::assert(result.ok, "native incoming request was recorded");
}
fn body_once(repo: String, j: NodeStageJournal, delivered: dna::KnowledgeNodeRequest) {
    let body = dna::Dna {
        journal: j,
        verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: repo }, repo: repo },
        membrane: dna::Board { who: "board" }
    };
    if len(delivered.request_id) > 0 { body.on_knowledge_node_requested(delivered); }
    body.reconcile_governance();
}

main locus App {
    bus { publish dna::ReviewVerdict; }
    fn repo(label: String) -> String {
        let root = "/tmp/dna-node-recovery-" + to_string(std::process::pid()) + "-" + label;
        std::io::fs::mkdir(root) or discard;
        let init = dna::run_tool("git\n-C\n" + root + "\ninit\n-q\n-b\nmain");
        std::test::assert_eq_int(init.code, 0, "temporary native Record");
        return root;
    }
    fn wait_event(j: dna::Journal, kind: String, id: String) {
        let mut ticks = 0;
        while len(event(j, kind, id).kind) == 0 && ticks < 200 { std::time::sleep(20ms); ticks = ticks + 1; }
        std::test::assert(len(event(j, kind, id).kind) > 0, "actual native " + kind + " arrived");
    }
    fn approve(command: String, digest: String) {
        dna::ReviewVerdict <- dna::Verdict {
            command_id: command, review_id: dna::knowledge_review_id(digest),
            subject_digest: digest, verdict: "approve", reviewer: "board-member", authority: "board", comment: "Exact native node."
        };
    }
    fn proposal(stage: String, lose: Bool) {
        let repo = self.repo(stage + if lose { "-lost" } else { "-blocked" });
        let j = NodeStageJournal { inner: dna::GitJournal { repo: repo }, stage: stage, blocked: !lose, lost_reply: lose };
        let r = request("command/node", "propose", "concept", exact_text(), "");
        let codec = dna::KnowledgeNodeRequestCodec { };
        record_request(j, r);
        body_once(repo, j, dna::KnowledgeNodeRequest { });
        std::test::assert_eq_int(count(j, "knowledge.node.started", r.request_id), 0, "a raw Record request cannot bypass trusted delivery");
        std::test::assert_eq_int(j.faults, 0, "birth does not process the undelivered request");
        body_once(repo, j, r);
        std::test::assert(j.faults > 0, "interrupted the exact native stage");
        std::test::assert_eq_int(count(j, "knowledge.node.refused", r.request_id), 0, "storage failure never becomes domain refusal");
        if !lose { std::test::assert_eq_int(count(j, "knowledge.node.proposed", r.request_id), 0, "an incomplete proposal is not acknowledged"); }
        let fresh = NodeStageJournal { inner: dna::GitJournal { repo: repo } };
        body_once(repo, fresh, dna::KnowledgeNodeRequest { });
        if stage == "knowledge.node.started" && !lose {
            std::test::assert_eq_int(count(fresh, "knowledge.node.started", r.request_id), 0, "missing delivery proof requires host redelivery");
            body_once(repo, fresh, r);
        }
        body_once(repo, fresh, r);
        let ack = event(fresh, "knowledge.node.proposed", r.request_id);
        std::test::assert_eq_str(ack.body, codec.proposed(r), "acknowledgment preserves all exact native request fields and identities");
        std::test::assert_eq_int(count(fresh, "knowledge.node.started", r.request_id), 1, "delivery proof is singular");
        std::test::assert_eq_int(count(fresh, "knowledge.proposed", r.candidate_digest), 1, "one generic candidate after recovery");
        std::test::assert_eq_int(count(fresh, "review.requested", "review:" + dna::knowledge_review_id(r.candidate_digest)), 1, "one exact-candidate Review after recovery");
        std::test::assert_eq_int(count(fresh, "knowledge.node.proposed", r.request_id), 1, "one acknowledgment after duplicate delivery");
        let receipt = dna::GitReceipts { repo: repo };
        std::test::assert_eq_str(receipt.read(r.candidate_digest[7..len(r.candidate_digest)]), codec.document(r), "receipt retains Unicode, CRLF and every non-NUL control byte");
        let removed = dna::run_tool("rm\n-rf\n" + repo);
    }
    fn interrupt_revision(repo: String, j: NodeStageJournal) -> String {
        let body = dna::Dna {
            journal: j,
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: repo }, repo: repo },
            membrane: dna::Board { who: "board" }
        };
        let initial = request("node/initial", "propose", "idea", "An actual generic idea.", "");
        body.on_knowledge_node_requested(initial);
        self.approve("review/initial", initial.candidate_digest);
        self.wait_event(j, "knowledge.ratified", initial.candidate_digest);
        std::test::assert_eq_int(count(j, "practice.proposed", initial.request_id), 0, "generic idea does not pretend to be a Practice request");
        let next = request("node/revision", "revise", "idea", "The adopted revision.", initial.candidate_digest);
        let other = request("node/competitor", "revise", "idea", "A competing revision.", initial.candidate_digest);
        body.on_knowledge_node_requested(next);
        body.on_knowledge_node_requested(other);
        j.blocked = true;
        self.approve("review/revision", next.candidate_digest);
        self.wait_event(j, "knowledge.ratified", next.candidate_digest);
        let mut ticks = 0; while j.faults == 0 && ticks < 200 { std::time::sleep(20ms); ticks = ticks + 1; }
        std::test::assert(j.faults > 0, "predecessor retirement is genuinely interrupted");
        self.approve("review/competitor", other.candidate_digest);
        self.wait_event(j, "knowledge.refused", other.candidate_digest);
        let decision = dna::review_command_decision(j, "review/competitor");
        std::test::assert(std::json::find_bool_field(decision, "accepted") && std::json::find_bool_field(decision, "settled"), "competing Review approval is an actual accepted decision");
        std::test::assert_eq_int(count(j, "knowledge.ratified", other.candidate_digest), 0, "approval cannot steal a predecessor reserved by another adopted revision");
        return next.candidate_digest;
    }
    fn revision_and_retirement() {
        let repo = self.repo("revision");
        let j = NodeStageJournal { inner: dna::GitJournal { repo: repo }, stage: "knowledge.retired" };
        let next = self.interrupt_revision(repo, j);
        let fresh = NodeStageJournal { inner: dna::GitJournal { repo: repo } };
        let body = dna::Dna {
            journal: fresh,
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: repo }, repo: repo },
            membrane: dna::Board { who: "board" }
        };
        body.reconcile_governance();
        let old = dna::native_json_string(event(fresh, "knowledge.node.proposed", "node/revision").body, "supersedes");
        std::test::assert_eq_int(count(fresh, "knowledge.retired", old), 1, "fresh Body completes exact predecessor retirement");
        std::test::assert_eq_str(dna::native_json_string(event(fresh, "knowledge.retired", old).body, "by"), next, "the exact adopted successor retires the predecessor");
        let retire = request("node/retire", "retire", "retirement", "No longer useful.", next);
        body.on_knowledge_node_requested(retire);
        std::test::assert_eq_int(count(fresh, "knowledge.retired", next), 0, "retirement proposal alone changes no active node");
        self.approve("review/retire", retire.candidate_digest);
        self.wait_event(fresh, "knowledge.retired", next);
        std::test::assert_eq_str(dna::native_json_string(event(fresh, "knowledge.retired", next).body, "by"), retire.candidate_digest, "native retirement uses its reviewed candidate");
        std::test::assert_eq_int(count(fresh, "knowledge.ratified", retire.candidate_digest), 1, "retirement itself has native ratification evidence");
        let removed = dna::run_tool("rm\n-rf\n" + repo);
    }
    fn guards() {
        let repo = self.repo("guards");
        let j = NodeStageJournal { inner: dna::GitJournal { repo: repo } };
        let codec = dna::KnowledgeNodeRequestCodec { };
        let body = dna::Dna {
            journal: j,
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: repo }, repo: repo },
            membrane: dna::Board { who: "board" }
        };
        let mut wrong = request("node/wrong-digest", "propose", "idea", "Exact candidate.", "");
        wrong.candidate_digest = dna::digest_of("another document");
        body.on_knowledge_node_requested(wrong);
        std::test::assert_eq_str(event(j, "knowledge.node.refused", wrong.request_id).body, codec.refused(wrong, "candidate digest does not match the exact native knowledge document"), "wrong predicted candidate is a correlated domain refusal");
        std::test::assert_eq_int(count(j, "knowledge.node.started", wrong.request_id), 0, "invalid digest creates no resumable candidate");
        let mut lateral = request("node/lateral", "propose", "concept", "No sibling coordination.", "");
        lateral.author = "org/left"; lateral.target = "org/right"; lateral.candidate_digest = dna::digest_of(codec.document(lateral));
        body.on_knowledge_node_requested(lateral);
        std::test::assert_eq_int(count(j, "knowledge.node.refused", lateral.request_id), 1, "lateral binding receives a domain refusal");
        let mut invalid = request("node/invalid", "propose", "concern", "Not an accepted command kind.", "");
        body.on_knowledge_node_requested(invalid);
        std::test::assert_eq_int(count(j, "knowledge.node.started", invalid.request_id), 0, "unsupported kind cannot start");
        invalid.kind = "idea"; invalid.by = "riley\nother";
        std::test::assert(!codec.valid(invalid), "principal control bytes are refused by the typed codec");
        let first = request("node/conflict", "propose", "idea", "First exact body.", "");
        j.stage = "knowledge.proposed"; j.blocked = true;
        body.on_knowledge_node_requested(first);
        let second = request("node/conflict", "propose", "idea", "Different body under same key.", "");
        j.blocked = false;
        body.on_knowledge_node_requested(second);
        body.reconcile_governance();
        std::test::assert_eq_str(event(j, "knowledge.node.proposed", first.request_id).body, codec.proposed(first), "a conflicting redelivery cannot replace the started request");
        std::test::assert_eq_int(count(j, "knowledge.proposed", second.candidate_digest), 0, "conflicting candidate is never proposed");
        let owned = dna::Dna {
            journal: j,
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: repo }, repo: repo },
            membrane: dna::Board { who: "board" },
            ownership: dna::Ownership { text: "org = north\norg/team = south\n", me: "south", me_env: "" }
        };
        let foreign = request("node/foreign", "propose", "idea", "Another owner's scope.", "");
        owned.on_knowledge_node_requested(foreign);
        std::test::assert_eq_int(count(j, "knowledge.node.started", foreign.request_id), 0, "wrong owner cannot begin a node request");
        std::test::assert_eq_int(count(j, "knowledge.node.refused", foreign.request_id), 0, "wrong owner leaves the request for its actual owner");
        let removed = dna::run_tool("rm\n-rf\n" + repo);
    }
    run() {
        self.proposal("knowledge.node.started", false);
        self.proposal("knowledge.proposed", false);
        self.proposal("review.requested", false);
        self.proposal("knowledge.node.proposed", false);
        self.proposal("knowledge.node.started", true);
        self.proposal("knowledge.node.proposed", true);
        self.revision_and_retirement();
        self.guards();
    }
}
fn main() { App { }; }
