// tests/hale/api_enum_field_test.hl — an enum crosses an api surface
// (spec/api.md § Codecs). On the JSON wire a payload-free variant is its
// name, a variant of one value `{"<Variant>": <value>}`, one of several
// `{"<Variant>": [<value>, ...]}`, exactly as many. An enum may be a field, a
// list's element (payload-free), a row's whole request or response, and its
// error type. Decoding stays strict: an unknown variant, a payload variant
// sent as a bare name, a payload-free one sent as an object, two keys, a
// value of the wrong kind or the wrong count are `wrong_type` for the field
// read. Served over a Unix exposure, with the description's schema.

unit cent;
type Money = quantity Int in cent;

fn api_sock() -> String {
    return "/tmp/hale-api-enum-" + to_string(std::process::pid()) + ".sock";
}

locus Table {
    fn holds(p: std::api::Principal, r: String) -> Bool { return true; }
}

type Inner { a: Int; }
type Status = enum { Up, Down, Gone };
type Shape = enum { Empty, Circle(Float), Tag(String), Rect(Int, Int), Boxed(Inner), At(Time), Mood(Status), Cost(Money) };
type Problem = enum { NotFound(String), Conflict };

type Req { s: Status; shape: Shape; many: bounded[Status; 3]; }
type Out { s: Status; shape: Shape; n: Int; }

locus Echo {
    fn on(r: Req) -> Out {
        return Out { s: r.s, shape: r.shape, n: count(r.many) };
    }
    fn whole(s: Shape) -> Shape { return s; }
    fn status(s: Status) -> Status { return s; }
    fn find(n: Int) -> Int fallible(Problem) {
        if n == 0 { fail Problem::Conflict; }
        if n < 0 { fail Problem::NotFound("no " + to_string(n)); }
        return n;
    }
}

api Public {
    rpc Echo::on;
    rpc Echo::whole;
    rpc Echo::status;
    rpc Echo::find;
}

locus Conn {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
    }
    fn open(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 { return false; }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }
    fn ask(line: String) -> String {
        self.stream.send(line + "\n") or discard;
        let mut i = 0;
        while i < 25 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let got = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return got;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 { i = i + 1; } else { self.buf = self.buf + chunk; }
        }
        return "";
    }
    fn call(member: String, payload: String) -> String {
        return self.ask("{\"call\":\"" + member + "\",\"payload\":" + payload + ",\"id\":\"c\"}");
    }
    // the value a call answered, as written
    fn value(member: String, payload: String) -> String {
        let got = self.call(member, payload);
        let at = std::str::index_of(got, "\"value\":");
        let end = std::str::index_of(got, ",\"caller\"");
        if at < 0 || end < 0 { return got; }
        return got[(at + 8)..end];
    }
}

main locus App {
    params {
        echo: Echo = Echo { };
        sock: api::Exposure = api::serve(Public, unix::Rpc { path: api_sock(), roles: Table { } }, as: "sock", receivers: { Echo: self.echo }, bound: 8, on_full: refuse);
        conn: Conn = Conn { };
    }
    placement { echo: cooperative(pool = work) where async_io; }

    fn shape_round(json: String, what: String) {
        std::test::assert_eq_str(self.conn.value("Echo::whole", json), json, what);
    }

    fn refused(member: String, payload: String, reason: String, what: String) {
        let got = self.conn.call(member, payload);
        std::test::assert(std::str::contains(got, "\"kind\":\"malformed\"") && std::str::contains(got, reason), what + ": " + got);
    }

    run() {
        std::test::assert(self.conn.open(api_sock()), "connected to the exposure's socket");

        // ---- a field, and a list of a payload-free enum ----
        std::test::assert_eq_str(
            self.conn.value("Echo::on", "{\"s\":\"Down\",\"shape\":{\"Rect\":[2,3]},\"many\":[\"Up\",\"Gone\"]}"),
            "{\"s\":\"Down\",\"shape\":{\"Rect\":[2,3]},\"n\":2}",
            "an enum field and a list of one");

        // ---- every variant as a row's whole request and response ----
        self.shape_round("\"Empty\"", "a payload-free variant is its name");
        self.shape_round("{\"Circle\":1.5}", "a variant of one value");
        self.shape_round("{\"Tag\":\"a \\\"b\\\"\"}", "a string value, escaped");
        self.shape_round("{\"Rect\":[2,-3]}", "a variant of several values");
        self.shape_round("{\"Boxed\":{\"a\":7}}", "a record value");
        self.shape_round("{\"At\":\"2026-10-17T03:04:05Z\"}", "an instant value");
        self.shape_round("{\"Mood\":\"Gone\"}", "a payload-free enum value");
        self.shape_round("{\"Cost\":125}", "a quantity value, by its count");
        std::test::assert_eq_str(self.conn.value("Echo::status", "\"Up\""), "\"Up\"", "a payload-free enum row");
        std::test::assert_eq_str(self.conn.value("Echo::whole", " { \"Rect\" : [ 4 , 5 ] } "), "{\"Rect\":[4,5]}", "whitespace around and within");

        // ---- strict ----
        self.refused("Echo::on", "{\"s\":\"Sideways\",\"shape\":\"Empty\"}", "wrong_type: s", "an unknown variant");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":\"Circle\"}", "wrong_type: shape", "a payload variant as a bare name");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":{\"Empty\":true}}", "wrong_type: shape", "a payload-free variant as an object");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":{\"Rect\":[1]}}", "wrong_type: shape", "too few values");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":{\"Rect\":[1,2,3]}}", "wrong_type: shape", "too many values");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":{\"Circle\":\"x\"}}", "wrong_type: shape", "a value of the wrong kind");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":{\"Circle\":1,\"Tag\":\"y\"}}", "wrong_type: shape", "two variants");
        self.refused("Echo::on", "{\"s\":3,\"shape\":\"Empty\"}", "wrong_type: s", "a number for an enum");
        self.refused("Echo::on", "{\"s\":\"Up\",\"shape\":\"Empty\",\"many\":[\"Up\",\"Nope\"]}", "wrong_type: many", "an unknown variant in a list");
        self.refused("Echo::on", "{\"shape\":\"Empty\"}", "missing_field: s", "an enum field is required");
        self.refused("Echo::whole", "\"Square\"", "wrong_type: payload", "an unknown variant as the whole request");

        // ---- an enum error type ----
        let conflict = self.conn.call("Echo::find", "0");
        std::test::assert(std::str::contains(conflict, "\"Conflict\""), "a payload-free error variant: " + conflict);
        let missing = self.conn.call("Echo::find", "-4");
        std::test::assert(std::str::contains(missing, "{\"NotFound\":\"no -4\"}"), "an error variant with a value: " + missing);
        std::test::assert(std::str::contains(self.conn.call("Echo::find", "9"), "\"value\":9"), "the result");

        // ---- the description ----
        let doc = self.conn.ask("{\"describe\":true}");
        std::test::assert(std::str::contains(doc, "{\"type\":\"string\",\"enum\":[\"Up\",\"Down\",\"Gone\"],\"x-hale-type\":\"Status\"}"), "a payload-free enum's schema: " + doc);
        std::test::assert(std::str::contains(doc, "{\"oneOf\":[{\"type\":\"string\",\"enum\":[\"Empty\"]},{\"type\":\"object\",\"properties\":{\"Circle\":{\"type\":\"number\"}},\"required\":[\"Circle\"],\"additionalProperties\":false}"), "an enum with payloads: " + doc);
        std::test::assert(std::str::contains(doc, "\"Rect\":{\"type\":\"array\",\"prefixItems\":[{\"type\":\"integer\"},{\"type\":\"integer\"}],\"minItems\":2,\"maxItems\":2}"), "a variant of several values: " + doc);

        self.sock.stop();
        std::io::fs::unlink(api_sock()) or discard;
    }
}

fn main() { App { }; }
