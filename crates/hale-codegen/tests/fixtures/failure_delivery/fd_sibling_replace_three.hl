// Three siblings on three pools. The owner's handler for `first`
// publishes what `second` fails on, waits for it to raise, then does the
// same for `third`, and replaces both while their failures are posted to
// it and not delivered. Both reclaims are deferred behind their own
// deliveries, which run after `first`'s handler returns, in the order
// they were posted; each old child is reclaimed right after its handler.
// Expected outcome: handled in the order 0, 1, 2; the old `second` and
// `third` dissolve after their own handlers and before `finished`;
// every child (the three old ones and the two replacements) dissolves
// once.

type Go { k: Int; }
topic Gos { payload: Go; subject: "fd.sibling.three.go"; }

fn gate(tag: Int) -> String {
    return "/tmp/hale-fd-sibling-three-" + to_string(tag) + "-" + to_string(std::process::pid());
}

locus Kid {
    params { tag: Int = 0; }
    closure fuse { captures: tag; epoch inline; }
    bus { subscribe Gos as on_go; }
    fn on_go(g: Go) {
        if g.k == self.tag {
            if self.tag > 0 { std::io::fs::write_file(gate(self.tag), "go") or discard; }
            violate fuse;
        }
    }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag)); }
}

main locus App {
    params { first: Kid = Kid { tag: 0 }; second: Kid = Kid { tag: 1 }; third: Kid = Kid { tag: 2 }; heard: Int = 0; }
    placement { first: cooperative(pool = left); second: cooperative(pool = right); third: cooperative(pool = far); }
    bus { publish Gos; }
    fn trigger(k: Int) {
        Gos <- Go { k: k };
        while !std::io::fs::file_exists(gate(k)) { std::time::sleep(1ms); }
        std::time::sleep(250ms);
    }
    on_failure(c: Kid, err: ClosureViolation) {
        println("ev handling " + to_string(c.tag));
        if c.tag == 0 {
            self.trigger(1);
            self.trigger(2);
            self.second = Kid { tag: 3 };
            self.third = Kid { tag: 4 };
            println("ev replaced siblings");
        }
        self.heard = self.heard + 1;
    }
    run() {
        Gos <- Go { k: 0 };
        while self.heard < 3 { std::time::sleep(1ms); }
        println("ev finished");
    }
    dissolve() {
        std::io::fs::unlink(gate(1)) or discard;
        std::io::fs::unlink(gate(2)) or discard;
    }
}

fn main() { App { }; }
