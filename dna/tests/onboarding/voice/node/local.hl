/// The node's local controls (LocalControls in ../spec/protocol.yaml): pause the
/// node or seats, or lower its cap. They only restrict. Kept in
/// `<data>/local.json`.
const LOCAL_DEFAULT: String = "{\"paused\": false, \"paused_seats\": [], \"max_in_flight\": null, \"reason\": null}";

fn read_local(data: String) -> String {
    let stored = std::io::fs::read_file(data + "/local.json") or "";
    if len(stored) == 0 { return LOCAL_DEFAULT; }
    return stored;
}

/// Why `body` is not valid local controls, or "" when it is.
fn local_problem(body: String) -> String {
    if !std::json::valid_object(body) { return "the body must be a JSON object"; }
    let paused = top_value(body, "paused");
    if paused != "true" && paused != "false" { return "paused must be true or false"; }
    let seats = top_value(body, "paused_seats");
    if !std::str::starts_with(seats, "[") { return "paused_seats must be a list of seat ids"; }
    let mut it = std::json::array_first_span(seats);
    while !it.done {
        if !std::str::starts_with(std::json::iter_substring(it, seats), "\"") { return "paused_seats must be a list of seat ids"; }
        it = std::json::array_next_span(it, seats);
    }
    let cap = top_value(body, "max_in_flight");
    if len(cap) > 0 && cap != "null" {
        let n = std::str::parse_int(cap) or - 1;
        if n < 0 { return "max_in_flight must be a whole number of at least 0, or null"; }
    }
    let reason = top_value(body, "reason");
    if len(reason) > 0 && reason != "null" && !std::str::starts_with(reason, "\"") { return "reason must be text or null"; }
    return "";
}

/// Valid local controls, with only the known fields and nulls filled in.
fn normalized_local(body: String) -> String {
    let cap = top_value(body, "max_in_flight");
    let reason = top_value(body, "reason");
    return "{\"paused\": " + top_value(body, "paused") + ", \"paused_seats\": " + top_value(body, "paused_seats") + ", \"max_in_flight\": " + (if len(cap) > 0 { cap } else { "null" }) + ", \"reason\": " + (if len(reason) > 0 { reason } else { "null" }) + "}";
}

/// The effective cap: the declared cap, lowered by a local one. The
/// coordinator's cap joins it with the protocol.
fn effective_cap(capabilities: String, local: String) -> Int {
    let declared = std::str::parse_int(top_value(capabilities, "max_in_flight")) or 0;
    let local_cap = top_value(local, "max_in_flight");
    if len(local_cap) == 0 || local_cap == "null" { return declared; }
    let n = std::str::parse_int(local_cap) or declared;
    if n < declared { return n; }
    return declared;
}
