// Hale stdlib — std::log.
//
// Structured logging on the bus. The Hale-shape: every log
// event is a typed payload published on a hierarchical subject;
// sinks are bus subscribers. Cross-process tailing comes for
// free once a subject is bridged via deployment config.
//
// User code reaches the surface via:
//   - std::log::LogEvent     — record type for events
//   - std::log::Logger       — the publishing locus
//   - std::log::StdoutSink   — default sink (subscribes log.**)
//
// Path-call dispatch + STDLIB_PATH_RENAMES route those names
// to the __StdLog* mangled forms declared here.
//
// Cascading namespaces: each Logger has a `name` (its segment)
// and a `parent_path` (the parent's full path, or "" for root).
// On birth() we compute full_path = parent_path + "." + name
// (or just name if root). Publishes go to "log." + full_path.
// A sink subscribed to "log.**" sees every Logger's events;
// "log.app.**" scopes to one sub-tree; "log.app.db" pins to
// one specific Logger.
//
// Levels are Int constants pending enum-variant patterns:
//   1 = INFO    2 = WARN    3 = ERROR    4 = DEBUG    5 = TRACE
//
// Ordering note: all Hale bus traffic registers at birth().
// Instantiate StdoutSink BEFORE any Logger so the sink is
// listening when Logger.info/warn/error fires.

// std::log::LogEvent — payload type for every Logger publish.
//
// `level` is an Int constant in the 1..=5 range; sinks map it
// to a printable name. `path` is the publishing Logger's
// computed full_path (e.g. "app.db") so a sink subscribing on
// a single subject can still show context.
/// One log event on the bus: numeric level (1=INFO 2=WARN
/// 3=ERROR 4=DEBUG 5=TRACE), cascaded logger path, message,
/// structured `fields` in logfmt, and `ts` (unix seconds at the
/// PUBLISH site). Subscribe to `log.**` to build your own sink.
type __StdLogEvent {
    level: Int;
    msg: String;
    path: String;

    // GH #469 B: structured fields, carried as logfmt text
    // (`k=v k2="two words"`).
    //
    // Not a map, because Hale has no first-class map VALUE — a
    // `@form(hashmap)` is a locus, and a locus cannot be a payload.
    // The alternatives were an inline `bounded[Pair; N]` (a fixed
    // arity baked into the record, and a shape the zero-copy bus
    // path does not carry for struct elements) or this. Rendering
    // at the call site keeps the record flat, keeps it crossing
    // every transport the bus already supports, and keeps the
    // ordering the author wrote.
    //
    // Build entries with `std::log::kv(k, v)`, which does the
    // quoting; joining with a space is the whole composition rule.
    // Empty when the call carried no fields.
    fields: String;

    // Wall-clock unix SECONDS, stamped by the publisher.
    //
    // Stamped at the publish site, not at the sink, so the time is
    // the event's rather than the renderer's — the two differ under
    // a queued or bridged sink, and differ arbitrarily under
    // `hale replay`, where the sink runs at a wall-clock time that
    // has nothing to do with the run being replayed.
    //
    // Seconds is the resolution `std::time::now()` offers. For
    // sub-second ordering, use the recording: bus publishes carry
    // their own sequence.
    ts: Int;
}

// std::log::kv — render one structured field.
//
// Quoting rule, kept small enough to hold in your head: a value
// is bare unless it contains a space, a quote or an `=`, in
// which case it is double-quoted with `\` escapes. That is the
// logfmt convention every parser in that family already
// implements.
/// Render one `key=value` pair for a log event's `fields`, quoting
/// the value when it contains a space, a quote or an `=`. Join
/// several with a space.
fn __std_log_kv(key: String, value: String) -> String {
    let mut needs_quote = false;
    if std::str::contains(value, " ") { needs_quote = true; }
    if std::str::contains(value, "\"") { needs_quote = true; }
    if std::str::contains(value, "=") { needs_quote = true; }
    if !needs_quote {
        return key + "=" + value;
    }
    let escaped = std::str::replace(
        std::str::replace(value, "\\", "\\\\"), "\"", "\\\"");
    return key + "=\"" + escaped + "\"";
}

// Severity ORDER, which the level constants deliberately are not.
//
// The wire values are historical (1=INFO 2=WARN 3=ERROR 4=DEBUG
// 5=TRACE) and cannot be renumbered without breaking every sink
// already decoding them, including ones outside this repo. So the
// comparison used for filtering goes through this map instead:
// TRACE < DEBUG < INFO < WARN < ERROR.
fn __log_severity(level: Int) -> Int {
    if level == 5 { return 0; } // TRACE
    if level == 4 { return 1; } // DEBUG
    if level == 1 { return 2; } // INFO
    if level == 2 { return 3; } // WARN
    if level == 3 { return 4; } // ERROR
    return 2;
}

// The `HALE_LOG` threshold, as a severity (see __log_severity).
//
// Accepts the level names case-insensitively; anything
// unrecognised — including an unset variable — means TRACE, i.e.
// no filtering, because a logging config typo must not silently
// discard the logs you set it to see.
fn __log_env_severity() -> Int {
    if !std::env::var_exists("HALE_LOG") {
        return 0;
    }
    let want = std::str::lower(std::env::var("HALE_LOG"));
    if want == "error" { return 4; }
    if want == "warn" { return 3; }
    if want == "info" { return 2; }
    if want == "debug" { return 1; }
    return 0;
}

// std::log::Logger — a publishing locus with cascading
// namespace.
//
// Each Logger has methods `info(msg)`, `warn(msg)`,
// `error(msg)`, `debug(msg)`, `trace(msg)` that publish a
// LogEvent on the computed subject "log." + full_path.
//
// The bus declaration uses a wildcard publish ("log.**")
// — this is the m94 surface that authorizes computed
// subjects of the right type. Without this declaration,
// the type-checker would reject `subj <- LogEvent { ... }`
// where `subj` is non-literal.
/// Emits typed log events onto the bus (`log.<path>` subjects).
/// `name` is the path segment; `parent_path` cascades
/// (`app` → `app.db`). Levels: info / warn / error / debug /
/// trace. Instantiate a sink FIRST — a subscriber must exist
/// before the publisher fires.
locus __StdLogLogger {
    params {
        name: String = "root";
        parent_path: String = "";
        full_path: String = ""; // computed in birth()

        // GH #469 B: the level threshold, as a SEVERITY (see
        // __log_severity), resolved from `HALE_LOG` in birth().
        //
        // Filtering here rather than at the sink is deliberate:
        // below the threshold there is no publish at all, so a
        // disabled `trace` in a hot loop costs one integer compare
        // instead of a payload plus a fanout. Sinks filter too, for
        // the case where two sinks want different levels — that one
        // has to be paid on the sink side by construction.
        //
        // Set it explicitly to ignore the environment:
        //   std::log::Logger { name: "app", min_severity: 3 }
        min_severity: Int = 0 - 1; // -1 = "ask the environment"
    }
    bus {
        publish "log.**" of type __StdLogEvent;
    }
    birth() {
        if len(self.parent_path) == 0 {
            self.full_path = self.name;
        } else {
            self.full_path = self.parent_path + "." + self.name;
        }
        if self.min_severity < 0 {
            self.min_severity = __log_env_severity();
        }
    }
    fn info(msg: String) {
        self.emit(1, msg, "");
    }
    fn warn(msg: String) {
        self.emit(2, msg, "");
    }
    fn error(msg: String) {
        self.emit(3, msg, "");
    }
    fn debug(msg: String) {
        self.emit(4, msg, "");
    }
    fn trace(msg: String) {
        self.emit(5, msg, "");
    }

    // The `_kv` family: same levels, plus structured fields.
    //
    //   log.info_kv("saved", std::log::kv("user", id));
    //   log.warn_kv("retrying", std::log::kv("attempt", to_string(n))
    //                           + " " + std::log::kv("after", "2s"));
    fn info_kv(msg: String, fields: String) { self.emit(1, msg, fields); }
    fn warn_kv(msg: String, fields: String) { self.emit(2, msg, fields); }
    fn error_kv(msg: String, fields: String) { self.emit(3, msg, fields); }
    fn debug_kv(msg: String, fields: String) { self.emit(4, msg, fields); }
    fn trace_kv(msg: String, fields: String) { self.emit(5, msg, fields); }

    fn emit(level: Int, msg: String, fields: String) {
        if __log_severity(level) < self.min_severity {
            return;
        }
        let subj = "log." + self.full_path;
        subj <- __StdLogEvent {
            level: level,
            msg: msg,
            path: self.full_path,
            fields: fields,
            ts: std::time::now(),
        };
    }
}

// std::log::StdoutSink — default sink.
//
// Subscribes to "log.**" so it sees every Logger's publishes
// regardless of namespace depth. Emits one line per event in
// the form `[LEVEL path] msg`.
//
// Routing: WARN and ERROR go to stderr via `eprintln` so the
// signal lane separates from normal program output in shell
// pipelines and supervisor / CI log capture. INFO, DEBUG, and
// TRACE go to stdout via `println`. Both runtimes implement
// `eprintln`.
/// The minimal sink: subscribes `log.**`, prints every event —
/// INFO/DEBUG/TRACE to stdout, WARN/ERROR to stderr.
locus __StdLogStdoutSink {
    params {
        // Same contract as the Logger's: -1 asks `HALE_LOG`.
        min_severity: Int = 0 - 1;
    }
    bus {
        subscribe "log.**" as on_event of type __StdLogEvent;
    }
    birth() {
        if self.min_severity < 0 {
            self.min_severity = __log_env_severity();
        }
    }
    fn on_event(e: __StdLogEvent) {
        if __log_severity(e.level) < self.min_severity {
            return;
        }
        let name = __log_level_name(e.level);
        let line = "[" + name + " " + e.path + "] " + e.msg
            + __log_fields_suffix(e.fields);
        if e.level == 2 || e.level == 3 {
            eprintln(line);
        } else {
            println(line);
        }
    }
}

// Shared level spelling — one table, so a renumbering or a new
// level cannot half-land across three sinks.
fn __log_level_name(level: Int) -> String {
    if level == 1 { return "INFO"; }
    if level == 2 { return "WARN"; }
    if level == 3 { return "ERROR"; }
    if level == 4 { return "DEBUG"; }
    if level == 5 { return "TRACE"; }
    return "?";
}

// Fields render AFTER the message, space-separated, and vanish
// entirely when empty — so adding fields to one call site does not
// change the shape of every other line in the file.
fn __log_fields_suffix(fields: String) -> String {
    if len(fields) == 0 {
        return "";
    }
    return " " + fields;
}

// =====================================================================
// Sinks (promoted from pond/logfmt, 2026-07-18).
// =====================================================================
//
// Two drop-in alternatives to StdoutSink — same "log.**"
// subscription, so swapping sinks is a one-line change at the
// wiring site. Both also wear the std::text::Sink shape
// (write/line/newline — non-fallible per the interface contract;
// I/O failures land in the FileSink's last_* triple instead of
// the value channel). pond's OtlpSink (OpenTelemetry export)
// deliberately stays in pond — vendor-protocol integration is
// app-tier.

// std::log::FileSink — append every event to a file, rotate by
// size. Rotation shifts path.N-1 → path.N (atomic rename(2)
// overwrite evicts the oldest), …, path → path.1; the next
// append recreates the active file.
//
//   std::log::FileSink { path: "logs/app.log" };
//   let log = std::log::Logger { name: "app" };
//   log.info("started");            // → appended to logs/app.log
//
// I/O failures are captured in the last-error triple
// (last_error_kind / last_error_errno / last_error_path) — the
// canonical scratch convention for loci whose methods can't
// return through the value channel (styleguide 2.7).
/// File sink with size-based rotation: appends every `log.**`
/// event to `path`; when the file exceeds `max_size_bytes` the
/// chain shifts (`path` → `path.1` → … → `path.<keep_files>`,
/// oldest evicted) via atomic rename(2). I/O failures land in
/// the `last_error_kind/errno/path` triple. Also satisfies
/// `std::text::Sink` (write/line/newline with the same
/// rotation).
locus __StdLogFileSink {
    params {
        path: String = "";
        max_size_bytes: Int = 10000000;
        keep_files: Int = 5;
        last_kind: String = "";
        last_errno: Int = 0;
        last_path: String = "";
        min_severity: Int = 0 - 1;
    }
    bus {
        subscribe "log.**" as on_event of type __StdLogEvent;
    }
    birth() {
        if self.min_severity < 0 {
            self.min_severity = __log_env_severity();
        }
    }

    // std::text::Sink shape — raw text with the same rotation.
    fn write(s: String) {
        self.__append(s);
    }
    fn line(s: String) {
        self.__append(s + "\n");
    }
    fn newline() {
        self.__append("\n");
    }

    fn on_event(e: __StdLogEvent) {
        if __log_severity(e.level) < self.min_severity {
            return;
        }
        let name = __log_level_name(e.level);
        self.__append("[" + name + " " + e.path + "] " + e.msg
                + __log_fields_suffix(e.fields) + "\n");
    }

    fn last_error_kind() -> String { return self.last_kind; }
    fn last_error_errno() -> Int { return self.last_errno; }
    fn last_error_path() -> String { return self.last_path; }

    fn __append(s: String) {
        let written = self.__do_append(s);
        if !written {
            return;
        }
        self.__maybe_rotate();
    }
    fn __do_append(s: String) -> Bool {
        std::io::fs::write_file_append(self.path, s) or self.__handle_io(err);
        if self.last_kind != "" {
            return false;
        }
        return true;
    }
    fn __handle_io(e: IoError) {
        self.last_kind = e.kind;
        self.last_errno = e.errno;
        self.last_path = e.path;
    }
    fn __maybe_rotate() {
        let size = std::io::fs::file_size(self.path) or 0;
        if size <= self.max_size_bytes {
            return;
        }
        self.__rotate();
    }
    fn __rotate() {
        let mut i = self.keep_files - 1;
        while i >= 1 {
            let src = self.path + "." + to_string(i);
            let dst = self.path + "." + to_string(i + 1);
            self.__shift_if_exists(src, dst);
            i = i - 1;
        }
        let dst1 = self.path + ".1";
        self.__shift_if_exists(self.path, dst1);
    }
    fn __shift_if_exists(src: String, dst: String) {
        if !std::io::fs::file_exists(src) {
            return;
        }
        std::io::fs::rename(src, dst) or self.__handle_io(err);
    }
}

// std::log::ConsoleSink — the human-facing console renderer:
// dim HH:MM:SS timestamp, colored width-5 level badge, dim
// logger path, plain message. WARN/ERROR route to stderr (the
// StdoutSink lane split). Color is AUTO by default: kept only
// when stderr is a tty, FORCE_COLOR/CLICOLOR_FORCE override,
// NO_COLOR always wins; `color: false` means never.
/// Pretty console sink: dim HH:MM:SS, colored width-5 level
/// badge, dim path, message; WARN/ERROR on stderr. Color is
/// AUTO (stderr tty probe; FORCE_COLOR/CLICOLOR_FORCE force on,
/// NO_COLOR always wins, `color: false` = never).
locus __StdLogConsoleSink {
    params {
        color: Bool = true;
        show_time: Bool = true;
        min_severity: Int = 0 - 1;
    }
    bus {
        subscribe "log.**" as on_event of type __StdLogEvent;
    }
    birth() {
        if std::env::var_exists("NO_COLOR") {
            self.color = false;
        } else if self.color {
            if !std::term::is_tty(2) && !__log_force_color() {
                self.color = false;
            }
        }
        if self.min_severity < 0 {
            self.min_severity = __log_env_severity();
        }
    }

    fn write(s: String) {
        print(s);
    }
    fn line(s: String) {
        println(s);
    }
    fn newline() {
        println("");
    }

    fn on_event(e: __StdLogEvent) {
        if __log_severity(e.level) < self.min_severity {
            return;
        }
        let rendered = self.render(e);
        if e.level == 2 || e.level == 3 {
            eprintln(rendered);
        } else {
            println(rendered);
        }
    }

    fn render(e: __StdLogEvent) -> String {
        let mut out = "";
        if self.show_time {
            // The EVENT's clock, not the sink's. These are the same
            // number for a same-thread sink and diverge for a
            // queued, bridged or replayed one — and in every case
            // the time a reader wants is the one the event happened
            // at.
            out = out + self.paint("\x1b[2m", __log_clock(e.ts)) + " ";
        }
        out = out + self.badge(e.level) + " ";
        if len(e.path) > 0 {
            out = out + self.paint("\x1b[2m", e.path) + " ";
        }
        out = out + e.msg;
        if len(e.fields) > 0 {
            out = out + " " + self.paint("\x1b[2m", e.fields);
        }
        return out;
    }
    fn badge(level: Int) -> String {
        if level == 1 { return self.paint("\x1b[36m", "INFO "); }
        if level == 2 { return self.paint("\x1b[33;1m", "WARN "); }
        if level == 3 { return self.paint("\x1b[31;1m", "ERROR"); }
        if level == 4 { return self.paint("\x1b[2m", "DEBUG"); }
        if level == 5 { return self.paint("\x1b[2m", "TRACE"); }
        return self.paint("\x1b[2m", "LOG  ");
    }
    fn paint(sgr: String, s: String) -> String {
        if !self.color { return s; }
        return sgr + s + "\x1b[0m";
    }
}

fn __log_force_color() -> Bool {
    if std::env::var_exists("FORCE_COLOR") {
        if std::env::var("FORCE_COLOR") != "0" { return true; }
    }
    if std::env::var_exists("CLICOLOR_FORCE") {
        if std::env::var("CLICOLOR_FORCE") != "0" { return true; }
    }
    return false;
}

fn __log_clock(at: Int) -> String {
    let secs_today = at % 86400;
    let h = secs_today / 3600;
    let m = (secs_today % 3600) / 60;
    let s = secs_today % 60;
    return std::str::pad_left(to_string(h), 2, "0") + ":"
        + std::str::pad_left(to_string(m), 2, "0") + ":"
        + std::str::pad_left(to_string(s), 2, "0");
}
