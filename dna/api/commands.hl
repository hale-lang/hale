        let b = std::json::Builder { }; b.begin_object();
        b.string_field("profile", "dna.task.reassign.v1"); b.bool_field("available", available); b.bool_field("authorized", available && capability.authorized);
        b.string_field("position_id", "org"); b.string_field("recovery", "record_lifetime");
        b.string_field("max_identity_bytes", "256"); b.string_field("max_request_bytes", "32768");
        b.field("recipients", if available && capability.authorized { capability.recipients } else { "[]" });
        b.string_field("reason", if !self.origin_valid(origin) { "Command submission has no configured origin." } else if !valid { "Task authority is unavailable." } else if self.bounded(capability.reason, 512, false, true) { capability.reason } else { "Task capability is unavailable." });
        b.end_object(); return b.result();
