// dna/tests/two_owners_test.hl — two owners, two bodies, one record (GH #665, B2).
//
// Over a shared record each owner's controller holds its own lease in
// memory, so two bodies run side by side: acme's beside clone A,
// north's beside clone B, both spines of the one record (GH #985). A
// forced claim of acme's lease from a third clone of acme's raises its
// epoch: the body that held it stops itself, its epoch writes nothing
// any more, and north's body is untouched. In between, a job acme's
// body plans for north's member is a transfer inside the ledger (GH
// #667): offered, refused to acme's member, accepted by north's, handed
// by north's body, and closed by the assignee. The spines know each
// owner's key (GH #669): a request in a person's name comes from a head
// of their owner, and north's head cannot act in alice's name — the
// request is refused in the record.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && unset ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// `argv` in `dir` with memory's head role named (GH #985): every verb
// that reads the ledger or requests a write of it, from any clone.
fn as_head(dir: String, head_dsn: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && unset ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_HEAD=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + dir + "\n" + head_dsn + "\n" + argv);
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

@unbounded
fn row_with(text: String, needle: String) -> String {
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::contains(line, needle) { return line; }
    }
    return "";
}

// How many lines of `text` carry `needle`.
@unbounded
fn count_rows(text: String, needle: String) -> Int {
    let mut n = 0;
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::contains(line, needle) { n = n + 1; }
    }
    return n;
}

// A row's body, as a ledger row carries it (a JSON string field).
fn row_body(row: String) -> String { return std::json::find_string_field(row, "body"); }

// The ledger's rows, read as a head (JSON lines).
fn ledger(app: String, head_dsn: String) -> String {
    return as_head(app, head_dsn, toolchain() + "\ndna\nledger\nrows").stdout;
}

// Every bound in this fixture is a number of 500ms polls sized for a
// quiet machine, widened by `dna::wait_scale()` (HALE_DNA_WAIT_SCALE) on
// a loaded one: one knob for the whole fixture (GH #795). `POLLS` is one
// step a spine or a body takes; `BOOT` is a body coming up, which builds
// it first.
const POLLS: Int = 240;
const BOOT: Int = 600;

@unbounded
fn wait_row(app: String, head_dsn: String, needle: String, tries: Int) -> String {
    let limit = tries * dna::wait_scale();
    let mut n = 0;
    while n < limit {
        let row = row_with(ledger(app, head_dsn), needle);
        if len(row) > 0 { return row; }
        std::time::sleep(500ms);
        n = n + 1;
    }
    return "";
}

// North's hand-off of `tid`, or why it cannot come (GH #1052): the
// spine's refusal of the acceptance, which lands in the record. A refused
// acceptance is nothing to wait out; its reason is the failure.
fn handed_or_refused(app: String, head_dsn: String, tid: String, tries: Int) -> String {
    let limit = tries * dna::wait_scale();
    let mut n = 0;
    while n < limit {
        let row = row_with(ledger(app, head_dsn), "\"kind\": \"task.handed\"");
        if len(row) > 0 { return row; }
        let j = dna::GitJournal { repo: app };
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == "ledger.request_refused" && std::json::find_string_field(e.body, "kind") == "task.transfer_accepted" && std::json::find_string_field(e.body, "entity") == tid { return "refused by the spine: " + std::json::find_string_field(e.body, "why"); }
            i = i + 1;
        }
        std::time::sleep(500ms);
        n = n + 1;
    }
    return "neither handed nor refused within the deadline";
}

// The body of a row of `app`'s record of `kind` whose body carries
// `needle`, once there is one ("" when none within the bound).
@unbounded
// As `wait_record`, syncing the clone on each poll: on a shared record the
// spine that admits is whichever holds the spine lease, and its rows reach
// another owner's clone through the remote (GH #985).
fn wait_synced(app: String, kind: String, needle: String, tries: Int) -> String {
    let limit = tries * dna::wait_scale();
    let mut n = 0;
    while n < limit {
        let synced = dna::run_tool("sh\n-c\ncd \"$1\" && HALE_DNA_DISCOVER=off exec \"$2\" dna sync\nsh\n" + app + "\n" + toolchain());
        let j = dna::GitJournal { repo: app };
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && std::str::contains(e.body, needle) { return e.body; }
            i = i + 1;
        }
        std::time::sleep(500ms);
        n = n + 1;
    }
    return "";
}

fn wait_record(app: String, kind: String, needle: String, tries: Int) -> String {
    let limit = tries * dna::wait_scale();
    let mut n = 0;
    while n < limit {
        let j = dna::GitJournal { repo: app };
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && std::str::contains(e.body, needle) { return e.body; }
            i = i + 1;
        }
        std::time::sleep(500ms);
        n = n + 1;
    }
    return "";
}

fn alive(pid: String) -> Bool {
    return len(pid) > 0 && dna::run_tool("kill\n-0\n" + pid).code == 0;
}

// The scripted catalog: every backend a `dna::FakeModel`, so a body plans
// with no API key (the B1 fixture's).
const CATALOG: String = "// dna/org/models.hl — the catalog, scripted (the two-owners fixture).\n"
    + "import \"vendor/dna\" as dna;\n"
    + "\n"
    + "fn frontier() -> dna::FakeModel {\n"
    + "    return dna::FakeModel { name: \"deep\", model: \"deep-1\", price_micros: 0, answer: \"kind: person\\nclass: application\\ntarget: (none)\\ncount: 1\\nassignee: bob\\nobligation: none\\na person chases it; nothing in the source changes\" };\n"
    + "}\n"
    + "\n"
    + "fn fast() -> dna::FakeModel {\n"
    + "    return dna::FakeModel { name: \"quick\", model: \"quick-1\", price_micros: 0, answer: \"kind: person\\nclass: application\\ntarget: (none)\\ncount: 1\\nassignee: bob\\nobligation: none\\na person chases it; nothing in the source changes\" };\n"
    + "}\n"
    + "\n"
    + "fn desk() -> dna::LocalFakeModel {\n"
    + "    return dna::LocalFakeModel { };\n"
    + "}\n"
    + "\n"
    + "fn leader_models() -> dna::ModelRouter {\n"
    + "    return dna::ModelRouter { quick: fast(), deep: frontier(), private: desk() };\n"
    + "}\n"
    + "\n"
    + "fn editor_models() -> dna::ModelRouter {\n"
    + "    return dna::ModelRouter { quick: fast(), deep: frontier(), private: desk() };\n"
    + "}\n"
    + "\n"
    + "fn agent_models() -> dna::ModelRouter {\n"
    + "    return dna::ModelRouter { quick: fast(), deep: frontier(), private: desk() };\n"
    + "}\n"
    + "\n"
    + "fn org_budget() -> dna::BudgetPolicy {\n"
    + "    return dna::BudgetPolicy { };\n"
    + "}\n";

main locus App {
    params {
        core: dna::Dna = dna::Dna { planned: true, org_id: "two-owners-placeholder" };
        leases: dna::PqLeaseStore = dna::PqLeaseStore { };
    }
    // The spine that adopts the ledger: `hale dna dev` with the owner's DSN
    // (dev migrates and hands the host the spine's role), which a shared
    // record not yet on the ledger needs.
    fn start_dev(dir: String, owner: String) -> String {
        let started = in_dir(dir, "sh\n-c\nHALE_DNA_MEMORY_DSN_OWNER=\"$2\" HALE_DNA_OWNER_KEYS=\"acme=ka north=kb\" nohup timeout 900 \"$1\" dna dev . --no-iris >>.hale/body.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + owner);
        return dna::trim_nl(started.stdout);
    }
    // A body over the shared record, on the ledger: `hale dna run` with the
    // spine's DSN and the owners' keys, which are the spine's and never the
    // record's (GH #669).
    fn start_body(dir: String, spine_dsn: String) -> String {
        let started = in_dir(dir, "sh\n-c\nHALE_DNA_MEMORY_DSN_SPINE=\"$2\" HALE_DNA_OWNER_KEYS=\"acme=ka north=kb\" nohup timeout 900 \"$1\" dna run . --no-iris >>.hale/body.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + spine_dsn);
        return dna::trim_nl(started.stdout);
    }
    @unbounded
    fn body_up(dir: String, tries: Int) -> Bool {
        let limit = tries * dna::wait_scale();
        let mut n = 0;
        while n < limit {
            if std::io::fs::file_exists(dir + "/.hale/dna/hale-dna.intent.offered.sock") && std::io::fs::file_exists(dir + "/.hale/dna/org.pid") { return true; }
            std::time::sleep(500ms);
            n = n + 1;
        }
        return false;
    }
    @unbounded
    fn wait_gone(pid: String, tries: Int) -> Bool {
        let limit = tries * dna::wait_scale();
        let mut n = 0;
        while n < limit {
            if !alive(pid) { return true; }
            std::time::sleep(500ms);
            n = n + 1;
        }
        return false;
    }
    // The lease in memory under `key` once it is (or is no longer) held,
    // read as a head; as it was last read either way.
    @unbounded
    fn wait_lease(key: String, held: Bool, tries: Int) -> dna::StoredLease {
        let limit = tries * dna::wait_scale();
        let mut n = 0;
        let mut l = self.leases.current(key);
        while l.present != held && n < limit {
            std::time::sleep(500ms);
            l = self.leases.current(key);
            n = n + 1;
        }
        return l;
    }
    fn configure(dir: String, who: String, owner: String, key: String) {
        let c0 = in_dir(dir, "git\nconfig\nuser.name\n" + who);
        let c1 = in_dir(dir, "git\nconfig\nuser.email\n" + who + "@l");
        let c2 = in_dir(dir, "git\nconfig\ndna.owner\n" + owner);
        // GH #669: this owner's key, which signs its heads' requests
        let c3 = in_dir(dir, "git\nconfig\ndna.owner.key\n" + key);
    }
    run() {
        let scratch = dna::scratch_root("two-owners");
        dna::reap_on_exit(scratch);
        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        if len(owner) == 0 {
            eprintln("two_owners_test: no HALE_DNA_MEMORY_DSN_OWNER; the bodies have no memory to hold their leases or admit requests, so nothing was exercised");
            dna::scratch_done(scratch);
            return;
        }
        let bare = scratch + "/origin.git";
        let b0 = in_dir(scratch, "git\ninit\n-q\n--bare\n-b\nmain\n" + bare);
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\nshared");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let app = scratch + "/shared";
        self.configure(app, "alice", "acme", "ka");
        std::io::fs::write_file(app + "/dna/org/models.hl", CATALOG) or discard;
        std::io::fs::write_file(app + "/dna/org/owners", "org = acme\norg/collections = north\nacme: alice\nnorth: bob\nhost = acme\n") or discard;
        let checked = in_dir(app, toolchain() + "\ncheck\n--matrix\n.");
        std::test::assert_eq_int(checked.code, 0, "the shared organization checks: " + checked.stdout + checked.stderr);
        let a1 = in_dir(app, "git\nadd\n-A");
        let a2 = in_dir(app, "git\ncommit\n-q\n-m\nthe shared organization");
        let a3 = in_dir(app, "git\nremote\nadd\norigin\n" + bare);
        let a4 = in_dir(app, "git\npush\n-q\norigin\nmain\nrefs/dna/*:refs/dna/*");
        std::test::assert_eq_int(a4.code, 0, "pushed: " + a4.stderr);
        let record = dna::GitJournal { repo: app }.genesis();
        let migrated = in_dir(app, "sh\n-c\nHALE_DNA_MEMORY_DSN_OWNER=\"$2\" exec \"$1\" dna memory migrate\nsh\n" + toolchain() + "\n" + owner);
        let head_dsn = line_value(migrated.stdout, "HALE_DNA_MEMORY_DSN_HEAD");
        let spine_dsn = line_value(migrated.stdout, "HALE_DNA_MEMORY_DSN_SPINE");
        std::test::assert(migrated.code == 0 && std::str::starts_with(head_dsn, "postgres") && std::str::starts_with(spine_dsn, "postgres"), "memory migrated for the record: " + migrated.stdout + migrated.stderr);
        self.leases = dna::PqLeaseStore { conn: dna::pq_conn(dna::parse_dsn(head_dsn)), record_id: record };
        std::test::assert(self.leases.open(), "a head reads the leases: " + self.leases.last_error());
        // ---- the ledger adopted: a shared record's controllers coordinate
        // through it, so `hale dna dev` is the spine that adopts it; the
        // bodies then run on it
        let pid_0 = self.start_dev(app, owner);
        std::test::assert(self.body_up(app, BOOT), "the adopting spine came up: " + (std::io::fs::read_file(app + "/.hale/body.log") or ""));
        let adopted = as_head(app, head_dsn, toolchain() + "\ndna\nledger\nadopt\n--as\nalice");
        std::test::assert(adopted.code == 0 && std::str::contains(adopted.stdout, "ledger adoption requested as"), "adoption requested: " + adopted.stdout + adopted.stderr);
        std::test::assert(len(wait_record(app, "ledger.adopted", "checkpoint", POLLS)) > 0, "the spine adopts the ledger on its tick: " + (std::io::fs::read_file(app + "/.hale/body.log") or ""));
        let k0 = dna::run_tool("kill\n" + pid_0);
        std::test::assert(self.wait_gone(pid_0, POLLS), "the adopting spine stops");
        let rest0 = dna::run_tool("sh\n-c\ncd \"$1\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; rm -f .hale/dna/$f.pid; done; rm -f .hale/dna/*.sock; true\nsh\n" + app);
        let pushed = in_dir(app, toolchain() + "\ndna\nsync");
        std::test::assert_eq_int(pushed.code, 0, "the adopted record is at the remote: " + pushed.stdout + pushed.stderr);
        // ---- acme's body beside clone A, north's beside clone B
        let pid_a = self.start_body(app, spine_dsn);
        std::test::assert(self.body_up(app, BOOT), "acme's body came up: " + (std::io::fs::read_file(app + "/.hale/body.log") or ""));
        let other = scratch + "/north";
        let cl = in_dir(scratch, "git\nclone\n-q\n" + bare + "\n" + other);
        std::test::assert_eq_int(cl.code, 0, "north clones the record: " + cl.stderr);
        self.configure(other, "bob", "north", "kb");
        let synced = as_head(other, head_dsn, toolchain() + "\ndna\nsync");
        std::test::assert_eq_int(synced.code, 0, "north's clone has the record: " + synced.stdout + synced.stderr);
        let pid_b = self.start_body(other, spine_dsn);
        std::test::assert(self.body_up(other, BOOT), "north's body came up beside acme's: " + (std::io::fs::read_file(other + "/.hale/body.log") or ""));
        // a body opens its membrane and takes its lease in its own order:
        // each lease is waited for, not read the moment the socket is there
        let la = self.wait_lease("owner/acme", true, POLLS);
        let lb = self.wait_lease("owner/north", true, POLLS);
        std::test::assert(la.present && std::str::contains(la.holder, "shared"), "acme's lease is held, by its clone: " + dna::stored_lease_json(la));
        std::test::assert(lb.present && std::str::contains(lb.holder, "north"), "north's lease is held, by its clone: " + dna::stored_lease_json(lb));
        std::test::assert(!self.leases.current("body").present, "no lease is the one body's: " + dna::stored_lease_json(self.leases.current("body")));
        let epoch_a = la.token;
        // ---- acme's body writes under its epoch: an ask for its own position lands
        let asked = as_head(app, head_dsn, toolchain() + "\ndna\ntask\ncreate\n--no-wait\n--to\norg/books\n--as\nalice\nchase the late invoice");
        std::test::assert_eq_int(asked.code, 0, "alice asks acme's body: " + asked.stdout + asked.stderr);
        let offered = wait_row(app, head_dsn, "\"kind\": \"intent.offered\"", POLLS);
        std::test::assert(std::str::contains(offered, "chase the late invoice (from alice)"), "the body's write landed under its lease: " + ledger(app, head_dsn));
        // ---- the plan names bob, north's member: a transfer, not a hand-off
        let transfer = wait_row(app, head_dsn, "\"kind\": \"task.transfer_requested\"", POLLS);
        std::test::assert(std::json::find_string_field(row_body(transfer), "to") == "north" && std::json::find_string_field(row_body(transfer), "assignee") == "bob" && std::json::find_string_field(row_body(transfer), "owner") == "acme", "acme's body offers the job to north for bob: " + transfer);
        let tid = std::json::find_string_field(transfer, "entity");
        std::test::assert(std::str::starts_with(tid, "acme:t"), "the task is acme's, in acme's namespace: " + tid);
        std::test::assert_eq_str(row_with(ledger(app, head_dsn), "\"kind\": \"task.handed\""), "", "and nothing is handed yet");
        let not_theirs = as_head(app, head_dsn, toolchain() + "\ndna\ntask\naccept\n" + tid + "\n--as\nalice");
        std::test::assert(not_theirs.code != 0 && std::str::contains(not_theirs.stdout + not_theirs.stderr, "only north's accepts"), "acme's member cannot accept for north: " + not_theirs.stdout + not_theirs.stderr);
        let accepted = as_head(other, head_dsn, toolchain() + "\ndna\ntask\naccept\n" + tid + "\n--as\nbob\n--note\nwe take it");
        std::test::assert(accepted.code == 0 && std::str::contains(accepted.stdout, "accepted for north by bob"), "north's member accepts: " + accepted.stdout + accepted.stderr);
        let handed = handed_or_refused(app, head_dsn, tid, POLLS);
        std::test::assert(std::json::find_string_field(row_body(handed), "transferred_from") == "acme" && std::json::find_string_field(row_body(handed), "assignee") == "bob" && std::json::find_string_field(row_body(handed), "by") == "north" && std::json::find_string_field(row_body(handed), "accepted_by") == "bob", "north's body hands it to bob in its own name: " + handed);
        // ---- two bodies, one spine (GH #985): while acme's spine holds the
        // spine lease, north's reads and forwards — it neither projects nor
        // admits, so the two clones never race over one projection
        let rows_now = dna::GitJournal { repo: app };
        let mut takers = "";
        let mut ri = 0;
        while ri < rows_now.revision() {
            let e = rows_now.read(ri);
            if e.kind == "spine.taken" { takers = takers + std::json::find_string_field(e.body, "owner") + " "; }
            ri = ri + 1;
        }
        std::test::assert(std::str::contains(takers, "acme") && !std::str::contains(takers, "north"), "only acme's spine has taken the spine lease, and the record names it: " + takers);
        let north_spine = std::io::fs::read_file(other + "/.hale/dna/spine.json") or "";
        std::test::assert(len(north_spine) > 0 && !std::json::find_bool_field(north_spine, "held") && std::json::find_int_field(north_spine, "projected") == 0 && std::json::find_int_field(north_spine, "decided") == 0, "north's spine reads and forwards: it projected and decided nothing: " + north_spine);
        let acme_spine = std::io::fs::read_file(app + "/.hale/dna/spine.json") or "";
        std::test::assert(std::json::find_bool_field(acme_spine, "held") && std::json::find_int_field(acme_spine, "projected") > 0 && std::json::find_int_field(acme_spine, "decided") > 0, "acme's spine does the work: " + acme_spine);
        let done = as_head(other, head_dsn, toolchain() + "\ndna\ntask\ndone\n" + tid + "\n--as\nbob\n--note\npaid");
        std::test::assert(done.code == 0 && std::str::contains(done.stdout, "done by bob"), "bob closes it from north's clone: " + done.stdout + done.stderr);
        std::test::assert(std::str::contains(wait_row(app, head_dsn, "\"kind\": \"task.done\"", POLLS), "\"author\": \"bob\""), "in bob's name, in the one ledger: " + ledger(app, head_dsn));
        // one ledger, whichever spine admitted what: each fact once
        let all = ledger(app, head_dsn);
        std::test::assert(count_rows(all, "\"kind\": \"task.transfer_accepted\"") == 1 && count_rows(all, "\"kind\": \"task.handed\"") == 1 && count_rows(all, "\"kind\": \"task.done\"") == 1, "each step of the transfer is one row: " + all);
        // ---- a forced claim of acme's lease from a third clone of acme's:
        // the epoch rises, the old body stops, north's does not
        let third = scratch + "/acme-2";
        let cl2 = in_dir(scratch, "git\nclone\n-q\n" + bare + "\n" + third);
        self.configure(third, "carol", "acme", "ka");
        let s2 = as_head(third, head_dsn, toolchain() + "\ndna\nsync");
        let claimed = as_head(third, head_dsn, toolchain() + "\ndna\nbody\nclaim\n--force\n--as\ncarol");
        std::test::assert(claimed.code == 0 && std::str::contains(claimed.stdout, "was taken by carol"), "acme's lease is taken from its body: " + claimed.stdout + claimed.stderr);
        std::test::assert(self.wait_gone(pid_a, POLLS), "acme's body stops itself once its lease is gone: " + (std::io::fs::read_file(app + "/.hale/body.log") or ""));
        std::test::assert(alive(pid_b), "north's body is untouched");
        // the release is the claim's own step, not the stopped body's: waited
        // for rather than read the moment that body is gone
        let la2 = self.wait_lease("owner/acme", false, POLLS);
        std::test::assert(!la2.present, "acme's lease is released for the next body: " + dna::stored_lease_json(la2));
        // the stopped body's epoch writes nothing any more: the ledger as its
        // organism held it, under its lease at its epoch (the fixture holds
        // only the owner's DSN, so it opens memory with that)
        let old = dna::MemoryLedger { repo: app, dsn_env: "HALE_DNA_MEMORY_DSN_OWNER", lease: "owner/acme", token: epoch_a };
        let stale = old.append(old.revision(), "task.born", "t-stale", "late");
        std::test::assert(!stale.ok && std::str::contains(old.last_error(), "fenced"), "a write at the old epoch is fenced: " + stale.error + " " + old.last_error());
        std::test::assert(!std::str::contains(ledger(app, head_dsn), "t-stale"), "and nothing landed for it");
        // ---- GH #669: north's head cannot act in acme's member's name, whatever it claims
        let borrowed = as_head(other, head_dsn, toolchain() + "\ndna\ntask\ncreate\n--no-wait\n--to\norg/books\n--as\nalice\nsomething in alice's name");
        std::test::assert_eq_int(borrowed.code, 0, "north's head requests it: " + borrowed.stdout + borrowed.stderr);
        let refusal = wait_synced(other, "ledger.request_refused", "\"as\": \"alice\"", POLLS);
        std::test::assert(std::str::contains(refusal, "\"kind\": \"intent.requested\"") && std::str::contains(refusal, "alice is acme's member; north's head cannot act in their name"), "the spine knows whose head this is, and refuses it in the record: " + refusal);
        std::test::assert(!std::str::contains(ledger(app, head_dsn), "something in alice's name"), "nothing landed for it");
        // ---- north's body still writes
        let asked_b = as_head(other, head_dsn, toolchain() + "\ndna\ntask\ncreate\n--no-wait\n--to\norg/collections\n--as\nbob\ncall the agency");
        std::test::assert_eq_int(asked_b.code, 0, "bob asks north's body: " + asked_b.stdout + asked_b.stderr);
        let offered_b = wait_row(app, head_dsn, "call the agency (from bob)", POLLS);
        std::test::assert(len(offered_b) > 0, "north's body still writes under its own lease: " + ledger(app, head_dsn));
        // ---- down
        let k1 = dna::run_tool("kill\n" + pid_b);
        std::test::assert(self.wait_gone(pid_b, POLLS), "north's body stops");
        let rest = dna::run_tool("sh\n-c\nfor d in \"$1\" \"$2\"; do cd \"$d\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; done; done; true\nsh\n" + app + "\n" + other);
        self.leases.conn.close();
        std::test::assert_eq_str(dna::unmigrate(owner, record), "", "this run's schema and roles dropped");
        dna::scratch_done(scratch);
    }
}
fn main() { App { }; }
