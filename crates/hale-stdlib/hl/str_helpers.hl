// std::str helpers (GH #1995 S3): the everyday splits and trims a
// program otherwise writes by hand with a magic offset —
// `line[(at + len(sep))..len(line)]` after an `index_of`, or
// `g[7..len(g)]` after a `starts_with(g, "sha256:")`.
//
// Each measures its String once and works on byte offsets against
// that length with the ByteView primitives (`range_index_of`,
// `range_copy`, `byte_at_unchecked`), so none pays a strlen per step
// and none copies more than the part it returns. Offsets are bytes:
// a separator or prefix is matched byte for byte, so a valid UTF-8
// separator always cuts on a character boundary. All are pure.

/// Whether byte `c` is whitespace to `trim`: space, tab, CR or LF
/// (`lotus_str_trim`'s set).
fn __str_trim_space(c: Int) -> Bool {
    return c == 32 || c == 9 || c == 13 || c == 10;
}

/// `s` around its first `sep`: the text before it and the text after
/// it, neither holding `sep`. `cut("k=v=w", "=")` is `("k", "v=w")`. An
/// empty `sep` is found at 0 (`("", s)`). No `sep` in `s` is
/// `ParseError { kind: "not_found", input: s }`.
fn __str_cut(s: String, sep: String) -> (String, String) fallible(ParseError) {
    let n = len(s);
    let at = std::str::range_index_of(s, n, sep, 0);
    if at < 0 {
        fail ParseError { kind: "not_found", input: s };
    }
    return (std::str::range_copy(s, n, 0, at), std::str::range_copy(s, n, at + len(sep), n));
}

/// The byte index of the last `sub` in `s`, or -1. An empty `sub` is
/// found at the end, `len(s)`.
fn __str_last_index_of(s: String, sub: String) -> Int {
    let n = len(s);
    let m = len(sub);
    if m == 0 {
        return n;
    }
    let first = std::str::byte_at_unchecked(sub, 0);
    let mut i = n - m;
    while i >= 0 {
        if std::str::byte_at_unchecked(s, i) == first && std::str::range_eq(s, i, i + m, sub) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

/// `s` around its last `sep`: `cut_last("a/b/c", "/")` is `("a/b",
/// "c")`. An empty `sep` is found at the end (`(s, "")`). No `sep` in
/// `s` is `ParseError { kind: "not_found", input: s }`.
fn __str_cut_last(s: String, sep: String) -> (String, String) fallible(ParseError) {
    let n = len(s);
    let at = __str_last_index_of(s, sep);
    if at < 0 {
        fail ParseError { kind: "not_found", input: s };
    }
    return (std::str::range_copy(s, n, 0, at), std::str::range_copy(s, n, at + len(sep), n));
}

/// `s` without a leading `prefix`, or `s` unchanged when it does not
/// start with one. Only one `prefix` goes.
fn __str_trim_prefix(s: String, prefix: String) -> String {
    if !std::str::starts_with(s, prefix) {
        return s;
    }
    let n = len(s);
    return std::str::range_copy(s, n, len(prefix), n);
}

/// `s` without a trailing `suffix`, or `s` unchanged when it does not
/// end with one. Only one `suffix` goes.
fn __str_trim_suffix(s: String, suffix: String) -> String {
    if !std::str::ends_with(s, suffix) {
        return s;
    }
    let n = len(s);
    return std::str::range_copy(s, n, 0, n - len(suffix));
}

/// `s` without its leading whitespace (space, tab, CR, LF: `trim`'s
/// set).
fn __str_trim_start(s: String) -> String {
    let n = len(s);
    let mut lo = 0;
    while lo < n && __str_trim_space(std::str::byte_at_unchecked(s, lo)) {
        lo = lo + 1;
    }
    if lo == 0 {
        return s;
    }
    return std::str::range_copy(s, n, lo, n);
}

/// `s` without its trailing whitespace (space, tab, CR, LF: `trim`'s
/// set).
fn __str_trim_end(s: String) -> String {
    let n = len(s);
    let mut hi = n;
    while hi > 0 && __str_trim_space(std::str::byte_at_unchecked(s, hi - 1)) {
        hi = hi - 1;
    }
    if hi == n {
        return s;
    }
    return std::str::range_copy(s, n, 0, hi);
}

/// Whether `a` and `b` are equal with ASCII letters compared without
/// case: `A`–`Z` match `a`–`z`, every other byte (UTF-8 included) only
/// itself.
fn __str_eq_ignore_case(a: String, b: String) -> Bool {
    let n = len(a);
    if n != len(b) {
        return false;
    }
    let mut i = 0;
    while i < n {
        let mut x = std::str::byte_at_unchecked(a, i);
        let mut y = std::str::byte_at_unchecked(b, i);
        if x >= 65 && x <= 90 {
            x = x + 32;
        }
        if y >= 65 && y <= 90 {
            y = y + 32;
        }
        if x != y {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// `true` for `"true"`, `false` for `"false"`; anything else (another
/// case, surrounding space, `"1"`) is `ParseError { kind: "parse_bool",
/// input: s }`.
fn __str_parse_bool(s: String) -> Bool fallible(ParseError) {
    if s == "true" {
        return true;
    }
    if s == "false" {
        return false;
    }
    fail ParseError { kind: "parse_bool", input: s };
}

// The `for` sources (GH #1995 S2). `for part in std::str::split(s, sep)`,
// `for line in std::str::lines(s)` and `for w in std::str::words(s)` are
// not calls: the desugar sequence (`hale_syntax::str_sources`) rewrites
// each into one `while` over a view of `s`, measured once, with a cursor
// these hooks move. Per part: one `end` (a find, or a scan to the next
// boundary), one `next` (O(1) for split and lines, a scan over the
// separating whitespace for words) and one `std::str::slice` of the part.
// Every hook reads the view and returns an offset; none allocates.

/// The first cursor of `split(s, sep)`: 0, or past the end when `sep` is
/// empty, which splits nothing (as `split_into` pushes nothing).
fn __str_split_first(v: std::str::ByteView, sep: String) -> Int {
    if len(sep) == 0 {
        return v.n + 1;
    }
    return 0;
}

/// The end of the part of `split` that starts at `lo`: the next `sep`,
/// or the end of the view when there is none.
fn __str_split_end(v: std::str::ByteView, sep: String, lo: Int) -> Int {
    let hit = std::str::find(v, sep, lo);
    if hit < 0 {
        return v.n;
    }
    return hit;
}

/// Where the part after the one ending at `hi` starts: past the `sep`
/// at `hi`, or past the end of the view when `hi` is the end (the part
/// was the last).
fn __str_split_next(v: std::str::ByteView, sep: String, hi: Int) -> Int {
    if hi >= v.n {
        return v.n + 1;
    }
    return hi + len(sep);
}

/// The end of the line of `lines` that starts at `lo`: the next `\n` or
/// the end of the view, less one `\r` before it.
fn __str_line_end(v: std::str::ByteView, lo: Int) -> Int {
    let mut hi = std::str::find(v, "\n", lo);
    if hi < 0 {
        hi = v.n;
    }
    if hi > lo && std::str::byte_at_unchecked(v.text, hi - 1) == 13 {
        hi = hi - 1;
    }
    return hi;
}

/// Where the line after the one ending at `hi` starts: past the `\r`
/// `__str_line_end` left out and the `\n`. A line that ends the view
/// leaves the cursor at its end, so a final newline starts no line.
fn __str_line_next(v: std::str::ByteView, hi: Int) -> Int {
    let mut at = hi;
    if at < v.n && std::str::byte_at_unchecked(v.text, at) == 13 {
        at = at + 1;
    }
    if at < v.n && std::str::byte_at_unchecked(v.text, at) == 10 {
        at = at + 1;
    }
    return at;
}

/// Whether byte `c` is ASCII whitespace, what separates `words`: space,
/// tab, LF, vertical tab, form feed or CR.
fn __str_ascii_space(c: Int) -> Bool {
    return c == 32 || (c >= 9 && c <= 13);
}

/// The first byte at or after `at` that is not ASCII whitespace: where
/// the next word starts, or the end of the view when none does.
fn __str_word_start(v: std::str::ByteView, at: Int) -> Int {
    let mut i = at;
    while i < v.n && __str_ascii_space(std::str::byte_at_unchecked(v.text, i)) {
        i = i + 1;
    }
    return i;
}

/// The end of the word that starts at `lo`: the next ASCII whitespace,
/// or the end of the view.
fn __str_word_end(v: std::str::ByteView, lo: Int) -> Int {
    let mut i = lo;
    while i < v.n && !__str_ascii_space(std::str::byte_at_unchecked(v.text, i)) {
        i = i + 1;
    }
    return i;
}
