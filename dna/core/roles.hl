// dna/core/roles.hl — the record as a membership source (GH #1109,
// #1104 piece 5).
//
// Positions are roles. The head's api binding names this locus as its
// `roles:` source, and a principal holds a role when the record's
// graph has a live `holds` edge from the position the role names to a
// known person that principal is mapped to:
//
//   - the mapping is `git config --local --add dna.unix.member
//     "uid:1000=ada"` in the record's own config (never a global or an
//     included file), the shape `dna.oidc.member` has for an identity
//     provider's subjects: the principal as the binding names it
//     (`uid:<n>`), then the person the record knows. It is read again
//     whenever the record moves. A principal nobody mapped holds
//     nothing; a principal the binding could not authenticate holds
//     nothing whatever the mapping says.
//   - a person is known while the record holds no `person.retired` row
//     for them.
//   - a SERVICE — a program with no person behind it, presenting a token
//     of the issuer's `client_credentials` grant — is mapped by `git
//     config --local --add dna.oidc.service "<subject>=<service>"`. It
//     is never a person: it holds no position and no role, so every
//     gated command refuses it; what it may do is read (`service`).
//   - a `holds` edge is live from its `graph.edge` row — or from the
//     ratification of the graph proposal that carries it (`hale dna
//     fill`) — until a `graph.retired` row names the edge, its position
//     or its holder, or memory refused it (`hold.refused`); `HoldsReader`
//     reads it, for the socket's roles and a lease's position alike.
//   - a role names a position: `_` in the role is `/` in the position
//     (`role api_dev;` is `position:api/dev`; a position spelled with
//     `_` cannot be named by a role). `owner`, the role the full
//     description is gated on, is the board: `position:board`.
//     `position` is any live position at all: the role a leg's verbs
//     are gated on.
//
// The hierarchy (`role owner includes …`) is the program's and the
// binding walks it; this source answers only the direct question. The
// record is re-read when it has moved, so a holder changes only by the
// governed decision that wrote the row.

// Whether the binding vouched for `p`: a socket peer the kernel named
// (uid 0 or more), or a bearer the program's source named (GH #1135).
fn authenticated(p: std::api::Principal) -> Bool {
    if p.mode == "bearer" { return len(p.name) > 0; }
    return p.uid >= 0;
}

locus RecordRoles {
    params {
        root: String = "."; // the record; given where the source is built
        mapping: String = ""; // `uid:<n>=<person>` per line (fixtures); "" = the record's own `git config --local dna.unix.member`, re-read when the record moves
        oidc: String = ""; // GH #989: `<subject>=<person>` per line (fixtures); "" = the record's `git config --local dna.oidc.member`
        services: String = ""; // `<subject>=<service>` per line: the record's `git config --local dna.oidc.service`, re-read when the record moves
        memory: Bool = false; // a fixture's record: the rows `remember` was given, never git
        rows: EventRows = EventRows { };
        git: GitJournal = GitJournal { };
        opened: Bool = false;
        given: Bool = false; // the mapping was handed in, not read from the record
        oidc_given: Bool = false;
        trust: String = ""; // `dna.trust` as read from the record ("" = local); a fixture hands one in
        local_trust: Bool = false; // under local trust the person a peer maps to holds every position
        scanned: Int = -1; // the revision the live edges were read at
        looked: Int = 0; // when the git record was last asked whether it moved (monotonic ns)
        seats: HoldsReader = HoldsReader { }; // who holds what, as of `scanned`
    }
    fn open() {
        if self.opened { return; }
        self.opened = true;
        self.given = len(self.mapping) > 0;
        self.oidc_given = len(self.oidc) > 0;
        if len(self.root) == 0 { self.root = "."; }
        if !self.memory { self.git = GitJournal { repo: self.root }; }
    }
    fn revision() -> Int { return if self.memory { self.rows.len() } else { self.git.revision() }; }
    fn row(i: Int) -> Event { return if self.memory { self.rows.get(i) or Event { } } else { self.git.read(i) }; }
    // A fixture's row: the record in memory grows by what the fixture
    // writes, which is its domain bound.
    @unbounded
    fn remember(kind: String, entity: String, body: String) {
        self.rows.push(Event { seq: self.rows.len(), kind: kind, entity: entity, body: body });
    }
    // The mapping as the record's own local config holds it — `--local`
    // only, never a global or an included file — read again whenever the
    // record moves.
    // The mapping, and the trust the record declares: a record that
    // declares `dna.trust = local` — one person holding every authority,
    // as `hale dna new` declares for the record it makes — is that
    // person's: whoever a peer maps to holds every position, the board
    // included, so a fresh record is its maker's to work as soon as the
    // socket knows them. A record that declares nothing, or any other
    // trust, leaves it to the graph's `holds` edges. A fixture's memory
    // record says its trust in `trust`.
    fn read_mapping() {
        if self.memory {
            self.local_trust = self.trust == "local";
            return;
        }
        if !self.given {
            let r = self.git.record.git("config\n--local\n--get-all\ndna.unix.member");
            self.mapping = if r.code == 0 { r.stdout } else { "" };
        }
        if !self.oidc_given {
            let o = self.git.record.git("config\n--local\n--get-all\ndna.oidc.member");
            self.oidc = if o.code == 0 { o.stdout } else { "" };
        }
        let sv = self.git.record.git("config\n--local\n--get-all\ndna.oidc.service");
        self.services = if sv.code == 0 { sv.stdout } else { "" };
        let t = self.git.record.git("config\n--get\ndna.trust");
        self.local_trust = trim_nl(if t.code == 0 { t.stdout } else { "" }) == "local";
    }
    // The live holds edges and the retired people, as of the record now.
    // A git record is asked whether it moved at most once a second: the
    // question is a git call on the binding's own pool, and a holder
    // changes by a governed decision, not per request. The rows are
    // rebuilt in place, bounded by the record.
    @unbounded
    fn scan() {
        self.open();
        if !self.memory {
            let now = std::time::monotonic_ns();
            if self.scanned >= 0 && now - self.looked < 1000000000 { return; }
            self.looked = now;
            self.git.refresh();
        }
        let rev = self.revision();
        if rev == self.scanned { return; }
        self.scanned = rev;
        self.read_mapping();
        // GH #1162: one reader with the head's lease check, a filled holder
        // (a ratified proposal's edge) and a refused hold included
        self.seats = HoldsReader { location: if self.memory { "" } else { self.root } };
        let mut i = 0;
        while i < rev { self.seats.take(self.row(i)); i = i + 1; }
    }
    // Whether `p` holds `r` directly: mapped to a known person who holds
    // the position the role names — `owner` is the board, `position` any
    // live position at all, any other role the position spelled with `/`
    // where the role has `_`.
    @unbounded
    fn holds(p: std::api::Principal, r: String) -> Bool {
        if !authenticated(p) || len(r) == 0 { return false; }
        self.scan();
        let person = self.person_named(p);
        if len(person) == 0 || self.seats.is_retired(person) { return false; }
        if self.local_trust { return true; }
        if r == "position" { return self.seats.holds_any(person); }
        return self.seats.holds(person, if r == "owner" { "position:board" } else { "position:" + std::str::replace(r, "_", "/") });
    }
    // The person the record maps `p` to ("" when it maps nobody, or the
    // person was retired): who a command is recorded as coming from.
    fn person(p: std::api::Principal) -> String {
        if !authenticated(p) { return ""; }
        self.scan();
        let person = self.person_named(p);
        if len(person) == 0 || self.seats.is_retired(person) { return ""; }
        return person;
    }
    // The service a verified subject is, by the record's
    // `dna.oidc.service` ("" when it maps none). A subject the record
    // maps to a person is that person, never a service.
    fn service(subject: String) -> String {
        self.scan();
        if len(member_of(self.oidc, subject)) > 0 { return ""; }
        return member_of(self.services, subject);
    }
    // Whether the record maps `subject` as a service at all, whatever else
    // it maps it to: a subject mapped both ways is refused, never read as
    // either.
    fn service_mapped(subject: String) -> Bool {
        self.scan();
        return len(member_of(self.services, subject)) > 0;
    }
    // Whether the record maps `subject` to a person by `dna.oidc.member`,
    // whatever else it maps it to.
    fn member_mapped(subject: String) -> Bool {
        self.scan();
        return len(member_of(self.oidc, subject)) > 0;
    }
    // Who `p` names before retirement is asked: a bearer the binding's
    // HTTP transport verified as an OIDC subject (`oidc:<sub>`, GH #1135)
    // is that subject's person by `dna.oidc.member` — unless the record
    // also maps it as a service, which makes it neither: a service's token
    // never acts as a person; any other principal is its account's by
    // `dna.unix.member` (GH #989).
    fn person_named(p: std::api::Principal) -> String {
        if std::str::starts_with(p.name, "oidc:") {
            let subject = p.name[5..len(p.name)];
            if len(member_of(self.services, subject)) > 0 { return ""; }
            return member_of(self.oidc, subject);
        }
        return member_of(self.mapping, p.name);
    }
    // The positions `p`'s person holds by the record's holds edges,
    // space-separated ("" for nobody; under local trust the one person
    // holds every position without an edge naming one).
    fn positions(p: std::api::Principal) -> String {
        let person = self.person(p);
        return if len(person) == 0 { "" } else { self.seats.positions_of(person) };
    }
}

// Who holds what, as the record says it (GH #1162), read row by row in
// record order — one reader for the socket's roles (`RecordRoles`) and a
// lease's position (the head's claim): a `holds` edge written as a row,
// or one a ratified graph proposal carries (`hale dna fill`: the
// `knowledge.proposed` of kind `graph` whose stored document's rows hold
// it, read from the record at `location`); taken out by a
// `graph.retired` naming the edge, its position or its holder, by a
// `hold.refused` memory wrote for the edge, and for good by a
// `person.retired`. Bounded by the record it is fed.
locus HoldsReader {
    params {
        location: String = ""; // the record whose stored documents a ratified proposal's rows are read from ("" = none)
        live: String = "\n"; // `<id>\t<position>\t<holder>` per line
        proposed: String = "\n"; // graph proposals seen, one entity per line
        retired: String = "\n"; // people retired from the record, one per line
    }
    @unbounded
    fn take(e: Event) {
        if e.kind == "graph.edge" && std::json::find_string_field(e.body, "kind") == "holds" { self.add(e.entity, e.body); return; }
        if e.kind == "knowledge.proposed" && std::json::find_string_field(e.body, "kind") == "graph" { self.proposed = self.proposed + e.entity + "\n"; return; }
        if e.kind == "knowledge.ratified" && std::str::contains(self.proposed, "\n" + e.entity + "\n") && len(self.location) > 0 {
            let raw = if std::str::starts_with(e.entity, "sha256:") { e.entity[7..len(e.entity)] } else { e.entity };
            let mut rest = proposal_rows(GitRecord { repo: self.location }.body(raw).text);
            while len(rest) > 0 {
                let nl = std::str::index_of(rest, "\n");
                let row = if nl < 0 { rest } else { rest[0..nl] };
                rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
                let body = std::json::find_string_field(row, "body");
                if std::json::find_string_field(row, "kind") == "graph.edge" && std::json::find_string_field(body, "kind") == "holds" { self.add(std::json::find_string_field(row, "entity"), body); }
            }
            return;
        }
        if e.kind == "graph.retired" { self.drop(e.entity, true); return; }
        if e.kind == "hold.refused" { self.drop(e.entity, false); return; }
        if e.kind == "person.retired" {
            self.retired = self.retired + e.entity + "\n";
            self.drop(e.entity, true);
        }
    }
    @unbounded
    fn add(id: String, body: String) {
        let position = graph_member(body, "position");
        let holder = graph_member(body, "holder");
        if len(position) == 0 || len(holder) == 0 || std::str::contains(self.retired, "\n" + holder + "\n") { return; }
        self.live = self.live + id + "\t" + position + "\t" + holder + "\n";
    }
    // Every live edge `what` names: its id, or (`nodes`) its position or holder.
    @unbounded
    fn drop(what: String, nodes: Bool) {
        let mut kept = "\n";
        let mut rest = self.live[1..len(self.live)];
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let t1 = std::str::index_of(line, "\t");
            let tail = line[(t1 + 1)..len(line)];
            let t2 = std::str::index_of(tail, "\t");
            let gone = line[0..t1] == what || (nodes && (tail[0..t2] == what || tail[(t2 + 1)..len(tail)] == what));
            if !gone { kept = kept + line + "\n"; }
        }
        self.live = kept;
    }
    // Whether `person` holds `position`: in their own name, or as a member
    // of an organization that holds it (GH #1123) — the route's reading of
    // a firm-held position. A membership alone is no seat.
    @unbounded
    fn holds(person: String, position: String) -> Bool {
        if len(person) == 0 || !std::str::starts_with(position, "position:") { return false; }
        if std::str::contains(self.live, "\t" + position + "\t" + person + "\n") { return true; }
        let mut firms = self.memberships(person);
        while len(firms) > 0 {
            let nl = std::str::index_of(firms, "\n");
            if std::str::contains(self.live, "\t" + position + "\t" + firms[0..nl] + "\n") { return true; }
            firms = firms[(nl + 1)..len(firms)];
        }
        return false;
    }
    fn is_retired(person: String) -> Bool { return std::str::contains(self.retired, "\n" + person + "\n"); }
    // Whether `person` holds any position at all, in their own name or
    // through an organization: never by a membership alone.
    @unbounded
    fn holds_any(person: String) -> Bool {
        if len(person) == 0 { return false; }
        let holders = "\n" + person + "\n" + self.memberships(person);
        let mut rest = self.live[1..len(self.live)];
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let t1 = std::str::index_of(line, "\t");
            let tail = line[(t1 + 1)..len(line)];
            let t2 = std::str::index_of(tail, "\t");
            if std::str::starts_with(tail, "position:") && std::str::contains(holders, "\n" + tail[(t2 + 1)..len(tail)] + "\n") { return true; }
        }
        return false;
    }
    // The organizations `person` is a member of, one node id per line.
    @unbounded
    fn memberships(person: String) -> String {
        let mut out = "";
        let mut rest = self.live[1..len(self.live)];
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let t1 = std::str::index_of(line, "\t");
            let tail = line[(t1 + 1)..len(line)];
            let t2 = std::str::index_of(tail, "\t");
            if std::str::starts_with(tail, "organization:") && tail[(t2 + 1)..len(tail)] == person { out = out + tail[0..t2] + "\n"; }
        }
        return out;
    }
    // The positions `person` holds, space-separated, in the order held: in
    // their own name or through an organization they belong to (GH
    // #1123) — never an organization node itself.
    @unbounded
    fn positions_of(person: String) -> String {
        if len(person) == 0 { return ""; }
        let holders = "\n" + person + "\n" + self.memberships(person);
        let mut out = "";
        let mut rest = self.live[1..len(self.live)];
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let t1 = std::str::index_of(line, "\t");
            let tail = line[(t1 + 1)..len(line)];
            let t2 = std::str::index_of(tail, "\t");
            let position = tail[0..t2];
            if std::str::starts_with(position, "position:") && std::str::contains(holders, "\n" + tail[(t2 + 1)..len(tail)] + "\n") && !word_in(position, out) { out = out + (if len(out) > 0 { " " } else { "" }) + position; }
        }
        return out;
    }
}

// Whether the record at `repo` declares `dna.trust = local`: one person
// holding every position (unset is not local).
fn record_trust_local(repo: String) -> Bool {
    if len(repo) == 0 { return false; }
    let t = GitRecord { repo: repo }.git("config\n--get\ndna.trust");
    return t.code == 0 && trim_nl(t.stdout) == "local";
}

// The node a member of `role` names in a `graph.edge` body ("" when
// none): the first `{"role": …, "node": …}` object of `members` whose
// role is `role`.
@unbounded
fn graph_member(body: String, role: String) -> String {
    let members = std::json::find_field_raw(body, "members");
    let mut rest = members;
    while len(rest) > 0 {
        let open = std::str::index_of(rest, "{");
        if open < 0 { return ""; }
        let close = std::str::index_of(rest, "}");
        if close < open { return ""; }
        let obj = rest[open..(close + 1)];
        rest = rest[(close + 1)..len(rest)];
        if std::json::find_string_field(obj, "role") == role { return std::json::find_string_field(obj, "node"); }
    }
    return "";
}

// The graph rows a hole proposal carries (`hale dna init`: a
// `knowledge.proposed` of kind `graph` whose stored document holds
// `rows`), one `{"kind", "entity", "body"}` object per line: what the
// record gains when the Board ratifies it. Read by `hale dna fill` and
// by the head's position check, so a ratified hole names exactly the
// positions its own rows state (GH #1166).
@unbounded
fn proposal_rows(doc: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(std::json::find_field_raw(doc, "rows"));
    while !it.done {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("kind", std::json::find_string_field(it.element, "kind"));
        b.string_field("entity", std::json::find_string_field(it.element, "entity"));
        b.string_field("body", std::json::find_string_field(it.element, "body"));
        b.end_object();
        out = out + b.result() + "\n";
        it = std::json::array_next(it);
    }
    return out;
}
