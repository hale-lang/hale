// Knowledge in memory, read and commanded in-process (GH #985).
//
// The knowledge service that answered these over HTTP is gone. A graph read
// opens memory under the head's role (HALE_DNA_MEMORY_DSN_HEAD) and answers
// from the spine's projection as it stands: a projection that has not reached
// the record's head is `knowledge_projection_unavailable` until the body's
// tick applies it — the head reads, it never projects. A Knowledge command is
// admitted into the record by the operations' `KnowledgeCommands` in this
// process, under the explicit authority policy it always required.

type GraphRequest {
    ok: Bool = false;
    record_id: String = "";
    record_head: String = "";
    record_revision: String = "";
    reader: String = "";
    kind: String = "nodes";
    id: String = "";
    target: String = "";
    limit: Int = 25;
    cursor: String = "";
    snapshot: String = "";
    first: String = "";
    second: String = "";
    third: String = "";
}

locus GraphHttp {
    params { syntax: ops::OrganizationJson = ops::OrganizationJson { }; }
    fn response(status: Int, body: String) -> std::http::Response {
        return std::http::Response { status: status, content_type: "application/json; charset=utf-8", headers: "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff", body: body };
    }
    fn error(status: Int, code: String) -> std::http::Response {
        let b = std::json::Builder { };
        b.begin_object(); b.string_field("api_version", "hale.v1"); b.begin_object_field("error");
        b.string_field("code", code);
        b.string_field("message", if status == 400 { "Invalid Knowledge query." } else if status == 404 { "No such Knowledge node." } else if status == 409 { "Knowledge changed; begin a new read." } else { "Knowledge is unavailable for this read." });
        b.bool_field("retryable", status == 409 || status == 503);
        b.end_object(); b.end_object();
        return self.response(status, b.result());
    }
    fn plain(text: String, maximum: Int) -> Bool {
        let n = len(text);
        if n > maximum { return false; }
        let mut i = 0;
        while i < n {
            let c = std::str::byte_at_unchecked(text, i);
            if c < 32 || c == 127 { return false; }
            i = i + 1;
        }
        return true;
    }
    fn fields(body: String, strings: String, integers: String) -> Bool {
        if !self.syntax.valid(body) || !std::str::starts_with(std::str::trim(body), "{") { return false; }
        let mut it = std::json::object_first(body);
        while !it.done {
            let key = std::json::obj_key_string(it, body);
            let mut found = false;
            let mut i = 0;
            while i < dna::word_count(strings + " " + integers) {
                if dna::nth_word(strings + " " + integers, i) == key { found = true; }
                i = i + 1;
            }
            if !found { return false; }
            it = std::json::object_next(it, body);
        }
        let mut i = 0;
        while i < dna::word_count(strings) {
            let raw = std::json::find_field_raw(body, dna::nth_word(strings, i));
            if len(raw) < 2 || !std::str::starts_with(raw, "\"") { return false; }
            i = i + 1;
        }
        i = 0;
        while i < dna::word_count(integers) {
            let raw = std::json::find_field_raw(body, dna::nth_word(integers, i));
            let value = std::str::parse_int(raw) or - 1;
            if to_string(value) != raw { return false; }
            i = i + 1;
        }
        return true;
    }
    fn text(body: String, key: String) -> String { return self.syntax.decode(std::json::find_field_raw(body, key)); }
    fn unhex(raw: String) -> String {
        let n = len(raw);
        if n == 0 || n > 8192 || n % 2 != 0 { return ""; }
        let bytes = std::bytes::BytesBuilder { };
        let mut i = 0;
        while i < n {
            let a = std::str::byte_at_unchecked(raw, i);
            let b = std::str::byte_at_unchecked(raw, i + 1);
            if !self.syntax.hex(a) || !self.syntax.hex(b) { return ""; }
            let value = self.syntax.hex_value(a) * 16 + self.syntax.hex_value(b);
            if value == 0 { return ""; }
            bytes.append_u8(value);
            i = i + 2;
        }
        return std::str::from_bytes(bytes.snapshot());
    }
    fn request(body: String) -> GraphRequest {
        if len(body) > 16384 || !self.fields(body, "record_id record_head record_revision reader kind id target cursor snapshot", "limit") { return GraphRequest { }; }
        let mut r = GraphRequest {
            record_id: self.text(body, "record_id"), record_head: self.text(body, "record_head"), record_revision: self.text(body, "record_revision"),
            reader: self.text(body, "reader"), kind: self.text(body, "kind"), id: self.text(body, "id"), target: self.text(body, "target"),
            limit: std::json::find_int_field(body, "limit"), cursor: self.text(body, "cursor"), snapshot: self.text(body, "snapshot")
        };
        if len(r.record_id) == 0 || !self.plain(r.record_id, 128) || len(r.record_head) == 0 || !self.plain(r.record_head, 128) || len(r.reader) == 0 || !self.plain(r.reader, 256) || !self.plain(r.target, 1024) { return GraphRequest { }; }
        let revision = std::str::parse_int(r.record_revision) or - 1;
        if revision < 1 || to_string(revision) != r.record_revision || r.limit < 1 || r.limit > 100 { return GraphRequest { }; }
        if r.kind != "nodes" && r.kind != "edges" && r.kind != "bindings" && r.kind != "dependents" { return GraphRequest { }; }
        if (r.kind != "nodes" && len(r.id) == 0) || (len(r.id) > 0 && !dna::digest_well_formed(r.id)) { return GraphRequest { }; }
        if len(r.snapshot) > 0 && !dna::digest_well_formed(r.snapshot) { return GraphRequest { }; }
        if len(r.cursor) > 0 {
            if len(r.snapshot) == 0 { return GraphRequest { }; }
            let cursor = self.unhex(r.cursor);
            if !self.fields(cursor, "snapshot kind id target limit first second third", "") { return GraphRequest { }; }
            if self.text(cursor, "snapshot") != r.snapshot || self.text(cursor, "kind") != r.kind || self.text(cursor, "id") != r.id || self.text(cursor, "target") != r.target || self.text(cursor, "limit") != to_string(r.limit) { return GraphRequest { }; }
            r.first = self.text(cursor, "first"); r.second = self.text(cursor, "second"); r.third = self.text(cursor, "third");
        }
        let rules = dna::GraphRules { };
        if len(rules.validate(self.query(r))) > 0 { return GraphRequest { }; }
        r.ok = true;
        return r;
    }
    fn query(r: GraphRequest) -> dna::GraphQuery {
        // Edges are incident relationships, not target applicability claims.
        // Keep target in the public basis while filtering bindings/nodes only.
        return dna::GraphQuery { kind: if r.kind == "dependents" { "bindings" } else { r.kind }, id: r.id, target: if r.kind == "edges" { "" } else { r.target }, after_first: r.first, after_second: r.second, after_third: r.third, limit: r.limit };
    }
    fn record_budget(record: dna::Journal) -> Bool {
        let n = record.revision();
        if n < 1 || n > 10000 { return false; }
        let mut remaining = 8388608;
        let mut i = 0;
        while i < n {
            let e = record.read(i);
            let size = len(e.kind) + len(e.entity) + len(e.body);
            if size > remaining { return false; }
            remaining = remaining - size;
            i = i + 1;
        }
        return true;
    }
    fn cursor(r: GraphRequest, page: dna::GraphPage, snapshot: String) -> String {
        let b = std::json::Builder { };
        b.begin_object(); b.string_field("snapshot", snapshot); b.string_field("kind", r.kind); b.string_field("id", r.id); b.string_field("target", r.target);
        b.string_field("limit", to_string(r.limit)); b.string_field("first", page.last_first); b.string_field("second", page.last_second); b.string_field("third", page.last_third); b.end_object();
        return dna::hex(std::bytes::from_string(b.result()));
    }
    fn basis(r: GraphRequest, policy: ops::KnowledgeVisibilityBasis, page: dna::GraphPage) -> String {
        let b = std::json::Builder { };
        b.begin_object(); b.string_field("record_id", r.record_id); b.string_field("projection_record_head", r.record_head);
        b.string_field("projection_record_revision", r.record_revision); b.string_field("projection_watermark", to_string(page.watermark)); b.string_field("store_generation", to_string(page.generation));
        b.string_field("routing_version", to_string(policy.routing)); b.string_field("visibility_record_head", policy.record_head); b.string_field("visibility_record_revision", to_string(policy.record_revision));
        if policy.routing > 0 { b.string_field("visibility_ledger_head", policy.ledger_head); b.string_field("visibility_ledger_revision", to_string(policy.ledger_revision)); }
        else { b.field("visibility_ledger_head", "null"); b.field("visibility_ledger_revision", "null"); }
        b.string_field("reader_scope", dna::digest_of("knowledge-reader/1\n" + r.reader)); b.string_field("target", r.target); b.string_field("coverage", "native_ideas_edges_bindings"); b.end_object();
        return b.result();
    }
}

locus GraphItems {
    params { policy: dna::KnowledgeReadPolicy; bytes: std::bytes::BytesBuilder = std::bytes::BytesBuilder { }; count: Int = 0; size: Int = 0; target: String = ""; }
    // Native graph text can approach the response budget. The current stdlib
    // quote helper retains one growing String prefix per byte; encode each
    // value with a byte buffer before passing its raw JSON to the fixed shape.
    fn quote(value: String) -> String {
        let bytes = std::bytes::BytesBuilder { };
        let size = len(value);
        bytes.append_u8(34);
        let mut at = 0;
        while at < size {
            let c = std::str::byte_at_unchecked(value, at);
            if c == 34 { bytes.append_str("\\\""); }
            else if c == 92 { bytes.append_str("\\\\"); }
            else if c == 8 { bytes.append_str("\\b"); }
            else if c == 12 { bytes.append_str("\\f"); }
            else if c == 10 { bytes.append_str("\\n"); }
            else if c == 13 { bytes.append_str("\\r"); }
            else if c == 9 { bytes.append_str("\\t"); }
            else if c < 32 {
                bytes.append_str("\\u00");
                bytes.append_u8(std::str::byte_at_unchecked("0123456789abcdef", c / 16));
                bytes.append_u8(std::str::byte_at_unchecked("0123456789abcdef", c % 16));
            } else { bytes.append_u8(c); }
            at = at + 1;
        }
        bytes.append_u8(34);
        return std::str::from_bytes(bytes.snapshot());
    }
    fn append(item: String) -> Bool {
        if len(item) > 1000000 - self.size || self.count >= 100 { return false; }
        if self.count > 0 { self.bytes.append_str(","); }
        self.bytes.append_str(item); self.count = self.count + 1; self.size = self.size + len(item) + 1;
        return true;
    }
    fn node(row: dna::Stored) -> Bool {
        let i = row.idea;
        if len(i.id) + len(i.kind) + len(i.text) + len(i.author) + len(i.name) + len(i.supersedes) + len(i.provenance) > 1000000 - self.size { return false; }
        let b = std::json::Builder { };
        b.begin_object(); b.field("id", self.quote(i.id)); b.field("kind", self.quote(i.kind)); b.field("text", self.quote(i.text)); b.field("author", self.quote(i.author));
        b.field("projection_state", self.quote(i.provenance)); b.string_field("revision", to_string(i.revision)); b.bool_field("accepted", i.accepted);
        b.field("name", self.quote(i.name)); b.field("supersedes", self.quote(if self.policy.visible(i.supersedes) { i.supersedes } else { "" })); b.string_field("ratified_seq", to_string(row.ratified_seq)); b.field("source_provenance", "null"); b.end_object();
        return self.append(b.result());
    }
    fn edge(e: dna::KnowledgeEdge) -> Bool {
        let key = std::json::Builder { };
        key.begin_array(); key.value(self.quote(e.from)); key.value(self.quote(e.to)); key.value(self.quote(e.rel)); key.end_array();
        let b = std::json::Builder { };
        b.begin_object(); b.string_field("id", dna::digest_of(key.result())); b.field("from_id", self.quote(e.from)); b.field("to_id", self.quote(e.to)); b.field("rel", self.quote(e.rel)); b.end_object();
        return self.append(b.result());
    }
    fn binding(v: dna::KnowledgeBinding) -> Bool {
        let key = std::json::Builder { };
        key.begin_array(); key.value(self.quote(v.idea)); key.value(self.quote(v.target)); key.value(self.quote(v.author)); key.end_array();
        let b = std::json::Builder { };
        b.begin_object(); b.string_field("id", dna::digest_of(key.result())); b.field("idea_id", self.quote(v.idea)); b.field("target", self.quote(v.target)); b.field("author", self.quote(v.author)); b.field("class", self.quote(v.class));
        b.string_field("applicability", if len(self.target) == 0 { "unfiltered" } else if v.target == self.target { "exact" } else { "ancestor" }); b.end_object();
        return self.append(b.result());
    }
    fn result() -> String { return "[" + std::str::clone(self.bytes.text_view()) + "]"; }
}

fn graph_read(r: GraphRequest, store: dna::KnowledgeStore, graph: dna::GraphStore, record: dna::GitJournal, ledger: dna::LedgerView) -> std::http::Response {
    let http = GraphHttp { };
    if record.genesis() != r.record_id || store.record() != r.record_id { return http.error(503, "knowledge_scope_mismatch"); }
    if record.head() != r.record_head || to_string(record.revision()) != r.record_revision { return http.error(409, "snapshot_changed"); }
    if !http.record_budget(record) { return http.error(503, "knowledge_read_limit"); }
    let mut seq = 0;
    while seq < record.revision() {
        let e = record.read(seq);
        if e.kind == "person.retired" && e.entity == r.reader { return http.error(403, "knowledge_unavailable"); }
        seq = seq + 1;
    }
    let policy = ops::KnowledgeVisibility { record: record, ledger: ledger, syntax: ops::OrganizationJson { } };
    let captured = policy.load();
    if !captured.available { return http.error(if captured.error == "snapshot_changed" { 409 } else { 503 }, captured.error); }
    if captured.record_head != r.record_head || to_string(captured.record_revision) != r.record_revision { return http.error(409, "snapshot_changed"); }
    let items = GraphItems { target: r.target, policy: policy };
    let page = graph.read_graph(http.query(r), policy, items);
    if !page.ok { return http.error(if page.error == "invalid_query" { 400 } else { 503 }, if page.error == "read_limit" { "knowledge_read_limit" } else if page.error == "knowledge_unsupported" || page.error == "invalid_query" { page.error } else { "knowledge_unavailable" }); }
    if page.record != r.record_id { return http.error(503, "knowledge_scope_mismatch"); }
    if page.watermark != captured.record_revision || page.projection_head != r.record_head { return http.error(503, "knowledge_projection_unavailable"); }
    let basis = http.basis(r, captured, page);
    let snapshot = dna::digest_of(basis);
    if len(r.snapshot) > 0 && r.snapshot != snapshot { return http.error(409, "snapshot_changed"); }
    // Check existence only after comparing the complete basis: a Ledger
    // restriction can hide this node without moving the Record. An old view
    // must then refresh, rather than mistaking that change for a stable 404.
    let absent = len(r.id) > 0 && (!page.subject_present || (r.kind == "nodes" && items.count == 0));
    let cursor = if page.has_more { http.cursor(r, page, snapshot) } else { "" };
    if len(cursor) > 8192 { return http.error(503, "knowledge_read_limit"); }
    let b = std::json::Builder { };
    b.begin_object(); b.string_field("api_version", "hale.v1"); b.begin_object_field("source"); b.string_field("record_id", r.record_id); b.string_field("record_head", r.record_head); b.string_field("record_revision", r.record_revision); b.end_object();
    b.begin_object_field("data"); b.field("items", items.result()); b.begin_object_field("page"); b.int_field("limit", r.limit); b.int_field("returned", items.count); b.bool_field("has_more", page.has_more);
    if page.has_more { b.string_field("next_cursor", cursor); } else { b.field("next_cursor", "null"); }
    b.string_field("snapshot", snapshot); b.end_object(); b.field("basis", basis); b.begin_object_field("coverage");
    b.string_field("bindings", "complete"); b.string_field("runs", "unavailable"); b.string_field("definitions", "unavailable"); b.string_field("practices", "unavailable"); b.end_object(); b.end_object(); b.end_object();
    let body = b.result();
    if len(body) > 1048576 { return http.error(503, "knowledge_read_limit"); }
    let generation = graph.graph_generation();
    if generation < 0 { return http.error(503, "knowledge_unavailable"); }
    if generation != page.generation { return http.error(409, "snapshot_changed"); }
    if !policy.unchanged() { return http.error(if policy.basis.error == "snapshot_changed" { 409 } else { 503 }, policy.basis.error); }
    if absent { return http.error(404, "knowledge_not_found"); }
    return http.response(200, body);
}

// The request a command handler reads (an HTTP request, minus
// what only a transport has).
type LocalCommandRequest { method: String = "POST"; path: String = ""; body: String = ""; }

locus KnowledgeLocalWire {
    params { }
    fn receipt(r: ops::KnowledgeReceipt) -> String {
        let c = ops::KnowledgeCommandCodec { }; let b = std::bytes::BytesBuilder { };
        b.append_str("{\"details_visible\":"); b.append_str(if r.details_visible { "true" } else { "false" });
        c.field(b, "command_id", r.command_id); c.field(b, "request_id", r.request_id); c.field(b, "application_id", r.application_id);
        c.field(b, "principal_mode", r.principal_mode); c.field(b, "principal_name", r.principal_name);
        c.field(b, "operation", r.operation); c.field(b, "operation_version", r.operation_version); c.field(b, "position_id", r.position_id);
        c.field(b, "target_id", r.target_id); c.field(b, "fingerprint", r.fingerprint); c.field(b, "state", r.state); c.field(b, "edge_id", r.edge_id);
        c.field(b, "event_id", r.event_id); c.field(b, "admission_head", r.admission_head); c.field(b, "authority", r.authority); c.field(b, "authority_basis", r.authority_basis);
        b.append_str(",\"sequence\":"); b.append_str(to_string(r.sequence));
        let node = ops::KnowledgeNodeCommandCodec { };
        if node.known(r.operation) {
            b.append_str(",\"node\":{\"proposal_state\":"); let wire = ops::GovernanceCommandCodec { }; b.append_str(wire.quote(r.node.proposal_state));
            c.field(b, "candidate_digest", r.node.candidate_digest); c.field(b, "review_id", r.node.review_id);
            c.field(b, "review_state", r.node.review_state); c.field(b, "review_outcome", r.node.review_outcome);
            c.field(b, "activation_state", r.node.activation_state); c.field(b, "activation_reason", r.node.activation_reason); c.field(b, "reason", r.node.reason); b.append_str("}");
        }
        let binding = ops::KnowledgeBindingCommandCodec { };
        if binding.known(r.operation) {
            b.append_str(",\"binding\":{\"binding_id\":"); let wire = ops::GovernanceCommandCodec { }; b.append_str(wire.quote(r.binding.binding_id));
            c.field(b, "proposal_state", r.binding.proposal_state); c.field(b, "candidate_digest", r.binding.candidate_digest); c.field(b, "review_id", r.binding.review_id);
            c.field(b, "review_state", r.binding.review_state); c.field(b, "review_outcome", r.binding.review_outcome);
            c.field(b, "effect_state", r.binding.effect_state); c.field(b, "effect_reason", r.binding.effect_reason); c.field(b, "reason", r.binding.reason); b.append_str("}");
        }
        if r.reviewed {
            b.append_str(",\"relationship\":{\"proposal_state\":"); let wire = ops::GovernanceCommandCodec { }; b.append_str(wire.quote(r.relationship.proposal_state));
            c.field(b, "candidate_digest", r.relationship.candidate_digest); c.field(b, "review_id", r.relationship.review_id);
            c.field(b, "review_state", r.relationship.review_state); c.field(b, "review_outcome", r.relationship.review_outcome);
            c.field(b, "effect_state", r.relationship.effect_state); c.field(b, "effect_reason", r.relationship.effect_reason); c.field(b, "reason", r.relationship.reason); b.append_str("}");
        }
        b.append_str("}");
        return std::str::from_bytes(b.snapshot());
    }
    fn result(r: ops::KnowledgeResult) -> String {
        let c = ops::KnowledgeCommandCodec { }; let b = std::bytes::BytesBuilder { };
        b.append_str("{\"ok\":"); b.append_str(if r.ok { "true" } else { "false" });
        c.field(b, "code", r.code); c.field(b, "application_id", r.application_id); c.field(b, "head", r.head);
        b.append_str(",\"revision\":"); b.append_str(to_string(r.revision)); b.append_str(",\"receipt\":"); b.append_str(self.receipt(r.receipt)); b.append_str("}");
        return std::str::from_bytes(b.snapshot());
    }
    fn capability(c: ops::KnowledgeCapability) -> String {
        let wire = ops::GovernanceCommandCodec { };
        return "{\"available\":" + (if c.available { "true" } else { "false" }) + ",\"authorized\":" + (if c.authorized { "true" } else { "false" })
            + ",\"mode\":" + wire.quote(c.mode) + ",\"reason\":" + wire.quote(c.reason) + ",\"policy_basis\":" + wire.quote(c.policy_basis) + "}";
    }
    fn response(result: ops::KnowledgeResult, submitting: Bool) -> std::http::Response {
        let code = result.code;
        let status = if result.ok { if submitting { 202 } else { 200 } }
        else if code == "invalid_command" { 400 } else if code == "forbidden" { 403 }
        else if code == "command_not_found" { 404 }
        else if code == "stale_subject" || code == "request_conflict" || code == "command_context_changed" { 409 } else { 200 };
        // The local wire carries typed domain refusals as successful
        // exchanges. The public adapter assigns their browser HTTP status.
        // Native Client discards 5xx bodies even with retries disabled; using
        // 5xx here would erase Review-required and uncertain-outcome codes.
        return std::http::Response { status: status, content_type: "application/json", headers: "Cache-Control: no-store", body: self.result(result) };
    }
    // One command, in-process (GH #985): `kind` is capability | lookup | submit.
    fn handle(kind: String, body: String, commands: ops::KnowledgeCommands) -> std::http::Response {
        let req = LocalCommandRequest { path: "/graph/commands/" + kind, body: body };
        let submit = req.path == "/graph/commands/submit";
        let lookup = req.path == "/graph/commands/lookup";
        let capability = req.path == "/graph/commands/capability";
        if !submit && !lookup && !capability { return self.response(ops::KnowledgeResult { code: "invalid_command" }, false); }
        let syntax = ops::OrganizationJson { }; let fields = ops::DefinitionCodec { }; let shape = ops::AuthorityPolicyCodec { }; let wire = ops::GovernanceCommandCodec { };
        let named = capability && len(std::json::find_field_raw(req.body, "operation")) > 0;
        if len(req.body) > 98304 || !syntax.valid(req.body) || !shape.fields(req.body, if submit { "context command" } else if lookup { "context request_id" } else if named { "context operation" } else { "context" }, if capability && !named { 1 } else { 2 }) { return self.response(ops::KnowledgeResult { code: "invalid_command" }, false); }
        let raw = std::json::find_field_raw(req.body, "context");
        if !fields.fields(raw, "application_id principal_mode principal_name", "") { return self.response(ops::KnowledgeResult { code: "invalid_command" }, false); }
        let context = ops::GovernanceContext { application_id: wire.string(raw, "application_id"), principal_mode: wire.string(raw, "principal_mode"), principal_name: wire.string(raw, "principal_name") };
        if !wire.context_valid(context) { return self.response(ops::KnowledgeResult { code: "invalid_command" }, false); }
        if capability {
            let operation = if named { wire.string(req.body, "operation") } else { "dna.knowledge.edge.link" };
            let node = ops::KnowledgeNodeCommandCodec { };
            let binding = ops::KnowledgeBindingCommandCodec { };
            if operation != "dna.knowledge.edge.link" && operation != "dna.knowledge.edge.unlink" && !node.known(operation) && !binding.known(operation) { return self.response(ops::KnowledgeResult { code: "invalid_command" }, false); }
            return std::http::Response { status: 200, content_type: "application/json", headers: "Cache-Control: no-store", body: self.capability(commands.capability_for(context, operation)) };
        }
        if lookup { return self.response(commands.lookup(context, wire.string(req.body, "request_id")), false); }
        let codec = ops::KnowledgeCommandCodec { };
        let command = codec.decode(context, std::json::find_field_raw(req.body, "command")); let node = ops::KnowledgeNodeCommandCodec { };
        if !node.known(command.operation) && len(req.body) > 32768 { return self.response(ops::KnowledgeResult { code: "invalid_command" }, false); }
        return self.response(commands.submit(context, command), true);
    }
}

fn knowledge_policy(root: String) -> ops::KnowledgePolicy {
    let path = std::env::var("HALE_DNA_KNOWLEDGE_COMMAND_POLICY");
    if len(path) == 0 { return ops::KnowledgePolicy { }; }
    let size = std::io::fs::file_size(path) or - 1;
    if size < 1 || size > 65536 {
        eprintln("hale dna api: Knowledge commands require an explicit bounded authority policy (HALE_DNA_KNOWLEDGE_COMMAND_POLICY)"); std::process::exit(2);
    }
    let record = dna::GitRecord { repo: root };
    let configured = record.git("config\n--get\ndna.trust");
    if configured.code != 0 && configured.code != 1 { eprintln("hale dna api: cannot read Record trust policy"); std::process::exit(2); }
    let declared = dna::trim_nl(configured.stdout);
    let wire = ops::KnowledgePolicyCodec { };
    let policy = wire.decode(std::io::fs::read_file(path) or "", record.identity(), if len(declared) == 0 { "local" } else { declared });
    if !policy.valid { eprintln("hale dna api: invalid command authority policy or Record trust mode"); std::process::exit(2); }
    return policy;
}

// Graph reads from memory under the head's role.
locus LocalKnowledge {
    params {
        root: String = ".";
        dsn_env: String = dna::HEAD_DSN_ENV;
        // the API's one handle on memory (GH #985): the graph store and the
        // ledger, opened on the first read and held for the process's life
        store: dna::Pq = dna::Pq { };
        memory: dna::Memory = dna::Memory { };
    }
    birth() {
        self.store.dsn_env = self.dsn_env;
        self.memory.point(self.root, self.dsn_env);
    }
    fn supported() -> Bool { return dna::dsn_set(self.dsn_env); }
    fn read(request: KnowledgeRequest) -> KnowledgeUpstream {
        let wire = KnowledgeWire { };
        let body = wire.request_json(request);
        let http = GraphHttp { };
        if len(body) > 16384 { return KnowledgeUpstream { }; }
        let q = http.request(body);
        if !q.ok { let e = http.error(400, "invalid_query"); return KnowledgeUpstream { transport_ok: true, status: e.status, body: e.body }; }
        let j = dna::GitJournal { repo: self.root, author: "api" };
        let moved = j.refresh();
        // the store follows the record's identity, and a session that no
        // longer answers is dialled again; otherwise the one it holds serves
        self.store.scope(j.genesis());
        if !self.store.healthy() && !self.store.reopen() {
            // one dial, answered at once when memory refuses it (GH #1030);
            // why goes to the operator, not into the response
            eprintln("hale dna api: knowledge read: memory unavailable: " + self.store.last_error());
            let e = http.error(503, "knowledge_unavailable");
            return KnowledgeUpstream { transport_ok: true, status: e.status, body: e.body };
        }
        let r = graph_read(q, self.store, self.store, j, self.memory.ledger);
        return KnowledgeUpstream { transport_ok: true, status: r.status, body: r.body };
    }
}

// Knowledge commands admitted into the record in this process.
locus LocalKnowledgeCommands {
    params {
        root: String = ".";
        // read once, when the API starts: an edit to the file does not
        // change the basis a running API decides on
        policy: ops::KnowledgePolicy = ops::KnowledgePolicy { };
    }
    birth() { if self.supported() { self.policy = knowledge_policy(self.root); } }
    fn supported() -> Bool { return len(std::env::var("HALE_DNA_KNOWLEDGE_COMMAND_POLICY")) > 0; }
    fn send(kind: String, body: String) -> KnowledgeUpstream {
        if !self.supported() || len(body) == 0 || len(body) > 98304 { return KnowledgeUpstream { }; }
        let authority = ops::FixedKnowledgeAuthority { policy: self.policy };
        let record = dna::GitRecord { repo: self.root };
        let commands = ops::KnowledgeCommands { record: record, authority: authority, sign: self.policy.sign };
        let wire = KnowledgeLocalWire { };
        let r = wire.handle(kind, body, commands);
        return KnowledgeUpstream { transport_ok: true, status: r.status, body: r.body };
    }
    fn capability(context: CommandContext) -> KnowledgeUpstream {
        return self.capability_for(context, "dna.knowledge.edge.link");
    }
    fn capability_for(context: CommandContext, operation: String) -> KnowledgeUpstream {
        let wire = KnowledgeCommandWire { };
        return self.send("capability", wire.private_request(context, "capability", ops::KnowledgeCommand { operation: operation }, ""));
    }
    fn submit(context: CommandContext, command: ops::KnowledgeCommand) -> KnowledgeUpstream {
        let wire = KnowledgeCommandWire { };
        return self.send("submit", wire.private_request(context, "submit", command, ""));
    }
    fn lookup(context: CommandContext, request_id: String) -> KnowledgeUpstream {
        let wire = KnowledgeCommandWire { };
        return self.send("lookup", wire.private_request(context, "lookup", ops::KnowledgeCommand { }, request_id));
    }
}
