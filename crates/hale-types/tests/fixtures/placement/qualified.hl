// Case 4: a qualified stdlib type beside a user locus whose name is
// its last segment. Each declaration is placed by its own instances.
fn ignore_conn(s: std::io::tcp::Stream) { }

locus Listener {
    params {
        n: Int = 0;
    }
}

main locus App {
    params {
        l: std::io::tcp::Listener = std::io::tcp::Listener {
            host: "127.0.0.1",
            port: 0,
            max_accepts: -1,
            on_connection: ignore_conn,
        };
        own: Listener = Listener { };
    }
    placement {
        l: cooperative(pool = io);
    }
}

fn main() { App { }; }
