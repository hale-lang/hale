// dna/organism — the reference organism (GH #527 B6, #986): the DNA
// assembly behind the NERVES, two typed topics bound to pond's NATS
// adapter in the main locus's `bindings { }`:
//
//   dna.review.verdict   a human's verdict on a pending Review
//   dna.intent.offered   intent entering the organism
//
// A node (`hale dna run` / `dev`) publishes them once their rows are in
// the record; they arrive here through the organization's durable
// consumer on the stream, under the organization's token. Nothing
// crosses through the observation segment. The owning locus decides: a
// verdict goes through the Review's own admission (digest pin,
// authority, independence), an intent through the gate and the engine.
// The edge is a declared route in the fleet model, so `hale fleet check`
// sees it.
//
//   hale build dna/organism && ./dna/organism/organism
//
// with HALE_DNA_NATS_URL_SPINE and HALE_DNA_NATS_ORG naming the nerves
// (`hale dna nerves migrate` prints both). The pending Review `r1` stands
// in for the first governed workflow (ratify the declared purpose).

import "../core" as dna;
import "../core/pond/realtime/nats" as nats;

main locus Organism {
    params {
        dna: dna::Dna = dna::Dna { };
        review: dna::Review = dna::Review {
            review_id: "r1",
            question: "ratify the declared purpose?",
            subject_digest: "sha256:purpose-v1",
            required_authority: "maintainer",
            author: "organism"
        };
        reported_asked: Int = 0;
        reported_refused: Int = 0;
        reported_settled: Bool = false;
        // 0 = run until killed; otherwise the number of 100ms ticks.
        ticks: Int = 0;
        nerves: nats::NatsConn = nats::NatsConn { url: dna::nerves_spine_url(), name: "organism", subject_prefix: dna::nerves_prefix(dna::nerves_org()), stream: dna::nerves_stream(dna::nerves_org()), consumer: nats::ConsumerSpec { durable: dna::NERVES_DURABLE, filter: dna::nerves_filter(dna::nerves_org()) } };
    }

    placement { nerves: pinned; }
    bindings {
        dna::ReviewVerdict: nats::NatsAdapter { };
        dna::IntentOffered: nats::NatsAdapter { };
    }

    // Report every transition the nerves drive on stdout: what the
    // organism DECIDED, in its own words, never what the transport
    // carried.
    fn report() {
        if self.dna.asked > self.reported_asked {
            self.reported_asked = self.dna.asked;
            println("organism: intent accepted, task ", self.dna.last_task, " born");
        }
        if self.review.refused > self.reported_refused {
            self.reported_refused = self.review.refused;
            println("organism: review r1 refused a verdict: ", self.review.last_refusal);
        }
        if self.review.settled && !self.reported_settled {
            self.reported_settled = true;
            println("organism: review r1 settled ", self.review.outcome, " by ", self.review.decided_by);
        }
    }

    run() {
        println("organism: listening on the nerves");
        let mut t = 0;
        while self.ticks == 0 || t < self.ticks {
            std::time::sleep(100ms);
            self.report();
            t = t + 1;
        }
        println("organism: window closed");
    }
}

fn main() {
    Organism { };
}
