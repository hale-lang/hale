// dna/tests/nerves_compose_test.hl — the nerves `hale dna init` writes,
// as `hale dna dev` runs them (GH #986).
//
// With no NATS server named (HALE_DNA_NATS_URL_OWNER unset), `dev` brings
// up the `nerves` service of the project's own dna/compose.yaml — NATS
// with JetStream, configured by dna/nats.conf: one user per family of
// subjects, each allowed only its own. It creates the organization's
// stream as the owner and hands the host the spine's user alone. The
// organization reads its facts through the durable consumer that user
// may pull, and a task asked from the clone is born: the relay, the
// stream, the consumer and every permission they need, on the
// configuration a project runs. The passwords are the seed's own (GH
// #989): drawn into the vault by init, rotated by upgrade, written into
// the untracked, mode-600 dna/nats.secrets.conf, never into the tracked
// dna/nats.conf; a tracked secrets file is refused, and so is a vault
// with nothing in it. Without docker compose, or without memory's owner
// DSN, nothing here is exercised.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, with no NATS server named:
// `dev` must use compose's, under the seed's own compose project (its
// name is this run's). The vault is this run's own (HALE_VAULT_DIR under
// the scratch root).
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_VAULT_DIR=\"$2\" && shift 2 && unset COMPOSE_PROJECT_NAME ANTHROPIC_API_KEY OPENAI_API_KEY HALE_DNA_NATS_URL_OWNER HALE_DNA_NATS_URL_SPINE HALE_DNA_NATS_ORG HALE_VAULT_ADDR && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + vault_of(dir) + "\n" + argv);
}

// The scratch root's vault: `/tmp/dna-nerves-compose-<pid>/vault`.
fn vault_of(dir: String) -> String {
    let at = std::str::index_of(dir, "/nervous");
    return (if at > 0 { dir[0..at] } else { dir }) + "/vault";
}

main locus App {
    params { app: String = ""; }
    fn log() -> String { return std::io::fs::read_file(self.app + "/.hale/dev.log") or ""; }
    // Whether the host's log comes to say `text` within `secs`.
    @unbounded
    fn logged(text: String, secs: Int) -> Bool {
        let deadline = std::time::now() + dna::wait_secs(secs);
        while std::time::now() <= deadline {
            if std::str::contains(self.log(), text) { return true; }
            std::time::sleep(500ms);
        }
        return false;
    }
    run() {
        if !std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { eprintln("nerves_compose_test: not exercised (HALE_DNA_MEMORY_DSN_OWNER is not set)"); return; }
        if dna::run_tool("docker\ncompose\nversion").code != 0 { eprintln("nerves_compose_test: not exercised (docker compose is not on PATH)"); return; }
        let scratch = dna::scratch_root("nerves-compose");
        dna::reap_on_exit(scratch);
        let name = "nervous" + to_string(std::process::pid());
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\n" + name);
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        self.app = scratch + "/" + name;
        let compose = std::io::fs::read_file(self.app + "/dna/compose.yaml") or "";
        std::test::assert(std::str::contains(compose, "\nname: hale-dna-" + name + "\n"), "the seed's compose is a project of its own: " + compose);
        let conf = std::io::fs::read_file(self.app + "/dna/nats.conf") or "";
        std::test::assert(std::str::contains(conf, "user: spine") && std::str::contains(conf, "jetstream"), "init writes the nerves' server configuration: " + conf);
        // GH #989: the conf is tracked and holds no password; the secrets
        // file does, drawn by the bootstrap with the vault, mode 600, ignored
        let secrets = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";
        let at = std::str::index_of(secrets, "NATS_SPINE_PASSWORD: \"");
        let spine_pw = if at < 0 { "" } else { secrets[(at + 22)..(at + 54)] };
        let org = dna::schema_for(dna::GitRecord { repo: self.app }.identity());
        let vault_env = "HALE_VAULT_DIR=" + scratch + "/vault";
        let matched = dna::run_tool("env\n" + vault_env + "\n" + toolchain() + "\ndna\nsecrets\n" + self.app);
        std::test::assert(len(spine_pw) == 32 && std::str::contains(matched.stdout, "present  " + dna::nerves_vault_name(org, "spine")) && !std::str::contains(matched.stdout, "MISSING  " + dna::nerves_vault_name(org, "spine")), "the bootstrap drew the spine's password into the vault and the secrets file: " + matched.stdout + matched.stderr);
        std::test::assert(!std::str::contains(matched.stdout, spine_pw), "and `hale dna secrets` names it, never shows it");
        std::test::assert(std::str::contains(conf, "password: $NATS_SPINE_PASSWORD") && std::str::contains(conf, "include ./nats.secrets.conf") && !std::str::contains(conf, spine_pw) && !std::str::contains(conf, "-dev\""), "the tracked conf names the password, never holds it: " + conf);
        std::test::assert_eq_str(dna::file_mode(self.app + "/dna/nats.secrets.conf"), "600", "the secrets file is yours alone");
        std::test::assert_eq_str(dna::file_mode(scratch + "/vault"), "700", "and so is the vault");
        let ignored = in_dir(self.app, "git\ncheck-ignore\n-q\ndna/nats.secrets.conf");
        std::test::assert_eq_int(ignored.code, 0, "and git ignores it");
        let c0 = in_dir(self.app, "sh\n-c\ngit config user.name riley && git config user.email riley@dna && git add -A && git commit -q -m 'the organization'");
        std::test::assert_eq_int(c0.code, 0, "the scaffold committed: " + c0.stderr);

        // ---- dev, on compose's NATS
        let started = in_dir(self.app, "sh\n-c\nnohup timeout 600 \"$0\" dna dev . --no-iris >.hale/dev.log 2>&1 </dev/null & echo $!\n" + toolchain());
        let host = dna::trim_nl(started.stdout);
        std::test::assert(len(host) > 0, "dev started");
        let reading = self.logged("the organization reads its facts from the nerves", 300);
        let asked = if reading { in_dir(self.app, toolchain() + "\ndna\ntask\ncreate\nsay hello to the nerves") } else { dna::RunResult { code: -1 } };

        // ---- the stream dropped as the owner, over the authenticated server
        let dropped = if reading { in_dir(self.app, "sh\n-c\nHALE_DNA_NATS_URL_OWNER=\"nats://$(docker compose -f dna/compose.yaml port nerves 4222)\" \"$0\" dna nerves drop .\n" + toolchain()) } else { dna::RunResult { code: -1 } };

        // ---- down, whatever happened
        let stop = dna::run_tool("sh\n-c\nkill \"$1\" 2>/dev/null; for i in $(seq 1 100); do kill -0 \"$1\" 2>/dev/null || break; sleep 0.1; done; true\nsh\n" + host);
        let down = in_dir(self.app, "docker\ncompose\n-f\ndna/compose.yaml\ndown\n-v");

        std::test::assert(reading, "the organization reads its facts from compose's nerves, as the spine: " + self.log());
        std::test::assert(std::str::contains(asked.stdout, "born for intent"), "a task asked from the clone is born over them: " + asked.stdout + asked.stderr + self.log());
        std::test::assert(!std::str::contains(self.log(), "nerves.lost") && !std::str::contains(self.log(), "Permissions Violation"), "no publish or pull was refused: " + self.log());
        std::test::assert(dropped.code == 0 && std::str::contains(dropped.stdout, "dropped DNA_"), "the owner drops the stream, presenting its credential: " + dropped.stdout + dropped.stderr);
        std::test::assert_eq_int(down.code, 0, "compose's services and volumes go: " + down.stderr);

        // ---- a regenerated seed rotates the passwords
        let upgraded = in_dir(self.app, toolchain() + "\ndna\nupgrade\n.");
        let rotated = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";
        std::test::assert(upgraded.code == 0 && len(rotated) > 0 && rotated != secrets && !std::str::contains(rotated, spine_pw), "upgrade drew every role's password anew: " + upgraded.stdout + upgraded.stderr);

        // ---- secrets fail closed: the bootstrap never writes a password into
        // a tracked file, and a consumer with nothing in the vault refuses
        let tracked = in_dir(self.app, "sh\n-c\ngit add -f dna/nats.secrets.conf && \"$0\" dna upgrade .\n" + toolchain());
        let after = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";
        std::test::assert(std::str::contains(tracked.stdout + tracked.stderr, "is tracked by git") && after == rotated, "a password is never written into a tracked file: " + tracked.stdout + tracked.stderr);
        let untrack = in_dir(self.app, "git\nrm\n-q\n--cached\ndna/nats.secrets.conf");
        let empty = in_dir(self.app, "sh\n-c\nmkdir -p ../empty-vault && HALE_VAULT_DIR=\"$(cd ../empty-vault && pwd)\" \"$0\" dna nerves migrate .\n" + toolchain());
        std::test::assert(empty.code != 0 && std::str::contains(empty.stderr + empty.stdout, "the vault holds no credential"), "no credential in the vault is no connection, never a default: " + empty.stdout + empty.stderr);
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
