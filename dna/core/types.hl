// dna/core/types.hl — pure facts (Σ in proto-form, no lifecycle).
//
// Everything here is passed or persisted by value. Identity is a
// String id minted by the owner that births the thing; durable
// identity outlives any locus instance (a Task survives a restart
// as its Journal events, not as its arena).

// ---- effect classes the law reasons about ----------------------------
// Declared once here; user classes cross seed boundaries. A backend or
// gateway that performs the effect carries `@effects(is: { ... })` on
// the one method that does; the app's claims forbid or gate reach.
effect external_model; // a prompt leaves the process for a hosted model
effect genome_apply; // a candidate becomes the genome (commit/merge/deploy)
effect journal_io; // the durable journal's own file I/O
effect worktree_io; // a worktree is created or removed on disk (GH #529 D1)
effect repo_write; // the repository's history is written (a commit, a merge)
effect toolchain_run; // the toolchain is run as a subprocess (fmt, check, verify, test, model diff)
effect harness_run; // an installed coding harness runs as a subprocess with its own tools (GH #583 M3)
effect money; // money moves: a processor is called, a ledger row is written, a settlement is published (GH #605)

// A bounded outcome offered downward (supersystem -> subsystem).
type Intent {
    id: String = "";
    outcome: String = "";
    constraints: String = "";
    from: String = ""; // who offered it: "human", a locus name, ...
    to: String = ""; // the position it is for ("" = the organization, `org`); its owner admits it (GH #664)
}

// Executor-neutral unit of work: the METHOD is open, the envelope is
// typed (#521 comment 2).
type WorkRequest {
    work_id: String = "";
    task_id: String = "";
    step_id: String = "";
    objective: String = "";
    context_digest: String = ""; // ContextPackage digest, never the bytes
    knowledge_bindings: String = ""; // the package and the ids it included ("package:<digest> <id>…"), for the evidence (GH #583 K2)
    output_contract: String = ""; // e.g. "ReviewVerdict", "Patch", "Assessment"
    data_class: String = "internal"; // "public" | "internal" | "customer" | "confidential"
    requires: String = ""; // capability words, space-separated
    target: String = ""; // what the Work is about: a file inside the worktree, a locus, ""
    cost_ceiling: Int = 0;
    attempt_no: Int = 0;
}

// The request for one attempt of a Work: the same request, only its
// `attempt_no` replaced. A retry is a new attempt of the same Work, so
// every other field — the context, the capabilities, the target, the
// data class — carries over unchanged.
fn request_for_attempt(req: WorkRequest, attempt_no: Int) -> WorkRequest {
    return WorkRequest {
        work_id: req.work_id,
        task_id: req.task_id,
        step_id: req.step_id,
        objective: req.objective,
        context_digest: req.context_digest,
        knowledge_bindings: req.knowledge_bindings,
        output_contract: req.output_contract,
        data_class: req.data_class,
        requires: req.requires,
        target: req.target,
        cost_ceiling: req.cost_ceiling,
        attempt_no: attempt_no
    };
}

type WorkResult {
    disposition: String = ""; // "done" | "failed" | "declined" | "timeout"
    result: String = ""; // structured result (JSON or a value)
    narrative: String = "";
    evidence: String = ""; // content digests, space-separated
    concerns: String = "";
    performer: String = ""; // performer identity, recorded not hidden
    attempt_id: String = ""; // the attempt this reply answers, echoed (card 08); "" from a performer that does not
    result_ref: String = ""; // where the result is, when it is not the text (GH #946)
    // GH #946: a leg's reply names the command that handed it back, so
    // the outcome answers the relayed request; and the hat it wore —
    // its digest, the head and watermark it was rendered at, the digest
    // of what was rendered and the renderer's version — so replay
    // renders from the recorded hat. "" and -1 from a performer that
    // wore none.
    request: String = "";
    hat_digest: String = "";
    hat_head: String = "";
    hat_watermark: Int = -1;
    prompt_digest: String = "";
    renderer: String = "";
}

// Autonomy is a property of the parent -> child relationship. The
// grant is authored by the parent; the child cannot enlarge it.
type Grant {
    child: String = "";
    classes: String = ""; // change classes the child may apply unreviewed
    max_magnitude: Int = 0; // scalar ceiling on the SUM of the vector, never a cancel
    review: String = "pre"; // "pre" | "post" | "sampled" | "audit"
    may_expand_self: Bool = false; // always false; here so a test can prove it stays false
    // GH #605: resources. Every field defaults to "none": a grant that
    // names no currency lets nothing be spent, so a grant written before
    // these existed means what it meant.
    amounts: String = ""; // per operation, "<CUR> <max>" pairs: "USD 500.00 EUR 200"; a currency not named may not be spent
    window_amounts: String = ""; // per window, the same shape; a currency granted but not named here has no window limit of its own
    window: String = "day"; // "day" | "week" | "none" (one window for the record's lifetime)
    counterparties: String = ""; // classes or named parties, space-separated; none named = none allowed
    routes: String = ""; // provider or account routes, space-separated
    expires: Int = 0; // unix seconds; 0 = does not expire
    // GH #668: who pays — `<owner>/<account>` or `<account>`; "" = the
    // organization's own. A child names its ceiling's funder or none.
    funder: String = "";
    authority_epoch: Int = 0; // the authority epoch: a contraction or revocation advances it, fencing admissions made before
}

// Magnitude stays a vector (#521 "do not reduce risk to one score").
type Magnitude {
    loci: Int = 0; // affected subtree size
    contract_change: Bool = false; // parent-facing contract changes
    effects_widened: Bool = false; // new capability / effect class reached
    law_touched: Bool = false; // claims / constitution / review policy
    placement_change: Bool = false;
    ownership_crossed: Bool = false;
    state_migration: Bool = false;
    external_blast: Int = 0; // 0 none .. 3 customer/financial
    irreversible: Bool = false;
    novelty: Int = 0; // 0 seen-before .. 3 unprecedented
}

// Evidence-shaped confidence, never an LLM self-rating.
type Evidence {
    check_clean: Bool = false;
    verify_clean: Bool = false;
    tests_pass: Bool = false;
    replay_ok: Bool = false;
    independent_reviews: Int = 0;
    rollback_rehearsed: Bool = false;
    fleet_clean: Bool = true; // every fleet the workspace declares composes and holds its claims with the candidate's artifacts (GH #566 F5); true when it declares none
    topology_changed: Bool = false; // the candidate names a plan or the manifest: the change is the fleet's shape, not one service's source
}

// The disposition of a proposed change (#521): release inside an
// already-granted envelope; stage = prepare and verify but do not
// apply; review = block on a named reviewer; escalate = the current
// parent cannot decide; deny = outside policy or evidence. An enum
// again since GH #534 (dna/FRICTION.md F.1): a library's own enum
// now crosses the seed boundary in expression and pattern position.
type Disposition = enum { Release, Stage, Review, Escalate, Deny };

fn disposition_name(d: Disposition) -> String {
    return match d {
        Disposition::Release -> "release",
        Disposition::Stage -> "stage",
        Disposition::Review -> "review",
        Disposition::Escalate -> "escalate",
        Disposition::Deny -> "deny",
    };
}

fn magnitude_sum(m: Magnitude) -> Int {
    let mut s = m.loci + m.external_blast + m.novelty;
    if m.contract_change { s = s + 4; }
    if m.effects_widened { s = s + 4; }
    if m.law_touched { s = s + 6; }
    if m.placement_change { s = s + 2; }
    if m.ownership_crossed { s = s + 3; }
    if m.state_migration { s = s + 3; }
    if m.irreversible { s = s + 5; }
    return s;
}

// A hard boundary is any dimension the grant can never cover, no
// matter what the evidence says: touching law or review policy,
// widening effects, crossing ownership, or an irreversible external
// blast. Confidence cannot cancel these (#521).
fn crosses_hard_boundary(m: Magnitude) -> Bool {
    if m.law_touched { return true; }
    if m.effects_widened { return true; }
    if m.ownership_crossed { return true; }
    if m.irreversible && m.external_blast > 0 { return true; }
    return false;
}

fn evidence_score(e: Evidence) -> Int {
    let mut s = 0;
    if e.check_clean { s = s + 1; }
    if e.verify_clean { s = s + 1; }
    if e.tests_pass { s = s + 2; }
    if e.replay_ok { s = s + 2; }
    if e.rollback_rehearsed { s = s + 2; }
    s = s + e.independent_reviews * 2;
    return s;
}

// required_assurance = policy(class, magnitude vector, novelty,
// reversibility, boundary crossings, inherited law); proceed only if
// the grant permits the class AND no hard boundary is crossed AND
// evidence satisfies required assurance.
// How strict a review policy is: `pre` before anything, `sampled`,
// `post`, then `audit` after the fact.
fn review_rank(r: String) -> Int {
    if r == "pre" { return 3; }
    if r == "sampled" { return 2; }
    if r == "post" { return 1; }
    return 0;
}

// A grant contained in another (GH #596, layering): the classes both
// allow, the smaller ceiling, the stricter review. A child's grant is
// always read through its parent's CURRENT grant, so a parent that
// contracted binds its children from that moment, whatever they were
// born with. A ceiling with no child is no ceiling.
@unbounded
fn intersect_grants(child: Grant, ceiling: Grant) -> Grant {
    if len(ceiling.child) == 0 { return child; }
    return Grant {
        child: child.child,
        classes: words_in_both(child.classes, ceiling.classes),
        max_magnitude: if child.max_magnitude < ceiling.max_magnitude { child.max_magnitude } else { ceiling.max_magnitude },
        review: if review_rank(child.review) >= review_rank(ceiling.review) { child.review } else { ceiling.review },
        may_expand_self: false,
        // GH #605: resources contain the same way — the currencies both
        // grant at the smaller ceilings, the parties and routes both
        // name, the earlier expiry, and an epoch that moves when either
        // side's does
        amounts: amounts_in_both(child.amounts, ceiling.amounts),
        window_amounts: window_limits(child, ceiling),
        window: if len(ceiling.window_amounts) > 0 { ceiling.window } else { child.window },
        counterparties: words_in_both(child.counterparties, ceiling.counterparties),
        routes: words_in_both(child.routes, ceiling.routes),
        expires: earlier_expiry(child.expires, ceiling.expires),
        authority_epoch: child.authority_epoch + ceiling.authority_epoch,
        funder: if len(child.funder) > 0 { child.funder } else { ceiling.funder }
    };
}
// GH #668: the owner and the account of a funder, `acme/ops` -> acme, ops;
// a bare `ops` is an account of the organization's own.
fn funder_owner(f: String) -> String {
    let c = std::str::index_of(f, "/");
    return if c < 0 { "" } else { f[0..c] };
}
fn funder_account(f: String) -> String {
    let c = std::str::index_of(f, "/");
    return if c < 0 { f } else { f[(c + 1)..len(f)] };
}
fn grant_within(child: Grant, ceiling: Grant) -> Bool {
    if len(ceiling.child) == 0 { return true; }
    let i = intersect_grants(child, ceiling);
    return i.classes == child.classes && i.max_magnitude == child.max_magnitude && i.review == child.review && len(resource_gap(child, ceiling)) == 0;
}

// GH #606: the classes whose bodies are protected — kept by the
// knowledge service alone, never a git receipt, never sent to a hosted
// model.
fn protected_class(c: String) -> Bool { return c == "customer" || c == "confidential"; }

// ---- resources (GH #605) ----------------------------------------------

fn word_in(w: String, list: String) -> Bool {
    if len(w) == 0 { return false; }
    return std::str::contains(" " + list + " ", " " + w + " ");
}

// The words of `a` that `b` also has, in `a`'s order.
fn words_in_both(a: String, b: String) -> String {
    let mut out = "";
    let mut rest = a + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let w = if sp < 0 { rest } else { rest[0..sp] };
        if sp < 0 { rest = ""; } else { rest = rest[(sp + 1)..len(rest)]; }
        if len(w) > 0 && word_in(w, b) { out = out + w + " "; }
    }
    return if len(out) > 0 { out[0..(len(out) - 1)] } else { "" };
}

// The words of `a` that `b` does not have.
fn words_not_in(a: String, b: String) -> String {
    let mut out = "";
    let mut rest = a + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let w = if sp < 0 { rest } else { rest[0..sp] };
        if sp < 0 { rest = ""; } else { rest = rest[(sp + 1)..len(rest)]; }
        if len(w) > 0 && !word_in(w, b) { out = out + w + " "; }
    }
    return if len(out) > 0 { out[0..(len(out) - 1)] } else { "" };
}

fn dec(s: String) -> Decimal { return std::str::parse_decimal(s) or 0.0d; }

// The ceiling `pairs` names for `currency`, or "".
fn amount_of(pairs: String, currency: String) -> String {
    if len(currency) == 0 { return ""; }
    let n = word_count(pairs);
    let mut i = 0;
    while i + 1 < n {
        if nth_word(pairs, i) == currency { return nth_word(pairs, i + 1); }
        i = i + 2;
    }
    return "";
}

// Per operation: the currencies both grant, each at the smaller ceiling.
fn amounts_in_both(child: String, ceiling: String) -> String {
    let mut out = "";
    let n = word_count(child);
    let mut i = 0;
    while i + 1 < n {
        let cur = nth_word(child, i);
        let mine = nth_word(child, i + 1);
        let above = amount_of(ceiling, cur);
        if len(above) > 0 { out = out + cur + " " + (if dec(mine) < dec(above) { mine } else { above }) + " "; }
        i = i + 2;
    }
    return if len(out) > 0 { out[0..(len(out) - 1)] } else { "" };
}

// Per window, for the currencies both grant: the smaller limit, or the
// one limit either side names.
fn window_limits(child: Grant, ceiling: Grant) -> String {
    let both = amounts_in_both(child.amounts, ceiling.amounts);
    let mut out = "";
    let n = word_count(both);
    let mut i = 0;
    while i + 1 < n {
        let cur = nth_word(both, i);
        let x = amount_of(child.window_amounts, cur);
        let y = amount_of(ceiling.window_amounts, cur);
        let pick = if len(x) == 0 { y } else if len(y) == 0 { x } else if dec(x) < dec(y) { x } else { y };
        if len(pick) > 0 { out = out + cur + " " + pick + " "; }
        i = i + 2;
    }
    return if len(out) > 0 { out[0..(len(out) - 1)] } else { "" };
}

fn earlier_expiry(x: Int, y: Int) -> Int {
    if x == 0 { return y; }
    if y == 0 { return x; }
    return if x < y { x } else { y };
}

// What makes the child's resources wider than the ceiling's, as the
// record says it ("" when contained): a currency the ceiling does not
// grant, a larger per-operation or per-window ceiling, a window the
// ceiling does not share, a counterparty or route it does not name, a
// later expiry.
// Bounded by the currencies, parties and routes the child's grant names.
@unbounded
fn resource_gap(child: Grant, ceiling: Grant) -> String {
    let mut out = "";
    let mut window_named = false;
    // GH #668: money comes from the ceiling's funder or none other
    if len(ceiling.funder) > 0 && len(child.funder) > 0 && child.funder != ceiling.funder {
        out = out + ", funder " + child.funder + " not granted above (the ceiling pays from " + ceiling.funder + ")";
    }
    let n = word_count(child.amounts);
    let mut i = 0;
    while i + 1 < n {
        let cur = nth_word(child.amounts, i);
        let mine = nth_word(child.amounts, i + 1);
        let above = amount_of(ceiling.amounts, cur);
        if len(above) == 0 {
            out = out + ", currency " + cur + " not granted above";
        } else if dec(mine) > dec(above) {
            out = out + ", " + cur + " " + mine + " per operation under " + above;
        }
        let above_w = amount_of(ceiling.window_amounts, cur);
        if len(above_w) > 0 {
            let mine_w = amount_of(child.window_amounts, cur);
            if len(mine_w) == 0 {
                out = out + ", " + cur + " unlimited per " + child.window + " under " + above_w + " per " + ceiling.window;
            } else if dec(mine_w) > dec(above_w) {
                out = out + ", " + cur + " " + mine_w + " per " + child.window + " under " + above_w;
            }
            if child.window != ceiling.window && !window_named {
                out = out + ", window " + child.window + " under " + ceiling.window;
                window_named = true;
            }
        }
        i = i + 2;
    }
    let cp = words_not_in(child.counterparties, ceiling.counterparties);
    if len(cp) > 0 { out = out + ", counterparties `" + cp + "` not granted above"; }
    let rt = words_not_in(child.routes, ceiling.routes);
    if len(rt) > 0 { out = out + ", routes `" + rt + "` not granted above"; }
    if ceiling.expires > 0 && (child.expires == 0 || child.expires > ceiling.expires) {
        out = out + ", expires " + (if child.expires == 0 { "never" } else { to_string(child.expires) }) + " after " + to_string(ceiling.expires);
    }
    return out;
}

// A spend a position asks to make. The amount is decimal text so the
// record carries it exactly as asked.
type Spend {
    id: String = ""; // the operation's durable id
    amount: String = "";
    currency: String = "";
    counterparty: String = "";
    route: String = "";
}

// The substrate's answer to a spend: admitted under a grant epoch, or
// refused with the field that failed.
type Admission {
    ok: Bool = false;
    op: String = "";
    amount: String = "";
    currency: String = "";
    authority_epoch: Int = 0;
    refused: String = "";
}

// Whether a grant permits a spend, predicate by predicate: "" when it
// does, else `<field>: <why>`.
fn permits(g: Grant, s: Spend, now: Int) -> String {
    if g.expires > 0 && now >= g.expires { return "expires: the grant expired at " + std::time::iso8601(std::time::time_from_unix(g.expires)); }
    if len(s.id) == 0 { return "operation: a spend needs a durable id"; }
    let limit = amount_of(g.amounts, s.currency);
    if len(limit) == 0 { return "currency: " + (if len(s.currency) == 0 { "none named" } else { s.currency + " is not granted" }); }
    let v = std::str::parse_decimal(s.amount) or - 1.0d;
    if v <= 0.0d { return "amount: `" + s.amount + "` is not a positive decimal"; }
    if v > dec(limit) { return "amount: " + s.amount + " " + s.currency + " exceeds the per-operation ceiling of " + limit; }
    if !word_in(s.counterparty, g.counterparties) { return "counterparty: `" + s.counterparty + "` is not granted"; }
    if !word_in(s.route, g.routes) { return "route: `" + s.route + "` is not granted"; }
    return "";
}

// The start of the window `at` falls in (unix seconds; 0 for `none`).
fn window_start_of(window: String, at: Int) -> Int {
    if window == "week" { return at - at % 604800; }
    if window == "day" { return at - at % 86400; }
    return 0;
}

fn dispose(g: Grant, change_class: String, m: Magnitude, e: Evidence) -> Disposition {
    if crosses_hard_boundary(m) { return Disposition::Review; }
    let permitted = std::str::contains(g.classes, change_class);
    if !permitted { return Disposition::Escalate; }
    let mag = magnitude_sum(m);
    if mag > g.max_magnitude { return Disposition::Escalate; }
    let required = mag + m.novelty * 2;
    let have = evidence_score(e);
    if have < required { return Disposition::Stage; }
    if g.review == "pre" { return Disposition::Review; }
    return Disposition::Release;
}

// ---- a Mutation (GH #529): a proposed change to the genome -----------
// Durable identity and the facts every applied Mutation must name
// (#521 principle 8): its base, the exact candidate, and what became
// of it. The evidence and the review are Journal events keyed by id;
// the worktree is the Mutation's scratch space, removed on dissolution.
type Mutation {
    id: String = "";
    task_id: String = ""; // the Task whose Attempt proposed it
    base_commit: String = "";
    base_exec_digest: String = ""; // the checked build the base was expressed as
    worktree: String = ""; // path while open, "" once removed
    candidate_commit: String = "";
    candidate_digest: String = ""; // what a Review pins (sha256 of the candidate's artifact, or the commit)
    change_class: String = "";
    seed: String = ""; // the seed the change edits, relative to the repository ("" = the genome's)
    rationale: String = "";
    fitness_signals: String = ""; // declared by the proposal; the observation window is judged against them
    disposition: String = ""; // "proposed" | "staged" | "reviewed" | "applied" | "rejected" | "rolled_back" | "dissolved"
}

// What a source-editing Attempt hands back (GH #529 D2): the files it
// changed inside its worktree, why, and the fitness signals it expects
// the change to move. Never the diff itself — the repository has that,
// pinned by the candidate commit the gateway records.
type MutationProposal {
    work_id: String = "";
    files_changed: String = ""; // space-separated, worktree-relative
    rationale: String = "";
    fitness_signals: String = ""; // "checkout_failures -", space-separated "<signal> <direction>"
    fmt_clean: Bool = false;
    check_clean: Bool = false;
    check_output: String = ""; // the toolchain's diagnostics when !check_clean
}

// GH #610: a schedule — an ask fired on an interval or a cron, in the
// organism's own name, taking the ordinary road (planned, proposed,
// reviewed). `action` is `ask` (the default) or `optimize` (the
// optimize pass, which is a schedule and no longer a special case).
type Schedule {
    id: String = "";
    every_ms: Int = 0; // an interval, on the organism's millisecond clock
    cron: String = ""; // or a cron expression (minute hour day-of-month month day-of-week), UTC
    ask: String = ""; // the intent text
    requires: String = "edit"; // routed as this kind of Work; "" births a Task and routes nothing
    action: String = "ask";
    // state, kept by the organism
    armed: Bool = false; // the first tick places `last_ms`
    last_at: Int = 0; // wall seconds of the last fire, from the record
    last_ms: Int = 0;
    last_minute: Int = 0;
    task: String = ""; // the last Task it fired
    fired: Int = 0;
    paused: Bool = false;
    pending_intent: String = ""; // an occurrence claimed in the record and not yet admitted (a restart admits it once)
}

// GH #604 rule 5: whether a person retired, and the successor their
// retirement named ("" when it named none).
type RetiredPerson {
    retired: Bool = false;
    successor: String = "";
}
