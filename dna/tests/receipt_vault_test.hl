// GH #606 — protected evidence. A customer or confidential body never
// becomes a git receipt, so no clone can hold it: without memory it is
// withheld (the record keeps the digest and the class), and a hosted
// model refuses a request carrying that class. With memory, the body is
// kept there alone, sealed under a key only memory holds (GH #985: a
// head files and reads through memory's own functions and never sees the
// key or the table); reading it is refused until a disclosure names the
// reader and the purpose, and every read and refusal is a row.

import "../core" as dna;
fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, model discovery off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

fn hex_of(digest: String) -> String {
    return if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
}

// `argv` in `dir` as a head of the record: memory reached by the head's
// role alone.
fn as_head(dir: String, head_dsn: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_HEAD=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + dir + "\n" + head_dsn + "\n" + argv);
}

// `hale dna memory migrate` in `dir` with the owner's DSN and a receipt key.
fn migrate_with(dir: String, owner: String, key: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_OWNER=\"$2\" HALE_DNA_RECEIPT_KEY=\"$3\" && exec \"$4\" dna memory migrate\nsh\n" + dir + "\n" + owner + "\n" + key + "\n" + toolchain());
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

// How many of the repository's git objects contain `needle`.
fn objects_with(repo: String, needle: String) -> String {
    let r = in_dir(repo, "sh\n-c\ngit cat-file --batch-all-objects --batch | grep -c -F \"$1\" || true\nsh\n" + needle);
    return dna::trim_nl(r.stdout);
}

main locus App {
    params {
        bare: dna::Dna = dna::Dna { };
        hosted: dna::FakeModel = dna::FakeModel { name: "hosted" };
        head: dna::Pq = dna::Pq { };
        owner_conn: dna::Pq = dna::Pq { };
    }
    @unbounded
    fn rows(repo: String, kind: String, entity: String) -> Int {
        let j = dna::GitJournal { repo: repo };
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && (len(entity) == 0 || e.entity == entity) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn last(repo: String, kind: String) -> String {
        let j = dna::GitJournal { repo: repo };
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    run() {
        std::test::assert(dna::protected_class("customer") && dna::protected_class("confidential"), "customer and confidential are protected");
        std::test::assert(!dna::protected_class("internal") && !dna::protected_class("public"), "internal and public are not");
        std::test::assert(!self.hosted.allows("confidential"), "a hosted model refuses confidential data as it refuses customer data");

        let scratch = dna::scratch_root("vault");
        // whatever this fixture starts under its scratch stops when it does (#637)
        dna::reap_on_exit(scratch);
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\nvaulted");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let app = scratch + "/vaulted";
        let u1 = in_dir(app, "git\nconfig\nuser.name\nmara");
        let u2 = in_dir(app, "git\nconfig\nuser.email\nmara@local");
        let ledger = "the March ledger for account 4411: 1200.00 owed since 2026-03-02";

        // ---- no memory: withheld, the digest and class kept, no ref
        self.bare = dna::Dna {
            journal: dna::GitJournal { repo: app },
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: app }, repo: app },
            vault: dna::MemoryVault { repo: app, dsn_env: "" },
            org_id: "bare"
        };
        let d0 = self.bare.file_evidence(ledger, "customer", "mara");
        std::test::assert_eq_str(d0, dna::digest_of(ledger), "the digest is the body's");
        std::test::assert_eq_int(self.rows(app, "receipt.withheld", d0), 1, "the record says the body was not kept");
        std::test::assert(std::str::contains(self.last(app, "receipt.withheld"), "\"class\": \"customer\""), "and its class: " + self.last(app, "receipt.withheld"));
        let git_receipts = dna::GitReceipts { repo: app };
        std::test::assert_eq_str(git_receipts.read(hex_of(d0)), "", "no git receipt holds it");
        std::test::assert_eq_str(self.bare.evidence_class(d0), "customer", "the class is readable from the record");
        let refused = self.hosted.complete(dna::ModelRequest { attempt_id: "vault/a0", role: "review", prompt: "summarise the evidence", context: "(protected)", data_class: self.bare.evidence_class(d0) });
        std::test::assert(!refused.ok && std::str::contains(refused.refused, "data class customer"), "a hosted model refuses a request carrying the evidence's class: " + refused.refused);
        let internal = self.bare.file_evidence("a note anyone in the record may read", "internal", "mara");
        std::test::assert(len(git_receipts.read(hex_of(internal))) > 0, "an internal body is an ordinary git receipt");

        // ---- memory keeps it, and only there
        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        if len(owner) == 0 {
            eprintln("receipt_vault_test: no HALE_DNA_MEMORY_DSN_OWNER; memory's half was not exercised here");
            dna::scratch_done(scratch);
            return;
        }
        let record = dna::GitJournal { repo: app }.genesis();
        let key = "a receipt key of forty characters, test";
        let short = migrate_with(app, owner, "short");
        std::test::assert(short.code != 0 && std::str::contains(short.stdout + short.stderr, "a short key is no key"), "a short receipt key is refused at migration: " + short.stdout + short.stderr);
        let migrated = migrate_with(app, owner, key);
        std::test::assert_eq_int(migrated.code, 0, "the owner migrates memory with the receipt key: " + migrated.stdout + migrated.stderr);
        let head_dsn = line_value(migrated.stdout, "HALE_DNA_MEMORY_DSN_HEAD");
        std::test::assert(std::str::starts_with(head_dsn, "postgres"), "and names the head's DSN: " + migrated.stdout);
        let other_key = migrate_with(app, owner, "a different key, also long enough");
        std::test::assert(other_key.code != 0 && std::str::contains(other_key.stdout + other_key.stderr, "another receipt key"), "a different key later is refused, so nothing sealed goes dark: " + other_key.stdout + other_key.stderr);

        let secret = "invoice INV-7 to globex: 980.00, bank account ending 3321";
        let secret_path = scratch + "/invoice.txt";
        std::io::fs::write_file(secret_path, secret) or discard;
        let d1 = dna::digest_of(secret);
        let filed = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nfile\n" + secret_path + "\n--class\nconfidential\n--as\nmara");
        std::test::assert(filed.code == 0 && std::str::contains(filed.stdout, "kept in memory"), "a head files it into memory: " + filed.stdout + filed.stderr);
        std::test::assert(std::str::contains(filed.stdout, d1[7..len(d1)]), "under the body's digest: " + filed.stdout);
        std::test::assert_eq_int(self.rows(app, "receipt.classified", d1), 1, "the record keeps the digest and the class");
        std::test::assert(std::str::contains(self.last(app, "receipt.classified"), "\"class\": \"confidential\"") && std::str::contains(self.last(app, "receipt.classified"), "\"by\": \"mara\""), self.last(app, "receipt.classified"));
        std::test::assert_eq_int(self.rows(app, "receipt.withheld", d1), 0, "kept, so not withheld");
        std::test::assert_eq_str(git_receipts.read(hex_of(d1)), "", "no git receipt holds the body");
        std::test::assert_eq_str(objects_with(app, "bank account ending 3321"), "0", "no git object anywhere in the repository contains it");
        std::test::assert_eq_str(objects_with(app, "account 4411"), "0", "nor the withheld one");

        // reading is refused until a disclosure names the reader and the purpose
        let cli_refused = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + d1 + "\n--purpose\naudit\n--as\ntomasz");
        std::test::assert(cli_refused.code != 0 && std::str::contains(cli_refused.stdout + cli_refused.stderr, "not disclosed to tomasz for audit"), "refused before any disclosure: " + cli_refused.stdout + cli_refused.stderr);
        std::test::assert_eq_int(self.rows(app, "receipt.read_refused", d1), 1, "the refusal is a row");
        let disclosed = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\ndisclose\n" + d1 + "\n--to\ntomasz\n--purpose\naudit\n--as\nmara");
        std::test::assert_eq_int(disclosed.code, 0, "mara discloses it to tomasz for audit: " + disclosed.stdout + disclosed.stderr);
        std::test::assert(std::str::contains(self.last(app, "receipt.disclosed"), "\"recipient\": \"tomasz\"") && std::str::contains(self.last(app, "receipt.disclosed"), "\"purpose\": \"audit\""), self.last(app, "receipt.disclosed"));
        let shown = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + d1 + "\n--purpose\naudit\n--as\ntomasz");
        std::test::assert_eq_int(shown.code, 0, "tomasz reads it for audit: " + shown.stderr);
        std::test::assert(std::str::contains(shown.stdout, "(confidential, " + to_string(len(secret)) + " bytes, disclosed to tomasz for audit)\n" + secret + "\nend of receipt\n"), "byte for byte: " + shown.stdout);
        std::test::assert_eq_int(self.rows(app, "receipt.read", d1), 1, "the read is a row");
        std::test::assert(std::str::contains(self.last(app, "receipt.read"), "\"by\": \"tomasz\"") && std::str::contains(self.last(app, "receipt.read"), "\"purpose\": \"audit\""), "in the reader's name, for the purpose: " + self.last(app, "receipt.read"));
        let other = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + d1 + "\n--purpose\nmarketing\n--as\ntomasz");
        std::test::assert(other.code != 0 && std::str::contains(other.stdout + other.stderr, "not disclosed to tomasz for marketing"), "a disclosure is for its purpose only: " + other.stdout + other.stderr);
        let listing = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt");
        std::test::assert(std::str::contains(listing.stdout, d1) && std::str::contains(listing.stdout, "confidential") && std::str::contains(listing.stdout, "disclosed to tomasz for audit") && std::str::contains(listing.stdout, "withheld"), "the list: " + listing.stdout);
        std::test::assert_eq_str(objects_with(app, "bank account ending 3321"), "0", "after every read, still no git object holds it");
        // a read the record cannot hold is not answered: with the journal's
        // ref locked, memory is not asked and nothing is disclosed
        std::io::fs::write_file(app + "/.git/refs/dna/journal.lock", "held by the test") or discard;
        let unrecorded = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + d1 + "\n--purpose\naudit\n--as\ntomasz");
        std::io::fs::unlink(app + "/.git/refs/dna/journal.lock") or discard;
        std::test::assert(unrecorded.code != 0 && !std::str::contains(unrecorded.stdout, "3321"), "no plaintext without its read row: " + unrecorded.stdout + unrecorded.stderr);
        std::test::assert_eq_int(self.rows(app, "receipt.read", d1), 1, "and no read row either");

        // at rest it is an OpenPGP message under memory's key, and the head
        // reaches neither the table nor the key
        self.owner_conn = dna::Pq { conn: dna::pq_conn(dna::parse_dsn(owner)) };
        let st = self.owner_conn.conn.open();
        std::test::assert(st.ok, "the owner connects: " + st.err.detail);
        let at_rest = self.owner_conn.conn.query_one("SELECT body FROM " + dna::schema_for(record) + ".protected_receipts WHERE digest = '" + d1 + "'");
        std::test::assert(at_rest.ok && std::str::contains(at_rest.data, "BEGIN PGP MESSAGE") && !std::str::contains(at_rest.data, "3321"), "at rest it is an OpenPGP message, not the body: " + at_rest.data);
        self.owner_conn.conn.close();
        self.head = dna::Pq { conn: dna::pq_conn(dna::parse_dsn(head_dsn)) };
        let hs = self.head.conn.open();
        std::test::assert(hs.ok, "the head's role connects: " + hs.err.detail);
        let raw = self.head.conn.query_one("SELECT body FROM " + dna::schema_for(record) + ".protected_receipts LIMIT 1");
        std::test::assert(!raw.ok, "the head cannot read the sealed table");
        let held_key = self.head.conn.query_one("SELECT value FROM " + dna::schema_for(record) + ".memory_keys LIMIT 1");
        std::test::assert(!held_key.ok, "nor memory's key");
        self.head.conn.close();
        std::test::assert_eq_str(dna::unmigrate(owner, record), "", "this run's schema and roles dropped");
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
