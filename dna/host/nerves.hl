// The nerves' stream, created by its owner (GH #986).
//
// `hale habitat migrate` (and birth and `hale dna nerves migrate`) runs
// `nerves-migrate`: the owner's NATS URL from HALE_DNA_NATS_URL_OWNER, or
// from the organism's nerves allocation in the local habitat brought up
// (GH #1653), creates the
// organization's stream and prints the organization's token and each
// role's URL. Like memory's owner, the owner's URL never reaches a
// process that runs the organism: `dev` hands the host the spine's.

// (`nats` is the host package's alias of pond's client, host.hl; the
// core imports none of it, see dna/core/nerves.hl.)

// `nerves-migrate`: `HALE_DNA_NATS_ORG=<token>` and, per role, its server's
// URL (`HALE_DNA_NATS_URL_<ROLE>=nats://host:port`, never a password) and
// its credential's vault name (`HALE_DNA_NATS_VAULT_<ROLE>`), when the
// stream is in place; `none: <why>` when there is no server to put it on.
// It consumes the organism's secrets and never creates one (GH #989): a
// credential the vault lacks, or a server include that is not written, is
// a refusal naming `hale dna upgrade`, which provisions them.
//
// GH #1653: `derive` (`nerves-migrate --derive`, what `dev` and the head's
// launcher ask) brings no service up and creates no stream: the URLs of the
// owner's server, or of the organism's nerves allocation when it is already
// up. A stream that is missing is the organization's refusal when it reads,
// naming `hale habitat migrate`.
fn nerves_migrate_verb(root: String, derive: Bool) -> Answer {
    let id = record_identity(root);
    if len(id) == 0 {
        return fail("nerves migrate: the record has no identity yet (`hale habitat graft` first)");
    }
    let org = dna::schema_for(id);
    let missing = dna::nerves_missing(org);
    if len(missing) > 0 {
        return fail(
            "nerves migrate: the vault holds no credential for the nerves' " + missing
                + " (`hale dna upgrade` provisions the organism's secrets; `hale dna secrets` lists them)",
        );
    }
    let mut server = if std::env::var_exists(dna::NATS_OWNER_URL_ENV) {
        std::env::var(dna::NATS_OWNER_URL_ENV)
    } else {
        ""
    };
    if len(server) == 0 {
        // compose's server reads the passwords from the include
        if derive && !std::io::fs::file_exists(nats_secrets_path(root)) {
            return answer(
                "none: the organism's nerves allocation in the local habitat is not provisioned (`hale habitat migrate "
                    + root + "` provisions it and brings it up)\n",
            );
        }
        if !std::io::fs::file_exists(nats_secrets_path(root)) {
            return fail(
                "nerves migrate: the nerves allocation's secrets (" + nats_secrets_path(root)
                    + ") are not written (`hale dna upgrade` writes them from the vault's provisioning)",
            );
        }
        // its own server, or the habitat's for an account the habitat's
        // server keeps (`dna::nerves_root`)
        let infra = ReferenceInfrastructure { root: dna::nerves_root(root) };
        if derive {
            server = infra.nerves_if_up();
            if len(server) == 0 {
                return answer(
                    "none: the organism's nerves allocation in the local habitat is not up (`hale habitat migrate "
                        + root + "` brings it up and creates the stream)\n",
                );
            }
        } else {
            let up = infra.nerves_server(dna::nerves_root(root));
            if !up.present { return answer("none: " + up.why + "\n"); }
            server = up.dsn;
        }
    }
    let url = dna::nerves_server_url(server);
    if derive { return answer(nerves_urls(root, org, url)); }
    let c = nats::NatsClient {
        url: dna::reach_url(url),
        user: dna::nerves_user(org, "owner"),
        credential: std::secret::Credential { vault: dna::nerves_vault_name(org, "owner") },
        name: "dna-owner",
        timeout: 2s,
    };
    // a server compose has just started takes a moment to listen
    let mut tries = 0;
    let mut open = c.open();
    while !open && tries < 50 {
        std::time::sleep(200ms);
        open = c.open();
        tries = tries + 1;
    }
    if !open { return fail("nerves migrate: " + c.last_error); }
    if !c.jetstream {
        c.close();
        return fail("nerves migrate: the server does not run JetStream (start it with -js)");
    }
    let m = nerves_migrate(c, org);
    // GH #1590: the exchange's stream, its inbox consumer and the card
    let x = if m.ok { exchange_migrate(c, root, id, org) } else { ExchangePlacement { } };
    c.close();
    if !m.ok { return fail("nerves migrate: " + m.why); }
    if len(x.why) > 0 { return fail("nerves migrate: the exchange: " + x.why); }
    // GH #1653: the version the stream was moved to, which the habitat
    // records for the allocation
    let mut slots = "";
    let mut roles = dna::NERVES_ROLES + " ";
    while len(roles) > 0 {
        let sp = std::str::index_of(roles, " ");
        if sp > 0 {
            slots = slots + (if len(slots) > 0 { " " } else { "" })
                + dna::nerves_vault_name(org, roles[0..sp]);
        }
        roles = roles[(sp + 1)..len(roles)];
    }
    // a word for the operator when the server could not reserve the whole
    // of the inbox's bound (the CLI prints it on stderr)
    let smaller = if x.bound < dna::EXCHANGE_MAX_BYTES {
        "nerves.note=the exchange's inbox is bounded at " + dna::bytes_words(x.bound) + ", not "
            + dna::bytes_words(dna::EXCHANGE_MAX_BYTES)
            + ": the nerves' server could reserve no more of its file store (max_file_store); a later migration asks for the whole bound again\n"
    } else {
        ""
    };
    return answer(
        nerves_urls(root, org, url) + "allocation.schema_version="
            + to_string(dna::NERVES_STREAM_VERSION) + "\nallocation.vault_slots=" + slots + "\n"
            + smaller,
    );

}

// GH #1653: the nerves server's configuration lives with the allocations
// of the organism whose server it is (`dna::nerves_root`: its own, or the
// habitat's for an organism whose account the habitat's server holds),
// never in a checkout; each organization's account and its secrets are
// files of the server's `nerves.d/`, named by the organization's key.
fn nats_conf_path(root: String) -> String {
    return allocation_files(dna::nerves_root(root)) + "/nats.conf";
}
fn nats_accounts_dir(root: String) -> String {
    let dir = allocation_files(dna::nerves_root(root));
    if len(dir) == 0 { return ""; }
    let made = dna::run_tool("mkdir\n-p\n-m\n700\n" + dir + "/nerves.d");
    return if made.code == 0 { dir + "/nerves.d" } else { "" };
}
fn nats_secrets_path(root: String) -> String {
    return nats_accounts_dir(root) + "/" + dna::allocation_key(root) + ".secrets.conf";
}
fn nats_account_path(root: String) -> String {
    return nats_accounts_dir(root) + "/" + dna::allocation_key(root) + ".account.conf";
}

// The organization's account written beside its server, and the server's
// configuration rewritten to hold every account there: whether either
// changed (the server then restarts to read them).
fn write_nerves_conf(root: String, org: String, app: String, heart: String) -> Bool {
    let mut moved = false;
    let account = nats_account_path(root);
    let text = dna::nerves_account_text(dna::allocation_key(root), org, app, heart);
    if (std::io::fs::read_file(account) or "") != text {
        std::io::fs::write_file(account, text) or discard;
        moved = true;
    }
    return server_conf_rewrite(root) || moved;
}

// The server's nats.conf rewritten from the accounts its `nerves.d/` holds
// (an account and its secrets, both written): whether it changed.
fn server_conf_rewrite(root: String) -> Bool {
    if len(nats_accounts_dir(root)) == 0 { return false; }
    return dna::nerves_server_conf_write(allocation_files(dna::nerves_root(root)));
}

// What `nerves_migrate` did: the stream exists as this toolchain wants it.
type NervesMigration {
    ok: Bool = false;
    why: String = "";
    stream: String = "";
}

// `stream` created with `config`, or an existing one brought to it: ""
// when it is in place, else JetStream's refusal. A create is refused when
// the stream is there with another configuration (err_code 10058), and —
// since nats-server checks a create's reservation before it looks for the
// stream — when the server's file store cannot reserve the whole of the
// stream's bound again (10047), though the stream reserves it already: an
// update reserves only what it adds, so either is answered by one. An
// update of a stream that is not there (10059) leaves the create's refusal.
fn stream_put(c: nats::NatsClient, stream: String, config: String) -> String {
    let made = nats::js_call(c, "$JS.API.STREAM.CREATE." + stream, config) or "";
    if len(made) > 0 { return ""; }
    let refused = c.last_error;
    if !std::str::contains(refused, "10058")
        && !std::str::contains(refused, dna::JETSTREAM_NO_STORE)
    {
        return refused;
    }
    let updated = nats::js_call(c, "$JS.API.STREAM.UPDATE." + stream, config) or "";
    if len(updated) > 0 { return ""; }
    if std::str::contains(c.last_error, "10059") { return refused; }
    return c.last_error;
}

// Create the organization's stream with the owner's connection, or bring
// an existing one to this configuration. Idempotent.
fn nerves_migrate(c: nats::NatsClient, org: String) -> NervesMigration {
    let stream = dna::nerves_stream(org);
    let why = stream_put(c, stream, dna::nerves_stream_config(org));
    if len(why) > 0 { return NervesMigration { why: nerves_refusal(why, stream), stream: stream }; }
    return NervesMigration { ok: true, stream: stream };
}

// JetStream's refusal of the organization's stream, with what to do about
// it when the server's file store is wholly reserved (the stream has no
// bound of its own, so that is the only way it is refused for storage).
fn nerves_refusal(why: String, stream: String) -> String {
    if !std::str::contains(why, dna::JETSTREAM_NO_STORE) { return why; }
    return dna::nerves_store_refusal(why, "the organization's stream " + stream, 0);
}

// The exchange's stream as `exchange_stream_place` left it: the bound the
// server reserved for it, or why there is none.
type ExchangePlacement {
    bound: Int = 0;
    why: String = "";
}

// The exchange's stream created, or an existing one brought to this
// configuration, bounded at the most the server's file store can reserve
// for it: `EXCHANGE_MAX_BYTES`, halved while JetStream refuses the
// reservation (err_code 10047), down to `EXCHANGE_MIN_BYTES` (see
// dna/core/nerves.hl, the exchange). An inbox already in place is never
// made smaller: asking for its own bound again reserves nothing new, so
// the halving stops there at the latest. Each migration asks for the whole
// bound first, so an inbox made small grows back once the server has room.
fn exchange_stream_place(c: nats::NatsClient, org: String, per_sender: Int) -> ExchangePlacement {
    let stream = dna::exchange_stream(org);
    let mut bound = dna::EXCHANGE_MAX_BYTES;
    while bound > 0 {
        let why = stream_put(c, stream, dna::exchange_stream_config(org, per_sender, bound));
        if len(why) == 0 { return ExchangePlacement { bound: bound }; }
        if !std::str::contains(why, dna::JETSTREAM_NO_STORE) {
            return ExchangePlacement { why: why };
        }
        let smaller = dna::exchange_smaller_bound(bound);
        if smaller == 0 {
            return ExchangePlacement {
                why: dna::nerves_store_refusal(why, "the exchange's inbox " + stream, bound),
            };
        }
        bound = smaller;
    }
    return ExchangePlacement { why: "the exchange's inbox has no bound to ask for" };
}

// GH #1590: the record's exchange stream created or brought to this
// configuration (bounded, refusing what overflows), its inbox consumer,
// and its card published anew — signed with the record's exchange key, so
// a peer that reads it can pin that key. The bound its stream has, or why
// it is not done.
fn exchange_migrate(
    c: nats::NatsClient,
    root: String,
    id: String,
    org: String
) -> ExchangePlacement {
    let key = dna::ExchangeKey { vault: dna::exchange_key_vault(org) };
    if !key.ready() {
        return ExchangePlacement {
            why: "the vault holds no exchange key (`" + dna::exchange_key_vault(org)
                + "`; `hale dna upgrade` provisions it)",
        };
    }
    let stream = dna::exchange_stream(org);
    let placed = exchange_stream_place(c, org, dna::exchange_per_sender());
    if len(placed.why) > 0 { return placed; }
    let mut consumer_why = "";
    nats::js_consumer_create(
        c,
        stream,
        nats::ConsumerSpec {
            durable: dna::EXCHANGE_DURABLE,
            filter: dna::exchange_inbox_filter(org),
            deliver: "all",
        },
    ) or {
        consumer_why = c.last_error;
    };
    if len(consumer_why) > 0 {
        return ExchangePlacement { why: "its inbox consumer: " + consumer_why };
    }
    let card = key.card(id, genome_root(root));
    if len(card) == 0 { return ExchangePlacement { why: "the card could not be signed" }; }
    // one card: the one before goes, so a bounded subject never fills with them
    let purged = nats::js_call(
        c,
        "$JS.API.STREAM.PURGE." + stream,
        "{\"filter\":\"" + dna::exchange_card_subject(org) + "\"}",
    ) or "";
    if len(purged) == 0 {
        return ExchangePlacement { why: "the old card could not be purged: " + c.last_error };
    }
    let ack = nats::js_publish(
        c,
        dna::exchange_card_subject(org),
        std::bytes::from_string(card),
    ) or nats::PubAck { };
    if ack.seq == 0 {
        return ExchangePlacement { why: "the card could not be published: " + c.last_error };
    }
    return placed;
}

// Whether the organization is reading its facts: its durable consumer
// has a pull outstanding (a connection that went away leaves none once
// its pull expires). "" when it is; otherwise why not. The host asks
// this where it used to look for the old socket transport's sockets.
fn nerves_listening(c: nats::NatsClient, org: String, owner: String) -> String {
    let info = nats::js_call(c, dna::nerves_info_subject_of(org, owner), "") or "";
    if len(info) == 0 { return c.last_error; }
    if std::json::find_int_field(info, "num_waiting") > 0 { return ""; }
    return "no pull outstanding on " + dna::nerves_stream(org) + "."
        + dna::nerves_durable_of(owner);
}

// The owner this host's body is, for the subjects it publishes under: the
// clone's `dna.owner` ("" when the organization is the only owner). Read
// from the root the CLI hands the host, before `Host` is born.
fn host_owner() -> String { return owner_here(std::env::arg_or(2, ".")); }

// `nerves-drop`: the organization's stream deleted with the owner's URL,
// everything it held with it — what a fixture does beside dropping its
// memory's schema, and an operator tearing an organization down. `dropped
// <stream>`, `absent <stream>` when there was none, `none: <why>` when
// there is no server.
fn nerves_drop_verb(root: String) -> Answer {
    let org = dna::schema_for(record_identity(root));
    let owner = if std::env::var_exists(dna::NATS_OWNER_URL_ENV) {
        std::env::var(dna::NATS_OWNER_URL_ENV)
    } else {
        ""
    };
    if len(owner) == 0 {
        return answer(
            "none: no " + dna::NATS_OWNER_URL_ENV
                + "; the stream is dropped with the owner's URL\n",
        );
    }
    if std::str::contains(" " + dna::nerves_missing(org) + " ", " owner ") {
        return fail(
            "nerves drop: the vault holds no credential for the nerves' owner (`hale dna secrets` lists it)",
        );
    }
    let c = nats::NatsClient {
        url: dna::reach_url(dna::nerves_server_url(owner)),
        user: dna::nerves_user(org, "owner"),
        credential: std::secret::Credential { vault: dna::nerves_vault_name(org, "owner") },
        name: "dna-owner",
        timeout: 2s,
    };
    if !c.open() { return fail("nerves drop: " + c.last_error); }
    let stream = dna::nerves_stream(org);
    let gone = nats::js_call(c, "$JS.API.STREAM.DELETE." + stream, "") or "";
    let why = c.last_error;
    // GH #1590: the exchange's stream goes with it (absent is not an error)
    let inbox_gone = nats::js_call(
        c,
        "$JS.API.STREAM.DELETE." + dna::exchange_stream(org),
        "",
    ) or "";
    c.close();
    if len(gone) > 0 { return answer("dropped " + stream + "\n"); }
    // err_code 10059: stream not found
    if std::str::contains(why, "10059") { return answer("absent " + stream + "\n"); }
    return fail("nerves drop: " + why);
}

// `senses-up` (GH #988): the senses' store, the organism's senses
// allocation in the local habitat brought up (with `--derive`, read when it
// is up) — `HALE_DNA_SENSES_URL=<read url>`, or `none: <why>`. No part
// of the organism is handed it: the store scrapes the parts, and only the
// reflexes read it.
fn senses_up_verb(root: String, derive: Bool) -> Answer {
    let infra = ReferenceInfrastructure { root: root };
    // GH #1653: `derive` brings nothing up: the store's URL when it is up
    let store = if derive { infra.senses_if_up() } else { infra.senses_store(root) };
    if !store.present { return answer("none: " + store.why + "\n"); }
    return answer("HALE_DNA_SENSES_URL=" + store.dsn + "\n");
}

// The organization's token and each role's URL on `url`, as `dev` hands
// them to the organism's parts.
fn nerves_urls(root: String, org: String, url: String) -> String {
    let mut out = dna::NATS_ORG_ENV + "=" + org + "\n";
    out = out + dna::NATS_SPINE_URL_ENV + "=" + url + "\n";
    out = out + dna::NATS_HEAD_URL_ENV + "=" + url + "\n";
    out = out + dna::NATS_REFLEXES_URL_ENV + "=" + url + "\n";
    // GH #989: the attached application's own account, when the record
    // attaches one that holds it
    let app = attached_application(root);
    if len(app) > 0 && len(dna::nerves_app_refusal(app)) == 0 {
        out = out + dna::NATS_APP_URL_ENV + "=" + url + "\n";
        out = out + dna::NATS_APP_USER_ENV + "=" + dna::nerves_app_user(org, app) + "\n";
        out = out + dna::NATS_APP_NAME_ENV + "=" + dna::nerves_app_name(app) + "\n";
        out = out + dna::NATS_APP_VAULT_ENV + "=" + dna::nerves_app_vault(org, app) + "\n";
    }
    out = out + "HALE_DNA_NATS_VAULT_REFLEXES=" + dna::nerves_vault_name(org, "reflexes") + "\n";
    return out;
}
