// GH #612 — the hosted head over a fake identity provider. `hale dna ui`
// under `dna.principal = oidc` serves nothing without a session; a
// session comes from the authorization-code flow against the issuer; a
// verdict and an intent posted with it act as the member the subject maps
// to, whatever the form says; without a session they are refused and
// nothing reaches the record; an unmapped subject gets no session; a
// sign-in is used once; a sign-out ends the session. Both heads' writes
// are requests in the record; the spine (the body host) is the one
// admission controller and the ledger's one writer (GH #985).

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// `argv` in `dir` with memory's head role named (GH #985).
fn as_head(dir: String, head_dsn: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_HEAD=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + dir + "\n" + head_dsn + "\n" + argv);
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

// The spine: `hale dna dev` in the background with the owner's DSN (dev
// migrates and hands the host the spine's role), bounded; its pid.
fn start_spine(app: String, owner: String) -> String {
    let started = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_OWNER=\"$2\" && nohup timeout 600 \"$3\" dna dev . --no-iris >>.hale/dev.log 2>&1 </dev/null & echo $!\nsh\n" + app + "\n" + owner + "\n" + toolchain());
    return dna::trim_nl(started.stdout);
}

// The host, then everything it started.
fn stop_spine(app: String, pid: String) {
    let k = dna::run_tool("kill\n" + pid);
    let gone = dna::run_tool("sh\n-c\nn=0; while kill -0 \"$1\" 2>/dev/null && [ $n -lt 100 ]; do sleep 0.1; n=$((n+1)); done; cd \"$2\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; rm -f .hale/dna/$f.pid; done; rm -f .hale/dna/*.sock; true\nsh\n" + pid + "\n" + app);
}

// Whether the record comes to hold a `kind` row whose body contains
// `needle`, within `secs`.
fn record_has(app: String, kind: String, needle: String, secs: Int) -> Bool {
    let deadline = std::time::now() + dna::wait_secs(secs);
    while std::time::now() <= deadline {
        let j = dna::GitJournal { repo: app };
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && std::str::contains(e.body, needle) { return true; }
            i = i + 1;
        }
        std::time::sleep(200ms);
    }
    return false;
}

// The ledger's rows, read as a head, once they hold every one of
// `needles` (newline-separated) or `secs` pass; the rows it last read.
fn ledger_holding(app: String, head_dsn: String, needles: String, secs: Int) -> String {
    let deadline = std::time::now() + dna::wait_secs(secs);
    let mut rows = "";
    while std::time::now() <= deadline {
        rows = as_head(app, head_dsn, toolchain() + "\ndna\nledger\nrows").stdout;
        // the asks' own rows: the organism's `intent.offered` names the text
        // too, and can land before the spine admits the request
        let asks = row_with_all(rows, "\"kind\": \"intent.requested\"");
        let mut all = true;
        let mut rest = needles + "\n";
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let n = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if len(n) > 0 && !std::str::contains(asks, n) { all = false; }
        }
        if all { return rows; }
        std::time::sleep(200ms);
    }
    return rows;
}

// Every line of `text` holding `needle`, newline-joined.
@unbounded
fn row_with_all(text: String, needle: String) -> String {
    let mut out = "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::contains(line, needle) { out = out + line + "\n"; }
    }
    return out;
}

fn b64(s: String) -> String { return std::text::base64::url_encode(std::bytes::from_string(s)); }

type Http {
    status: Int = 0;
    headers: String = "";
    body: String = "";
}

// One request through curl, headers included, redirects not followed.
fn curl(method: String, url: String, cookie: String, body: String) -> Http {
    let mut argv = "curl\n-s\n-i\n-X\n" + method;
    if len(cookie) > 0 { argv = argv + "\n-H\nCookie: " + cookie; }
    if len(body) > 0 { argv = argv + "\n-H\nContent-Type: application/json\n--data\n" + body; }
    let r = dna::run_tool(argv + "\n" + url);
    let raw = r.stdout;
    let split = std::str::index_of(raw, "\r\n\r\n");
    let head = if split < 0 { raw } else { raw[0..split] };
    let rest = if split < 0 { "" } else { raw[(split + 4)..len(raw)] };
    let sp = std::str::index_of(head, " ");
    let status = if sp < 0 || len(head) < sp + 4 { 0 } else { std::str::parse_int(head[(sp + 1)..(sp + 4)]) or 0 };
    return Http { status: status, headers: head, body: rest };
}

@unbounded
fn form_field(body: String, name: String) -> String {
    let mut rest = body + "&";
    while len(rest) > 0 {
        let amp = std::str::index_of(rest, "&");
        let part = rest[0..amp];
        rest = rest[(amp + 1)..len(rest)];
        if std::str::starts_with(part, name + "=") { return dna::url_decode(part[(len(name) + 1)..len(part)]); }
    }
    return "";
}

type IssuedCode {
    code: String = "";
    nonce: String = "";
    sub: String = "";
}

@form(vec)
locus IssuedCodes { capacity { heap rows of IssuedCode; } }

// A fake identity provider: a discovery document; an authorize endpoint
// that signs the user in at once (as `login_hint` names, alice by default)
// and sends the browser back with a code; a token endpoint that answers
// the code, given the client's secret, with an ID token carrying the
// sign-in's nonce.
locus FakeIssuer {
    params {
        base: String = "http://127.0.0.1:47811";
        codes: IssuedCodes = IssuedCodes { };
        exchanges: Int = 0;
        refused_secrets: Int = 0;
    }
    @unbounded
    fn handle(req: std::http::Request) -> std::http::Response {
        let ctx = std::http::build_context(req);
        if std::http::is_route(ctx, "GET", "/.well-known/openid-configuration") {
            return std::http::Response { status: 200, content_type: "application/json", body: "{\"issuer\": \"" + self.base + "\", \"authorization_endpoint\": \"" + self.base + "/authorize\", \"token_endpoint\": \"" + self.base + "/token\"}" };
        }
        if std::http::is_route(ctx, "GET", "/authorize") {
            let back = dna::url_decode(std::http::query_param(ctx.params, "redirect_uri"));
            let hint = std::http::query_param(ctx.params, "login_hint");
            let code = "code-" + to_string(self.codes.len() + 1);
            self.codes.push(IssuedCode { code: code, nonce: std::http::query_param(ctx.params, "nonce"), sub: if len(hint) > 0 { hint } else { "alice-sub" } });
            return std::http::Response { status: 302, content_type: "text/plain", headers: "Location: " + back + "?code=" + code + "&state=" + std::http::query_param(ctx.params, "state"), body: "" };
        }
        if std::http::is_route(ctx, "POST", "/token") {
            if form_field(req.body, "client_secret") != "fake-secret" {
                self.refused_secrets = self.refused_secrets + 1;
                return std::http::Response { status: 401, content_type: "application/json", body: "{\"error\": \"invalid_client\"}" };
            }
            let code = form_field(req.body, "code");
            let mut i = 0;
            while i < self.codes.len() {
                let g = self.codes.get(i) or IssuedCode { };
                if g.code == code && len(code) > 0 {
                    self.codes.set(i, IssuedCode { }) or discard;
                    self.exchanges = self.exchanges + 1;
                    let payload = "{\"iss\": \"" + self.base + "\", \"aud\": \"dna-ui\", \"sub\": \"" + g.sub + "\", \"nonce\": \"" + g.nonce + "\", \"exp\": " + to_string(std::time::now() + 600) + "}";
                    let token = b64("{\"alg\":\"RS256\"}") + "." + b64(payload) + ".unverified";
                    return std::http::Response { status: 200, content_type: "application/json", body: "{\"id_token\": \"" + token + "\", \"token_type\": \"Bearer\"}" };
                }
                i = i + 1;
            }
            return std::http::Response { status: 400, content_type: "application/json", body: "{\"error\": \"invalid_grant\"}" };
        }
        return std::http::Response { status: 404, body: "not found" };
    }
}

// The line of a JSON-per-line text that carries `needle` ("" when none).
@unbounded
fn row_with(text: String, needle: String) -> String {
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::contains(line, needle) { return line; }
    }
    return "";
}

main locus App {
    params {
        srv: std::http::Server = std::http::Server { port: 47813, handler: FakeIssuer { base: "http://127.0.0.1:47813" } };
        watch: dna::Pq = dna::Pq { };
    }
    placement { srv: cooperative(pool = io); }
    // A member signs in at the issuer as `subject` and gets a session cookie.
    fn session(ui: String, subject: String) -> String {
        let login = curl("GET", ui + "/auth/login", "", "");
        let authorize = dna::response_header(login.headers, "Location") + "&login_hint=" + subject;
        let signin_line = dna::response_header(login.headers, "Set-Cookie");
        let signin = signin_line[0..std::str::index_of(signin_line, ";")];
        let back = dna::response_header(curl("GET", authorize, "", "").headers, "Location");
        let landed = curl("GET", back, signin, "");
        let cookie_line = dna::response_header(landed.headers, "Set-Cookie");
        if landed.status != 302 || !std::str::starts_with(cookie_line, "dna_session=") { return ""; }
        return cookie_line[0..std::str::index_of(cookie_line, ";")];
    }
    run() {
        let scratch = dna::scratch_root("two-heads");
        dna::reap_on_exit(scratch);
        let bare = scratch + "/origin.git";
        let b0 = in_dir(scratch, "git\ninit\n-q\n--bare\n-b\nmain\n" + bare);
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\nshared");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let app = scratch + "/shared";
        let port = dna::free_port(0);
        let ui = "http://127.0.0.1:" + to_string(port);
        let g1 = in_dir(app, "git\nconfig\nuser.name\nhead-operator");
        let g2 = in_dir(app, "git\nconfig\nuser.email\nhead@local");
        let g3 = in_dir(app, "git\nadd\n-A");
        let g4 = in_dir(app, "git\ncommit\n-q\n-m\nthe app");
        let g5 = in_dir(app, "git\nremote\nadd\norigin\n" + bare);
        let g6 = in_dir(app, "git\npush\n-q\norigin\nmain\nrefs/dna/*:refs/dna/*");
        // two independently identified people: two subjects at the issuer, two members
        let c1 = in_dir(app, "git\nconfig\ndna.principal\noidc");
        let c2 = in_dir(app, "git\nconfig\ndna.oidc.issuer\nhttp://127.0.0.1:47813");
        let c3 = in_dir(app, "git\nconfig\ndna.oidc.client\ndna-ui");
        let c4 = in_dir(app, "git\nconfig\ndna.oidc.redirect\n" + ui + "/auth/callback");
        let c5 = in_dir(app, "git\nconfig\n--add\ndna.oidc.member\nalice-sub=alice");
        let c5b = in_dir(app, "git\nconfig\n--add\ndna.oidc.member\nbob-sub=bob");
        let c6 = in_dir(app, "git\nconfig\ndna.oidc.board\nalice");
        std::test::assert_eq_int(c6.code, 0, "configured: " + c6.stderr);

        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        if len(owner) == 0 {
            eprintln("two_heads_test: no HALE_DNA_MEMORY_DSN_OWNER; the heads have no spine to admit their requests, so nothing was exercised");
            dna::scratch_done(scratch);
            return;
        }
        let migrated = dna::run_tool("sh\n-c\ncd \"$1\" && HALE_DNA_MEMORY_DSN_OWNER=\"$2\" exec \"$3\" dna memory migrate\nsh\n" + app + "\n" + owner + "\n" + toolchain());
        let head_dsn = line_value(migrated.stdout, "HALE_DNA_MEMORY_DSN_HEAD");
        std::test::assert(migrated.code == 0 && std::str::starts_with(head_dsn, "postgres"), "memory migrated for the record: " + migrated.stdout + migrated.stderr);

        // the one logical admission controller: the spine, and the record adopted into its ledger
        let spine = start_spine(app, owner);
        let adopted = as_head(app, head_dsn, toolchain() + "\ndna\nledger\nadopt\n--as\nhead-operator");
        std::test::assert(adopted.code == 0 && std::str::contains(adopted.stdout, "ledger adoption requested as"), "adoption requested: " + adopted.stdout + adopted.stderr);
        std::test::assert(record_has(app, "ledger.adopted", "checkpoint", 300), "the spine adopts the ledger on its tick");
        std::test::assert(record_has(app, "spine.taken", "\"holder\"", 30), "the spine that adopted holds the spine lease, and the record names it");

        // the hosted head, with the head's role in memory
        let started = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_OIDC_SECRET=fake-secret HALE_DNA_MEMORY_DSN_HEAD=\"$4\" && nohup timeout 600 \"$2\" dna ui . --port \"$3\" >.hale/ui.log 2>&1 </dev/null & echo $!\nsh\n" + app + "\n" + toolchain() + "\n" + to_string(port) + "\n" + head_dsn);
        let pid = dna::trim_nl(started.stdout);
        let mut up = false;
        let mut tries = 0;
        while !up && tries < 600 {
            if curl("GET", ui + "/api/board", "", "").status != 0 { up = true; } else { std::time::sleep(200ms); }
            tries = tries + 1;
        }
        std::test::assert(up, "the hosted head came up at " + ui);

        // ---- two people, two sessions, one record, one controller
        let alice = self.session(ui, "alice-sub");
        let bob = self.session(ui, "bob-sub");
        std::test::assert(len(alice) > 60 && len(bob) > 60 && alice != bob, "two sessions, one each");
        let a1 = curl("POST", ui + "/api/task/create", alice, "{\"outcome\":\"chase the late invoice\",\"to\":\"\",\"as\":\"bob\"}");
        std::test::assert_eq_int(a1.status, 200, "alice's ask is taken: " + a1.body);
        let b1 = curl("POST", ui + "/api/task/create", bob, "{\"outcome\":\"reconcile the payroll account\",\"to\":\"\",\"as\":\"alice\"}");
        std::test::assert_eq_int(b1.status, 200, "bob's ask is taken: " + b1.body);
        let ledger = ledger_holding(app, head_dsn, "chase the late invoice\nreconcile the payroll account", 120);
        std::test::assert(std::str::contains(ledger, "chase the late invoice") && std::str::contains(ledger, "reconcile the payroll account"), "both asks are admitted as rows of the ledger: " + ledger);
        // each in the name the session proves, whatever the form said
        // the ask's own row (the organism's `intent.offered` names the text too)
        let arow = row_with(row_with_all(ledger, "\"kind\": \"intent.requested\""), "chase the late invoice");
        let brow = row_with(row_with_all(ledger, "\"kind\": \"intent.requested\""), "reconcile the payroll account");
        std::test::assert(std::str::contains(arow, "\"author\": \"alice\"") && !std::str::contains(arow, "\"author\": \"bob\""), "alice's ask, in alice's name whatever the form said: " + arow);
        std::test::assert(std::str::contains(brow, "\"author\": \"bob\"") && !std::str::contains(brow, "\"author\": \"alice\""), "bob's ask, in bob's name whatever the form said: " + brow);
        // the record holds the request, not the day's work
        let record = in_dir(app, "git\nshow\nrefs/dna/journal:journal.jsonl").stdout;
        std::test::assert(std::str::contains(row_with(record, "chase the late invoice"), "\"kind\": \"ledger.requested\""), "the ask reached the record as a request: " + row_with(record, "chase the late invoice"));
        // a session is not a shared secret: bob's cookie on alice's form field is bob
        let b2 = curl("POST", ui + "/api/task/create", bob, "{\"outcome\":\"file the returns\",\"to\":\"\",\"as\":\"alice\"}");
        std::test::assert_eq_int(b2.status, 200, "taken");
        let ledger2 = ledger_holding(app, head_dsn, "file the returns", 120);
        std::test::assert(std::str::contains(row_with(row_with_all(ledger2, "\"kind\": \"intent.requested\""), "file the returns"), "\"author\": \"bob\""), "in bob's name: " + ledger2);

        // ---- connections stay bounded: each process holds one handle on
        // memory for its life, so ticking longer opens nothing more (GH #985)
        let record_id = dna::GitJournal { repo: app }.genesis();
        self.watch = dna::Pq { conn: dna::pq_conn(dna::parse_dsn(owner)) };
        let wst = self.watch.conn.open();
        std::test::assert(wst.ok, "the owner connects to watch: " + wst.err.detail);
        let roles = "'" + dna::spine_role(record_id) + "', '" + dna::head_role(record_id) + "'";
        let mut first = -1;
        let mut last = -1;
        let mut most = 0;
        let mut spine_seen = 0;
        let mut k = 0;
        while k < 10 {
            let n = std::str::parse_int(dna::trim_nl(self.watch.conn.query_one("SELECT count(*) FROM pg_stat_activity WHERE usename IN (" + roles + ")").data)) or - 1;
            let sp = std::str::parse_int(dna::trim_nl(self.watch.conn.query_one("SELECT count(*) FROM pg_stat_activity WHERE usename = '" + dna::spine_role(record_id) + "'").data)) or - 1;
            if first < 0 { first = n; }
            last = n;
            if n > most { most = n; }
            if sp > spine_seen { spine_seen = sp; }
            std::time::sleep(1s);
            k = k + 1;
        }
        self.watch.conn.close();
        std::test::assert(spine_seen > 0, "the spine holds its memory open while it runs");
        // a handle opens on its first use, so the first ticks bring the set
        // up to its size; a handle per call reached ninety within seconds
        std::test::assert(most <= 16, "the spine's and the head's connections stay a fixed handful over ten seconds of ticks: " + to_string(first) + " at first, " + to_string(most) + " at most, " + to_string(last) + " at the end");

        // ---- the spine away: the head still takes a request into the record;
        // back, the spine checks it against the record as it is then
        stop_spine(app, spine);
        let requested = curl("POST", ui + "/api/task/create", bob, "{\"outcome\":\"close the quarter\",\"to\":\"\"}");
        std::test::assert_eq_int(requested.status, 200, "taken while the spine is away: " + requested.body);
        std::test::assert(record_has(app, "ledger.requested", "close the quarter", 30), "a request in the record, waiting for the spine");
        // bob retires meanwhile — a fact of the record
        let retired = in_dir(app, toolchain() + "\ndna\nretire\nbob\n--to\nalice\n--as\nalice");
        std::test::assert(retired.code == 0, "bob retired: " + retired.stdout + retired.stderr);
        let spine2 = start_spine(app, owner);
        std::test::assert(record_has(app, "ledger.request_refused", "bob retired from this organism", 300), "the request is checked against the record as it is now, not as it was, and refused in the record");
        let ledger3 = as_head(app, head_dsn, toolchain() + "\ndna\nledger\nrows").stdout;
        std::test::assert(!std::str::contains(ledger3, "close the quarter"), "and nothing landed for it");

        let stop = dna::run_tool("kill\n" + pid);
        stop_spine(app, spine2);
        std::test::assert_eq_str(dna::unmigrate(owner, dna::GitJournal { repo: app }.genesis()), "", "this run's schema and roles dropped");
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
