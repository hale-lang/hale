// dna/knowledge/ledger.hl — the Ledger: the organism's operational memory
// in the store (GH #646 stage 1, #650). `PqLedger` is the record-scoped
// table in Postgres, `MemLedger` the same contract for the life of a
// process. The knowledge service serves either over HTTP (`/ledger/*`),
// and the core's `ServiceLedger` is what an organism and a head hold.
//
// Rows are appended under compare-and-swap on the tail — one insert
// conditioned on the row count — so a reservation read at a revision
// cannot land after a writer that changed it (GH #605 without a ref).
// Claim kinds (`effect.requested`, `spend.reserved`, `task.born`) carry
// a unique constraint on (kind, entity): the exclusive claim is the
// database's, not a scan's. Every row keeps its sha256 chain as the
// memory journal does, so a reader verifies the Ledger the same way.
//
// Adoption (`hale dna ledger adopt`) copies the record's operational rows
// here keyed by their commit, so a copy interrupted anywhere is rerun,
// never repaired; the cutover row names the record head it was taken at.

// What the Ledger says about its adoption.
type Cutover {
    adopted: Bool = false;
    checkpoint: String = ""; // the record head the operational rows were copied at
    copied: Int = 0;
    routing: Int = 0;
}

// What a reader of the ledger needs — the graph's visibility, a head's
// status: the rows, their head and the adoption checkpoint (GH #985).
interface LedgerView {
    fn revision() -> Int;
    fn head() -> String;
    fn refresh() -> Bool;
    fn read(i: Int) -> Event;
    fn verify_chain() -> Bool;
    fn checkpoint() -> Cutover;
    fn last_error() -> String;
}

// The Ledger as memory holds it: a `Journal`, scoped to a record, opened
// before use, with the adoption steps.
interface Ledger {
    fn kind() -> String;
    fn scope(record: String);
    fn open() -> Bool;
    fn last_error() -> String;
    // ---- Journal
    fn revision() -> Int;
    fn head() -> String;
    fn refresh() -> Bool;
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult;
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult;
    fn read(i: Int) -> Event;
    fn verify_chain() -> Bool;
    fn author_of(i: Int) -> String;
    // ---- adoption
    // One record row copied in, keyed by its commit: true when it is
    // here (already or now).
    fn adopt_row(kind: String, entity: String, body: String, author: String, record_seq: Int, commit: String) -> Bool;
    fn cutover(checkpoint: String, copied: Int, routing: Int) -> Bool;
    fn checkpoint() -> Cutover;
    fn abandon() -> Bool;
    // ---- requests (GH #646 stage 3, #652): a request id seen before is
    // answered as it was (the revision its row landed at, or -1 when it
    // was refused); an id never seen is -2.
    fn seen(request_id: String) -> Int;
    fn mark(request_id: String, revision: Int) -> Bool;
    // The row at `i` is in a person's name (the service admitted it as them).
    fn name_author(i: Int, author: String) -> Bool;
}

// The row as it is served: the event plus its author.
fn row_json(e: Event, author: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.int_field("seq", e.seq);
    b.string_field("kind", e.kind);
    b.string_field("entity", e.entity);
    b.string_field("body", e.body);
    b.string_field("author", author);
    b.string_field("prev", e.prev);
    b.string_field("digest", e.digest);
    b.end_object();
    return b.result();
}

fn claim_kind(kind: String) -> Bool {
    return kind == "effect.requested" || kind == "spend.reserved" || kind == "task.born";
}

// ---- in memory ------------------------------------------------------------

// ---- Postgres ---------------------------------------------------------------

locus PqLedger {
    params {
        conn: pq::PgConn = pq::PgConn { sslmode: "prefer" };
        // GH #985: the environment variable naming this store's DSN, read
        // at open; "" when the connection was built from a DSN in hand
        dsn_env: String = "";
        record_id: String = "";
        opened: Bool = false;
        error: String = "";
        rows: EventRows = EventRows { };
        authors: Authors = Authors { };
        dialling: Bool = false;
    }
    // a store holds one connection, and gives it back when it goes (GH #985)
    dissolve() { self.conn.close(); }
    fn kind() -> String { return "postgres"; }
    fn scope(record: String) {
        if record == self.record_id { return; }
        self.record_id = record;
        self.opened = false;
    }
    fn schema() -> String { return schema_for(self.record_id); }
    fn fail(what: String, e: db::DbError) -> Bool {
        self.error = what + ": " + e.kind + " " + e.detail;
        return false;
    }
    fn last_error() -> String { return self.error; }
    // One schema per record, the same the knowledge store uses; the
    // Ledger's tables beside it. Claim kinds are unique by (kind, entity).
    fn open() -> Bool {
        if self.opened { return true; }
        let dialled = dial_from_env(self.conn, self.dsn_env);
        if len(dialled) > 0 { self.error = dialled; return false; }
        let st = self.conn.open();
        if !st.ok { return self.fail("open", st.err); }
        // the schema is the owner's to create (GH #985): checked here
        let sch = self.schema();
        let ns = self.conn.exec("SET search_path TO " + sch + ", public");
        if !ns.ok { return self.fail("scope (schema " + sch + ")", ns.err); }
        let fence = memory_fence(self.conn, sch);
        if len(fence) > 0 { self.error = fence; self.conn.close(); return false; }
        self.opened = true;
        self.load();
        return true;
    }
    // Drop the connection and open it again, schema and all: a database
    // restart, a failover or an idle timeout leaves the connection dead
    // and every statement failing until then. The protected store learnt
    // this under #637; the ledger and the leases are newer and had not.
    fn redial() -> Bool {
        if self.dialling { return false; }
        self.dialling = true;
        self.conn.close();
        self.opened = false;
        let ok = self.open();
        self.dialling = false;
        return ok;
    }
    // A statement, and once more over a fresh connection when the first
    // attempt fails. The retry sees the store as it is, so a statement
    // that landed before the connection died reports what it finds (a
    // stale tail, a claim taken) rather than landing twice.
    fn run_q(sql: String, a: db::Args) -> db::Rows {
        let r = self.conn.query_params(sql, a);
        if r.ok || !self.redial() { return r; }
        return self.conn.query_params(sql, a);
    }
    fn run_x(sql: String, a: db::Args) -> db::ExecResult {
        let r = self.conn.exec_params(sql, a);
        if r.ok || !self.redial() { return r; }
        return self.conn.exec_params(sql, a);
    }
    fn run_one(sql: String) -> db::Row {
        let r = self.conn.query_one(sql);
        if r.ok || !self.redial() { return r; }
        return self.conn.query_one(sql);
    }
    fn run_all(sql: String) -> db::Rows {
        let r = self.conn.query_all(sql);
        if r.ok || !self.redial() { return r; }
        return self.conn.query_all(sql);
    }
    fn run_sql(sql: String) -> db::ExecResult {
        let r = self.conn.exec(sql);
        if r.ok || !self.redial() { return r; }
        return self.conn.exec(sql);
    }
    // Every row from the one after the last held, in order, as JSON per
    // line (the driver's rows are tab-separated with no escaping; a body
    // is free text).
    @unbounded
    fn load() {
        let a = db::Args { };
        a.add(to_string(self.rows.len()));
        let rows = self.run_q("SELECT row_to_json(t) FROM (SELECT seq, kind, entity, body, author, prev, digest FROM ledger_rows WHERE seq >= $1::bigint ORDER BY seq) t", a);
        if !rows.ok { self.error = "load: " + rows.err.kind + " " + rows.err.detail; return; }
        let mut rest = rows.csv;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = if nl < 0 { rest } else { rest[0..nl] };
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            if len(trim_nl(line)) == 0 { continue; }
            let seq = std::json::find_int_field(line, "seq");
            if seq != self.rows.len() { self.error = "load: Ledger sequence is not contiguous"; return; }
            self.rows.push(Event {
                seq: seq,
                kind: std::json::find_string_field(line, "kind"),
                entity: std::json::find_string_field(line, "entity"),
                body: std::json::find_string_field(line, "body"),
                prev: std::json::find_string_field(line, "prev"),
                digest: std::json::find_string_field(line, "digest")
            });
            self.authors.push(std::json::find_string_field(line, "author"));
        }
    }
    fn revision() -> Int { return self.rows.len(); }
    fn head() -> String {
        if self.rows.len() == 0 { return "genesis"; }
        let e = self.rows.get(self.rows.len() - 1) or Event { };
        return e.digest;
    }
    fn refresh() -> Bool {
        // last_error describes this read, not an earlier refused command.
        self.error = "";
        if !self.opened { self.error = "refresh: Ledger is not open"; return false; }
        // Count alone misses a deletion paired with another append. Inspect
        // density and the authoritative tail in the same database statement.
        let n = self.run_one("SELECT count(*)::text || E'\\t' || coalesce(min(seq),0)::text || E'\\t' || coalesce(max(seq),-1)::text || E'\\t' || coalesce((SELECT digest FROM ledger_rows ORDER BY seq DESC LIMIT 1),'genesis') FROM ledger_rows");
        if !n.ok { self.error = "refresh: " + n.err.kind + " " + n.err.detail; return false; }
        let row = trim_nl(n.data);
        let count = std::str::parse_int(tab_field(row, 0)) or - 1;
        let first = std::str::parse_int(tab_field(row, 1)) or - 1;
        let last = std::str::parse_int(tab_field(row, 2)) or - 2;
        let head = tab_field(row, 3);
        if count < 0 || first != 0 || last != count - 1 { self.error = "refresh: Ledger sequence is not contiguous"; return false; }
        if count < self.rows.len() { self.error = "refresh: Ledger row count moved backwards"; return false; }
        if count == self.rows.len() {
            if head != self.head() { self.error = "refresh: Ledger history changed at the same revision"; }
            return false;
        }
        self.load();
        if len(self.error) > 0 { return false; }
        if self.rows.len() != count || self.head() != head { self.error = "refresh: Ledger changed during read or rows are incomplete"; return false; }
        return true;
    }
    fn read(i: Int) -> Event { return self.rows.get(i) or Event { }; }
    fn author_of(i: Int) -> String { return self.authors.get(i) or ""; }
    fn verify_chain() -> Bool { return chain_ok(self.rows); }
    // One insert conditioned on the tail: zero rows means another writer
    // got there first (or a claim is taken: a unique violation).
    fn insert(seq: Int, kind: String, entity: String, body: String, author: String, record_seq: Int, commit: String) -> String {
        let prev = self.head();
        let digest = event_digest(prev, kind, entity, body);
        let a = db::Args { };
        a.add(to_string(seq));
        a.add(kind);
        a.add(entity);
        a.add(body);
        a.add(author);
        a.add(prev);
        a.add(digest);
        a.add(if record_seq < 0 { "" } else { to_string(record_seq) });
        a.add(commit);
        let r = self.run_q("INSERT INTO ledger_rows (seq, kind, entity, body, author, prev, digest, record_seq, record_commit) SELECT $1::bigint, $2, $3, $4, $5, $6, $7, NULLIF($8, '')::bigint, NULLIF($9, '') WHERE (SELECT coalesce(max(seq) + 1, 0) FROM ledger_rows) = $1::bigint RETURNING seq", a);
        if !r.ok {
            if std::str::contains(r.err.detail, "ledger_rows_claim") { self.error = "claimed"; return "claimed"; } // ledger_rows_claims
            if std::str::contains(r.err.detail, "ledger_rows_commit") { return "duplicate"; }
            self.error = "append: " + r.err.kind + " " + r.err.detail;
            return "io";
        }
        if r.n == 0 { return "stale"; }
        self.rows.push(Event { seq: seq, kind: kind, entity: entity, body: body, prev: prev, digest: digest });
        self.authors.push(author);
        return "";
    }
    // Compare-and-append: the in-process check against `expected`, then
    // the store's; a lost race reloads and re-appends at the new tail,
    // as the record does (GH #603).
    @unbounded
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let rev = self.rows.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let mut attempt = 0;
        while attempt < 200 {
            let out = self.insert(self.rows.len(), kind, entity, body, "ledger", -1, "");
            if len(out) == 0 { return AppendResult { ok: true, revision: self.rows.len() }; }
            if out != "stale" { return AppendResult { error: if out == "claimed" { "claimed" } else { "io" }, expected: expected, actual: self.rows.len() }; }
            self.load();
            attempt = attempt + 1;
        }
        self.error = "append lost the tail two hundred times";
        return AppendResult { error: "io", expected: expected, actual: self.rows.len() };
    }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let moved = self.refresh();
        let rev = self.rows.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let out = self.insert(rev, kind, entity, body, "ledger", -1, "");
        if len(out) == 0 { return AppendResult { ok: true, revision: self.rows.len() }; }
        if out == "stale" { self.load(); return AppendResult { error: "stale_revision", expected: expected, actual: self.rows.len() }; }
        return AppendResult { error: if out == "claimed" { "claimed" } else { "io" }, expected: expected, actual: self.rows.len() };
    }
    @unbounded
    fn adopt_row(kind: String, entity: String, body: String, author: String, record_seq: Int, commit: String) -> Bool {
        let mut attempt = 0;
        while attempt < 200 {
            let out = self.insert(self.rows.len(), kind, entity, body, author, record_seq, commit);
            if len(out) == 0 || out == "duplicate" { return true; }
            if out != "stale" { return false; }
            self.load();
            attempt = attempt + 1;
        }
        return false;
    }
    fn put_meta(key: String, value: String) -> Bool {
        let a = db::Args { };
        a.add(key);
        a.add(value);
        let r = self.run_x("INSERT INTO ledger_meta (key, value) VALUES ($1, $2) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value", a);
        if !r.ok { return self.fail("meta " + key, r.err); }
        return true;
    }
    fn meta(key: String) -> String {
        let a = db::Args { };
        a.add(key);
        let rows = self.run_q("SELECT value FROM ledger_meta WHERE key = $1", a);
        if !rows.ok { self.error = "meta " + key + ": " + rows.err.kind + " " + rows.err.detail; return ""; }
        if rows.n == 0 { return ""; }
        return trim_nl(line_one(rows.csv));
    }
    fn cutover(checkpoint: String, copied: Int, routing: Int) -> Bool {
        return self.put_meta("checkpoint", checkpoint) && self.put_meta("copied", to_string(copied)) && self.put_meta("routing", to_string(routing)) && self.put_meta("record", self.record_id);
    }
    fn checkpoint() -> Cutover {
        let at = self.meta("checkpoint");
        if len(at) == 0 { return Cutover { }; }
        return Cutover { adopted: true, checkpoint: at, copied: std::str::parse_int(self.meta("copied")) or 0, routing: std::str::parse_int(self.meta("routing")) or 0 };
    }
    fn name_author(i: Int, author: String) -> Bool {
        let a = db::Args { };
        a.add(to_string(i));
        a.add(author);
        let r = self.run_x("UPDATE ledger_rows SET author = $2 WHERE seq = $1::bigint", a);
        if !r.ok { return self.fail("author", r.err); }
        if i >= 0 && i < self.authors.len() { self.authors.set(i, author) or discard; }
        return true;
    }
    fn seen(request_id: String) -> Int {
        let a = db::Args { };
        a.add(request_id);
        let rows = self.run_q("SELECT revision FROM ledger_requests WHERE request_id = $1", a);
        if !rows.ok || rows.n == 0 { return -2; }
        return std::str::parse_int(trim_nl(line_one(rows.csv))) or - 2;
    }
    fn mark(request_id: String, revision: Int) -> Bool {
        let a = db::Args { };
        a.add(request_id);
        a.add(to_string(revision));
        let r = self.run_x("INSERT INTO ledger_requests (request_id, revision) VALUES ($1, $2::bigint) ON CONFLICT (request_id) DO NOTHING", a);
        if !r.ok { return self.fail("mark", r.err); }
        return true;
    }
    fn abandon() -> Bool {
        let r = self.run_sql("DELETE FROM ledger_rows; DELETE FROM ledger_meta; DELETE FROM ledger_requests");
        if !r.ok { return self.fail("abandon", r.err); }
        while self.rows.len() > 0 { let gone = self.rows.pop() or Event { }; }
        while self.authors.len() > 0 { let gone = self.authors.pop() or ""; }
        return true;
    }
}

// ---- leases in the store (GH #646 stage 2, #651) ------------------------------
//
// A lease is swapped by its token: `put` lands only when the stored
// token is the one expected (0 for an absent lease). Mutation leases
// and the body lease stand on `current` and `put`; the fence renews a
// row, and a stale token — a host that lost its lease to another — is
// refused by the store.

interface LeaseStore {
    fn kind() -> String;
    fn scope(record: String);
    fn open() -> Bool;
    fn last_error() -> String;
    // `known` false when no lease was ever put under the key.
    fn current(key: String) -> StoredLease;
    fn put(key: String, holder: String, token: Int, expires: Int, present: Bool, expected: Int) -> Bool;
}

type StoredLease {
    known: Bool = false;
    key: String = "";
    holder: String = "";
    token: Int = 0;
    expires: Int = 0;
    present: Bool = false;
}

fn stored_lease_json(l: StoredLease) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.bool_field("known", l.known);
    b.string_field("key", l.key);
    b.string_field("holder", l.holder);
    b.int_field("token", l.token);
    b.int_field("expires", l.expires);
    b.bool_field("present", l.present);
    b.end_object();
    return b.result();
}

locus PqLeaseStore {
    params {
        conn: pq::PgConn = pq::PgConn { sslmode: "prefer" };
        // GH #985: the environment variable naming this store's DSN, read
        // at open; "" when the connection was built from a DSN in hand
        dsn_env: String = "";
        record_id: String = "";
        opened: Bool = false;
        error: String = "";
        dialling: Bool = false;
    }
    // a store holds one connection, and gives it back when it goes (GH #985)
    dissolve() { self.conn.close(); }
    fn kind() -> String { return "postgres"; }
    fn scope(record: String) {
        if record == self.record_id { return; }
        self.record_id = record;
        self.opened = false;
    }
    fn last_error() -> String { return self.error; }
    fn fail(what: String, e: db::DbError) -> Bool {
        self.error = what + ": " + e.kind + " " + e.detail;
        return false;
    }
    fn open() -> Bool {
        if self.opened { return true; }
        let dialled = dial_from_env(self.conn, self.dsn_env);
        if len(dialled) > 0 { self.error = dialled; return false; }
        let st = self.conn.open();
        if !st.ok { return self.fail("open", st.err); }
        // the schema is the owner's to create (GH #985): checked here
        let sch = schema_for(self.record_id);
        let ns = self.conn.exec("SET search_path TO " + sch + ", public");
        if !ns.ok { return self.fail("scope (schema " + sch + ")", ns.err); }
        let fence = memory_fence(self.conn, sch);
        if len(fence) > 0 { self.error = fence; self.conn.close(); return false; }
        self.opened = true;
        return true;
    }
    // As the ledger's: dial again once when a statement fails.
    fn redial() -> Bool {
        if self.dialling { return false; }
        self.dialling = true;
        self.conn.close();
        self.opened = false;
        let ok = self.open();
        self.dialling = false;
        return ok;
    }
    fn run_q(sql: String, a: db::Args) -> db::Rows {
        let r = self.conn.query_params(sql, a);
        if r.ok || !self.redial() { return r; }
        return self.conn.query_params(sql, a);
    }
    fn current(key: String) -> StoredLease {
        let a = db::Args { };
        a.add(key);
        let rows = self.run_q("SELECT row_to_json(t) FROM (SELECT key, holder, token, expires, present FROM ledger_leases WHERE key = $1) t", a);
        if !rows.ok { self.error = "current: " + rows.err.kind + " " + rows.err.detail; return StoredLease { key: key }; }
        if rows.n == 0 { return StoredLease { key: key }; }
        let row = trim_nl(line_one(rows.csv));
        return StoredLease { known: true, key: key, holder: std::json::find_string_field(row, "holder"), token: std::json::find_int_field(row, "token"), expires: std::json::find_int_field(row, "expires"), present: std::json::find_bool_field(row, "present") };
    }
    // One statement: insert when nothing is there and 0 was expected,
    // else update where the stored token is the one expected.
    fn put(key: String, holder: String, token: Int, expires: Int, present: Bool, expected: Int) -> Bool {
        let a = db::Args { };
        a.add(key);
        a.add(holder);
        a.add(to_string(token));
        a.add(to_string(expires));
        a.add(if present { "true" } else { "false" });
        a.add(to_string(expected));
        let r = self.run_q("INSERT INTO ledger_leases (key, holder, token, expires, present) SELECT $1, $2, $3::bigint, $4::bigint, $5::boolean WHERE $6::bigint = 0 AND NOT EXISTS (SELECT 1 FROM ledger_leases WHERE key = $1) ON CONFLICT (key) DO NOTHING RETURNING key", a);
        if !r.ok { self.error = "put: " + r.err.kind + " " + r.err.detail; return false; }
        if r.n > 0 { return true; }
        let u = self.run_q("UPDATE ledger_leases SET holder = $2, token = $3::bigint, expires = $4::bigint, present = $5::boolean, at = now() WHERE key = $1 AND token = $6::bigint RETURNING key", a);
        if !u.ok { self.error = "put: " + u.err.kind + " " + u.err.detail; return false; }
        return u.n > 0;
    }
}
