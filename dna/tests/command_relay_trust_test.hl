// Actual production relay over a native Record. /bin/true is only a transport
// probe: invoking it would report a successful relay, without fabricating any
// domain outcome. Failed signing must never turn a retry into trusted delivery.
import "../core" as dna;
import "../host" as host;

fn relay_child(root: String) {
    let p = host::open_projection(root, ".", "", dna::Memory { repo: root });
    let expired = host::relay_mark("\n", host::fact_key(p, 0), std::time::now() - host::RELAY_AGAIN_AFTER - 1);
    let state = host::relay_record_membrane(root, ".", "", "test", expired, dna::Memory { repo: root });
    println("relayed=", state.count);
}

fn check() {
    let root = "/tmp/dna-command-relay-trust-" + to_string(std::process::pid());
    std::io::fs::mkdir(root) or discard;
    let init = dna::run_tool("git\n-C\n" + root + "\ninit\n-q\n-b\nmain");
    std::test::assert_eq_int(init.code, 0, "native relay Record");
    let journal = dna::GitJournal { repo: root };
    let v = dna::Verdict { command_id: "command/unsigned", review_id: "k:pending", subject_digest: "sha256:pending", verdict: "approve", reviewer: "board-member", authority: "board" };
    let b = std::json::Builder { };
    b.begin_object(); b.string_field("command_id", v.command_id); b.string_field("review_id", v.review_id);
    b.string_field("subject_digest", v.subject_digest); b.string_field("verdict", v.verdict);
    b.string_field("reviewer", v.reviewer); b.string_field("authority", v.authority); b.string_field("comment", ""); b.end_object();
    let input = journal.append_exact(journal.revision(), "review.verdict", v.review_id, b.result());
    std::test::assert(input.ok, "unsigned native trigger input");
    let trust = dna::run_tool("git\n-C\n" + root + "\nconfig\ndna.trust\nsigned");
    let signing = dna::run_tool("git\n-C\n" + root + "\nconfig\ngpg.program\n/bin/false");
    std::test::assert_eq_int(trust.code + signing.code, 0, "signed policy with unavailable signing service");
    let initial = host::relay_record_membrane(root, ".", "", "test", "\n", dna::Memory { repo: root });
    std::test::assert_eq_int(initial.count, 0, "first unsigned attempt never reaches membrane");
    let refreshed = journal.refresh();
    std::test::assert_eq_int(journal.revision(), 1, "refusal append really failed");
    let child = dna::run_tool("env\nHALE_DNA_MEMBRANE=/bin/true\n" + std::env::arg_or(0, "") + "\nrelay\n" + root);
    std::test::assert_eq_int(child.code, 0, "expired retry probe finished");
    std::test::assert_eq_str(std::str::trim(child.stdout), "relayed=0", "expired retry still refuses the unverified row before transport");
    let fresh = dna::GitJournal { repo: root };
    std::test::assert_eq_int(fresh.revision(), 1, "retry creates no acceptance or unsigned refusal");
    let removed = dna::run_tool("rm\n-rf\n" + root);
}

main locus App {
    run() {
        if std::env::arg_or(1, "") == "relay" { relay_child(std::env::arg_or(2, "")); }
        else { check(); }
    }
}
fn main() { App { }; }
