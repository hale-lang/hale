// dna/tests/journal_contention_test.hl — GH #603: an organism's append
// that loses the ref race goes round with the new tail until it
// lands. Three tries used to be the bound; a host reconciling the
// record beside a busy organism won every race for seconds, and the
// organism's own rows — an apply, a restart request — were dropped in
// silence, the mutation never retained. Here another writer (a shell
// loop, compare-and-swapping like a host) appends two hundred rows
// while the journal appends forty; every row of both lands, once.

import "../core" as dna;

const SCRIPT: String = "repo=\"$1\"; n=0\nwhile [ $n -lt 200 ]; do\n  head=$(git -C \"$repo\" rev-parse -q --verify refs/dna/journal)\n  text=$(git -C \"$repo\" show \"$head:journal.jsonl\")\n  seq=$(printf '%s\\n' \"$text\" | grep -c .)\n  row=\"{\\\"seq\\\": $seq, \\\"kind\\\": \\\"shell.row\\\", \\\"entity\\\": \\\"s$n\\\", \\\"body\\\": \\\"row $n\\\", \\\"author\\\": \\\"shell\\\"}\"\n  blob=$(printf '%s\\n%s\\n' \"$text\" \"$row\" | git -C \"$repo\" hash-object -w --stdin)\n  tree=$(printf '100644 blob %s\\tjournal.jsonl\\n' \"$blob\" | git -C \"$repo\" mktree)\n  c=$(git -C \"$repo\" -c user.name=shell -c user.email=s@l commit-tree \"$tree\" -p \"$head\" -m \"shell $n\")\n  if git -C \"$repo\" update-ref refs/dna/journal \"$c\" \"$head\" 2>/dev/null; then n=$((n+1)); fi\ndone\ntouch \"$repo/.hale/dna/shell.done\"\n";

main locus App {
    params {
        j: dna::GitJournal = dna::GitJournal { };
    }
    @unbounded
    fn count(kind: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            if self.j.read(i).kind == kind { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn has_body(body: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            if self.j.read(i).body == body { return true; }
            i = i + 1;
        }
        return false;
    }
    run() {
        let repo = dna::scratch_root("jc");
        std::io::fs::mkdir(repo + "/.hale") or discard;
        std::io::fs::mkdir(repo + "/.hale/dna") or discard;
        let init = dna::run_tool("git\n-C\n" + repo + "\ninit\n-q\n-b\nmain");
        self.j = dna::GitJournal { repo: repo, author: "org" };
        let seed = self.j.append(self.j.revision(), "seed", "s", "the first row");
        std::test::assert(seed.ok, "seeded");
        std::io::fs::write_file(repo + "/.hale/dna/appender.sh", SCRIPT) or discard;
        // the other writer, detached: it compare-and-swaps like a host does
        let spawn = dna::run_tool("sh\n-c\nnohup sh \"$1\" \"$2\" >/dev/null 2>&1 &\nsh\n" + repo + "/.hale/dna/appender.sh\n" + repo);
        std::test::assert_eq_int(spawn.code, 0, "the appender started: " + spawn.stderr);
        let mut i = 0;
        while i < 40 {
            let r = self.j.append(self.j.revision(), "org.row", "o" + to_string(i), "org row " + to_string(i));
            std::test::assert(r.ok, "org row " + to_string(i) + " landed (" + r.error + ": " + self.j.last_error + ")");
            i = i + 1;
        }
        let mut waited = 0;
        while !std::io::fs::file_exists(repo + "/.hale/dna/shell.done") && waited < 1200 {
            std::time::sleep(100ms);
            waited = waited + 1;
        }
        std::test::assert(waited < 1200, "the appender finished");
        self.j.load();
        std::test::assert_eq_int(self.count("shell.row"), 200, "every shell row landed");
        std::test::assert_eq_int(self.count("org.row"), 40, "every org row landed, once");
        std::test::assert_eq_int(self.j.revision(), 241, "and nothing else");
        i = 0;
        while i < 40 {
            std::test::assert(self.has_body("org row " + to_string(i)), "org row " + to_string(i) + " is in the record");
            i = i + 1;
        }
        dna::scratch_done(repo);
    }
}
fn main() { App { }; }
