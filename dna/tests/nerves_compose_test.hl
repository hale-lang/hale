// dna/tests/nerves_compose_test.hl — the nerves `hale dna init` writes,
// as `hale dna dev` runs them (GH #986).
//
// With no NATS server named (HALE_DNA_NATS_URL_OWNER unset), `dev` brings
// up the `nerves` service of the project's own dna/compose.yaml — NATS
// with JetStream, configured by dna/nats.conf: one user per family of
// subjects, each allowed only its own. It creates the organization's
// stream as the owner and hands the host the spine's user alone. The
// organization reads its facts through the durable consumer that user
// may pull, and a task asked from the clone is born: the relay, the
// stream, the consumer and every permission they need, on the
// configuration a project runs. The passwords are the seed's own (GH
// #989): drawn into the vault by init, rotated by upgrade, written into
// the untracked, mode-600 dna/nats.secrets.conf, never into the tracked
// dna/nats.conf; a tracked secrets file is refused, and so is a vault
// with nothing in it. The application the record attaches holds an
// account of its own (GH #989): it publishes on its own subjects and no
// other application's, and `hale dna application remove` revokes it.
// Without docker compose, or without memory's owner DSN, nothing here is
// exercised.

import "../core" as dna;
import "../core/pond/realtime/nats" as nats;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, with no NATS server named:
// `dev` must use compose's, under the seed's own compose project (its
// name is this run's). The vault is this run's own (HALE_VAULT_DIR under
// the scratch root).
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_VAULT_DIR=\"$2\" && shift 2 && unset COMPOSE_PROJECT_NAME ANTHROPIC_API_KEY OPENAI_API_KEY HALE_DNA_NATS_URL_OWNER HALE_DNA_NATS_URL_SPINE HALE_DNA_NATS_ORG HALE_VAULT_ADDR && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + vault_of(dir) + "\n" + argv);
}

// The scratch root's vault: `/tmp/dna-nerves-compose-<pid>/vault`.
fn vault_of(dir: String) -> String {
    let at = std::str::index_of(dir, "/nervous");
    return (if at > 0 { dir[0..at] } else { dir }) + "/vault";
}

main locus App {
    params { app: String = ""; refused: String = ""; }
    // GH #989: a JetStream publish as the attached application `name`, on
    // `<org>.app.<under>.probe.checked`, with the password its own entry of
    // the run's vault holds (copied into this test's vault, which pond's
    // client reads): the stream's sequence, -1 when it was refused, -2 when
    // the account could not connect at all (why in `self.refused`).
    fn app_publish(org: String, name: String, hp: String, under: String) -> Int {
        let c = nats::NatsClient { url: "nats://" + hp, user: dna::nerves_app_user(name), credential: std::secret::Credential { vault: dna::nerves_app_vault(org, name) }, name: "nerves-compose-app", timeout: 2s };
        if !c.open() { self.refused = c.last_error; return -2; }
        let ack = nats::js_publish(c, org + ".app." + under + ".probe.checked", std::bytes::from_string("{\"id\": \"probe-" + under + "\"}")) or nats::PubAck { seq: -1 };
        c.close();
        return ack.seq;
    }
    // The run's vault entry `entry`, copied into this test's own vault.
    fn lend(scratch: String, entry: String) -> Bool {
        return dna::run_tool("sh\n-c\nmkdir -p \"$2\" && cp \"$1/$3\" \"$2/$3\" && chmod 600 \"$2/$3\"\nsh\n" + scratch + "/vault\n" + std::secret::vault_local_dir() + "\n" + entry).code == 0;
    }
    // The heart's durable deleted, as the owner over compose's nerves (`hp`,
    // host:port), under this file's own vault, given the owner's entry
    // alone: "" when done, else why.
    fn stop_the_heart(org: String, scratch: String, hp: String) -> String {
        let entry = dna::nerves_vault_name(org, "owner");
        let copied = dna::run_tool("sh\n-c\numask 077 && cp \"$1/vault/$3\" \"$2/$3\"\nsh\n" + scratch + "\n" + std::secret::vault_local_dir() + "\n" + entry);
        if copied.code != 0 { return "the owner's entry: " + copied.stderr; }
        let c = nats::NatsClient { url: "nats://" + hp, user: "owner", credential: std::secret::Credential { vault: dna::nerves_vault_name(org, "owner") }, name: "fixture-owner", timeout: 2s };
        if !c.open() { return "no owner connection: " + c.last_error; }
        let r = nats::js_call(c, "$JS.API.CONSUMER.DELETE." + dna::nerves_stream(org) + "." + dna::NERVES_HEART_DURABLE, "") or "";
        c.close();
        return if std::str::contains(r, "\"success\":true") { "" } else { "the delete answered: " + r + " " + c.last_error };
    }
    // Whether the heart's durable is there again within ten seconds.
    @unbounded
    fn heart_again(org: String, hp: String) -> Bool {
        let c = nats::NatsClient { url: "nats://" + hp, user: "owner", credential: std::secret::Credential { vault: dna::nerves_vault_name(org, "owner") }, name: "fixture-owner", timeout: 2s };
        if !c.open() { return false; }
        let mut tries = 0;
        let mut there = false;
        while !there && tries < 40 {
            let r = nats::js_call(c, "$JS.API.CONSUMER.INFO." + dna::nerves_stream(org) + "." + dna::NERVES_HEART_DURABLE, "") or "";
            there = std::str::contains(r, "\"name\":\"" + dna::NERVES_HEART_DURABLE + "\"");
            if !there { std::time::sleep(250ms); }
            tries = tries + 1;
        }
        c.close();
        return there;
    }
    fn log() -> String { return std::io::fs::read_file(self.app + "/.hale/dev.log") or ""; }
    // Whether the host's log comes to say `text` within `secs`.
    @unbounded
    // Whether `text` reaches dev's log within `secs`. A dev that cannot
    // start compose, or that has ended, never will: that is known at once,
    // and said, rather than after the whole deadline.
    fn logged(text: String, secs: Int, host: String) -> Bool {
        let deadline = std::time::now() + dna::wait_secs(secs);
        while std::time::now() <= deadline {
            let log = self.log();
            if std::str::contains(log, text) { return true; }
            if std::str::contains(log, "docker compose up failed") { return false; }
            if len(host) > 0 && dna::run_tool("kill\n-0\n" + host).code != 0 { return std::str::contains(self.log(), text); }
            std::time::sleep(500ms);
        }
        return false;
    }
    run() {
        if !std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { eprintln("nerves_compose_test: not exercised (HALE_DNA_MEMORY_DSN_OWNER is not set)"); return; }
        if dna::run_tool("docker\ncompose\nversion").code != 0 { eprintln("nerves_compose_test: not exercised (docker compose is not on PATH)"); return; }
        let scratch = dna::scratch_root("nerves-compose");
        dna::reap_on_exit(scratch);
        let name = "nervous" + to_string(std::process::pid());
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\n" + name);
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        self.app = scratch + "/" + name;
        let compose = std::io::fs::read_file(self.app + "/dna/compose.yaml") or "";
        std::test::assert(std::str::contains(compose, "\nname: hale-dna-" + name + "\n"), "the seed's compose is a project of its own: " + compose);
        let conf = std::io::fs::read_file(self.app + "/dna/nats.conf") or "";
        std::test::assert(std::str::contains(conf, "user: spine") && std::str::contains(conf, "jetstream"), "init writes the nerves' server configuration: " + conf);
        // GH #989: the conf is tracked and holds no password; the secrets
        // file does, drawn by the bootstrap with the vault, mode 600, ignored
        let secrets = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";
        let at = std::str::index_of(secrets, "NATS_SPINE_PASSWORD: \"");
        let spine_pw = if at < 0 { "" } else { secrets[(at + 22)..(at + 54)] };
        let org = dna::schema_for(dna::GitRecord { repo: self.app }.identity());
        let vault_env = "HALE_VAULT_DIR=" + scratch + "/vault";
        let matched = dna::run_tool("env\n" + vault_env + "\n" + toolchain() + "\ndna\nsecrets\n" + self.app);
        std::test::assert(len(spine_pw) == 32 && std::str::contains(matched.stdout, "present  " + dna::nerves_vault_name(org, "spine")) && !std::str::contains(matched.stdout, "MISSING  " + dna::nerves_vault_name(org, "spine")), "the bootstrap drew the spine's password into the vault and the secrets file: " + matched.stdout + matched.stderr);
        std::test::assert(!std::str::contains(matched.stdout, spine_pw), "and `hale dna secrets` names it, never shows it");
        std::test::assert(std::str::contains(conf, "password: $NATS_SPINE_PASSWORD") && std::str::contains(conf, "include ./nats.secrets.conf") && !std::str::contains(conf, spine_pw) && !std::str::contains(conf, "-dev\""), "the tracked conf names the password, never holds it: " + conf);
        std::test::assert_eq_str(dna::file_mode(self.app + "/dna/nats.secrets.conf"), "600", "the secrets file is yours alone");
        std::test::assert_eq_str(dna::file_mode(scratch + "/vault"), "700", "and so is the vault");
        let ignored = in_dir(self.app, "git\ncheck-ignore\n-q\ndna/nats.secrets.conf");
        std::test::assert_eq_int(ignored.code, 0, "and git ignores it");
        // GH #989: the attached application's account, drawn with the rest
        let app_name = dna::nerves_app_name(name);
        std::test::assert(std::str::contains(conf, "user: app-" + app_name + ", password: $NATS_APP_" + std::str::upper(app_name) + "_PASSWORD") && std::str::contains(conf, "publish: [\"*.app." + app_name + ".>\"]") && !std::str::contains(conf, "user: app,"), "the application's own user may publish on its own subjects alone: " + conf);
        std::test::assert(std::str::contains(secrets, "NATS_APP_" + std::str::upper(app_name) + "_PASSWORD: \"") && std::str::contains(matched.stdout, "present  " + dna::nerves_app_vault(org, app_name)), "its password is drawn into the include and the vault: " + matched.stdout);
        let attached = dna::GitJournal { repo: self.app };
        let mut named = "";
        let mut k = 0;
        while k < attached.revision() { let e = attached.read(k); if e.kind == "application.attached" { named = std::json::find_string_field(e.body, "name"); } k = k + 1; }
        std::test::assert_eq_str(named, app_name, "the record attaches the application by its project's name");
        let c0 = in_dir(self.app, "sh\n-c\ngit config user.name riley && git config user.email riley@dna && git add -A && git commit -q -m 'the organization'");
        std::test::assert_eq_int(c0.code, 0, "the scaffold committed: " + c0.stderr);

        // ---- dev, on compose's NATS
        let started = in_dir(self.app, "sh\n-c\nnohup timeout 600 \"$0\" dna dev . --no-iris >.hale/dev.log 2>&1 </dev/null & echo $!\n" + toolchain());
        let host = dna::trim_nl(started.stdout);
        std::test::assert(len(host) > 0, "dev started");
        let reading = self.logged("the organization reads its facts from the nerves", 300, host);
        let asked = if reading { in_dir(self.app, toolchain() + "\ndna\ntask\ncreate\nsay hello to the nerves") } else { dna::RunResult { code: -1 } };

        // ---- the heart's pulse stops (GH #989): its durable deleted, as the
        // owner, while the spine's connection holds. The spine records it
        // once, makes the durable again, and goes on
        let hp = dna::trim_nl(in_dir(self.app, "docker\ncompose\n-f\ndna/compose.yaml\nport\nnerves\n4222").stdout);
        let stopped_the_heart = if reading { self.stop_the_heart(org, scratch, hp) } else { "not reading" };
        let pulse_said = reading && len(stopped_the_heart) == 0 && self.logged("the heart's pull on its durable heart was refused", 60, host);
        let board = in_dir(self.app, toolchain() + "\ndna\nboard\n.");
        let remade = reading && len(stopped_the_heart) == 0 && self.heart_again(org, hp);

        // ---- GH #989: the application's own account publishes under its
        // name and under no other application's; removed, it is revoked
        let lent = reading && self.lend(scratch, dna::nerves_app_vault(org, app_name));
        let own = if lent { self.app_publish(org, app_name, hp, app_name) } else { -3 };
        let other = if lent { self.app_publish(org, app_name, hp, "someone") } else { -3 };
        let removed = if lent { in_dir(self.app, toolchain() + "\ndna\napplication\nremove\n.\n--as\nriley") } else { dna::RunResult { code: -1 } };
        let conf_after = std::io::fs::read_file(self.app + "/dna/nats.conf") or "";
        let secrets_after = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";

        // ---- the stream dropped as the owner, over the authenticated server
        // the stream is dropped as the owner, so the server that restarted
        // for the removal is up; then the application's account is refused
        let dropped = if reading { in_dir(self.app, "sh\n-c\nHALE_DNA_NATS_URL_OWNER=\"nats://$(docker compose -f dna/compose.yaml port nerves 4222)\" \"$0\" dna nerves drop .\n" + toolchain()) } else { dna::RunResult { code: -1 } };

        let revoked = if removed.code == 0 && dropped.code == 0 { self.app_publish(org, app_name, hp, app_name) } else { -3 };

        // ---- down, whatever happened
        let stop = dna::run_tool("sh\n-c\nkill \"$1\" 2>/dev/null; for i in $(seq 1 100); do kill -0 \"$1\" 2>/dev/null || break; sleep 0.1; done; true\nsh\n" + host);
        let down = in_dir(self.app, "docker\ncompose\n-f\ndna/compose.yaml\ndown\n-v");

        std::test::assert(reading, "the organization reads its facts from compose's nerves, as the spine: " + self.log());
        std::test::assert(std::str::contains(asked.stdout, "born for intent"), "a task asked from the clone is born over them: " + asked.stdout + asked.stderr + self.log());
        std::test::assert(!std::str::contains(self.log(), "adapter_undeliverable") && !std::str::contains(self.log(), "Permissions Violation"), "no publish was refused: " + self.log());
        std::test::assert_eq_str(stopped_the_heart, "", "the owner deleted the heart's durable");
        std::test::assert(pulse_said, "the spine names the pulse stopped: " + self.log());
        std::test::assert(std::str::contains(board.stdout, "pulse_stopped heart (") && std::str::contains(board.stdout, "violations: 1 recorded"), "the board shows the violation, recorded once: " + board.stdout + board.stderr);
        std::test::assert(remade, "and the durable is made again: " + self.log());
        std::test::assert(dropped.code == 0 && std::str::contains(dropped.stdout, "dropped DNA_"), "the owner drops the stream, presenting its credential: " + dropped.stdout + dropped.stderr);
        std::test::assert(own > 0, "the application publishes under its own name (" + to_string(own) + "): " + self.refused);
        std::test::assert_eq_int(other, -1, "and not under another application's");
        std::test::assert(removed.code == 0 && std::str::contains(removed.stdout, "`" + app_name + "` detached"), "hale dna application remove detaches it: " + removed.stdout + removed.stderr);
        let mut detached = 0;
        let rec = dna::GitJournal { repo: self.app };
        let mut r = 0;
        while r < rec.revision() { let e = rec.read(r); if e.kind == "application.detached" && std::json::find_string_field(e.body, "name") == app_name && std::json::find_string_field(e.body, "by") == "riley" { detached = detached + 1; } r = r + 1; }
        std::test::assert_eq_int(detached, 1, "one application.detached row in the record, naming it and who");
        std::test::assert(!std::str::contains(conf_after, "app-" + app_name) && !std::str::contains(secrets_after, "NATS_APP_") && std::str::contains(secrets_after, "NATS_SPINE_PASSWORD"), "its user leaves the conf and its password the include, and the roles' stay: " + conf_after);
        std::test::assert(!std::io::fs::file_exists(scratch + "/vault/" + dna::nerves_app_vault(org, app_name)), "its entry leaves the vault");
        std::test::assert(revoked == -2 && std::str::contains(self.refused, "Authorization"), "the server refuses the revoked account (" + to_string(revoked) + "): " + self.refused);
        std::test::assert_eq_int(down.code, 0, "compose's services and volumes go: " + down.stderr);

        // ---- a regenerated seed rotates the passwords
        let upgraded = in_dir(self.app, toolchain() + "\ndna\nupgrade\n.");
        let rotated = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";
        std::test::assert(upgraded.code == 0 && len(rotated) > 0 && rotated != secrets && !std::str::contains(rotated, spine_pw), "upgrade drew every role's password anew: " + upgraded.stdout + upgraded.stderr);
        std::test::assert(!std::str::contains(rotated, "NATS_APP_"), "and none for the application the record detached: " + upgraded.stdout);

        // ---- secrets fail closed: the bootstrap never writes a password into
        // a tracked file, and a consumer with nothing in the vault refuses
        let tracked = in_dir(self.app, "sh\n-c\ngit add -f dna/nats.secrets.conf && \"$0\" dna upgrade .\n" + toolchain());
        let after = std::io::fs::read_file(self.app + "/dna/nats.secrets.conf") or "";
        std::test::assert(std::str::contains(tracked.stdout + tracked.stderr, "is tracked by git") && after == rotated, "a password is never written into a tracked file: " + tracked.stdout + tracked.stderr);
        let untrack = in_dir(self.app, "git\nrm\n-q\n--cached\ndna/nats.secrets.conf");
        let empty = in_dir(self.app, "sh\n-c\nmkdir -p ../empty-vault && HALE_VAULT_DIR=\"$(cd ../empty-vault && pwd)\" \"$0\" dna nerves migrate .\n" + toolchain());
        std::test::assert(empty.code != 0 && std::str::contains(empty.stderr + empty.stdout, "the vault holds no credential"), "no credential in the vault is no connection, never a default: " + empty.stdout + empty.stderr);
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
