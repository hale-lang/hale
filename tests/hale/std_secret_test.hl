// std::secret — the runtime half of GH #436.
//
// The compile-time half (`self.signer.key` is rejected) is pinned in
// `crates/hale-types/tests/std_secret.rs`. What can only be checked by
// running is the construction discipline: `birth` is the sole writer
// of the key, so a caller who tries to seed it directly gets nothing.
//
// Without that, the module's whole claim — "there is no construction
// site at which the caller held the material" — is false, because
// params are constructible by whoever holds the locus.

locus Seeded {
    params { s: std::secret::Signer = std::secret::Signer { key: b"hunter2" }; }
    fn ready() -> Bool { return self.s.ready(); }
    fn mac_len(m: Bytes) -> Int { return len(self.s.sign(m)); }
}

locus FromFile {
    params { s: std::secret::Signer = std::secret::Signer { key_file: "/nonexistent/key" }; }
    fn ready() -> Bool { return self.s.ready(); }
}

locus Unset {
    params { c: std::secret::Credential = std::secret::Credential { env_var: "" }; }
    fn ready() -> Bool { return self.c.ready(); }
    fn tag() -> String { return self.c.fingerprint(); }
}

main locus App {
    params {
        seeded: Seeded = Seeded { };
        from_file: FromFile = FromFile { };
        unset: Unset = Unset { };
    }
}

fn main() {
    let app = App { };

    // The load-bearing one: a key handed in at construction is
    // discarded, so the caller gains nothing by holding it.
    std::test::assert(
        !app.seeded.ready(),
        "a key passed at construction is ignored");

    // An unreadable source is empty, not a crash — a misconfigured
    // deployment reports at startup instead of signing under a
    // silently-empty key.
    std::test::assert(
        !app.from_file.ready(),
        "a missing key file yields an empty key");
    std::test::assert(
        !app.unset.ready(),
        "an unset env var yields an empty credential");

    // Still functional with no key: HMAC-SHA256 is 32 bytes whatever
    // the key length, so `ready()` is the check that matters.
    std::test::assert_eq_int(
        app.seeded.mac_len(b"hello"), 32, "hmac-sha256 width");

    // A fingerprint is derived and publishable even when empty.
    std::test::assert_eq_int(
        len(app.unset.tag()), 16, "fingerprint is 8 bytes as hex");

}
