// dna/api/knowledge_commands.hl — Knowledge commands, the head's gated
// topics (GH #985, #1129).
//
// A Knowledge change is a topic on the head's api binding, like every
// other command the record takes (commands.hl): one flat payload per
// operation under the request id the caller mints, the head supplying the
// record, the principal and the target the operation implies. Every
// change is gated `position` — a person of the record, since the
// Knowledge policy's own grants (per mode and name) decide what that
// person may change and whether it goes to Review; recovery is ungated,
// like `CommandLookup`. The operations' `KnowledgeCommandCodec` is the
// admissibility rule; the provider admits and recovers. A receipt never
// claims graph projection.
import "../core" as dna;
import "../operations" as ops;

// Admission and recovery, in the head's own process (LocalKnowledgeCommands
// in knowledge_memory.hl) under the explicit Knowledge authority policy.
interface KnowledgeCommandProvider {
    fn supported() -> Bool;
    fn submit(context: CommandContext, command: ops::KnowledgeCommand) -> ops::KnowledgeResult;
    fn lookup(context: CommandContext, request_id: String) -> ops::KnowledgeResult;
}
locus NoKnowledgeCommands {
    params { }
    fn supported() -> Bool { return false; }
    fn submit(context: CommandContext, command: ops::KnowledgeCommand) -> ops::KnowledgeResult { return ops::KnowledgeResult { code: "commands_unsupported" }; }
    fn lookup(context: CommandContext, request_id: String) -> ops::KnowledgeResult { return ops::KnowledgeResult { code: "commands_unsupported" }; }
}

// The payloads. `record_head` is the head the change was prepared at;
// an edge's `target_id` is the endpoint it is made from (its from_id or
// to_id).
type KnowledgeLink { request_id: String = ""; record_head: String = ""; target_id: String = ""; from_id: String = ""; to_id: String = ""; rel: String = ""; rationale: String = ""; }
type KnowledgeUnlink { request_id: String = ""; record_head: String = ""; target_id: String = ""; edge_id: String = ""; from_id: String = ""; to_id: String = ""; rel: String = ""; rationale: String = ""; }
type KnowledgeNodeProposal { request_id: String = ""; record_head: String = ""; kind: String = ""; name: String = ""; text: String = ""; author: String = ""; target: String = ""; rationale: String = ""; }
type KnowledgeNodeRevision { request_id: String = ""; record_head: String = ""; supersedes: String = ""; kind: String = ""; name: String = ""; text: String = ""; author: String = ""; target: String = ""; rationale: String = ""; }
type KnowledgeNodeRetirement { request_id: String = ""; record_head: String = ""; id: String = ""; rationale: String = ""; }
type KnowledgeBind { request_id: String = ""; record_head: String = ""; idea_id: String = ""; author: String = ""; target: String = ""; rationale: String = ""; }
type KnowledgeUnbind { request_id: String = ""; record_head: String = ""; binding_id: String = ""; idea_id: String = ""; author: String = ""; target: String = ""; rationale: String = ""; }
type KnowledgeRecovery { request_id: String = ""; }
// Every Knowledge command's answer: the provider's result and the
// receipt as the record holds it — `node`, `binding` or (a reviewed
// edge, `reviewed`) `relationship` filled for its operation, the rest
// at their defaults.
type KnowledgeReply {
    ok: Bool = false;
    code: String = "";
    application_id: String = "";
    head: String = "";
    revision: Int = 0;
    receipt: ops::KnowledgeReceipt = ops::KnowledgeReceipt { };
}

topic KnowledgeEdgeLink { payload: KnowledgeLink; subject: "dna.commands.knowledge.edge.link"; }
topic KnowledgeEdgeUnlink { payload: KnowledgeUnlink; subject: "dna.commands.knowledge.edge.unlink"; }
topic KnowledgeNodePropose { payload: KnowledgeNodeProposal; subject: "dna.commands.knowledge.node.propose"; }
topic KnowledgeNodeRevise { payload: KnowledgeNodeRevision; subject: "dna.commands.knowledge.node.revise"; }
topic KnowledgeNodeRetire { payload: KnowledgeNodeRetirement; subject: "dna.commands.knowledge.node.retire"; }
topic KnowledgeBindingBind { payload: KnowledgeBind; subject: "dna.commands.knowledge.binding.bind"; }
topic KnowledgeBindingUnbind { payload: KnowledgeUnbind; subject: "dna.commands.knowledge.binding.unbind"; }
topic KnowledgeLookup { payload: KnowledgeRecovery; subject: "dna.commands.knowledge.lookup"; }

// The Knowledge handlers, beside `CommandAdmission` and on the same
// pool: each builds the operations' command, checks it against their
// codec, and hands it to the provider under the caller the binding
// established.
locus KnowledgeAdmission {
    params {
        root: String = ".";
        roles: dna::RecordRoles = dna::RecordRoles { };
        provider: KnowledgeCommandProvider = NoKnowledgeCommands { };
        reader: SourceReader = SourceReader { };
        wire: CommandWire = CommandWire { };
        codec: ops::KnowledgeCommandCodec = ops::KnowledgeCommandCodec { };
    }
    birth() { self.reader.root = self.root; }
    // The caller as the record knows them, exactly as CommandAdmission
    // names them: the mapped person, else `uid:<n>`.
    fn context(ctx: std::api::Context) -> CommandContext {
        let source = self.reader.read();
        let person = self.roles.person(ctx.caller);
        return CommandContext { root: self.root, source: source, principal_mode: "local", principal_name: if len(person) > 0 { person } else { ctx.caller.name } };
    }
    fn refused(code: String) -> KnowledgeReply { return KnowledgeReply { code: code }; }
    fn reply(result: ops::KnowledgeResult) -> KnowledgeReply {
        return KnowledgeReply { ok: result.ok, code: result.code, application_id: result.application_id, head: result.head, revision: result.revision, receipt: result.receipt };
    }
    fn submit(ctx: std::api::Context, command: ops::KnowledgeCommand) -> KnowledgeReply {
        let context = self.context(ctx);
        if !context.source.ok { return self.refused(context.source.code); }
        let mut c = command;
        c.application_id = context.source.identity;
        let native = ops::GovernanceContext { application_id: context.source.identity, principal_mode: context.principal_mode, principal_name: context.principal_name };
        if !self.codec.valid(native, c) { return self.refused("invalid_command"); }
        if !self.provider.supported() { return self.refused("commands_unsupported"); }
        return self.reply(self.provider.submit(context, c));
    }
    fn link(l: KnowledgeLink, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: l.request_id, operation: "dna.knowledge.edge.link", target_id: l.target_id, record_head: l.record_head, from_id: l.from_id, to_id: l.to_id, rel: l.rel, rationale: l.rationale });
    }
    fn unlink(u: KnowledgeUnlink, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: u.request_id, operation: "dna.knowledge.edge.unlink", target_id: u.target_id, record_head: u.record_head, edge_id: u.edge_id, from_id: u.from_id, to_id: u.to_id, rel: u.rel, rationale: u.rationale });
    }
    // A proposal targets the collection it names; a revision the node it
    // supersedes; a retirement the node it retires.
    fn propose_node(p: KnowledgeNodeProposal, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: p.request_id, operation: "dna.knowledge.node.propose", target_id: p.target, record_head: p.record_head, node_kind: p.kind, name: p.name, text: p.text, author: p.author, target: p.target, rationale: p.rationale });
    }
    fn revise_node(r: KnowledgeNodeRevision, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: r.request_id, operation: "dna.knowledge.node.revise", target_id: r.supersedes, record_head: r.record_head, supersedes: r.supersedes, node_kind: r.kind, name: r.name, text: r.text, author: r.author, target: r.target, rationale: r.rationale });
    }
    fn retire_node(r: KnowledgeNodeRetirement, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: r.request_id, operation: "dna.knowledge.node.retire", target_id: r.id, record_head: r.record_head, rationale: r.rationale });
    }
    fn bind(b: KnowledgeBind, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: b.request_id, operation: "dna.knowledge.binding.bind", target_id: b.idea_id, record_head: b.record_head, idea_id: b.idea_id, author: b.author, target: b.target, rationale: b.rationale });
    }
    fn unbind(u: KnowledgeUnbind, ctx: std::api::Context) -> KnowledgeReply {
        return self.submit(ctx, ops::KnowledgeCommand { request_id: u.request_id, operation: "dna.knowledge.binding.unbind", target_id: u.idea_id, record_head: u.record_head, binding_id: u.binding_id, idea_id: u.idea_id, author: u.author, target: u.target, rationale: u.rationale });
    }
    // Recovery by the request id the caller minted, under the policy's
    // own recovery grant.
    fn lookup(l: KnowledgeRecovery, ctx: std::api::Context) -> KnowledgeReply {
        if !self.wire.bounded(l.request_id, 128, true, false) { return self.refused("invalid_query"); }
        let context = self.context(ctx);
        if !context.source.ok { return self.refused(context.source.code); }
        if !self.provider.supported() { return self.refused("commands_unsupported"); }
        return self.reply(self.provider.lookup(context, l.request_id));
    }
}
