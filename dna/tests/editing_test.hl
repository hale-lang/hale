// dna/tests/editing_test.hl — GH #529 D2: the source-editing Attempt.
//
// A worktree under /tmp holding one program; a SourceEditor whose
// "models" are scripted (the quick tier returns the rewritten file,
// the deep tier the fitness assessment); a tool grant confined to
// that directory. One Attempt rewrites the file, formats and checks
// it with the real toolchain, and hands back a MutationProposal. The
// grant refuses paths outside the worktree, and a proposal that does
// not check is a failed Attempt with the diagnostics as its evidence.
//
// The toolchain is HALE_BIN when set (the Rust suite passes its own
// build), else `hale` on PATH.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

main locus App {
    params {
        root: String = "";
        editor: dna::SourceEditor = dna::SourceEditor { };
        breaker: dna::SourceEditor = dna::SourceEditor { };
        multi: dna::SourceEditor = dna::SourceEditor { };
        retrier: dna::SourceEditor = dna::SourceEditor { };
        bounded: dna::SourceEditor = dna::SourceEditor { };
    }
    run() {
        let root = "/tmp/dna-edit-" + to_string(std::process::pid());
        std::io::fs::mkdir(root) or discard;
        std::io::fs::write_file(root + "/main.hl", "fn main() { println(\"v1\"); }\n") or discard;
        self.editor = dna::SourceEditor {
            name: "editor",
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answer: "fn main() {\n    println(\"v2\");\n}\n" },
                deep: dna::FakeModel { name: "deep", answer: "startup_prints +" }
            },
            tools: dna::WorktreeTools { root: root, hale_bin: toolchain() }
        };

        // ---- one Attempt: edit, fmt, check, propose ---------------------
        let r = self.editor.perform(dna::WorkRequest {
            work_id: "w1", task_id: "t1", objective: "print v2 instead of v1", target: "main.hl", data_class: "internal"
        });
        std::test::assert_eq_str(r.disposition, "done", "attempt done: " + r.narrative);
        std::test::assert_eq_str(r.performer, "editor", "performer");
        std::test::assert(std::str::contains(r.evidence, "fmt=0 check=0"), "toolchain evidence: " + r.evidence);
        std::test::assert(std::str::contains(r.evidence, "backends=quick,deep"), "two tiers under one attempt: " + r.evidence);
        std::test::assert_eq_str(std::json::find_string_field(r.result, "files_changed"), "main.hl", "files changed");
        std::test::assert_eq_str(std::json::find_string_field(r.result, "fitness_signals"), "startup_prints +", "fitness signals");
        std::test::assert(std::str::contains(r.result, "\"check_clean\": true") || std::str::contains(r.result, "\"check_clean\":true"), "check clean in the proposal: " + r.result);
        let after = std::io::fs::read_file(root + "/main.hl") or "";
        std::test::assert(std::str::contains(after, "v2"), "the worktree holds the edit");
        std::test::assert_eq_int(self.editor.tools.reads, 1, "one read");
        // a hosted model's habit: the file inside a fence, with a remark
        // on each side — the fence is not the file (GH #566 F7)
        let fenced = dna::SourceEditor {
            name: "fenced",
            tools: dna::WorktreeTools { root: root, hale_bin: toolchain() },
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answer: "Here is the rewritten file:\n\n```hale\nfn main() {\n    println(\"v3\");\n}\n```\n\nI kept the structure.\n" },
                deep: dna::FakeModel { name: "deep", answer: "Looking at the change, I would expect:\n\nstartup_prints +\nlatency_p99 -\n\nNothing else moves." }
            }
        };
        let r3 = fenced.perform(dna::WorkRequest { work_id: "w3", task_id: "t1", objective: "print v3", target: "main.hl", requires: "edit", attempt_no: 0 });
        std::test::assert_eq_str(r3.disposition, "done", "a fenced answer is the file inside the fence: " + r3.narrative);
        let after3 = std::io::fs::read_file(root + "/main.hl") or "";
        std::test::assert(std::str::contains(after3, "v3") && !std::str::contains(after3, "```") && !std::str::contains(after3, "Here is"), "the worktree holds the file, not the fence or the remarks: " + after3);
        std::test::assert_eq_str(std::json::find_string_field(r3.result, "fitness_signals"), "startup_prints +\nlatency_p99 -", "only the well-formed signal lines count: " + r3.result);
        std::test::assert_eq_int(self.editor.tools.edits, 1, "one edit");
        std::test::assert_eq_int(self.editor.models.calls, 2, "edit + assess");

        // ---- the grant is confined -----------------------------------------
        let out = self.editor.perform(dna::WorkRequest { work_id: "w2", objective: "x", target: "../etc/passwd" });
        std::test::assert_eq_str(out.disposition, "failed", "outside path refused");
        std::test::assert(std::str::contains(out.narrative, "outside the worktree"), "refusal names the reason: " + out.narrative);
        let abs = self.editor.perform(dna::WorkRequest { work_id: "w3", objective: "x", target: "/tmp/x.hl" });
        std::test::assert_eq_str(abs.disposition, "failed", "absolute path refused");
        std::test::assert_eq_int(self.editor.tools.refused, 2, "two refusals");
        std::test::assert_eq_int(self.editor.tools.edits, 1, "no edit outside");

        // ---- a proposal that does not check is a failed Attempt ------------
        self.breaker = dna::SourceEditor {
            name: "breaker",
            models: dna::ModelRouter { quick: dna::FakeModel { name: "quick", answer: "fn main() { let x: Int = \"no\"; }\n" } },
            tools: dna::WorktreeTools { root: root, hale_bin: toolchain() }
        };
        let bad = self.breaker.perform(dna::WorkRequest { work_id: "w4", objective: "break it", target: "main.hl" });
        std::test::assert_eq_str(bad.disposition, "failed", "unchecked proposal fails");
        std::test::assert(std::str::contains(bad.evidence, "fmt=0 check=1"), "check failed in evidence: " + bad.evidence);
        std::test::assert(std::str::contains(bad.narrative, "type error"), "diagnostics travel with the attempt: " + bad.narrative);
        std::test::assert_eq_int(self.editor.attempts, 3, "three attempts on the first editor");

        // ---- several files from one ask (GH #566 F3) -----------------------
        let root2 = "/tmp/dna-edit2-" + to_string(std::process::pid());
        std::io::fs::mkdir(root2) or discard;
        std::io::fs::mkdir(root2 + "/answers") or discard;
        std::io::fs::write_file(root2 + "/main.hl", "fn main() { println(add(1, 2)); }\n") or discard;
        std::io::fs::write_file(root2 + "/util.hl", "fn add(a: Int, b: Int) -> Int { return a + b; }\n") or discard;
        std::io::fs::write_file(root2 + "/answers/main.hl", "// prints a sum\nfn main() { println(add(1, 2)); }\n") or discard;
        std::io::fs::write_file(root2 + "/answers/util.hl", "// adds\nfn add(a: Int, b: Int) -> Int { return a + b; }\n") or discard;
        self.multi = dna::SourceEditor {
            name: "editor",
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answers_dir: root2 + "/answers" },
                deep: dna::FakeModel { name: "deep", answer: "readability +" }
            },
            tools: dna::WorktreeTools { root: root2, hale_bin: toolchain() }
        };
        let both = self.multi.perform(dna::WorkRequest { work_id: "w5", objective: "document main.hl and util.hl", data_class: "internal" });
        std::test::assert_eq_str(both.disposition, "done", "two files from one ask: " + both.narrative);
        std::test::assert_eq_str(std::json::find_string_field(both.result, "files_changed"), "main.hl util.hl", "both files named");
        std::test::assert(std::str::contains(both.evidence, "tries=1"), both.evidence);
        std::test::assert(std::str::contains(std::io::fs::read_file(root2 + "/util.hl") or "", "// adds"), "util.hl edited");
        std::test::assert(std::str::contains(std::io::fs::read_file(root2 + "/main.hl") or "", "// prints a sum"), "main.hl edited");
        std::test::assert_eq_int(self.multi.tools.edits, 2, "two edits");

        // ---- a proposal that fails check twice and passes on the third try
        let root3 = "/tmp/dna-edit3-" + to_string(std::process::pid());
        std::io::fs::mkdir(root3) or discard;
        std::io::fs::mkdir(root3 + "/answers") or discard;
        std::io::fs::write_file(root3 + "/main.hl", "fn main() { println(\"v1\"); }\n") or discard;
        std::io::fs::write_file(root3 + "/answers/main.hl@a0", "fn main() { let x: Int = \"no\"; }\n") or discard;
        std::io::fs::write_file(root3 + "/answers/main.hl@a1", "fn main() { let y: Bool = 1; }\n") or discard;
        std::io::fs::write_file(root3 + "/answers/main.hl@a2", "fn main() { println(\"v2\"); }\n") or discard;
        self.retrier = dna::SourceEditor {
            name: "editor",
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answers_dir: root3 + "/answers" },
                deep: dna::FakeModel { name: "deep", answer: "startup_prints +" }
            },
            tools: dna::WorktreeTools { root: root3, hale_bin: toolchain() }
        };
        let third = self.retrier.perform(dna::WorkRequest { work_id: "w6", objective: "print v2 instead of v1", target: "main.hl", data_class: "internal" });
        std::test::assert_eq_str(third.disposition, "done", "passes on the third try: " + third.narrative);
        std::test::assert(std::str::contains(third.evidence, "tries=3"), third.evidence);
        std::test::assert(std::str::contains(third.narrative, "after 3 try(ies)"), third.narrative);
        std::test::assert_eq_int(self.retrier.models.calls, 4, "three edits and one assessment");
        std::test::assert(std::str::contains(std::io::fs::read_file(root3 + "/main.hl") or "", "v2"), "the third answer stands");
        // the fourth would be one too many: the bound holds
        self.bounded = dna::SourceEditor {
            name: "editor", max_tries: 2,
            models: dna::ModelRouter { quick: dna::FakeModel { name: "quick", answers_dir: root3 + "/answers" }, deep: dna::FakeModel { name: "deep", answer: "x" } },
            tools: dna::WorktreeTools { root: root3, hale_bin: toolchain() }
        };
        std::io::fs::write_file(root3 + "/main.hl", "fn main() { println(\"v1\"); }\n") or discard;
        let gave_up = self.bounded.perform(dna::WorkRequest { work_id: "w7", objective: "print v2", target: "main.hl", data_class: "internal" });
        std::test::assert_eq_str(gave_up.disposition, "failed", "two tries were not enough, and it says so");
        std::test::assert(std::str::contains(gave_up.evidence, "tries=2"), gave_up.evidence);
    }
}
fn main() { App { }; }
