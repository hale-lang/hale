// The conformance fixture for the api description (GH #1107, rows in
// GH #1417): an rpc with a reply, an rpc with none, a scalar reply, a
// nested payload, and (GH #1109) a gated rpc under a declared role with a
// hierarchy, on a surface served over the Unix socket.
// `crates/hale-cli/tests/api_description.rs` holds the inventory, the
// per-exposure description, the OpenAPI and MCP forms beside it.

role auditor;
role owner includes auditor;

type Money { amount: Int; currency: String = "USD"; }
type Refund { order_id: Int; money: Money; }
type RefundResult { ok: Bool; note: String; }
type Audit { line: String; }
type Ledger { balance: Int; entries: Int; }
type Query { who: String = ""; }
type Count { by: Int; }

locus Billing {
    params { ledger: Ledger = Ledger { balance: 100, entries: 0 }; }
    fn on_refund(r: Refund) -> RefundResult {
        self.ledger.balance = self.ledger.balance - r.money.amount;
        self.ledger.entries = self.ledger.entries + 1;
        return RefundResult { ok: true, note: "refunded " + to_string(r.order_id) };
    }
    fn on_audit(a: Audit) { println(a.line); }
    // A scalar reply: the description inlines its schema.
    fn on_count(c: Count) -> Int {
        self.ledger.entries = self.ledger.entries + c.by;
        return self.ledger.entries;
    }
    fn read_ledger(q: Query) -> Ledger { return self.ledger; }
}

api Books {
    rpc Billing::on_refund;
    rpc Billing::on_audit requires: [auditor];
    rpc Billing::on_count;
    rpc Billing::read_ledger requires: [auditor];
}

main locus Shop {
    params {
        billing: Billing = Billing { };
        staff: std::api::StaticRoles = std::api::StaticRoles { known: "auditor owner" };
    }
    placement { billing: cooperative(pool = work) where async_io; }
    run() {
        let books = api::serve(Books, unix::Rpc { path: "/tmp/hale-api-description-fixture.sock", roles: self.staff }, as: "books", receivers: { Billing: self.billing }, bound: 8, on_full: refuse);
        while !self.draining { std::time::sleep(100ms); }
        books.stop();
    }
}

fn main() { Shop { }; }
