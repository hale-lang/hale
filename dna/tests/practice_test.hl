// GH #602 — a person proposes a practice for the Board. In process: the
// organization turns a `PracticeRequest` into a named practice proposal
// with the Board's Review, recording who proposed it and why, and refuses
// one with no text. Scripted model rules answer by role and prompt, once
// when asked. Through the CLI, with no organization bound here, the
// proposal is a `practice.requested` row the host will relay, and the list
// says it is not yet heard.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, model discovery off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool(
        "sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir
            + "\n" + argv,
    );
}

fn dna_cli(app: String, args: String) -> String {
    let r = in_dir(app, toolchain() + "\ndna\n" + args);
    return r.stdout + r.stderr;
}

main locus App {
    params {
        // receipts outside the working directory: a proposal files its document
        one: dna::Dna = dna::Dna {
            planned: true,
            org_id: "prac",
            verification: dna::HaleVerification {
                receipts: dna::FileReceipts { dir: dna::scratch_root("practice-receipts") },
            },
        };
        script: dna::FakeModel = dna::FakeModel {
            name: "script",
            rules: "plan|bill B-1|kind: person\\nassignee: mara\nonce:optimize||proposal: change the intake\noptimize||proposal: none"
        };
    }
    bus { publish dna::PracticeRequested; }
    fn last(kind: String, entity: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && (len(entity) == 0 || e.entity == entity) { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    run() {

        // ---- the organization proposes it, for the Board
        dna::PracticeRequested <- dna::PracticeRequest {
            request_id: "p1",
            name: "acceptance/expense-receipt",
            text: "An expense closes with its receipt.\nevidence: required",
            by: "alice",
            because: "three bills arrived without receipts",
        };
        std::time::sleep(300ms);
        let proposed = self.last("practice.proposed", "p1");
        let digest = std::json::find_string_field(proposed, "digest");
        std::test::assert(
            std::str::starts_with(digest, "sha256:")
                && std::json::find_string_field(proposed, "by") == "alice"
                && std::json::find_string_field(
                    proposed,
                    "because",
                ) == "three bills arrived without receipts"
                && std::json::find_string_field(
                    proposed,
                    "review_id",
                ) == dna::knowledge_review_id(digest),
            "proposed, with who and why: " + proposed,
        );
        let knowledge = self.last("knowledge.proposed", digest);
        std::test::assert(
            std::str::contains(knowledge, "\"name\": \"acceptance/expense-receipt\"")
                && std::str::contains(knowledge, "\"kind\": \"practice\"")
                && std::str::contains(knowledge, "\"target\": \"org\""),
            "a named practice for the organization: " + knowledge,
        );
        let review = self.last("review.requested", "review:" + dna::knowledge_review_id(digest));
        std::test::assert(
            std::str::contains(review, "\"required_authority\": \"board\""),
            "the Board's Review: " + review,
        );
        std::test::assert_eq_str(
            self.one.knowledge_record.practice_in_force("acceptance/expense-receipt"),
            "",
            "not in force until the Board ratifies it",
        );

        dna::PracticeRequested <- dna::PracticeRequest {
            request_id: "p2",
            name: "acceptance/empty",
            text: "",
            by: "alice",
        };
        std::time::sleep(300ms);
        std::test::assert_eq_str(
            self.last("practice.refused", "p2"),
            "a practice has a name and a text",
            "no text, no proposal",
        );

        // ---- scripted answers by role and prompt, once when asked
        let plan = self.script.complete(
            dna::ModelRequest { role: "plan", prompt: "Ask: capture bill B-1 from Northwind" },
        );
        std::test::assert_eq_str(
            plan.output,
            "kind: person\nassignee: mara",
            "a plan rule, with its newline",
        );
        let other = self.script.complete(
            dna::ModelRequest { role: "plan", prompt: "Ask: something else" },
        );
        std::test::assert(
            std::str::starts_with(other.output, "script:plan:"),
            "no rule matches: the fake's own answer: " + other.output,
        );
        std::test::assert_eq_str(
            self.script.complete(dna::ModelRequest { role: "optimize", prompt: "SIGNALS" }).output,
            "proposal: change the intake",
            "the once-rule answers once",
        );
        std::test::assert_eq_str(
            self.script.complete(dna::ModelRequest { role: "optimize", prompt: "SIGNALS" }).output,
            "proposal: none",
            "and then the next rule does",
        );

        // ---- through the CLI, with no organization here: a row for the host to relay
        let scratch = dna::scratch_root("practice");
        let made = in_dir(scratch, dna::in_habitat(toolchain() + "\nhabitat\ngraft\nbooks"));
        std::test::assert_eq_int(made.code, 0, "hale habitat graft: " + made.stdout + made.stderr);
        let app = scratch + "/books";
        let g0 = in_dir(scratch, "git\ninit\n-q\n--bare\n-b\nmain\n" + scratch + "/books.git");
        let g1 = in_dir(app, "git\nconfig\nuser.name\nalice");
        let g2 = in_dir(app, "git\nconfig\nuser.email\nalice@local");
        let g3 = in_dir(app, "git\nremote\nadd\norigin\n" + scratch + "/books.git");
        std::test::assert(
            std::str::contains(
                dna_cli(app, "practice\npropose\nacceptance/x"),
                "practice: `hale dna practice propose <name> --text",
            ),
            "a proposal needs its text",
        );
        std::test::assert(
            std::str::contains(
                dna_cli(app, "practice\nretire\nx"),
                "practice: `hale dna practice propose",
            ),
            "an unknown subcommand",
        );
        let requested = dna_cli(
            app,
            "practice\npropose\nacceptance/expense-receipt\n--text\nAn expense closes with its receipt.\n--because\nbills without receipts\n--as\nalice",
        );
        std::test::assert(
            std::str::contains(
                requested,
                "practice acceptance/expense-receipt requested in the record by alice (p",
            ),
            "requested: " + requested,
        );
        let journal = in_dir(app, toolchain() + "\ndna\nrecord-rows").stdout;
        std::test::assert(
            std::str::contains(journal, "\"kind\": \"practice.requested\"")
                && std::str::contains(journal, "\\\"because\\\": \\\"bills without receipts\\\""),
            "the row, with why",
        );
        // a practice's text arrives byte for byte: newlines, a backslash,
        // UTF-8 and words that look like flags
        let multi = "Receipts must be collected.\nevidence: required\nexceptions by: dana, lee — a \\ backslash, é, and --as nobody";
        std::io::fs::write_file(scratch + "/practice.txt", multi) or discard;
        let sent = in_dir(
            app,
            "sh\n-c\nexec \"$1\" dna practice propose acceptance/multiline --text \"$(cat \"$2\")\" --as alice\nsh\n"
                + toolchain() + "\n" + scratch + "/practice.txt",
        );
        std::test::assert(
            std::str::contains(
                sent.stdout,
                "practice acceptance/multiline requested in the record by alice",
            ),
            "sent: " + sent.stdout + sent.stderr,
        );
        let mut stored = "";
        let mut lines = in_dir(app, toolchain() + "\ndna\nrecord-rows").stdout + "\n";
        while len(lines) > 0 {
            let nl = std::str::index_of(lines, "\n");
            let line = lines[0..nl];
            lines = lines[(nl + 1)..len(lines)];
            let body = std::json::find_string_field(line, "body");
            if std::json::find_string_field(line, "kind") == "practice.requested"
                && std::json::find_string_field(body, "name") == "acceptance/multiline"
            {
                stored = std::json::find_string_field(body, "text");
            }
        }
        std::test::assert_eq_str(stored, multi, "the text, whole");
        let listed = dna_cli(app, "practice");
        std::test::assert(
            std::str::contains(
                listed,
                "acceptance/expense-receipt [requested by alice, not yet heard by the organization]",
            ),
            "listed as not yet heard: " + listed,
        );
        std::test::assert(
            std::str::contains(listed, "design/principles ")
                && std::str::contains(listed, "[awaiting the Board (k:"),
            "the seeded design practices, awaiting the Board: " + listed,
        );
        // `--supersedes` takes the digest as the list abbreviates it, and is
        // resolved when the proposal is made: a version not in force, an
        // unknown prefix and an ambiguous one are refused here, never
        // accepted and then refused at ratification
        let at = std::str::index_of(listed, "design/principles sha256:");
        let short = if at < 0 { "" } else { listed[(at + 18)..(at + 30)] };
        std::test::assert(
            std::str::starts_with(short, "sha256:"),
            "the list abbreviates the digest: " + listed,
        );
        let pending = dna_cli(
            app,
            "practice\npropose\ndesign/principles\n--text\nPrinciples, again.\n--supersedes\n"
                + short + "\n--as\nalice",
        );
        std::test::assert(
            std::str::contains(pending, "is the practice `design/principles` (sha256:")
                && std::str::contains(pending, "which is not in force (pending)"),
            "a version awaiting the Board is not superseded: " + pending,
        );
        let unknown = dna_cli(
            app,
            "practice\npropose\ndesign/principles\n--text\nPrinciples, again.\n--supersedes\nsha256:zz\n--as\nalice",
        );
        std::test::assert(
            std::str::contains(unknown, "names no practice the record holds"),
            "an unknown digest is refused: " + unknown,
        );
        let rows = in_dir(app, toolchain() + "\ndna\nrecord-rows").stdout;
        std::test::assert(
            !std::str::contains(rows, "Principles, again."),
            "and nothing was requested: " + rows,
        );
        let cands = "3122dabc in-force acceptance/a\n3122ffff pending acceptance/b\n9a00 in-force acceptance/c\n";
        std::test::assert_eq_str(
            dna::superseded_digest(cands, "sha256:9a").digest,
            "sha256:9a00",
            "a unique prefix resolves to the full digest",
        );
        std::test::assert_eq_str(
            dna::superseded_digest(cands, "3122da").digest,
            "sha256:3122dabc",
            "with or without its `sha256:`",
        );
        std::test::assert(
            std::str::contains(
                dna::superseded_digest(cands, "sha256:3122").why,
                "is ambiguous: it begins 2 practices' digests",
            ),
            "an ambiguous prefix is refused",
        );
        std::test::assert(
            std::str::contains(dna::superseded_digest(cands, "sha256:").why, "names no digest"),
            "an empty one too",
        );
        // a replay resolves whatever the predecessor's state now, the short
        // spelling to the same digest as the full one
        std::test::assert(
            dna::superseded_digest_for(cands, "sha256:3122ff", false).digest == "sha256:3122ffff"
                && dna::superseded_digest_for(cands, "3122ffff", false).digest == "sha256:3122ffff",
            "a replay of a request against a version no longer in force resolves it",
        );

        dna::scratch_done(scratch);
        dna::scratch_done("/tmp/dna-practice-receipts-" + to_string(std::process::pid()));
    }
}

fn main() { App { }; }
