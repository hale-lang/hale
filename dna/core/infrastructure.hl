// dna/core/infrastructure.hl — what a body runs on, and how a head
// reaches it (GH #647; the boundary declared with #646 stage 0, #649).
//
// Every external dependency of the DNA sits behind an interface in the
// core with a vocabulary of its own, one implementation over the real
// thing and one in memory; only the implementation spells the tool.
// `Infrastructure` and `Transport` are declared here and implemented in
// memory; the host implements them over docker compose, systemd and ssh
// (dna/host/infra.hl). `Provider`, below, is the level above them: which
// host an allocation of the habitat runs on, and what places, applies and
// observes it there.

// Where a body's knowledge database is, once it is up.
type Database {
    present: Bool = false;
    dsn: String = "";
    why: String = "";
}

// What a supervisor reports about a unit.
type UnitStatus {
    known: Bool = false;
    active: Bool = false;
    detail: String = "";
}

// A named credential as a body holds it: the name and whether it is
// present; never the value.
type Credential {
    name: String = "";
    present: Bool = false;
}

// What a body runs on: its database (compose today), its supervisor
// (systemd today), its credentials (the env file today). The three
// compose independently: choosing a database never chooses a
// deployment platform.
interface Infrastructure {
    fn kind() -> String;
    // The knowledge database, brought up when it is not: a DSN.
    fn knowledge_database(project: String) -> Database;
    // The supervisor: a unit installed from its text, started, stopped,
    // asked, read.
    fn install_unit(name: String, unit: String) -> Bool;
    fn start(name: String) -> Bool;
    fn stop(name: String) -> Bool;
    fn status(name: String) -> UnitStatus;
    fn logs(name: String, lines: Int) -> String;
    // Credentials: put by name; whether one is present; never read back.
    fn put_credential(name: String, value: String) -> Bool;
    fn credential(name: String) -> Credential;
}

// What a probe of a body's machine found, one fact per line (`git=yes`).
type Facts {
    reachable: Bool = false;
    facts: String = "";
    why: String = "";
}

// How a head reaches a body: ssh today.
interface Transport {
    fn kind() -> String;
    fn probe(target: String) -> Facts;
    // A script run in the body's shell with `stdin` on its input.
    fn execute(target: String, script: String, stdin: String) -> RunResult;
}

type MemUnit { name: String = ""; unit: String = ""; active: Bool = false; }

@form(hashmap)
locus MemUnits {
    capacity { pool rows of MemUnit indexed_by name; }
}

type MemCredential { name: String = ""; value: String = ""; }

@form(hashmap)
locus MemCredentials {
    capacity { pool rows of MemCredential indexed_by name; }
}

// A body in memory: the database is whatever DSN the fixture set; units
// and credentials are rows for the life of the process.
locus MemInfrastructure {
    params {
        dsn: String = "memory";
        units: MemUnits = MemUnits { };
        credentials: MemCredentials = MemCredentials { };
        started: Int = 0;
        stopped: Int = 0;
    }
    fn kind() -> String { return "memory"; }
    fn knowledge_database(project: String) -> Database {
        return Database { present: true, dsn: self.dsn };
    }
    fn install_unit(name: String, unit: String) -> Bool {
        self.units.set(MemUnit { name: name, unit: unit });
        return true;
    }
    fn start(name: String) -> Bool {
        let u = self.units.get(name) or MemUnit { };
        if len(u.name) == 0 { return false; }
        self.units.set(MemUnit { name: name, unit: u.unit, active: true });
        self.started = self.started + 1;
        return true;
    }
    fn stop(name: String) -> Bool {
        let u = self.units.get(name) or MemUnit { };
        if len(u.name) == 0 { return false; }
        self.units.set(MemUnit { name: name, unit: u.unit, active: false });
        self.stopped = self.stopped + 1;
        return true;
    }
    fn status(name: String) -> UnitStatus {
        let u = self.units.get(name) or MemUnit { };
        return UnitStatus {
            known: len(u.name) > 0,
            active: u.active,
            detail: if u.active { "active" } else { "inactive" },
        };
    }
    fn logs(name: String, lines: Int) -> String { return ""; }
    fn put_credential(name: String, value: String) -> Bool {
        self.credentials.set(MemCredential { name: name, value: value });
        return true;
    }
    fn credential(name: String) -> Credential {
        let c = self.credentials.get(name) or MemCredential { };
        return Credential { name: name, present: len(c.name) > 0 };
    }
}

// A transport in memory: every target is reachable with the facts the
// fixture set, and a script "runs" by being kept — what the fixture
// asserts on is the script's text, never a tool on PATH.
locus MemTransport {
    params {
        facts: String = "git=yes\nsystemd=yes\ncompose=yes\ncurl=yes\nLinux x86_64\n";
        reachable: Bool = true;
        last_target: String = "";
        last_script: String = "";
        last_stdin: String = "";
        runs: Int = 0;
    }
    fn kind() -> String { return "memory"; }
    fn probe(target: String) -> Facts {
        if !self.reachable { return Facts { why: "unreachable" }; }
        return Facts { reachable: true, facts: self.facts };
    }
    fn execute(target: String, script: String, stdin: String) -> RunResult {
        self.last_target = target;
        self.last_script = script;
        self.last_stdin = stdin;
        self.runs = self.runs + 1;
        return RunResult { code: 0, stdout: "", stderr: "" };
    }
}

// ---- providers: where the habitat's allocations run (phase 4) ----------------
//
// A **host** is a machine the habitat places on: never the program
// `dna/host`, which keeps its name. Hosts are rows that providers produce,
// each declaring what it offers. An **allocation** is one role of one
// instance (an organism's record key) placed on a host by a provider:
// placement is the record's, a row naming the role, the instance, the
// provider and the host. A **policy** maps each role to the provider that
// allocates it, per habitat; a profile is a preset of policy (`local`: the
// `compose` provider for every role). A provider's verbs are what every
// provider does, whatever it spells: the host it produces and what it
// offers, an allocation by role, a placement on a host, a render applied
// on a host, and what it observes of an allocation.

// A machine a provider produces: its name, the provider, and what it
// offers, space-separated (`compose`, `systemd-user`).
type Host {
    name: String = "";
    provider: String = "";
    offers: String = "";
    reachable: Bool = false;
    why: String = "";
    // `ready`, `pending-key` (reached, the habitat's key not yet authorized
    // there) or `removed`
    state: String = "";
    // how the habitat reaches it: the name the LAN resolves, the SSH port
    // and user (an `ssh` host's), and the host key first seen there
    address: String = "";
    port: Int = 0;
    user: String = "";
    host_key: String = "";
    fingerprint: String = "";
    os: String = "";
    arch: String = "";
}

// A host as a `habitat.host` row's body states it.
fn host_row_body(h: Host) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("name", h.name);
    b.string_field("provider", h.provider);
    b.string_field("offers", h.offers);
    b.string_field("state", h.state);
    b.string_field("address", h.address);
    b.int_field("port", h.port);
    b.string_field("user", h.user);
    b.string_field("host_key", h.host_key);
    b.string_field("fingerprint", h.fingerprint);
    b.string_field("os", h.os);
    b.string_field("arch", h.arch);
    b.end_object();
    return b.result();
}

// The host a `habitat.host` row's body states.
fn host_of_row(body: String) -> Host {
    return Host {
        name: std::json::find_string_field(body, "name"),
        provider: std::json::find_string_field(body, "provider"),
        offers: std::json::find_string_field(body, "offers"),
        reachable: std::json::find_string_field(body, "state") == "ready",
        state: std::json::find_string_field(body, "state"),
        address: std::json::find_string_field(body, "address"),
        port: std::json::find_int_field(body, "port"),
        user: std::json::find_string_field(body, "user"),
        host_key: std::json::find_string_field(body, "host_key"),
        fingerprint: std::json::find_string_field(body, "fingerprint"),
        os: std::json::find_string_field(body, "os"),
        arch: std::json::find_string_field(body, "arch"),
    };
}

// The latest `habitat.host` row for `name` in the record at `root`, a Host
// with no provider when there is none.
@bounded_by(root)
fn recorded_host(root: String, name: String) -> Host {
    let j = RecordJournal { repo: root, author: "habitat" };
    let moved = j.refresh();
    let mut body = "";
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "habitat.host" && e.entity == name { body = e.body; }
        i = i + 1;
    }
    if len(body) == 0 { return Host { name: name }; }
    return host_of_row(body);
}

// One role of one instance, as a provider allocates and places it: the
// service that runs it on its host (in the compose project `project`), the
// offer its host must make (`needs`, "" for none), and the address it
// answers on when it serves one.
type Allocation {
    role: String = "";
    instance: String = "";
    provider: String = "";
    host: String = "";
    project: String = "";
    service: String = "";
    needs: String = "";
    address: String = "";
    placed: Bool = false;
    why: String = "";
}

// What a provider applies on a host. Until a fleet's render exists, a
// render is what `hale deploy render --backend compose` writes: a compose
// project, the directory its files are in, its files (newline-separated, in
// order) and the services to bring up (newline-separated, "" all of them).
type Render {
    project: String = "";
    dir: String = "";
    files: String = "";
    services: String = "";
}

type RenderApplied {
    ok: Bool = false;
    why: String = "";
}

// What a provider observes of an allocation: `up`, `degraded` (running,
// not well) or `down`, and what it saw.
type AllocationState {
    state: String = "down";
    detail: String = "";
}

interface Provider {
    fn kind() -> String;
    // The host named `host` as this provider produces it, with its offers.
    fn offers(host: String) -> Host;
    // `role` allocated for `instance`, on no host yet.
    fn allocate(role: String, instance: String) -> Allocation;
    // `a` placed on `host`: refused (`why`) when the host does not offer
    // what the allocation needs.
    fn place(a: Allocation, host: Host) -> Allocation;
    // `render` applied on the host named `host`.
    fn apply(host: String, render: Render) -> RenderApplied;
    // What `render` brought up on `host` taken down again (`release` is
    // the lifecycle hook's name).
    fn withdraw(host: String, render: Render) -> RenderApplied;
    fn observe(a: Allocation) -> AllocationState;
}

// The roles a habitat allocates, in the order its policy lists them.
const HABITAT_ROLES: String = "memory nerves senses database broker head face";

// Whether the space-separated `words` hold `word`.
fn has_word(words: String, word: String) -> Bool {
    return len(word) > 0 && std::str::contains(" " + words + " ", " " + word + " ");
}

// The provider a profile's preset gives `role` on these backends: `local`
// gives `compose` every role; on `operator` backends, the roles the
// operator's servers hold (memory, nerves and the heart's database) are
// the `operator`'s, adopted and never applied, and the `broker` is not
// allocated there (""). "" for a profile that is not built.
fn profile_provider(profile: String, backends: String, role: String) -> String {
    if profile != "local" || !has_word(HABITAT_ROLES, role) { return ""; }
    if backends == "operator" {
        if role == "broker" { return ""; }
        if role == "memory" || role == "nerves" || role == "database" { return "operator"; }
    }
    return "compose";
}

// The compose service that holds `role` for the instance `k`, the offer
// its host must make, or "" for a role the compose provider does not run
// as a service: the heart's database is a tenant of the memory server, its
// broker users the nerves server's; the head and the face are one process
// of the habitat's (`hale dna head`), not a service of the project.
fn compose_service(role: String, k: String) -> String {
    if role == "memory" || role == "nerves" || role == "senses" { return role + "-" + k; }
    if role == "database" { return "memory-" + k; }
    if role == "broker" { return "nerves-" + k; }
    return "";
}

// The render of the allocations of the organism at `root` (its compose
// file and ports, written the first time) bringing up `services`.
fn allocation_render(root: String, services: String) -> Render {
    let argv = allocation_compose(root);
    if len(argv) == 0 { return Render { }; }
    return Render {
        project: local_habitat_project(),
        dir: allocation_dir(root),
        files: "compose.yaml\nports.yaml",
        services: services,
    };
}

// The render of the allocations kept at `dir` (`allocations/<key>`), every
// service of them: what `hale habitat up` brings back for a tenant.
fn allocations_render(dir: String) -> Render {
    return Render {
        project: local_habitat_project(),
        dir: dir,
        files: "compose.yaml\nports.yaml",
    };
}

// `docker compose`'s arguments for `render`, joined by `sep`: the project,
// its directory and its files (each under the directory).
fn compose_args(render: Render, sep: String) -> String {
    let mut out = "-p" + sep + render.project + sep + "--project-directory" + sep + render.dir;
    let mut rest = render.files;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let f = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(f) > 0 { out = out + sep + "-f" + sep + render.dir + "/" + f; }
    }
    return out;
}

// The services of `render`, each after `sep` ("" when it names none).
fn compose_services(render: Render, sep: String) -> String {
    return if len(render.services) > 0 {
        sep + std::str::replace(render.services, "\n", sep)
    } else {
        ""
    };
}

// `up` for `render`: every service it names, or all of them.
fn compose_up_args(render: Render, sep: String) -> String {
    return "up" + sep + "-d" + sep + "--wait" + compose_services(render, sep);
}

// What `render` brought up taken down: the services it names, removed
// (the project's other services stay), or, when it names none, the
// project's own (`down`).
fn compose_down_args(render: Render, sep: String) -> String {
    if len(render.services) > 0 {
        return "rm" + sep + "-s" + sep + "-f" + compose_services(render, sep);
    }
    return "down";
}

// The `compose` provider: this machine (the host `local`), docker compose
// for the services of the habitat's project, and the habitat's own
// processes (its head and face) beside them. Local only.
locus ComposeProvider {
    params {
        project: String = "";
        host_name: String = "local";
    }
    fn kind() -> String { return "compose"; }
    fn offers(host: String) -> Host {
        if host != self.host_name {
            return Host {
                name: host,
                provider: "compose",
                why: "the compose provider places on this machine alone (`" + self.host_name
                    + "`)",
            };
        }
        let mut offers = "";
        if run_tool("docker\ncompose\nversion").code == 0 { offers = "compose"; }
        if run_tool("systemctl\n--user\nshow-environment").code == 0 {
            offers = offers + (if len(offers) > 0 { " " } else { "" }) + "systemd-user";
        }
        return Host {
            name: host,
            provider: "compose",
            offers: offers,
            reachable: true,
            state: "ready",
            os: trim_nl(run_tool("uname\n-s").stdout),
            arch: trim_nl(run_tool("uname\n-m").stdout),
        };
    }
    fn allocate(role: String, instance: String) -> Allocation {
        if !has_word(HABITAT_ROLES, role) {
            return Allocation {
                role: role,
                instance: instance,
                provider: "compose",
                why: "the compose provider allocates no `" + role + "`",
            };
        }
        let service = compose_service(role, instance);
        return Allocation {
            role: role,
            instance: instance,
            provider: "compose",
            project: if len(self.project) > 0 { self.project } else { local_habitat_project() },
            service: if len(service) > 0 { service } else { "dna head" },
            needs: if len(service) > 0 { "compose" } else { "" },
        };
    }
    fn place(a: Allocation, host: Host) -> Allocation {
        let mut p = a;
        if !host.reachable {
            p.why = "host `" + host.name + "` is not reachable: " + host.why;
            return p;
        }
        if host.provider != "compose" {
            p.why = "host `" + host.name + "` is the " + host.provider + " provider's";
            return p;
        }
        if len(a.needs) > 0 && !has_word(host.offers, a.needs) {
            p.why = "host `" + host.name + "` does not offer " + a.needs + " (it offers: "
                + (if len(host.offers) > 0 { host.offers } else { "nothing" }) + ")";
            return p;
        }
        p.host = host.name;
        p.placed = true;
        return p;
    }
    fn apply(host: String, render: Render) -> RenderApplied {
        if host != self.host_name {
            return RenderApplied {
                why: "the compose provider applies on this machine alone (`" + self.host_name
                    + "`)",
            };
        }
        if len(render.project) == 0 || len(render.dir) == 0 {
            return RenderApplied { why: "nothing to apply: the render names no project" };
        }
        let up = run_tool(
            "env\nCOMPOSE_IGNORE_ORPHANS=1\ndocker\ncompose\n" + compose_args(render, "\n") + "\n"
                + compose_up_args(render, "\n"),
        );
        if up.code != 0 {
            return RenderApplied { why: "docker compose up failed: " + trim_nl(up.stderr) };
        }
        return RenderApplied { ok: true };
    }
    fn withdraw(host: String, render: Render) -> RenderApplied {
        if host != self.host_name {
            return RenderApplied {
                why: "the compose provider withdraws on this machine alone (`" + self.host_name
                    + "`)",
            };
        }
        if len(render.project) == 0 || len(render.dir) == 0 {
            return RenderApplied { why: "nothing to withdraw: the render names no project" };
        }
        let down = run_tool(
            "env\nCOMPOSE_IGNORE_ORPHANS=1\ndocker\ncompose\n" + compose_args(render, "\n") + "\n"
                + compose_down_args(render, "\n"),
        );
        if down.code != 0 {
            return RenderApplied { why: "docker compose down failed: " + trim_nl(down.stderr) };
        }
        return RenderApplied { ok: true };
    }
    fn observe(a: Allocation) -> AllocationState {
        if a.provider != "compose" {
            return AllocationState { detail: "the " + a.provider + " provider's, not compose's" };
        }
        // the service that holds the role (the heart's database is the
        // memory server's), never a name the row spelled otherwise
        let service = compose_service(a.role, a.instance);
        if len(service) == 0 { return observe_address(a.address); }
        let ps = run_tool(
            "docker\nps\n-a\n--filter\nlabel=com.docker.compose.project="
                + (if len(a.project) > 0 { a.project } else { local_habitat_project() })
                + "\n--filter\nlabel=com.docker.compose.service=" + service
                + "\n--format\n{{.State}} {{.Status}}",
        );
        if ps.code != 0 { return AllocationState { detail: "docker: " + trim_nl(ps.stderr) }; }
        return container_state(service, trim_nl(ps.stdout));
    }
}

// What `docker ps`'s `{{.State}} {{.Status}}` line says of `service`:
// running is up, running unhealthy or restarting is degraded, anything else
// (or no container) is down.
fn container_state(service: String, seen: String) -> AllocationState {
    if len(seen) == 0 { return AllocationState { detail: service + " is not created" }; }
    if std::str::starts_with(seen, "running") {
        if std::str::contains(seen, "(unhealthy)") {
            return AllocationState { state: "degraded", detail: seen };
        }
        return AllocationState { state: "up", detail: seen };
    }
    if std::str::starts_with(seen, "restarting") {
        return AllocationState { state: "degraded", detail: seen };
    }
    return AllocationState { detail: seen };
}

// An allocation served at a loopback `address` (`http://127.0.0.1:<port>`):
// up while something accepts connections there.
fn observe_address(address: String) -> AllocationState {
    let at = std::str::index_of(address, "127.0.0.1:");
    if at < 0 { return AllocationState { detail: "no address assigned yet" }; }
    let rest = address[(at + 10)..len(address)];
    let slash = std::str::index_of(rest, "/");
    let port = std::str::parse_int(if slash < 0 { rest } else { rest[0..slash] }) or 0;
    if port < 1 || port > 65535 { return AllocationState { detail: "no port in " + address }; }
    let fd = std::io::tcp::connect("127.0.0.1", port) or - 1;
    if fd < 0 { return AllocationState { detail: "nothing answers at " + address }; }
    std::io::tcp::close_fd(fd);
    return AllocationState { state: "up", detail: "answers at " + address };
}

// A provider in memory: one host whose offers the fixture sets; an
// allocation is placed when the host offers what it needs, a render is
// kept rather than applied, and an allocation observes as the fixture says
// (`down` and `degraded` list `<instance>/<role>` keys, space-separated;
// every other applied allocation is up).
locus MemProvider {
    params {
        host_name: String = "local";
        host_offers: String = "compose systemd-user";
        reachable: Bool = true;
        refuse_apply: String = "";
        down: String = "";
        degraded: String = "";
        applied: Int = 0;
        withdrawn: Int = 0;
        last_host: String = "";
        last: Render = Render { };
    }
    fn kind() -> String { return "memory"; }
    fn offers(host: String) -> Host {
        if host != self.host_name || !self.reachable {
            return Host { name: host, provider: "memory", why: "no such host in memory" };
        }
        return Host { name: host, provider: "memory", offers: self.host_offers, reachable: true };
    }
    fn allocate(role: String, instance: String) -> Allocation {
        if !has_word(HABITAT_ROLES, role) {
            return Allocation {
                role: role,
                instance: instance,
                provider: "memory",
                why: "the memory provider allocates no `" + role + "`",
            };
        }
        let service = compose_service(role, instance);
        return Allocation {
            role: role,
            instance: instance,
            provider: "memory",
            project: "memory",
            service: if len(service) > 0 { service } else { role + "-" + instance },
            needs: if len(service) > 0 { "compose" } else { "" },
        };
    }
    fn place(a: Allocation, host: Host) -> Allocation {
        let mut p = a;
        if !host.reachable {
            p.why = "host `" + host.name + "` is not reachable";
            return p;
        }
        if len(a.needs) > 0 && !has_word(host.offers, a.needs) {
            p.why = "host `" + host.name + "` does not offer " + a.needs;
            return p;
        }
        p.host = host.name;
        p.placed = true;
        return p;
    }
    fn apply(host: String, render: Render) -> RenderApplied {
        if host != self.host_name { return RenderApplied { why: "no such host in memory" }; }
        if len(self.refuse_apply) > 0 { return RenderApplied { why: self.refuse_apply }; }
        self.applied = self.applied + 1;
        self.last_host = host;
        self.last = render;
        return RenderApplied { ok: true };
    }
    fn withdraw(host: String, render: Render) -> RenderApplied {
        if host != self.host_name { return RenderApplied { why: "no such host in memory" }; }
        self.withdrawn = self.withdrawn + 1;
        if self.applied > 0 { self.applied = self.applied - 1; }
        return RenderApplied { ok: true };
    }
    fn observe(a: Allocation) -> AllocationState {
        let key = a.instance + "/" + a.role;
        if !a.placed && len(a.host) == 0 { return AllocationState { detail: "not placed" }; }
        if has_word(self.down, key) { return AllocationState { detail: "down in memory" }; }
        if has_word(self.degraded, key) {
            return AllocationState { state: "degraded", detail: "degraded in memory" };
        }
        if self.applied == 0 { return AllocationState { detail: "nothing applied" }; }
        return AllocationState { state: "up", detail: "up in memory" };
    }
}
