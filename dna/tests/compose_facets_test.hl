// dna/tests/compose_facets_test.hl — a compose file's services with their
// facets, as ingest reads them (GH #1907): built or pulled, the shape
// (one build, many placements), and whether each runs the repository's
// code. Read as written: anchors merged, a build mapping's context and
// target, the `dna.runs=repository` label.
import "../operations" as ops;

const COMPOSE: String = "name: synth

x-app: &app
  build: .
  image: ghcr.io/acme/synth:dev

services:
  api:
    <<: *app
    command: [\"synth-api\"]
  worker:
    <<: *app
    command: [\"synth-worker\"]
  web:
    build:
      context: ./web
      dockerfile: Dockerfile
      target: serve
    ports:
      - \"8080:8080\"
  tool:
    image: ubuntu:24.04
    labels:
      - dna.runs=repository
    command: [\"/usr/local/bin/synth-tool\"]
  postgres:
    image: postgres:17
    volumes:
      - pg:/var/lib/postgresql/data
  prometheus:
    image: prom/prometheus:v2.55.0
    command: [\"--config.file=/etc/prometheus/prometheus.yml\"]
    volumes:
      - ./config/prometheus.yml:/etc/prometheus/prometheus.yml:ro

volumes:
  pg:
";

fn main() {
    let lines = ops::ingest_compose_services(COMPOSE, "synth");
    std::test::assert_eq_str(
        lines,
        "api\tbuilt\tsynth\ttrue\tsynth-api\n"
            + "worker\tbuilt\tsynth\ttrue\tsynth-worker\n"
            + "web\tbuilt\tweb-serve\ttrue\t\n"
            + "tool\tpulled\ttool\ttrue\tsynth-tool\n"
            + "postgres\tpulled\tpostgres\tfalse\t\n"
            + "prometheus\tpulled\tprometheus\tfalse\t\n",
        "two services of one anchored image are one shape and two programs; a build mapping is its context and target; a labelled pulled image runs the repository's code; a database and a monitor do not; the program is the command's first word, and flags alone name none",
    );
    std::test::assert_eq_str(
        ops::ingest_compose_shape("x", ".", "", "", "repo"),
        "repo",
        "a build at the root is the repository's shape",
    );
    std::test::assert_eq_str(
        ops::ingest_compose_shape("x", "./services/edge/", "", "", "repo"),
        "edge",
        "a build context's last segment",
    );
    std::test::assert_eq_str(
        ops::ingest_compose_shape("x", ".", "", "registry.local:5000/team/thing:1.2", "repo"),
        "thing",
        "an image's name, without its registry and tag",
    );
    // an anchored build mapping keeps its context and target whatever
    // order its keys come in (a `dockerfile` first dropped them once)
    std::test::assert_eq_str(
        ops::ingest_compose_services(
            "x-api: &api\n  build:\n    dockerfile: Dockerfile\n    context: ./api\n    target: api\n"
                + "x-web: &web\n  build:\n    context: ./web\n    dockerfile: Dockerfile\n    target: serve\n"
                + "services:\n  api:\n    <<: *api\n  web:\n    <<: *web\n",
            "repo",
        ),
        "api\tbuilt\tapi-api\ttrue\t\nweb\tbuilt\tweb-serve\ttrue\t\n",
        "two anchored build mappings are two shapes, their keys in any order",
    );
    // the program a command runs: a plain word, a launcher script's next
    // word, a shell's `exec`, a block list, a folded script
    std::test::assert_eq_str(
        ops::ingest_program("/app/bin/synth-api --port 80"),
        "synth-api",
        "the first word",
    );
    std::test::assert_eq_str(
        ops::ingest_program("entrypoint.sh settle --once"),
        "settle",
        "a launcher script hands on",
    );
    std::test::assert_eq_str(
        ops::ingest_program("sh -c apt-get update && exec todo-api --host 0.0.0.0"),
        "todo-api",
        "a shell's exec",
    );
    std::test::assert_eq_str(
        ops::ingest_program("bash -c npm start"),
        "npm",
        "a shell script's first word when nothing is exec'd",
    );
    std::test::assert_eq_str(ops::ingest_program(""), "", "no command");
    std::test::assert_eq_str(
        ops::ingest_compose_services(
            "services:\n  node:\n    build: .\n    command:\n      - voice-node\n      - --id\n  api:\n    build: .\n    command:\n      - sh\n      - -c\n      - >-\n        cd /app\n        && exec voice-api --port 8080\n",
            "repo",
        ),
        "node\tbuilt\trepo\ttrue\tvoice-node\napi\tbuilt\trepo\ttrue\tvoice-api\n",
        "a block-list command and a folded shell script",
    );
    std::test::assert(ops::ingest_runs_label("- \"dna.runs=repository\""), "a quoted list item");
    std::test::assert(ops::ingest_runs_label("dna.runs: repository"), "a mapping entry");
    std::test::assert(!ops::ingest_runs_label("- dna.runs=elsewhere"), "another value");
}
