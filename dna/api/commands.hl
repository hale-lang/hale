    fn apply_batch(b: BatchApplication, ctx: std::api::Context) -> CommandReply {
        return self.submit(
            ctx,
            CommandRequest {
                request_id: b.request_id,
                operation: "dna.batch.apply",
                target_kind: "dna.record",
                subject_digest: b.record_head,
                record_head: b.record_head,
                steps: b.steps,
                pack: b.pack,
            },
        );
    }
    // A batch planned, not proposed: what `apply_batch` would propose at the
    // Record's head, as data. A read — it writes nothing, and asks nothing of
    // the provider — so any authenticated caller may ask, and a head that
    // composes no provider answers it too. The plan is the one `apply_batch`
    // makes (`dna::batch_plan` over the captured Record).
    fn preview_batch(d: BatchDraft, ctx: std::api::Context) -> BatchPreview {
        if len(d.steps) == 0 || len(d.steps) > 65536 {
            return BatchPreview { code: "invalid_command" };
        }
        let capture = ops::GovernanceCommands { record: dna::MemoryRecord { repo: self.root } };
        let s = capture.capture();
        if !s.ok { return BatchPreview { code: s.code }; }
        let j = ops::GovernanceJournal { snapshot: s };
        if !j.valid { return BatchPreview { code: "command_history_invalid" }; }
        let receipts = ops::GovernanceReceipts { record: dna::MemoryRecord { repo: self.root } };
        let plan = dna::batch_plan(j, receipts, d.steps);
        let diff = dna::batch_diff(plan);
        return BatchPreview {
            ok: plan.ok,
            code: "",
            why: plan.why,
            application_id: s.application_id,
            head: s.head,
            revision: s.revision,
            steps: plan.steps,
            before: plan.before,
            after: plan.after,
            added: diff.added,
            removed: diff.removed,
            unchanged: diff.unchanged,
            pending: if plan.ok {
                dna::batch_pending(j, plan.steps)
            } else {
                ""
            } };
    }
    // The record as the standard face's index reads it (record_index.hl): a
    // read, so any authenticated caller the record knows may ask.
    fn index(a: IndexAsk, ctx: std::api::Context) -> RecordIndex {
        if self.personless(ctx) { return RecordIndex { why: "forbidden" }; }
        return record_index(self.root, a.limit);
    }
    // The habitat's hosts, allocations and policy (habitat_rows.hl): reads,
    // so any authenticated caller the record knows may ask.
    fn hosts(a: HabitatAsk, ctx: std::api::Context) -> HostRows {
        if self.personless(ctx) { return HostRows { why: "forbidden" }; }
        return habitat_hosts(self.root, a.limit);
    }
    fn allocations(a: HabitatAsk, ctx: std::api::Context) -> AllocationRows {
        if self.personless(ctx) { return AllocationRows { why: "forbidden" }; }
        return habitat_allocations(self.root, a.limit);
    }
    fn policy(a: HabitatAsk, ctx: std::api::Context) -> PolicyRows {
        if self.personless(ctx) { return PolicyRows { why: "forbidden" }; }
        return habitat_policy(self.root, a.limit);
    }
    // What the habitat's reflexes say now: its store's alerts (a read).
    fn alerts(a: HabitatAsk, ctx: std::api::Context) -> AlertRows {
        if self.personless(ctx) { return AlertRows { why: "forbidden" }; }
        return habitat_alerts(self.root);
    }
    // The web UIs across its organisms (habitat_rows.hl): each organism's
    // face and the UIs its manifest declares, with their addresses (a read).
    fn uis(a: HabitatAsk, ctx: std::api::Context) -> UiRows {
        if self.personless(ctx) { return UiRows { why: "forbidden" }; }
        return habitat_uis(self.root, a.limit);
    }
    // The habitat's placement (habitat_placement.hl): the Board's.
    fn place_allocation(a: AllocationPlace, ctx: std::api::Context) -> PlaceReply {
        if self.personless(ctx) { return PlaceReply { code: "forbidden" }; }
        return habitat_place(self.root, a);
    }
    fn apply_allocations(a: ApplyAsk, ctx: std::api::Context) -> ApplyReply {
        if self.personless(ctx) { return ApplyReply { code: "forbidden" }; }
        return habitat_apply(self.root, a);
    }
    fn graft(a: GraftAsk, ctx: std::api::Context) -> GraftReply {
        if self.personless(ctx) { return GraftReply { code: "forbidden" }; }
        return habitat_graft(self.root, a);
    }
    // The log of a graft this head started (habitat_placement.hl): read by
    // the graft's id, the Board's like the graft.
    fn graft_log(a: GraftLogAsk, ctx: std::api::Context) -> GraftLogReply {
        if self.personless(ctx) { return GraftLogReply { code: "forbidden" }; }
        return habitat_graft_log(a);
    }
    fn set_model_map(a: ModelMapSet, ctx: std::api::Context) -> ModelMapReply {
        if self.personless(ctx) { return ModelMapReply { code: "forbidden" }; }
        return habitat_set_model_map(self.root, a);
    }
    fn probe_model(a: ModelProbe, ctx: std::api::Context) -> ModelMapReply {
        if self.personless(ctx) { return ModelMapReply { code: "forbidden" }; }
        return habitat_probe_model(self.root, a);
    }
    // The habitat's nurseries and saplings (habitat_rows.hl): two reads, and
    // the Board's acts on them.
    fn nurseries(a: HabitatAsk, ctx: std::api::Context) -> NurseryRows {
        if self.personless(ctx) { return NurseryRows { why: "forbidden" }; }
        return habitat_nurseries(self.root, a.limit);
    }
    fn saplings(a: HabitatAsk, ctx: std::api::Context) -> SaplingRows {
        if self.personless(ctx) { return SaplingRows { why: "forbidden" }; }
        return habitat_saplings(self.root, a.limit);
    }
    fn add_nursery(a: NurseryAdd, ctx: std::api::Context) -> NurseryReply {
        if self.personless(ctx) { return NurseryReply { code: "forbidden" }; }
        return habitat_nursery_add(self.root, a, self.author(ctx));
    }
    // The solo path (solo_tasks.hl): a person takes a handed Task and
    // reports it done, as text, in their own name.
    fn take_task(t: TaskTake, ctx: std::api::Context) -> TaskAct {
        let who = self.roles.person(ctx.caller);
        if self.personless(ctx) || len(who) == 0 {
            return task_act_refused(
                t.task_id,
                "forbidden",
                "a Task is taken by a person of the record",
            );
        }
        return solo_take(self.root, t.task_id, who);
    }
    fn complete_task(d: TaskDone, ctx: std::api::Context) -> TaskAct {
        let who = self.roles.person(ctx.caller);
        if self.personless(ctx) || len(who) == 0 {
            return task_act_refused(
                d.task_id,
                "forbidden",
                "a Task is reported done by a person of the record",
            );
        }
        return solo_done(self.root, d.task_id, d.text, who);
    }
    fn ratify_sapling(n: SaplingNamed, ctx: std::api::Context) -> NurseryReply {
        if self.personless(ctx) { return NurseryReply { code: "forbidden" }; }
        return habitat_sapling_ratify(self.root, n.name, self.author(ctx));
    }
    // The habitat's brief (habitat_brief.hl): the Board's hat as a prompt,
    // with the live state, for the person who asks. A read.
    fn brief(a: HabitatAsk, ctx: std::api::Context) -> HabitatBrief {
        if self.personless(ctx) { return HabitatBrief { why: "forbidden" }; }
        return habitat_brief(self.root, self.roles.person(ctx.caller), a.limit);
    }
    // Who a habitat act's row is written by: the person the caller maps
    // to, else the caller as the binding named it. Every act of the
    // habitat's is a row in the name of whoever asked, over any transport.
    fn author(ctx: std::api::Context) -> String {
        let person = self.roles.person(ctx.caller);
        return if len(person) > 0 { person } else { ctx.caller.name };
    }
    // The habitat's hosts (habitat_hosts.hl): the Board's acts.
    fn add_host(a: HostAdd, ctx: std::api::Context) -> HostReply {
        if self.personless(ctx) { return HostReply { code: "forbidden" }; }
        return habitat_host_add(self.root, a, self.author(ctx));
    }
    fn probe_host(n: HostNamed, ctx: std::api::Context) -> HostReply {
        if self.personless(ctx) { return HostReply { code: "forbidden" }; }
        return habitat_host_probe(self.root, n.name, self.author(ctx));
    }
    fn plan_remove_host(n: HostNamed, ctx: std::api::Context) -> HostPlan {
        if self.personless(ctx) { return HostPlan { code: "forbidden" }; }
        return habitat_host_plan_remove(self.root, n.name);
    }
    fn remove_host(r: HostRemove, ctx: std::api::Context) -> HostRemoval {
        if self.personless(ctx) { return HostRemoval { code: "forbidden" }; }
        return habitat_host_remove(self.root, r, self.author(ctx));
    }
    // The services placed on its hosts (habitat_placed.hl): recorded by the
    // CLI once a placement ran, the Board's; and read.
    fn record_placed(p: PlacementRecord, ctx: std::api::Context) -> PlacementReply {
        if self.personless(ctx) { return PlacementReply { code: "forbidden" }; }
        return habitat_record_placed(self.root, p, self.author(ctx));
    }
    fn record_unplaced(p: PlacementRecord, ctx: std::api::Context) -> PlacementReply {
        if self.personless(ctx) { return PlacementReply { code: "forbidden" }; }
        return habitat_record_unplaced(self.root, p, self.author(ctx));
    }
    fn placements(a: HabitatAsk, ctx: std::api::Context) -> PlacementRows {
        if self.personless(ctx) { return PlacementRows { why: "forbidden" }; }
        return habitat_placements(self.root);
    }
    // The habitat's organisms (habitat_organisms.hl): removed, the Board's.
    fn plan_remove_organism(n: OrganismNamed, ctx: std::api::Context) -> OrganismPlan {
        if self.personless(ctx) { return OrganismPlan { code: "forbidden" }; }
        return habitat_organism_plan_remove(self.root, n.name);
    }
    fn remove_organism(r: OrganismRemove, ctx: std::api::Context) -> OrganismRemoval {
        if self.personless(ctx) { return OrganismRemoval { code: "forbidden" }; }
        return habitat_organism_remove(self.root, r, self.author(ctx));
    }
    fn allocate_forge(a: ForgeAllocate, ctx: std::api::Context) -> NurseryReply {
        if self.personless(ctx) { return NurseryReply { code: "forbidden" }; }
        return habitat_allocate_forge(self.root, a);
    }
    // Recovery: a command by the request id the caller minted, under the
    // provider's own recovery grant.
    fn lookup(l: Lookup, ctx: std::api::Context) -> CommandReply {
        if !self.wire.bounded(l.request_id, 128, true, false) {
            return self.refused("invalid_query");
        }
        if self.personless(ctx) { return self.refused("forbidden"); }
        let context = self.context(ctx);
        if !context.source.ok { return self.refused(context.source.code); }
        return self.reply(self.provider.lookup(context, l.request_id), context);
    }
}

// The head's command handlers, one per row of `HeadCommands`, each
// delegating to the admission above. The head and a composed head (the
// practice review head) serve the one surface over the same admissions;
// the composed head holds this locus beside its own provider, since an
// imported locus is not part of a program's surface.
locus Commands {
    params {
        admission: CommandAdmission = CommandAdmission { };
        knowledge: KnowledgeAdmission = KnowledgeAdmission { };
    }
    fn propose(p: PracticeProposal, ctx: std::api::Context) -> CommandReply {
        return self.admission.propose(p, ctx);
    }
    fn verdict(v: ReviewDecision, ctx: std::api::Context) -> CommandReply {
        return self.admission.verdict(v, ctx);
    }
    fn propose_organization(o: OrganizationProposal, ctx: std::api::Context) -> CommandReply {
        return self.admission.propose_organization(o, ctx);
    }
    fn create_task(t: TaskCreation, ctx: std::api::Context) -> CommandReply {
        return self.admission.create_task(t, ctx);
    }
    fn reassign_task(t: TaskReassignment, ctx: std::api::Context) -> CommandReply {
        return self.admission.reassign_task(t, ctx);
    }
    fn retire_person(p: PersonRetirement, ctx: std::api::Context) -> CommandReply {
        return self.admission.retire_person(p, ctx);
    }
    fn claim(c: Claim, ctx: std::api::Context) -> CommandReply {
        return self.admission.claim(c, ctx);
    }
    fn outcome(o: Outcome, ctx: std::api::Context) -> CommandReply {
        return self.admission.outcome(o, ctx);
    }
    fn renew(r: Renewal, ctx: std::api::Context) -> CommandReply {
        return self.admission.renew(r, ctx);
    }
    fn release_attempt(r: Release, ctx: std::api::Context) -> CommandReply {
        return self.admission.release_attempt(r, ctx);
    }
    fn ask_allowance(a: Allowance, ctx: std::api::Context) -> CommandReply {
        return self.admission.allowance(a, ctx);
    }
