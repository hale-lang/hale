// dna/tests/two_owners_test.hl — two owners, two bodies, one record (GH #665, B2).
//
// Over a shared record each owner's controller holds its own lease in
// the store, so two bodies run side by side: acme's beside clone A,
// north's beside clone B, both writing through the one service. A
// forced claim of acme's lease from a third clone of acme's raises its
// epoch: the body that held it stops itself, its epoch writes nothing
// any more, and north's body is untouched. In between, a job acme's
// body plans for north's member is a transfer inside the ledger (GH
// #667): offered, refused to acme's member, accepted by north's, handed
// by north's body, and closed by the assignee. The service knows each
// owner's key (GH #669): a write in a person's name comes from a head of
// their owner, and north's head cannot act in alice's name.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && unset ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

fn through(dir: String, service: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && unset ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off HALE_DNA_KNOWLEDGE_URL=\"$1\" && shift && exec \"$@\"\nsh\n" + dir + "\n" + service + "\n" + argv);
}

type Http { status: Int = 0; body: String = ""; }

fn curl(method: String, url: String, body: String) -> Http {
    let mut argv = "curl\n-s\n-i\n-X\n" + method;
    if len(body) > 0 { argv = argv + "\n-H\nContent-Type: application/json\n--data\n" + body; }
    let r = dna::run_tool(argv + "\n" + url);
    let raw = r.stdout;
    let split = std::str::index_of(raw, "\r\n\r\n");
    let head = if split < 0 { raw } else { raw[0..split] };
    let rest = if split < 0 { "" } else { raw[(split + 4)..len(raw)] };
    let sp = std::str::index_of(head, " ");
    let status = if sp < 0 || len(head) < sp + 4 { 0 } else { std::str::parse_int(head[(sp + 1)..(sp + 4)]) or 0 };
    return Http { status: status, body: rest };
}

@unbounded
fn row_with(text: String, needle: String) -> String {
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::contains(line, needle) { return line; }
    }
    return "";
}

// A row's body, as a ledger row carries it (a JSON string field).
fn row_body(row: String) -> String { return std::json::find_string_field(row, "body"); }

fn ledger(service: String) -> String {
    return curl("GET", service + "/ledger/rows?from=0", "").body;
}

@unbounded
fn wait_row(service: String, needle: String, tries: Int) -> String {
    let mut n = 0;
    while n < tries {
        let row = row_with(ledger(service), needle);
        if len(row) > 0 { return row; }
        std::time::sleep(500ms);
        n = n + 1;
    }
    return "";
}

fn alive(pid: String) -> Bool {
    return len(pid) > 0 && dna::run_tool("kill\n-0\n" + pid).code == 0;
}

// The scripted catalog: every backend a `dna::FakeModel`, so a body plans
// with no API key (the B1 fixture's).
const CATALOG: String = "// dna/org/models.hl — the catalog, scripted (the two-owners fixture).\n"
    + "import \"vendor/dna\" as dna;\n"
    + "\n"
    + "fn frontier() -> dna::FakeModel {\n"
    + "    return dna::FakeModel { name: \"deep\", model: \"deep-1\", price_micros: 0, answer: \"kind: person\\nclass: application\\ntarget: (none)\\ncount: 1\\nassignee: bob\\nobligation: none\\na person chases it; nothing in the source changes\" };\n"
    + "}\n"
    + "\n"
    + "fn fast() -> dna::FakeModel {\n"
    + "    return dna::FakeModel { name: \"quick\", model: \"quick-1\", price_micros: 0, answer: \"kind: person\\nclass: application\\ntarget: (none)\\ncount: 1\\nassignee: bob\\nobligation: none\\na person chases it; nothing in the source changes\" };\n"
    + "}\n"
    + "\n"
    + "fn desk() -> dna::LocalFakeModel {\n"
    + "    return dna::LocalFakeModel { };\n"
    + "}\n"
    + "\n"
    + "fn leader_models() -> dna::ModelRouter {\n"
    + "    return dna::ModelRouter { quick: fast(), deep: frontier(), private: desk() };\n"
    + "}\n"
    + "\n"
    + "fn editor_models() -> dna::ModelRouter {\n"
    + "    return dna::ModelRouter { quick: fast(), deep: frontier(), private: desk() };\n"
    + "}\n"
    + "\n"
    + "fn agent_models() -> dna::ModelRouter {\n"
    + "    return dna::ModelRouter { quick: fast(), deep: frontier(), private: desk() };\n"
    + "}\n"
    + "\n"
    + "fn org_budget() -> dna::BudgetPolicy {\n"
    + "    return dna::BudgetPolicy { };\n"
    + "}\n";

main locus App {
    params {
        core: dna::Dna = dna::Dna { planned: true, org_id: "two-owners-placeholder" };
    }
    fn start_body(dir: String, service: String) -> String {
        let started = in_dir(dir, "sh\n-c\nHALE_DNA_KNOWLEDGE_URL=\"$2\" nohup timeout 900 \"$1\" dna run . --no-iris >.hale/body.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + service);
        return dna::trim_nl(started.stdout);
    }
    @unbounded
    fn body_up(dir: String, tries: Int) -> Bool {
        let mut n = 0;
        while n < tries {
            if std::io::fs::file_exists(dir + "/.hale/dna/hale-dna.intent.offered.sock") && std::io::fs::file_exists(dir + "/.hale/dna/org.pid") { return true; }
            std::time::sleep(500ms);
            n = n + 1;
        }
        return false;
    }
    @unbounded
    fn wait_gone(pid: String, tries: Int) -> Bool {
        let mut n = 0;
        while n < tries {
            if !alive(pid) { return true; }
            std::time::sleep(500ms);
            n = n + 1;
        }
        return false;
    }
    fn configure(dir: String, who: String, owner: String, key: String) {
        let c0 = in_dir(dir, "git\nconfig\nuser.name\n" + who);
        let c1 = in_dir(dir, "git\nconfig\nuser.email\n" + who + "@l");
        let c2 = in_dir(dir, "git\nconfig\ndna.owner\n" + owner);
        // GH #669: this owner's key to the shared record's service
        let c3 = in_dir(dir, "git\nconfig\ndna.owner.key\n" + key);
    }
    run() {
        let scratch = "/tmp/dna-two-owners-" + to_string(std::process::pid());
        std::io::fs::mkdir(scratch) or discard;
        dna::reap_on_exit(scratch);
        let bare = scratch + "/origin.git";
        let b0 = in_dir(scratch, "git\ninit\n-q\n--bare\n-b\nmain\n" + bare);
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\nshared");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let app = scratch + "/shared";
        let kport = 30000 + (std::process::pid() + 59) % 17000;
        let service = "http://127.0.0.1:" + to_string(kport);
        self.configure(app, "alice", "acme", "ka");
        std::io::fs::write_file(app + "/dna/org/models.hl", CATALOG) or discard;
        std::io::fs::write_file(app + "/dna/org/owners", "org = acme\norg/collections = north\nacme: alice\nnorth: bob\nhost = acme\n") or discard;
        let checked = in_dir(app, toolchain() + "\ncheck\n--matrix\n.");
        std::test::assert_eq_int(checked.code, 0, "the shared organization checks: " + checked.stdout + checked.stderr);
        let a1 = in_dir(app, "git\nadd\n-A");
        let a2 = in_dir(app, "git\ncommit\n-q\n-m\nthe shared organization");
        let a3 = in_dir(app, "git\nremote\nadd\norigin\n" + bare);
        let a4 = in_dir(app, "git\npush\n-q\norigin\nmain\nrefs/dna/*:refs/dna/*");
        std::test::assert_eq_int(a4.code, 0, "pushed: " + a4.stderr);
        // ---- one service, the ledger adopted into it
        let ksrv = in_dir(app, "sh\n-c\nHALE_DNA_KNOWLEDGE_DSN=memory HALE_DNA_OWNER_KEYS=\"acme=ka north=kb\" nohup timeout 900 \"$1\" dna knowledge . --port \"$2\" >.hale/knowledge.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + to_string(kport));
        let kpid = dna::trim_nl(ksrv.stdout);
        let mut kup = false;
        let mut tries = 0;
        while !kup && tries < 600 {
            if curl("GET", service + "/ledger/head", "").status == 200 { kup = true; } else { std::time::sleep(200ms); }
            tries = tries + 1;
        }
        std::test::assert(kup, "the service came up at " + service);
        let adopted = through(app, service, toolchain() + "\ndna\nledger\nadopt\n--as\nalice");
        std::test::assert(adopted.code == 0 && std::str::contains(adopted.stdout, "ledger adopted at"), "adopted: " + adopted.stdout + adopted.stderr);
        // ---- acme's body beside clone A, north's beside clone B
        let pid_a = self.start_body(app, service);
        std::test::assert(self.body_up(app, 600), "acme's body came up: " + (std::io::fs::read_file(app + "/.hale/body.log") or ""));
        let other = scratch + "/north";
        let cl = in_dir(scratch, "git\nclone\n-q\n" + bare + "\n" + other);
        std::test::assert_eq_int(cl.code, 0, "north clones the record: " + cl.stderr);
        self.configure(other, "bob", "north", "kb");
        let synced = through(other, service, toolchain() + "\ndna\nsync");
        std::test::assert_eq_int(synced.code, 0, "north's clone has the record: " + synced.stdout + synced.stderr);
        let pid_b = self.start_body(other, service);
        std::test::assert(self.body_up(other, 600), "north's body came up beside acme's: " + (std::io::fs::read_file(other + "/.hale/body.log") or ""));
        let la = curl("GET", service + "/ledger/lease?key=owner/acme", "").body;
        let lb = curl("GET", service + "/ledger/lease?key=owner/north", "").body;
        std::test::assert(std::str::contains(la, "\"present\": true") && std::str::contains(la, "shared"), "acme's lease is held, by its clone: " + la);
        std::test::assert(std::str::contains(lb, "\"present\": true") && std::str::contains(lb, "north"), "north's lease is held, by its clone: " + lb);
        std::test::assert(!std::str::contains(curl("GET", service + "/ledger/lease?key=body", "").body, "\"present\": true"), "no lease is the one body's: " + curl("GET", service + "/ledger/lease?key=body", "").body);
        let epoch_a = std::json::find_int_field(la, "token");
        // ---- acme's body writes under its epoch: an ask for its own position lands
        let asked = through(app, service, toolchain() + "\ndna\nask\n--no-wait\n--to\norg/books\n--as\nalice\nchase the late invoice");
        std::test::assert_eq_int(asked.code, 0, "alice asks acme's body: " + asked.stdout + asked.stderr);
        let offered = wait_row(service, "\"kind\": \"intent.offered\"", 240);
        std::test::assert(std::str::contains(offered, "chase the late invoice (from alice)"), "the body's write landed under its lease: " + ledger(service));
        // ---- the plan names bob, north's member: a transfer, not a hand-off
        let transfer = wait_row(service, "\"kind\": \"task.transfer_requested\"", 240);
        std::test::assert(std::json::find_string_field(row_body(transfer), "to") == "north" && std::json::find_string_field(row_body(transfer), "assignee") == "bob" && std::json::find_string_field(row_body(transfer), "owner") == "acme", "acme's body offers the job to north for bob: " + transfer);
        let tid = std::json::find_string_field(transfer, "entity");
        std::test::assert(std::str::starts_with(tid, "acme:t"), "the task is acme's, in acme's namespace: " + tid);
        std::test::assert_eq_str(row_with(ledger(service), "\"kind\": \"task.handed\""), "", "and nothing is handed yet");
        let not_theirs = through(app, service, toolchain() + "\ndna\ntask\naccept\n" + tid + "\n--as\nalice");
        std::test::assert(not_theirs.code != 0 && std::str::contains(not_theirs.stdout + not_theirs.stderr, "only north's accepts"), "acme's member cannot accept for north: " + not_theirs.stdout + not_theirs.stderr);
        let accepted = through(other, service, toolchain() + "\ndna\ntask\naccept\n" + tid + "\n--as\nbob\n--note\nwe take it");
        std::test::assert(accepted.code == 0 && std::str::contains(accepted.stdout, "accepted for north by bob"), "north's member accepts: " + accepted.stdout + accepted.stderr);
        let handed = wait_row(service, "\"kind\": \"task.handed\"", 240);
        std::test::assert(std::json::find_string_field(row_body(handed), "transferred_from") == "acme" && std::json::find_string_field(row_body(handed), "assignee") == "bob" && std::json::find_string_field(row_body(handed), "by") == "north" && std::json::find_string_field(row_body(handed), "accepted_by") == "bob", "north's body hands it to bob in its own name: " + handed);
        let done = through(other, service, toolchain() + "\ndna\ntask\ndone\n" + tid + "\n--as\nbob\n--note\npaid");
        std::test::assert(done.code == 0 && std::str::contains(done.stdout, "done by bob"), "bob closes it from north's clone: " + done.stdout + done.stderr);
        std::test::assert(std::str::contains(wait_row(service, "\"kind\": \"task.done\"", 60), "\"author\": \"bob\""), "in bob's name, in the one ledger");
        // ---- a forced claim of acme's lease from a third clone of acme's:
        // the epoch rises, the old body stops, north's does not
        let third = scratch + "/acme-2";
        let cl2 = in_dir(scratch, "git\nclone\n-q\n" + bare + "\n" + third);
        self.configure(third, "carol", "acme", "ka");
        let s2 = through(third, service, toolchain() + "\ndna\nsync");
        let claimed = through(third, service, toolchain() + "\ndna\nbody\nclaim\n--force\n--as\ncarol");
        std::test::assert(claimed.code == 0 && std::str::contains(claimed.stdout, "was taken by carol"), "acme's lease is taken from its body: " + claimed.stdout + claimed.stderr);
        std::test::assert(self.wait_gone(pid_a, 120), "acme's body stops itself once its lease is gone: " + (std::io::fs::read_file(app + "/.hale/body.log") or ""));
        std::test::assert(alive(pid_b), "north's body is untouched");
        let la2 = curl("GET", service + "/ledger/lease?key=owner/acme", "").body;
        std::test::assert(!std::str::contains(la2, "\"present\": true"), "acme's lease is released for the next body: " + la2);
        // the stopped body's epoch writes nothing any more
        let stale = curl("POST", service + "/ledger/append", "{\"expected\": 0, \"exact\": false, \"kind\": \"task.born\", \"entity\": \"t-stale\", \"body\": \"late\", \"as\": \"\", \"request_id\": \"stale-1\", \"lease\": \"owner/acme\", \"token\": " + to_string(epoch_a) + "}");
        std::test::assert(stale.status == 403 && std::str::contains(stale.body, "fenced"), "a write at the old epoch is fenced: " + to_string(stale.status) + " " + stale.body);
        // ---- GH #669: north's head cannot act in acme's member's name, whatever it claims
        let borrowed = through(other, service, toolchain() + "\ndna\nask\n--no-wait\n--to\norg/books\n--as\nalice\nsomething in alice's name");
        std::test::assert(borrowed.code != 0 && std::str::contains(borrowed.stdout + borrowed.stderr, "north's head cannot act in their name"), "the service knows whose head this is: " + borrowed.stdout + borrowed.stderr);
        // ---- north's body still writes
        let asked_b = through(other, service, toolchain() + "\ndna\nask\n--no-wait\n--to\norg/collections\n--as\nbob\ncall the agency");
        std::test::assert_eq_int(asked_b.code, 0, "bob asks north's body: " + asked_b.stdout + asked_b.stderr);
        let offered_b = wait_row(service, "call the agency (from bob)", 240);
        std::test::assert(len(offered_b) > 0, "north's body still writes under its own lease: " + ledger(service));
        // ---- down
        let k1 = dna::run_tool("kill\n" + pid_b);
        let rest = dna::run_tool("sh\n-c\nfor d in \"$1\" \"$2\"; do cd \"$d\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; done; done; true\nsh\n" + app + "\n" + other);
        let k2 = dna::run_tool("kill\n" + kpid);
    }
}
fn main() { App { }; }
