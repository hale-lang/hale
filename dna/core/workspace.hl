// dna/core/workspace.hl — the workspace and repository gateways
// (GH #529 D1): where a Mutation edits, and where the genome lives.
//
// Two effect gateways over `std::process`, each carrying the effect
// class the law reasons about (`worktree_io`, `repo_write`, and for
// the one operation that changes the genome, `genome_apply`), and a
// `MutationGateway` that puts every operation behind the Journal and
// a lease:
//
//   - journaled BEFORE dispatch under an idempotency key
//     (`effect_request`), the result appended once (`effect_result`),
//     so a crashed and retried apply cannot commit twice — the retry
//     finds the key and reads the recorded result;
//   - fenced by the Attempt's lease on `mutation:<id>`: an operation
//     presents its fencing token, and a stale one (the lease expired
//     and was re-acquired) is refused, never applied.
//
// One worktree per Mutation, named by the Mutation's id under
// `root`, removed on dissolution. The base is recorded as the commit
// AND the `exec_digest` of the checked build it was expressed as —
// a branch name says nothing about what ran.

// ---- running a tool -----------------------------------------------

// Once this process is gone, every process under `dir` is killed: whatever
// a fixture (or a tool) started under `dir` — hosts, bodies, services, the
// tools they run — stops, whether it ended passing, failing an assertion
// or killed (#637). A watcher in the background; returns at once.
fn reap_on_exit(dir: String) { reap_after(to_string(std::process::pid()), dir); }

// `reap_on_exit` for the process `pid`: once it is gone, what `reap_targets`
// names under `dir` is killed. The root's physical spelling is taken now,
// while it exists: by the time the watcher fires, `scratch_done` has
// removed it and there is nothing left to resolve.
fn reap_after(pid: String, dir: String) {
    let r = run_tool(
        "sh\n-c\n" + REAP_ROOTS + " (while kill -0 \"$1\" 2>/dev/null; do sleep 1; done; "
            + REAP_MATCH + " | xargs -r kill -KILL 2>/dev/null) </dev/null >/dev/null 2>&1 &\nsh\n"
            + pid + "\n" + dir,
    );
}

// The processes under `dir`, one pid a line: those whose command line names
// a path under it, and those whose working directory is it or lies under
// it. The second is the one a process whose program lives elsewhere — an
// organization started from the build cache, in its root — is found by:
// its command line names no scratch path, and the reaper missed it, so the
// suite's guard found it running after its fixture had gone. `dir` is the
// fixture's own (`scratch_root` names it by the fixture's pid), so only what
// that fixture started is among them (GH #872). The watcher itself names
// `dir` without the trailing `/` and runs elsewhere, so it is not.
fn reap_targets(dir: String) -> String {
    return trim_nl(run_tool("sh\n-c\n" + REAP_ROOTS + " " + REAP_MATCH + "\nsh\n-\n" + dir).stdout);
}

// The root two ways, as `sh` from `$2`: `d` as given, which is what a
// command line names, and `r` as the kernel reports a working directory —
// physical, every symlink resolved (macOS's `/tmp` is `/private/tmp`, and a
// TMPDIR may be a link anywhere). `r` is `d` when the root cannot be
// resolved.
const REAP_ROOTS: String = "d=$2; r=$(cd \"$d\" 2>/dev/null && pwd -P); [ -n \"$r\" ] || r=$d;";

// `reap_targets` as `sh`, over `d` and `r`: a command line is matched by
// `d`, a working directory by either. Linux reads it from /proc (a removed
// one reads `<path> (deleted)`); elsewhere `lsof` names it.
const REAP_MATCH: String = "{ ps -eo pid=,args= | awk -v d=\"$d/\" '$2 != \"awk\" && index($0, d) {print $1}'; if [ -d /proc/self ]; then for c in /proc/[0-9]*/cwd; do l=$(readlink \"$c\" 2>/dev/null) || continue; case \"$l\" in \"$d\" | \"$d\"/* | \"$d (deleted)\" | \"$r\" | \"$r\"/* | \"$r (deleted)\") q=${c#/proc/}; echo \"${q%/cwd}\" ;; esac; done; else lsof -a -d cwd -Fpn 2>/dev/null | awk -v d=\"$d\" -v r=\"$r\" '/^p/ {q = substr($0, 2)} /^n/ {n = substr($0, 2); if (n == d || n == r || index(n, d \"/\") == 1 || index(n, r \"/\") == 1) print q}'; fi; } | sort -u";

// ---- a body's processes, by the session they were born in -----------
//
// Everything a body starts begins a session of its own (`in_new_session`),
// and everything THAT starts stays in it: a child that takes a process
// group of its own — every `std::process::run` child does — keeps its
// session, and so does one reparented when its parent dies. Only an
// explicit `setsid` leaves. So the processes of a body's organization are
// the processes of its session, on every POSIX system, and a fence that
// stops "the session led by the organization's pid" stops the tool an
// organism orphaned when it crashed (GH #970). This is the mechanism; the
// environment mark below is a second net where a machine discloses
// environments (Linux), for a tool that did `setsid` itself.

// getsid(2), from the lotus runtime (every Hale program links it): the
// session `pid` is in, -1 when it cannot be read.
@ffi("c") fn lotus_process_session(pid: Int) -> Int;

// `argv` (newline-separated), run as the leader of a new session. Linux
// has `setsid(1)`; macOS has none, and perl does what it does: a process
// that already leads a process group cannot begin a session, so it forks
// first and the child begins it (the parent exits 0); otherwise it begins
// one in place. Either way the program is exec'd, so its command line and
// the environment it was given are its own — and from `start`, whose
// child never leads a group, so is its pid.
fn in_new_session(argv: String) -> String {
    return "sh\n-c\nif command -v setsid >/dev/null 2>&1; then exec setsid \"$@\"; fi; exec perl -MPOSIX -e 'if (getpgrp() == $$) { defined(my $k = fork) or die \"fork: $!\\n\"; exit 0 if $k } POSIX::setsid() >= 0 or die \"setsid: $!\\n\"; exec @ARGV or die \"exec $ARGV[0]: $!\\n\"' \"$@\"\nsh\n"
        + argv;
}

// Every process in the session `leader` began, newline-separated ("" when
// none, or when `leader` began no session). The leader itself, while it
// lives, is among them. Never this process.
// One line per process in `leader`'s session.
@bounded_by(leader)
fn session_members(leader: String) -> String {
    let sid = std::str::parse_int(leader) or 0;
    if sid <= 0 { return ""; }
    let me = std::process::pid();
    let mut rest = run_tool("ps\n-A\n-o\npid=").stdout;
    let mut out = "";
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let word = std::str::trim(if nl < 0 { rest } else { rest[0..nl] });
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let p = std::str::parse_int(word) or 0;
        if p > 0 && p != me && lotus_process_session(p) == sid { out = out + to_string(p) + "\n"; }
    }
    return trim_nl(out);
}

// Two newline-separated lists as one, with no empty line between them —
// an empty argument would make `kill` refuse the call.
fn join_lines(a: String, b: String) -> String {
    if len(a) == 0 { return b; }
    if len(b) == 0 { return a; }
    return a + "\n" + b;
}

// ---- a body's processes, wherever they were reparented -------------

// The mark a body puts in the environment of everything it starts
// (`HALE_DNA_BODY`): its lease's holder and token and its host's pid, `#`
// after each so no mark is a prefix of another.
fn body_mark(holder: String, token: Int, host_pid: Int) -> String {
    return holder + "#" + to_string(token) + "#" + to_string(host_pid) + "#";
}

// How this machine reads another process's environment (#638). A tool
// keeps the environment its organism gave it after that organism is gone
// and the tool is reparented, where a walk from the organism's pid no
// longer reaches it — but only if this machine will show it:
//
//   `proc`  Linux: /proc/<pid>/environ.
//   `ps`    the BSDs, and a macOS that discloses environments (GitHub's
//           runners do; a Mac with SIP does not): `ps -E`, proved here on
//           a child of this call's, since the answer depends on what the
//           kernel will disclose about another process, not on the flag.
//   ""      neither: a body finds only what still hangs off a living
//           parent (`kill_tree`), and the host says so at startup.
fn body_scan() -> String {
    if std::io::fs::file_exists("/proc/self/environ") { return "proc"; }
    // Proved on ANOTHER process — a child carrying the probe — never on the
    // probing shell itself: macOS shows a process its own environment and
    // no one else's, so a self-probe said "ps" where the scan then found
    // nothing (GH #970).
    let probe = run_tool(
        "env\nHALE_DNA_SCAN_PROBE=yes\nsh\n-c\nsleep 5 & p=$!; n=$(ps -E -ww -o command= -p $p 2>/dev/null | grep -c HALE_DNA_SCAN_PROBE=yes); kill $p 2>/dev/null; echo $n",
    );
    if probe.code == 0 && trim_nl(probe.stdout) != "0" { return "ps"; }
    return "";
}

// Every process whose environment carries `HALE_DNA_BODY=<mark>`,
// newline-separated ("" when none, or when this machine has no scan).
fn marked(mark: String) -> String {
    if len(mark) == 0 { return ""; }
    let needle = "HALE_DNA_BODY=" + mark;
    let scan = body_scan();
    if scan == "proc" {
        // the needle is this call's argument, never its environment, so
        // the shell reading /proc does not match itself
        let r = run_tool(
            "sh\n-c\nfor e in /proc/[0-9]*/environ; do if grep -a -q -F \"$1\" \"$e\" 2>/dev/null; then p=${e#/proc/}; echo ${p%/environ}; fi; done\nsh\n"
                + needle,
        );
        return trim_nl(r.stdout);
    }
    if scan == "ps" {
        // `ps -E` prints a process's environment after its command, so a
        // needle in this call's own argv would match the line for its own
        // `awk`. It goes in the environment instead, and the shell running
        // the scan (`$$`) and its two children — the `ps` and the `awk` —
        // are the lines to leave out.
        // `-A`: every process, not the ones sharing this call's terminal,
        // which is how a BSD `ps` given no selection reads — and an orphan
        // shares no terminal with anything (macOS, first run of this scan)
        let r = run_tool(
            "env\nHALE_DNA_SCAN_NEEDLE=" + needle
                + "\nsh\n-c\nps -A -E -ww -o pid=,ppid=,command= 2>/dev/null | awk -v me=$$ '$1 != me && $2 != me && index($0, ENVIRON[\"HALE_DNA_SCAN_NEEDLE\"]) { print $1 }'",
        );
        return trim_nl(r.stdout);
    }
    return "";
}

// Everything carrying a body's mark, at once: frozen, read again, killed.
fn kill_marked(mark: String) {
    if len(mark) == 0 { return; }
    let first = marked(mark);
    if len(first) == 0 { return; }
    let s = run_tool("kill\n-STOP\n" + first);
    let again = marked(mark);
    let k = run_tool("kill\n-KILL\n" + first + (if len(again) > 0 { "\n" + again } else { "" }));
}

type RunResult {
    code: Int = -1;
    stdout: String = "";
    stderr: String = "";
}

fn run_failed(e: IoError) -> std::process::ProcessOutput {
    return std::process::ProcessOutput { code: -1, signal: 0, stdout: "", stderr: e.kind };
}

// A file's permission bits as octal digits (`600`, `700`), "" when there
// is no such file. std::io::fs reads no permissions, and stat spells the
// question per platform: `-f %Lp` on macOS (BSD), `-c %a` elsewhere (GNU).
fn file_mode(path: String) -> String {
    let r = run_tool(
        "sh\n-c\nif [ \"$(uname -s)\" = Darwin ]; then stat -f %Lp \"$1\"; else stat -c %a \"$1\"; fi\nsh\n"
            + path,
    );
    return if r.code == 0 { trim_nl(r.stdout) } else { "" };
}

// argv as `std::process::run` takes it: newline-separated.
fn run_tool(argv: String) -> RunResult {
    let out = std::process::run(argv) or run_failed(err);
    return RunResult { code: out.code, stdout: out.stdout, stderr: out.stderr };
}

// A clone of the local repository `src` at `dst`, for a fixture: through
// git's transport (`--no-local`), never a copy of `src`'s object files.
// A push into a bare `src` starts its auto-gc in the background, and a
// local clone copying `objects/info/commit-graphs` while that gc rewrote
// it failed with "failed to copy file to ...commit-graphs/..." (CI). The
// clone's own auto-gc and maintenance are off, so it races nothing the
// fixture does next either.
fn clone_repo(src: String, dst: String) -> RunResult {
    return clone_repo_with("", src, dst);
}

// `clone_repo` with more of `git clone`'s flags, one per line and each
// line ended (`"-b\nmain\n"` checks out `main`).
fn clone_repo_with(flags: String, src: String, dst: String) -> RunResult {
    return run_tool(
        "git\nclone\n--quiet\n--no-local\n--config\ngc.auto=0\n--config\nmaintenance.auto=false\n"
            + flags + src + "\n" + dst,
    );
}

// `argv` under a wall-clock limit of `secs`; exit 124 when the limit
// ends it, as GNU `timeout` reports it. `timeout` is coreutils: Linux
// has it and a stock Mac does not, so where it is missing perl's
// `alarm` does the same job — the alarm survives the exec and SIGALRM
// ends the tool (perl ships on every Mac). Without this, a Mac's every
// timed git transfer failed on the missing tool (GH #970).
fn run_tool_timeout(secs: Int, argv: String) -> RunResult {
    return run_tool(
        "sh\n-c\nif command -v timeout >/dev/null 2>&1; then exec timeout \"$@\"; fi; s=$1; shift; perl -e 'alarm shift; exec @ARGV or exit 127' \"$s\" \"$@\"; rc=$?; [ $rc -eq 142 ] && rc=124; exit $rc\nsh\n"
            + to_string(secs) + "\n" + argv,
    );
}

// A file's SHA-256 as lowercase hex, "" when it cannot be read.
// `sha256sum` is coreutils (Linux); `shasum -a 256` answers the same
// question in the same format on every Mac, where a digest taken with
// `sha256sum` alone came back silently empty (GH #970).
fn sha256_file(path: String) -> String {
    let r = run_tool("sh\n-c\n(sha256sum \"$1\" || shasum -a 256 \"$1\") 2>/dev/null\nsh\n" + path);
    if r.code != 0 { return ""; }
    let sp = std::str::index_of(r.stdout, " ");
    return if sp < 0 { trim_nl(r.stdout) } else { r.stdout[0..sp] };
}

// The regular files under `dir`, relative and one per line, sorted;
// vendor, `.git` (a worktree's is a FILE, so it is named as well as
// its tree) and `.hale` are never part of a change (GH #583 M3/M4).
fn list_files(dir: String) -> String {
    let r = run_tool(
        "sh\n-c\ncd \"$0\" && find . -type f ! -path \"./vendor/*\" ! -path \"./.git\" ! -path \"./.git/*\" ! -path \"./.hale\" ! -path \"./.hale/*\" | sed \"s|^./||\" | sort\n"
            + dir,
    );
    return if r.code == 0 { r.stdout } else { "" };
}

// The last `/` in a path, -1 for a bare name.
fn last_slash(s: String) -> Int {
    let mut i = len(s) - 1;
    while i >= 0 {
        if s[i..(i + 1)] == "/" { return i; }
        i = i - 1;
    }
    return -1;
}

// A patch (`git format-patch` or a unified diff) applied in a worktree,
// index and all (GH #1156): through a file in the worktree, which git
// reads relative to it, gone before anything is staged.
fn apply_patch_in(worktree: String, patch: String) -> RunResult {
    std::io::fs::write_file(worktree + "/.hale-leg.patch", patch) or discard;
    let applied = run_tool("git\n-C\n" + worktree + "\napply\n--index\n.hale-leg.patch");
    let gone = run_tool("rm\n-f\n" + worktree + "/.hale-leg.patch");
    return applied;
}

// Every path a worktree's index changes, one per line, a rename's source
// and destination both, unquoted (GH #1156).
fn staged_paths(worktree: String) -> RunResult {
    return run_tool(
        "git\n-C\n" + worktree
            + "\n-c\ncore.quotePath=false\ndiff\n--cached\n--name-only\n--no-renames",
    );
}

fn trim_nl(s: String) -> String {
    let mut e = len(s);
    while e > 0 && (s[(e - 1)..e] == "\n" || s[(e - 1)..e] == "\r" || s[(e - 1)..e] == " ") {
        e = e - 1;
    }
    return s[0..e];
}

// ---- how long a fixture waits for the organism (GH #795) -------------

// Every bounded wait in a fixture is a base sized for a quiet machine
// times this multiplier (`HALE_DNA_WAIT_SCALE`, default 1, never below
// 1). A loaded runner — the whole workspace's tests beside one organism
// and its bodies — widens every wait from one place, instead of each
// fixture growing its own number after each flake.
fn wait_scale() -> Int {
    let given = trim_nl(std::env::var("HALE_DNA_WAIT_SCALE"));
    let s = std::str::parse_int(given) or 1;
    return if s < 1 { 1 } else { s };
}

// `secs` seconds on a quiet machine, widened by `wait_scale()`.
fn wait_secs(secs: Int) -> Int { return secs * wait_scale(); }

// ---- a port a fixture's service can have (GH #873) -------------------

// GH #1123: `<node> <holder>` lines — `position:org organization:acme`,
// `organization:acme alice` — as memory's `graph_ownership()` answers
// them, JSON `[node, holder]` pairs: a fixture states who owns what in the
// graph's own terms without a memory to hold it.
fn graph_ownership_of(lines: String) -> String {
    let b = std::json::Builder { };
    b.begin_array();
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = trim_nl(if nl < 0 { rest } else { rest[0..nl] });
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let sp = std::str::index_of(line, " ");
        if sp <= 0 { continue; }
        b.begin_array();
        b.string_value(line[0..sp]);
        b.string_value(line[(sp + 1)..len(line)]);
        b.end_array();
    }
    b.end_array();
    return b.result();
}

// A loopback port nothing is listening on: bound here, closed, and
// handed back.
//
// The fixtures used to compute `30000 + (pid + salt) % 17000` and trust
// it. Nothing checked, so a collision with any other listener on the
// box — a neighbouring slice's fixture, another checkout's DNA run, a
// server of the developer's — reached the fixture as "the service never
// came up", which is the shape #795 reported and #869 could not
// reproduce. Here the bind IS the check: a candidate that cannot be
// bound is not returned, and the search steps to the next one. Each
// refusal's errno is on stderr from the bind itself
// (`lotus_tcp_listen_socket: bind: Address already in use`), so a
// fixture that ends up with no port says which ports it tried and why
// each was refused.
//
// `index` separates the several ports one fixture needs: closing the
// probe leaves the port free again, so two calls with the same index
// answer the same port. Give each service its own (0, 1, 2, …) — the
// starts are 512 apart, so one search would have to cross 512 bound
// ports to reach another's answer.
//
// The process's own offset is a hash of its pid, not a multiple of it:
// with `pid * 64`, two fixtures running at once whose pids were 8 apart
// started one's index 1 where the other's index 2 started, both probes
// found the port free, and the later bind of the two was refused.
//
// 20000..32767: below the kernel's ephemeral range (Linux's
// `ip_local_port_range` is 32768..60999 by default), so no outgoing
// connection on the box is handed the port between the close here and
// the service's own bind — the window in which a reflex fixture's spine
// once found its port taken (the range was 30000..46999, most of it
// ephemeral). Clear of the fixed ports the OIDC fixtures bind. -1, with a
// line saying so, when every candidate was in use.
//
// The window itself stays open: another fixture's probe could still take
// the port, which the pid-hashed starts below keep apart.
fn free_port(index: Int) -> Int {
    let span = 12768;
    let h = std::crypto::sha256(
        std::bytes::from_string("free_port:" + to_string(std::process::pid())),
    );
    let offset = (std::bytes::at(h, 0) or 0) * 256 + (std::bytes::at(h, 1) or 0);
    let start = (offset + index * 512) % span;
    let mut i = 0;
    while i < 512 {
        let port = 20000 + (start + i) % span;
        let fd = std::io::tcp::__listen_socket("127.0.0.1", port);
        if fd >= 0 {
            std::io::tcp::__close_fd(fd);
            return port;
        }
        i = i + 1;
    }
    println(
        "dna::free_port: every port from ",
        20000 + start,
        " on (512 candidates in 20000..32767) was refused at bind; each errno is above. The caller is handed -1.",
    );
    return -1;
}

// ---- where a fixture works (GH #909) ---------------------------------

// A fixture's scratch root: `/tmp/dna-<what>-<pid>`, empty, and its
// own. Anything left at that path from an earlier run that held this
// pid goes first, so a fixture never reads a stranger's files.
//
// One place knows the shape, because three things read it: the
// fixture, the suite's leftover-process guard (which attributes a
// leaked process to the root in its command line, GH #872), and the
// sweep below.
fn scratch_root(what: String) -> String {
    let dir = scratch_dir(what);
    let gone = run_tool("rm\n-rf\n" + dir);
    std::io::fs::mkdir(dir) or discard;
    scratch_register(dir);
    return dir;
}

// The path `scratch_root(what)` makes, for a file a fixture keeps under
// its root from a fn that is not handed the root.
fn scratch_dir(what: String) -> String {
    return "/tmp/dna-" + what + "-" + to_string(std::process::pid());
}

// Where the slice that started this fixture records the roots it is
// responsible for: `/tmp/dna-suite-<HALE_DNA_SUITE_TAG>`, one file per
// root. "" when nothing stamped this process — a fixture run by hand
// belongs to no slice, and nobody sweeps after it.
fn scratch_registry() -> String {
    let tag = trim_nl(std::env::var("HALE_DNA_SUITE_TAG"));
    if len(tag) == 0 { return ""; }
    return "/tmp/dna-suite-" + tag;
}

// The entry in the registry for `dir`, named after the root and
// holding the root's path. The sweep never has to reconstruct a path
// from a name, and never touches a root it has no entry for: a
// neighbouring slice's roots, and another checkout's, carry a
// different tag or none.
fn scratch_register(dir: String) {
    let reg = scratch_registry();
    if len(reg) == 0 { return; }
    std::io::fs::mkdir(reg) or discard;
    std::io::fs::write_file(reg + "/" + scratch_name(dir), dir) or discard;
    // The slice's ledger: every root it ever made, kept when the
    // fixture passes and its registry entry goes. Where no process's
    // environment can be read (macOS), the leftover guard attributes a
    // process to this slice by a root in the ledger instead of by the
    // stamp in its environment (GH #970).
    std::io::fs::mkdir(reg + ".all") or discard;
    std::io::fs::write_file(reg + ".all/" + scratch_name(dir), dir) or discard;
}

// ---- the test's habitat (GH #1653) ------------------------------------
//
// Every organism a fixture makes is grafted from a habitat, as every
// organism but the habitat is. `test_habitat` is the one it grafts into:
// the slice's (`HALE_DNA_TEST_HABITAT`, born once per slice by the suite,
// its secrets lent from `HALE_DNA_TEST_HABITAT_VAULT` into this file's
// vault), or one of this test file's own, born here the first time with
// no body — on the operator's backends when an owner's DSN and NATS are
// named, else its own. `grafted` grafts into it.

// The habitat this fixture grafts into, born: its directory, "" with why
// on stderr when it cannot be.
fn test_habitat() -> String {
    let slice = trim_nl(std::env::var("HALE_DNA_TEST_HABITAT"));
    if len(slice) > 0 {
        let vault = trim_nl(std::env::var("HALE_DNA_TEST_HABITAT_VAULT"));
        // the habitat's secrets, lent: copied where this file's vault has none
        let lent = run_tool(
            "sh\n-c\numask 077 && mkdir -p \"$2\" && for f in \"$1\"/*; do [ -f \"$f\" ] || continue; b=$(basename \"$f\"); [ -e \"$2/$b\" ] || cp \"$f\" \"$2/$b\"; done\nsh\n"
                + vault + "\n" + std::secret::vault_local_dir(),
        );
        if lent.code != 0 {
            eprintln("dna: the slice habitat's secrets could not be lent: ", lent.stderr);
            return "";
        }
        return slice;
    }
    let dir = local_habitat_dir();
    if std::io::fs::file_exists(dir + "/genome/hale.toml")
        && !std::io::fs::file_exists(dir + "/birth.pending")
        && len(record_scope(dir + "/genome")) > 0
    {
        return dir;
    }
    let operator = len(trim_nl(std::env::var("HALE_DNA_MEMORY_DSN_OWNER"))) > 0
        && len(trim_nl(std::env::var("HALE_DNA_NATS_URL_OWNER"))) > 0;
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let up = run_tool_timeout(
        900,
        "sh\n-c\n"
            + (
                if operator {
                    ""
                } else {
                    "unset HALE_DNA_MEMORY_DSN_OWNER HALE_DNA_NATS_URL_OWNER; "
                }
            )
            + "export HALE_DNA_DISCOVER=off; exec \"$1\" habitat up --no-body --backends \"$2\"\nsh\n"
            + hale + "\n" + (if operator { "operator" } else { "own" }),
    );
    if up.code != 0 {
        eprintln("dna: the test's habitat was not born: ", up.stdout, up.stderr);
        return "";
    }
    return dir;
}

// `argv` (newline-separated) run under this fixture's habitat: `env
// HALE_DNA_HABITAT=<it> <argv>`, what a fixture's own runner executes for a
// graft (`hale habitat graft <name>`) with the environment it gives every
// other command.
fn in_habitat(argv: String) -> String {
    return "env\nHALE_DNA_HABITAT=" + test_habitat() + "\n" + argv;
}

// `hale habitat graft <args>` (newline-separated) run in `dir`, into this
// fixture's habitat.
fn grafted(dir: String, args: String) -> RunResult {
    let habitat = test_habitat();
    if len(habitat) == 0 { return RunResult { code: -1, stderr: "no habitat to graft into" }; }
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    return run_tool_timeout(
        900,
        "sh\n-c\ncd \"$1\" && export HALE_DNA_HABITAT=\"$2\" HALE_DNA_DISCOVER=off && shift 2 && exec \"$@\"\nsh\n"
            + dir + "\n" + habitat + "\n" + hale + "\nhabitat\ngraft\n" + args,
    );
}

// The CI jobs of the voice repository, as the gates a fixture about routing
// needs: the vendored tree carries no .github of its own, so a copy that
// wants gates is given this one, a job per gate, each naming what it guards.
const VOICE_GATES: String = "name: ci
on: [push]
jobs:
  api:
    name: api
    steps:
      - run: hale test api && hale build api && spec/openapi.yaml && spec/validate
  brain:
    name: brain
    steps:
      - run: hale test brain && hale build brain
  node:
    name: node
    steps:
      - run: hale test node && hale build node && spec/node.yaml && spec/validate
  ui:
    name: ui
    steps:
      - run: ui
  contracts:
    name: contracts
    steps:
      - run: spec/openapi.yaml spec/node.yaml spec/protocol.yaml spec/internal.yaml spec/validate
  store:
    name: store
    steps:
      - run: spec/store.md
  image:
    name: image
    steps:
      - run: docker compose build
";

// The vendored voice (onboarding/voice-heart.source) as a repository of its
// own at `dir`, for a fixture about the repository's graph, holes, holds or
// routes: a copy (the vendored tree is never touched) with the `broker` role
// left out of the needs its manifest declares (a habitat on the operator's
// backends configures no NATS of its own, and these fixtures are not about
// the broker; first_run_test grafts the whole heart on a habitat of its own),
// with `VOICE_GATES` as its CI when `gates`, committed under `who` (the built
// binary kept out of the commits by the clone's own exclude file), and its
// api built, which the migration the heart hands the habitat at graft runs.
// The result is the chain's last step.
fn voice_repo(source: String, dir: String, who: String, gates: Bool) -> RunResult {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let copied = run_tool(
        "sh\n-c\nmkdir -p \"$2/.github/workflows\" && cp -r \"$1/dna/tests/onboarding/voice-heart/.\" \"$2/\" && cd \"$2\" && sed 's/^needs = .*/needs = [\"memory\", \"nerves\", \"database\"]/' hale.toml > hale.toml.next && mv hale.toml.next hale.toml && grep -qF 'needs = [\"memory\", \"nerves\", \"database\"]' hale.toml\nsh\n"
            + source + "\n" + dir,
    );
    if copied.code != 0 { return copied; }
    if gates { std::io::fs::write_file(dir + "/.github/workflows/ci.yml", VOICE_GATES) or discard; }
    else { let bare = run_tool("rmdir\n-p\n" + dir + "/.github/workflows"); }
    return run_tool_timeout(
        900,
        "sh\n-c\ncd \"$1\" && git init -q -b main && printf '/api/api\\n' >> .git/info/exclude && git config user.name \"$2\" && git config user.email \"$2@dna\" && git add -A && git commit -q -m voice && \"$3\" build api\nsh\n"
            + dir + "\n" + who + "\n" + hale,
    );
}

// The fixture is done with `dir` and passed: the root goes, and its
// registry entry with it. `HALE_DNA_KEEP_SCRATCH` keeps both and says
// where the root is, which is the knob for looking at what a fixture
// built. The word goes to stderr: a leg cleans its hands with this, and
// its stdout is its answer.
fn scratch_done(dir: String) {
    if keep_scratch() {
        eprintln("kept (HALE_DNA_KEEP_SCRATCH): ", dir);
        return;
    }
    // what compose runs from under the root goes with it, or it outlives
    // the root (a host with no owner's DSN brings its knowledge database
    // up as an allocation of the local habitat: the test file's own, which
    // `hale test` takes down with the file's vault, or one a fixture keeps
    // under its root). A teardown that failed, or left anything, fails the fixture and keeps the root, its registry
    // entry and the projects it names, for the sweep or a run by hand
    let left = scratch_compose_down(dir);
    if len(left) > 0 {
        eprintln(
            "dna: the compose projects rooted in ",
            dir,
            " did not come down; the root and its record are kept for another attempt:\n",
            left,
        );
    }
    std::test::assert(
        len(left) == 0,
        "compose projects rooted in " + dir + " survived their teardown: " + left,
    );
    let gone = run_tool("rm\n-rf\n" + dir);
    let reg = scratch_registry();
    if len(reg) == 0 { return; }
    // A root can survive its own removal: a host or a body the fixture
    // started is still on its way down and writes the directory back
    // underneath the `rm` (`relayrepeat` left a 20K skeleton that way).
    // The record stays for exactly that case, so the slice's sweep —
    // which runs once everything the fixture started is gone — takes
    // it. Dropping the record here regardless is what let one through.
    if (std::io::fs::list_dir_count(dir) or - 1) >= 0 { return; }
    std::io::fs::unlink(reg + "/" + scratch_name(dir)) or discard;
}

// The file under a scratch root naming the compose projects found rooted
// in it, one per line, kept until their teardown is confirmed. A volume
// carries its project's name but not the directory the project ran from,
// so a project whose containers went and whose volumes did not is found
// again by the name kept here.
const SCRATCH_COMPOSE_FILE: String = ".dna-compose-projects";

// What docker answered: `ok` with its output, `absent` when there is no
// docker to ask (no CLI, or no daemon: nothing compose started can be
// running there), else `why` it failed.
type DockerAnswer { ok: Bool = false; absent: Bool = false; out: String = ""; why: String = ""; }

fn docker_ask(argv: String) -> DockerAnswer {
    let r = run_tool("docker\n" + argv);
    if r.code == 0 { return DockerAnswer { ok: true, out: r.stdout }; }
    if r.code == -1
        || std::str::contains(r.stderr, "Cannot connect to the Docker daemon")
        || std::str::contains(r.stderr, "Is the docker daemon running")
    {
        return DockerAnswer { absent: true };
    }
    return DockerAnswer {
        why: "docker " + std::str::replace(argv, "\n", " ") + ": " + trim_nl(r.stderr),
    };
}

// `line` added to the line set `set` ("\n"-terminated lines), once.
fn line_set_add(set: String, line: String) -> String {
    if len(line) == 0 || std::str::contains("\n" + set, "\n" + line + "\n") { return set; }
    return set + line + "\n";
}

// The compose projects rooted in `dir`: every container compose labelled
// (running or not) whose working directory is `dir` or under it, and the
// projects an earlier teardown of `dir` named and did not finish. The
// answer's `out` is one project per line.
@bounded_by(dir)
fn scratch_compose_projects(dir: String) -> DockerAnswer {
    let ps = docker_ask(
        "ps\n-a\n--filter\nlabel=com.docker.compose.project\n--format\n{{.Label \"com.docker.compose.project\"}}|{{.Label \"com.docker.compose.project.working_dir\"}}",
    );
    if !ps.ok { return ps; }
    return DockerAnswer {
        ok: true,
        out: scratch_projects_in(
            ps.out,
            dir,
            std::io::fs::read_file(dir + "/" + SCRATCH_COMPOSE_FILE) or "",
        ),
    };
}

// The projects of docker's `listed` (`<project>|<working dir>` lines)
// rooted in `dir`, and the ones `recorded` names. GH #1653: never the
// developer's own local habitat, nor the one this process's XDG_DATA_HOME
// names when it lives outside `dir` — the machine's long-lived habitat is
// no fixture's to take down, whatever a file under a root says. A test
// file's habitat is `hale test`'s, beside the file's vault, and comes down
// with it.
@bounded_by(listed)
fn scratch_projects_in(listed: String, dir: String, recorded: String) -> String {
    let mine = developer_habitat_project();
    let here = local_habitat_dir();
    let current = if here == dir || std::str::starts_with(here, dir + "/") {
        ""
    } else {
        local_habitat_project()
    };
    let mut out = "";
    let mut rest = listed + recorded;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let bar = std::str::index_of(line, "|");
        let project = if bar < 0 { line } else { line[0..bar] };
        if len(project) == 0 || project == mine || project == current { continue; }
        if bar < 0 { out = line_set_add(out, line); continue; }
        let wd = line[(bar + 1)..len(line)];
        if wd == dir || std::str::starts_with(wd, dir + "/") { out = line_set_add(out, project); }
    }
    return out;
}

// Take down every compose project rooted in `dir` — its containers,
// networks and volumes (`docker compose -p <project> down -v`, which needs
// no compose file) — and confirm none of it is left, by the project's
// label on containers and on volumes. "" when nothing is left (or there
// is no docker to ask); else what failed or survived, and the projects
// stay named under `dir` (SCRATCH_COMPOSE_FILE) for the next attempt.
@bounded_by(dir)
fn scratch_compose_down(dir: String) -> String {
    let found = scratch_compose_projects(dir);
    if found.absent { return ""; }
    if !found.ok { return found.why; }
    if len(found.out) == 0 { return ""; }
    std::io::fs::mkdir(dir) or discard;
    std::io::fs::write_file(dir + "/" + SCRATCH_COMPOSE_FILE, found.out) or discard;
    let mut failed = "";
    let mut rest = found.out;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let project = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let down = docker_ask("compose\n-p\n" + project + "\ndown\n-v\n--remove-orphans");
        if !down.ok && !down.absent { failed = failed + down.why + "\n"; }
        let containers = docker_ask(
            "ps\n-a\n-q\n--filter\nlabel=com.docker.compose.project=" + project,
        );
        let volumes = docker_ask(
            "volume\nls\n-q\n--filter\nlabel=com.docker.compose.project=" + project,
        );
        if !containers.ok && !containers.absent { failed = failed + containers.why + "\n"; }
        if !volumes.ok && !volumes.absent { failed = failed + volumes.why + "\n"; }
        if len(trim_nl(containers.out)) > 0 || len(trim_nl(volumes.out)) > 0 {
            failed = failed + "compose project " + project + " still has "
                + (if len(trim_nl(containers.out)) > 0 { "containers " } else { "" })
                + (if len(trim_nl(volumes.out)) > 0 { "volumes " } else { "" })
                + "after its teardown\n";
        }
    }
    if len(failed) == 0 { std::io::fs::unlink(dir + "/" + SCRATCH_COMPOSE_FILE) or discard; }
    return failed;
}

// Whether a scratch root is kept for inspection instead of removed.
// Read by the fixtures AND by the suite's sweep, so one value decides
// both: a knob that cleaned up behind the fixture that honoured it
// would be no knob at all.
fn keep_scratch() -> Bool {
    let v = trim_nl(std::env::var("HALE_DNA_KEEP_SCRATCH"));
    return len(v) > 0 && v != "0";
}

// A root's last path segment, which is what names its registry entry.
fn scratch_name(dir: String) -> String {
    return dir[(last_slash(dir) + 1)..len(dir)];
}

// ---- workspaces ------------------------------------------------------

type Worktree {
    mutation_id: String = "";
    path: String = "";
    base_commit: String = "";
    base_exec_digest: String = "";
    present: Bool = false;
    error: String = "";
}

interface Workspaces {
    fn open(mutation_id: String, base_commit: String) -> Worktree;
    fn remove(mutation_id: String) -> Bool;
    fn path_of(mutation_id: String) -> String;
    fn repo() -> String;
    fn kind() -> String;
}

// `git worktree` under `root`, one per Mutation, detached at the base.
locus IsolatedWorktrees {
    params {
        repo: String = ".";
        root: String = ".hale/dna/worktrees";
        base_exec_digest: String = ""; // the checked build's identity, supplied by the host
        opened: Int = 0;
        removed: Int = 0;
        last_error: String = "";
    }
    fn kind() -> String { return "isolated-worktrees"; }
    fn repo() -> String { return self.repo; }
    fn path_of(mutation_id: String) -> String { return self.root + "/" + mutation_id; }
    @effects(is: { worktree_io })
    fn open(mutation_id: String, base_commit: String) -> Worktree {
        let path = self.path_of(mutation_id);
        std::io::fs::mkdir(self.root) or discard;
        let r = run_tool(
            "git\n-C\n" + self.repo + "\nworktree\nadd\n--detach\n" + path + "\n" + base_commit,
        );
        if r.code != 0 {
            self.last_error = trim_nl(r.stderr);
            return Worktree {
                mutation_id: mutation_id,
                base_commit: base_commit,
                error: self.last_error,
            };
        }
        self.opened = self.opened + 1;
        // vendor/ is toolchain-managed and ignored by git (the graft's
        // edit), so a fresh checkout has none: the worktree gets the
        // repository's, and the editor's `hale check` resolves its
        // imports the way the genome's does.
        let vendored = std::io::fs::list_dir_count(self.repo + "/vendor") or - 1;
        if vendored >= 0 {
            let cp = run_tool("cp\n-r\n" + self.repo + "/vendor\n" + path + "/vendor");
        }
        return Worktree {
            mutation_id: mutation_id, path: path, base_commit: base_commit,
            base_exec_digest: self.base_exec_digest, present: true
        };
    }
    @effects(is: { worktree_io })
    fn remove(mutation_id: String) -> Bool {
        let r = run_tool(
            "git\n-C\n" + self.repo + "\nworktree\nremove\n--force\n" + self.path_of(mutation_id),
        );
        if r.code != 0 { self.last_error = trim_nl(r.stderr); return false; }
        self.removed = self.removed + 1;
        return true;
    }
}

// ---- the repository --------------------------------------------------

// A Mutation's candidate is a branch of the genome (GH #1590): code, kept
// where code is, whatever its Review decides. The record names its commit
// (`mutation.committed`); the branch keeps the commit reachable after the
// worktree is gone. It travels as any branch does: a person pushes it.
const CANDIDATE_BRANCHES: String = "refs/heads/dna/candidate/";

fn candidate_ref(mutation_id: String) -> String { return CANDIDATE_BRANCHES + mutation_id; }

interface Repository {
    fn root() -> String; // the repository's path: what a harness must never reach (GH #583 M3)
    fn head(path: String) -> String;
    fn commit_all(path: String, message: String) -> String;
    // Keep a candidate reachable under the Mutation's name whatever the
    // review decides and whatever collects its worktree (#649): a branch
    // of the genome, `dna/candidate/<mutation>` (`candidate_ref`), and the
    // record names its commit (GH #1590).
    fn mark_candidate(mutation_id: String, commit: String) -> Bool;
    fn diff(path: String, base: String, candidate: String) -> String;
    fn contains(path: String, commit: String) -> Bool;
    fn apply(candidate: String) -> Bool;
    fn rollback(base: String) -> Bool;
    fn kind() -> String;
    // Why the last apply or rollback refused, in the words the record
    // keeps: "apply failed" alone told an operator nothing about which
    // of the destination's states stopped it.
    fn why() -> String;
    // What the destination has that the expression of `seed` from
    // `worktree` would read and the candidate's tree does not hold
    // ("" = clean): tracked modifications, and every input of the
    // CANDIDATE's build — its graph, not the destination's — that the
    // destination has untracked. `seed` empty asks about tracked
    // files alone. A build whose inputs cannot be inspected is dirt.
    fn dirty_for(seed: String, worktree: String) -> String;
}

// Local git. `apply` is the ONE method that changes the genome: it
// carries `genome_apply`, so the law can forbid every path to it
// except through the assembly's gate.
locus LocalGit {
    params {
        repo: String = ".";
        author: String = "dna <dna@local>";
        hale_bin: String = ""; // "" = HALE_BIN when set, else `hale` on PATH
        applied: Int = 0;
        last_error: String = "";
    }
    fn kind() -> String { return "local-git"; }
    fn why() -> String { return self.last_error; }
    fn root() -> String { return self.repo; }
    fn head(path: String) -> String {
        let r = run_tool("git\n-C\n" + path + "\nrev-parse\nHEAD");
        if r.code != 0 { self.last_error = trim_nl(r.stderr); return ""; }
        return trim_nl(r.stdout);
    }
    // Stage everything in `path` but `vendor/` and commit it; the
    // candidate's sha, or "". `vendor/` is the toolchain's copy that
    // `IsolatedWorktrees.open` puts in every worktree: a genome whose
    // committed `.gitignore` does not name it (`hale habitat graft`'s edit left
    // uncommitted) would otherwise carry the whole vendored tree in every
    // candidate. It is unstaged after `add -A` rather than excluded by a
    // pathspec, which git refuses when `vendor/` is already ignored.
    @effects(is: { repo_write })
    fn commit_all(path: String, message: String) -> String {
        let a = run_tool("git\n-C\n" + path + "\nadd\n-A");
        if a.code != 0 { self.last_error = trim_nl(a.stderr); return ""; }
        let v = run_tool("git\n-C\n" + path + "\nreset\n-q\n--\nvendor");
        if v.code != 0 { self.last_error = trim_nl(v.stderr); return ""; }
        let c = run_tool(
            "git\n-C\n" + path
                + "\n-c\nuser.name=dna\n-c\nuser.email=dna@local\ncommit\n-q\n--allow-empty\n-m\n"
                + message + "\n--author\n" + self.author,
        );
        if c.code != 0 { self.last_error = trim_nl(c.stderr); return ""; }
        return self.head(path);
    }
    fn mark_candidate(mutation_id: String, commit: String) -> Bool {
        let r = run_tool(
            "git\n-C\n" + self.repo + "\nupdate-ref\n" + candidate_ref(mutation_id) + "\n" + commit,
        );
        if r.code != 0 { self.last_error = trim_nl(r.stderr); return false; }
        return true;
    }
    fn diff(path: String, base: String, candidate: String) -> String {
        let r = run_tool("git\n-C\n" + path + "\ndiff\n" + base + "\n" + candidate);
        if r.code != 0 { self.last_error = trim_nl(r.stderr); return ""; }
        return r.stdout;
    }
    fn contains(path: String, commit: String) -> Bool {
        let r = run_tool("git\n-C\n" + path + "\nmerge-base\n--is-ancestor\n" + commit + "\nHEAD");
        return r.code == 0;
    }
    // A destination that carries uncommitted work of its own. A
    // fast-forward keeps such a change: the head would be the candidate
    // while the files the host builds from are not the candidate's, and
    // nobody reviewed the difference.
    //
    // What the CANDIDATE's build reads counts, not what git tracks and
    // not what the destination builds today. `hale check` reads the
    // directory, not the index; a build follows imports and reads
    // manifests and the C sources they declare. And the graph is the
    // candidate's: a reviewed change that adds `import "../lib"` makes
    // an untracked, unfinished `lib/helper.hl` an input the moment it
    // lands, though the destination's own graph never reached `lib`
    // (the fifth review round's finding 1). So the inputs are asked of
    // the compiler in the candidate's worktree (`hale inputs`), and any
    // file of the same kind that the destination has untracked in one
    // of those directories — or that the graph names outright — is
    // dirt; tracked modifications and deletions anywhere are dirt as
    // before. What no build reads — a binary, a log, another program's
    // source — is not. `seed` empty asks about tracked files alone;
    // `.hale/` never counts. A graph that cannot be inspected is dirt:
    // an inspection that failed authorises nothing (finding 4).
    fn dirty_for(seed: String, worktree: String) -> String {
        let r = run_tool("git\n-C\n" + self.repo + "\nstatus\n--porcelain");
        if r.code != 0 { return ""; }
        let mut out = "";
        let mut rest = trim_nl(r.stdout) + "\n";
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = if nl < 0 { rest } else { rest[0..nl] };
            if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
            if len(line) < 4 || line[0..2] == "??" { continue; }
            let what = line[3..len(line)];
            if what == ".hale" || std::str::starts_with(what, ".hale/") { continue; }
            out = out + line + "\n";
        }
        if len(seed) > 0 { out = out + self.candidate_inputs(seed, worktree); }
        return trim_nl(out);
    }
    // `untracked_inputs` for the seeds the candidate builds. A repository
    // organism's seed is its root, which holds no `.hl` of its own
    // (`hale inputs` finds nothing there): its build inputs are those of
    // the seeds that hold the files the candidate changes (`api/`), a
    // rename as both its names, so the seed a file leaves is read too. A
    // directory holding no `.hl` (`docs/`) builds nothing and is no seed.
    fn candidate_inputs(seed: String, worktree: String) -> String {
        if seed != "." || root_is_seed(worktree) { return self.untracked_inputs(seed, worktree); }
        let changed = changed_paths(worktree, self.head(self.repo), "HEAD");
        if changed.code != 0 {
            return "!! the candidate's changed files cannot be listed: " + trim_nl(changed.stderr)
                + "\n";
        }
        let mut out = "";
        let mut rest = seeds_of_files(worktree, trim_nl(changed.stdout), "\n");
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let s = if nl < 0 { rest } else { rest[0..nl] };
            if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
            if len(s) > 0 && s != "." && holds_source(worktree + "/" + s) {
                out = out + self.untracked_inputs(s, worktree);
            }
        }
        return out;
    }
    // The candidate's inputs that the destination has untracked, as
    // `?? <path>` lines: the graph is read in `worktree`, its
    // directories are looked at on the destination, and git names
    // the destination's untracked files unquoted, one per line.
    fn untracked_inputs(seed: String, worktree: String) -> String {
        let hale = resolve_toolchain(self.hale_bin);
        let dir = if seed == "." { worktree } else { worktree + "/" + seed };
        let ins = run_tool(hale + "\ninputs\n" + dir);
        if ins.code != 0 {
            return "!! the candidate's build inputs cannot be inspected (`hale inputs " + dir
                + "` exited " + to_string(ins.code) + "): " + trim_nl(ins.stderr) + "\n";
        }
        let wroot = trim_nl(
            run_tool("git\n-C\n" + worktree + "\nrev-parse\n--show-toplevel").stdout,
        );
        if len(wroot) == 0 {
            return "!! the candidate's worktree is not a repository: " + worktree + "\n";
        }
        // the graph, as directories and as files, relative to the tree
        let mut dirs = "\n";
        let mut files = "\n";
        let mut rest = trim_nl(ins.stdout) + "\n";
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let f = if nl < 0 { rest } else { rest[0..nl] };
            if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
            if len(f) == 0 || !std::str::starts_with(f, wroot + "/") { continue; }
            let rel = f[(len(wroot) + 1)..len(f)];
            files = files + rel + "\n";
            let sl = last_slash(rel);
            dirs = dirs + (if sl < 0 { "." } else { rel[0..sl] }) + "\n";
        }
        let others = run_tool(
            "git\n-C\n" + self.repo + "\n-c\ncore.quotePath=false\nls-files\n--others",
        );
        if others.code != 0 {
            return "!! the destination's untracked files cannot be listed: "
                + trim_nl(others.stderr) + "\n";
        }
        let mut out = "";
        let mut urest = trim_nl(others.stdout) + "\n";
        while len(urest) > 0 {
            let nl = std::str::index_of(urest, "\n");
            let u = if nl < 0 { urest } else { urest[0..nl] };
            if nl < 0 { urest = ""; } else { urest = urest[(nl + 1)..len(urest)]; }
            if len(u) == 0
                || std::str::starts_with(u, ".hale/")
                || std::str::starts_with(u, "vendor/")
            {
                continue;
            }
            let sl = last_slash(u);
            let udir = if sl < 0 { "." } else { u[0..sl] };
            let name = if sl < 0 { u } else { u[(sl + 1)..len(u)] };
            let named = std::str::contains(files, "\n" + u + "\n");
            let in_graph = std::str::contains(dirs, "\n" + udir + "\n");
            let kind = (len(name) > 3 && name[(len(name) - 3)..len(name)] == ".hl")
                || name == "hale.toml";
            if named || (in_graph && kind) { out = out + "?? " + u + "\n"; }
        }
        return out;
    }
    // Fast-forward the repository to the EXACT candidate, or fail.
    //
    // This used to fall back to a merge commit when the candidate was
    // not a descendant of HEAD. A merge composes a tree that is not the
    // reviewed candidate: a maintainer commit or a second proposal
    // landing during a review was enough, and the result was applied
    // with the reviewed candidate's name on it, unverified and unseen
    // (the shakeout's finding 2). A stale base is now a refusal, and
    // whoever wants the change makes a new candidate on the new base
    // and takes it through the whole gate.
    //
    // Git's exit status is not the guarantee, though, and the review's
    // second round found both ways it can lie. `merge --ff-only` keeps
    // an uncommitted edit to another file, and reports success. And a
    // head that advanced BEYOND the candidate between the caller's
    // check and this call makes `--ff-only <older>` "already up to
    // date" — success, with the genome on a commit nobody reviewed.
    // So the destination is checked here, immediately around the git
    // call, and the result is read back: applied means the genome IS
    // the candidate, tree and all.
    @effects(is: { genome_apply, repo_write })
    fn apply(candidate: String) -> Bool {
        let dirty = self.dirty_for("", "");
        if len(dirty) > 0 {
            self.last_error = "the genome has uncommitted changes; commit or stash them before an apply:\n"
                + dirty;
            return false;
        }
        let ff = run_tool("git\n-C\n" + self.repo + "\nmerge\n-q\n--ff-only\n" + candidate);
        if ff.code != 0 {
            self.last_error = "not a fast-forward onto " + self.head(self.repo) + ": "
                + trim_nl(ff.stderr);
            return false;
        }
        let now = self.head(self.repo);
        if now != candidate {
            self.last_error = "the genome is " + now + ", not the candidate " + candidate
                + ": it moved during the apply; propose again on the new base";
            return false;
        }
        let after = self.dirty_for("", "");
        if len(after) > 0 {
            self.last_error = "the genome's files are not the candidate's after the apply:\n"
                + after;
            return false;
        }
        self.applied = self.applied + 1;
        return true;
    }
    // Move the genome back to `base`, keeping the working tree's
    // untracked files; the applied commits stay reachable from the
    // Mutation's worktree, so the lineage loses nothing.
    @effects(is: { repo_write })
    fn rollback(base: String) -> Bool {
        let r = run_tool("git\n-C\n" + self.repo + "\nreset\n-q\n--keep\n" + base);
        if r.code != 0 { self.last_error = trim_nl(r.stderr); return false; }
        return true;
    }
}

// ---- the gateway: journaled, fenced -----------------------------------

type GateResult {
    ok: Bool = false;
    value: String = ""; // a path, a sha, a diff
    refused: String = ""; // why, when !ok
    replayed: Bool = false; // the effect had already been requested; result read from the Journal
}

// The Journal is not a param: the assembly owns the one Journal
// (GH #529 D4) and hands it to every gated operation as an argument,
// so the gateway journals in the SAME chain as everything else and
// cannot be wired with a private one.
locus MutationGateway {
    params {
        leases: Coordination = MemLeases { };
        workspaces: Workspaces = IsolatedWorktrees { };
        repo: Repository = LocalGit { };
        lease_ttl: Int = 600;
        refusals: Int = 0;
        namespace: String = ""; // GH #666: the owner whose claims these are ("" = the one owner)
    }
    fn lease_key(mutation_id: String) -> String { return "mutation:" + mutation_id; }
    fn head() -> String { return self.repo.head(self.workspaces.repo()); }
    fn head_of(path: String) -> String { return self.repo.head(path); }
    fn repo_path() -> String { return self.workspaces.repo(); }
    // The Attempt takes the Mutation's lease before touching it.
    fn take(mutation_id: String, holder: String, now: Int) -> Lease {
        return self.leases.acquire(self.lease_key(mutation_id), holder, now, self.lease_ttl);
    }
    // What the destination has uncommitted, for the caller's check
    // before an apply is requested at all.
    fn dirty(seed: String, worktree: String) -> String {
        return self.repo.dirty_for(seed, worktree);
    }
    fn refuse(why: String) -> GateResult {
        self.refusals = self.refusals + 1;
        return GateResult { refused: why };
    }
    // Open the Mutation's worktree at `base`. Idempotent per Mutation:
    // a retry finds the request journaled and re-reads the path.
    fn open(
        j: Journal,
        mutation_id: String,
        base_commit: String,
        token: Int,
        now: Int
    ) -> GateResult {
        if !lease_fences(self.leases, self.lease_key(mutation_id), token, now) {
            return self.refuse("stale or missing lease");
        }
        let key = "worktree.open:" + mutation_id;
        let fresh = effect_request(j, key, base_commit);
        if !fresh {
            let st = effect_status(j, key);
            if st.done && st.ok {
                return GateResult {
                    ok: true,
                    value: self.workspaces.path_of(mutation_id),
                    replayed: true,
                };
            }
            if st.unknown {
                return self.refuse(
                    "the outcome of " + key
                        + " is unknown after a restart; resolve it first (`hale dna effect resolve "
                        + key + " --outcome ok|failed`)",
                );
            }
            if st.done { return self.refuse("earlier open failed; not retried"); }
            // another request holds the claim and has no result yet (#635)
            return self.refuse("open in flight");
        }
        let wt = self.workspaces.open(mutation_id, base_commit);
        let r = effect_result(j, key, wt.present);
        if !wt.present { return self.refuse(wt.error); }
        let j = j.append(j.revision(), "mutation.worktree", mutation_id,
            "opened " + wt.path + " at " + base_commit + " expressed as " + wt.base_exec_digest);
        return GateResult { ok: true, value: wt.path };
    }
    // Commit the worktree's state as a candidate. `step` names the
    // commit within the Mutation, so each is its own idempotent effect.
    fn commit(
        j: Journal,
        mutation_id: String,
        step: String,
        message: String,
        token: Int,
        now: Int
    ) -> GateResult {
        return self.commit_key(j, mutation_id, step, message, mutation_id, token, now);
    }
    // Prepared source retains owner-qualified IDs under a Git-safe pointer.
    // The Record entity and native mutation routing remain the full ID.
    fn commit_prepared(
        j: Journal,
        mutation_id: String,
        step: String,
        message: String,
        candidate_key: String,
        token: Int,
        now: Int
    ) -> GateResult {
        if candidate_key != "source-" + hex_digest(mutation_id) {
            return self.refuse("invalid prepared candidate key");
        }
        return self.commit_key(j, mutation_id, step, message, candidate_key, token, now);
    }
    fn commit_key(
        j: Journal,
        mutation_id: String,
        step: String,
        message: String,
        candidate_key: String,
        token: Int,
        now: Int
    ) -> GateResult {
        if !lease_fences(self.leases, self.lease_key(mutation_id), token, now) {
            return self.refuse("stale or missing lease");
        }
        let key = "commit:" + mutation_id + ":" + step;
        let fresh = effect_request(j, key, message);
        if !fresh {
            let st = effect_status(j, key);
            if st.done && st.ok {
                return GateResult { ok: true, value: self.recorded(j, key), replayed: true };
            }
            if st.unknown {
                return self.refuse(
                    "the outcome of " + key
                        + " is unknown after a restart; resolve it first (`hale dna effect resolve "
                        + key + " --outcome ok|failed`)",
                );
            }
            if st.done { return self.refuse("earlier commit failed; not retried"); }
            return self.refuse("commit in flight");
        }
        let sha = self.repo.commit_all(self.workspaces.path_of(mutation_id), message);
        let r = effect_result(j, key, sha != "");
        if sha == "" { return self.refuse("commit failed"); }
        let kept = self.repo.mark_candidate(candidate_key, sha);
        let j = j.append(j.revision(), "mutation.candidate", mutation_id, sha);
        return GateResult { ok: true, value: sha };
    }
    // A prepared-source caller has proved this exact owned worktree's commit,
    // parent and complete tree through its source guard. Repair acknowledgments
    // of the already-claimed commit; this method NEVER creates another commit.
    fn recover_prepared_commit(
        j: Journal,
        mutation_id: String,
        step: String,
        candidate: String,
        candidate_key: String,
        token: Int,
        now: Int
    ) -> GateResult {
        if candidate_key != "source-" + hex_digest(mutation_id) {
            return self.refuse("invalid prepared candidate key");
        }
        if !lease_fences(self.leases, self.lease_key(mutation_id), token, now) {
            return self.refuse("stale or missing lease");
        }
        let key = "commit:" + mutation_id + ":" + step;
        let refreshed = j.refresh(); let st = effect_status(j, key);
        if !st.requested || (st.done && !st.ok && !st.unknown) {
            return self.refuse("no recoverable commit claim");
        }
        if len(candidate) == 0
            || self.repo.head(self.workspaces.path_of(mutation_id)) != candidate
        {
            return self.refuse("candidate moved during commit recovery");
        }
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == "mutation.candidate" && e.entity == mutation_id && e.body != candidate {
                return self.refuse("a different candidate was already recorded");
            }
            i = i + 1;
        }
        if !self.repo.mark_candidate(candidate_key, candidate) {
            return self.refuse("candidate pointer unavailable");
        }
        let mut tries = 0;
        while tries < 20 {
            let moved = j.refresh(); let revision = j.revision();
            let mut recorded = false; let mut k = 0;
            while k < revision {
                let e = j.read(k);
                if e.kind == "mutation.candidate" && e.entity == mutation_id {
                    if e.body != candidate {
                        return self.refuse("a different candidate was already recorded");
                    }
                    recorded = true;
                }
                k = k + 1;
            }
            if recorded { break; }
            let appended = j.append_exact(revision, "mutation.candidate", mutation_id, candidate);
            if !appended.ok && appended.error != "stale_revision" {
                return self.refuse("candidate acknowledgment pending");
            }
            tries = tries + 1;
        }
        if self.recorded(j, key) != candidate {
            return self.refuse("candidate acknowledgment pending");
        }
        let current = effect_status(j, key);
        if !(current.done && current.ok) {
            let completed = j.append_exact(
                j.revision(),
                "effect.result",
                key,
                "ok (exact prepared candidate recovered)",
            );
            if !completed.ok { return self.refuse("commit result acknowledgment pending"); }
        }
        return GateResult { ok: true, value: candidate, replayed: true };
    }
    // Apply the exact candidate to the repository. Keyed by the
    // candidate itself: a crashed and retried apply cannot commit twice.
    fn apply(
        j: Journal,
        mutation_id: String,
        candidate: String,
        token: Int,
        now: Int
    ) -> GateResult {
        if !lease_fences(self.leases, self.lease_key(mutation_id), token, now) {
            return self.refuse("stale or missing lease");
        }
        let key = effect_key(self.namespace, "apply", candidate);
        let fresh = effect_request(j, key, mutation_id);
        if !fresh {
            let st = effect_status(j, key);
            if st.done && st.ok {
                return GateResult { ok: true, value: candidate, replayed: true };
            }
            if st.unknown {
                return self.refuse(
                    "the outcome of " + key
                        + " is unknown after a restart; resolve it first (`hale dna effect resolve "
                        + key + " --outcome ok|failed`)",
                );
            }
            if st.done { return self.refuse("earlier apply failed; not retried"); }
            return self.refuse("apply in flight");
        }
        let ok = self.repo.apply(candidate);
        let r = effect_result(j, key, ok);
        if !ok { return self.refuse("apply failed: " + self.repo.why()); }
        let j = j.append(j.revision(), "mutation.applied", mutation_id, candidate);
        return GateResult { ok: true, value: candidate };
    }
    // Roll the genome back to the Mutation's base (GH #529 D6): the
    // observation window went badly, or the host could not express the
    // candidate. Idempotent per (Mutation, base), fenced like an apply.
    fn rollback(j: Journal, mutation_id: String, base: String, token: Int, now: Int) -> GateResult {
        if !lease_fences(self.leases, self.lease_key(mutation_id), token, now) {
            return self.refuse("stale or missing lease");
        }
        let key = "rollback:" + mutation_id + ":" + base;
        let fresh = effect_request(j, key, base);
        if !fresh {
            let st = effect_status(j, key);
            if st.done && st.ok { return GateResult { ok: true, value: base, replayed: true }; }
            if st.unknown {
                return self.refuse(
                    "the outcome of " + key
                        + " is unknown after a restart; resolve it first (`hale dna effect resolve "
                        + key + " --outcome ok|failed`)",
                );
            }
            if st.done { return self.refuse("earlier rollback failed; not retried"); }
            return self.refuse("rollback in flight");
        }
        let ok = self.repo.rollback(base);
        let r = effect_result(j, key, ok);
        if !ok { return self.refuse("rollback failed"); }
        let x = j.append(j.revision(), "mutation.rolled_back", mutation_id, base);
        return GateResult { ok: true, value: base };
    }
    // Remove the worktree (the Mutation dissolves; its history stays).
    fn remove(j: Journal, mutation_id: String, token: Int, now: Int) -> GateResult {
        if !lease_fences(self.leases, self.lease_key(mutation_id), token, now) {
            return self.refuse("stale or missing lease");
        }
        let ok = self.workspaces.remove(mutation_id);
        if !ok { return self.refuse("remove failed"); }
        let j = j.append(j.revision(), "mutation.worktree", mutation_id, "removed");
        return GateResult { ok: true };
    }
    // The last `mutation.candidate` body for the key's Mutation — the
    // sha a replayed commit returns.
    fn recorded(j: Journal, key: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == "mutation.candidate"
                && std::str::starts_with(key, "commit:" + e.entity + ":")
            {
                out = e.body;
            }
            i = i + 1;
        }
        return out;
    }
}

// A fixture clone's kept head DSN: `.hale/dna/memory.env`, the head's DSN
// alone, mode 600, where git ignores it (the clone's own exclude, so the
// fixture's tree is untouched). "" when written, else why not.
fn fixture_keep_head(repo: String, head_dsn: String) -> String {
    std::io::fs::mkdir(repo + "/.hale") or discard;
    std::io::fs::mkdir(repo + "/.hale/dna") or discard;
    // (a directory that is no repository has nothing to exclude it from)
    let excluded = run_tool(
        "sh\n-c\ncd \"$1\" && { git rev-parse --git-dir >/dev/null 2>&1 || exit 0; } && { git check-ignore -q .hale/dna/memory.env || { mkdir -p \"$(git rev-parse --git-path info)\" && echo /.hale/ >> \"$(git rev-parse --git-path info/exclude)\"; }; }\nsh\n"
            + repo,
    );
    if excluded.code != 0 { return "the clone could not ignore .hale/: " + excluded.stderr; }
    // the fixture's memory is the owner's, never a checkout's compose
    let kept = run_tool(
        "sh\n-c\numask 077 && printf '%s=%s\\n%s=owner\\n' \"$2\" \"$3\" \"$4\" > \"$1/.hale/dna/memory.env\" && chmod 600 \"$1/.hale/dna/memory.env\"\nsh\n"
            + repo + "\n" + HEAD_DSN_ENV + "\n" + head_dsn + "\n" + MEMORY_FROM_KEY,
    );
    if kept.code != 0 { return "the clone's memory.env could not be written: " + kept.stderr; }
    return "";
}

// ---- a fixture's record in memory (GH #1590) -------------------------------
//
// The record is memory's, so a fixture that builds a repository and reads
// or writes a record there gives it one first: `memory_fixture(repo)` pins
// a new identity in the repository's hale.toml, draws the roles' passwords
// and the record's key into the vault (`hale test`'s, one per file),
// applies memory's schema with the owner's DSN the suite hands the fixture
// (HALE_DNA_MEMORY_DSN_OWNER), keeps the head's DSN in the clone as `hale
// dna memory migrate` does (`.hale/dna/memory.env`, mode 600, ignored:
// every memory handle in it dials it when it is given no role's DSN), and
// appends the record's birth (`record.genesis`, `record.key`) as a graft
// does. "" when the
// record is born (or was, by an earlier call), else why not.
fn memory_fixture(repo: String) -> String {
    let owner_env = "HALE_DNA_MEMORY_DSN_OWNER";
    let owner = if std::env::var_exists(owner_env) { std::env::var(owner_env) } else { "" };
    let unnamed = owner_env
        + " is not set: a fixture's record is memory's, and there is no memory to keep it in";
    // a record already born is this one: born once, whoever asks again (a
    // process that reaches it needs no owner); a clone of its genome that
    // does not reach it yet keeps the head's DSN, as `hale dna memory
    // migrate` keeps it
    let pinned = record_scope(repo);
    if len(pinned) > 0 {
        if !std::io::fs::file_exists(repo + "/.hale/dna/memory.env") {
            if !std::str::starts_with(owner, "postgres") { return unnamed; }
            // a clone of a record memory holds: the head's DSN kept, and
            // memory left as it is (a migration rewrites the principals, and
            // one that names no owners drops a shared record's heads)
            let born = RecordJournal { repo: repo, dsn: owner, author: "dna" };
            let head = if born.revision() > 0 {
                dsn_text(role_dsn(parse_dsn(owner), head_role(pinned)))
            } else {
                ""
            };
            let again = if len(head) > 0 {
                Migrated { ok: true, head_dsn: head }
            } else {
                migrate(parse_dsn(owner), pinned)
            };
            if !again.ok { return "memory's schema: " + again.why; }
            let kept_here = fixture_keep_head(repo, again.head_dsn);
            if len(kept_here) > 0 { return kept_here; }
        }
        let held = RecordJournal { repo: repo, author: "dna" };
        if held.revision() > 0 { return ""; }
        return repo + "/hale.toml pins record " + pinned + ", and memory holds none of it: "
            + held.last_error();
    }
    if !std::str::starts_with(owner, "postgres") { return unnamed; }
    // the genome is not named: a fixture's last commit is amended with the
    // pin below, which would move a root commit the row named
    let has_head = run_tool("git\n-C\n" + repo + "\nrev-parse\n-q\n--verify\nHEAD").code == 0;
    let genome = "";
    let nonce = digest_of(
        repo + "\n" + to_string(std::process::pid()) + "\n"
            + to_string(std::time::nanos(std::time::current())),
    )[7..39];
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("genome", genome);
    b.string_field("nonce", nonce);
    b.end_object();
    let body = b.result();
    let id = event_digest("genesis", "record.genesis", "record", body);
    // the pin, in the manifest's `dna` table
    let manifest = repo + "/hale.toml";
    let text = std::io::fs::read_file(manifest) or "";
    let pinned = if std::str::starts_with(text, "[dna]\n") {
        "[dna]\nrecord = \"" + id + "\"\n" + text[6..len(text)]
    }
    else if std::str::contains(text, "\n[dna]\n") {
        std::str::replace(text, "\n[dna]\n", "\n[dna]\nrecord = \"" + id + "\"\n")
    }
    else {
        text + (if len(text) > 0 && !std::str::ends_with(text, "\n") { "\n" } else { "" })
            + "\n[dna]\nrecord = \"" + id + "\"\n"
    };
    let made = run_tool("mkdir\n-p\n" + repo);
    std::io::fs::write_file(manifest, pinned) or {
        return "the pin could not be written to " + manifest;
    };
    if record_scope(repo) != id {
        return "the pin in " + manifest + " does not read back as " + id;
    }
    // a genome with commits keeps the pin in its last commit, amended, as a
    // person commits what `init` wrote: the tree stays clean and the count
    // of commits the fixture sees is its own
    if has_head {
        let c = run_tool(
            "sh\n-c\ncd \"$1\" && git add hale.toml && git -c user.name=dna -c user.email=dna@local -c commit.gpgsign=false commit -q --amend --no-edit\nsh\n"
                + repo,
        );
        if c.code != 0 {
            return "the pin could not be committed: " + trim_nl(c.stderr) + trim_nl(c.stdout);
        }
    }
    // the vault's: the roles' passwords and the record's key
    let sch = schema_for(id);
    if len(provision_role(spine_role(id))) == 0 || len(provision_role(head_role(id))) == 0 {
        return "the vault could not hold the roles' passwords";
    }
    let key_vault = exchange_key_vault(sch);
    if !std::secret::Credential { vault: key_vault }.ready()
        && len(vault_provision_local(key_vault)) == 0
    {
        return "the vault could not hold the record's key";
    }
    let m = migrate(parse_dsn(owner), id);
    if !m.ok { return "memory's schema: " + m.why; }
    let kept_here = fixture_keep_head(repo, m.head_dsn);
    if len(kept_here) > 0 { return kept_here; }
    // the birth, as init writes it
    let j = RecordJournal { repo: repo, author: "dna", dsn: m.spine_dsn };
    let g = j.append_as(0, "record.genesis", "record", body, "dna", true);
    if !g.ok {
        return "memory refused the record's first row (" + g.error + "): " + j.last_error();
    }
    let k = std::json::Builder { };
    k.begin_object();
    k.string_field("key", record_key(sch).public());
    k.end_object();
    let r = j.append_as(1, "record.key", "record", k.result(), "dna", true);
    if !r.ok { return "memory refused the record's birth (" + r.error + "): " + j.last_error(); }
    return "";
}

// The spine's DSN for a fixture's record, from the owner's DSN the suite
// hands it: what a fixture's in-process organism writes its own Ledger rows
// with (`MemoryLedger { dsn_env: fixture_spine(repo) }`, a DSN in place of
// the name). Never kept on disk; "" when the record or the owner is missing.
fn fixture_spine(repo: String) -> String {
    let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") {
        std::env::var("HALE_DNA_MEMORY_DSN_OWNER")
    } else {
        ""
    };
    let id = record_scope(repo);
    if !std::str::starts_with(owner, "postgres") || len(id) == 0 { return ""; }
    return dsn_text(role_dsn(parse_dsn(owner), spine_role(id)));
}

// A fixture's process with a vault of its own (`HALE_VAULT_DIR=<dir>`)
// reaches the record's memory with the entries the fixture drew (GH
// #1590): the roles' passwords and the record's key, copied into `dir`,
// mode 600. "" when copied, else why not.
fn fixture_share_vault(repo: String, dir: String) -> String {
    let id = record_scope(repo);
    if len(id) == 0 { return repo + " pins no record"; }
    let names = role_vault_name(spine_role(id)) + " " + role_vault_name(head_role(id)) + " "
        + exchange_key_vault(schema_for(id));
    let r = run_tool(
        "sh\n-c\numask 077 && mkdir -p \"$2\" && chmod 700 \"$2\" && for n in $3; do [ -f \"$1/$n\" ] && cp \"$1/$n\" \"$2/$n\" && chmod 600 \"$2/$n\"; done; true\nsh\n"
            + std::secret::vault_local_dir() + "\n" + dir + "\n" + names,
    );
    return if r.code == 0 { "" } else { trim_nl(r.stderr) };
}

// A fixture's memory refusing every append for a while, to the record and
// to the Ledger through their insert functions (GH #1590): the owner
// revokes its roles' right to call them, and grants it back. "" when done,
// else why not.
fn fixture_record_refuses(repo: String, refusing: Bool) -> String {
    let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") {
        std::env::var("HALE_DNA_MEMORY_DSN_OWNER")
    } else {
        ""
    };
    let id = record_scope(repo);
    if !std::str::starts_with(owner, "postgres") || len(id) == 0 {
        return "no owner's DSN or no record to refuse";
    }
    let sch = schema_for(id);
    let verb = if refusing { "REVOKE" } else { "GRANT" };
    let dir = if refusing { "FROM" } else { "TO" };
    let fns = sch + ".record_append(bigint, text, text, text, text, text, text, text), " + sch
        + ".record_append_rows(bigint, text, text), " + sch
        + ".ledger_append(bigint, text, text, text, text, text, bigint, text)";
    let sql = verb + " EXECUTE ON FUNCTION " + fns + " " + dir + " " + spine_role(id) + ", "
        + head_role(id);
    let r = run_tool("psql\n" + owner + "\n-q\n-v\nON_ERROR_STOP=1\n-c\n" + sql);
    return if r.code == 0 { "" } else { trim_nl(r.stderr) };
}

// ---- a codebase's repository (phase 3) ----
// git is spelled here, in the workspace's file, not beside the codebase.

// A scratch clone of the codebase at its default branch: its path, or ""
// with why in `why`.
fn codebase_clone(c: Codebase) -> RunResult {
    let dir = scratch_root("codebase-" + c.name);
    let r = run_tool("git\nclone\n--quiet\n--no-checkout\n" + c.repo + "\n" + dir + "/clone");
    if r.code != 0 { scratch_done(dir); return RunResult { code: r.code, stderr: r.stderr }; }
    return RunResult { code: 0, stdout: dir };
}

// `git <args>` in the codebase's repository: where it is on this machine,
// else in a scratch clone that goes after.
fn codebase_git(c: Codebase, args: String) -> RunResult {
    if codebase_repo_local(c) { return run_tool("git\n-C\n" + c.repo + "\n" + args); }
    let cl = codebase_clone(c);
    if cl.code != 0 { return cl; }
    let r = run_tool("git\n-C\n" + cl.stdout + "/clone\n" + args);
    scratch_done(cl.stdout);
    return r;
}
