// dna/core/topics.hl — facts that cross a real boundary.
//
// Most transitions stay inside the owning locus and are read by the
// owner through `release(c)`. Topics exist only where a fact must
// cross an ownership tower, a placement, persistence, observation, or
// the external membrane (#521 "domain facts and topic families").

// Human/external intent entering the organism's membrane.
type IntentOffer { intent_id: String = ""; outcome: String = ""; from: String = ""; to: String = ""; }
topic IntentOffered { payload: IntentOffer; subject: "dna.intent.offered"; }

// A delegated child Task settled. Published by the Task pool owner
// (Metabolism) on behalf of the spawning Step, keyed by the PARENT
// task so only the waiting Step's tower hears it — supersystem
// mediation, not sibling chatter (H9).
type TaskSettlement {
    task_id: String = "";
    parent_task: String = "";
    spawning_step: String = "";
    disposition: String = "";
    detail: String = "";
}
topic TaskSettled { payload: TaskSettlement; subject: "dna.task.settled"; keyed_by parent_task; }

// Upward-only signals (child -> supersystem).
type Pressure { source: String = ""; what: String = ""; count: Int = 0; }
topic PressureRaised { payload: Pressure; subject: "dna.pressure.raised"; }

type Concern { source: String = ""; what: String = ""; severity: Int = 0; }
topic ConcernRaised { payload: Concern; subject: "dna.concern.raised"; }

// Review requests and verdicts cross the membrane (a human answers).
type ReviewRequest {
    review_id: String = "";
    question: String = "";
    subject_digest: String = ""; // exact candidate under review (TOCTOU pin)
    required_authority: String = "";
    // GH #566 F2: what a position deciding it needs — the mutation, its
    // class and disposition under the grant, the base to diff from, the
    // receipts (by digest) and the evidence line
    mutation_id: String = "";
    change_class: String = "";
    seed: String = ""; // the seed the change edits ("" = the genome's)
    disposition: String = "";
    base_commit: String = "";
    diff_text: String = "";
    evidence: String = "";
    magnitude: String = "";
}
topic ReviewRequested { payload: ReviewRequest; subject: "dna.review.requested"; }

type Verdict {
    review_id: String = "";
    subject_digest: String = ""; // must equal the request's, or the verdict is refused
    verdict: String = ""; // "approve" | "revise" | "reject" | "abstain"
    reviewer: String = "";
    authority: String = ""; // the authority the reviewer claims
    comment: String = "";
}
topic ReviewVerdict { payload: Verdict; subject: "dna.review.verdict"; keyed_by review_id; }

// A Review settled (or refused a verdict): the owning Review announces
// it, the assembly journals it. The decision stays with the Review;
// this is the record of it (GH #528 `hale dna status`).
type ReviewSettlement {
    review_id: String = "";
    outcome: String = ""; // "approve" | "revise" | "reject" | "" when a verdict was refused
    decided_by: String = "";
    refusal: String = ""; // non-empty when a verdict was refused, with the reason
    comment: String = ""; // the deciding verdict's comment: a person's note, a model's reasoning (GH #566 F7)
}
topic ReviewSettled { payload: ReviewSettlement; subject: "dna.review.settled"; }

// Work routed to the assembly-owned WorkSystem (F.3/F.4/F.5 in
// dna/FRICTION.md: a dynamic child cannot be handed an assembly
// implementation, so the implementations own the Attempts and the
// bus carries the request and the settlement, keyed by work id).
topic WorkRequested { payload: WorkRequest; subject: "dna.work.requested"; }

type WorkSettlement {
    work_id: String = "";
    disposition: String = "";
    result: String = "";
    attempts: Int = 0;
    history: String = ""; // "a0:human:declined a1:agent:done "
}
topic WorkDone { payload: WorkSettlement; subject: "dna.work.done"; keyed_by work_id; }

// A recorded model call (inside an Attempt; never a Work of its own):
// the evidence list from #521 comment 1. Published by the backend
// that made the call on `ModelCalled`; the assembly journals it.
type ModelEvidence {
    attempt_id: String = "";
    adapter: String = ""; // "openai-chat" | "local" | "fake"
    backend: String = ""; // the router-facing name ("quick", "deep", "private")
    endpoint: String = ""; // where the prompt went (never the credential)
    credential: String = ""; // the credential's fingerprint (a correlation handle), or ""
    requested_model: String = "";
    reported_model: String = ""; // what the endpoint said it ran
    params: String = ""; // decoding knobs as sent, "temperature=0.0 max_tokens=512"
    prompt_digest: String = "";
    context_digest: String = "";
    knowledge_bindings: String = ""; // ids of the bindings the context was assembled from
    tool_grant: String = ""; // tools offered on this call, "" when none
    response_digest: String = "";
    artifact_digest: String = ""; // digest of what the attempt produced from it, when known
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    elapsed: String = ""; // wall time of the call, as a Duration renders
    cost_micros: Int = 0;
    validation: String = ""; // what was checked on the response ("json", "schema:X", "")
    retry_of: String = ""; // the previous call in this attempt this one retries, or ""
    data_class: String = "";
    ok: Bool = false;
    refused: String = "";
}
topic ModelCalled { payload: ModelEvidence; subject: "dna.model.called"; }

// GH #529 D6: what became of the expression after an apply. The host
// (`hale dna run`) rebuilds and restarts on the organism's request,
// watches the observation window, and reports back on the membrane;
// the organism decides whether the Mutation is retained or rolled back.
type Observation {
    mutation_id: String = "";
    outcome: String = ""; // "healthy" | "crashed" | "build_failed"
    model_hash: String = ""; // the shape hash the restarted expression reports
    detail: String = "";
}
topic ExpressionObserved { payload: Observation; subject: "dna.expression.observed"; }
