// std::secret — the runtime half of GH #436.
//
// The compile-time half (`self.signer.key` is rejected) is pinned in
// `crates/hale-types/tests/std_secret.rs`. What can only be checked by
// running is the construction discipline: `birth` is the sole writer
// of the key, so a caller who tries to seed it directly gets nothing.
//
// Without that, the module's whole claim — "there is no construction
// site at which the caller held the material" — is false, because
// params are constructible by whoever holds the locus.

locus Seeded {
    params { s: std::secret::Signer = std::secret::Signer { key: b"hunter2" }; }
    fn ready() -> Bool { return self.s.ready(); }
    fn mac_len(m: Bytes) -> Int { return len(self.s.sign(m)); }
}

locus FromFile {
    params { s: std::secret::Signer = std::secret::Signer { key_file: "/nonexistent/key" }; }
    fn ready() -> Bool { return self.s.ready(); }
}

locus Unset {
    params { c: std::secret::Credential = std::secret::Credential { env_var: "" }; }
    fn ready() -> Bool { return self.c.ready(); }
    fn tag() -> String { return self.c.fingerprint(); }
    fn accepts(x: Bytes) -> Bool { return self.c.matches(x); }
}

// A `decode` transform fails CLOSED. A venue that issues a base64
// secret needs `decode: "base64"` so the key is the DECODED bytes; a
// signer pointed at such a credential without it keys under the text of
// the base64 and produces valid-looking MACs under the wrong key, which
// every private call then silently rejects. The transform's contract is
// that an UNAVAILABLE source (empty env here) or an UNRECOGNIZED
// transform yields an empty key and `ready() == false` — never a key
// that isn't the one the source names. (The positive path — real
// base64 in → decoded key out — needs an env var and is pinned in the
// Rust test.)
locus DecodeUnset {
    params { s: std::secret::Signer = std::secret::Signer { env_var: "", decode: "base64" }; }
    fn ready() -> Bool { return self.s.ready(); }
}

locus DecodeUnknown {
    params { s: std::secret::Signer = std::secret::Signer { env_var: "", decode: "rot13" }; }
    fn ready() -> Bool { return self.s.ready(); }
}

main locus App {
    params {
        seeded: Seeded = Seeded { };
        from_file: FromFile = FromFile { };
        unset: Unset = Unset { };
        decode_unset: DecodeUnset = DecodeUnset { };
        decode_unknown: DecodeUnknown = DecodeUnknown { };
    }
}

fn main() {
    let app = App { };

    // The load-bearing one: a key handed in at construction is
    // discarded, so the caller gains nothing by holding it.
    std::test::assert(
        !app.seeded.ready(),
        "a key passed at construction is ignored");

    // An unreadable source is empty, not a crash — a misconfigured
    // deployment reports at startup instead of signing under a
    // silently-empty key.
    std::test::assert(
        !app.from_file.ready(),
        "a missing key file yields an empty key");
    std::test::assert(
        !app.unset.ready(),
        "an unset env var yields an empty credential");

    // A signer with no key produces NO signature.
    //
    // The first version of this test asserted 32 here — pinning the
    // defect as the specification. An unavailable signer was happily
    // returning a valid HMAC under the EMPTY key, which `verify` then
    // accepted, so anyone could forge. `ready()` reporting false was
    // not enough, because nothing consulted it.
    std::test::assert_eq_int(
        app.seeded.mac_len(b"hello"), 0,
        "an unavailable signer does not sign");

    // Same rule for the correlation handle: no credential, no handle.
    // A fingerprint over the empty value is a constant that looks
    // like a real identifier.
    std::test::assert_eq_int(
        len(app.unset.tag()), 0,
        "an unavailable credential has no fingerprint");

    // The authentication bypass. With no credential loaded,
    // `self.value` was empty, `matches(b"")` took the zero-iteration
    // path, and `diff == 0` returned TRUE. Anyone presenting an empty
    // token authenticated against an unconfigured deployment.
    std::test::assert(
        !app.unset.accepts(b""),
        "an unavailable credential rejects the empty candidate");
    std::test::assert(
        !app.unset.accepts(b"anything"),
        "an unavailable credential rejects everything");

    // A `decode` over an unavailable source stays fail-closed.
    std::test::assert(
        !app.decode_unset.ready(),
        "a decode:base64 signer with no source is not ready");
    // An unrecognized transform fails closed rather than silently
    // falling back to the raw source bytes.
    std::test::assert(
        !app.decode_unknown.ready(),
        "an unknown decode transform yields no key");

}
