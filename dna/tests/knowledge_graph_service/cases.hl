// Actual Git receipts, native projection and the API's graph handler. Test
// doubles only inject concurrent source changes after the real store has
// captured its page.
//
// GH #985: the knowledge service is gone. What its read did in one process is
// two roles now: the spine projects the record into memory on its tick
// (`ops::MemoryProjection`, as the record's spine role), and the head reads
// (`api::graph_read`, as the record's head role). `GraphService` is the two of
// them over one fixture record, the way the host and the API run them.
import "../../core" as dna;
import "../../operations" as ops;
import "../../api" as api;
import "../../api/tests/fixture" as fixture;

fn request_json(r: api::GraphRequest) -> String {
    let b = std::json::Builder { };
    b.begin_object(); b.string_field("record_id", r.record_id); b.string_field("record_head", r.record_head);
    b.string_field("record_revision", r.record_revision); b.string_field("reader", r.reader); b.string_field("kind", r.kind);
    b.string_field("id", r.id); b.string_field("target", r.target); b.int_field("limit", r.limit);
    b.string_field("cursor", r.cursor); b.string_field("snapshot", r.snapshot); b.end_object();
    return b.result();
}

// A graph that supports no enumeration: the handler fails closed.
locus NoGraphStore {
    params { }
    fn projection_basis() -> dna::GraphProjection { return dna::GraphProjection { }; }
    fn graph_generation() -> Int { return -1; }
    fn read_graph(query: dna::GraphQuery, policy: dna::KnowledgeReadPolicy, sink: dna::GraphSink) -> dna::GraphPage {
        return dna::GraphPage { error: "knowledge_unsupported" };
    }
}

// The head reads through `reader`; the concurrent change is written as the
// spine (`writer`, `ledger`) or into the Record.
locus RacingGraph {
    params { reader: dna::Pq; writer: dna::Pq; record: dna::GitJournal; ledger: dna::PqLedger; mode: String; }
    fn projection_basis() -> dna::GraphProjection { return self.reader.projection_basis(); }
    fn graph_generation() -> Int { return self.reader.graph_generation(); }
    fn read_graph(q: dna::GraphQuery, policy: dna::KnowledgeReadPolicy, sink: dna::GraphSink) -> dna::GraphPage {
        let page = self.reader.read_graph(q, policy, sink);
        if self.mode == "generation" {
            let wrote = self.writer.upsert(dna::Idea { id: dna::digest_of("concurrent graph row"), text: "must retry" }, 0);
            std::test::assert(wrote, "concurrent graph fixture write");
        } else if self.mode == "record" {
            let wrote = self.record.append(self.record.revision(), "fixture.changed", "org", "concurrent Record write");
            std::test::assert(wrote.ok, "concurrent Record fixture write");
        } else {
            let wrote = self.ledger.append(self.ledger.revision(), "receipt.redacted", dna::digest_of("concurrent Ledger receipt"), "{}");
            std::test::assert(wrote.ok, "concurrent Ledger fixture write");
        }
        return page;
    }
}

// The spine's tick, then the head's read, as LocalKnowledge reads: the request
// parsed first, then the record and the store, scoped to the record's genesis.
locus GraphService {
    params {
        root: String = "";
        projector: ops::MemoryProjection = ops::MemoryProjection { dsn_env: "" };
        reader: dna::Pq = dna::Pq { };
        ledger: dna::PqLedger = dna::PqLedger { };
        j: dna::GitJournal = dna::GitJournal { repo: "/nonexistent/graph-service", author: "api" };
    }
    fn open_reader() -> Bool {
        self.j = dna::GitJournal { repo: self.root, author: "api" };
        let moved = self.j.refresh();
        self.reader.scope(self.j.genesis());
        self.ledger.scope(self.j.genesis());
        return self.reader.reopen() && self.ledger.open();
    }
    fn handle(body: String) -> std::http::Response {
        let applied = self.projector.apply();
        let http = api::GraphHttp { };
        let q = http.request(body);
        if !q.ok { return http.error(400, "invalid_query"); }
        if !self.open_reader() { return http.error(503, "knowledge_unavailable"); }
        let r = api::graph_read(q, self.reader, self.reader, self.j, self.ledger);
        self.reader.close();
        return r;
    }
    fn close() { self.projector.store.close(); self.reader.close(); self.ledger.conn.close(); }
}

// The stamp as a projector leaves it after `watermark` rows, the last of
// them `head`: for a graph a fixture writes by hand (GH #1026: a row and
// its stamp land together, so the fixture writes both).
fn stamp(store: dna::Pq, watermark: Int, head: String) -> Bool {
    return store.conn.exec("UPDATE knowledge_meta SET value = '" + to_string(watermark) + "' WHERE key = 'watermark'; UPDATE knowledge_meta SET value = '" + head + "' WHERE key = 'graph_projection_head'").ok;
}

// Empty the projection at the stamp it holds now.
fn rebuild_at_stamp(store: dna::Pq) -> Bool {
    let b = store.projection_basis();
    return b.ok && store.rebuild(b.watermark, b.head);
}

// Both roles over one fixture record, from the DSNs its migration handed back.
// The projector's record and receipts are built on the fixture's root: a
// GitJournal or GitReceipts reads the repository it was born with, and
// `root` alone reaches only their `repo` fields, after that birth.
fn graph_service(root: String, spine: dna::Dsn, head: dna::Dsn) -> GraphService {
    return GraphService {
        root: root,
        projector: ops::MemoryProjection { root: root, dsn_env: "", store: dna::Pq { conn: dna::pq_conn(spine) }, j: dna::GitJournal { repo: root, author: "spine" }, receipts: dna::GitReceipts { repo: root } },
        reader: dna::Pq { conn: dna::pq_conn(head) },
        ledger: dna::PqLedger { conn: dna::pq_conn(head) }
    };
}

locus GraphCases {
    params { f: fixture::Fixture; owner: String = ""; json: fixture::Json = fixture::Json { }; http: api::GraphHttp = api::GraphHttp { }; }
    fn query() -> api::GraphRequest {
        let moved = self.f.journal.refresh();
        // The interrupted-projection case rewinds its owned Record to model
        // a fence the Record no longer shows. A journal that already holds
        // rows refuses a shorter read (GH #748) and keeps the longer head,
        // so the request names what a reader opened now would see.
        let fresh = dna::GitJournal { repo: self.f.root };
        return api::GraphRequest { ok: true, record_id: self.f.identity, record_head: fresh.head(), record_revision: to_string(fresh.revision()), reader: "alice" };
    }
    // The fixture record's memory: its schema applied by the owner, the
    // spine's DSN handed back (the head's is `head()`).
    fn spine() -> dna::Dsn {
        let spine = dna::migrated(self.owner, self.f.identity);
        std::test::assert(spine.ok, "memory migrates for the fixture record: " + spine.why);
        return spine;
    }
    fn head() -> dna::Dsn {
        let head = dna::migrated_head(self.owner, self.f.identity);
        std::test::assert(head.ok, "the head's DSN for the fixture record: " + head.why);
        return head;
    }
    fn unmigrate() { std::test::assert_eq_str(dna::unmigrate(self.owner, self.f.identity), "", "the fixture record's schema and roles dropped"); }
    fn raw(service: GraphService, body: String) -> std::http::Response {
        return service.handle(body);
    }
    fn read(service: GraphService, q: api::GraphRequest, status: Int) -> String {
        let response = self.raw(service, request_json(q));
        std::test::assert_eq_int(response.status, status, response.body);
        std::test::assert(std::str::contains(response.headers, "no-store"), "graph response is never cached");
        let schema = if status != 200 { "ErrorResponse" } else if q.kind == "nodes" { "KnowledgeNodesResponse" } else if q.kind == "edges" { "KnowledgeEdgesResponse" } else { "KnowledgeBindingsResponse" };
        let checked = self.f.validator.validate(schema, response.body);
        std::test::assert(checked.ok, checked.error + "\n" + response.body);
        return response.body;
    }
    fn seed(text: String, target: String, lifecycle: String, supersedes: String) -> String {
        let doc = dna::knowledge_document(dna::Idea { kind: "practice", text: text, author: "org", provenance: "design", name: "native/" + text, supersedes: supersedes }, target);
        let id = "sha256:" + self.f.receipts.store(doc);
        self.f.append(lifecycle, id, "{\"class\":\"goal\"}");
        return id;
    }
    fn large_cached() {
        // This is a real graph read over a prebuilt native projection.
        // Cold receipt decoding still uses the legacy stdlib and is a separate
        // prerequisite; do not accidentally exercise it to prepare this case.
        let bytes = std::bytes::BytesBuilder { };
        let mut n = 0;
        while n < 600000 { bytes.append_u8(120); n = n + 1; }
        let text = std::str::clone(bytes.text_view());
        let document = "{\"kind\":\"practice\",\"text\":\"" + text + "\",\"author\":\"org\",\"target\":\"org\"}";
        let id = "sha256:" + self.f.receipts.store(document);
        self.f.append("knowledge.ratified", id, "{\"class\":\"goal\"}");
        let q = self.query();
        let spine = self.spine(); let head = self.head();
        let store = dna::Pq { conn: dna::pq_conn(spine), record_id: q.record_id };
        std::test::assert(store.open(), "large cached store open: " + store.last_error());
        std::test::assert(store.upsert(dna::Idea { id: id, kind: "practice", text: text, author: "org", provenance: "ratified", accepted: true, revision: 1 }, 1), "large cached native node");
        std::test::assert(store.bind(dna::KnowledgeBinding { idea: id, target: "org", author: "org", class: "goal" }), "large cached native binding");
        std::test::assert(stamp(store, self.f.journal.revision(), q.record_head), "large cached projection stamped at the record's head");
        let service = graph_service(self.f.root, spine, head);
        let response = self.raw(service, request_json(q));
        std::test::assert_eq_int(response.status, 200, "600k cached node read succeeds");
        std::test::assert(len(response.body) > 600000 && len(response.body) < 1048576, "large graph remains within the public wire budget");
        std::test::assert(self.http.syntax.valid(response.body), "large response is strict JSON");
        let first = self.json.first(response.body);
        let decoded = self.http.syntax.decode(self.json.raw(first, "text"));
        std::test::assert_eq_int(len(decoded), 600000, "large node retains every byte");
        std::test::assert_eq_str(decoded, text, "large node text round trips");
        std::test::assert_eq_int(self.json.integer(self.json.page(response.body), "returned"), 1, "large cached page count");
        let policy = ops::KnowledgeVisibility { record: self.f.journal, syntax: self.http.syntax };
        let captured = policy.load();
        std::test::assert(captured.available, "quote regression visibility");
        let items = api::GraphItems { policy: policy };
        let special = "quote\" slash\\ control\x01\x08\x0c\n\r\t café 🧭";
        let quoted = items.quote(special);
        let legacy = std::json::Builder { };
        std::test::assert_eq_str(quoted, legacy.quote(special), "graph quotes preserve existing wire bytes");
        std::test::assert(self.http.syntax.valid(quoted), "escaped Unicode/control text is strict JSON");
        std::test::assert_eq_str(self.http.syntax.decode(quoted), special, "escaped graph strings round trip");
        store.close(); service.close(); self.unmigrate();
    }
    // GH #1026: a row lands with its stamp in one transaction, so a projector
    // that dies inside a row leaves nothing of it, and the next projector
    // applies the row from the start.
    fn interrupted_projection() {
        let spine = self.spine(); let head = self.head();
        let store = dna::Pq { conn: dna::pq_conn(spine), record_id: self.f.identity };
        std::test::assert(store.open(), "the fixture's own store opens: " + store.last_error());
        let service = graph_service(self.f.root, spine, head);
        self.read(service, self.query(), 200);
        let clean = store.projection_basis();
        let id = self.seed("canonical completed text", "org", "knowledge.ratified", "");
        let target = self.query();
        std::test::assert_eq_int(store.begin_row(clean.watermark, clean.head, target.record_head), 1, "the row after the stamp is begun");
        std::test::assert(store.upsert(dna::Idea { id: id, kind: "practice", text: "partial uncommitted projection", author: "org", provenance: "ratified", accepted: true, revision: clean.watermark }, clean.watermark), "the row's first effect");
        // the projector dies inside the row: its connection goes, and the
        // row's transaction with it
        store.close();
        std::test::assert(store.reopen(), "the fixture's store reopens: " + store.last_error());
        std::test::assert(!store.idea(id).present, "nothing of the interrupted row landed");
        let after = store.projection_basis();
        std::test::assert(after.watermark == clean.watermark && after.head == clean.head, "the stamp stands where it was");
        let restarted = graph_service(self.f.root, spine, head);
        let recovered = self.read(restarted, self.query(), 200);
        self.json.eq(self.json.first(recovered), "text", "canonical completed text");
        std::test::assert(!std::str::contains(recovered, "partial uncommitted projection"), "the partial row never reaches a reader");
        std::test::assert_eq_str(store.projection_basis().head, target.record_head, "the next projector stamps the row's head");
        store.close(); service.close(); restarted.close(); self.unmigrate();
    }
    // A reconcile re-appends the local rows on top of the remote's head:
    // same rows, new digests, one remote row among them (GH #603). The
    // projection stamped before it must not refuse forever; it rebuilds.
    fn chain_rebuilt() {
        let spine = self.spine(); let head = self.head();
        let store = dna::Pq { conn: dna::pq_conn(spine), record_id: self.f.identity };
        std::test::assert(store.open(), "the fixture's own store opens: " + store.last_error());
        let service = graph_service(self.f.root, spine, head);
        let earlier = self.seed("an earlier practice", "org", "knowledge.ratified", "");
        let id = self.seed("a practice the reconcile keeps", "org", "knowledge.ratified", "");
        let first = self.read(service, self.query(), 200);
        self.json.eq(self.json.first(first), "text", "a practice the reconcile keeps");
        let stamped = store.projection_basis();
        std::test::assert(stamped.watermark > 1, "the projection is stamped past genesis");
        // rebuild the chain: keep everything before the last two rows, insert a
        // remote row, re-append the last two with their bodies unchanged
        let moved = self.f.journal.refresh();
        let n = self.f.journal.revision();
        std::test::assert(n >= 3, "genesis, then rows to rebuild: " + to_string(n));
        let r = self.f.journal.record;
        let mut chain = self.f.journal.read(n - 3).digest;
        chain = r.build(chain, dna::Row { kind: "instance.up", entity: "remote-0", body: "{}", author: "node" }, false, "");
        std::test::assert(len(chain) > 0, "the remote row builds");
        let mut i = n - 2;
        while i < n {
            let e = self.f.journal.read(i);
            chain = r.build(chain, dna::Row { kind: e.kind, entity: e.entity, body: e.body, author: self.f.journal.author_of(i) }, false, "Rebuilt-From: " + e.digest);
            std::test::assert(len(chain) > 0, "row " + to_string(i) + " re-appends");
            i = i + 1;
        }
        std::test::assert(r.move_chain("journal", chain, stamped.head), "the rebuilt chain is swapped in");
        let after = self.query();
        std::test::assert_eq_str(after.record_head, chain, "the record's head is the rebuilt chain's");
        let recovered = self.read(service, after, 200);
        self.json.eq(self.json.first(recovered), "text", "a practice the reconcile keeps");
        let rebuilt = store.projection_basis();
        std::test::assert_eq_str(rebuilt.head, chain, "the projection is stamped at the rebuilt head");
        std::test::assert_eq_int(rebuilt.watermark, n + 1, "and past every row of the rebuilt chain");
        store.close(); service.close(); self.unmigrate();
    }
    fn syntax() {
        // The head reads memory in-process (GH #985): no bearer to check. An
        // invalid request is refused before the Record or the store is read —
        // this child holds no head DSN, so a read that got that far would be
        // unavailable, not invalid.
        let absent = api::LocalKnowledge { root: "/no-such-graph-root" };
        let invalid = absent.read(api::KnowledgeRequest { source: api::Source { }, reader: "", kind: "nodes", query: api::KnowledgeQuery { } });
        std::test::assert(invalid.transport_ok && invalid.status == 400, "invalid request precedes source read: " + to_string(invalid.status));
        let valid = request_json(self.query());
        std::test::assert(self.http.request(valid).ok, "canonical request accepted");
        let duplicate = valid[0..(len(valid) - 1)] + ",\"reader\":\"mallory\"}";
        std::test::assert(!self.http.request(duplicate).ok, "duplicate reader rejected");
        std::test::assert(!self.http.request(std::str::replace(valid, "\"reader\"", "\"r\\u0065ader\"")).ok, "escaped key rejected");
        std::test::assert(!self.http.request(valid[0..(len(valid) - 1)] + ",\"actor\":\"mallory\"}").ok, "unknown key rejected");
        std::test::assert(!self.http.request(std::str::replace(valid, "\"limit\": 25", "\"limit\": 25.0")).ok, "integer JSON token required");
        std::test::assert(!self.http.request("{}").ok, "an empty request is invalid");
        let mut invalid_q = self.query(); invalid_q.record_revision = "01";
        std::test::assert(!self.http.request(request_json(invalid_q)).ok, "revision canonical");
        invalid_q = self.query(); invalid_q.reader = "alice\nother";
        std::test::assert(!self.http.request(request_json(invalid_q)).ok, "reader cannot contain controls");
        invalid_q = self.query(); invalid_q.limit = 101;
        std::test::assert(!self.http.request(request_json(invalid_q)).ok, "limit bounded");
        invalid_q = self.query(); invalid_q.cursor = "7b7d";
        std::test::assert(!self.http.request(request_json(invalid_q)).ok, "cursor requires snapshot");
        invalid_q = self.query(); invalid_q.snapshot = dna::digest_of("view"); invalid_q.cursor = "gg";
        std::test::assert(!self.http.request(request_json(invalid_q)).ok, "invalid hex cursor rejected");
        let mut unicode = self.query(); unicode.reader = "équipe 🧭";
        std::test::assert_eq_str(self.http.request(request_json(unicode)).reader, unicode.reader, "Unicode reader preserved");
    }
    fn exercise() {
        self.syntax();
        let secret = self.seed("SECRET-BODY", "org/secret", "knowledge.ratified", "");
        let a = self.seed("A <literal>\nsecond line", "org/finance", "knowledge.ratified", secret);
        let b = self.seed("B parent", "org", "knowledge.ratified", "");
        let c = self.seed("C proposal", "org/other", "knowledge.proposed", b);
        self.f.append("receipt.classified", secret, "{\"class\":\"confidential\"}");
        let spine = self.spine(); let head = self.head();
        // the fixture's own hands on memory, as the spine: direct graph
        // writes and the Ledger's adoption
        let store = dna::Pq { conn: dna::pq_conn(spine), record_id: self.f.identity };
        std::test::assert(store.open(), "the fixture's own store opens: " + store.last_error());
        let ledger = dna::PqLedger { conn: dna::pq_conn(spine), record_id: self.f.identity };
        std::test::assert(ledger.open(), "the fixture's own Ledger opens: " + ledger.last_error());
        let service = graph_service(self.f.root, spine, head);
        let before = self.f.refs();
        let mut q = self.query(); q.limit = 2;
        let first = self.read(service, q, 200);
        std::test::assert_eq_str(self.f.refs(), before, "graph reads do not write Record or receipt refs");
        std::test::assert_eq_int(store.count("ideas"), 4, "real projection includes all stored nodes");
        std::test::assert_eq_int(self.json.count(first), 2, "page contains two visible nodes");
        std::test::assert(!std::str::contains(first, secret) && !std::str::contains(first, "SECRET-BODY") && !std::str::contains(first, "total"), "no hidden labels, identifiers or totals");
        let snapshot = self.json.string(self.json.page(first), "snapshot");
        let cursor = self.json.string(self.json.page(first), "next_cursor");
        std::test::assert(!std::str::contains(self.http.unhex(cursor), secret), "cursor never includes a hidden identity");
        q.snapshot = snapshot; q.cursor = cursor;
        let last = self.read(service, q, 200);
        std::test::assert_eq_int(self.json.count(last), 1, "visible continuation contains the remaining node");
        self.json.is_bool(self.json.page(last), "has_more", false);
        std::test::assert(!std::str::contains(first, self.json.string(self.json.first(last), "id")), "continuation never repeats a visible row");
        // Reconciliation may replace a chain without changing its length or
        // genesis. A stale cached graph must not acquire the replacement head:
        // the projection is rebuilt from the replaced chain, and what it
        // serves is the replacement's, never the stale rows under a new head.
        let original = self.f.journal.head();
        let parent = self.f.git("rev-parse\n" + original + "^");
        let mut row = self.f.journal.record.row_of(original);
        row.body = "{\"class\":\"public\"}";
        let replacement = self.f.journal.record.build(parent, row, false, "replace classification for lineage regression");
        std::test::assert(len(replacement) > 0 && replacement != original, "same-length replacement built");
        std::test::assert(self.f.journal.record.move_chain("journal", replacement, original), "replace only owned fixture chain");
        let changed = self.query();
        std::test::assert_eq_str(changed.record_revision, q.record_revision, "replacement preserves revision count");
        let lineage = self.read(service, changed, 200);
        std::test::assert_eq_str(store.projection_basis().head, replacement, "the projection was rebuilt onto the replacement chain");
        std::test::assert(std::str::contains(lineage, "\"record_head\": \"" + replacement + "\""), "the read names the replacement head");
        std::test::assert(self.f.journal.record.move_chain("journal", original, replacement), "restore fixture chain");
        self.read(service, self.query(), 200);
        std::test::assert_eq_str(store.projection_basis().head, original, "and rebuilt again onto the restored chain");
        q.target = "org/finance"; self.read(service, q, 400);
        q = self.query(); q.id = secret;
        let hidden = self.read(service, q, 404);
        q.id = dna::digest_of("missing");
        std::test::assert_eq_str(self.read(service, q, 404), hidden, "missing and hidden nodes have identical responses");
        q = self.query(); q.target = "org/finance/child";
        let relevant = self.read(service, q, 200);
        std::test::assert_eq_int(self.json.count(relevant), 2, "accepted exact or ancestor bindings only");
        q.id = c; self.read(service, q, 404);
        q = self.query(); q.id = a;
        let detail = self.read(service, q, 200);
        self.json.eq(self.json.first(detail), "projection_state", "ratified");
        self.json.eq(self.json.first(detail), "text", "A <literal>\nsecond line");
        self.json.eq(self.json.first(detail), "supersedes", "");
        q.id = c;
        self.json.eq(self.json.first(self.read(service, q, 200)), "supersedes", b);
        q.id = a;
        std::test::assert_eq_str(self.json.raw(self.json.first(detail), "source_provenance"), "null", "lifecycle is not fabricated source provenance");
        std::test::assert(store.link(dna::KnowledgeEdge { from: a, to: b, rel: "supports" }), "native public edge");
        std::test::assert(store.link(dna::KnowledgeEdge { from: a, to: secret, rel: "SECRET-EDGE" }), "native private edge");
        std::test::assert(store.link(dna::KnowledgeEdge { from: secret, to: a, rel: "SECRET-INBOUND" }), "native private inbound edge");
        q.snapshot = self.json.string(self.json.page(detail), "snapshot"); self.read(service, q, 409);
        q = self.query(); q.kind = "edges"; q.id = a;
        let edges = self.read(service, q, 200);
        std::test::assert_eq_int(self.json.count(edges), 1, "both endpoints must be visible");
        self.json.eq(self.json.first(edges), "from_id", a); self.json.eq(self.json.first(edges), "to_id", b);
        std::test::assert(!std::str::contains(edges, secret) && !std::str::contains(edges, "SECRET"), "hidden edge endpoints and labels absent");
        q.kind = "bindings"; q.target = "org/finance/child";
        let binding = self.read(service, q, 200);
        self.json.eq(self.json.first(binding), "applicability", "ancestor");
        q.kind = "dependents";
        std::test::assert_eq_str(self.read(service, q, 200), binding, "dependents claim only the same stored binding coverage");
        q = self.query(); q.snapshot = snapshot; q.reader = "bob"; self.read(service, q, 409);
        q = self.query(); q.record_id = "different-record"; self.read(service, q, 503);
        q = self.query(); q.record_revision = "999"; self.read(service, q, 409);

        // A fresh projector over the real same Record must rebuild its
        // projection: the record's schema is the same one, emptied first.
        std::test::assert(rebuild_at_stamp(store), "the projection is emptied for a fresh projector");
        let restarted = graph_service(self.f.root, spine, head);
        let rebuilt = self.read(restarted, self.query(), 200);
        std::test::assert_eq_int(self.json.count(rebuilt), 3, "restart derives visible nodes from canonical receipts");
        restarted.close();
        std::test::assert(rebuild_at_stamp(store) && stamp(store, self.f.journal.revision(), ""), "a count with no head");
        let legacy = graph_service(self.f.root, spine, head);
        self.read(legacy, self.query(), 503);
        legacy.close();
        std::test::assert(store.rebuild(self.f.journal.revision(), ""), "the headless projection is emptied again");
        std::test::assert_eq_str(service.projector.apply().error, "", "and the record projected back into it");

        let exact = store.idea(a);
        let mut large = exact.idea; large.revision = 9007199254740993;
        std::test::assert(store.upsert(large, 9223372036854775807), "native Int64 values");
        q = self.query(); q.id = a;
        let integers = self.read(service, q, 200);
        self.json.eq(self.json.first(integers), "revision", "9007199254740993");
        self.json.eq(self.json.first(integers), "ratified_seq", "9223372036854775807");
        std::test::assert(service.open_reader(), "the head's reader opens");
        let generation_race = RacingGraph { reader: service.reader, writer: store, record: service.j, ledger: ledger, mode: "generation" };
        let raced = api::graph_read(self.query(), service.reader, generation_race, service.j, service.ledger);
        std::test::assert_eq_int(raced.status, 409, "graph generation fence rejects a mixed read");
        std::test::assert(service.open_reader(), "the head's reader opens");
        let record_race = RacingGraph { reader: service.reader, writer: store, record: service.j, ledger: ledger, mode: "record" };
        std::test::assert_eq_int(api::graph_read(self.query(), service.reader, record_race, service.j, service.ledger).status, 409, "Record fence rejects a mixed read");

        // The Ledger has an independently moving visibility head.
        let refreshed = self.f.journal.refresh();
        let checkpoint = self.f.journal.head();
        std::test::assert(ledger.cutover(checkpoint, 0, dna::ROUTING_VERSION), "adopt scoped Ledger");
        let adoption = std::json::Builder { }; adoption.begin_object(); adoption.int_field("routing", dna::ROUTING_VERSION); adoption.string_field("checkpoint", checkpoint); adoption.end_object();
        self.f.append("ledger.adopted", "org", adoption.result());
        q = self.query(); q.id = a;
        let adopted = self.read(service, q, 200);
        let adopted_basis = self.json.raw(self.json.data(adopted), "basis");
        self.json.eq(adopted_basis, "routing_version", "1");
        let hidden_row = ledger.append(ledger.revision(), "receipt.withheld", a, "{\"class\":\"customer\"}");
        std::test::assert(hidden_row.ok, "Ledger restriction");
        q.snapshot = self.json.string(self.json.page(adopted), "snapshot");
        self.read(service, q, 409);
        q.snapshot = ""; self.read(service, q, 404);
        std::test::assert(service.open_reader(), "the head's reader opens");
        let ledger_race = RacingGraph { reader: service.reader, writer: store, record: service.j, ledger: ledger, mode: "ledger" };
        std::test::assert_eq_int(api::graph_read(self.query(), service.reader, ledger_race, service.j, service.ledger).status, 409, "Ledger fence rejects a mixed read");
        self.f.append("person.retired", "alice", "{}");
        self.read(service, self.query(), 403);
        let orphan = NoGraphStore { };
        q = self.query(); q.reader = "bob";
        std::test::assert(service.open_reader(), "the head's reader opens");
        std::test::assert_eq_int(api::graph_read(q, service.reader, orphan, service.j, service.ledger).status, 503, "no enumeration implementation fails closed");

        // An oversized canonical object is refused from its pinned Git size
        // before a bounded projection transports, parses or embeds its body.
        // (A read no longer projects: the head reads what the spine's tick
        // applied, so the bounded projection is asked for here directly.)
        let bytes = std::bytes::BytesBuilder { };
        let mut i = 0;
        while i < 8193 { bytes.append_str("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"); i = i + 1; }
        let block = std::str::clone(bytes.text_view());
        let large_bytes = std::bytes::BytesBuilder { };
        i = 0;
        while i < 16 { large_bytes.append_str(block); i = i + 1; }
        let large_body = std::str::clone(large_bytes.text_view());
        std::test::assert(len(large_body) > 8388608, "regression crosses real projection byte budget");
        let oversized = "sha256:" + self.f.receipts.store(large_body);
        self.f.append("knowledge.proposed", oversized, "{}");
        let moved = service.projector.j.refresh();
        let bounded = service.projector.project(true);
        std::test::assert_eq_str(bounded.error, "knowledge_read_limit", "a bounded projection refuses the oversized receipt");
        std::test::assert(!store.idea(oversized).present, "oversized object was never projected");
        let record_limit = dna::MemJournal { };
        record_limit.rows.push(dna::Event { body: large_body });
        std::test::assert(!self.http.record_budget(record_limit), "Record byte guard precedes projection work");
        let blob = self.f.git("rev-parse\nrefs/dna/receipts/" + oversized[7..len(oversized)]);
        self.f.git("tag\n-a\ngraph-size-trap\n" + blob + "\n-m\nA small tag must not stand in for its large receipt blob");
        let tag = self.f.git("rev-parse\nrefs/tags/graph-size-trap");
        self.f.git("update-ref\nrefs/dna/receipts/" + oversized[7..len(oversized)] + "\n" + tag);
        let tagged = ops::GraphReceipts { source: self.f.receipts, remaining: 4096 };
        std::test::assert(tagged.read(oversized[7..len(oversized)]) == "" && tagged.error == "knowledge_projection_unavailable", "receipt must be a direct blob, never a size-checked tag over another object");

        let refs = self.f.refs();
        let limited = ops::GraphReceipts { source: self.f.receipts, remaining: 1 };
        std::test::assert(limited.read(a[7..len(a)]) == "" && limited.error == "knowledge_read_limit", "receipt metadata rejects before body read");
        std::test::assert(limited.store("never write") == "" && !limited.erase(a), "projection receipt adapter cannot mutate authority");
        std::test::assert_eq_str(self.f.refs(), refs, "bounded receipt adapter leaves all refs unchanged");
        store.close(); ledger.conn.close(); service.close(); self.unmigrate();
    }
}

// Run only in the explicit child branch of knowledge_store_test App.run.
// The parent owns the temporary directory and cleans it even on assertion exit.
fn run_cases(owner: String) {
    std::test::assert(std::env::var("HALE_GRAPH_SERVICE_TEST_CLEAN") == "1", "graph service cases require the isolated child");
    std::test::assert(!std::env::var_exists("HALE_DNA_MEMORY_DSN_SPINE") && !std::env::var_exists("HALE_DNA_MEMORY_DSN_HEAD") && !std::env::var_exists("GIT_DIR") && !std::env::var_exists("GIT_CONFIG_COUNT"), "graph child cannot inherit private database or Git overrides");
    let root = std::env::var("HALE_GRAPH_SERVICE_TEST_ROOT");
    std::test::assert(std::str::starts_with(root, "/tmp/hale-graph-service.") && len(root) > 24, "owned graph-service temporary directory");
    let f = fixture::Fixture { root: root, port: 1 };
    let cases = GraphCases { f: f, owner: owner };
    cases.exercise();
    let large = fixture::Fixture { root: root + "/large-cached", port: 1 };
    let large_cases = GraphCases { f: large, owner: owner };
    large_cases.large_cached();
    let interrupted = fixture::Fixture { root: root + "/interrupted-projection", port: 1 };
    let interrupted_cases = GraphCases { f: interrupted, owner: owner };
    interrupted_cases.interrupted_projection();
    let rebuilt = fixture::Fixture { root: root + "/chain-rebuilt", port: 1 };
    let rebuilt_cases = GraphCases { f: rebuilt, owner: owner };
    rebuilt_cases.chain_rebuilt();
}

// The child keeps the owner's DSN (it migrates its fixture records) and loses
// every role's: a role's DSN names one record, and the child makes its own.
fn run_isolated(owner: String) {
    let supplied = std::env::var("HALE_API_CONTRACT_ROOT");
    let source = std::env::var("HALE_DNA_SOURCE");
    let contract_root = if len(supplied) > 0 { supplied } else if len(source) > 0 { source + "/dna/api/contract/v1" } else { "dna/api/contract/v1" };
    std::test::assert(!std::str::contains(contract_root, "\n") && !std::str::contains(contract_root, "\r") && std::io::fs::file_exists(contract_root + "/schema.json"), "graph service contract root must resolve from explicit environment, HALE_DNA_SOURCE or repository working directory");
    let made = dna::run_tool("mktemp\n-d\n/tmp/hale-graph-service.XXXXXX");
    std::test::assert_eq_int(made.code, 0, made.stderr);
    let root = dna::trim_nl(made.stdout);
    let clean = dna::run_tool("env\n-u\nGIT_DIR\n-u\nGIT_COMMON_DIR\n-u\nGIT_CONFIG\n-u\nGIT_NAMESPACE\n-u\nGIT_WORK_TREE\n-u\nGIT_INDEX_FILE\n-u\nGIT_OBJECT_DIRECTORY\n-u\nGIT_ALTERNATE_OBJECT_DIRECTORIES\n-u\nGIT_CONFIG_COUNT\n-u\nGIT_CONFIG_PARAMETERS\n-u\nHALE_DNA_MEMORY_DSN_SPINE\n-u\nHALE_DNA_MEMORY_DSN_HEAD\n-u\nHALE_DNA_EVIDENCE_KEY\n-u\nHALE_DNA_OIDC_SECRET\nGIT_CONFIG_NOSYSTEM=1\nGIT_CONFIG_GLOBAL=/dev/null\nGIT_TERMINAL_PROMPT=0\nHALE_DNA_DISCOVER=off\nHALE_DNA_MEMORY_DSN_OWNER=" + owner + "\nHALE_GRAPH_SERVICE_TEST_CLEAN=1\nHALE_GRAPH_SERVICE_TEST_ROOT=" + root + "\nHALE_API_CONTRACT_ROOT=" + contract_root + "\n" + std::env::arg_or(0, "") + "\n--graph-service-cases");
    let removed = dna::run_tool("rm\n-rf\n" + root);
    std::test::assert_eq_int(removed.code, 0, "graph service fixture cleanup");
    std::test::assert_eq_int(clean.code, 0, "isolated graph service cases: " + clean.stderr + clean.stdout);
    std::test::assert_eq_str(clean.stdout, "", "graph service fixture stdout must be silent");
}
