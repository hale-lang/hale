    fn inactive_task(r: CommandReceipt) -> Bool {
        return r.task.state == "" && r.task.from == "" && r.task.to == "" && r.task.event_id == "";
    }
    fn inactive_task_create(r: CommandReceipt) -> Bool {
        let t = r.task_create;
        return t.intent_id == "" && t.intent_state == "" && t.task_id == "" && t.event_id == "";
    }
    // A create is admitted once its row is in the Record; the organism's
    // answer is a later fact. `born` alone names a Task.
    fn task_create_valid(r: CommandReceipt) -> Bool {
        let t = r.task_create; let source = ops::OrganizationCommandCodec { }; let codec = ops::TaskCreateCommandCodec { };
        if r.target_kind != "dna.record" || r.target_id != r.application_id || !self.bounded(r.subject_digest, 256, true, false)
            || r.proposal_state != "" || r.verdict_value != "" || r.verdict_state != "" || r.candidate_digest != "" || r.review_id != ""
            || r.review_state != "unavailable" || r.activation_state != "unknown" || r.activation_reason != "" { return false; }
        if t.intent_state == "unknown" { return r.state == "outcome_unknown" && t.intent_id == "" && t.task_id == "" && t.event_id == ""; }
        if t.intent_state != "requested" && t.intent_state != "offered" && t.intent_state != "refused" && t.intent_state != "born" { return false; }
        return r.state == "succeeded" && codec.intent_id_valid(t.intent_id) && source.commit_id(t.event_id) && (if t.intent_state == "born" { self.bounded(t.task_id, 256, true, false) } else { t.task_id == "" });
    }
    fn inactive_person(r: CommandReceipt) -> Bool {
        return r.person.state == "" && r.person.from == "" && r.person.to == "" && r.person.event_id == "" && r.person.transferred == -1;
    }
    fn person_valid(r: CommandReceipt) -> Bool {
        let p = r.person; let source = ops::OrganizationCommandCodec { };
        if r.target_kind != "dna.person" || !dna::digest_well_formed(r.subject_digest) || p.from != r.target_id
            || !self.bounded(p.to, 256, false, false) || p.from == p.to || r.proposal_state != "" || r.verdict_value != "" || r.verdict_state != ""
            || r.candidate_digest != "" || r.review_id != "" || r.review_state != "unavailable" || r.activation_state != "unknown" || r.activation_reason != "" { return false; }
        return if p.state == "applied" { r.state == "succeeded" && source.commit_id(p.event_id) && p.transferred >= 0 && p.transferred <= 32 && (p.transferred == 0 || p.to != "") }
        else { p.state == "unknown" && r.state == "outcome_unknown" && p.event_id == "" && p.transferred == -1 };
    }
    fn task_valid(r: CommandReceipt) -> Bool {
        let t = r.task; let source = ops::OrganizationCommandCodec { };
        if r.target_kind != "dna.task" || !dna::digest_well_formed(r.subject_digest)
            || !self.bounded(t.from, 256, true, false) || !self.bounded(t.to, 256, true, false) || t.from == t.to
            || r.proposal_state != "" || r.verdict_value != "" || r.verdict_state != "" || r.candidate_digest != "" || r.review_id != ""
            || r.review_state != "unavailable" || r.activation_state != "unknown" || r.activation_reason != "" { return false; }
        return if t.state == "applied" { r.state == "succeeded" && source.commit_id(t.event_id) }
        else { t.state == "unknown" && r.state == "outcome_unknown" && t.event_id == "" };
    }
    fn organization_valid(r: CommandReceipt) -> Bool {
        let o = r.organization; let codec = ops::OrganizationCommandCodec { };
        if r.target_kind != "dna.organization.module" || r.target_id != "dna/org/main.hl" || !dna::digest_well_formed(r.subject_digest)
            || r.proposal_state != "" || r.verdict_value != "" || r.verdict_state != "" || r.candidate_digest != ""
            || !codec.commit_id(o.source_head) || !dna::digest_well_formed(o.source_digest) || !self.bounded(o.mutation_id, 256, false, false)
            || (o.candidate_commit != "" && !codec.commit_id(o.candidate_commit)) || r.activation_state != "unknown" || r.activation_reason != "" { return false; }
        if o.proposal_state == "created" {
            if r.state != "succeeded" || o.mutation_id == "" || o.candidate_commit == "" || r.review_id != o.mutation_id { return false; }
        } else {
            if r.review_id != "" || o.candidate_commit != "" || r.review_state != "unavailable" || o.application_reason_code != "" { return false; }
            let expected = if o.proposal_state == "unknown" { "unknown" } else { "pending" };
            if o.application_state != expected || o.restart_handoff_state != expected { return false; }
            if o.proposal_state == "pending" { if r.state != "recorded" { return false; } }
            else if o.proposal_state == "refused" || o.proposal_state == "failed" { if r.state != "refused" { return false; } }
            else if o.proposal_state == "unknown" { if r.state != "outcome_unknown" { return false; } }
            else { return false; }
        }
        if o.application_state != "pending" && o.application_state != "applied" && o.application_state != "refused" && o.application_state != "declined" && o.application_state != "failed" && o.application_state != "unknown" { return false; }
        if o.restart_handoff_state != "pending" && o.restart_handoff_state != "requested" && o.restart_handoff_state != "unknown" { return false; }
        if o.restart_handoff_state == "requested" && o.application_state != "applied" { return false; }
        if o.application_state == "applied" || o.application_state == "refused" || o.application_state == "failed" {
            if r.review_state != "settled" || r.review_outcome != "approve" { return false; }
        }
        if o.application_state == "declined" && (r.review_state != "settled" || (r.review_outcome != "reject" && r.review_outcome != "revise")) { return false; }
        if o.application_state == "refused" {
            let codes = ops::OrganizationApplication { }; if !codes.refusal_code(o.application_reason_code) { return false; }
        } else if o.application_state == "failed" { if o.application_reason_code != "native_apply_failed" { return false; } }
        else if o.application_reason_code != "" { return false; }
        return true;
    }
    fn receipt_valid(context: CommandContext, command: CommandRequest, result: CommandResult, submitting: Bool) -> Bool {
        let r = result.receipt;
        if !result.ok || !result.source.ok || result.source.identity != context.source.identity || !self.bounded(result.source.head, 256, true, false) || result.source.revision < 0 { return false; }
        if r.application_id != context.source.identity || r.principal_mode != context.principal_mode || r.principal_name != context.principal_name || !self.bounded(r.principal_name, 256, true, false) || (r.principal_mode != "local" && r.principal_mode != "oidc") { return false; }
        if !self.known_operation(r.operation, r.operation_version) || r.position_id != "org" || r.request_id != command.request_id || !self.bounded(r.command_id, 256, true, false) || !self.bounded(r.fingerprint, 256, true, false) { return false; }
        if !self.bounded(r.target_id, 256, true, false) || !self.bounded(r.subject_digest, 256, true, false) { return false; }
        if submitting && (r.operation != command.operation || r.operation_version != command.operation_version || r.target_kind != command.target_kind || r.target_id != command.target_id || r.subject_digest != command.subject_digest) { return false; }
        if !self.bounded(r.reason, 2048, false, true) || !self.bounded(r.activation_reason, 2048, false, true) { return false; }
        if r.state != "recorded" && r.state != "admitted" && r.state != "running" && r.state != "succeeded" && r.state != "refused" && r.state != "failed" && r.state != "outcome_unknown" { return false; }
        let practice = r.operation == "dna.practice.propose"; let organization = r.operation == "dna.organization.propose"; let task = r.operation == "dna.task.reassign";
        let person = r.operation == "dna.person.retire"; let create = r.operation == "dna.task.create";
        let attempt = std::str::starts_with(r.operation, "dna.attempt.") || r.operation == "dna.friction.file";
        if !attempt && !self.inactive_attempt(r) { return false; }
        if !person && !self.inactive_person(r) { return false; }
        if !task && !self.inactive_task(r) { return false; }
        if !organization && !self.inactive_organization(r) { return false; }
        if !create && !self.inactive_task_create(r) { return false; }
        if attempt {
            if !self.attempt_valid(r) { return false; }
            if submitting && (r.attempt.holder != if r.operation == "dna.attempt.claim" || r.operation == "dna.friction.file" { command.performer } else { command.holder }) { return false; }
        } else if create {
            if !self.task_create_valid(r) { return false; }
        } else if person {
            if !self.person_valid(r) || (submitting && r.person.to != command.new_assignee) { return false; }
        } else if task {
            if !self.task_valid(r) || (submitting && (r.task.from != command.expected_assignee || r.task.to != command.new_assignee)) { return false; }
        } else if organization {
            if !self.organization_valid(r) { return false; }
            if submitting && (r.organization.source_head != command.source_head || r.organization.source_digest != dna::digest_of(command.source_text)) { return false; }
        } else if practice {
            if r.target_kind != "dna.practice" || r.target_id != r.subject_digest || len(r.verdict_value) > 0 || len(r.verdict_state) > 0 { return false; }
            if r.proposal_state != "pending" && r.proposal_state != "created" && r.proposal_state != "refused" && r.proposal_state != "unknown" { return false; }
            if !self.bounded(r.candidate_digest, 256, false, false) || !self.bounded(r.review_id, 256, false, false) { return false; }
            if r.proposal_state == "created" && (len(r.candidate_digest) == 0 || len(r.review_id) == 0) { return false; }
            if (r.state == "succeeded" && r.proposal_state != "created") || (r.state == "refused" && r.proposal_state != "refused") { return false; }
        } else {
            if r.target_kind != "dna.review" || len(r.proposal_state) > 0 || len(r.candidate_digest) > 0 || len(r.review_id) > 0 || !self.verdict_value(r.verdict_value) { return false; }
            if r.verdict_state != "pending" && r.verdict_state != "accepted" && r.verdict_state != "refused" && r.verdict_state != "unknown" { return false; }
            if submitting && r.verdict_value != command.verdict { return false; }
            if (r.state == "succeeded" && r.verdict_state != "accepted") || (r.state == "refused" && r.verdict_state != "refused") { return false; }
        }
        if r.review_state == "unavailable" {
            if len(r.review_outcome) > 0 || len(r.review_subject_digest) > 0 { return false; }
        } else if r.review_state == "pending" || r.review_state == "settled" {
            if practice && r.proposal_state != "created" { return false; }
            if r.review_subject_digest != if organization { r.organization.candidate_commit } else if practice { r.candidate_digest } else { r.subject_digest } { return false; }
            if r.review_state == "pending" && len(r.review_outcome) > 0 { return false; }
            if r.review_state == "settled" && r.review_outcome != "approve" && r.review_outcome != "reject" && r.review_outcome != "revise" && r.review_outcome != "abstain" { return false; }
        } else { return false; }
        if r.activation_state != "unknown" && r.activation_state != "pending" && r.activation_state != "adopted" && r.activation_state != "refused" { return false; }
        if r.activation_state == "adopted" && (r.review_state != "settled" || r.review_outcome != "approve") { return false; }
        return true;
    }
    fn receipt_json(r: CommandReceipt) -> String {
        let b = std::json::Builder { }; b.begin_object();
        b.string_field("command_id", r.command_id); b.string_field("request_id", r.request_id); b.string_field("application_id", r.application_id);
        b.string_field("operation", r.operation); b.string_field("operation_version", r.operation_version);
        b.begin_object_field("principal"); b.string_field("mode", r.principal_mode); b.string_field("name", r.principal_name); b.end_object();
        b.begin_object_field("context"); b.string_field("application_id", r.application_id); b.string_field("position_id", r.position_id); b.end_object();
        b.begin_object_field("target"); b.string_field("application_id", r.application_id); b.string_field("kind", r.target_kind); b.string_field("id", r.target_id); b.end_object();
        b.string_field("subject_digest", r.subject_digest); b.string_field("fingerprint", r.fingerprint); b.string_field("state", r.state); b.string_field("reason", r.reason);
        if r.operation == "dna.person.retire" {
            let p = r.person; b.begin_object_field("person"); b.string_field("state", p.state); b.field("from", dna::record_json_quote(p.from)); b.field("to", dna::record_json_quote(p.to));
            b.string_field("event_id", p.event_id); b.string_field("transferred", if p.transferred < 0 { "" } else { to_string(p.transferred) }); b.end_object();
        } else if r.operation == "dna.task.reassign" {
            let t = r.task; b.begin_object_field("task"); b.string_field("state", t.state); b.string_field("from", t.from); b.string_field("to", t.to); b.string_field("event_id", t.event_id); b.end_object();
        } else if r.operation == "dna.task.create" {
            let t = r.task_create; b.begin_object_field("task_create"); b.string_field("intent_id", t.intent_id); b.string_field("intent_state", t.intent_state); b.string_field("task_id", t.task_id); b.string_field("event_id", t.event_id); b.end_object();
        } else if std::str::starts_with(r.operation, "dna.attempt.") || r.operation == "dna.friction.file" {
            let a = r.attempt; b.begin_object_field("attempt"); b.string_field("state", a.state); b.string_field("attempt_id", a.attempt_id); b.string_field("work_id", a.work_id);
            b.string_field("task_id", a.task_id); b.string_field("performer_kind", a.performer_kind); b.string_field("holder", a.holder);
            b.string_field("token", if a.token < 0 { "" } else { to_string(a.token) }); b.string_field("until", to_string(a.until)); b.string_field("disposition", a.disposition);
            b.string_field("reason", a.reason); b.string_field("event_id", a.event_id); b.end_object();
        } else if r.operation == "dna.practice.propose" {
            b.begin_object_field("proposal"); b.string_field("state", r.proposal_state); b.string_field("candidate_digest", r.candidate_digest); b.string_field("review_id", r.review_id); b.end_object();
        } else if r.operation == "dna.organization.propose" {
            let o = r.organization; b.begin_object_field("organization");
            b.string_field("proposal_state", o.proposal_state); b.string_field("source_head", o.source_head); b.string_field("source_digest", o.source_digest);
            b.string_field("mutation_id", o.mutation_id); b.string_field("candidate_commit", o.candidate_commit);
            b.string_field("application_state", o.application_state); b.string_field("application_reason_code", o.application_reason_code); b.string_field("restart_handoff_state", o.restart_handoff_state); b.end_object();
        } else {
            b.begin_object_field("verdict"); b.string_field("value", r.verdict_value); b.string_field("state", r.verdict_state); b.end_object();
        }
        b.begin_object_field("review"); b.string_field("state", r.review_state); b.string_field("outcome", r.review_outcome); b.string_field("subject_digest", r.review_subject_digest); b.end_object();
        b.begin_object_field("activation"); b.string_field("state", r.activation_state); b.string_field("reason", r.activation_reason); b.end_object();
        b.end_object(); return b.result();
    }
    fn error(code: String) -> std::http::Response {
        let http = Http { };
        if code == "invalid_command" { return http.error(400, code, "invalid command fields, values, or required headers", false); }
        if code == "invalid_query" { return http.error(400, code, "lookup requires exactly one request_id", false); }
        if code == "unauthenticated" { return http.error(401, code, "sign in at /auth/login", false); }
        if code == "forbidden" { return http.error(403, code, "this command operation is not authorized", false); }
        if code == "invalid_origin" { return http.error(403, code, "the command origin is not permitted", false); }
        if code == "command_context_changed" { return http.error(409, code, "the authenticated principal changed; review the command under the current identity", false); }
        if code == "stale_subject" { return http.error(409, code, "the selected subject is no longer eligible; load its current state", false); }
        if code == "request_conflict" { return http.error(409, code, "this request identity belongs to different command content", false); }
        if code == "command_not_found" { return http.error(404, code, "no visible command was found for this request identity", false); }
        if code == "command_too_large" { return http.error(413, code, "the command body exceeds the supported byte limit", false); }
        if code == "unsupported_media_type" { return http.error(415, code, "commands require Content-Type application/json", false); }
        if code == "commands_unsupported" { return http.error(503, code, "this application does not configure command submission", false); }
        return http.error(503, "commands_unavailable", "the command result is unavailable; retain the request identity for lookup", true);
    }
    fn response(context: CommandContext, command: CommandRequest, result: CommandResult, submitting: Bool) -> std::http::Response {
        if !result.ok { return self.error(result.code); }
        if !self.receipt_valid(context, command, result, submitting) { return self.error("commands_unavailable"); }
        let http = Http { };
        let mut response = http.success(result.source, self.receipt_json(result.receipt));
        let state = result.receipt.state;
        if submitting && state != "succeeded" && state != "refused" && state != "failed" { response.status = 202; }
        return response;
    }
}

// The typed request as the operations' command, for the attempt codec's
// own rules (GH #946); the provider maps the same fields.
fn attempt_native(command: CommandRequest) -> ops::GovernanceCommand {
    return ops::GovernanceCommand {
        request_id: command.request_id, operation: command.operation, operation_version: command.operation_version,
        application_id: command.application_id, position_id: command.position_id, target_kind: command.target_kind, target_id: command.target_id,
        subject_digest: command.subject_digest, record_head: command.record_head,
        performer_kind: command.performer_kind, performer: command.performer, effect_class: command.effect_class, capabilities: command.capabilities, data_classes: command.data_classes,
        organizations: command.organizations, ttl: command.ttl, attempt_id: command.attempt_id, holder: command.holder, token: command.token,
        disposition: command.disposition, result: command.result, result_ref: command.result_ref, narrative: command.narrative,
        evidence: command.evidence, receipts: command.receipts,
        hat_digest: command.hat_digest, hat_head: command.hat_head, hat_watermark: command.hat_watermark, prompt_digest: command.prompt_digest, renderer: command.renderer
    };
}
