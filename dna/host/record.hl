// dna/host/record.hl — the record as the host reads and writes it
// (GH #566 F8). The record's API is the core's `dna::Record` (GH #646
// stage 0, #649): the Journal is its `journal` chain and receipts are its
// bodies. The record is memory's (GH #1590): every clone and body reads
// and writes the one record there, so nothing of it travels by git and
// nothing here syncs it. The host appends in a person's or a node's name
// and reads receipts by digest. Nothing here decides, and nothing here
// spells the store: the one implementation is `dna::MemoryRecord`.

import "../core" as dna;
import "../organization_runtime" as org_runtime;

const JOURNAL: String = "journal";

// The record at `root`, as the core implements it over memory.
fn rec(root: String) -> dna::MemoryRecord {
    return dna::MemoryRecord { repo: root };
}

// write_file as a Bool, so a caller can act on failure.
fn write_text(path: String, text: String) -> Bool fallible(IoError) {
    std::io::fs::write_file(path, text) or raise;
    return true;
}

fn record_head(root: String) -> dna::Head {
    let authority = org_runtime::HostAuthority { root: root };
    return authority.record_head();
}

// The genome's remote, its forge (`dna.remote`, else `origin`; "" when the
// repository has none): what revisions and candidates travel to and from.
fn genome_remote(repo: String) -> String {
    return rec(repo).remote();
}

// GH #604 rule 6: the admission boundary for record-originated rows.
// `dna.trust` is `local` (default: every writer to the record is
// trusted, the operator's profile) or `signed` (a relayed row is admitted
// only when it carries a signature the record's trust verifies: the
// record's key for the organism's parts, a key the record enrolled for a
// person — `hale dna signers`, GH #1590).
fn trust_mode(root: String) -> String {
    let authority = org_runtime::HostAuthority { root: root };
    return authority.trust();
}

// GH #664: the organization this clone's body is (`git config dna.owner`,
// the name of its `organization` node, GH #1123), "" when unnamed.
fn owner_here(root: String) -> String {
    let authority = org_runtime::HostAuthority { root: root };
    return authority.owner();
}
// Whether this body is one of a shared record's: it names its organization.
fn shared_here(root: String) -> Bool {
    let authority = org_runtime::HostAuthority { root: root };
    return authority.shared();
}
// GH #1123: the graph's ownership, read from memory as the head reads it
// (the spine's DSN where no head's is named); "" when no memory is named or
// it does not answer — one owner, or, for a body that names its
// organization, nothing it may admit.
fn ownership_graph_here(root: String) -> String {
    // one owner — the record states no organization and this body names
    // none — asks memory nothing
    if len(owner_here(root)) == 0 && len(organizations_in_record(root)) == 0 { return ""; }
    let env = if dna::dsn_set(dna::HEAD_DSN_ENV) {
        dna::HEAD_DSN_ENV
    } else if dna::dsn_set(dna::SPINE_DSN_ENV) {
        dna::SPINE_DSN_ENV
    } else {
        ""
    };
    if len(env) == 0 { return ""; }
    let store = dna::Pq { dsn_env: env };
    store.scope(dna::record_scope(root));
    if !store.reopen() { return ""; }
    let graph = store.graph_ownership();
    store.close();
    return graph;
}
// GH #1123: the organizations the record states — `graph.node` rows of
// kind `organization`, less the retired — read from the record itself,
// the membership's source, so a shared record is known as one with no
// memory at all.
fn organizations_in_record(root: String) -> String {
    let j = dna::RecordJournal { repo: root };
    let mut out = "";
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if std::str::starts_with(e.entity, "organization:") && !std::str::contains(e.entity, "|") {
            let name = e.entity[13..len(e.entity)];
            if e.kind == "graph.node" { out = dna::word_add(out, name); }
            if e.kind == "graph.retired" {
                let mut kept = "";
                let mut k = 0;
                while len(dna::nth_word(out, k)) > 0 {
                    if dna::nth_word(out, k) != name {
                        kept = dna::word_add(kept, dna::nth_word(out, k));
                    }
                    k = k + 1;
                }
                out = kept;
            }
        }
        i = i + 1;
    }
    return out;
}
// GH #989: the application the record attaches, by the name its broker
// account carries — `application.attached`'s `name`, or for a row written
// before it named one, the project's directory, as `hale habitat graft` names
// it — and "" when none is attached or an `application.detached` row
// removed it. The record is the membership source.
fn attached_application(root: String) -> String {
    let j = dna::RecordJournal { repo: root };
    let mut name = "";
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "application.attached" {
            let named = std::json::find_string_field(e.body, "name");
            name = dna::nerves_app_name(
                if len(named) > 0 { named } else { project_dir_name(root) },
            );
        }
        if e.kind == "application.detached"
            && dna::nerves_app_name(std::json::find_string_field(e.body, "name")) == name
        {
            name = "";
        }
        i = i + 1;
    }
    return name;
}
// The last segment of the project's directory, resolved.
fn project_dir_name(root: String) -> String {
    let r = dna::run_tool("sh\n-c\nbasename \"$(cd \"$1\" && pwd -P)\"\nsh\n" + root);
    return if r.code == 0 { dna::trim_nl(r.stdout) } else { "" };
}
// Every organization the graph names, as memory projects it.
fn owners_here(root: String) -> String {
    let o = dna::Ownership { graph: ownership_graph_here(root), me: owner_here(root), me_env: "" };
    return o.owners();
}
// Whether a body here admits an intent for `to` — always with one owner,
// only for this organization's positions over a shared record.
fn admits_here(root: String, to: String) -> Bool {
    let o = dna::Ownership { graph: ownership_graph_here(root), me: owner_here(root), me_env: "" };
    return o.admits(to);
}
fn owner_of_person_here(root: String, who: String) -> String {
    let o = dna::Ownership { graph: ownership_graph_here(root), me: owner_here(root), me_env: "" };
    return o.owner_of_person(who);
}
fn ownership_note(root: String, to: String) -> String {
    let o = dna::Ownership { graph: ownership_graph_here(root), me: owner_here(root), me_env: "" };
    return o.why_not(to);
}

fn row_verified(root: String, sha: String) -> Bool {
    let authority = org_runtime::HostAuthority { root: root };
    return authority.row_verified(sha);
}

fn short(s: String) -> String {
    if len(s) > 12 { return s[0..12]; }
    return s;
}

fn shape_of(path: String) -> String {
    let t = std::io::fs::read_file(path) or "";
    return std::json::find_string_field(t, "shape_hash");
}

// The receipt filed under a digest, or absent.
type Receipt {
    present: Bool = false;
    text: String = "";
}

fn receipt_read(repo: String, digest: String) -> Receipt {
    let k = rec(repo).body(digest);
    if !k.present { return Receipt { }; }
    return Receipt { present: true, text: k.text };
}

// The last non-empty line of a text.
fn last_line(text: String) -> String { return dna::last_line(text); }

fn count_lines(text: String) -> Int { return dna::count_lines(text); }

// The rows at a row id ("" for none), newline-terminated.
fn journal_text_at(repo: String, commit: String) -> String {
    return rec(repo).text_at(commit);
}

// The `memory:` line of status: which memories the organism has.
fn routing_line(root: String, memory: dna::Memory) -> String {
    let sl = memory.leases;
    let probe = sl.current(store_lease_key(root));
    let reach = if sl.reachable {
        ""
    } else {
        "; THE LEDGER IS UNREACHABLE (" + sl.last_error
            + "): what is read here is the last projection, and nothing is admitted until it answers"
    };
    return "record + ledger (operations and leases live in memory" + reach + ")";
}

// An operational row goes to the Ledger, never into
// the record itself (#646 decision 3), written straight in by this
// process under its own role (GH #1026).
fn ledger_append(
    root: String,
    kind: String,
    entity: String,
    body: String,
    memory: dna::Memory
) -> Bool {
    return ledger_submit(root, kind, entity, body, "", memory);
}

// A write's request id, minted when it is made: a write retried after an
// answer that was lost lands once.
fn request_id(root: String) -> String {
    let d = dna::digest_of(
        root + "\n" + to_string(std::time::now()) + "\n" + to_string(std::process::pid()) + "\n"
            + to_string(millis()),
    );
    return if std::str::starts_with(d, "sha256:") { d[7..31] } else { d[0..24] };
}

// `, "owner": "<owner>"` for a body's own rows when the record names an
// owner (GH #985): a row written as `host` still says whose body it was.
fn owner_json(root: String) -> String {
    let o = owner_here(root);
    return if len(o) > 0 { ", \"owner\": " + quote(o) } else { "" };
}

// A row in a person's name on an adopted organism (GH #646 stage 3, #652;
// GH #1026). The writer writes it: straight into the Ledger, as its own
// role, through memory's insert function, which is the gate — it lands
// the row, or refuses it and says why (a retired person, a task handed to
// someone else, a transfer accepted outside the owner it was offered to,
// an author this role does not write as, a claim already taken). A write
// is done when it lands, and the verb says so; there is no request to
// wait on and no spine to admit it.
fn ledger_submit(
    root: String,
    kind: String,
    entity: String,
    body: String,
    author: String,
    memory: dna::Memory
) -> Bool {
    let why = ledger_write(root, -1, kind, entity, body, author, memory);
    if len(why) > 0 {
        eprintln("hale dna: `", kind, " ", entity, "` was not written to the ledger: ", why);
        return false;
    }
    return true;
}

// One row into the Ledger in `author`'s name ("" = the host's): "" when it
// landed, `stale_revision` when the Ledger moved past `expected` (-1 for
// the tail), else why it was refused. One reason per write: it outlives
// the call only in a caller that writes several rows, one per row.
@bounded_by(rows)
fn ledger_write(
    root: String,
    expected: Int,
    kind: String,
    entity: String,
    body: String,
    author: String,
    memory: dna::Memory
) -> String {
    let l = memory.ledger;
    if !l.ready() {
        return "no memory is named here (" + l.dsn_env
            + "); the organism's operations live in its Ledger, in memory";
    }
    let who = if len(author) > 0 { author } else { "host" };
    let r = l.write(expected, kind, entity, body, who, request_id(root));
    if r.ok { return ""; }
    if r.error == "stale_revision" { return "stale_revision"; }
    let why = l.last_error();
    return if len(why) > 0 { why } else { r.error };
}

// The ledger's revision as memory holds it now, or -1 when this head holds
// no memory: the point a decision over ledger rows is read at.
fn ledger_revision(root: String, memory: dna::Memory) -> Int {
    let l = memory.ledger;
    if !l.ready() { return -1; }
    return l.revision();
}

// A row of the Ledger only if the Ledger is still at `expected` (the
// revision a decision was read at). "" when it landed, `stale_revision`
// when the Ledger moved (read again and decide again), else why it was
// refused.
fn ledger_submit_at(
    root: String,
    expected: Int,
    kind: String,
    entity: String,
    body: String,
    author: String,
    memory: dna::Memory
) -> String {
    if expected < 0 { return "the ledger's revision was not read"; }
    return ledger_write(root, expected, kind, entity, body, author, memory);
}

// Whether rows this clone writes are signed (GH #604 rule 6). Every row is
// signed as its writer signs (GH #1590), so this only says what the record's
// trust asks of them.
fn signing(root: String) -> Bool { return trust_mode(root) == "signed"; }

// Append one event to the record in `author`'s name ("" = the record's
// identity for whoever runs this): one row on the chain, compare-and-
// swapped, re-appended at the new tail when the chain moved. A lost
// race is not a failure: the tail moved, so the append goes round with
// the new tail — as many times as it takes within a bound that only a
// wedged repository reaches. Three tries used to be the bound, and a
// host reconciling beside a busy organism lost them all and dropped the
// row (GH #603).
fn append_as(
    repo: String,
    kind: String,
    entity: String,
    body: String,
    author: String,
    memory: dna::Memory
) -> Bool {
    if dna::memory_of(kind) == "ledger" {
        return ledger_submit(repo, kind, entity, body, author, memory);
    }
    return len(record_append(repo, kind, entity, body, author)) > 0;
}

// A row of the record in `author`'s name, at the tail however often the
// chain moves under it: its digest, "" when it could not be written.
// One row per try, two hundred at most.
// GH #1590: the row lands through memory's insert function, signed as its
// writer signs; "" names whoever runs this.
fn record_append(
    repo: String,
    kind: String,
    entity: String,
    body: String,
    author: String
) -> String {
    let who = if len(author) > 0 { author } else { who_am_i() };
    let j = dna::RecordJournal { repo: repo, author: who };
    let r = j.append(j.revision(), kind, entity, body);
    if !r.ok {
        eprintln(
            "hale dna: `",
            kind,
            " ",
            entity,
            "` was not written to the record: ",
            if len(j.last_error()) > 0 { j.last_error() } else { r.error },
        );
        return "";
    }
    return j.head();
}

// A receipt queued for `keeps_flush`: its digest, now. The queue is the
// caller's batch, a `Texts` it builds for one verb and flushes once.
@bounded_by(keeps)
fn keep_later(keeps: dna::Texts, text: String) -> String {
    keeps.push(text);
    return dna::hex_digest(text);
}

// The queued receipts kept, in one pass.
fn keeps_flush(repo: String, keeps: dna::Texts) -> Bool { return rec(repo).keep_batch(keeps); }

// Rows written together, one commit each, at the tail however often the
// chain moves under them: the id of the last, "" when they could not be
// written (and then none was).
@bounded_by(rows)
fn record_append_batch(repo: String, rows: dna::RowBatch) -> String {
    let j = dna::RecordJournal { repo: repo, author: who_am_i() };
    let mut i = 0;
    while i < rows.len() {
        let row = rows.get(i) or dna::Row { };
        let r = j.append_as(
            j.revision(),
            row.kind,
            row.entity,
            row.body,
            if len(row.author) > 0 { row.author } else { who_am_i() },
            false,
        );
        if !r.ok {
            eprintln(
                "hale dna: `",
                row.kind,
                " ",
                row.entity,
                "` was not written to the record: ",
                j.last_error(),
            );
            return "";
        }
        i = i + 1;
    }
    return j.head();
}

// The rows of a text, one JSON object per line (`kind`, `entity`, `body`),
// appended in order in the identity of whoever runs this: a run of rows of
// the record is one batch, a row of the ledger goes to it where it falls.
// The count appended, -1 when the record refused (the runs before it
// stay: each run is its own write).
fn append_lines(repo: String, text: String, memory: dna::Memory) -> Int {
    let pending = dna::RowBatch { };
    let mut n = 0;
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(dna::trim_nl(line)) == 0 { continue; }
        let kind = std::json::find_string_field(line, "kind");
        let entity = std::json::find_string_field(line, "entity");
        let body = std::json::find_string_field(line, "body");
        if dna::memory_of(kind) == "ledger" {
            if pending.len() > 0 {
                if len(record_append_batch(repo, pending)) == 0 { return -1; }
                while pending.len() > 0 { let gone = pending.pop() or dna::Row { }; }
            }
            if !ledger_submit(repo, kind, entity, body, "", memory) { return -1; }
        } else {
            pending.push(dna::Row { kind: kind, entity: entity, body: body });
        }
        n = n + 1;
    }
    if pending.len() > 0 && len(record_append_batch(repo, pending)) == 0 { return -1; }
    return n;
}

// Append one event only if the memory it belongs to is still where a
// decision was read: at `expected` (the record head) for a row of the
// record, at `ledger_expected` (the ledger's revision) for a row of the
// ledger. "" when it landed, `stale_revision` when that memory moved
// (nothing appended; read again and decide again), else why it was
// refused (#636: a redaction that read "no hold" must not land after a
// hold did — on either memory).
fn append_as_at(
    repo: String,
    expected: String,
    ledger_expected: Int,
    kind: String,
    entity: String,
    body: String,
    author: String,
    memory: dna::Memory
) -> String {
    if dna::memory_of(kind) == "ledger" {
        return ledger_submit_at(repo, ledger_expected, kind, entity, body, author, memory);
    }
    let r = dna::MemoryRecord {
        repo: repo,
        author: if len(author) > 0 { author } else { who_am_i() },
    };
    let now = r.head(JOURNAL);
    if !now.ok { return "the record's head could not be read: " + now.why; }
    if now.id != expected && !(now.absent && len(expected) == 0) { return "stale_revision"; }
    let a = r.append(
        JOURNAL,
        expected,
        dna::Row { kind: kind, entity: entity, body: body, author: author },
        false,
        "",
    );
    if a.ok { return ""; }
    if a.error == "stale" { return "stale_revision"; }
    return "the row could not be written: " + a.error;
}

type SyncResult {
    ok: Bool = true;
    summary: String = "";
    seen: Int = 0; // the view's rows looked at, for the next pass to start after
}

fn sync_failed(why: String) -> SyncResult {
    return SyncResult { ok: false, summary: why };
}

// GH #1590: the record is memory's, read and written there by every clone
// and body alike, so nothing of it travels by git and there is nothing to
// receive, reconcile or share. What a sync still does is local: a
// candidate the record dropped loses its branch here.
fn sync_record(repo: String, memory: dna::Memory) -> SyncResult {
    let dropped = apply_drops(repo);
    return SyncResult { ok: true, summary: "the record is memory's: nothing to sync" };
}

// The same, for a body that keeps its view of the record for its life: the
// view read again, so what other writers appended is in it, and only the
// rows past `from` (what the last pass saw) looked at — an idle body asks
// memory only whether the record moved.
fn sync_record_over(repo: String, j: dna::RoutedJournal, from: Int) -> SyncResult {
    let moved = j.refresh();
    let mut i = from;
    while i < j.revision() {
        let e = j.read(i);
        i = i + 1;
        if e.kind == "candidate.dropped" { let gone = drop_here(repo, e.entity); }
    }
    return SyncResult {
        ok: true,
        summary: "the record is memory's: nothing to sync",
        seen: j.revision(),
    };
}

// A record's identity names its memory: the digest of its first row
// (`record.genesis`). The genome pins it (`[dna] record` in hale.toml), and
// a clone whose pin is unreadable has none ("", `dna::record_identity_at`
// says why).
fn record_identity(repo: String) -> String {
    return dna::record_scope(repo);
}

// The record's identity as memory holds it for this clone's pin ("none"
// when memory holds no record for it).
fn record_identity_verb(root: String) -> Answer {
    let j = dna::RecordJournal { repo: root, author: "host" };
    return answer((if j.revision() > 0 { record_identity(root) } else { "none" }) + "\n");
}

// A candidate the record says was dropped (`candidate.dropped
// <mutation>`) has its branch deleted here (GH #1590: a candidate is a
// branch of the genome); its commits stay in the object store until git
// collects them.
fn apply_drops(repo: String) -> Int {
    let mut n = 0;
    // `candidate.dropped` is a row of the record
    let j = dna::RecordJournal { repo: repo, author: "host" };
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        i = i + 1;
        if e.kind == "candidate.dropped" { n = n + drop_here(repo, e.entity); }
    }
    return n;
}

// One dropped candidate's branch deleted here: 1 when one was kept.
fn drop_here(repo: String, mutation: String) -> Int {
    return if genome_uncandidate(repo, mutation) { 1 } else { 0 };
}

// ---- the body lease (GH #617) ---------------------------------------
// A record admits one body at a time: the host that runs its organism
// holds the lease row in memory (`MemoryLeases`, keyed `body`, or
// `owner/<owner>` over a shared record), swapped by its token, which is
// the epoch every write the body makes carries. The holder is
// `user@host:<clone>`, so the same clone restarting is the same holder and
// takes its lease back at once, and a second clone — a second body — is
// refused until the lease expires or someone forces it. The host renews
// on tick and asserts the lease before every consequential act; a body
// whose lease is no longer its own stops (a partitioned server executes
// nothing past its TTL).
const BODY_TTL: Int = 30;
// GH #1026: the exit code of a node that stops to take a moved genome; its
// unit (`Restart=always`) starts it again, and it builds the new genome at
// start. The organism's one restart code (dna::NODE_RESTART), which a
// collapse of the nerves exits with too.
const GENOME_RESTART: Int = dna::NODE_RESTART;
// The host's tick: supervision, the record's sync, and memory's work.
const HOST_TICK: Duration = 1s;
// The body fence stops the organism this many seconds before the lease
// it could last prove expires; another body can take the lease only once
// it has expired.
const FENCE_MARGIN: Int = org_runtime::FENCE_MARGIN;

type BodyLease {
    ok: Bool = true; // false: the remote could not be read (a partition)
    present: Bool = false;
    holder: String = "";
    token: Int = 0;
    expires: Int = 0;
    sha: String = ""; // the cell's version ("" = no lease)
}

fn body_holder(root: String) -> String {
    let user = std::env::var("USER");
    let h = dna::run_tool("hostname");
    let host = if h.code == 0 { dna::trim_nl(h.stdout) } else { "localhost" };
    let abs = dna::run_tool("sh\n-c\ncd \"$1\" && pwd -P\nsh\n" + root);
    let place = if abs.code == 0 { dna::trim_nl(abs.stdout) } else { root };
    return (if len(user) > 0 { user } else { "body" }) + "@" + host + ":" + place;
}

// GH #665: the store's key for this body's lease — one per owner over a
// shared record (`owner/<owner>`), `body` when the organization is the
// one owner. Its token is the epoch every write the body makes carries.
fn store_lease_key(root: String) -> String {
    let authority = org_runtime::HostAuthority { root: root };
    return authority.lease_key();
}

fn body_lease_from_store(repo: String, memory: dna::Memory) -> BodyLease {
    let authority = org_runtime::HostAuthority { root: repo };
    let l = authority.store_lease(memory.leases);
    return BodyLease {
        ok: l.ok,
        present: l.present,
        holder: l.holder,
        token: l.token,
        expires: l.expires,
        sha: l.sha,
    };
}

// The lease as memory has it; `ok` false when memory could not be
// reached. `sha` carries the token.
fn body_lease_read(repo: String, memory: dna::Memory) -> BodyLease {
    let authority = org_runtime::HostAuthority { root: repo };
    let l = authority.body_lease(memory.leases);
    return BodyLease {
        ok: l.ok,
        present: l.present,
        holder: l.holder,
        token: l.token,
        expires: l.expires,
        sha: l.sha,
    };
}

// Write a lease where `expected` is the token it has now ("" = no lease),
// swapped by that token in memory. False when someone else moved it first.
fn body_lease_write(repo: String, l: BodyLease, expected: String, memory: dna::Memory) -> Bool {
    let sl = memory.leases;
    let expected_token = if len(expected) == 0 { 0 } else { std::str::parse_int(expected) or 0 };
    let key = store_lease_key(repo);
    return sl.put(
        key,
        dna::Lease {
            key: key,
            holder: l.holder,
            token: l.token,
            expires: l.expires,
            present: l.present,
        },
        expected_token,
    );
}

fn body_live(l: BodyLease, now: Int) -> Bool { return l.present && l.expires > now; }

// GH #986: whether the organism runs from this clone — a body here holds
// the record's lease, live. A one-shot verb asks it to know whether an
// answer will come without a sync; the host beside the organism relays
// the verb's row onto the nerves on its next tick.
fn organism_here(root: String, memory: dna::Memory) -> Bool {
    let l = body_lease_read(root, memory);
    return l.ok && body_live(l, std::time::now()) && l.holder == body_holder(root);
}

// Take the body lease for `holder`, or learn who holds it: a live
// lease of another holder is refused (present false, holder theirs),
// unless `force`. A refused acquire because of a partition is `ok`
// false.
fn body_acquire(
    repo: String,
    holder: String,
    now: Int,
    force: Bool,
    memory: dna::Memory
) -> BodyLease {
    let cur = body_lease_read(repo, memory);
    if !cur.ok { return cur; }
    if body_live(cur, now) && cur.holder != holder && !force {
        // theirs, not ours: `present` is false for the caller, `holder` says whose
        return BodyLease {
            present: false,
            holder: cur.holder,
            token: cur.token,
            expires: cur.expires,
            sha: cur.sha,
        };
    }
    let l = BodyLease {
        present: true,
        holder: holder,
        token: cur.token + 1,
        expires: now + BODY_TTL,
    };
    if !body_lease_write(repo, l, cur.sha, memory) {
        let again = body_lease_read(repo, memory);
        if !again.ok { return again; }
        if again.holder == holder && body_live(again, now) { return again; }
        return BodyLease {
            present: false,
            holder: again.holder,
            token: again.token,
            expires: again.expires,
            sha: again.sha,
        };
    }
    let mine = body_lease_read(repo, memory);
    return if mine.ok && mine.holder == holder && mine.token == l.token {
        mine
    } else {
        BodyLease {
            present: true,
            holder: holder,
            token: l.token,
            expires: l.expires,
            sha: to_string(l.token),
        }
    };
}

// Renew a lease that is still ours; the renewed lease, or the lease as
// someone else now has it (present false for us), or `ok` false when
// the remote could not be reached — the caller keeps the lease it had
// until that one expires.
fn body_renew(repo: String, mine: BodyLease, now: Int, memory: dna::Memory) -> BodyLease {
    let cur = body_lease_read(repo, memory);
    if !cur.ok { return cur; }
    if !(cur.present && cur.holder == mine.holder && cur.token == mine.token) {
        return BodyLease {
            present: false,
            holder: cur.holder,
            token: cur.token,
            expires: cur.expires,
            sha: cur.sha,
        };
    }
    let l = BodyLease {
        present: true,
        holder: mine.holder,
        token: mine.token,
        expires: now + BODY_TTL,
    };
    if !body_lease_write(repo, l, cur.sha, memory) {
        let again = body_lease_read(repo, memory);
        if !again.ok { return again; }
        // the write failed and the lease is still ours as it was: not lost,
        // only unrenewed — kept until it expires, like a partition
        if again.present && again.holder == mine.holder && again.token == mine.token {
            return BodyLease { ok: false };
        }
        return BodyLease {
            present: false,
            holder: again.holder,
            token: again.token,
            expires: again.expires,
            sha: again.sha,
        };
    }
    return BodyLease {
        present: true,
        holder: mine.holder,
        token: mine.token,
        expires: l.expires,
        sha: to_string(l.token),
    };
}

// Give the lease up (present false, token kept so a late renewal of it
// is refused). True when it was ours to give up.
fn body_release(repo: String, mine: BodyLease, memory: dna::Memory) -> Bool {
    let cur = body_lease_read(repo, memory);
    if !cur.ok || !cur.present || cur.holder != mine.holder || cur.token != mine.token {
        return false;
    }
    return body_lease_write(
        repo,
        BodyLease { present: false, holder: cur.holder, token: cur.token, expires: 0 },
        cur.sha,
        memory,
    );
}

fn ago(secs: Int) -> String {
    if secs < 0 { return "just now"; }
    if secs < 90 { return to_string(secs) + "s ago"; }
    if secs < 5400 { return to_string(secs / 60) + "m ago"; }
    if secs < 172800 { return to_string(secs / 3600) + "h ago"; }
    return to_string(secs / 86400) + "d ago";
}

// The body line of `status` and `profile`: who runs this record's
// organism, from the lease alone.
fn body_line(repo: String, now: Int, memory: dna::Memory) -> String {
    let l = body_lease_read(repo, memory);
    if !l.ok { return "unknown (memory cannot be reached)"; }
    if len(l.holder) == 0 {
        return "none (no body has run this record; `hale dna run` takes the lease)";
    }
    let ticked = ago(now - (l.expires - BODY_TTL));
    if body_live(l, now) {
        return "live on " + l.holder + ", ticked " + ticked + ", lease expires in "
            + to_string(l.expires - now) + "s";
    }
    if l.present {
        return "stale: " + l.holder + " last ticked " + ticked
            + " and its lease has expired; `hale dna run` takes it, `hale dna body claim` says so";
    }
    return "released by " + l.holder + "; `hale dna run` takes the lease";
}
