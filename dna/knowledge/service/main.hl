// dna/knowledge/service — the knowledge service (GH #583 K1).
//
// A Hale program that owns the graph: it tails the record
// (`knowledge.*` rows from its watermark on, each digest resolved to
// its receipt) into a KnowledgeStore and answers over HTTP. Git is the
// sole authority; the store is the live, shared, queryable half. Run
// by `hale dna dev` beside the organization (the DSN from compose) or
// as an instance in the plan with a node; `hale dna knowledge` asks it.
//
//   knowledge <root> <port>   with HALE_DNA_KNOWLEDGE_DSN in the environment
//                             ("memory" runs the in-memory store: dev with nothing)
//
// Every request applies the record first (the reader sees it as it is
// now), so there is no tick to fall behind.
// GET /            a summary: store kind, watermark, counts
// GET /context?target=<locus path>&budget=<n>[&query=<text>]
//                  the bounded ContextPackage a position would receive;
//                  with a query, ranked by similarity inside the bound (K3)
// GET /structure   the code's structure as projected from the record
// GET /signals     pressure and concerns, counted per source
// GET /idea/<digest>
//                  one idea with its ratification row
// POST /apply      tail the record and report what was applied

import "../../core" as dna;
import ".." as know;

fn arg(i: Int) -> String { return std::env::arg_or(i, ""); }

fn count_words(s: String) -> Int {
    let mut n = 0;
    let mut rest = s + " ";
    while len(rest) > 1 {
        let sp = std::str::index_of(rest, " ");
        if sp > 0 { n = n + 1; }
        rest = rest[(sp + 1)..len(rest)];
    }
    return n;
}

fn json(body: String) -> std::http::Response {
    return std::http::Response { status: 200, content_type: "application/json", headers: "Cache-Control: no-store", body: body };
}

// The store cannot answer: say so with a status a caller notices,
// rather than an empty package that reads like an answer.
fn unavailable(why: String) -> std::http::Response {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("error", why);
    b.end_object();
    return std::http::Response { status: 503, content_type: "application/json", headers: "Cache-Control: no-store", body: b.result() };
}

locus Service {
    params {
        root: String = ".";
        store: know::KnowledgeStore = know::Mem { };
        // GH #606: the only keeper of protected bodies
        protected: know::ProtectedBodies = know::MemProtected { };
        j: dna::GitJournal = dna::GitJournal { repo: ".", author: "knowledge" };
        receipts: dna::GitReceipts = dna::GitReceipts { repo: "." };
        // GH #646 stage 1: the Ledger, the organism's operational memory,
        // served over /ledger/* to the organism and the heads
        ledger: know::Ledger = know::MemLedger { };
        // GH #646 stage 2: leases in the store, swapped by token
        leases: know::LeaseStore = know::MemLeaseStore { };
        applied: Int = 0;
        last_error: String = "";
        ticks: Int = 0;
        // The store must be OPEN before it can answer: `Pq.open()` is
        // what connects and migrates. Nothing opened it, so the Postgres
        // path returned 200 with an empty graph and a normal-looking
        // digest while every query failed (the shakeout's finding 4).
        // `Mem.open()` is a no-op, which is why the tests never saw it.
        opened: Bool = false;
    }
    // Opened on the first request, not at birth: a database that is
    // down or slow to answer must not hold the HTTP surface closed —
    // the surface is where an operator reads that it is down. Kept
    // open once it opens, and retried while it will not, so a database
    // that comes up late needs no restart.
    fn ensure_open() -> Bool {
        // An open that succeeded once is not a connection that still
        // answers. A database restart, or anything else that drops the
        // session, left this true forever: the summary said `open`, the
        // record tail failed, and `/context` answered 200 with an empty
        // package and a normal-looking digest until someone restarted
        // the service by hand (the review's second round, finding 4).
        // The connection is asked on each request, and a dead one is
        // re-established here rather than reported as knowledge.
        // The store is scoped by the record's identity, its first
        // commit (GH #613): a record that had no rows when the store
        // opened, and has some now, moves to its own schema here.
        let scope = self.j.genesis();
        if self.opened && scope != self.store.record() {
            eprintln("hale dna knowledge: the record has its first row; the store is scoped to record ", scope);
            self.opened = false;
        }
        if self.opened && self.store.healthy() { return true; }
        if self.opened { eprintln("hale dna knowledge: the store's connection is gone (", self.store.last_error(), "); dialling again"); }
        self.opened = false;
        self.store.scope(scope);
        self.protected.scope(scope);
        self.ledger.scope(scope);
        if self.store.reopen() {
            // the ledger lives in the same database, beside the store
            if !self.ledger.open() {
                self.last_error = "the ledger is not open: " + self.ledger.last_error();
                return false;
            }
            self.leases.scope(scope);
            if !self.leases.open() {
                self.last_error = "the leases are not open: " + self.leases.last_error();
                return false;
            }
            self.opened = true;
            self.last_error = "";
            return true;
        }
        self.last_error = "the store is not open: " + self.store.last_error();
        return false;
    }
    // Tail the record: fetch is the host's job; this reads what the
    // repository has now (another process — the organization, a CLI —
    // may have moved the ref since the last read).
    fn apply() -> know::Applied {
        // read the record before opening the store: the scope is the
        // record's identity as loaded, and what is applied is the same
        // loaded record
        let moved = self.j.refresh();
        if !self.ensure_open() { return know::Applied { error: self.last_error }; }
        self.store.forget_error();
        let r = know::apply_record(self.store, self.j, self.receipts);
        self.applied = self.applied + r.ratified + r.proposed + r.declined;
        self.last_error = r.error;
        return r;
    }
    @unbounded
    fn has_row(kind: String, entity: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == kind && e.entity == entity { return true; }
            i = i + 1;
        }
        return false;
    }
    // A `receipt.disclosed` row naming this reader and this purpose.
    @unbounded
    fn disclosed(digest: String, reader: String, purpose: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "receipt.disclosed" && e.entity == digest && std::json::find_string_field(e.body, "recipient") == reader && std::json::find_string_field(e.body, "purpose") == purpose { return true; }
            i = i + 1;
        }
        return false;
    }
    // "who: why" of a hold that stands on `digest` ("" when none).
    @unbounded
    fn hold_of(digest: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.entity == digest && e.kind == "receipt.held" { out = std::json::find_string_field(e.body, "by") + ": " + std::json::find_string_field(e.body, "why"); }
            if e.entity == digest && e.kind == "receipt.hold_released" { out = ""; }
            i = i + 1;
        }
        return out;
    }
    // "by <who> under <policy>: <why>" of a redaction ("" when none).
    @unbounded
    fn redaction_of(digest: String) -> String {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.entity == digest && e.kind == "receipt.redacted" { return "by " + std::json::find_string_field(e.body, "by") + " under " + std::json::find_string_field(e.body, "policy") + ": " + std::json::find_string_field(e.body, "why"); }
            i = i + 1;
        }
        return "";
    }
    // Why a request in `author`'s name is not admitted: a retired person
    // (the record's `person.retired` row, effective from the head this
    // service has), a completion for a task handed to someone else. ""
    // when it is admitted. (GH #646 stage 3, #652; stage 4 adds grants.)
    @unbounded
    // GH #665: why a write under `lease` at `token` is fenced, "" when it holds.
    fn fence_refusal(lease: String, token: Int, now: Int) -> String {
        let cur = self.leases.current(lease);
        if !cur.known || !cur.present { return "fenced: the lease `" + lease + "` is not held; a controller writes only under a lease it holds"; }
        if cur.token != token { return "fenced: the lease `" + lease + "` is " + cur.holder + "'s at epoch " + to_string(cur.token) + ", not epoch " + to_string(token) + "; a controller that lost its lease writes nothing"; }
        if cur.expires <= now { return "fenced: the lease `" + lease + "` expired at " + to_string(cur.expires) + " (epoch " + to_string(token) + ") and was not renewed"; }
        return "";
    }
    fn admission_refusal(kind: String, entity: String, author: String) -> String {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "person.retired" && e.entity == author { return author + " retired from this organism (person.retired at row " + to_string(e.seq) + "); nothing is admitted in their name"; }
            i = i + 1;
        }
        if kind == "task.done" || kind == "task.failed" || kind == "completion.linked" || kind == "completion.excepted" {
            let mut assignee = "";
            let mut k = 0;
            while k < self.ledger.revision() {
                let e = self.ledger.read(k);
                if e.entity == entity && (e.kind == "task.handed" || e.kind == "task.reassigned") {
                    let to = if e.kind == "task.reassigned" { std::json::find_string_field(e.body, "to") } else { std::json::find_string_field(e.body, "assignee") };
                    if len(to) > 0 { assignee = to; }
                }
                k = k + 1;
            }
            if len(assignee) > 0 && assignee != author { return "task " + entity + " is handed to " + assignee + ", not to " + author + "; a completion is admitted in the assignee's name"; }
        }
        return "";
    }
    // The Ledger's rows from `from` on, one JSON object per line.
    @unbounded
    fn ledger_rows_from(from: Int) -> String {
        let mut out = "";
        let mut i = if from < 0 { 0 } else { from };
        while i < self.ledger.revision() {
            out = out + know::row_json(self.ledger.read(i), self.ledger.author_of(i)) + "\n";
            i = i + 1;
        }
        return out;
    }
    fn summary() -> String {
        let up = self.ensure_open();
        // The counts below are queries. A store that answers none of
        // them reported zeroes beside an empty error, which reads as an
        // empty graph rather than a failure (the third-round review's
        // finding 3): whatever they hit is the summary's error too.
        self.store.forget_error();
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("store", self.store.kind());
        b.bool_field("open", self.opened);
        b.string_field("scope", self.store.record());
        b.int_field("watermark", self.store.watermark());
        b.int_field("record", self.j.revision());
        b.int_field("ideas", self.store.count("ideas"));
        b.int_field("ratified", self.store.count("ratified"));
        b.int_field("bindings", self.store.count("bindings"));
        b.int_field("structure", self.store.structure_count(""));
        b.int_field("ticks", self.ticks);
        b.string_field("error", if len(self.last_error) > 0 { self.last_error } else { self.store.last_error() });
        b.end_object();
        return b.result();
    }
    fn package(target: String, budget: Int, query: String) -> String {
        let ids = if len(query) > 0 { self.store.ranked_ids(target, budget, know::embed_text(query)) } else { self.store.context_ids(target, budget) };
        let n = if len(ids) == 0 { 0 } else { count_words(ids) };
        // the digest identifies what is handed over — the target and the
        // ideas — and nothing that varies between runs: the revision is
        // reported beside it, never inside it, or a tape could not answer
        // the same request twice (GH #583 K4)
        let d = dna::digest_of(target + ":" + ids);
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("target", target);
        b.int_field("revision", self.store.watermark());
        b.string_field("digest", d);
        b.string_field("included", ids);
        b.int_field("included_n", n);
        b.bool_field("ranked", len(query) > 0);
        b.begin_array_field("ideas");
        let mut rest = ids + " ";
        while len(rest) > 1 {
            let sp = std::str::index_of(rest, " ");
            let id = rest[0..sp];
            rest = rest[(sp + 1)..len(rest)];
            if len(id) == 0 { continue; }
            let s = self.store.idea(id);
            let ib = std::json::Builder { };
            ib.begin_object();
            ib.string_field("id", s.idea.id);
            ib.string_field("kind", s.idea.kind);
            ib.string_field("text", s.idea.text);
            ib.string_field("author", s.idea.author);
            ib.int_field("ratified_seq", s.ratified_seq);
            ib.end_object();
            b.value(ib.result());
        }
        b.end_array();
        b.end_object();
        return b.result();
    }
    // Every request applies the record first: the reader sees the
    // record as it is now, and the one Service the server holds is the
    // one that tails — no second instance to keep in step.
    // ---- the Ledger (GH #646 stage 1, #650) and its leases (stage 2, #651)
    fn handle_ledger(req: std::http::Request, ctx: std::http::Context) -> std::http::Response {
        if std::http::is_route(ctx, "GET", "/ledger/head") {
            let moved = self.ledger.refresh();
            let b = std::json::Builder { };
            b.begin_object();
            b.int_field("revision", self.ledger.revision());
            b.string_field("head", self.ledger.head());
            let c = self.ledger.checkpoint();
            b.bool_field("adopted", c.adopted);
            b.string_field("checkpoint", c.checkpoint);
            b.int_field("routing", c.routing);
            b.end_object();
            return json(b.result());
        }
        // ---- the exchange (GH #646 stage 5, #662): this record's identity,
        // and its mailboxes, one per connected record
        if std::http::is_route(ctx, "GET", "/identity") {
            return json("{\"identity\": \"" + self.j.genesis() + "\"}");
        }
        if std::http::is_route(ctx, "GET", "/exchange") {
            return std::http::Response { status: 200, content_type: "application/x-ndjson", headers: "Cache-Control: no-store", body: self.ledger.mailboxes() };
        }
        if std::http::is_route(ctx, "GET", "/exchange/has") {
            let sender = know::url_decode(std::http::query_param(ctx.params, "sender"));
            let kind = know::url_decode(std::http::query_param(ctx.params, "kind"));
            let entity = know::url_decode(std::http::query_param(ctx.params, "entity"));
            return json("{\"has\": " + (if self.ledger.mailbox_has(sender, kind, entity) { "true" } else { "false" }) + "}");
        }
        if std::str::starts_with(req.path, "/exchange/") && req.method == "POST" {
            // an envelope from the record whose identity names the mailbox,
            // once by (kind, entity): a delivery repeated is one envelope
            let sender = know::url_decode(req.path[10..len(req.path)]);
            if len(sender) == 0 { return refusal(400, "an envelope names its sender"); }
            let body = req.body;
            let kind = std::json::find_string_field(body, "kind");
            let entity = std::json::find_string_field(body, "entity");
            if len(kind) == 0 || len(entity) == 0 { return refusal(400, "an envelope has a kind and an entity"); }
            if std::json::find_string_field(std::json::find_string_field(body, "body"), "origin_record") != sender && kind == "handoff.received" { return refusal(403, "an envelope claiming another origin than its sender is not its sender's"); }
            if !self.ledger.mailbox_put(sender, kind, entity, std::json::find_string_field(body, "body"), std::json::find_string_field(body, "author")) { return unavailable("the mailbox could not take the envelope: " + self.ledger.last_error()); }
            return json("{\"delivered\": true, \"ref\": \"" + sender + "/" + kind + "/" + entity + "\"}");
        }
        if std::http::is_route(ctx, "GET", "/ledger/lease") {
            let key = know::url_decode(std::http::query_param(ctx.params, "key"));
            if len(key) == 0 { return refusal(400, "a lease has a key"); }
            return json(know::stored_lease_json(self.leases.current(key)));
        }
        if std::http::is_route(ctx, "POST", "/ledger/lease") {
            let body = req.body;
            let key = std::json::find_string_field(body, "key");
            if len(key) == 0 { return refusal(400, "a lease has a key"); }
            let ok = self.leases.put(key, std::json::find_string_field(body, "holder"), std::json::find_int_field(body, "token"), std::json::find_int_field(body, "expires"), std::json::find_bool_field(body, "present"), std::json::find_int_field(body, "expected"));
            if !ok {
                if len(self.leases.last_error()) > 0 { return unavailable("the lease could not be put: " + self.leases.last_error()); }
                return refusal(409, "the lease moved: its token is not the one expected");
            }
            return json(know::stored_lease_json(self.leases.current(key)));
        }
        if std::http::is_route(ctx, "GET", "/ledger/rows") {
            let moved = self.ledger.refresh();
            let f = std::http::query_param(ctx.params, "from");
            let from = if len(f) > 0 { std::str::parse_int(f) or 0 } else { 0 };
            return std::http::Response { status: 200, content_type: "application/x-ndjson", headers: "Cache-Control: no-store", body: self.ledger_rows_from(from) };
        }
        if std::http::is_route(ctx, "POST", "/ledger/append") {
            let body = req.body;
            let kind = std::json::find_string_field(body, "kind");
            if len(kind) == 0 { return refusal(400, "an append names a kind"); }
            if dna::memory_of(kind) != "ledger" { return refusal(400, "`" + kind + "` is a row of the record, not the ledger: it is appended to the record and synced"); }
            let expected = std::json::find_int_field(body, "expected");
            let exact = std::json::find_bool_field(body, "exact");
            let entity = std::json::find_string_field(body, "entity");
            let text = std::json::find_string_field(body, "body");
            let author = std::json::find_string_field(body, "as");
            let request_id = std::json::find_string_field(body, "request_id");
            let moved = self.ledger.refresh();
            // GH #646 stage 3: a request seen before is answered as it was
            // and writes nothing — a queued request submitted twice lands once
            if len(request_id) > 0 {
                let before = self.ledger.seen(request_id);
                if before == -1 { return refusal(403, "this request was refused when it was first submitted"); }
                if before >= 0 {
                    let b = std::json::Builder { };
                    b.begin_object();
                    b.int_field("revision", before);
                    b.string_field("rows", self.ledger_rows_from(expected));
                    b.bool_field("repeated", true);
                    b.end_object();
                    return json(b.result());
                }
            }
            // GH #665: a controller's write carries the lease it holds and
            // its epoch; under a lease it no longer holds — taken over,
            // released, expired — nothing lands
            let lease = std::json::find_string_field(body, "lease");
            if len(lease) > 0 {
                let token = std::json::find_int_field(body, "token");
                let fenced = self.fence_refusal(lease, token, std::time::now());
                if len(fenced) > 0 {
                    if len(request_id) > 0 { let m = self.ledger.mark(request_id, -1); }
                    return refusal(403, fenced);
                }
            }
            // in a person's name: checked against the record as it is now,
            // whenever the request was captured (#646 decision 2)
            if len(author) > 0 {
                let why = self.admission_refusal(kind, entity, author);
                if len(why) > 0 {
                    if len(request_id) > 0 { let m = self.ledger.mark(request_id, -1); }
                    return refusal(403, why);
                }
            }
            let r = if exact { self.ledger.append_exact(expected, kind, entity, text) } else { self.ledger.append(self.ledger.revision(), kind, entity, text) };
            if !r.ok {
                if r.error == "stale_revision" { return refusal(409, "stale_revision"); }
                // GH #666: a claim kind's entity is taken — the first claim
                // holds; the writer mints another
                if r.error == "claimed" { return refusal(409, "claimed"); }
                return unavailable("the ledger refused the append: " + self.ledger.last_error());
            }
            if len(author) > 0 { let named = self.ledger.name_author(r.revision - 1, author); }
            if len(request_id) > 0 { let m = self.ledger.mark(request_id, r.revision); }
            let b = std::json::Builder { };
            b.begin_object();
            b.int_field("revision", r.revision);
            b.string_field("rows", self.ledger_rows_from(expected));
            b.end_object();
            return json(b.result());
        }
        if std::http::is_route(ctx, "POST", "/ledger/adopt") {
            // every operational row of the record, in order, keyed by its
            // commit: rerun after any interruption, nothing copied twice
            let head = self.j.head();
            let mut copied = 0;
            let mut i = 0;
            while i < self.j.revision() {
                let e = self.j.read(i);
                if dna::memory_of(e.kind) == "ledger" {
                    if !self.ledger.adopt_row(e.kind, e.entity, e.body, self.j.author_of(i), e.seq, e.digest) { return unavailable("the ledger could not take row " + to_string(e.seq) + ": " + self.ledger.last_error()); }
                    copied = copied + 1;
                }
                i = i + 1;
            }
            if !self.ledger.cutover(head, copied, dna::ROUTING_VERSION) { return unavailable("the ledger could not record the cutover: " + self.ledger.last_error()); }
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("checkpoint", head);
            b.int_field("copied", copied);
            b.int_field("routing", dna::ROUTING_VERSION);
            b.end_object();
            return json(b.result());
        }
        if std::http::is_route(ctx, "POST", "/ledger/abandon") {
            if !self.ledger.abandon() { return unavailable("the ledger could not be abandoned: " + self.ledger.last_error()); }
            return json("{\"abandoned\": true}");
        }
        return refusal(404, "no such ledger route");
    }
    fn handle(req: std::http::Request) -> std::http::Response {
        self.ticks = self.ticks + 1;
        let ctx = std::http::build_context(req);
        // the ledger and the leases are answered from the store alone:
        // applying the record's knowledge first (below) is a read of the
        // whole record, and an organism asks for its ledger every tick
        if std::str::starts_with(req.path, "/ledger/") || std::str::starts_with(req.path, "/exchange") || req.path == "/identity" {
            let moved = self.j.refresh();
            if !self.ensure_open() { return unavailable(self.last_error); }
            return self.handle_ledger(req, ctx);
        }
        let fresh = self.apply();
        // the summary is always answerable: it is where an operator reads
        // that the store is down, and why
        if std::http::is_route(ctx, "GET", "/") { return json(self.summary()); }
        if !self.ensure_open() { return unavailable(self.last_error); }
        // A connection that answers `SELECT 1` is not a database that
        // can answer the questions knowledge is made of. The record's
        // projection failing, or a read failing, used to reach the
        // caller as an empty package with a well-formed digest — "there
        // is no knowledge here" (the third-round review's finding 3).
        // Both are refusals: what this service has to say about the
        // record is unknown until it can read and project it.
        if len(fresh.error) > 0 { return unavailable("the record is not applied: " + fresh.error); }
        if std::http::is_route(ctx, "GET", "/context") {
            let target = std::str::replace(std::http::query_param(ctx.params, "target"), "%2F", "/");
            let b = std::http::query_param(ctx.params, "budget");
            let budget = if len(b) > 0 { std::str::parse_int(b) or 8 } else { 8 };
            let query = know::url_decode(std::http::query_param(ctx.params, "query"));
            self.store.forget_error();
            let p = self.package(target, budget, query);
            if len(self.store.last_error()) > 0 { return unavailable("the store cannot answer: " + self.store.last_error()); }
            return json(p);
        }
        if std::http::is_route(ctx, "GET", "/structure") {
            self.store.forget_error();
            let b = std::json::Builder { };
            b.begin_object();
            b.int_field("rows", self.store.structure_count(""));
            b.int_field("loci", self.store.structure_count("locus"));
            b.int_field("topics", self.store.structure_count("topic"));
            b.int_field("bindings", self.store.structure_count("binding"));
            b.int_field("effect_classes", self.store.structure_count("effect_class"));
            b.int_field("claims", self.store.structure_count("claim"));
            b.string_field("loci_names", self.store.structure_names("locus"));
            b.string_field("topic_names", self.store.structure_names("topic"));
            b.end_object();
            if len(self.store.last_error()) > 0 { return unavailable("the store cannot answer: " + self.store.last_error()); }
            return json(b.result());
        }
        if std::http::is_route(ctx, "GET", "/signals") {
            self.store.forget_error();
            let sig = self.store.signals();
            if len(self.store.last_error()) > 0 { return unavailable("the store cannot answer: " + self.store.last_error()); }
            return json("{\"signals\": " + sig + "}");
        }
        if std::str::starts_with(req.path, "/idea/") && req.method == "GET" {
            self.store.forget_error();
            let s = self.store.idea(req.path[6..len(req.path)]);
            if len(self.store.last_error()) > 0 { return unavailable("the store cannot answer: " + self.store.last_error()); }
            if !s.present { return std::http::Response { status: 404, content_type: "application/json", body: "{\"error\": \"no such idea\"}" }; }
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("id", s.idea.id);
            b.string_field("kind", s.idea.kind);
            b.string_field("text", s.idea.text);
            b.string_field("author", s.idea.author);
            b.string_field("provenance", s.idea.provenance);
            b.bool_field("accepted", s.idea.accepted);
            b.int_field("ratified_seq", s.ratified_seq);
            b.end_object();
            return json(b.result());
        }
        // GH #606: protected evidence. A body is kept here and nowhere
        // else; the record gets its digest and class. A read names a
        // reader and a purpose, is refused unless a `receipt.disclosed`
        // row names both, and is a row either way.
        if std::http::is_route(ctx, "POST", "/receipt") {
            let b = req.body;
            let class = std::json::find_string_field(b, "class");
            let text = std::json::find_string_field(b, "text");
            let by = std::json::find_string_field(b, "by");
            if !dna::protected_class(class) { return refusal(400, "class: `" + class + "` is not protected (customer | confidential); a public or internal body is an ordinary git receipt"); }
            if len(text) == 0 { return refusal(400, "text: nothing to keep"); }
            let digest = dna::digest_of(text);
            // a body the record says was redacted is not kept again: a
            // replay, a retry or a re-run intake would put erased bytes back
            // behind a record that says they are gone (#636)
            let moved = self.j.refresh();
            let redaction = self.redaction_of(digest);
            if len(redaction) > 0 { return refusal(409, digest + " was redacted " + redaction + "; a redacted body is not kept again"); }
            if !self.protected.ready() { return refusal(503, self.protected.why_not() + "; the body of " + digest + " is not kept"); }
            if !self.protected.put(digest, class, text, std::time::now()) { return refusal(503, "the protected store refused: " + self.protected.last_error()); }
            if !self.has_row("receipt.classified", digest) {
                let rb = std::json::Builder { };
                rb.begin_object();
                rb.string_field("class", class);
                rb.string_field("by", by);
                rb.string_field("store", self.protected.kind());
                rb.end_object();
                let x = self.j.append(self.j.revision(), "receipt.classified", digest, rb.result());
                if !x.ok { return refusal(503, "the body of " + digest + " is kept, but the record refused its classification (" + x.error + "); file it again"); }
            }
            let ob = std::json::Builder { };
            ob.begin_object();
            ob.string_field("digest", digest);
            ob.string_field("class", class);
            ob.end_object();
            return json(ob.result());
        }
        // GH #606 part 2: redaction. A standing hold refuses it; the body
        // is erased from the store and the record keeps the digest and a
        // `receipt.redacted` row naming who, why and under what policy.
        if std::str::starts_with(req.path, "/receipt/") && std::str::ends_with(req.path, "/erase") && req.method == "POST" {
            let digest = know::url_decode(req.path[9..(len(req.path) - 6)]);
            let b = req.body;
            let by = std::json::find_string_field(b, "by");
            let why = std::json::find_string_field(b, "why");
            let policy = std::json::find_string_field(b, "policy");
            if len(by) == 0 || len(why) == 0 || len(policy) == 0 { return refusal(400, "a redaction names who (`by`), why and the policy"); }
            let moved = self.j.refresh();
            let hold = self.hold_of(digest);
            if len(hold) > 0 { return refusal(409, "held: " + hold + "; redaction waits for the hold's release"); }
            let p = self.protected.get(digest);
            let already = self.has_row("receipt.redacted", digest);
            let step = dna::protected_erase_step(p.present, if p.present { "" } else { self.protected.last_error() }, already);
            if std::str::starts_with(step, "unread: ") { return refusal(503, "the protected store cannot say whether it keeps " + digest + " (" + step[8..len(step)] + "); nothing was recorded or erased — redact again once it answers"); }
            if step == "already" { return refusal(409, digest + " is already redacted"); }
            // the decision is in the record before a byte is erased, at the
            // revision the hold was read at: a redaction the record cannot
            // hold erases nothing, and a hold that arrived in between refuses it
            if !already {
                let rb = std::json::Builder { };
                rb.begin_object();
                rb.string_field("by", by);
                rb.string_field("why", why);
                rb.string_field("policy", policy);
                rb.string_field("class", if p.present { p.class } else { "" });
                rb.string_field("store", if p.present { self.protected.kind() } else { "none (the body was not kept here)" });
                rb.end_object();
                let x = self.j.append_exact(self.j.revision(), "receipt.redacted", digest, rb.result());
                if !x.ok { return refusal(if x.error == "stale_revision" { 409 } else { 503 }, "the redaction of " + digest + " could not be recorded (" + x.error + "); nothing was erased"); }
            }
            if p.present && !self.protected.erase(digest) { return refusal(503, "the redaction of " + digest + " is recorded, but the protected store could not erase it: " + self.protected.last_error() + "; a read answers 410 already, and redacting again erases it"); }
            return json("{\"digest\": \"" + digest + "\", \"redacted\": true}");
        }
        if std::str::starts_with(req.path, "/receipt/") && req.method == "GET" {
            let q = std::str::index_of(req.path, "?");
            let digest = know::url_decode(if q < 0 { req.path[9..len(req.path)] } else { req.path[9..q] });
            let reader = know::url_decode(std::http::query_param(ctx.params, "as"));
            let purpose = know::url_decode(std::http::query_param(ctx.params, "purpose"));
            if len(reader) == 0 || len(purpose) == 0 { return refusal(400, "a read names a reader (`as`) and a purpose"); }
            let moved_first = self.j.refresh();
            let redaction = self.redaction_of(digest);
            if len(redaction) > 0 { return refusal(410, digest + " was redacted: " + redaction + "; the record keeps its digest, not its body"); }
            if !self.protected.ready() { return refusal(503, self.protected.why_not()); }
            let p = self.protected.get(digest);
            if !p.present {
                let err = self.protected.last_error();
                return refusal(if len(err) > 0 { 503 } else { 404 }, if len(err) > 0 { "the protected store cannot read " + digest + ": " + err } else { "no protected body for " + digest });
            }
            let moved = self.j.refresh();
            let rb = std::json::Builder { };
            rb.begin_object();
            rb.string_field("by", reader);
            rb.string_field("purpose", purpose);
            rb.string_field("class", p.class);
            rb.end_object();
            if !self.disclosed(digest, reader, purpose) {
                let x = self.j.append(self.j.revision(), "receipt.read_refused", digest, rb.result());
                return refusal(403, "not disclosed to " + reader + " for " + purpose + ": `hale dna receipt disclose " + digest + " --to " + reader + " --purpose " + purpose + "` authorizes it");
            }
            // every answer is an act in the reader's name: a read the record
            // cannot hold is not answered, and no byte of the body leaves
            let x = self.j.append(self.j.revision(), "receipt.read", digest, rb.result());
            if !x.ok { return refusal(503, "the read of " + digest + " could not be recorded (" + x.error + "); nothing was disclosed"); }
            let ob = std::json::Builder { };
            ob.begin_object();
            ob.string_field("digest", digest);
            ob.string_field("class", p.class);
            ob.string_field("text", p.text);
            ob.end_object();
            return json(ob.result());
        }
        if std::http::is_route(ctx, "POST", "/apply") {
            let r = self.apply();
            let b = std::json::Builder { };
            b.begin_object();
            b.int_field("rows", r.rows);
            b.int_field("ratified", r.ratified);
            b.int_field("proposed", r.proposed);
            b.int_field("declined", r.declined);
            b.int_field("watermark", r.watermark);
            b.string_field("error", r.error);
            b.end_object();
            return json(b.result());
        }
        return std::http::Response { status: 404, content_type: "application/json", body: "{\"error\": \"no such route\"}" };
    }
}

main locus Knowledge {
    params {
        root: String = ".";
        port: Int = 8791;
        dsn: String = "";
        srv: std::http::Server = std::http::Server { port: 8791, handler: Service { } };
    }
    placement { srv: cooperative(pool = io); }
    run() {
        // the server's Service applies the record on every request; this
        // loop only holds the process up (and returns once under ONESHOT)
        while true {
            if std::env::var_exists("HALE_DNA_ONESHOT") { return; }
            std::time::sleep(1s);
        }
    }
}

fn refusal(status: Int, why: String) -> std::http::Response {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("error", why);
    b.end_object();
    return std::http::Response { status: status, content_type: "application/json", body: b.result() };
}

fn main() {
    let root = if len(arg(1)) > 0 { arg(1) } else { "." };
    let port = std::str::parse_int(arg(2)) or 8791;
    let dsn = if std::env::var_exists("HALE_DNA_KNOWLEDGE_DSN") { std::env::var("HALE_DNA_KNOWLEDGE_DSN") } else { "" };
    if len(dsn) == 0 {
        eprintln("hale dna knowledge: HALE_DNA_KNOWLEDGE_DSN is not set (a postgres:// URL, or `memory` for a store that lives only as long as this process)");
        std::process::exit(2);
    }
    if dsn == "memory" {
        eprintln("hale dna knowledge: in-memory store at :", port, " over ", root, " (nothing durable; set a postgres:// DSN for a shared graph)");
        Knowledge {
            root: root, port: port, dsn: dsn,
            srv: std::http::Server { port: port, handler: Service { root: root, store: know::Mem { }, protected: know::MemProtected { }, ledger: know::MemLedger { }, leases: know::MemLeaseStore { }, j: dna::GitJournal { repo: root, author: "knowledge" }, receipts: dna::GitReceipts { repo: root } } }
        };
        return;
    }
    let d = know::parse_dsn(dsn);
    if !d.ok { eprintln("hale dna knowledge: HALE_DNA_KNOWLEDGE_DSN: ", d.why); std::process::exit(2); }
    eprintln("hale dna knowledge: postgres at ", d.host, ":", d.port, "/", d.database, ", serving :", port, " over ", root);
    Knowledge {
        root: root, port: port, dsn: dsn,
        srv: std::http::Server { port: port, handler: Service { root: root, store: know::Pq { conn: know::pq_conn(d) }, protected: know::PqProtected { conn: know::pq_conn(d) }, ledger: know::PqLedger { conn: know::pq_conn(d) }, leases: know::PqLeaseStore { conn: know::pq_conn(d) }, j: dna::GitJournal { repo: root, author: "knowledge" }, receipts: dna::GitReceipts { repo: root } } }
    };
}
