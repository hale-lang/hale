// dna/tests/projection_fence_test.hl — two projectors of one record, one
// memory (GH #1026, #1590).
//
// The record is one chain in memory that only grows, and memory's stamp
// is a row of it, so each projector places the stamp by the row at the
// stamp's watermark: a projector whose view is at the stamp has nothing
// to project and leaves the graph as it is; one whose view is ahead
// projects only its delta; and only a stamp that is not the record's row
// at its watermark — a projection of rows rewritten behind memory's
// function — rebuilds the graph from row 0. Memory is Postgres: without
// the owner's DSN in HALE_DNA_MEMORY_DSN_OWNER nothing here is exercised.

import "../core" as dna;
import "../operations" as ops;

fn sh(argv: String) -> dna::RunResult { return dna::run_tool(argv); }

// A projector over the record at `root`, into the memory `spine` opens.
fn projector(root: String, spine: dna::Dsn) -> ops::MemoryProjection {
    return ops::MemoryProjection { root: root, dsn_env: "", store: dna::Pq { conn: dna::pq_conn(spine) }, j: dna::RecordJournal { repo: root, author: "spine" }, receipts: dna::MemoryReceipts { repo: root } };
}

main locus App {
    params { a: String = ""; }
    // `n` rows no receipt is needed for: the code's structure and a
    // signal, as the organism appends them.
    fn rows(from: Int, n: Int) {
        let j = dna::RoutedJournal { record: dna::RecordJournal { repo: self.a }, ledger: dna::MemoryLedger { repo: self.a } };
        let mut k = from;
        while k < from + n {
            std::test::assert(j.append(j.revision(), "structure.observed", "locus:L" + to_string(k), "{\"kind\":\"locus\",\"name\":\"L" + to_string(k) + "\"}").ok, "structure row " + to_string(k));
            std::test::assert(j.append(j.revision(), "pressure.raised", "org/app/w", "backlog x" + to_string(k)).ok, "signal row " + to_string(k));
            k = k + 1;
        }
    }
    fn head() -> String { return dna::RecordJournal { repo: self.a }.head(); }
    fn length() -> Int { return dna::RecordJournal { repo: self.a }.revision(); }
    run() {
        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        if len(owner) == 0 { eprintln("projection_fence_test: not exercised (HALE_DNA_MEMORY_DSN_OWNER is not set)"); return; }
        let scratch = dna::scratch_root("fence");
        self.a = scratch + "/a";
        let mk = sh("sh\n-c\nmkdir -p \"$1/.hale/dna\" && git -C \"$1\" init -q -b main && git -C \"$1\" config user.name t && git -C \"$1\" config user.email t@dna\nsh\n" + self.a);
        std::test::assert_eq_int(mk.code, 0, "a repository: " + mk.stderr);
        std::test::assert_eq_str(dna::memory_fixture(self.a), "", "the record is born in memory (GH #1590)");
        let born = dna::RecordJournal { repo: self.a };
        std::test::assert(born.append(born.revision(), "application.observed", "org", "{}").ok, "the record's first application row");
        let birth = self.length();
        self.rows(0, 3);
        let identity = dna::MemoryRecord { repo: self.a }.identity();
        let spine = dna::migrated(owner, identity);
        std::test::assert(spine.ok, "memory migrates for the record: " + spine.why);
        let store = dna::Pq { conn: dna::pq_conn(spine), record_id: identity };
        std::test::assert(store.open(), "memory opens: " + store.last_error());
        let pa = projector(self.a, spine);
        let pb = projector(self.a, spine);
        // the record's own rows, then the routed signal rows are the
        // Ledger's: the record is at its birth, one application row and
        // three structure rows
        let at = self.length();
        std::test::assert_eq_int(at, birth + 3, "the record holds the structure rows; the signals are the Ledger's");

        // ---- projector a projects the record to its end
        let first = pa.apply();
        std::test::assert_eq_str(first.error, "", "projector a projects");
        std::test::assert_eq_int(store.watermark(), at, "memory stamped at the record's end");
        std::test::assert_eq_str(store.projection_basis().head, self.head(), "at its head");
        let generation = store.graph_generation();

        // ---- projector b reads the record at the stamp: nothing to do
        let level = pb.apply();
        std::test::assert(level.error == "" && level.rows == 0, "at the stamp there is nothing to project: " + level.error);
        std::test::assert(store.watermark() == at && store.graph_generation() == generation, "the graph and its stamp stand");

        // ---- the record grows: projector b projects only the delta
        self.rows(3, 2);
        let ahead = pb.apply();
        std::test::assert(ahead.error == "" && ahead.rows == 2, "projector b projects the two new rows, and only those: " + to_string(ahead.rows) + " " + ahead.error);
        std::test::assert_eq_int(store.watermark(), at + 2, "memory at the record's new end");
        std::test::assert_eq_str(store.projection_basis().head, self.head(), "stamped at the new head");
        let after_b = store.graph_generation();

        // ---- projector a, at the stamp again once it reads the record
        let a_level = pa.apply();
        std::test::assert(a_level.error == "" && a_level.rows == 0 && store.watermark() == at + 2, "and has nothing to project: " + a_level.error);
        std::test::assert_eq_int(store.graph_generation(), after_b, "the graph stands");

        // ---- a stamp that is not the record's row at its watermark: the
        // graph is derived, and is rebuilt from row 0
        let sch = dna::schema_for(identity);
        let forged = sh("psql\n" + owner + "\n-q\n-v\nON_ERROR_STOP=1\n-c\nUPDATE " + sch + ".knowledge_meta SET value = 'not-a-row' WHERE key = 'graph_projection_head'");
        std::test::assert_eq_int(forged.code, 0, "the stamp names no row of the record: " + forged.stderr);
        let rebuilt = pa.apply();
        std::test::assert_eq_str(rebuilt.error, "", "a stamp the record does not hold is rebuilt, not refused");
        std::test::assert_eq_int(store.watermark(), at + 2, "memory at the record's end");
        std::test::assert_eq_str(store.projection_basis().head, self.head(), "stamped at its head");
        std::test::assert(store.graph_generation() > after_b, "the graph was rebuilt");
        std::test::assert_eq_int(store.count("ideas"), 0, "and holds what the record holds");
        std::test::assert_eq_int(store.structure_count("locus"), 5, "every locus the record observed");

        store.close(); pa.store.close(); pb.store.close();
        std::test::assert_eq_str(dna::unmigrate(owner, identity), "", "this run's schema and roles dropped");
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
