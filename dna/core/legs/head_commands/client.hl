type ops_KnowledgeReceipt {
    command_id: String;
    request_id: String;
    application_id: String;
    principal_mode: String;
    principal_name: String;
    operation: String;
    operation_version: String;
    position_id: String;
    target_id: String;
    fingerprint: String;
    state: String;
    edge_id: String;
    event_id: String;
    admission_head: String;
    sequence: Int;
    authority: String;
    authority_basis: String;
    details_visible: Bool;
    node: ops_KnowledgeNodeOutcome;
    binding: ops_KnowledgeBindingOutcome;
    reviewed: Bool;
    relationship: ops_KnowledgeEdgeOutcome;
}

fn api_enc_ops_KnowledgeReceipt(v: ops_KnowledgeReceipt) -> String {
    return "{\"command_id\":" + api_str(v.command_id) + ",\"request_id\":" + api_str(v.request_id) + ",\"application_id\":" + api_str(v.application_id) + ",\"principal_mode\":" + api_str(v.principal_mode) + ",\"principal_name\":" + api_str(v.principal_name) + ",\"operation\":" + api_str(v.operation) + ",\"operation_version\":" + api_str(v.operation_version) + ",\"position_id\":" + api_str(v.position_id) + ",\"target_id\":" + api_str(v.target_id) + ",\"fingerprint\":" + api_str(v.fingerprint) + ",\"state\":" + api_str(v.state) + ",\"edge_id\":" + api_str(v.edge_id) + ",\"event_id\":" + api_str(v.event_id) + ",\"admission_head\":" + api_str(v.admission_head) + ",\"sequence\":" + to_string(v.sequence) + ",\"authority\":" + api_str(v.authority) + ",\"authority_basis\":" + api_str(v.authority_basis) + ",\"details_visible\":" + (if v.details_visible { "true" } else { "false" }) + ",\"node\":" + api_enc_ops_KnowledgeNodeOutcome(v.node) + ",\"binding\":" + api_enc_ops_KnowledgeBindingOutcome(v.binding) + ",\"reviewed\":" + (if v.reviewed { "true" } else { "false" }) + ",\"relationship\":" + api_enc_ops_KnowledgeEdgeOutcome(v.relationship) + "}";
}

fn api_dec_ops_KnowledgeReceipt(json: String) -> ops_KnowledgeReceipt {
    return ops_KnowledgeReceipt {
        command_id: std::json::find_string_field(json, "command_id"),
        request_id: std::json::find_string_field(json, "request_id"),
        application_id: std::json::find_string_field(json, "application_id"),
        principal_mode: std::json::find_string_field(json, "principal_mode"),
        principal_name: std::json::find_string_field(json, "principal_name"),
        operation: std::json::find_string_field(json, "operation"),
        operation_version: std::json::find_string_field(json, "operation_version"),
        position_id: std::json::find_string_field(json, "position_id"),
        target_id: std::json::find_string_field(json, "target_id"),
        fingerprint: std::json::find_string_field(json, "fingerprint"),
        state: std::json::find_string_field(json, "state"),
        edge_id: std::json::find_string_field(json, "edge_id"),
        event_id: std::json::find_string_field(json, "event_id"),
        admission_head: std::json::find_string_field(json, "admission_head"),
        sequence: std::json::find_int_field(json, "sequence"),
        authority: std::json::find_string_field(json, "authority"),
        authority_basis: std::json::find_string_field(json, "authority_basis"),
        details_visible: std::json::find_bool_field(json, "details_visible"),
        node: api_dec_ops_KnowledgeNodeOutcome(std::json::find_field_raw(json, "node")),
        binding: api_dec_ops_KnowledgeBindingOutcome(std::json::find_field_raw(json, "binding")),
        reviewed: std::json::find_bool_field(json, "reviewed"),
        relationship: api_dec_ops_KnowledgeEdgeOutcome(std::json::find_field_raw(json, "relationship")),
    };
}

// Commands::ask_allowance, requires position
type CommandsAskAllowanceOutcome = enum { Result(CommandReply), Refusal(ApiRefusal), ServerError, Lost(String) };

fn commands_ask_allowance(endpoint: String, bearer: String, request: Allowance) -> CommandsAskAllowanceOutcome {
    let raw = api_call(endpoint, bearer, "Commands::ask_allowance", api_enc_Allowance(request));
    if raw.outcome == 0 { return CommandsAskAllowanceOutcome::Result(api_dec_CommandReply(raw.body)); }
    if raw.outcome == 2 { return CommandsAskAllowanceOutcome::Refusal(api_refusal(raw)); }
    if raw.outcome == 3 { return CommandsAskAllowanceOutcome::ServerError; }
    if raw.outcome == 1 { return CommandsAskAllowanceOutcome::Lost("the member has no handler error, and one came: " + raw.body); }
    return CommandsAskAllowanceOutcome::Lost(raw.why);
}

