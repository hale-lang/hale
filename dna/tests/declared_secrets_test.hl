// dna/tests/declared_secrets_test.hl — the secrets a seed declares in its
// manifest (`[dna.secrets.<name>]`): read by the toolchain (`hale dna
// declared-secrets`), each the organism's vault entry `secret-<org>-<name>`,
// handed to the programs that read it through a reader vault of the
// organism's own (`HALE_VAULT_DIR`, `HALE_SECRET_<NAME>`), drawn by the
// organism's bootstrap and never rotated by an upgrade, set by a person
// when it is a slot, and shown only when its person is `read`.
//
// The first part needs nothing but the toolchain; the second grafts an
// organism in this test file's own habitat, when docker compose is on PATH.

import "../core" as dna;
import "../host" as host;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn text_of(path: String) -> String { return std::io::fs::read_file(path) or ""; }

const DECLARED: String = "\n[dna.secrets.operator-token]\nkind = \"drawn\"\nreaders = [\"api\"]\n\n[dna.secrets.upstream-key]\nkind = \"slot\"\nreaders = [\"api\", \"worker\"]\n\n[dna.secrets.dashboard]\nkind = \"drawn\"\nperson = \"read\"\n\n[dna.secrets.shared-note]\nkind = \"slot\"\nperson = \"read\"\n\n[dna.secrets.model-token]\nkind = \"slot\"\nfamily = true\nperson = \"read\"\nreaders = [\"worker\"]\n";

// Run `argv` (newline-separated) in `dir`, with `vault` as the vault and
// no discovery, as compose_projects_test does.
fn in_dir(dir: String, vault: String, argv: String) -> dna::RunResult {
    return dna::run_tool(
        "sh\n-c\ncd \"$1\" && export HALE_VAULT_DIR=\"$2\" HALE_DNA_DISCOVER=off HALE_DNA_NODE_EXPORTER=off HALE_DNA_GRAFANA=off && shift 2 && unset COMPOSE_PROJECT_NAME HALE_VAULT_ADDR && { [ -n \"$HALE_DNA_MEMORY_DSN_OWNER\" ] && [ -n \"$HALE_DNA_NATS_URL_OWNER\" ] || unset HALE_DNA_MEMORY_DSN_OWNER HALE_DNA_NATS_URL_OWNER; } && exec \"$@\"\nsh\n"
            + dir + "\n" + vault + "\n" + argv,
    );
}

// `hale dna secret <sub> <name>` in `dir`, `value` on its stdin.
fn secret_cmd(
    dir: String,
    vault: String,
    sub: String,
    name: String,
    value: String
) -> dna::RunResult {
    return in_dir(
        dir,
        vault,
        "sh\n-c\nprintf %s \"$1\" | \"$2\" dna secret \"$3\" \"$4\"\nsh\n" + value + "\n"
            + toolchain()
            + "\n" + sub + "\n" + name,
    );
}

// `hale dna secret <sub> <name> --member <label>` in `dir`, `value` on its stdin.
fn member_cmd(
    dir: String,
    vault: String,
    sub: String,
    name: String,
    label: String,
    value: String
) -> dna::RunResult {
    return in_dir(
        dir,
        vault,
        "sh\n-c\nprintf %s \"$1\" | \"$2\" dna secret \"$3\" \"$4\" --member \"$5\"\nsh\n" + value
            + "\n"
            + toolchain() + "\n" + sub + "\n" + name + "\n" + label,
    );
}

// Why `hale dna secret <sub> k` is refused for a secret so declared.
fn refusal(sub: String, kind: String, person: String, family: Bool, label: String) -> String {
    return host::declared_secret_refusal(sub, "k", kind, person, family, label);
}

// The file of the organism's entry for its secret `name` in `vault`.
fn entry_of(vault: String, org: String, name: String) -> String {
    return vault + "/" + dna::declared_secret_vault(org, name);
}

fn main() {
    let scratch = dna::scratch_root("declared-secrets");

    // ---- the declaration, as the toolchain reads it
    let seed = scratch + "/seed";
    std::io::fs::mkdir(seed) or discard;
    std::io::fs::write_file(
        seed + "/hale.toml",
        "[dna]\nneeds = [\"memory\"]\n" + DECLARED,
    ) or discard;
    let d = dna::declared_secrets(seed);
    std::test::assert(d.ok, "the declaration is read: " + d.why);
    std::test::assert_eq_str(
        d.lines,
        "dashboard\tdrawn\tread\t\t\t\nmodel-token\tslot\tread\tworker\t\tfamily\noperator-token\tdrawn\tnone\tapi\t\t\nshared-note\tslot\tread\t\t\t\nupstream-key\tslot\twrite\tapi worker\t\t\n",
        "a line a secret: its kind, its person (defaulted), its programs and host commands, a family",
    );
    std::io::fs::write_file(
        seed + "/hale.toml",
        "[dna.secrets.k]\nkind = \"drawn\"\nreaders = [\"host.node\"]\n",
    ) or discard;
    let refused = dna::declared_secrets(seed);
    std::test::assert(
        !refused.ok && std::str::contains(refused.why, "no host command `node`"),
        "a reader that is no host command of the seed's is refused: " + refused.why,
    );
    std::io::fs::unlink(seed + "/hale.toml") or discard;
    std::test::assert(
        dna::declared_secrets(seed).ok && len(dna::declared_secrets(seed).lines) == 0,
        "a seed with no manifest declares none",
    );

    // ---- the entry, the variable, and what the programs are handed
    let org = dna::schema_for("0123456789abcdef0123456789abcdef");
    std::test::assert_eq_str(
        dna::declared_secret_vault(org, "operator-token"),
        "secret-dna_0123456789abcdef0123456789abcdef-operator-token",
        "the vault entry is named for the organism and the secret",
    );
    std::test::assert_eq_str(
        dna::declared_secret_var("upstream-key"),
        "HALE_SECRET_UPSTREAM_KEY",
        "and its readers' variable for the secret",
    );
    // a family's members, by label: the vault's own entries, in order
    let vault = std::secret::vault_local_dir();
    dna::run_tool("mkdir\n-p\n" + vault);
    let work = dna::family_member_vault(org, "model-token", "work");
    let home = dna::family_member_vault(org, "model-token", "home");
    std::test::assert_eq_str(
        work,
        dna::declared_secret_vault(org, "model-token") + "--work",
        "a member's entry is its family's, `--` and its label",
    );
    std::test::assert_eq_str(dna::family_labels(org, "model-token"), "", "a family with no member");
    let no_members = dna::program_secrets(d.lines, org);
    std::io::fs::write_file(vault + "/" + work, "w") or discard;
    std::io::fs::write_file(vault + "/" + home, "h") or discard;
    std::io::fs::write_file(vault + "/" + work + ".tmp", "x") or discard;
    std::test::assert_eq_str(
        dna::family_labels(org, "model-token"),
        "home\nwork\n",
        "a family's members, by label, in order, and nothing else under its name",
    );
    let programs = dna::program_secrets(d.lines, org);
    std::test::assert_eq_str(
        programs,
        "HALE_SECRET_MODEL_TOKEN\t" + home + " " + work + "\nHALE_SECRET_OPERATOR_TOKEN\t"
            + dna::declared_secret_vault(org, "operator-token") + "\nHALE_SECRET_UPSTREAM_KEY\t"
            + dna::declared_secret_vault(org, "upstream-key") + "\n",
        "only a secret some program reads reaches compose, a family with every member",
    );
    std::test::assert(
        std::str::starts_with(no_members, "HALE_SECRET_MODEL_TOKEN\t\n"),
        "a family with no member is handed none: " + no_members,
    );
    std::test::assert_eq_str(
        dna::reader_words(programs, "/r"),
        "HALE_VAULT_DIR=/r HALE_SECRET_MODEL_TOKEN=\"$(printf '%s\\n' '" + home + "' '" + work
            + "')\" HALE_SECRET_OPERATOR_TOKEN='"
            + dna::declared_secret_vault(org, "operator-token")
            + "' HALE_SECRET_UPSTREAM_KEY='" + dna::declared_secret_vault(org, "upstream-key")
            + "' ",
        "compose is handed the reader vault and each entry's name, a family's one a line",
    );
    // what a shell makes of them: a family's variable, its members a line each
    let seen = dna::run_tool(
        dna::reader_wrap(programs, "/r")
            + "sh\n-c\nprintf '%s|' \"$HALE_VAULT_DIR\" \"$HALE_SECRET_MODEL_TOKEN\"",
    );
    std::test::assert_eq_str(
        seen.stdout,
        "/r|" + home + "\n" + work + "|",
        "the command compose is run as sees them: " + seen.stderr,
    );
    std::test::assert_eq_str(
        dna::ssh_reader_env(
            dna::Render { project: "p", secrets: "HALE_SECRET_A\tsecret-x-a\n" },
        ),
        "HALE_VAULT_DIR=\"$HOME/.hale/habitat/p/.vault\" HALE_SECRET_A='secret-x-a' ",
        "on an ssh host, the reader vault beside the render the habitat ships",
    );

    // ---- the reader vault: the entries its programs read and no other,
    // copied file to file, the directory never replaced
    let tok = dna::declared_secret_vault(org, "operator-token");
    let key = dna::declared_secret_vault(org, "upstream-key");
    std::io::fs::write_file(vault + "/" + tok, "drawn-value") or discard;
    std::io::fs::unlink(vault + "/" + key) or discard;
    let reader = scratch + "/reader";
    std::test::assert_eq_str(
        dna::stage_reader_vault(reader, programs),
        "",
        "the reader vault is staged",
    );
    std::test::assert_eq_str(dna::file_mode(reader), "700", "the reader vault is yours alone");
    std::test::assert_eq_str(dna::file_mode(reader + "/" + tok), "600", "and each entry");
    std::test::assert_eq_str(
        text_of(reader + "/" + tok),
        "drawn-value",
        "it holds the vault's value",
    );
    std::test::assert(
        !std::io::fs::file_exists(reader + "/" + key),
        "a slot no person filled is not there",
    );
    std::test::assert(
        text_of(reader + "/" + work) == "w" && text_of(reader + "/" + home) == "h",
        "and each member of a family is",
    );
    let inode = dna::run_tool("ls\n-id\n" + reader).stdout;
    std::io::fs::write_file(reader + "/stale", "x") or discard;
    std::io::fs::write_file(vault + "/" + tok, "rotated") or discard;
    std::test::assert_eq_str(dna::stage_reader_vault(reader, programs), "", "staged again");
    std::test::assert(
        !std::io::fs::file_exists(reader + "/stale") && text_of(reader + "/" + tok) == "rotated",
        "an entry no secret names goes, and a rotated value is rewritten",
    );
    std::test::assert_eq_str(
        dna::run_tool("ls\n-id\n" + reader).stdout,
        inode,
        "in the same directory, which a running service mounts",
    );
    std::io::fs::unlink(vault + "/" + tok) or discard;
    std::io::fs::unlink(vault + "/" + work) or discard;
    std::io::fs::unlink(vault + "/" + home) or discard;
    std::io::fs::unlink(vault + "/" + work + ".tmp") or discard;

    // ---- show: only a secret whose person is `read`
    std::test::assert_eq_str(host::secret_show_refusal("dashboard", "read"), "", "read is shown");
    std::test::assert(
        std::str::contains(
            host::secret_show_refusal("upstream-key", "write"),
            "never reads it back",
        ),
        "a slot a person writes is never shown",
    );
    std::test::assert(
        std::str::contains(
            host::secret_show_refusal("operator-token", "none"),
            "no person touches it",
        ),
        "nor one no person touches",
    );

    // ---- a family's member is named by `--member`, and nothing else is
    std::test::assert(dna::family_label_ok("work"), "work is a label");
    std::test::assert(dna::family_label_ok("personal-1"), "personal-1 is a label");
    std::test::assert(dna::family_label_ok("0"), "a digit first is a label");
    let long = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    std::test::assert(len(long) == 63 && dna::family_label_ok(long), "63 characters is a label");
    std::test::assert(!dna::family_label_ok(long + "a"), "64 is not");
    std::test::assert(!dna::family_label_ok("-x"), "a dash first is not");
    std::test::assert(!dna::family_label_ok("Work"), "an upper-case letter is not");
    std::test::assert(!dna::family_label_ok("a_b"), "an underscore is not");
    std::test::assert(!dna::family_label_ok(""), "nothing is not");
    std::test::assert_eq_str(
        refusal("set", "slot", "write", true, "work"),
        "",
        "a member is set by its label",
    );
    std::test::assert_eq_str(refusal("rotate", "slot", "write", true, "work"), "", "and rotated");
    std::test::assert_eq_str(refusal("remove", "slot", "write", true, "work"), "", "and removed");
    std::test::assert_eq_str(
        refusal("show", "slot", "read", true, "work"),
        "",
        "and shown, when read",
    );
    std::test::assert(
        std::str::contains(refusal("set", "slot", "write", true, ""), "--member <label>"),
        "a family without --member is refused, naming it",
    );
    std::test::assert(
        std::str::contains(refusal("set", "slot", "write", false, "work"), "is no family"),
        "--member on a secret that is no family is refused",
    );
    std::test::assert(
        std::str::contains(
            refusal("set", "slot", "write", true, "Work"),
            "^[a-z0-9][a-z0-9-]{0,62}$",
        ),
        "a label that is none is refused, naming the rule",
    );
    std::test::assert(
        std::str::contains(
            refusal("remove", "slot", "write", false, ""),
            "remove takes a family's member",
        ),
        "remove is a family member's alone",
    );
    std::test::assert(
        std::str::contains(refusal("set", "drawn", "none", false, ""), "is drawn"),
        "a drawn secret is never set",
    );
    std::test::assert(
        std::str::contains(refusal("show", "slot", "write", true, "work"), "never reads it back"),
        "a family a person writes is never shown",
    );

    // ---- an organism of this file's habitat
    let habitat_vault = scratch + "/vault";
    if dna::local_habitat_project() == dna::developer_habitat_project()
        || dna::run_tool("docker\ncompose\nversion").code != 0
    {
        eprintln(
            "declared_secrets_test: the organism's part is not exercised (outside `hale test`, or docker compose is not on PATH)",
        );
        dna::scratch_done(scratch);
        return;
    }
    let born = in_dir(
        scratch,
        habitat_vault,
        toolchain() + "\nhabitat\nup\n--no-body\n--backends\nown",
    );
    std::test::assert_eq_int(
        born.code,
        0,
        "the file's habitat is born: " + born.stdout + born.stderr,
    );
    let name = "declared" + to_string(std::process::pid());
    let made = in_dir(scratch, habitat_vault, toolchain() + "\nhabitat\ngraft\n" + name);
    std::test::assert_eq_int(made.code, 0, "hale habitat graft: " + made.stdout + made.stderr);
    let root = scratch + "/" + name;
    std::io::fs::write_file_append(root + "/hale.toml", DECLARED) or discard;
    let upgraded = in_dir(root, habitat_vault, toolchain() + "\ndna\nupgrade\n.");
    std::test::assert_eq_int(upgraded.code, 0, "upgrade: " + upgraded.stdout + upgraded.stderr);
    let own = dna::schema_for(dna::record_scope(root));
    let drawn = text_of(entry_of(habitat_vault, own, "operator-token"));
    std::test::assert(len(drawn) == 32, "a drawn secret is drawn into the vault");
    std::test::assert_eq_str(
        dna::file_mode(entry_of(habitat_vault, own, "operator-token")),
        "600",
        "its entry is yours alone",
    );
    let listed = in_dir(root, habitat_vault, toolchain() + "\ndna\nsecrets\n.");
    std::test::assert(
        std::str::contains(
            listed.stdout,
            "present  " + dna::declared_secret_vault(own, "operator-token"),
        )
            && std::str::contains(
                listed.stdout,
                "MISSING  " + dna::declared_secret_vault(own, "upstream-key"),
            )
            && std::str::contains(listed.stdout, "`hale dna secret set upstream-key`")
            && std::str::contains(
                listed.stdout,
                "MISSING  " + dna::declared_secret_vault(own, "model-token") + "--<label>",
            )
            && std::str::contains(
                listed.stdout,
                "`hale dna secret set model-token --member <label>`",
            )
            && !std::str::contains(listed.stdout, drawn),
        "`hale dna secrets` lists each declared secret, a missing slot naming its set: "
            + listed.stdout + listed.stderr,
    );
    let again = in_dir(root, habitat_vault, toolchain() + "\ndna\nupgrade\n.");
    std::test::assert(
        again.code == 0 && text_of(entry_of(habitat_vault, own, "operator-token")) == drawn,
        "an upgrade never rotates a drawn secret: " + again.stderr,
    );
    let set_drawn = secret_cmd(root, habitat_vault, "set", "operator-token", "mine");
    std::test::assert(
        set_drawn.code != 0 && std::str::contains(set_drawn.stderr + set_drawn.stdout, "is drawn"),
        "a person never sets a drawn secret: " + set_drawn.stdout + set_drawn.stderr,
    );
    let set_slot = secret_cmd(root, habitat_vault, "set", "upstream-key", "the-key");
    std::test::assert(
        set_slot.code == 0 && text_of(entry_of(habitat_vault, own, "upstream-key")) == "the-key",
        "a slot is set from stdin: " + set_slot.stdout + set_slot.stderr,
    );
    let show_write = secret_cmd(root, habitat_vault, "show", "upstream-key", "");
    std::test::assert(
        show_write.code != 0 && !std::str::contains(show_write.stdout, "the-key"),
        "a slot a person writes is never shown: " + show_write.stdout + show_write.stderr,
    );
    let shown = secret_cmd(root, habitat_vault, "show", "dashboard", "");
    std::test::assert(
        shown.code == 0
            && dna::trim_nl(shown.stdout) == text_of(entry_of(habitat_vault, own, "dashboard")),
        "a secret whose person is read is shown: " + shown.stderr,
    );
    let rotated = secret_cmd(root, habitat_vault, "rotate", "operator-token", "");
    std::test::assert(
        rotated.code == 0 && len(text_of(entry_of(habitat_vault, own, "operator-token"))) == 32
            && text_of(entry_of(habitat_vault, own, "operator-token")) != drawn,
        "rotate draws a drawn secret anew: " + rotated.stdout + rotated.stderr,
    );
    // ---- a family: each member set, listed, shown and removed by its label
    let bare = secret_cmd(root, habitat_vault, "set", "model-token", "t");
    std::test::assert(
        bare.code != 0 && std::str::contains(bare.stderr + bare.stdout, "--member <label>"),
        "a family's member is named: " + bare.stdout + bare.stderr,
    );
    let w = member_cmd(root, habitat_vault, "set", "model-token", "work", "token-w");
    let h = member_cmd(root, habitat_vault, "set", "model-token", "home", "token-h");
    std::test::assert(
        w.code == 0 && h.code == 0
            && text_of(habitat_vault + "/" + dna::family_member_vault(own, "model-token", "work"))
            == "token-w",
        "each member in its own entry: " + w.stdout + w.stderr + h.stdout + h.stderr,
    );
    let members = in_dir(root, habitat_vault, toolchain() + "\ndna\nsecrets\n.");
    std::test::assert(
        std::str::contains(members.stdout, "family `model-token`, read by worker: home, work"),
        "`hale dna secrets` lists the family once, with its members: " + members.stdout,
    );
    let shown_member = member_cmd(root, habitat_vault, "show", "model-token", "home", "");
    std::test::assert(
        shown_member.code == 0 && dna::trim_nl(shown_member.stdout) == "token-h",
        "a member of a family a person reads is shown: " + shown_member.stderr,
    );
    let removed = member_cmd(root, habitat_vault, "remove", "model-token", "home", "");
    std::test::assert(
        removed.code == 0
            && !std::io::fs::file_exists(
                habitat_vault + "/" + dna::family_member_vault(own, "model-token", "home"),
            ),
        "a member is removed: " + removed.stdout + removed.stderr,
    );
    dna::scratch_done(scratch);
}
