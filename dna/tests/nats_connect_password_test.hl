// dna/tests/nats_connect_password_test.hl — the CONNECT line's password
// is spliced in after the line is built (spec/semantics.md § "@sealed").
//
// `NatsClient.connect` reveals a sealed credential straight into the
// CONNECT it writes: `connect_line` is built with an empty `pass`, and
// `with_password` puts the password between the quotes, JSON-escaped.
// The splice finds `"pass": ""` as the Builder writes it; if the Builder
// ever wrote it differently the password would go missing and every
// authenticated connection fail, so this pins the shape.

import "../core/pond/realtime/nats" as nats;

fn main() {
    let bare = nats::connect_line("spine", "", "", "a-name", false);
    std::test::assert(std::str::contains(bare, "\"user\": \"spine\", \"pass\": \"\""), "the Builder writes the empty pass the splice looks for: " + bare);

    let line = nats::with_password(bare, "p\"w\\d");
    std::test::assert(std::str::contains(line, "\"pass\": \"p\\\"w\\\\d\"}"), "the password goes between the quotes, escaped: " + line);
    std::test::assert(std::str::starts_with(line, "CONNECT {") && std::str::ends_with(line, "}\r\n"), "the rest of the line is untouched: " + line);

    // a token connection has no `pass` field: nothing is spliced
    let token = nats::connect_line("", "", "a-token", "a-name", false);
    std::test::assert_eq_str(nats::with_password(token, "unused"), token, "no pass field, no password");
}
