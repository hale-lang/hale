// restart_in_place restores an inline fixed-array param (a downstream
// handoff, a regression in 0.22.0).
//
// A `[T; N]` of scalars is laid out inline in the locus struct: its
// field is the `[N x T]` element bytes, not a pointer to arena storage.
// The copy of the params as built, and the restore from it, loaded that
// field and handed it to the owned-pointer copy, so codegen panicked on
// any closure-bearing locus with such a param: `Bars` below is the
// reported shape (its run() printed `ring[0]`; a passing test is
// silent, so it keeps the value instead). Now an inline array crosses
// slot to slot as bytes.
//
// `Ring` is restarted in place on both paths: once after a failed
// run(), and `Born` once after its birth-epoch closure fails. Each
// mutates its array before failing; after the restart the array is
// what the literal built, mutated once more by the run that passes.

locus Bars {
    params { ring: [Int; 8] = [0; 8]; lag: Int = 0; }
    closure freshness { captures: lag; epoch inline; }
    run() { self.lag = self.ring[0] + 1; }
}

@form(vec)
locus Tries { capacity { heap items of Int; } }

locus Ring {
    params { ring: [Int; 8] = [0; 8]; lag: Int = 0; t: Tries = Tries { }; }
    closure freshness { captures: lag; epoch inline; }
    run() {
        self.t.push(1);
        self.ring[0] = self.ring[0] + 1;
        self.ring[3] = self.ring[3] * 2;
        if self.t.len() < 2 { violate freshness; }
    }
}

locus Born {
    params { ring: [Float; 4] = [0.0; 4]; t: Tries = Tries { }; }
    closure settled { self.t.len() ~~ 2 within 0; epoch birth; }
    birth() {
        self.t.push(1);
        self.ring[1] = self.ring[1] + 1.0;
    }
}

locus Sup {
    params { fired: Int = 0; b: Born = Born { ring: [2.5; 4] }; }
    on_failure(c: Born, err: ClosureViolation) {
        self.fired = self.fired + 1;
        restart_in_place (c) for 3;
    }
}

main locus App {
    params {
        bars: Bars = Bars { };
        r: Ring = Ring { ring: [5; 8] };
        s: Sup = Sup { };
        seen0: Int = 0;
        seen3: Int = 0;
        fired: Int = 0;
    }
    on_failure(c: Ring, err: ClosureViolation) {
        self.fired = self.fired + 1;
        self.seen0 = c.ring[0];
        self.seen3 = c.ring[3];
        restart_in_place (c) for 3;
    }
    run() {
        std::test::assert_eq_int(self.bars.lag, 1, "the reported locus builds and runs");
        // run path: the failing run left 6 and 10; the restore put back
        // 5 and 5, and the passing run made them 6 and 10 again (no
        // restore would leave 7 and 20)
        std::test::assert_eq_int(self.fired, 1, "one failure reached the handler");
        std::test::assert_eq_int(self.seen0, 6, "the failing run's ring[0]");
        std::test::assert_eq_int(self.seen3, 10, "the failing run's ring[3]");
        std::test::assert_eq_int(self.r.ring[0], 6, "ring[0] restored, then one passing run");
        std::test::assert_eq_int(self.r.ring[3], 10, "ring[3] restored, then one passing run");
        std::test::assert_eq_int(self.r.ring[7], 5, "an untouched element keeps the built value");
        std::test::assert_eq_int(self.r.t.len(), 2, "the Tries child is kept");
        // birth path: one failure, then a birth from the restored array
        std::test::assert_eq_int(self.s.fired, 1, "one birth failure reached the handler");
        std::test::assert(self.s.b.ring[1] == 3.5, "ring[1] restored, then one more birth");
        std::test::assert(self.s.b.ring[0] == 2.5, "an untouched element keeps the built value");
    }
}

fn main() { App { }; }
