// dna/tests/habitat_up_test.hl — the local habitat, born, read, stopped and
// brought back (GH #1653).
//
// `hale habitat up` births the habitat the first time from the genome the
// toolchain ships, the one organism with no parent: its record lives in its
// own memory allocation, and the allocations it holds are rows of that
// record, `habitat.allocated` and `habitat.migrated` by organism and role,
// never by checkout. `--foreground` runs its body in the process. An
// organism born beside it is its tenant, recorded in the same record.
// `status` reads the rows; `down` stops the body and every service and
// keeps their data; `up` again brings them back and migrates only the
// habitat's own memory and nerves, never a tenant's. The habitat is this
// test file's own (`hale test` gives each file one). Without docker compose
// nothing here is exercised.

import "../core" as dna;
import "../core/pond/db" as db;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// `argv` in `dir` with no server of anyone else's named: the habitat's
// memory and nerves are its own allocations.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool_timeout(900, "sh\n-c\ncd \"$1\" && shift && unset HALE_DNA_MEMORY_DSN_OWNER HALE_DNA_NATS_URL_OWNER ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// `hale habitat up --foreground` in the background, its output in `log`;
// its pid.
fn up(dir: String, log: String) -> String {
    let started = in_dir(dir, "sh\n-c\nnohup timeout --foreground 900 \"$1\" habitat up --foreground >\"$2\" 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + log);
    return dna::trim_nl(started.stdout);
}

fn text_of(path: String) -> String { return std::io::fs::read_file(path) or ""; }

// How many times `needle` occurs in `text`.
fn occurrences(text: String, needle: String) -> Int {
    let mut n = 0;
    let mut rest = text;
    let mut at = std::str::index_of(rest, needle);
    while at >= 0 {
        n = n + 1;
        rest = rest[(at + len(needle))..len(rest)];
        at = std::str::index_of(rest, needle);
    }
    return n;
}

// Whether `log` comes to say `text` within `secs`.
fn logged(log: String, text: String, secs: Int) -> Bool {
    let deadline = std::time::now() + dna::wait_secs(secs);
    while std::time::now() <= deadline {
        if std::str::contains(text_of(log), text) { return true; }
        std::time::sleep(500ms);
    }
    return false;
}

// The record rows of `kind` the habitat's record holds, a line each.
@bounded_by(genome)
fn rows_of(genome: String, kind: String) -> String {
    let rows = in_dir(genome, toolchain() + "\ndna\nrecord-rows\n.").stdout + "\n";
    let mut out = "";
    let mut rest = rows;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        if std::json::find_string_field(line, "kind") == kind { out = out + line + "\n"; }
    }
    return out;
}

// Whether the habitat's Ledger holds the body lease `token` given back.
@bounded_by(genome)
fn released(genome: String, token: Int) -> Bool {
    let j = dna::RoutedJournal { record: dna::RecordJournal { repo: genome }, ledger: dna::MemoryLedger { repo: genome } };
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "body.released" && std::json::find_int_field(e.body, "token") == token { return true; }
        i = i + 1;
    }
    return false;
}

// The services of the habitat's project, running (`all` false) or not.
fn containers(all: Bool) -> Int {
    let r = dna::run_tool("docker\nps\n" + (if all { "-a\n" } else { "" }) + "-q\n--filter\nlabel=com.docker.compose.project=" + dna::local_habitat_project());
    let mut n = 0;
    let mut rest = r.stdout;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        if nl < 0 { break; }
        if nl > 0 { n = n + 1; }
        rest = rest[(nl + 1)..len(rest)];
    }
    return n;
}

fn main() {
    if dna::run_tool("docker\ncompose\nversion").code != 0 { eprintln("habitat_up_test: not exercised (docker compose is not on PATH)"); return; }
    if dna::local_habitat_project() == dna::developer_habitat_project() { eprintln("habitat_up_test: not exercised (outside `hale test`, the habitat would be the developer's)"); return; }
    let scratch = dna::scratch_root("habitat-up");
    dna::reap_on_exit(scratch);
    let genome = dna::local_habitat_dir() + "/genome";

    // ---- a birth that stops part way, after the identity is pinned
    // (docker unreachable when memory comes up), is resumed by the next
    // `up`, which births it whole
    let stopped = in_dir(scratch, "sh\n-c\nDOCKER_HOST=unix:///nonexistent/docker.sock exec \"$1\" habitat up\nsh\n" + toolchain());
    std::test::assert(stopped.code != 0 && len(dna::allocation_key(genome)) == 12, "the first birth stops after pinning an identity: " + stopped.stdout + stopped.stderr);
    let first_key = dna::allocation_key(genome);

    // ---- born, without a parent, its body in the foreground
    let first = scratch + "/up.log";
    let body = up(scratch, first);
    std::test::assert(len(body) > 0 && logged(first, "body    the habitat's body runs in this process", 600), "the habitat is born and its body runs: " + text_of(first));
    std::test::assert(std::str::contains(text_of(first), "born    the habitat at " + genome + " (the one organism with no parent)") && std::str::contains(text_of(first), "resume  the habitat's earlier birth stopped"), "born from the toolchain's genome, the stopped birth resumed: " + text_of(first));
    std::test::assert(dna::allocation_key(genome) != first_key, "under an identity drawn again, its record in memory");
    std::test::assert(len(rows_of(genome, "habitat.profile")) > 0 && std::str::contains(rows_of(genome, "batch.proposed"), "habitat@1") && std::str::contains(rows_of(genome, "batch.proposed"), "standard@1"), "born whole: its profile and both packs");
    std::test::assert(std::str::contains(text_of(genome + "/README.md"), "`law` **Only the habitat's acts provision.**"), "whose document carries its law");
    let key = dna::allocation_key(genome);
    std::test::assert_eq_int(len(key), 12, "the habitat has a record identity");
    let status = in_dir(scratch, toolchain() + "\nhabitat\nstatus").stdout;
    std::test::assert(std::str::contains(status, "body    up (pid ") && std::str::contains(status, "allocations, as the habitat's record:") && std::str::contains(status, "memory  memory-" + key + " running, schema ") && std::str::contains(status, "(this toolchain's)"), "status reads the habitat's own allocation from its record: " + status);
    let allocated = rows_of(genome, "habitat.allocated");
    std::test::assert(std::str::contains(allocated, "\"entity\": \"" + key + "/memory\"") && std::str::contains(allocated, "\"entity\": \"" + key + "/nerves\""), "its bootstrap allocations are rows of its record: " + allocated);
    std::test::assert(!std::str::contains(allocated, genome) && std::str::contains(allocated, "postgres-owner-" + key), "keyed by organism and role, naming vault slots, never a checkout: " + allocated);

    // ---- a tenant, grafted: born as the habitat's child, its genesis
    // naming the habitat's record, its graft a row of the habitat's
    let made = in_dir(scratch, toolchain() + "\nhabitat\ngraft\ntenant\n--no-library");
    std::test::assert(made.code == 0 && std::str::contains(made.stdout, "as the habitat's child (parent " + key) && std::str::contains(made.stdout, "needs memory, nerves, senses"), "the tenant is grafted: " + made.stdout + made.stderr);
    let tenant = scratch + "/tenant";
    let tkey = dna::allocation_key(tenant);
    let genesis = in_dir(tenant, toolchain() + "\ndna\nrecord-rows\n.").stdout;
    std::test::assert(std::str::contains(genesis, "\"kind\": \"record.genesis\"") && std::str::contains(genesis, "\\\"parent\\\":\\\"" + dna::record_scope(genome) + "\\\""), "its genesis names its parent: " + genesis);
    std::test::assert(std::str::contains(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + tkey + "\""), "and the habitat records the graft");
    // a repository attached, declaring the roles it needs: no senses
    std::io::fs::mkdir(scratch + "/attached") or discard;
    std::io::fs::write_file(scratch + "/attached/README.md", "# attached\n\nA repository grafted as it is.\n") or discard;
    std::io::fs::write_file(scratch + "/attached/hale.toml", "[dna]\nneeds = [\"memory\", \"nerves\"]\n") or discard;
    let attached = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nattached\n--attach\n--no-library");
    std::test::assert(attached.code == 0 && std::str::contains(attached.stdout, "needs memory, nerves)") && !std::str::contains(attached.stdout, "senses  allocated"), "an attached repository gets the roles it declares: " + attached.stdout + attached.stderr);
    // a Hale heart declaring the `database` heart role: a tenant database
    // of its memory server, its DSN naming its vault slot, working
    std::io::fs::mkdir(scratch + "/keeper") or discard;
    std::io::fs::write_file(scratch + "/keeper/README.md", "# keeper\n\nA repository whose heart keeps a store.\n") or discard;
    std::io::fs::write_file(scratch + "/keeper/hale.toml", "[dna]\nneeds = [\"memory\", \"nerves\", \"database\"]\n") or discard;
    let keeper = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nkeeper\n--attach\n--no-library");
    std::test::assert(keeper.code == 0 && std::str::contains(keeper.stdout, "needs memory, nerves, database)") && std::str::contains(keeper.stdout, "database a tenant database of the organism's memory server"), "the database the heart declares is provisioned at graft: " + keeper.stdout + keeper.stderr);
    let kkey = dna::allocation_key(scratch + "/keeper");
    std::test::assert(std::str::contains(rows_of(genome, "habitat.allocated"), "\"entity\": \"" + kkey + "/database\""), "and recorded as its allocation");
    let hp = dna::trim_nl(dna::run_tool(dna::allocation_compose(scratch + "/keeper") + "\nport\nmemory-" + kkey + "\n5432").stdout);
    let role = dna::heart_role(kkey);
    let c = dna::pq_conn(dna::parse_dsn("postgres://" + role + "@" + hp + "/" + role + "?sslmode=disable&vault=" + dna::role_vault_name(role)));
    let opened = c.open();
    let wrote = if opened.ok { c.exec("CREATE TABLE IF NOT EXISTS kept (n int); INSERT INTO kept VALUES (7)") } else { db::ExecResult { } };
    let read = if opened.ok { c.query_one("SELECT n FROM kept") } else { db::Row { } };
    if opened.ok { c.close(); }
    std::test::assert(opened.ok && wrote.ok && read.ok && std::str::contains(read.data, "7"), "the DSN reaches the heart's own database through its slot: " + opened.err.detail + wrote.err.detail + read.err.detail);
    let undeclared = in_dir(scratch, toolchain() + "\nhabitat\nstatus").stdout;
    std::test::assert(!std::str::contains(undeclared, "database-" + tkey) && !std::str::contains(rows_of(genome, "habitat.allocated"), "\"entity\": \"" + tkey + "/database\""), "an undeclared genome gets no database: " + undeclared);
    // a whole graft grafted again goes on where it stopped, which is its
    // end: nothing is born, allocated or recorded twice
    let again = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nattached\n--attach");
    let akey = dna::allocation_key(scratch + "/attached");
    std::test::assert(again.code == 0 && std::str::contains(again.stdout, "the graft goes on where it stopped") && std::str::contains(again.stdout, "kept    the graft of " + akey) && std::str::contains(again.stdout, "kept    the `standard` pack"), "a whole graft keeps everything: " + again.stdout + again.stderr);
    std::test::assert_eq_int(occurrences(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + akey + "\""), 1, "and the habitat records it once");

    // ---- an application under a workspace: the organism is the
    // workspace's, whose manifest declares the database
    std::io::fs::mkdir(scratch + "/ws") or discard;
    std::io::fs::mkdir(scratch + "/ws/app") or discard;
    std::io::fs::write_file(scratch + "/ws/hale.toml", "[dna]\nneeds = [\"memory\", \"nerves\", \"database\"]\n") or discard;
    std::io::fs::write_file(scratch + "/ws/app/main.hl", "main locus Shop { }\n") or discard;
    let ws = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nws/app\n--attach\n--no-library");
    let wkey = dna::allocation_key(scratch + "/ws");
    std::test::assert(ws.code == 0 && len(wkey) == 12 && std::str::contains(ws.stdout, "needs memory, nerves, database)") && std::str::contains(ws.stdout, "database a tenant database of the organism's memory server"), "the workspace's needs are the organism's: " + ws.stdout + ws.stderr);
    std::test::assert(std::str::contains(rows_of(genome, "habitat.allocated"), "\"entity\": \"" + wkey + "/database\"") && !std::io::fs::file_exists(scratch + "/ws/app/hale.toml"), "its database is recorded, and the pin is the workspace's");
    // a workspace pinned to a record that is not this habitat's child is
    // never grafted: nothing re-parents it
    std::io::fs::mkdir(scratch + "/foreign") or discard;
    std::io::fs::mkdir(scratch + "/foreign/app") or discard;
    std::io::fs::write_file(scratch + "/foreign/hale.toml", "[dna]\nrecord = \"" + dna::record_scope(genome) + "\"\n") or discard;
    std::io::fs::write_file(scratch + "/foreign/app/main.hl", "main locus Shop { }\n") or discard;
    let foreign = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nforeign/app\n--attach\n--no-library");
    std::test::assert(foreign.code != 0 && std::str::contains(text_of(scratch + "/foreign/hale.toml"), "record = \"" + dna::record_scope(genome) + "\"") && !std::io::fs::file_exists(scratch + "/foreign/app/hale.toml"), "a workspace pinned to another record is refused, its pin untouched: " + foreign.stdout + foreign.stderr);

    // ---- a clone that keeps no head DSN of its own: memory says whose
    // child its record is before anything is grafted. A clone of the
    // habitat's own genome pins a record born of no parent (or one whose
    // parent memory cannot say), and is refused; a clone of a grafted
    // child pins this habitat's child, and
    // its graft goes on, recorded once
    let cloned = dna::run_tool("sh\n-c\ncd \"$1\" && git -C attached add -A && git -C attached -c user.name=t -c user.email=t@dna commit -qm attached && git clone -q --no-local attached attached-clone && git clone -q --no-local \"$2\" genome-clone\nsh\n" + scratch + "\n" + genome);
    std::test::assert(cloned.code == 0 && !std::io::fs::file_exists(scratch + "/attached-clone/.hale/dna/memory.env") && !std::io::fs::file_exists(scratch + "/genome-clone/.hale/dna/memory.env"), "two clones, neither with a head DSN of its own: " + cloned.stderr);
    let orphan = in_dir(scratch, toolchain() + "\nhabitat\ngraft\ngenome-clone\n--attach\n--no-library");
    std::test::assert(orphan.code != 0 && (std::str::contains(orphan.stderr, "born of no parent, not of this habitat") || std::str::contains(orphan.stderr, "so its parent is not known")) && occurrences(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + key + "\"") == 0, "a record born of no parent is refused, and no graft is recorded: " + orphan.stdout + orphan.stderr);
    let joined = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nattached-clone\n--attach\n--no-library");
    std::test::assert(joined.code == 0 && std::str::contains(joined.stdout, "the graft goes on where it stopped") && std::str::contains(joined.stdout, "kept    the graft of " + akey), "a clone of this habitat's child goes on: " + joined.stdout + joined.stderr);
    std::test::assert_eq_int(occurrences(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + akey + "\""), 1, "and the graft stays one row");

    // ---- a graft stopped part way goes on where it stopped: the first
    // stops at the git config the birth writes (a lock held on it), after
    // the record is pinned; the second at the heart's database (its
    // password's vault slot cannot be written); the third, repaired, ends
    std::io::fs::mkdir(scratch + "/held") or discard;
    std::io::fs::write_file(scratch + "/held/README.md", "# held\n\nA repository whose graft is interrupted.\n") or discard;
    std::io::fs::write_file(scratch + "/held/hale.toml", "[dna]\nneeds = [\"memory\", \"nerves\", \"database\"]\n") or discard;
    let locked = dna::run_tool("sh\n-c\ncd \"$1\" && git init -q -b main && : > .git/config.lock\nsh\n" + scratch + "/held");
    std::test::assert_eq_int(locked.code, 0, "the repository, its config locked: " + locked.stderr);
    let first = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nheld\n--attach\n--no-library");
    let hkey = dna::allocation_key(scratch + "/held");
    std::test::assert(first.code != 0 && len(hkey) == 12 && !std::str::contains(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + hkey + "\""), "the first graft stops after the pin, ungrafted: " + first.stdout + first.stderr);
    let slot = std::secret::vault_local_dir() + "/" + dna::role_vault_name(dna::heart_role(hkey));
    let blocked = dna::run_tool("sh\n-c\nrm -f \"$1/.git/config.lock\" && mkdir -p \"$2\"\nsh\n" + scratch + "/held\n" + slot);
    std::test::assert_eq_int(blocked.code, 0, "the lock goes, and the database's slot is blocked: " + blocked.stderr);
    let second = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nheld\n--attach\n--no-library");
    std::test::assert(second.code != 0 && std::str::contains(second.stderr, "could not be provisioned in the vault") && dna::allocation_key(scratch + "/held") == hkey && !std::str::contains(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + hkey + "\""), "the second goes on, the same record, and stops at the database: " + second.stdout + second.stderr);
    let repaired = dna::run_tool("rmdir\n" + slot);
    std::test::assert_eq_int(repaired.code, 0, "the slot repaired: " + repaired.stderr);
    let third = in_dir(scratch, toolchain() + "\nhabitat\ngraft\nheld\n--attach\n--no-library");
    std::test::assert(third.code == 0 && std::str::contains(third.stdout, "the graft goes on where it stopped") && std::str::contains(third.stdout, "database a tenant database") && std::str::contains(third.stdout, "recorded the graft of " + hkey) && dna::allocation_key(scratch + "/held") == hkey, "the third ends it, the same record: " + third.stdout + third.stderr);
    std::test::assert_eq_int(occurrences(rows_of(genome, "habitat.grafted"), "\"entity\": \"" + hkey + "\""), 1, "and the habitat records it once");
    let with_tenant = in_dir(scratch, toolchain() + "\nhabitat\nstatus").stdout;
    std::test::assert(std::str::contains(with_tenant, "allocation " + tkey + " (" + tenant + ")") && std::str::contains(with_tenant, "memory  memory-" + tkey + " running"), "status names the tenant's allocation: " + with_tenant);
    std::test::assert(std::str::contains(rows_of(genome, "habitat.migrated"), "\"entity\": \"" + tkey + "/memory\""), "the tenant's migration is a row of the habitat's record");

    // ---- down keeps the data; up brings it back, migrating no tenant
    // a birth whose local marker was lost after its genesis reached
    // memory resumes that same identity, its rows intact: memory decides,
    // never the marker
    let rows_before = rows_of(genome, "habitat.allocated");
    std::io::fs::write_file(dna::local_habitat_dir() + "/birth.pending", "") or discard;
    let resumed = in_dir(scratch, toolchain() + "\nhabitat\nup");
    std::test::assert(resumed.code == 0 && std::str::contains(resumed.stdout, "resume  the habitat's record is in memory") && !std::str::contains(resumed.stdout, "born again"), "a born record is resumed, never drawn again: " + resumed.stdout + resumed.stderr);
    std::test::assert(dna::allocation_key(genome) == key && rows_of(genome, "habitat.allocated") == rows_before && !std::io::fs::file_exists(dna::local_habitat_dir() + "/birth.pending"), "the same identity, its rows intact, the birth whole again");
    let down = in_dir(scratch, toolchain() + "\nhabitat\ndown");
    std::test::assert(down.code == 0 && std::str::contains(down.stdout, "its data is kept"), "down stops the habitat: " + down.stdout + down.stderr);
    std::test::assert(containers(false) == 0 && containers(true) > 0, "every service stopped, none removed");
    // memory that cannot be reached, with a birth marked pending, destroys
    // nothing: up refuses, and the identity and its volumes stay
    std::io::fs::write_file(dna::local_habitat_dir() + "/birth.pending", "") or discard;
    let blind = in_dir(scratch, "sh\n-c\nDOCKER_HOST=unix:///nonexistent/docker.sock exec \"$1\" habitat up\nsh\n" + toolchain());
    std::test::assert(blind.code != 0 && std::str::contains(blind.stderr, "nothing is undone on a guess"), "unreachable memory is a refusal: " + blind.stdout + blind.stderr);
    std::test::assert(dna::allocation_key(genome) == key && containers(true) > 0, "and nothing is undone");
    let second = scratch + "/up2.log";
    let again = up(scratch, second);
    std::test::assert(len(again) > 0 && logged(second, "body    the habitat's body runs in this process", 300), "up brings the habitat back: " + text_of(second));
    let back = text_of(second);
    std::test::assert(!std::str::contains(back, "born    ") && std::str::contains(back, "resume  the habitat's record is in memory") && std::str::contains(back, "up      allocation " + tkey + " (" + tenant + ")"), "born once, resumed against its record, and its tenant brought up: " + back);
    std::test::assert(!std::str::contains(back, tenant + "/.hale/dna/memory.env"), "and the tenant is not migrated by up: " + back);
    // the first body drained onto its backends before they stopped: its
    // lease went back in memory
    std::test::assert(released(genome, 1), "the body drained before its backends stopped: its lease went back in memory");
    let after = in_dir(scratch, toolchain() + "\nhabitat\nstatus").stdout;
    std::test::assert(std::str::contains(after, "memory  memory-" + tkey + " running"), "the tenant runs again: " + after);

    let stopped = in_dir(scratch, toolchain() + "\nhabitat\ndown");
    std::test::assert_eq_int(stopped.code, 0, "and down again: " + stopped.stderr);
    dna::scratch_done(scratch);
}
