// GH #2091: a serving `main locus` whose run() polls the drain with a
// sleep loop (`while !self.draining { std::time::sleep(100ms); }`)
// answers each call in the time the call takes, not the time main's
// sleep slice takes. A call a transport delivers for main's queue ends
// the slice's wait as it ends `Handle.wait()`'s, the queue is drained,
// and the sleep goes on for the rest of its length. Before, each call
// waited for main's slice to end: 100 to 250 ms a call.
//
// A main that wakes that fast sends the call after a receiver's failure
// at once: the receiver stops as it fails, so that call is answered
// `unavailable`, never handed to the failed receiver and dropped (the
// hang GH #2091 first showed on CI).

fn app_source(sock: String) -> String {
    return "type Ping { n: Int; }\n"
        + "type Pong { n: Int; }\n"
        + "locus Echo {\n"
        + "    params { seen: Int = 0; }\n"
        + "    closure sane { captures: seen; epoch inline; }\n"
        + "    fn on_ping(p: Ping) -> Pong fallible(ClosureViolation) {\n"
        + "        if p.n < 0 { violate sane; }\n"
        + "        self.seen = self.seen + 1;\n"
        + "        return Pong { n: p.n + 1 };\n"
        + "    }\n"
        + "}\n"
        + "api Public { rpc Echo::on_ping; }\n"
        + "main locus App {\n"
        + "    params { failed: Int = 0; echo: Echo = Echo { }; h: api::Exposure = api::serve(Public, unix::Rpc { path: \""
        + sock
        + "\" }, as: \"public\", receivers: { Echo: self.echo }, bound: 4, on_full: refuse); }\n"
        + "    placement { echo: cooperative(pool = work) where async_io; }\n"
        + "    on_failure(e: Echo, err: ClosureViolation) { self.failed = self.failed + 1; }\n"
        + "    run() {\n"
        + "        while !self.draining { std::time::sleep(100ms); }\n"
        + "        self.h.stop();\n"
        + "    }\n"
        + "}\n"
        + "fn main() { App { }; }\n";
}

locus Proc {
    params {
        child: std::process::Child = std::process::Child { };
    }

    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }

    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                return;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
    }

    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 {
            return false;
        }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }

    fn send(line: String) {
        self.stream.send(line + "\n") or discard;
    }

    // The next complete line, or "" after ~4s without one.
    fn next_line() -> String {
        let mut i = 0;
        while i < 20 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let line = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return line;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                i = i + 1;
            } else {
                self.buf = self.buf + chunk;
            }
        }
        return "";
    }

    fn call(n: Int) -> String {
        self.send(
            "{\"call\":\"Echo::on_ping\",\"payload\":{\"n\":" + to_string(n) + "},\"id\":\"c-"
                + to_string(n) + "\"}",
        );
        return self.next_line();
    }
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let tag = to_string(std::process::pid());
    let sock = "/tmp/hale-api-sleep-loop-" + tag + ".sock";
    let src = std::io::fs::mktemp("/tmp/hale-2091-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source(sock)) or discard;
    let built = std::process::run(hale + "\nbuild\n" + src)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(built.code, 0, "the app builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];
    let p = Proc { };
    std::test::assert(p.start(bin), "the app started");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);

    // The first call warms the connection and the receiver's pool.
    let first = api.call(0);
    std::test::assert(
        std::str::contains(first, "\"ok\":true"),
        "the first call is answered: " + first,
    );

    // Twenty calls one at a time. Each waited for main's 100 ms slice
    // before (about 2 s and more in all); each takes microseconds now,
    // so a whole second is room for a loaded machine.
    let t0 = std::time::monotonic_ns();
    let mut i = 1;
    while i <= 20 {
        let reply = api.call(i);
        std::test::assert(
            std::str::contains(reply, "\"value\":{\"n\":" + to_string(i + 1) + "}"),
            "call " + to_string(i) + " is answered: " + reply,
        );
        i = i + 1;
    }
    let took_ms = (std::time::monotonic_ns() - t0) / 1000000;
    std::test::assert(
        took_ms < 1000,
        "twenty calls take " + to_string(took_ms) + " ms; each waited for main's sleep slice",
    );

    // The receiver fails in a call: that call is the server's error, and
    // the next one, sent the moment the error is read, is `unavailable`
    // (it was handed to the failed receiver, and never answered).
    let failed = api.call(-1);
    std::test::assert(
        std::str::contains(failed, "\"refusal\":{\"kind\":\"server\""),
        "the call the receiver failed in is the server's error: " + failed,
    );
    let after = api.call(30);
    std::test::assert(
        std::str::contains(after, "\"refusal\":{\"kind\":\"unavailable\""),
        "the call after the failure is answered unavailable: " + after,
    );

    p.stop();
    std::io::fs::unlink(src) or discard;
    std::io::fs::unlink(bin) or discard;
}
