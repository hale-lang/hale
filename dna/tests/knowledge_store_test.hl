// dna/tests/knowledge_store_test.hl — GH #583 K1: the knowledge store
// and the record's tail, on Postgres: memory is Postgres (GH #985), each
// store a migrated record of its own under the owner's DSN
// (HALE_DNA_MEMORY_DSN_OWNER); without it nothing here is exercised.
//
// A record with proposals, their ratifications, a declined proposal,
// the code's structure, the fleet's signals and noise is applied into a
// store from the watermark: the ratified ideas are accepted with their
// bindings, the declined one is kept as declined, structure and signals
// are projected (K3) and ranking inside the bound keeps what the work
// is about,
// the watermark advances to the record's end, and applying the same
// record again converges (idempotent by digest). The tower rule holds
// in the store's own query: a goal bound to a parent path reaches the
// child; a sibling's initiative does not. The DSN parser reads every
// shape a tool prints.

import "../core" as dna;
import "../operations" as ops;
import "./knowledge_projection_fidelity" as fidelity_cases;
import "./knowledge_visibility" as visibility_cases;
import "./knowledge_graph_service" as graph_service_cases;
import "./knowledge_graph_store" as graph_store_cases;

// Postgres builds its JSON server-side and Hale's builder spaces its
// separators; both are the same document, so compare without them.
fn compact(j: String) -> String {
    return std::str::replace(std::str::replace(j, "\": ", "\":"), ", \"", ",\"");
}

fn doc(kind: String, text: String, author: String, target: String) -> String {
    return dna::knowledge_document(dna::Idea { kind: kind, text: text, author: author }, target);
}

// The imported service declares a main locus; this test enters App explicitly
// through its existing fn main, retaining the lifecycle dispatch below.
locus App {
    params {
        j: dna::MemJournal = dna::MemJournal { };
        receipts: dna::FileReceipts = dna::FileReceipts { dir: dna::scratch_root("know-receipts") };
        pg: dna::Pq = dna::Pq { };
    }
    @unbounded
    fn exercise(store: dna::KnowledgeStore, label: String) {
        // the record: a goal proposed by a parent for its child, ratified;
        // a sibling's initiative proposed and declined; other rows between
        let d1 = "sha256:" + self.receipts.store(doc("practice", "retry a mail send once", "org/sup", "org/sup/worker"));
        let d2 = "sha256:" + self.receipts.store(doc("idea", "batch the invoices", "org/sup/api", "org/sup/api"));
        // a second practice for the worker, about something else (K3 ranks between them)
        let d3 = "sha256:" + self.receipts.store(doc("practice", "compress the nightly archive before upload", "org/sup", "org/sup/worker"));
        // K3: what the record observed of the code, and the fleet's signals
        let s0 = self.j.append(self.j.revision(), "structure.observed", "locus:Worker", "{\"kind\": \"locus\", \"name\": \"Worker\", \"provenance\": \"observed\"}");
        let s1 = self.j.append(self.j.revision(), "structure.observed", "topic:Fulfil", "{\"kind\": \"topic\", \"name\": \"Fulfil\", \"subject\": \"trio.fulfil\", \"provenance\": \"observed\"}");
        let s2 = self.j.append(self.j.revision(), "structure.observed", "locus:Worker", "{\"kind\": \"locus\", \"name\": \"Worker\", \"sealed\": true, \"provenance\": \"observed\"}");
        let p0 = self.j.append(self.j.revision(), "pressure.raised", "org/sup/worker", "mail backlog x1");
        let p1 = self.j.append(self.j.revision(), "pressure.raised", "org/sup/worker", "mail backlog x2");
        let c0 = self.j.append(self.j.revision(), "concern.raised", "org/sup/worker/mailer", "sends duplicated x1 severity 2");
        let a0 = self.j.append(self.j.revision(), "task.born", "t1", "noise");
        let a1 = self.j.append(self.j.revision(), "knowledge.proposed", d1, "{\"class\": \"goal\", \"target\": \"org/sup/worker\"}");
        let a2 = self.j.append(self.j.revision(), "knowledge.proposed", d2, "{\"class\": \"initiative\", \"target\": \"org/sup/api\"}");
        let a3 = self.j.append(self.j.revision(), "model.called", "x", "noise");
        let a4 = self.j.append(self.j.revision(), "knowledge.ratified", d1, "{\"class\": \"goal\", \"target\": \"org/sup/worker\", \"decided_by\": \"riley\"}");
        let a5 = self.j.append(self.j.revision(), "knowledge.declined", d2, "{\"class\": \"initiative\", \"target\": \"org/sup/api\"}");
        let a6 = self.j.append(self.j.revision(), "knowledge.proposed", d3, "{\"class\": \"goal\", \"target\": \"org/sup/worker\"}");
        let a7 = self.j.append(self.j.revision(), "knowledge.ratified", d3, "{\"class\": \"goal\", \"target\": \"org/sup/worker\", \"decided_by\": \"riley\"}");
        std::test::assert(store.open(), label + ": open: " + store.last_error());
        let r = ops::apply_record(store, self.j, self.receipts);
        std::test::assert_eq_str(r.error, "", label + ": applied clean");
        std::test::assert_eq_int(r.ratified, 2, label + ": two ratified");
        std::test::assert_eq_int(r.proposed, 3, label + ": three proposed");
        std::test::assert_eq_int(r.declined, 1, label + ": one declined");
        std::test::assert_eq_int(r.structure, 3, label + ": three structure rows walked");
        std::test::assert_eq_int(r.signals, 3, label + ": three signal rows walked");
        // the projections: structure keyed by kind and name (the later row wins), signals counted
        std::test::assert_eq_int(store.structure_count(""), 2, label + ": two structure rows (Worker once)");
        std::test::assert_eq_int(store.structure_count("locus"), 1, label + ": one locus");
        std::test::assert_eq_str(store.structure_names("topic"), "Fulfil", label + ": the topic by name");
        let sig = store.signals();
        std::test::assert(std::str::contains(compact(sig), "\"kind\":\"pressure\",\"source\":\"org/sup/worker\",\"what\":\"mail backlog\",\"count\":2"), label + ": pressure counted twice: " + sig);
        std::test::assert(std::str::contains(compact(sig), "\"kind\":\"concern\",\"source\":\"org/sup/worker/mailer\",\"what\":\"sends duplicated\",\"count\":1"), label + ": the concern once: " + sig);
        std::test::assert_eq_int(r.watermark, self.j.revision(), label + ": the watermark is the record's end");
        std::test::assert_eq_int(store.watermark(), self.j.revision(), label + ": and stored");
        let s1 = store.idea(d1);
        std::test::assert(s1.present && s1.idea.accepted && s1.idea.provenance == "ratified" && s1.idea.text == "retry a mail send once", label + ": the ratified idea, by digest");
        std::test::assert_eq_int(s1.ratified_seq, 10, label + ": ratified at row 10");
        let s2 = store.idea(d2);
        std::test::assert(s2.present && !s2.idea.accepted && s2.idea.provenance == "declined", label + ": the declined one, kept as declined");
        std::test::assert_eq_int(store.count("ratified"), 2, label + ": counts");
        std::test::assert_eq_int(store.count("ideas"), 3, label + ": counts");
        std::test::assert_eq_int(store.count("bindings"), 2, label + ": two bindings (the ratified goals)");
        // the tower rule: the goals bound to org/sup/worker reach it and
        // its descendants, in ratification order; org/sup/api sees nothing
        std::test::assert_eq_str(store.context_ids("org/sup/worker", 8), d1 + " " + d3, label + ": the goals reach their target, in order");
        std::test::assert_eq_str(store.context_ids("org/sup/worker/mailer", 8), d1 + " " + d3, label + ": and the target's children");
        std::test::assert_eq_str(store.context_ids("org/sup/api", 8), "", label + ": not a sibling");
        std::test::assert_eq_str(store.context_ids("org/sup", 8), "", label + ": not the parent");
        // K3: ranked inside the bound — the budget keeps what the work is about
        std::test::assert_eq_str(store.ranked_ids("org/sup/worker", 1, dna::embed_text("retry the mail send when it fails")), d1, label + ": a mail objective keeps the mail practice");
        std::test::assert_eq_str(store.ranked_ids("org/sup/worker", 1, dna::embed_text("compress the archive before the upload")), d3, label + ": an archive objective keeps the archive practice");
        std::test::assert_eq_str(store.ranked_ids("org/sup/worker", 8, dna::embed_text("compress the archive")), d3 + " " + d1, label + ": the whole bound, most relevant first");
        std::test::assert_eq_str(store.ranked_ids("org/sup/worker", 8, ""), d1 + " " + d3, label + ": no query is ratification order");
        std::test::assert_eq_str(store.ranked_ids("org/sup/api", 8, dna::embed_text("mail")), "", label + ": ranking never leaves the bound");
        // ---- the shakeout's findings 8, 9 and 12 ----
        // 8: `_` is a SQL LIKE wildcard and an ordinary character in a
        // project name, so `org/orders_api` matched `org/ordersXapi`.
        let du = "sha256:" + self.receipts.store(doc("practice", "invoice before shipping", "org", "org/orders_api"));
        let u1 = self.j.append(self.j.revision(), "knowledge.ratified", du, "{\"class\": \"goal\", \"target\": \"org/orders_api\"}");
        // 9: an ordinary practice is a paragraph, and the driver's rows
        // are tab- and newline-separated with no escaping.
        let dm = "sha256:" + self.receipts.store(doc("practice", "First line\nSecond line\twith a tab", "org/sup", "org/sup/worker"));
        let m1 = self.j.append(self.j.revision(), "knowledge.ratified", dm, "{\"class\": \"goal\", \"target\": \"org/sup/worker\"}");
        let more = ops::apply_record(store, self.j, self.receipts);
        std::test::assert_eq_str(more.error, "", label + ": applied");
        std::test::assert_eq_str(store.context_ids("org/orders_api/worker", 8), du, label + ": the underscored path gets its own practice");
        std::test::assert_eq_str(store.context_ids("org/ordersXapi/worker", 8), "", label + ": and no other path matches it");
        std::test::assert_eq_str(store.context_ids("org/orders_apiary", 8), "", label + ": a longer name is not a child");
        let kept = store.idea(dm);
        std::test::assert_eq_str(kept.idea.text, "First line\nSecond line\twith a tab", label + ": the paragraph survives the transport");
        std::test::assert_eq_str(kept.idea.author, "org/sup", label + ": and the fields after it are not shifted");
        std::test::assert(kept.idea.accepted && kept.idea.provenance == "ratified", label + ": provenance intact");
        // 12: the projection write and the watermark advance are
        // separate, so a crash between them replays the row.
        // The pressure rows were record rows 3 and 4, so the store's
        // last_seq is 4: replaying row 4 is the crash window exactly.
        let before_signals = store.signals();
        std::test::assert(std::str::contains(compact(before_signals), "\"what\":\"mail backlog\",\"count\":2,\"last_seq\":4"), label + ": two raises counted: " + before_signals);
        let replay = store.put_signal("pressure", "org/sup/worker", "mail backlog", 4);
        std::test::assert_eq_str(store.signals(), before_signals, label + ": the same record row twice is one event");
        let older = store.put_signal("pressure", "org/sup/worker", "mail backlog", 3);
        std::test::assert_eq_str(store.signals(), before_signals, label + ": nor does an earlier row count again");

        // applying the same record again converges
        let again = ops::apply_record(store, self.j, self.receipts);
        std::test::assert_eq_int(again.rows, 0, label + ": nothing new to apply");
        std::test::assert_eq_int(store.count("ideas"), 5, label + ": idempotent (three, plus the underscored and the multiline practice)");
        std::test::assert_eq_int(store.structure_count(""), 2, label + ": projections idempotent");
        // the watermark only advances: a row already applied is not begun again
        std::test::assert_eq_int(store.begin_row(2, self.j.read(1).digest, self.j.read(2).digest), 0, label + ": a row already applied is not begun again");
        std::test::assert_eq_int(store.watermark(), self.j.revision(), label + ": and the watermark stands");
    }
    run() {
        // Dispatch in the actual lifecycle entry. Only this isolated child
        // clears private database/Git settings; the parent keeps the owner's
        // DSN and hands it to the child explicitly.
        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        if len(owner) == 0 {
            eprintln("knowledge_store_test: not exercised (HALE_DNA_MEMORY_DSN_OWNER is not set)");
        } else if std::env::arg_or(1, "") == "--graph-service-cases" {
            graph_service_cases::run_cases(owner);
        } else {
            graph_service_cases::run_isolated(owner);
            self.registered_cases(owner);
        }
    }
    fn registered_cases(owner: String) {
        fidelity_cases::run_cases(owner);
        visibility_cases::run_cases(owner);
        graph_store_cases::run_cases(owner);

        // the embedding: deterministic, normalized, lexical
        let e1 = dna::embed_text("retry a mail send once");
        std::test::assert(dna::cosine(e1, dna::embed_text("Retry a MAIL send, once!")) > 0.99, "the same words, however written");
        std::test::assert(dna::cosine(e1, dna::embed_text("compress the nightly archive")) < 0.5, "different words, far");
        std::test::assert(dna::cosine(e1, dna::embed_text("")) == 0.0, "the zero vector");
        std::test::assert(std::str::starts_with(e1, "[") && std::str::ends_with(e1, "]"), "a pgvector literal: " + e1);
        std::test::assert_eq_str(dna::url_decode("retry%20the%20mail%2Fsend+now"), "retry the mail/send now", "the service decodes what the client encodes");

        // the DSN parser
        let d = dna::parse_dsn("postgres://dna:s3cret@db.example:5480/graph?sslmode=require");
        std::test::assert(d.ok && d.user == "dna" && d.password == "s3cret" && d.host == "db.example" && d.port == 5480 && d.database == "graph" && d.sslmode == "require", "a full DSN: " + d.host);
        let d2 = dna::parse_dsn("postgresql://localhost/dna");
        std::test::assert(d2.ok && d2.user == "postgres" && d2.host == "localhost" && d2.port == 5432 && d2.database == "dna" && d2.sslmode == "prefer", "a bare DSN");
        std::test::assert(!dna::parse_dsn("mysql://x").ok, "not postgres");

        // the owner's DSN applies the schema; the store opens as the
        // record's spine role (GH #985). The store is scoped by the
        // record's identity (GH #613): a schema per record, named here
        // for this run.
        let record = "fixture" + to_string(std::process::pid());
        let spine = dna::migrated(owner, record);
        std::test::assert(spine.ok, "the schema is applied: " + spine.why);
        // a locus is structure: built here from the DSN's fields, not handed back by a factory
        self.pg = dna::Pq { conn: dna::pq_conn(spine), record_id: record };
        std::test::assert(self.pg.open(), "postgres opens: " + self.pg.last_error());
        std::test::assert_eq_str(self.pg.schema(), "dna_" + record, "the schema is the record's");
        self.exercise(self.pg, "pq");
        // the store outlives the process: a second connection sees the same graph
        let other = dna::Pq { conn: dna::pq_conn(spine), record_id: record };
        std::test::assert(other.open(), "a second connection opens: " + other.last_error());
        std::test::assert_eq_int(other.watermark(), self.j.revision(), "pq: the watermark is durable");
        std::test::assert_eq_int(other.count("ratified"), 4, "pq: the ratified ideas are there for anyone");
        // a second store over the same record, from zero (a fresh record's
        // schema), reaches the same state and answers the same package
        let fresh_record = record + "fresh";
        let fresh_spine = dna::migrated(owner, fresh_record);
        std::test::assert(fresh_spine.ok, "the fresh store's schema is applied: " + fresh_spine.why);
        let fresh = dna::Pq { conn: dna::pq_conn(fresh_spine), record_id: fresh_record };
        std::test::assert(fresh.open(), "the fresh store opens: " + fresh.last_error());
        let back = ops::apply_record(fresh, self.j, self.receipts);
        std::test::assert_eq_int(back.ratified, 4, "pq: a fresh store replays the record");
        std::test::assert_eq_int(fresh.count("ideas"), 5, "pq: five ideas");
        std::test::assert(fresh.idea("sha256:" + self.receipts.store(doc("practice", "retry a mail send once", "org/sup", "org/sup/worker"))).idea.accepted, "pq: the goal is ratified there too");
        std::test::assert_eq_str(other.context_ids("org/sup/worker/mailer", 8), fresh.context_ids("org/sup/worker/mailer", 8), "the store and a rebuilt one answer the same package");
        // another record on the same database sees none of it: its
        // own schema, its own watermark (GH #613)
        let spine_b = dna::migrated(owner, record + "b");
        std::test::assert(spine_b.ok, "the other record's schema is applied: " + spine_b.why);
        let stranger = dna::Pq { conn: dna::pq_conn(spine_b), record_id: record + "b" };
        std::test::assert(stranger.open(), "a second record opens on the same database: " + stranger.last_error());
        std::test::assert_eq_int(stranger.watermark(), 0, "pq: the other record's watermark is its own");
        std::test::assert_eq_int(stranger.count("ratified"), 0, "pq: the other record has no ideas of the first");
        std::test::assert_eq_str(stranger.context_ids("org/sup/worker/mailer", 8), "", "pq: and an empty package");
        // a schema that names another record is refused, not read
        let tamper = self.pg.conn.exec("UPDATE knowledge_meta SET value = 'someone-else' WHERE key = 'record'");
        std::test::assert(tamper.ok, "tampered: " + tamper.err.detail);
        let wrong = dna::Pq { conn: dna::pq_conn(spine), record_id: record };
        std::test::assert(!wrong.open(), "a schema belonging to another record is refused");
        std::test::assert(std::str::contains(wrong.last_error(), "belongs to record someone-else, not " + record), "and says whose it is: " + wrong.last_error());
        self.pg.close();
        other.close();
        fresh.close();
        stranger.close();
        std::test::assert_eq_str(dna::unmigrate(owner, record), "", "this run's schema and roles dropped");
        std::test::assert_eq_str(dna::unmigrate(owner, fresh_record), "", "the fresh store's schema and roles dropped");
        std::test::assert_eq_str(dna::unmigrate(owner, record + "b"), "", "the other record's schema and roles dropped");
        // the receipts directory is a fixed path (a param default, so it
        // cannot carry this process's pid): removed here, not registered
        // with the slice, since another run may be inside it
        dna::scratch_done("/tmp/dna-know-receipts-" + to_string(std::process::pid()));
    }
}

fn main() { App { }; }
