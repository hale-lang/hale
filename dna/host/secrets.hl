// The organism's secrets (GH #989): the skin's, provisioned in one place.
//
// A secret is provisioned when its owner is declared and consumed when it
// runs. The organism's own — its role passwords, its OIDC client and
// service clients, and the slots for what a person supplies (the forge
// token, the model keys) — are provisioned here, by `hale dna init` and
// `upgrade`, whether or not the part that uses one runs:
//
//   drawn     where the organism owns the value: memory's roles and
//             the compose database's superuser, the nerves' roles, the
//             local OIDC client's secret, each declared service client;
//             random, into the vault
//   a slot    where a person supplies it: the forge token, each model
//             key the catalog names; an empty entry of the vault's that
//             `hale dna secret set` fills
//
// A member's own (a node's account, an application's broker account) is
// provisioned at that member's admission, not here. Everything else only
// consumes a secret, by its vault name, and never creates one: a start
// that finds a drawn secret missing refuses. `hale dna secrets` lists them
// all and says which the vault holds; the board says so for each missing.
//
// The only files that hold a value are the vault's own and, for the
// servers compose runs, dna/nats.secrets.conf and dna/postgres.secrets
// (mode 600, never tracked; the writer refuses a file git tracks or
// would track).

// One secret per line: `<vault name>\t<drawn|slot>\t<what it is>`.
@unbounded
fn organism_secrets(root: String) -> String {
    let id = record_identity(root);
    let mut out = "";
    if len(id) > 0 {
        out = out + dna::role_vault_name(dna::spine_role(id)) + "\tdrawn\tmemory: the spine's role\n";
        out = out + dna::role_vault_name(dna::head_role(id)) + "\tdrawn\tmemory: the head's role\n";
        let seed = compose_seed(root);
        if len(seed) > 0 { out = out + postgres_owner_vault(seed) + "\tdrawn\tmemory: the compose database's superuser (" + POSTGRES_SECRETS + ")\n"; }
        let org = dna::schema_for(id);
        let mut rest = dna::NERVES_ROLES + " ";
        while len(rest) > 0 {
            let sp = std::str::index_of(rest, " ");
            let role = rest[0..sp];
            rest = rest[(sp + 1)..len(rest)];
            out = out + dna::nerves_vault_name(org, role) + "\tdrawn\tthe nerves: the " + role + "'s account\n";
        }
    }
    let client = git_config(root, "dna.oidc.client");
    let issuer = git_config(root, "dna.oidc.issuer");
    let local_issuer = len(issuer) == 0 || std::str::contains(issuer, "://127.0.0.1") || std::str::contains(issuer, "://localhost");
    out = out + oidc_client_vault(if len(client) > 0 { client } else { "dna-local" }) + "\t" + (if local_issuer { "drawn" } else { "slot" }) + "\tthe skin: the head's OIDC client secret" + (if local_issuer { " (the local stub's)" } else { " (issued by " + issuer + ")" }) + "\n";
    let mut services = git_config_all(root, "dna.oidc.service");
    while len(services) > 0 {
        let nl = std::str::index_of(services, "\n");
        let line = if nl < 0 { services } else { services[0..nl] };
        services = if nl < 0 { "" } else { services[(nl + 1)..len(services)] };
        let eq = std::str::index_of(line, "=");
        let service = if eq < 0 { line } else { line[(eq + 1)..len(line)] };
        if len(service) > 0 && !std::str::contains(out, "oidc-service-" + service + "\t") { out = out + "oidc-service-" + service + "\tdrawn\tthe skin: the service client `" + service + "`\n"; }
    }
    out = out + FORGE_TOKEN_VAULT + "\tslot\tthe forge's token (else `gh`'s own login)\n";
    let mut keys = catalog_credentials(root) + " ";
    while len(dna::trim_nl(keys)) > 0 {
        let sp = std::str::index_of(keys, " ");
        let name = keys[0..sp];
        keys = keys[(sp + 1)..len(keys)];
        if len(name) > 0 { out = out + model_key_vault(name) + "\tslot\tthe model's key " + name + "\n"; }
    }
    return out;
}

const FORGE_TOKEN_VAULT: String = "forge-token";
const POSTGRES_SECRETS: String = "dna/postgres.secrets";
fn postgres_owner_vault(seed: String) -> String { return "postgres-owner-" + seed; }

// The seed's own compose project (dna/compose.yaml's `name: hale-dna-<seed>`),
// the `<seed>` alone; "" when there is no compose file, or it names none.
@unbounded
fn compose_seed(root: String) -> String {
    let text = std::io::fs::read_file(root + "/dna/compose.yaml") or "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::starts_with(line, "name: hale-dna-") { return dna::trim_nl(line[15..len(line)]); }
    }
    return "";
}
fn oidc_client_vault(client: String) -> String { return "oidc-client-" + client; }
fn model_key_vault(name: String) -> String { return "model-" + name; }

fn git_config(root: String, key: String) -> String { return dna::trim_nl(dna::run_tool("git\n-C\n" + root + "\nconfig\n--get\n" + key).stdout); }
fn git_config_all(root: String, key: String) -> String { return dna::trim_nl(dna::run_tool("git\n-C\n" + root + "\nconfig\n--get-all\n" + key).stdout); }

fn secret_present(vault: String) -> Bool { return std::secret::Credential { vault: vault }.ready(); }

// The drawn secrets the vault lacks, one vault name a line ("" when none):
// what a start refuses on.
@unbounded
fn missing_drawn(root: String) -> String {
    let mut out = "";
    let mut rest = organism_secrets(root);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let t = std::str::index_of(line, "\t");
        let vault = line[0..t];
        if std::str::contains(line, "\tdrawn\t") && !secret_present(vault) { out = out + vault + "\n"; }
    }
    return out;
}

// A value drawn from urandom (32 hex characters), "" when there is none.
fn draw_secret() -> String {
    let drawn = dna::run_tool("od\n-An\n-tx1\n-N16\n/dev/urandom");
    let value = std::str::replace(std::str::replace(drawn.stdout, " ", ""), "\n", "");
    return if drawn.code == 0 && len(value) == 32 { value } else { "" };
}

// `value` into the local vault as `name`, mode 600 ("" once it holds it).
fn vault_put(name: String, value: String) -> String {
    if !std::secret::vault_name_is_safe(name) { return "the vault name " + name + " is not safe"; }
    let dir = std::secret::vault_local_dir();
    let path = dir + "/" + name;
    if dna::run_tool("sh\n-c\numask 077 && mkdir -p \"$1\" && : > \"$2\"\nsh\n" + dir + "\n" + path).code != 0 { return "cannot write " + path; }
    std::io::fs::write_file(path, value) or discard;
    if len(value) > 0 && !std::secret::Credential { vault: name }.matches(std::bytes::from_string(value)) { return "the vault did not keep " + name; }
    return "";
}

// What provisioning came to.
type Provisioned {
    ok: Bool = false;
    why: String = "";
    report: String = "";
}

// Every secret the organism requires, provisioned: each drawn secret the
// vault lacks drawn into it — the nerves' anew for every role when
// `rotate` (a regenerated seed rotates them), with the server's
// dna/nats.secrets.conf written from the same draw — and each slot named.
// A real vault (`HALE_VAULT_ADDR`) is provisioned out of band: there this
// checks and says what is missing.
@unbounded
fn provision_secrets(root: String, rotate: Bool) -> Provisioned {
    let id = record_identity(root);
    if len(id) == 0 { return Provisioned { why: "the record has no identity yet" }; }
    let real = std::env::var_exists("HALE_VAULT_ADDR");
    let org = dna::schema_for(id);
    let mut report = "";
    // memory's roles
    if !real {
        let pw = dna::provision_record_roles(id, "");
        if len(pw) > 0 { return Provisioned { why: pw }; }
    }
    // the compose database's superuser: the vault's entry and the server's
    // file from one draw, when either is missing
    let seed = compose_seed(root);
    if !real && len(seed) > 0 && (!secret_present(postgres_owner_vault(seed)) || !std::io::fs::file_exists(root + "/" + POSTGRES_SECRETS)) {
        let written = write_postgres_secrets(root, seed);
        if len(written) > 0 { return Provisioned { why: written }; }
        report = report + "memory  the compose database's superuser password in the vault; " + POSTGRES_SECRETS + " written from it (mode 600, untracked)\n";
    }
    // the nerves: every role drawn together, so the server's include and the
    // vault come from one draw
    let nerves_missing = dna::nerves_missing(org);
    let include_missing = !std::io::fs::file_exists(root + "/" + NATS_SECRETS);
    if !real && (rotate || len(nerves_missing) > 0 || include_missing) {
        let written = write_nerves_secrets(root, org);
        if len(written) > 0 { return Provisioned { why: written }; }
        report = report + "nerves  every role's password drawn into the vault; " + NATS_SECRETS + " written (mode 600, untracked)\n";
    }
    // the skin's clients, and the slots
    let mut rest = organism_secrets(root);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let t = std::str::index_of(line, "\t");
        let vault = line[0..t];
        if real || std::str::starts_with(vault, "postgres-") || std::str::starts_with(vault, "nats-") || secret_present(vault) { continue; }
        if std::str::contains(line, "\tdrawn\t") {
            let why = vault_put(vault, draw_secret());
            if len(why) > 0 { return Provisioned { why: why }; }
            report = report + "secret  " + vault + " drawn into the vault\n";
        } else if !std::io::fs::file_exists(std::secret::vault_local_dir() + "/" + vault) {
            let why = vault_put(vault, "");
            if len(why) > 0 { return Provisioned { why: why }; }
            report = report + "secret  " + vault + ": a slot in the vault for a person to fill (`hale dna secret set`)\n";
        }
    }
    let conf = root + "/" + NATS_CONF;
    if (std::io::fs::read_file(conf) or "") != dna::nerves_conf_text() { std::io::fs::write_file(conf, dna::nerves_conf_text()) or discard; }
    let missing = missing_drawn(root);
    if len(missing) > 0 { return Provisioned { why: "the vault lacks " + std::str::replace(dna::trim_nl(missing), "\n", ", ") + (if real { " (a real vault is provisioned out of band)" } else { "" }) }; }
    return Provisioned { ok: true, report: report };
}

// The nerves' passwords, drawn: each role's into the vault and into the
// server's dna/nats.secrets.conf, from the one draw — the only place a
// NATS password is held as a value, and only while it is written. The
// guard: never into a file git tracks or would track, never into the
// tracked conf. A server compose runs is restarted to read them.
@unbounded
fn write_nerves_secrets(root: String, org: String) -> String {
    let refused = untracked_refusal(root, NATS_SECRETS);
    if len(refused) > 0 { return refused; }
    let conf = dna::nerves_conf_text();
    let mut text = "# dna/nats.secrets.conf — the nerves' passwords (GH #989), drawn by the\n# organism's bootstrap into the vault and here; never tracked, mode 600.\n";
    let mut rest = dna::NERVES_ROLES + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let role = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        let value = draw_secret();
        if len(value) == 0 { return "no randomness for the nerves' `" + role + "` password"; }
        if std::str::contains(conf, value) { return "refused: " + NATS_CONF + " would carry a password, and it is a tracked seed file"; }
        let put = vault_put(dna::nerves_vault_name(org, role), value);
        if len(put) > 0 { return put; }
        text = text + dna::nerves_password_var(role) + ": \"" + value + "\"\n";
    }
    let path = root + "/" + NATS_SECRETS;
    let before = std::io::fs::file_exists(path);
    if dna::run_tool("sh\n-c\numask 077 && : > \"$1\" && chmod 600 \"$1\"\nsh\n" + path).code != 0 { return "cannot write " + path; }
    std::io::fs::write_file(path, text) or discard;
    let compose = root + "/dna/compose.yaml";
    if before && std::io::fs::file_exists(compose) {
        let up = dna::run_tool("docker\ncompose\n-f\n" + compose + "\nps\n-q\nnerves");
        if up.code == 0 && len(dna::trim_nl(up.stdout)) > 0 { let r = dna::run_tool("docker\ncompose\n-f\n" + compose + "\nrestart\nnerves"); }
    }
    return "";
}

// The guard: "" when `rel` is a file git neither tracks nor would track,
// else why a password is never written there.
fn untracked_refusal(root: String, rel: String) -> String {
    if dna::run_tool("git\n-C\n" + root + "\nls-files\n--error-unmatch\n" + rel).code == 0 { return "refused: " + rel + " is tracked by git, and a password is never written into a tracked file (`git rm --cached " + rel + "`)"; }
    if dna::run_tool("git\n-C\n" + root + "\ncheck-ignore\n-q\n" + rel).code != 0 { return "refused: " + rel + " is not ignored by git, and a password is never written where git would track it (add /" + rel + " to .gitignore; `hale dna upgrade` does)"; }
    return "";
}

// The compose database's superuser password: dna/postgres.secrets (the
// file compose mounts for the server's POSTGRES_PASSWORD_FILE) holds the
// vault's entry, behind the same guard. The entry is drawn when the vault
// has none; one the vault holds already (another clone of this seed on the
// machine, whose database was made with it) is copied as it is, file to
// file, never read into this program. A database made before holds the
// password it was made with: the server adopts the vault's when memory
// next brings it up (dna/host/infra.hl).
fn write_postgres_secrets(root: String, seed: String) -> String {
    let refused = untracked_refusal(root, POSTGRES_SECRETS);
    if len(refused) > 0 { return refused; }
    let name = postgres_owner_vault(seed);
    if !secret_present(name) {
        let value = draw_secret();
        if len(value) == 0 { return "no randomness for the compose database's password"; }
        let put = vault_put(name, value);
        if len(put) > 0 { return put; }
    }
    let path = root + "/" + POSTGRES_SECRETS;
    if dna::run_tool("sh\n-c\numask 077 && cp \"$1\" \"$2\" && chmod 600 \"$2\"\nsh\n" + std::secret::vault_local_dir() + "/" + name + "\n" + path).code != 0 { return "cannot write " + path; }
    return "";
}

// `secrets-provision [--rotate]`: init's and upgrade's step. What it did,
// a line each, or `none: <why>`.
fn secrets_provision_verb(root: String, rotate: Bool) -> Answer {
    let p = provision_secrets(root, rotate);
    if !p.ok { return answer("none: " + p.why + "\n"); }
    return answer(if len(p.report) > 0 { p.report } else { "secrets the organism's secrets are in the vault\n" });
}

// `hale dna secrets`: every secret the organism requires, and whether the
// vault holds it. Never a value.
@unbounded
fn secrets_status_verb(root: String) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let mut out = "the organism's secrets (" + (if std::env::var_exists("HALE_VAULT_ADDR") { "the vault at " + std::env::var("HALE_VAULT_ADDR") } else { "the local vault, " + std::secret::vault_local_dir() }) + "):\n";
    let mut rest = organism_secrets(root);
    let mut missing = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let t1 = std::str::index_of(line, "\t");
        let vault = line[0..t1];
        let tail = line[(t1 + 1)..len(line)];
        let t2 = std::str::index_of(tail, "\t");
        let kind = tail[0..t2];
        let what = tail[(t2 + 1)..len(tail)];
        let here = secret_present(vault);
        if !here { missing = missing + 1; }
        out = out + "  " + (if here { "present" } else { "MISSING" }) + "  " + vault + "  " + what + (if here { "" } else if kind == "drawn" { " — `hale dna upgrade` draws it" } else { " — a person supplies it: `hale dna secret set " + slot_name(vault) + "`" }) + "\n";
    }
    return answer(out + (if missing == 0 { "every one is in the vault\n" } else { to_string(missing) + " missing\n" }));
}

// What `hale dna secret set` calls a slot: the model key's own name,
// FORGE_TOKEN for the forge's, OIDC_CLIENT_SECRET for the head's client
// an issuer elsewhere issued.
const OIDC_CLIENT_SLOT: String = "OIDC_CLIENT_SECRET";
fn slot_name(vault: String) -> String {
    if vault == FORGE_TOKEN_VAULT { return "FORGE_TOKEN"; }
    if std::str::starts_with(vault, "oidc-client-") { return OIDC_CLIENT_SLOT; }
    if std::str::starts_with(vault, "model-") { return vault[6..len(vault)]; }
    return vault;
}

// The vault entry `hale dna secret set <NAME>` fills: FORGE_TOKEN is the
// forge's, OIDC_CLIENT_SECRET the head's client's (`dna.oidc.client`), any
// other name a model key's slot.
fn slot_vault(root: String, name: String) -> String {
    if name == "FORGE_TOKEN" { return FORGE_TOKEN_VAULT; }
    if name == OIDC_CLIENT_SLOT { let client = git_config(root, "dna.oidc.client"); return oidc_client_vault(if len(client) > 0 { client } else { "dna-local" }); }
    return model_key_vault(name);
}

// The board's lines for the secrets the vault lacks ("" when none). A
// model key is not among them: it may be in the body's environment, and
// the body reports it (`body.credential_missing`).
@unbounded
fn secrets_board(root: String) -> String {
    let mut out = "";
    let mut rest = organism_secrets(root);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let t1 = std::str::index_of(line, "\t");
        let vault = line[0..t1];
        if secret_present(vault) || std::str::starts_with(vault, "model-") { continue; }
        let tail = line[(t1 + 1)..len(line)];
        let t2 = std::str::index_of(tail, "\t");
        let kind = tail[0..t2];
        let what = tail[(t2 + 1)..len(tail)];
        out = out + "secret: " + what + " is not in the vault (" + vault + "); " + (if kind == "drawn" { "`hale dna upgrade` draws it, and nothing starts without it" } else { "`hale dna secret set " + slot_name(vault) + "` fills it" }) + "\n";
    }
    return out;
}
