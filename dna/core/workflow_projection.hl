// dna/core/workflow_projection.hl — the state an execution is in, read
// from its facts and nothing else (DNA workflow card 06;
// dna/WORKFLOW-CONTRACT.md §4, §5, §6, §7, §8).
//
// Every fact card 05 writes is applied here to plain rows. Applying one
// asks nothing of the world: no journal, no bus, no performer, no clock.
// `replay` carries `@no_syscall`, which the compiler checks through every
// method it reaches, and the locus holds no journal, no gateway and no
// model to call — a replay of a thousand facts reaches nothing outside
// this arena. (The contract guards syscall-class effects; the absence of
// anything to call is what rules out the rest.)
//
// The admitted recipe is the authority. An admission carries the whole
// bound tree under its Task, and every later fact is checked against it:
// a Step is one the recipe binds for that Task, a registration names
// exactly the members the recipe bound under that Step (key, kind and
// entity), a Work's allowance is the one bound for it, and a child answers
// only as the Task the recipe bound under that key. A fact the recipe does
// not know is refused, however well-formed.
//
// Every transition has its basis (§5, §7). A Work is done only when its
// current attempt recorded `done`; it fails only after a failed attempt
// with no allowance left, or once its Step has failed or its Task is
// cancelled (the drain policy); it is cancelled only under a cancelled
// Task (the fence). A Step activates only after the one before it
// completed, completes only when every member it registered has settled
// `done`, and fails only on a member that failed. A Task is done only when
// every Step the recipe binds for it completed, and failed only after a
// Step failed and every responsibility it admitted has settled. A
// cancelled Task admits nothing further; what it had admitted still
// records its outcome.
//
// A fact is either the fact already recorded for that identity — the
// same bytes, a replay — or it is not, and then it is checked against the
// state: a different body under a recorded identity is a conflict and is
// refused. That check comes first, so a fact from history is recognized
// as such even after the state has moved past it.
//
// Applying a fact answers one of three things:
//
//   refused  the fact does not belong to this execution, contradicts a
//            recorded one, or has no basis in the state
//   replay   the fact is already recorded; nothing moved
//   applied  the projection moved
//
// Nothing here dispatches, admits or appends. Card 07 admits.

// One Work, as its facts leave it. What the attempt said and what the
// Work settled on are kept apart: a retry clears the attempt's fields, and
// `result` is written only when the Work settles `done`.
type WorkView {
    work_id: String = "";
    step_id: String = "";
    task_id: String = "";
    member_key: String = "";
    allowance: Int = 0; // attempts the recipe bound for it
    attempt_id: String = ""; // the attempt admitted last: the current one
    attempt_no: Int = -1; // -1 until one is admitted (§4 numbers from 0)
    attempt_disposition: String = ""; // "" while the current attempt is outstanding
    attempt_result: String = "";
    attempt_result_ref: String = "";
    disposition: String = ""; // "" until the Work itself settles
    result: String = ""; // the accepted output, once settled done
    result_ref: String = "";
}

// One Step: the members it must have, and the ones it has.
type StepView {
    step_id: String = "";
    task_id: String = "";
    workflow_id: String = "";
    step_index: Int = 0;
    required: String = ""; // every member key, space-separated
    kinds: String = ""; // `<key>:<leaf|child>` per member, as registered
    entities: String = ""; // `<key>=<work id | task id>` per member
    settled: String = ""; // the keys that have settled `done`
    activated: Bool = false;
    disposition: String = "";
    failed_member: String = "";
}

// One Task, from its admission to its settlement.
type TaskView {
    task_id: String = "";
    definition: String = "";
    revision: Int = 0;
    parent_task: String = "";
    spawning_step: String = "";
    member_key: String = "";
    disposition: String = ""; // "" while it runs; `cancelled` stops it
    reason: String = "";
}

// One accepted fact, by identity, as it was recorded: the bytes a later
// row under the same identity is compared against.
type Fact {
    kind: String = "";
    id: String = "";
    body: String = "";
}

@form(vec)
locus WorkViewRows {
    capacity { heap rows of WorkView; }
}

@form(vec)
locus StepViewRows {
    capacity { heap rows of StepView; }
}

@form(vec)
locus TaskViewRows {
    capacity { heap rows of TaskView; }
}

@form(vec)
locus FactRows {
    capacity { heap rows of Fact; }
}

// What applying one fact did. `ok` is false only when the fact does not
// belong here; a replay is `ok` and moved nothing.
type Applied {
    ok: Bool = false;
    changed: Bool = false;
    why: String = "";
}

fn applied() -> Applied {
    return Applied { ok: true, changed: true };
}

fn replayed(why: String) -> Applied {
    return Applied { ok: true, changed: false, why: why };
}

fn refused(why: String) -> Applied {
    return Applied { ok: false, changed: false, why: why };
}

// Whether a space-separated set names this key. The whole key, never a
// prefix of one: `b` is not in `bb c`.
fn set_has(set: String, key: String) -> Bool {
    if len(key) == 0 { return false; }
    return std::str::contains(" " + set + " ", " " + key + " ");
}

fn set_add(set: String, key: String) -> String {
    if set_has(set, key) { return set; }
    if len(set) == 0 { return key; }
    return set + " " + key;
}

// The value after `<key><sep>` in a space-separated map, "" when the map
// does not name the key.
fn map_get(map: String, key: String, sep: String) -> String {
    let rest = " " + map + " ";
    let at = std::str::index_of(rest, " " + key + sep);
    if at < 0 { return ""; }
    let tail = rest[(at + len(key) + len(sep) + 1)..len(rest)];
    let sp = std::str::index_of(tail, " ");
    return if sp < 0 { tail } else { tail[0..sp] };
}

// The member key a Work id carries under its Step: a Work is
// `<step>/<key>` and nothing longer (§4). `<step>/x/a` is not the member
// `a` of that Step — it is not a member of it at all — so the key is read
// against the Step, not off the end of the id.
fn work_key_under(step_id: String, work_id: String) -> String {
    if !id_below(step_id, work_id) { return ""; }
    let key = work_id[(len(step_id) + 1)..len(work_id)];
    if std::str::contains(key, "/") { return ""; }
    return key;
}

// Whether a bound node is `task_id` or lies under it (§4).
fn node_under(id: String, task_id: String) -> Bool {
    if id == task_id { return true; }
    return std::str::starts_with(id, task_id + ".") || std::str::starts_with(id, task_id + "/");
}

// The first field in which two bound nodes differ, "" when none does.
// Every field is immutable once bound: the content a leaf carries as much
// as the ids around it.
fn node_difference(a: BoundNode, b: BoundNode) -> String {
    if a.kind != b.kind { return "kind"; }
    if a.parent != b.parent { return "parent"; }
    if a.spawning_step != b.spawning_step { return "spawning step"; }
    if a.member_key != b.member_key { return "member key"; }
    if a.definition != b.definition { return "definition"; }
    if a.revision != b.revision { return "revision"; }
    if a.workflow_id != b.workflow_id { return "workflow"; }
    if a.step_index != b.step_index { return "step index"; }
    if a.depth != b.depth { return "depth"; }
    if a.path != b.path { return "path"; }
    if a.objective != b.objective { return "objective"; }
    if a.context_digest != b.context_digest { return "context digest"; }
    if a.knowledge_bindings != b.knowledge_bindings { return "knowledge bindings"; }
    if a.output_contract != b.output_contract { return "output contract"; }
    if a.data_class != b.data_class { return "data class"; }
    if a.requires != b.requires { return "requires"; }
    if a.target != b.target { return "target"; }
    if a.cost_ceiling != b.cost_ceiling { return "cost ceiling"; }
    if a.attempts != b.attempts { return "attempt allowance"; }
    return "";
}

// The first field in which an attempt's request departs from the Work
// the recipe bound, "" when none does. Ids and the attempt number are
// the attempt's own (§7); who performs it is the application's choice;
// what the Work IS was bound at admission and is not the attempt's to
// change.
fn request_difference(bound: BoundNode, req: WorkRequest) -> String {
    if bound.objective != req.objective { return "objective"; }
    if bound.context_digest != req.context_digest { return "context digest"; }
    if bound.knowledge_bindings != req.knowledge_bindings { return "knowledge bindings"; }
    if bound.output_contract != req.output_contract { return "output contract"; }
    if bound.data_class != req.data_class { return "data class"; }
    if bound.requires != req.requires { return "requires"; }
    if bound.target != req.target { return "target"; }
    if bound.cost_ceiling != req.cost_ceiling { return "cost ceiling"; }
    return "";
}

// Applying a fact reaches nothing outside this arena. The contract is on
// this one entry point and the checker follows it through every method it
// reaches: a journal append, a performer, a clock or a print anywhere
// under `apply` fails the build here rather than in a review.
@no_syscall
fn replay(p: WorkflowProjection, kind: String, entity: String, body: String) -> Applied {
    return p.apply(kind, entity, body);
}

// The state of one execution, and nothing but. It holds rows; it does not
// hold a journal, a bus, a performer or a clock, so there is nothing here
// for a replay to reach.
locus WorkflowProjection {
    params {
        works: WorkViewRows = WorkViewRows { };
        steps: StepViewRows = StepViewRows { };
        tasks: TaskViewRows = TaskViewRows { };
        facts: FactRows = FactRows { };
        // every node every admission bound, by id: the authority
        tree: BoundNodeRows = BoundNodeRows { };
        // reads one recipe at a time, on its way into `tree`
        reader: WorkflowCatalog = WorkflowCatalog { };
    }

    // ---- what it knows ------------------------------------------------

    fn work_count() -> Int { return self.works.len(); }
    fn step_count() -> Int { return self.steps.len(); }
    fn task_count() -> Int { return self.tasks.len(); }
    fn fact_count() -> Int { return self.facts.len(); }
    fn node_count() -> Int { return self.tree.len(); }

    @unbounded
    fn work(work_id: String) -> WorkView {
        let mut i = 0;
        while i < self.works.len() {
            let w = self.works.get(i) or WorkView { };
            if w.work_id == work_id { return w; }
            i = i + 1;
        }
        return WorkView { };
    }

    @unbounded
    fn step(step_id: String) -> StepView {
        let mut i = 0;
        while i < self.steps.len() {
            let s = self.steps.get(i) or StepView { };
            if s.step_id == step_id { return s; }
            i = i + 1;
        }
        return StepView { };
    }

    @unbounded
    fn task(task_id: String) -> TaskView {
        let mut i = 0;
        while i < self.tasks.len() {
            let t = self.tasks.get(i) or TaskView { };
            if t.task_id == task_id { return t; }
            i = i + 1;
        }
        return TaskView { };
    }

    @unbounded
    fn node(id: String) -> BoundNode {
        let mut i = 0;
        while i < self.tree.len() {
            let n = self.tree.get(i) or BoundNode { };
            if n.id == id { return n; }
            i = i + 1;
        }
        return BoundNode { };
    }

    // The accepted output of one Work, by its id: what the attempt it
    // settled on produced. "" until the Work has settled `done`; what an
    // outstanding or superseded attempt said is never the Work's result.
    fn result_of(work_id: String) -> String {
        let w = self.work(work_id);
        if w.disposition != "done" { return ""; }
        return w.result;
    }

    fn result_ref_of(work_id: String) -> String {
        let w = self.work(work_id);
        if w.disposition != "done" { return ""; }
        return w.result_ref;
    }

    // The members a Step is still waiting for, in registration order.
    @unbounded
    fn pending(step_id: String) -> String {
        let s = self.step(step_id);
        let mut out = "";
        let mut rest = s.required;
        while len(rest) > 0 {
            let sp = std::str::index_of(rest + " ", " ");
            let key = rest[0..sp];
            rest = if sp + 1 >= len(rest) { "" } else { rest[(sp + 1)..len(rest)] };
            if len(key) > 0 && !set_has(s.settled, key) { out = set_add(out, key); }
        }
        return out;
    }

    // Whether every member of a Step's required set has settled `done`.
    // A Step with no required set is not ready: it was never registered.
    fn joined(step_id: String) -> Bool {
        let s = self.step(step_id);
        if len(s.required) == 0 { return false; }
        return len(self.pending(step_id)) == 0;
    }

    // Why a Task admits nothing further, "" when it still does: it has
    // settled, or it or an ancestor was cancelled (§5.5: cancellation
    // fences the whole execution under it). A failed ancestor is not a
    // stop — under the drain policy a member keeps its responsibility
    // until its own outcome — and a settled descendant stops nothing above
    // it.
    @unbounded
    fn stop(task_id: String) -> String {
        let t = self.task(task_id);
        if len(t.disposition) > 0 { return "task " + task_id + " " + t.disposition; }
        let mut up = t.parent_task;
        let mut hops = 0;
        while len(up) > 0 && hops < 64 {
            let anc = self.task(up);
            if anc.disposition == "cancelled" { return "task " + up + ", above " + task_id + ", was cancelled"; }
            up = anc.parent_task;
            hops = hops + 1;
        }
        return "";
    }

    fn stopped(task_id: String) -> Bool {
        return len(self.stop(task_id)) > 0;
    }

    // Whether a Task or an ancestor of it was cancelled: the fence under
    // which an outstanding member settles cancelled.
    fn fenced(task_id: String) -> Bool {
        let why = self.stop(task_id);
        return std::str::contains(why, "cancelled");
    }

    // One line per row, in order: what two projections of one history
    // must agree on, and what an invalid fact must leave as it was.
    @unbounded
    fn digest() -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.tasks.len() {
            let t = self.tasks.get(i) or TaskView { };
            out = out + "task " + t.task_id + " " + t.definition + "@" + to_string(t.revision) + " <" + t.parent_task + " " + t.spawning_step + " " + t.member_key + "> " + t.disposition + " " + t.reason + "\n";
            i = i + 1;
        }
        i = 0;
        while i < self.steps.len() {
            let s = self.steps.get(i) or StepView { };
            out = out + "step " + s.step_id + " [" + s.required + "] {" + s.entities + "} settled [" + s.settled + "] " + (if s.activated { "active " } else { "" }) + s.disposition + " " + s.failed_member + "\n";
            i = i + 1;
        }
        i = 0;
        while i < self.works.len() {
            let w = self.works.get(i) or WorkView { };
            out = out + "work " + w.work_id + " " + w.attempt_id + " " + w.attempt_disposition + " " + w.attempt_result + " | " + w.disposition + " " + w.result + " " + w.result_ref + "\n";
            i = i + 1;
        }
        return out + "facts " + to_string(self.facts.len()) + " nodes " + to_string(self.tree.len()) + "\n";
    }

    // ---- the fact already recorded under an identity ----------------------

    @unbounded
    fn recorded(kind: String, id: String) -> String {
        let mut i = 0;
        while i < self.facts.len() {
            let f = self.facts.get(i) or Fact { };
            if f.kind == kind && f.id == id { return f.body; }
            i = i + 1;
        }
        return "";
    }

    // "" when this fact is new; a replay or a refusal when its identity is
    // already recorded. Checked before the state, so a fact from history
    // is recognized as such after the state has moved past it.
    fn known(kind: String, id: String, body: String) -> Applied {
        let before = self.recorded(kind, id);
        if len(before) == 0 { return Applied { }; }
        if before == body { return replayed(kind + " " + id + " is already recorded"); }
        return refused(kind + " " + id + " is already recorded, and this row says something else");
    }

    fn record(kind: String, id: String, body: String) {
        self.facts.push(Fact { kind: kind, id: id, body: body });
    }

    // Why a row's envelope does not carry this fact, "" when it does: the
    // row's entity is the fact's own identity.
    fn envelope(entity: String, id: String, what: String) -> String {
        if entity == id { return ""; }
        return "the row is about `" + entity + "`; the " + what + " it carries is about `" + id + "`";
    }

    // ---- applying one fact ---------------------------------------------

    @unbounded
    fn apply(kind: String, entity: String, body: String) -> Applied {
        if kind == "workflow.admitted" { return self.admitted(entity, body); }
        if kind == "workflow.refused" { return self.refusal(entity, body); }
        if kind == "step.registered" { return self.registered(entity, body); }
        if kind == "step.activated" { return self.activated(entity, body); }
        if kind == "attempt.admitted" { return self.attempt(entity, body); }
        if kind == "attempt.outcome" { return self.attempt_outcome(entity, body); }
        if kind == "work.settled" { return self.work_settled(entity, body); }
        if kind == "step.completed" || kind == "step.failed" { return self.step_settled(kind, entity, body); }
        if kind == "workflow.settled" { return self.workflow_settled(entity, body); }
        return refused("`" + kind + "` is no fact of a workflow execution");
    }

    // ---- admission: the recipe becomes the authority ------------------

    @unbounded
    fn admitted(entity: String, body: String) -> Applied {
        let read = decode_admission(body);
        if !read.ok { return refused(read.why); }
        let a = read.value;
        let bad = self.envelope(entity, a.task_id, "admission");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("workflow.admitted", a.task_id, body);
        if len(seen.why) > 0 { return seen; }
        if len(self.task(a.task_id).task_id) > 0 {
            return refused("task " + a.task_id + " was already admitted, and this row says something else");
        }
        // the recipe has to be readable whole, and has to bind this Task
        // as the admission describes it
        let gap = self.reader.decode_bound(a.recipe);
        if len(gap) > 0 { return refused("the admission of " + a.task_id + " carries a recipe that cannot be read: " + gap); }
        let root = self.reader.bound_node(a.task_id);
        if root.kind != "task" { return refused("the recipe an admission of " + a.task_id + " carries does not bind that task"); }
        if root.definition != a.definition || root.revision != a.revision {
            return refused("task " + a.task_id + " is bound to " + definition_name(root.definition, root.revision) + ", not " + definition_name(a.definition, a.revision));
        }
        if root.parent != a.parent_task || root.spawning_step != a.spawning_step || root.member_key != a.member_key {
            return refused("task " + a.task_id + " is bound under <" + root.parent + " " + root.spawning_step + " " + root.member_key + ">, not <" + a.parent_task + " " + a.spawning_step + " " + a.member_key + ">");
        }
        // a child is admitted for what its parent bound under it, from a
        // step that is registered and active
        if len(a.parent_task) > 0 {
            if len(self.task(a.parent_task).task_id) == 0 {
                return refused("task " + a.task_id + " names parent " + a.parent_task + ", which was never admitted");
            }
            if self.stopped(a.parent_task) {
                return refused("task " + a.task_id + " names parent " + a.parent_task + ": " + self.stop(a.parent_task) + "; it admits nothing further");
            }
            let bound = self.node(a.task_id);
            if bound.kind != "task" {
                return refused("task " + a.task_id + " is not a task the recipe of " + a.parent_task + " binds");
            }
            if bound.spawning_step != a.spawning_step || bound.member_key != a.member_key || bound.definition != a.definition || bound.revision != a.revision {
                return refused("task " + a.task_id + " is bound by its parent as " + definition_name(bound.definition, bound.revision) + " under <" + bound.spawning_step + " " + bound.member_key + ">");
            }
            let up = self.step(a.spawning_step);
            if len(up.step_id) == 0 { return refused("task " + a.task_id + " is spawned by step " + a.spawning_step + ", which was never registered"); }
            if !up.activated { return refused("task " + a.task_id + " is spawned by step " + a.spawning_step + ", which was never activated"); }
            if len(up.disposition) > 0 { return refused("task " + a.task_id + " is spawned by step " + a.spawning_step + ", which " + up.disposition); }
        }
        // A root's recipe binds a fresh execution: nothing in it may already
        // be bound. A child's recipe is the subtree its parent already
        // bound, exactly — the same nodes, each the same in every field —
        // so a child's admission activates a binding and never redefines
        // the execution its parent admitted, by contradiction or by
        // addition or by omission.
        if len(a.parent_task) == 0 {
            let mut i = 0;
            while i < self.reader.bound_count() {
                let n = self.reader.bound_at(i);
                if len(self.node(n.id).id) > 0 {
                    return refused("the recipe an admission of " + a.task_id + " carries binds " + n.id + ", which is already bound");
                }
                i = i + 1;
            }
            i = 0;
            while i < self.reader.bound_count() {
                self.tree.push(self.reader.bound_at(i));
                i = i + 1;
            }
        } else {
            let gap = self.subtree_gap(a.task_id);
            if len(gap) > 0 { return refused("the recipe an admission of " + a.task_id + " carries " + gap); }
        }
        self.tasks.push(TaskView {
            task_id: a.task_id, definition: a.definition, revision: a.revision,
            parent_task: a.parent_task, spawning_step: a.spawning_step, member_key: a.member_key
        });
        self.record("workflow.admitted", a.task_id, body);
        return applied();
    }

    @unbounded
    fn refusal(entity: String, body: String) -> Applied {
        let read = decode_refusal(body);
        if !read.ok { return refused(read.why); }
        let r = read.value;
        let bad = self.envelope(entity, r.task_id, "refusal");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("workflow.refused", r.task_id, body);
        if len(seen.why) > 0 { return seen; }
        if len(self.task(r.task_id).task_id) > 0 {
            return refused("task " + r.task_id + " was admitted; a refusal does not undo that");
        }
        self.tasks.push(TaskView {
            task_id: r.task_id, definition: r.definition, revision: r.revision,
            parent_task: r.parent_task, spawning_step: r.spawning_step, member_key: r.member_key,
            disposition: "refused", reason: r.why
        });
        self.record("workflow.refused", r.task_id, body);
        return applied();
    }

    // Why the recipe just read is not the subtree already bound under
    // `task_id`, "" when it is: every node it carries is bound, the same
    // in every field, and it carries every node bound there.
    @unbounded
    fn subtree_gap(task_id: String) -> String {
        let mut i = 0;
        while i < self.reader.bound_count() {
            let n = self.reader.bound_at(i);
            if !node_under(n.id, task_id) { return "binds " + n.id + ", which is not under " + task_id; }
            let have = self.node(n.id);
            if len(have.id) == 0 { return "binds " + n.id + ", which its parent never bound under " + task_id; }
            let differs = node_difference(have, n);
            if len(differs) > 0 { return "binds " + n.id + " with another " + differs + " than its parent bound"; }
            i = i + 1;
        }
        let mut bound = 0;
        i = 0;
        while i < self.tree.len() {
            let n = self.tree.get(i) or BoundNode { };
            if node_under(n.id, task_id) {
                bound = bound + 1;
                if self.reader.bound_node(n.id).kind != n.kind { return "leaves out " + n.id + ", which its parent bound under " + task_id; }
            }
            i = i + 1;
        }
        if bound != self.reader.bound_count() { return "binds " + to_string(self.reader.bound_count()) + " node(s) where its parent bound " + to_string(bound); }
        return "";
    }

    // ---- a step: registered against the recipe, activated in order ----

    // The members the recipe bound under one Step, as `<key>:<kind>=<id>`:
    // the Works whose parent it is, and the child Tasks it spawns.
    @unbounded
    fn bound_members(step_id: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.tree.len() {
            let n = self.tree.get(i) or BoundNode { };
            if n.kind == "work" && n.parent == step_id { out = set_add(out, n.member_key + ":leaf=" + n.id); }
            if n.kind == "task" && n.spawning_step == step_id { out = set_add(out, n.member_key + ":child=" + n.id); }
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn registered(entity: String, body: String) -> Applied {
        let read = decode_members(body);
        if !read.ok { return refused(read.why); }
        let m = read.value;
        let bad = self.envelope(entity, m.step_id, "registration");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("step.registered", m.step_id, body);
        if len(seen.why) > 0 { return seen; }
        if len(self.task(m.task_id).task_id) == 0 {
            return refused("step " + m.step_id + " belongs to task " + m.task_id + ", which was never admitted");
        }
        if self.stopped(m.task_id) {
            return refused("step " + m.step_id + " belongs to task " + m.task_id + ": " + self.stop(m.task_id) + "; it admits nothing further");
        }
        let bound = self.node(m.step_id);
        if bound.kind != "step" || bound.parent != m.task_id {
            return refused("step " + m.step_id + " is not a step the recipe binds for task " + m.task_id);
        }
        if bound.step_index != m.step_index || bound.workflow_id != m.workflow_id {
            return refused("step " + m.step_id + " is bound as step " + to_string(bound.step_index) + " of " + bound.workflow_id + ", not step " + to_string(m.step_index) + " of " + m.workflow_id);
        }
        if len(self.step(m.step_id).step_id) > 0 {
            return refused("step " + m.step_id + " was already registered, and this row says something else");
        }
        // the registration names exactly the members the recipe bound
        // under this step: each by key, kind and entity, none missing,
        // none invented
        let bound_set = self.bound_members(m.step_id);
        let mut required = "";
        let mut kinds = "";
        let mut entities = "";
        let mut rest = m.members;
        while len(rest) > 0 {
            let sp = std::str::index_of(rest + " ", " ");
            let one = rest[0..sp];
            rest = if sp + 1 >= len(rest) { "" } else { rest[(sp + 1)..len(rest)] };
            if len(one) == 0 { continue; }
            let c1 = std::str::index_of(one, ":");
            if c1 < 0 { return refused("step " + m.step_id + " registers `" + one + "`, which names no kind and no entity"); }
            let key = one[0..c1];
            let after = one[(c1 + 1)..len(one)];
            let c2 = std::str::index_of(after, ":");
            if c2 < 0 { return refused("step " + m.step_id + " registers `" + one + "`, which names no entity"); }
            let kind = after[0..c2];
            let id = after[(c2 + 1)..len(after)];
            if set_has(required, key) { return refused("step " + m.step_id + " registers `" + key + "` twice"); }
            let want = map_get(bound_set, key + ":" + kind, "=");
            if len(want) == 0 {
                return refused("step " + m.step_id + " registers `" + key + "` as a " + kind + ", which the recipe does not bind under it (it bound `" + bound_set + "`)");
            }
            if want != id {
                return refused("step " + m.step_id + " registers `" + key + "` as " + id + "; the recipe bound " + want);
            }
            required = set_add(required, key);
            kinds = set_add(kinds, key + ":" + kind);
            entities = set_add(entities, key + "=" + id);
        }
        if len(required) == 0 { return refused("step " + m.step_id + " registers no member"); }
        // nothing the recipe bound may be left out
        let mut rest2 = bound_set;
        while len(rest2) > 0 {
            let sp = std::str::index_of(rest2 + " ", " ");
            let one = rest2[0..sp];
            rest2 = if sp + 1 >= len(rest2) { "" } else { rest2[(sp + 1)..len(rest2)] };
            if len(one) == 0 { continue; }
            let key = one[0..std::str::index_of(one, ":")];
            if !set_has(required, key) {
                return refused("step " + m.step_id + " registers `" + required + "` and leaves out `" + key + "`, which the recipe bound under it; a required set is whole");
            }
        }
        self.steps.push(StepView {
            step_id: m.step_id, task_id: m.task_id, workflow_id: m.workflow_id,
            step_index: m.step_index, required: required, kinds: kinds, entities: entities
        });
        self.record("step.registered", m.step_id, body);
        return applied();
    }

    // Whether every step the recipe binds before this one, in this
    // workflow, has completed. "" when it has; else the step still ahead.
    @unbounded
    fn step_ahead(task_id: String, index: Int) -> String {
        let mut i = 0;
        while i < self.tree.len() {
            let n = self.tree.get(i) or BoundNode { };
            if n.kind == "step" && n.parent == task_id && n.step_index < index {
                if self.step(n.id).disposition != "completed" { return n.id; }
            }
            i = i + 1;
        }
        return "";
    }

    @unbounded
    fn activated(entity: String, body: String) -> Applied {
        let read = decode_activation(body);
        if !read.ok { return refused(read.why); }
        let a = read.value;
        let bad = self.envelope(entity, a.step_id, "activation");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("step.activated", a.step_id, body);
        if len(seen.why) > 0 { return seen; }
        let mut i = 0;
        while i < self.steps.len() {
            let s = self.steps.get(i) or StepView { };
            if s.step_id == a.step_id {
                if s.activated { return refused("step " + a.step_id + " was already activated, and this row says something else"); }
                if len(s.disposition) > 0 { return refused("step " + a.step_id + " " + s.disposition + "; it does not activate"); }
                if self.stopped(s.task_id) {
                    return refused("step " + a.step_id + " belongs to task " + s.task_id + ": " + self.stop(s.task_id) + "; nothing further activates");
                }
                let ahead = self.step_ahead(s.task_id, s.step_index);
                if len(ahead) > 0 {
                    return refused("step " + a.step_id + " cannot activate while step " + ahead + " has not completed");
                }
                s.activated = true;
                self.steps.set(i, s) or discard;
                self.record("step.activated", a.step_id, body);
                return applied();
            }
            i = i + 1;
        }
        return refused("step " + a.step_id + " was activated before its members were registered");
    }

    // ---- attempts: first, current, next ---------------------------------

    @unbounded
    fn attempt(entity: String, body: String) -> Applied {
        let read = decode_attempt(body);
        if !read.ok { return refused(read.why); }
        let a = read.value;
        let bad = self.envelope(entity, a.attempt_id, "attempt admission");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("attempt.admitted", a.attempt_id, body);
        if len(seen.why) > 0 { return seen; }
        let gap = self.member_gap(a.step_id, a.work_id);
        if len(gap) > 0 { return refused(gap); }
        let s = self.step(a.step_id);
        if s.task_id != a.task_id { return refused("work " + a.work_id + " belongs to task " + s.task_id + ", not " + a.task_id); }
        if self.stopped(s.task_id) {
            return refused(self.stop(s.task_id) + "; it admits no attempt");
        }
        if !s.activated { return refused("work " + a.work_id + " cannot be attempted before step " + a.step_id + " is activated"); }
        if len(s.disposition) > 0 { return refused("work " + a.work_id + " cannot be attempted after step " + a.step_id + " " + s.disposition); }
        let bound = self.node(a.work_id);
        let departs = request_difference(bound, a.request);
        if len(departs) > 0 {
            return refused("attempt " + a.attempt_id + " asks for another " + departs + " than the recipe bound for " + a.work_id);
        }
        if a.attempt_no >= bound.attempts {
            return refused("attempt " + a.attempt_id + " exhausts the allowance of " + to_string(bound.attempts) + " the recipe bound for " + a.work_id);
        }
        let mut i = 0;
        while i < self.works.len() {
            let w = self.works.get(i) or WorkView { };
            if w.work_id == a.work_id {
                if len(w.disposition) > 0 {
                    return refused("work " + a.work_id + " settled " + w.disposition + "; a settled Work is not attempted again");
                }
                if a.attempt_no <= w.attempt_no {
                    return refused("attempt " + a.attempt_id + " was superseded by " + w.attempt_id);
                }
                if a.attempt_no != w.attempt_no + 1 {
                    return refused("attempt " + a.attempt_id + " skips attempt " + to_string(w.attempt_no + 1) + " of " + a.work_id);
                }
                if len(w.attempt_disposition) == 0 {
                    return refused("attempt " + w.attempt_id + " is still outstanding; " + a.work_id + " is not retried until its outcome is recorded");
                }
                if w.attempt_disposition == "done" {
                    return refused("attempt " + w.attempt_id + " was done; a Work that succeeded is not retried");
                }
                w.attempt_id = std::str::clone(a.attempt_id);
                w.attempt_no = a.attempt_no;
                w.attempt_disposition = "";
                w.attempt_result = "";
                w.attempt_result_ref = "";
                self.works.set(i, w) or discard;
                self.record("attempt.admitted", a.attempt_id, body);
                return applied();
            }
            i = i + 1;
        }
        if a.attempt_no != 0 {
            return refused("attempt " + a.attempt_id + " is not the first attempt of " + a.work_id + "; that is " + attempt_id_of(a.work_id, 0));
        }
        self.works.push(WorkView {
            work_id: a.work_id, step_id: a.step_id, task_id: a.task_id,
            member_key: work_key_under(a.step_id, a.work_id), allowance: bound.attempts,
            attempt_id: a.attempt_id, attempt_no: a.attempt_no
        });
        self.record("attempt.admitted", a.attempt_id, body);
        return applied();
    }

    // An outcome is recorded for the current attempt, once — under a
    // cancelled Task too: what was admitted still says how it ended.
    @unbounded
    fn attempt_outcome(entity: String, body: String) -> Applied {
        let read = decode_attempt_outcome(body);
        if !read.ok { return refused(read.why); }
        let o = read.value;
        let bad = self.envelope(entity, o.attempt_id, "attempt outcome");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("attempt.outcome", o.attempt_id, body);
        if len(seen.why) > 0 { return seen; }
        let mut i = 0;
        while i < self.works.len() {
            let w = self.works.get(i) or WorkView { };
            if w.work_id == o.work_id {
                if w.attempt_id != o.attempt_id {
                    return refused("attempt " + o.attempt_id + " was superseded by " + w.attempt_id + "; its outcome decides nothing");
                }
                if len(w.attempt_disposition) > 0 {
                    return refused("attempt " + o.attempt_id + " was " + w.attempt_disposition + "; an attempt has one outcome");
                }
                w.attempt_disposition = std::str::clone(o.disposition);
                w.attempt_result = std::str::clone(o.result);
                w.attempt_result_ref = std::str::clone(o.result_ref);
                self.works.set(i, w) or discard;
                self.record("attempt.outcome", o.attempt_id, body);
                return applied();
            }
            i = i + 1;
        }
        return refused("work " + o.work_id + " was never attempted");
    }

    // ---- a Work settles on its basis --------------------------------------

    @unbounded
    fn work_settled(entity: String, body: String) -> Applied {
        let read = decode_work_outcome(body);
        if !read.ok { return refused(read.why); }
        let o = read.value;
        let bad = self.envelope(entity, o.work_id, "work outcome");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("work.settled", o.work_id, body);
        if len(seen.why) > 0 { return seen; }
        let gap = self.member_gap(o.step_id, o.work_id);
        if len(gap) > 0 { return refused(gap); }
        let mut i = 0;
        while i < self.works.len() {
            let w = self.works.get(i) or WorkView { };
            if w.work_id == o.work_id {
                if w.step_id != o.step_id {
                    return refused("work " + o.work_id + " is a member of step " + w.step_id + ", not " + o.step_id);
                }
                if w.attempt_id != o.attempt_id {
                    return refused("work " + o.work_id + " ran attempt " + w.attempt_id + "; it cannot settle on " + o.attempt_id);
                }
                if len(w.disposition) > 0 {
                    return refused("work " + o.work_id + " settled " + w.disposition + "; a settled Work does not settle again");
                }
                let basis = self.settlement_basis(w, o.disposition);
                if len(basis) > 0 { return refused(basis); }
                w.disposition = std::str::clone(o.disposition);
                if o.disposition == "done" {
                    w.result = std::str::clone(w.attempt_result);
                    w.result_ref = if len(o.result_ref) > 0 { std::str::clone(o.result_ref) } else { std::str::clone(w.attempt_result_ref) };
                }
                self.works.set(i, w) or discard;
                self.record("work.settled", o.work_id, body);
                if o.disposition == "done" {
                    let j = self.join(o.step_id, w.member_key);
                    if !j.ok { return j; }
                    return Applied { ok: true, changed: true, why: j.why };
                }
                return applied();
            }
            i = i + 1;
        }
        return refused("work " + o.work_id + " was never attempted");
    }

    // Why a Work may not settle this way on its current attempt, "" when it
    // may (§5, §7). Done needs the attempt's `done`. Failed needs a failed
    // attempt and no allowance left — or a Step already failed or a Task
    // already cancelled, under which a member records its outcome and
    // stops (the drain). Cancelled needs the cancelled Task (the fence).
    fn settlement_basis(w: WorkView, disposition: String) -> String {
        if disposition == "done" {
            if w.attempt_disposition != "done" {
                if len(w.attempt_disposition) == 0 { return "work " + w.work_id + " cannot settle done: attempt " + w.attempt_id + " is still outstanding"; }
                return "work " + w.work_id + " cannot settle done: attempt " + w.attempt_id + " " + w.attempt_disposition;
            }
            return "";
        }
        let step = self.step(w.step_id);
        if disposition == "cancelled" {
            if !self.fenced(w.task_id) { return "work " + w.work_id + " cannot settle cancelled: neither task " + w.task_id + " nor anything above it was cancelled"; }
            return "";
        }
        if disposition == "failed" {
            if len(w.attempt_disposition) == 0 { return "work " + w.work_id + " cannot settle failed: attempt " + w.attempt_id + " is still outstanding"; }
            if w.attempt_disposition == "done" { return "work " + w.work_id + " cannot settle failed: attempt " + w.attempt_id + " was done"; }
            let exhausted = w.attempt_no + 1 >= w.allowance;
            let draining = step.disposition == "failed" || self.fenced(w.task_id);
            if !exhausted && !draining {
                return "work " + w.work_id + " cannot settle failed with " + to_string(w.allowance - w.attempt_no - 1) + " attempt(s) of its allowance left";
            }
            return "";
        }
        return "a work is done, failed or cancelled, not `" + disposition + "`";
    }

    // A member that settled `done` joins its Step's settled set, once, by
    // its key. Two answers from one member are one member.
    @unbounded
    fn join(step_id: String, key: String) -> Applied {
        let mut i = 0;
        while i < self.steps.len() {
            let s = self.steps.get(i) or StepView { };
            if s.step_id == step_id {
                if set_has(s.settled, key) { return replayed("member `" + key + "` of step " + step_id + " had already answered"); }
                s.settled = set_add(s.settled, key);
                self.steps.set(i, s) or discard;
                return applied();
            }
            i = i + 1;
        }
        return refused("step " + step_id + " was never registered");
    }

    // ---- a Step settles on its members ----------------------------------

    @unbounded
    fn step_settled(kind: String, entity: String, body: String) -> Applied {
        let read = decode_step_outcome(body);
        if !read.ok { return refused(read.why); }
        let o = read.value;
        let bad = self.envelope(entity, o.step_id, "step outcome");
        if len(bad) > 0 { return refused(bad); }
        // the row's kind and the fact's disposition are one statement
        if (kind == "step.completed" && o.disposition != "completed") || (kind == "step.failed" && o.disposition != "failed") {
            return refused("a `" + kind + "` row carries a step that " + o.disposition);
        }
        let seen = self.known(kind, o.step_id, body);
        if len(seen.why) > 0 { return seen; }
        let mut i = 0;
        while i < self.steps.len() {
            let s = self.steps.get(i) or StepView { };
            if s.step_id == o.step_id {
                if len(s.disposition) > 0 {
                    return refused("step " + o.step_id + " " + s.disposition + "; a settled Step does not settle again");
                }
                if !s.activated { return refused("step " + o.step_id + " was never activated; it does not settle"); }
                if o.disposition == "completed" && !self.joined(o.step_id) {
                    return refused("step " + o.step_id + " still waits for `" + self.pending(o.step_id) + "`");
                }
                if o.disposition == "failed" {
                    if !set_has(s.required, o.failed_member) {
                        return refused("step " + o.step_id + " has no member `" + o.failed_member + "`");
                    }
                    let why = self.failure_basis(s, o.failed_member);
                    if len(why) > 0 { return refused(why); }
                }
                s.disposition = std::str::clone(o.disposition);
                s.failed_member = std::str::clone(o.failed_member);
                self.steps.set(i, s) or discard;
                self.record(kind, o.step_id, body);
                return applied();
            }
            i = i + 1;
        }
        return refused("step " + o.step_id + " was never registered");
    }

    // Why this member has not failed its Step, "" when it has: a leaf's
    // Work settled failed, or a child's Task settled failed.
    fn failure_basis(s: StepView, key: String) -> String {
        let id = map_get(s.entities, key, "=");
        let kind = map_get(s.kinds, key, ":");
        if kind == "leaf" {
            let w = self.work(id);
            if w.disposition == "failed" { return ""; }
            if len(w.disposition) == 0 { return "step " + s.step_id + " cannot fail on `" + key + "`: work " + id + " has not settled"; }
            return "step " + s.step_id + " cannot fail on `" + key + "`: work " + id + " settled " + w.disposition;
        }
        let t = self.task(id);
        if t.disposition == "failed" { return ""; }
        if len(t.disposition) == 0 { return "step " + s.step_id + " cannot fail on `" + key + "`: task " + id + " has not settled"; }
        return "step " + s.step_id + " cannot fail on `" + key + "`: task " + id + " " + t.disposition;
    }

    // ---- an execution settles on its steps ---------------------------------

    @unbounded
    fn workflow_settled(entity: String, body: String) -> Applied {
        let read = decode_workflow_outcome(body);
        if !read.ok { return refused(read.why); }
        let o = read.value;
        let bad = self.envelope(entity, o.task_id, "workflow outcome");
        if len(bad) > 0 { return refused(bad); }
        let seen = self.known("workflow.settled", o.task_id, body);
        if len(seen.why) > 0 { return seen; }
        let mut i = 0;
        while i < self.tasks.len() {
            let t = self.tasks.get(i) or TaskView { };
            if t.task_id == o.task_id {
                if len(t.disposition) > 0 {
                    return refused("task " + o.task_id + " " + t.disposition + "; a settled execution does not settle again");
                }
                // the settlement may not redirect the answer: where a
                // child answers is where it was admitted from
                if len(o.parent_task) > 0 && o.parent_task != t.parent_task {
                    return refused("task " + o.task_id + " was admitted under " + t.parent_task + ", not " + o.parent_task);
                }
                if len(o.spawning_step) > 0 && o.spawning_step != t.spawning_step {
                    return refused("task " + o.task_id + " answers step " + t.spawning_step + ", not " + o.spawning_step);
                }
                let basis = self.task_basis(t, o.disposition);
                if len(basis) > 0 { return refused(basis); }
                // §6: a child answers the step that invoked it by settling
                // done. Whether its parent can receive that is decided
                // before the child moves, so a refusal leaves nothing
                // half-applied.
                let answers = o.disposition == "done" && len(t.spawning_step) > 0 && len(t.member_key) > 0;
                if answers {
                    let gap = self.child_gap(t.spawning_step, t.member_key, t.task_id);
                    if len(gap) > 0 { return refused(gap); }
                }
                let up = std::str::clone(t.spawning_step);
                let key = std::str::clone(t.member_key);
                t.disposition = std::str::clone(o.disposition);
                t.reason = std::str::clone(o.reason);
                self.tasks.set(i, t) or discard;
                self.record("workflow.settled", o.task_id, body);
                if answers {
                    let j = self.join(up, key);
                    if !j.ok { return j; }
                    return Applied { ok: true, changed: true, why: j.why };
                }
                return applied();
            }
            i = i + 1;
        }
        return refused("task " + o.task_id + " was never admitted");
    }

    // Why a Task may not settle this way, "" when it may (§5, §6). Done
    // needs every step the recipe binds for it completed. Failed needs a
    // step that failed, and every responsibility it admitted — every Work
    // attempted, every child admitted — settled: the root settles last.
    // Cancelled is the stop, and needs nothing: it fences what is
    // outstanding, which then records its own outcome.
    @unbounded
    fn task_basis(t: TaskView, disposition: String) -> String {
        if disposition == "cancelled" { return ""; }
        if disposition != "done" && disposition != "failed" {
            return "a workflow is done, failed or cancelled, not `" + disposition + "`";
        }
        let mut steps_bound = 0;
        let mut failed = "";
        let mut incomplete = "";
        let mut i = 0;
        while i < self.tree.len() {
            let n = self.tree.get(i) or BoundNode { };
            if n.kind == "step" && n.parent == t.task_id {
                steps_bound = steps_bound + 1;
                let s = self.step(n.id);
                if s.disposition == "failed" && len(failed) == 0 { failed = std::str::clone(n.id); }
                if s.disposition != "completed" && len(incomplete) == 0 { incomplete = std::str::clone(n.id); }
            }
            i = i + 1;
        }
        if steps_bound == 0 { return "task " + t.task_id + " has no step bound; it cannot settle"; }
        if disposition == "done" {
            if len(incomplete) > 0 { return "task " + t.task_id + " cannot settle done: step " + incomplete + " has not completed"; }
            return "";
        }
        if len(failed) == 0 { return "task " + t.task_id + " cannot settle failed: no step of it failed"; }
        // the drain: what was admitted has said how it ended
        i = 0;
        while i < self.works.len() {
            let w = self.works.get(i) or WorkView { };
            if w.task_id == t.task_id && len(w.disposition) == 0 {
                return "task " + t.task_id + " cannot settle failed while work " + w.work_id + " is outstanding";
            }
            i = i + 1;
        }
        i = 0;
        while i < self.tasks.len() {
            let c = self.tasks.get(i) or TaskView { };
            if c.parent_task == t.task_id && len(c.disposition) == 0 {
                return "task " + t.task_id + " cannot settle failed while child " + c.task_id + " is outstanding";
            }
            i = i + 1;
        }
        return "";
    }

    // ---- who may answer for a member --------------------------------------

    // Why this Work is not a leaf member of that Step, "" when it is. The
    // Step has to be registered, the Work has to live directly under it
    // (§4), its key has to be one the Step registered, as a leaf, and as
    // this very Work.
    fn member_gap(step_id: String, work_id: String) -> String {
        let s = self.step(step_id);
        if len(s.step_id) == 0 { return "step " + step_id + " was never registered"; }
        let key = work_key_under(step_id, work_id);
        if len(key) == 0 { return "work " + work_id + " is not a work of step " + step_id; }
        if !set_has(s.required, key) {
            return "step " + step_id + " has no member `" + key + "` (it required `" + s.required + "`)";
        }
        if map_get(s.kinds, key, ":") != "leaf" {
            return "member `" + key + "` of step " + step_id + " is a child workflow; it answers by settling, not as a Work";
        }
        if map_get(s.entities, key, "=") != work_id {
            return "member `" + key + "` of step " + step_id + " is " + map_get(s.entities, key, "=") + ", not " + work_id;
        }
        return "";
    }

    // Why this Task is not the child member its spawning Step waits for
    // under this key, "" when it is: registered, a child, and this very
    // Task — not another one claiming the same parent, step and key.
    fn child_gap(step_id: String, key: String, task_id: String) -> String {
        let s = self.step(step_id);
        if len(s.step_id) == 0 { return "step " + step_id + " was never registered"; }
        if !set_has(s.required, key) {
            return "step " + step_id + " has no member `" + key + "` (it required `" + s.required + "`)";
        }
        if map_get(s.kinds, key, ":") != "child" {
            return "member `" + key + "` of step " + step_id + " is a Work; it answers when it settles, not as a child workflow";
        }
        if map_get(s.entities, key, "=") != task_id {
            return "member `" + key + "` of step " + step_id + " is task " + map_get(s.entities, key, "=") + "; " + task_id + " does not answer for it";
        }
        return "";
    }
}
