// dna/host/record_verbs.hl — the record's operator surface that #649
// added, and the seeding `hale dna init` / `upgrade` do through the host
// rather than with record code of their own (the driver in
// `crates/hale-cli/src/dna.rs` kept a third copy of the row-commit
// sequence, with the three-try bound GH #603 removed elsewhere).

import "../core" as dna;
import "../operations" as ops;

// ---- hale dna candidates --------------------------------------------
//
// A candidate is a commit in the Mutation's worktree; the gateway keeps it
// as a branch of the genome, `dna/candidate/<mutation>` (GH #1590), and
// the record names its commit (`mutation.candidate`), so a refused change
// stays readable as a diff after its worktree is gone. It travels as any
// branch does. `drop` is a row (`candidate.dropped`); every clone deletes
// its branch when it reads the row.

fn review_for_mutation(p: Projection, mutation_id: String) -> ReviewRow {
    let ids = p.review_ids();
    let n = list_len(ids);
    let mut i = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        if r.is_mutation && r.mutation_id == mutation_id { return r; }
        i = i + 1;
    }
    return ReviewRow { };
}

fn candidates_verb(root: String, seed: String, sub: String, id_in: String, why: String, who_flag: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    if len(sub) == 0 {
        let p = open_projection(root, seed, "", memory);
        let mut out = "";
        let mut n = 0;
        let mut rest = genome_candidates(root);
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let mid = if nl < 0 { rest } else { rest[0..nl] };
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            if len(mid) == 0 { continue; }
            let rv = review_for_mutation(p, mid);
            let state = if len(rv.id) == 0 { "no Review names it" } else { "review " + rv.id + " " + rv.state + (if rv.state == "pending" { "" } else { ": " + rv.settled }) };
            out = out + "  " + mid + "  " + short(genome_candidate(root, mid)) + "  " + state + "\n";
            n = n + 1;
        }
        return answer("candidates: " + (if n == 0 { "none kept" } else { to_string(n) }) + "\n" + out + (if n > 0 { "`hale dna candidates <mutation>` shows one as a diff; `hale dna candidates drop <mutation> --why <why>` stops keeping it\n" } else { "" }));
    }
    if sub == "drop" {
        if len(id_in) == 0 || len(why) == 0 { return fail("candidates drop: `hale dna candidates drop <mutation> --why <why> [--as <who>]`"); }
        if len(genome_candidate(root, id_in)) == 0 { return fail("candidates drop: no candidate is kept for " + id_in); }
        let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("by", who);
        b.string_field("why", why);
        b.end_object();
        if !append_as(root, "candidate.dropped", id_in, b.result(), who, memory) { return fail("the record refused the append"); }
        let dropped = apply_drops(root);
        let s = sync_record(root, memory);
        return answer("candidate " + id_in + " dropped by " + who + ": " + why + " (candidate.dropped; its branch is deleted here, and every clone deletes its own when it reads the row; a branch pushed to a forge is deleted there as any branch is)\n");
    }
    // show one: the diff from the review's base
    let mid = sub;
    let commit = genome_candidate(root, mid);
    if len(commit) == 0 { return fail("candidates: no candidate is kept for " + mid + " (`hale dna candidates` lists them)"); }
    let p = open_projection(root, seed, "", memory);
    let rv = review_for_mutation(p, mid);
    let base = if len(rv.base_commit) > 0 { rv.base_commit } else { commit + "~1" };
    let mut out = "candidate " + mid + " at " + short(commit) + (if len(rv.id) > 0 { " (review " + rv.id + " " + rv.state + ")" } else { "" }) + "\n";
    out = out + "diff (" + short(base) + " .. " + short(commit) + "):\n";
    let d = genome_diff(root, base, commit);
    if d.code == 0 { out = out + indent_lines(dna::trim_nl(d.stdout), "  ") + "\n"; } else { out = out + "  (the diff could not be read: " + dna::trim_nl(d.stderr) + ")\n"; }
    return answer(out);
}

// ---- the driver's seeding, through the record ------------------------

// GH #1590: the record's first rows, born in memory: `record.genesis` with
// the body the driver composed, exactly at 0, whose digest must be the
// identity the driver pinned in hale.toml; and `record.key`, the public half
// of the record's key, which every row the organism's parts write is signed
// with. Its Ledger is memory's from the start: no row says so.
// Answers the identity and the key.
fn record_genesis_verb(root: String, body: String) -> Answer {
    if len(body) == 0 { return fail("record-genesis: the genesis row's body"); }
    let id = record_identity(root);
    if len(id) == 0 { return fail("record-genesis: hale.toml pins no record; `hale dna init` pins it first"); }
    if dna::event_digest("genesis", "record.genesis", "record", body) != id { return fail("record-genesis: the row's digest is not the identity hale.toml pins (" + id + ")"); }
    let key = dna::record_key(dna::schema_for(id));
    if !key.ready() { return fail("record-genesis: the record's key is not in the vault (" + dna::exchange_key_vault(dna::schema_for(id)) + "); `hale dna secrets` draws it"); }
    let who = who_am_i();
    let j = dna::RecordJournal { repo: root, author: who };
    let r = j.append_as(0, "record.genesis", "record", body, who, true);
    if !r.ok { return fail("record-genesis: memory refused the record's first row (" + r.error + "): " + j.last_error()); }
    let k = std::json::Builder { };
    k.begin_object();
    k.string_field("key", key.public());
    k.end_object();
    let kr = j.append_as(1, "record.key", "record", k.result(), "dna", true);
    if !kr.ok { return fail("record-genesis: memory refused the record's key (" + kr.error + "): " + j.last_error()); }
    return answer("record " + id + " (record.genesis; record.key " + key.public()[0..12] + "…)\n");
}

// The record's head, or `none`: the driver asks before it seeds.
fn record_head_verb(root: String) -> Answer {
    // `none` only for a record known absent: the driver seeds on it
    let h = record_head(root);
    if !h.ok { return fail("the record of " + root + " could not be read from memory: " + h.why); }
    return answer((if h.absent { "none" } else { h.id }) + "\n");
}

// GH #1590: the record's rows, one JSON object per line (`seq`, `kind`,
// `entity`, `body`, `author`), oldest first: the record's own line format,
// "" for a record with no rows. What a test or a script reads of the
// record, so none of them reads the record's storage. The record's rows
// alone: the Ledger's are memory's (`hale dna history` reads both).
fn record_rows_verb(root: String) -> Answer {
    let h = record_head(root);
    if !h.ok { return fail("record-rows: the record in " + root + " could not be read: " + h.why); }
    if h.absent { return answer(""); }
    let text = journal_text_at(root, h.id);
    if len(text) == 0 { return fail("record-rows: the record's rows at " + h.id + " could not be read"); }
    return answer(text);
}

// GH #1590: a public or internal receipt's body as memory keeps it, by its
// digest (`sha256:` optional), for tests and scripts, so none of them reads
// memory's tables. A protected body is the vault's (`hale dna receipt show
// … --purpose`), never this verb's.
fn record_body_verb(root: String, digest: String) -> Answer {
    let hexd = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
    if len(hexd) != 64 { return fail("record-body: a receipt's digest"); }
    let r = dna::MemoryReceipts { repo: root };
    let text = r.read(hexd);
    if len(text) == 0 { return fail("record-body: no body " + digest + " is kept unsealed in memory" + (if len(r.last_error()) > 0 { " (" + r.last_error() + ")" } else { "" })); }
    return answer(text);
}

// Append every row of a file (one JSON object per line: kind, entity,
// body) in order, in the identity of whoever runs this. The count.
fn record_seed_verb(root: String, path: String, purpose_path: String, memory: dna::Memory) -> Answer {
    if len(path) == 0 { return fail("record-seed: a file of rows"); }
    let rows = std::io::fs::read_file(path) or "";
    // GH #995: the declared purpose's proposal in the same seed, so a
    // record never exists without it
    let purpose = if len(purpose_path) > 0 { std::io::fs::read_file(purpose_path) or "" } else { "" };
    if len(purpose_path) > 0 && len(purpose) == 0 { return fail("record-seed: no purpose at " + purpose_path); }
    let keeps = dna::Texts { };
    let proposed = if len(purpose) > 0 { purpose_rows(keeps, purpose) } else { "" };
    if !keeps_flush(root, keeps) { return fail("record-seed: the purpose's receipt could not be kept; nothing was seeded"); }
    return seed_rows(root, rows + (if len(rows) > 0 && !std::str::ends_with(rows, "\n") { "\n" } else { "" }) + proposed, "record-seed", memory);
}

// Rows into the record, one JSON object per line (`kind`, `entity`,
// `body`). Every `graph.*` row is checked against the graph's vocabulary
// before any row is appended (GH #1090): a seed the graph refuses leaves
// the record as it was, never half written.
fn seed_rows(root: String, text: String, who: String, memory: dna::Memory) -> Answer {
    let mut n = 0;
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(dna::trim_nl(line)) == 0 { continue; }
        n = n + 1;
        let kind = std::json::find_string_field(line, "kind");
        if len(kind) == 0 { return fail(who + ": row " + to_string(n) + " has no kind"); }
        let entity = std::json::find_string_field(line, "entity");
        let body = std::json::find_string_field(line, "body");
        let g = if kind == "graph.node" { ops::graph_node_row(entity, body) } else if kind == "graph.edge" { ops::graph_edge_row(entity, body) } else if kind == "graph.retired" { ops::graph_retired_row(entity) } else { ops::GraphRow { ok: true } };
        if !g.ok { return fail(who + ": row " + to_string(n) + " (" + kind + " " + entity + "): " + g.why); }
    }
    // the rows land in their order; those of the record go down together,
    // one commit each, through the record's batch
    let landed = append_lines(root, text, memory);
    if landed < 0 { return fail(who + ": the record refused the rows"); }
    return answer(to_string(landed) + "\n");
}

// ---- hale dna init on a repository (GH #1090) ----------------------------
//
// The repository read into the graph (dna/operations/graph_ingest.hl) and
// its rows appended to the record after the declared purpose's proposal
// (`first`, a file holding the purpose's text, when one is given), all of
// them in one
// `seed_rows`, each checked before any lands — a repository ingest refuses
// leaves no record, and init can be run again. Says how many nodes and
// edges, and the nodes by kind.
// The operational roles dna/org/structure.hl opts into (GH #1091, B): the
// string `operational_roles` returns, space-separated; "" when there is no
// policy or it opts into none. A generated file, read by its one shape.
fn structure_roles(root: String) -> String {
    let text = std::io::fs::read_file(root + "/dna/org/structure.hl") or "";
    let at = std::str::index_of(text, "fn operational_roles");
    if at < 0 { return ""; }
    let rest = text[at..len(text)];
    let q = std::str::index_of(rest, "return \"");
    if q < 0 { return ""; }
    let lit = rest[(q + 8)..len(rest)];
    let end = std::str::index_of(lit, "\"");
    if end < 0 { return ""; }
    return dna::trim_nl(std::str::trim(lit[0..end]));
}

// An application's (`hale dna init`, the application attached): `rows_path`
// is a file of the artifact's rows, which land first; `app` names the
// application's root seed; `description_path` is a file holding what
// `hale check --api` exports.
fn graph_ingest_verb(root: String, first: String, rows_path: String, app: String, description_path: String, memory: dna::Memory) -> Answer {
    let described = if len(description_path) > 0 { std::io::fs::read_file(description_path) or "" } else { "" };
    let declared = if len(first) > 0 { std::io::fs::read_file(first) or "" } else { "" };
    let g = ops::GraphIngest { root: root, app: app, description: described, declared: declared };
    let r = g.ingest();
    if len(r.error) > 0 { return fail("graph-ingest: " + r.error); }
    // GH #1091: the holes, proposed in the same seed as the graph, with the
    // operational roles the project's structure policy opts into
    let holes = ops::graph_holes(g, structure_roles(root));
    if len(holes.error) > 0 { return fail("graph-ingest: " + holes.error); }
    let keeps = dna::Texts { };
    let mut proposals = "";
    let mut rest = holes.proposals;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        proposals = proposals + hole_rows(keeps, rest[0..nl], "hale dna init");
        rest = rest[(nl + 1)..len(rest)];
    }
    // GH #995: the declared purpose, proposed in the same checked seed, so
    // a repository with nothing to ingest still has its record
    let purpose = if len(first) > 0 { std::io::fs::read_file(first) or "" } else { "" };
    let observed = if len(rows_path) > 0 { std::io::fs::read_file(rows_path) or "" } else { "" };
    if len(rows_path) > 0 && len(observed) == 0 { return fail("graph-ingest: no rows at " + rows_path); }
    let head = if len(observed) > 0 && !std::str::ends_with(observed, "\n") { observed + "\n" } else { observed };
    let before = head + (if len(purpose) > 0 { purpose_rows(keeps, purpose) } else { "" });
    if !keeps_flush(root, keeps) { return fail("graph-ingest: the receipts could not be kept; nothing was seeded"); }
    let seeded = seed_rows(root, before + (if len(before) > 0 && !std::str::ends_with(before, "\n") { "\n" } else { "" }) + r.rows + proposals, "graph-ingest", memory);
    if !seeded.ok { return seeded; }
    // ruling 11b: what the ingest took no row from, said once, a line each
    return answer(to_string(r.nodes) + " node(s), " + to_string(r.edges) + " edge(s): " + r.counts + "; " + to_string(holes.count) + " proposal(s)\n" + r.notes);
}

// Whether the record attaches an application built from a seed
// (`application.attached` naming its `main`). A repository's own
// attachment (ruling 11: its compose services are the expression) names
// no `main` and does not count: a repository is re-ingested.
fn attached_somewhere(j: dna::Journal) -> Bool {
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "application.attached" && len(std::json::find_string_field(e.body, "main")) > 0 { return true; }
        i = i + 1;
    }
    return false;
}

// Whether an id is one the repository's ingest states (and so one a
// re-ingest may add, change or retire): its node kinds and edge kinds,
// and an `unfold` between two of them, never a position's, a work's, an
// organization's or a definition's, which the record's own proposals own.
fn ingest_owned(id: String) -> Bool {
    let colon = std::str::index_of(id, ":");
    if colon <= 0 { return false; }
    let kind = id[0..colon];
    if dna::word_in(kind, "purpose axiom process seed contract noun deployment gate document witness tool meets names refers constrains runs gates witnesses") { return true; }
    if kind != "unfold" { return false; }
    let rest = id[(colon + 1)..len(id)];
    let bar = std::str::index_of(rest, "|");
    if bar < 0 { return false; }
    let ends = rest[0..bar] + " " + rest[(bar + 1)..len(rest)];
    return !std::str::contains(" " + ends, " position:") && !std::str::contains(" " + ends, " work:") && !std::str::contains(" " + ends, " organization:") && !std::str::contains(" " + ends, " definition:");
}

// `hale dna ingest [--at <rev>]` (the CLI checks the commit out at `tree`):
// the repository's graph as it stands at `at`, diffed against the graph the
// record states over what the ingest owns, the difference filed as ONE
// reviewed graph proposal (group `ingest`): nodes and edges added, bodies
// changed, and the ones gone as retirements, edges first. A `graph.ingested`
// row names the commit either way; with nothing changed there is nothing to
// review. An application's own re-ingest follows (its description is the
// toolchain's to export at that commit).
fn graph_reingest_verb(root: String, tree: String, at: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    if len(at) < 7 { return fail("ingest: name the commit (--at <sha>)"); }
    // the record and its Ledger, as the organization reads them
    let journal = dna::RoutedJournal { record: dna::RecordJournal { repo: root }, ledger: memory.ledger };
    if attached_somewhere(journal) { return fail("ingest: an attached application's re-ingest is not built yet; a repository's is"); }
    let g = ops::GraphIngest { root: tree, tools: true };
    let r = g.ingest();
    if len(r.error) > 0 { return fail("ingest: " + r.error); }
    let current = dna::record_graph_bodies(journal, dna::MemoryReceipts { repo: root });
    let mut ids = "\n";
    let mut nodes = "";
    let mut edges = "";
    let mut added = 0;
    let mut changed = 0;
    let v = std::str::bytes_view(r.rows);
    let mut at_ = 0;
    while at_ < v.n {
        let mut end = at_;
        while end < v.n && std::str::byte_at(v, end) != 10 { end = end + 1; }
        let row = std::str::slice(v, at_, end);
        at_ = end + 1;
        if len(row) == 0 { continue; }
        let id = std::json::find_string_field(row, "entity");
        let body = std::json::find_string_field(row, "body");
        ids = ids + id + "\n";
        let was = dna::graph_body_of(current, id);
        if len(was) == 0 || was != body {
            if len(was) == 0 { added = added + 1; } else { changed = changed + 1; }
            if std::json::find_string_field(row, "kind") == "graph.node" { nodes = nodes + row + "\n"; } else { edges = edges + row + "\n"; }
        }
    }
    // what the record states and the repository no longer does: retired,
    // the edges before the nodes they name
    let mut gone_edges = "";
    let mut gone_nodes = "";
    let mut retired = 0;
    let cv = std::str::bytes_view(current);
    let mut c = 0;
    while c < cv.n {
        let mut end = c;
        while end < cv.n && std::str::byte_at(cv, end) != 10 { end = end + 1; }
        let line = std::str::slice(cv, c, end);
        c = end + 1;
        let tab = std::str::index_of(line, "\t");
        if tab <= 0 { continue; }
        let id = line[0..tab];
        if !ingest_owned(id) || std::str::contains(ids, "\n" + id + "\n") { continue; }
        if !ops::graph_retired_row(id).ok { continue; }
        retired = retired + 1;
        let gone = hole_row("graph.retired", id, "{}");
        let colon = std::str::index_of(id, ":");
        if dna::word_in(id[0..colon], "meets names refers constrains runs gates witnesses unfold") { gone_edges = gone_edges + gone; } else { gone_nodes = gone_nodes + gone; }
    }
    let short = at[0..12];
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("commit", at);
    b.int_field("added", added);
    b.int_field("changed", changed);
    b.int_field("retired", retired);
    let total = added + changed + retired;
    if total == 0 {
        b.string_field("review_id", "");
        b.end_object();
        let seeded = seed_rows(root, hole_row("graph.ingested", at, b.result()), "ingest", memory);
        if !seeded.ok { return seeded; }
        return answer("ingested " + short + ": the graph the record states is the repository's; nothing to review\n");
    }
    // one graph proposal: its rows as the receipt carries them
    let d = std::json::Builder { };
    d.begin_object();
    d.string_field("author", "hale dna ingest");
    d.string_field("kind", "graph");
    d.string_field("name", "ingest@" + short);
    d.string_field("provenance", "ingested at " + at);
    let question = "ratify the graph as the repository states it at " + short + ": " + to_string(added) + " added, " + to_string(changed) + " changed, " + to_string(retired) + " retired";
    d.string_field("question", question);
    d.begin_array_field("rows");
    let all = nodes + edges + gone_edges + gone_nodes;
    let av = std::str::bytes_view(all);
    let mut a = 0;
    while a < av.n {
        let mut end = a;
        while end < av.n && std::str::byte_at(av, end) != 10 { end = end + 1; }
        let row = std::str::slice(av, a, end);
        a = end + 1;
        if len(row) == 0 { continue; }
        d.begin_object();
        d.string_field("kind", std::json::find_string_field(row, "kind"));
        d.string_field("entity", std::json::find_string_field(row, "entity"));
        d.string_field("body", std::json::find_string_field(row, "body"));
        d.end_object();
    }
    d.end_array();
    d.string_field("target", "org");
    d.string_field("text", question + ".");
    d.end_object();
    let keeps = dna::Texts { };
    let proposal = hole_rows(keeps, ops::hole_line(d.result(), question, "ingest", "graph", "ingest@" + short, "org"), "hale dna ingest");
    let digest = std::json::find_string_field(proposal[0..std::str::index_of(proposal, "\n")], "entity");
    b.string_field("review_id", dna::knowledge_review_id(digest));
    b.end_object();
    // the same difference at the same commit is the same proposal: asked once
    if len(dna::first_row(journal, "knowledge.proposed", digest).kind) > 0 {
        return answer("ingested " + short + ": the same difference is already proposed as " + dna::knowledge_review_id(digest) + "\n");
    }
    if !keeps_flush(root, keeps) { return fail("ingest: the receipt could not be kept; nothing was proposed"); }
    // the organization opens the Review it is asked to (a running one hears
    // the request; one started later finds it in the record)
    let rq = std::json::Builder { };
    rq.begin_object();
    rq.string_field("request_id", "g" + digest[7..19]);
    rq.string_field("review_id", dna::knowledge_review_id(digest));
    rq.string_field("by", "hale dna ingest");
    rq.end_object();
    let seeded = seed_rows(root, proposal + hole_row("graph.ingested", at, b.result()) + hole_row("graph.requested", "g" + digest[7..19], rq.result()), "ingest", memory);
    if !seeded.ok { return seeded; }
    return answer("ingested " + short + ": " + to_string(added) + " added, " + to_string(changed) + " changed, " + to_string(retired) + " retired; the Board ratifies it as " + dna::knowledge_review_id(digest) + " (`hale dna review` lists it under `ingest`)\n");
}

// ---- the toolchain's design, as proposals (GH #596 C) --------------------
//
// At `init` every practice of the design is proposed, one Board Review
// each. At `upgrade` each practice whose current text is not the latest
// proposed under its name is proposed again — superseding the ACTIVE
// digest under that name when there is one, plainly when nothing is
// active (a pending or rejected proposal is not a predecessor: retiring
// it would retire nothing). Unchanged practices propose nothing. One
// replacement at a time under a name: while the latest proposal awaits
// the Board, a changed text waits too — two pending replacements would
// both name the same predecessor, and the assembly refuses to ratify the
// second once the first has retired it. A refused one is proposed again,
// against what is active now.

// What the record holds under one practice name.
type DesignState {
    name: String = "";
    latest_text: String = "";
    latest: String = ""; // the latest proposal's digest
    active: String = ""; // ratified and not retired, "" when none
    pending: Bool = false; // the latest proposal awaits the Board
    refused: Bool = false; // the latest proposal was refused at ratification
}

@form(hashmap)
locus DesignStates {
    capacity { pool rows of DesignState indexed_by name; }
}

// digest -> practice name, from the receipts the proposals point at
type DigestName { digest: String = ""; name: String = ""; }

@form(hashmap)
locus DigestNames {
    capacity { pool rows of DigestName indexed_by digest; }
}

fn in_list(list: String, item: String) -> Bool { return std::str::contains(list, "\n" + item + "\n"); }

// The record's design states, by name, from the rows and the receipts:
// the journal's `text`, read whole.
@bounded_by(text)
fn design_in_record(root: String, states: DesignStates) -> Bool {
    let r = rec(root);
    // a head that could not be read is not a record with no design in it:
    // every practice would be proposed again
    let h = r.head(JOURNAL);
    if !h.ok { return false; }
    let text = r.text_at(h.id);
    let names = DigestNames { };
    let mut ratified = "\n"; // in order
    let mut retired = "\n";
    let mut decided = "\n";
    let mut refused = "\n";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(dna::trim_nl(line)) == 0 { continue; }
        let kind = std::json::find_string_field(line, "kind");
        let entity = std::json::find_string_field(line, "entity");
        if kind == "knowledge.proposed" {
            let digest = std::json::find_string_field(std::json::find_string_field(line, "body"), "digest");
            if len(digest) == 0 { continue; }
            // the receipt is canonical: its name and its text
            let raw = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
            let doc = r.body(raw);
            if !doc.present { continue; }
            let name = std::json::find_string_field(doc.text, "name");
            if len(name) == 0 { continue; }
            names.set(DigestName { digest: digest, name: name });
            let cur = states.get(name) or DesignState { name: name };
            states.set(DesignState { name: name, latest_text: design_terms(std::json::find_string_field(doc.text, "text"), std::json::find_string_field(doc.text, "schedule")), latest: digest, active: cur.active });
        } else if kind == "knowledge.ratified" {
            decided = decided + entity + "\n";
            ratified = ratified + entity + "\n";
        } else if kind == "knowledge.declined" {
            decided = decided + entity + "\n";
        } else if kind == "knowledge.refused" {
            decided = decided + entity + "\n";
            refused = refused + entity + "\n";
        } else if kind == "knowledge.retired" {
            retired = retired + entity + "\n";
        }
    }
    // the active digest under a name: the last ratified one not retired
    let mut rr = ratified[1..len(ratified)];
    while len(rr) > 0 {
        let nl = std::str::index_of(rr, "\n");
        let digest = if nl < 0 { rr } else { rr[0..nl] };
        rr = if nl < 0 { "" } else { rr[(nl + 1)..len(rr)] };
        if len(digest) == 0 || in_list(retired, digest) { continue; }
        let dn = names.get(digest) or DigestName { };
        if len(dn.name) == 0 { continue; }
        let cur = states.get(dn.name) or DesignState { };
        if len(cur.name) == 0 { continue; }
        states.set(DesignState { name: cur.name, latest_text: cur.latest_text, latest: cur.latest, active: digest });
    }
    // pending / refused: about the latest proposal under each name; the
    // names are walked through the digests they were proposed under
    let mut rest2 = text;
    while len(rest2) > 0 {
        let nl = std::str::index_of(rest2, "\n");
        let line = if nl < 0 { rest2 } else { rest2[0..nl] };
        rest2 = if nl < 0 { "" } else { rest2[(nl + 1)..len(rest2)] };
        if std::json::find_string_field(line, "kind") != "knowledge.proposed" { continue; }
        let digest = std::json::find_string_field(std::json::find_string_field(line, "body"), "digest");
        let dn = names.get(digest) or DigestName { };
        if len(dn.name) == 0 { continue; }
        let cur = states.get(dn.name) or DesignState { };
        if cur.latest != digest { continue; }
        states.set(DesignState { name: cur.name, latest_text: cur.latest_text, latest: cur.latest, active: cur.active, pending: !in_list(decided, digest), refused: in_list(refused, digest) });
    }
    return true;
}

// The practice's document, byte for byte as the toolchain has always
// filed it (compact, keys in order): its digest is the Review's name.
// What a seeded practice states: its text, and the schedule it declares
// once ratified (GH #1143) — a change to either is a new revision.
fn design_terms(text: String, schedule: String) -> String { return if len(schedule) > 0 { text + "\n\nschedule: " + schedule } else { text }; }

fn design_document(name: String, text: String, toolchain: String, supersedes: String, schedule: String, target: String) -> String {
    let q = std::json::Builder { };
    return "{\"author\":\"org\",\"kind\":\"" + (if len(target) > 0 { "mandate" } else { "practice" }) + "\",\"name\":" + q.quote(name) + ",\"provenance\":\"design\"," + (if len(supersedes) > 0 { "\"supersedes\":" + q.quote(supersedes) + "," } else { "" }) + (if len(schedule) > 0 { "\"schedule\":" + q.quote(schedule) + "," } else { "" }) + "\"target\":" + q.quote(if len(target) > 0 { target } else { "org" }) + ",\"text\":" + q.quote(text) + ",\"toolchain\":" + q.quote(toolchain) + "}";
}

// A seeded practice's family: the part of its name before the slash
// (`design`, `operating` — GH #994), which is the group it is listed under.
fn seeded_family(name: String) -> String {
    let slash = std::str::index_of(name, "/");
    return if slash > 0 { name[0..slash] } else { "design" };
}

// Propose one practice: its receipt (queued in `keeps`), a
// `knowledge.proposed` row and a Review of its own, grouped by its family
// for the listing: the two seed rows.
fn design_rows(keeps: dna::Texts, name: String, text: String, toolchain: String, supersedes: String, schedule: String, target: String) -> String {
    let raw = keep_later(keeps, design_document(name, text, toolchain, supersedes, schedule, target));
    let kind = if len(target) > 0 { "mandate" } else { "practice" };
    let bound = if len(target) > 0 { target } else { "org" };
    let digest = "sha256:" + raw;
    let review_id = "k:" + raw[0..12];
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("digest", digest);
    b.string_field("review_id", review_id);
    b.string_field("kind", kind);
    b.string_field("author", "org");
    b.string_field("target", bound);
    b.string_field("class", "initiative");
    b.string_field("provenance", "design");
    b.string_field("name", name);
    b.string_field("supersedes", supersedes);
    b.end_object();
    let proposed = hole_row("knowledge.proposed", digest, b.result());
    let first = if len(text) > 72 { text[0..72] + "…" } else { text };
    let question = (if len(target) > 0 { "ratify the mandate of `" + target + "` (`" + name + "`)" } else { "ratify the " + seeded_family(name) + " practice `" + name + "`" }) + (if len(supersedes) > 0 { " (replacing an earlier version)" } else { "" }) + ": " + first;
    let q = std::json::Builder { };
    q.begin_object();
    q.string_field("question", question);
    q.string_field("subject_digest", digest);
    q.string_field("required_authority", "board");
    q.string_field("author", "org");
    q.string_field("knowledge_digest", digest);
    q.string_field("kind", kind);
    q.string_field("target", bound);
    q.string_field("class", "initiative");
    q.string_field("group", seeded_family(name));
    q.string_field("name", name);
    q.end_object();
    return proposed + hole_row("review.requested", "review:" + review_id, q.result());
}

// ---- the toolchain's library, as proposals --------------------------------
//
// The library is the book per chapter and the spec per section: one idea
// each, a `knowledge.proposed` row and its receipt, bound to its node by its
// own `target`. The Board does not review hundreds of ideas one by one: a
// FAMILY of them is one Review (`library/language@<version>`,
// `library/design@<version>`) whose body names the ideas it ratifies, their
// ids and digests, and whose verdict ratifies, or declines, every one of
// them (dna/core/knowledge_record.hl).

// A library idea's document: the toolchain's text about a node of the
// graph (`language:hale`, `system:dna`), authored above it, bound to it by
// its own `target`, with the chapter's title and the digest of its text.
fn library_document(name: String, title: String, text: String, target: String, toolchain: String, content: String, supersedes: String) -> String {
    let q = std::json::Builder { };
    return "{\"author\":\"org\",\"content_digest\":" + q.quote(content) + ",\"kind\":\"idea\",\"name\":" + q.quote(name) + ",\"provenance\":\"toolchain\"," + (if len(supersedes) > 0 { "\"supersedes\":" + q.quote(supersedes) + "," } else { "" }) + "\"target\":" + q.quote(target) + ",\"text\":" + q.quote(text) + ",\"title\":" + q.quote(title) + ",\"toolchain\":" + q.quote(toolchain) + "}";
}

type LibraryRow {
    digest: String = "";
    row: String = "";
}

// One library idea's receipt and its `knowledge.proposed` row, as a seed
// row; the digest is "" when the receipt could not be kept.
fn library_idea_row(keeps: dna::Texts, name: String, title: String, text: String, target: String, toolchain: String, content: String, supersedes: String) -> LibraryRow {
    let raw = keep_later(keeps, library_document(name, title, text, target, toolchain, content, supersedes));
    let digest = "sha256:" + raw;
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("digest", digest);
    b.string_field("kind", "idea");
    b.string_field("author", "org");
    b.string_field("target", target);
    b.string_field("class", dna::classify_binding("org", target));
    b.string_field("provenance", "toolchain");
    b.string_field("name", name);
    b.string_field("supersedes", supersedes);
    b.end_object();
    return LibraryRow { digest: digest, row: hole_row("knowledge.proposed", digest, b.result()) };
}

// A family's document: the ideas it ratifies, `<name> <digest>` a line.
fn library_family_document(name: String, version: String, count: Int, ideas: String) -> String {
    let q = std::json::Builder { };
    return "{\"author\":\"org\",\"count\":" + to_string(count) + ",\"ideas\":" + q.quote(ideas) + ",\"kind\":\"family\",\"name\":" + q.quote(name) + ",\"provenance\":\"toolchain\",\"toolchain\":" + q.quote(version) + "}";
}

// A family's Review: its receipt kept and its `review.requested` row, as a
// seed row, under the group `library`. "" when the receipt could not be kept.
fn library_family_row(keeps: dna::Texts, family: String, version: String, target: String, count: Int, ideas: String) -> String {
    let name = "library/" + family + "@" + version;
    let raw = keep_later(keeps, library_family_document(name, version, count, ideas));
    let digest = "sha256:" + raw;
    let q = std::json::Builder { };
    q.begin_object();
    q.string_field("question", "ratify the library family `" + name + "`: " + to_string(count) + " idea(s) bound to `" + target + "`");
    q.string_field("subject_digest", digest);
    q.string_field("required_authority", "board");
    q.string_field("author", "org");
    q.string_field("knowledge_digest", digest);
    q.string_field("kind", "family");
    q.string_field("target", target);
    q.string_field("group", "library");
    q.string_field("name", name);
    q.int_field("count", count);
    q.string_field("ideas", ideas);
    q.end_object();
    return hole_row("review.requested", "review:k:" + raw[0..12], q.result());
}

// The record's library families: `<name> <pending|decided>` a line.
fn library_families_in_record(root: String) -> String {
    let r = rec(root);
    let h = r.head(JOURNAL);
    if !h.ok { return ""; }
    let mut text = r.text_at(h.id);
    let mut asked = "";
    let mut settled = "\n";
    while len(text) > 0 {
        let nl = std::str::index_of(text, "\n");
        let line = if nl < 0 { text } else { text[0..nl] };
        text = if nl < 0 { "" } else { text[(nl + 1)..len(text)] };
        let kind = std::json::find_string_field(line, "kind");
        let e = std::json::find_string_field(line, "entity");
        let id = if std::str::starts_with(e, "review:") { e[7..len(e)] } else { e };
        if kind == "review.settled" {
            settled = settled + id + "\n";
        } else if kind == "review.requested" {
            let body = std::json::find_string_field(line, "body");
            if std::json::find_string_field(body, "group") == "library" { asked = asked + std::json::find_string_field(body, "name") + " " + id + "\n"; }
        }
    }
    let mut out = "";
    let mut rest = asked;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let sp = std::str::index_of(line, " ");
        out = out + line[0..sp] + " " + (if in_list(settled, line[(sp + 1)..len(line)]) { "decided" } else { "pending" }) + "\n";
    }
    return out;
}

// Whether a family (`language`, `design`) has a Review, of some version,
// still before the Board.
fn family_pending(known: String, family: String) -> Bool {
    let mut rest = known;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        if std::str::starts_with(line, "library/" + family + "@") && std::str::ends_with(line, " pending") { return true; }
    }
    return false;
}

// `library-seed <ideas> [<version>]`: the toolchain's library as proposals,
// one JSON object per line (`name`, `title`, `text`, `target`, `family`,
// `digest` — the text's), grouped by family. At `init` the record holds
// none and every idea is proposed plainly. At `upgrade` a family already
// proposed at this version proposes nothing, a family whose earlier version
// still awaits the Board waits, and any other is proposed afresh, each idea
// superseding the ACTIVE digest under its name. Prints
// `proposed=<n> families=<f> superseding=<m> waiting=<w>`.
fn library_seed_verb(root: String, path: String, version_arg: String, upgrading: Bool, toolchain: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let ideas = std::io::fs::read_file(path) or "";
    if len(ideas) == 0 { return fail("library-seed: no ideas at " + path); }
    let version = if len(version_arg) > 0 { version_arg } else { toolchain };
    let known = library_families_in_record(root);
    // a record seeded without the library (`--no-library`) is not given one
    // by an upgrade
    if upgrading && len(known) == 0 { return answer("proposed=0 families=0 superseding=0 waiting=0\n"); }
    let states = DesignStates { };
    if len(known) > 0 && !design_in_record(root, states) { return fail("library-seed: the record's head could not be read; nothing was proposed"); }
    let keeps = dna::Texts { };
    let mut rows = "";
    let mut proposed = 0;
    let mut families = 0;
    let mut superseding = 0;
    let mut waiting = 0;
    // the family being gathered: what to do with it (0 propose, 1 already
    // proposed at this version, 2 waits), its node, ideas and rows
    let mut cur = "";
    let mut mode = 0;
    let mut cur_target = "";
    let mut cur_ideas = "";
    let mut cur_rows = "";
    let mut cur_count = 0;
    let mut cur_super = 0;
    let mut rest = ideas + "\n{\"family\":\"\"}\n";
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(dna::trim_nl(line)) == 0 { continue; }
        let family = std::json::find_string_field(line, "family");
        if family != cur {
            if cur_count > 0 {
                let fam = library_family_row(keeps, cur, version, cur_target, cur_count, cur_ideas);
                rows = rows + cur_rows + fam;
                proposed = proposed + cur_count;
                families = families + 1;
                superseding = superseding + cur_super;
            }
            if mode == 2 { waiting = waiting + 1; }
            cur = family; cur_ideas = ""; cur_rows = ""; cur_count = 0; cur_super = 0; mode = 0;
            if std::str::contains("\n" + known, "\nlibrary/" + family + "@" + version + " ") { mode = 1; }
            else if family_pending(known, family) { mode = 2; }
        }
        if len(family) == 0 || mode != 0 { continue; }
        cur_target = std::json::find_string_field(line, "target");
        let name = std::json::find_string_field(line, "name");
        let mut st = states.get(name) or DesignState { };
        // a chapter the book moved is proposed under its new name over what
        // the record holds under the earlier one
        let earlier = std::json::find_string_field(line, "earlier");
        if len(st.active) == 0 && len(earlier) > 0 { st = states.get(earlier) or DesignState { }; }
        let one = library_idea_row(keeps, name, std::json::find_string_field(line, "title"), std::json::find_string_field(line, "text"), cur_target, version, std::json::find_string_field(line, "digest"), st.active);
        cur_rows = cur_rows + one.row;
        cur_ideas = cur_ideas + name + " " + one.digest + "\n";
        cur_count = cur_count + 1;
        if len(st.active) > 0 { cur_super = cur_super + 1; }
    }
    if proposed > 0 {
        if !keeps_flush(root, keeps) { return fail("library-seed: the receipts could not be kept; nothing was seeded"); }
        let seeded = seed_rows(root, rows, "library-seed", memory);
        if !seeded.ok { return seeded; }
    }
    return answer("proposed=" + to_string(proposed) + " families=" + to_string(families) + " superseding=" + to_string(superseding) + " waiting=" + to_string(waiting) + "\n");
}

// The rows that propose the declared purpose (GH #995), one JSON object
// per line as `seed_rows` takes them: its receipt kept, a
// `knowledge.proposed` row — kind `purpose`, the organization's, for
// `org` — and the Board's Review under the group `purpose`, as a seeded
// practice is. The Board ratifies it through practice-ratify like any
// proposal, and `hale dna review purpose approve` decides it by its
// group. "" when the receipt could not be kept.
fn purpose_rows(keeps: dna::Texts, text: String) -> String {
    let raw = keep_later(keeps, dna::knowledge_document(dna::Idea { kind: "purpose", text: text, author: "org", name: "purpose", provenance: "declared" }, "org"));
    let digest = "sha256:" + raw;
    let review_id = "k:" + raw[0..12];
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("digest", digest);
    b.string_field("review_id", review_id);
    b.string_field("kind", "purpose");
    b.string_field("author", "org");
    b.string_field("target", "org");
    b.string_field("class", "initiative");
    b.string_field("provenance", "declared");
    b.string_field("name", "purpose");
    b.string_field("supersedes", "");
    b.end_object();
    let q = std::json::Builder { };
    q.begin_object();
    q.string_field("question", "ratify the declared purpose?");
    q.string_field("subject_digest", digest);
    q.string_field("required_authority", "board");
    q.string_field("author", "org");
    q.string_field("knowledge_digest", digest);
    q.string_field("kind", "purpose");
    q.string_field("target", "org");
    q.string_field("class", "initiative");
    q.string_field("group", "purpose");
    q.string_field("name", "purpose");
    q.end_object();
    return hole_row("knowledge.proposed", digest, b.result()) + hole_row("review.requested", "review:" + review_id, q.result());
}

// `design-upgrade <practices>`: the practices as the toolchain states
// them, one JSON object per line (`name`, `text`). Prints
// `proposed=<n> superseding=<m> waiting=<w>`.
fn design_upgrade_verb(root: String, path: String, toolchain: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let practices = std::io::fs::read_file(path) or "";
    if len(practices) == 0 { return fail("design-upgrade: no practices at " + path); }
    let states = DesignStates { };
    if !design_in_record(root, states) { return fail("design-upgrade: the record's head could not be read; nothing was proposed"); }
    let keeps = dna::Texts { };
    let mut rows = "";
    let mut proposed = 0;
    let mut superseding = 0;
    let mut waiting = 0;
    let mut rest = practices;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(dna::trim_nl(line)) == 0 { continue; }
        let name = std::json::find_string_field(line, "name");
        let text = std::json::find_string_field(line, "text");
        let schedule = std::json::find_string_field(line, "schedule");
        let target = std::json::find_string_field(line, "target");
        let st = states.get(name) or DesignState { };
        if len(st.name) > 0 && st.latest_text == design_terms(text, schedule) && !st.refused { continue; }
        if len(st.name) > 0 && st.pending { waiting = waiting + 1; continue; }
        let old = st.active;
        rows = rows + design_rows(keeps, name, text, toolchain, old, schedule, target);
        proposed = proposed + 1;
        if len(old) > 0 { superseding = superseding + 1; }
    }
    if proposed > 0 {
        if !keeps_flush(root, keeps) { return fail("design-upgrade: the receipts could not be kept; nothing was proposed"); }
        let seeded = seed_rows(root, rows, "design-upgrade", memory);
        if !seeded.ok { return fail("design-upgrade: the record refused the proposals"); }
    }
    return answer("proposed=" + to_string(proposed) + " superseding=" + to_string(superseding) + " waiting=" + to_string(waiting) + "\n");
}

// ---- hale dna signers (GH #1590) -------------------------------------------
//
// Under `dna.trust = signed` a person's row is admitted when it carries an
// ssh signature by a key the record enrolled for them; the enrolment is a
// row of the record (`signer.enrolled {who, key}`, `signer.revoked {who}`),
// itself signed by someone the record already admits, so nobody enrols
// themselves into a record that admits others. The first enrolment is the
// bootstrap.

fn signers_verb(root: String, sub: String, who_in: String, key_in: String, who_flag: String) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let j = dna::RecordJournal { repo: root, author: "host" };
    if len(sub) == 0 || sub == "list" {
        let keys = dna::enrolled_keys(j);
        let mut out = "signers: " + (if len(keys) == 0 { "none enrolled (`hale dna signers enroll <who> --key <ssh public key or file>`)" } else { to_string(dna::count_lines(keys)) }) + "\n";
        out = out + indent_lines(dna::trim_nl(keys), "  ") + (if len(keys) > 0 { "\n" } else { "" });
        out = out + "trust:   " + trust_mode(root) + (if trust_mode(root) == "signed" { " (a person's row is admitted when an enrolled key signed it)" } else { " (every writer to the record is trusted; `git config dna.trust signed` admits signed rows alone)" }) + "\n";
        return answer(out);
    }
    let by = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    if sub == "enroll" {
        if len(who_in) == 0 || len(key_in) == 0 { return fail("signers enroll: `hale dna signers enroll <who> --key <ssh public key or a .pub file> [--as <who>]`"); }
        let from_file = std::io::fs::read_file(key_in) or "";
        let key = dna::trim_nl(if len(from_file) > 0 { from_file } else { key_in });
        if !std::str::starts_with(key, "ssh-") && !std::str::starts_with(key, "ecdsa-") && !std::str::starts_with(key, "sk-") { return fail("signers enroll: `" + key_in + "` is not an ssh public key or a file holding one"); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("who", who_in);
        b.string_field("key", key);
        b.string_field("by", by);
        b.end_object();
        let w = dna::RecordJournal { repo: root, author: by };
        let r = w.append_as(w.revision(), "signer.enrolled", who_in, b.result(), by, false);
        if !r.ok { return fail("signers enroll: the record refused the enrolment (" + r.error + "): " + w.last_error()); }
        let now = dna::enrolled_keys(dna::RecordJournal { repo: root, author: "host" });
        if !std::str::contains("\n" + now, "\n" + who_in + " " + key + "\n") { return fail("signers enroll: the enrolment of " + who_in + " is in the record, but it does not count: it is not signed by anyone the record admits (" + by + " signs with " + (if len(dna::person_signing_key(root)) > 0 { "a key the record has not enrolled" } else { "no key: `git config user.signingkey` and `gpg.format ssh` name one" }) + ")"); }
        return answer("enrolled " + who_in + " (" + key[0..std::str::index_of(key + " ", " ")] + ") as a signer of the record, by " + by + "\n");
    }
    if sub == "revoke" {
        if len(who_in) == 0 { return fail("signers revoke: `hale dna signers revoke <who> [--as <who>]`"); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("who", who_in);
        b.string_field("by", by);
        b.end_object();
        let w = dna::RecordJournal { repo: root, author: by };
        let r = w.append_as(w.revision(), "signer.revoked", who_in, b.result(), by, false);
        if !r.ok { return fail("signers revoke: the record refused the revocation (" + r.error + "): " + w.last_error()); }
        let now = dna::enrolled_keys(dna::RecordJournal { repo: root, author: "host" });
        if std::str::contains("\n" + now, "\n" + who_in + " ") { return fail("signers revoke: the revocation of " + who_in + " is in the record, but it does not count: it is not signed by anyone the record admits"); }
        return answer("revoked " + who_in + " as a signer of the record, by " + by + "\n");
    }
    return fail("signers: `hale dna signers [list]`, `hale dna signers enroll <who> --key <ssh public key or file>`, or `hale dna signers revoke <who>`");
}

// ---- hale dna ledger --------------------------------------------------------
//
// The organism's operational memory is the Ledger, in memory beside the
// record, from the record's first row (GH #1590): `hale dna ledger rows`
// reads it.

fn ledger_verb(root: String, sub: String) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    // the ledger's rows, one JSON object per line, as memory holds them:
    // the supported query an export reads (GH #646 stage 4; GH #985)
    if sub == "rows" {
        let env = dna::memory_source(root, dna::own_dsn_env());
        if !dna::dsn_set(env) { return fail("ledger rows: no memory named here (HALE_DNA_MEMORY_DSN_HEAD)"); }
        let l = dna::MemoryLedger { repo: root, dsn_env: env };
        let n = l.revision();
        if len(l.last_error()) > 0 { return fail("ledger rows: " + l.last_error()); }
        let mut out = "";
        let mut i = 0;
        while i < n {
            out = out + dna::row_json(l.read(i), l.store.author_of(i), l.store.writer_of(i)) + "\n";
            i = i + 1;
        }
        return answer(out);
    }
    return fail("ledger: `hale dna ledger rows`");
}
