// std::api — the runtime of `api::serve` (GH #1417, R2a).
//
// spec/api.md § The runtime boundaries. A serve site makes an
// `Exposure`: the locus that admits a framed request against its
// sources, hands an accepted call to its receiver's pool over the bus,
// keeps the call as pending state until the receiver's pool publishes
// the outcome back, and completes it exactly once. A transport is a
// locus that implements `Rpc`; `std::api::test::Rpc`, at the end of this
// file, is the in-process one.
//
// Nothing here waits on a receiver. The call travels on a keyed topic
// (`__ApiRpcCallT`, keyed by the receiver's number), the receiver's
// synthesized subscription runs the handler through the fallible ABI and
// publishes the outcome on `__ApiRpcEventT` (keyed by the exposure),
// and the exposure's handler for that event completes the request. A
// receiver announces each incarnation (`kind` 5, with its stamp) and its
// dissolve (`kind` 6), so the exposure keeps a generation per receiver
// and a call is never run by an incarnation other than the one it was
// handed to. The exposure hands a receiver one call at a time and holds
// the rest itself, so what `stop()` and a receiver's failure refuse is
// exactly what has not been handed over.

// ---- the identity sources (spec/api.md § Identity sources) ----
//
// A role source may answer a principal's grants and its own revision as
// ONE pair, so a check never reads grants from one revision and the number
// from another; a bearer source may state when a credential expires. Both
// are optional extensions of the interfaces api.hl declares, which stay
// as they were: a source written for the structural path is a source
// here. The runtime asks an extension of a source whose declaration states
// it (the compiler wires it from the source's type), and nothing of one
// that does not.

/// A principal's direct grants and the source's revision, as one pair.
type __StdApiGrants {
    // the roles the principal holds directly, comma-joined
    roles: String = "";
    // changes when a grant is added or removed
    revision: Int = 0;
}

/// A role source that states its revision with every answer.
interface __StdApiRevisedRoleSource {
    fn grants(p: std::api::Principal) -> std::api::Grants;
}

/// A role source's announcement that its revision changed, published on
/// the wire subject `__api.roles.revision` (`publish "__api.roles.revision"
/// of type std::api::Revision`; the stdlib declares no `topic`). R5 reads it
/// to invalidate live subscriptions.
type __StdApiRevision {
    source: String = "";
    revision: Int = 0;
}

/// A bearer source that states a credential's expiry: the instant it
/// expires as nanoseconds since the Unix epoch (`std::time::nanos` of a
/// `Time`), 0 for no expiry, read against the runtime's clock. (An `Int`,
/// not a `Time`: a locus method that returns a `Time` does not lower yet.)
interface __StdApiExpiringBearerSource {
    fn expiry(token: String) -> Int;
}

/// The stdlib's static table (`std::api::StaticRoles`) with the revision
/// of a table fixed for the process, answering the pair.
locus __StdApiRevisedStaticRoles {
    params {
        inner: std::api::StaticRoles = std::api::StaticRoles { };
        revision: Int = 0;
    }
    fn holds(p: std::api::Principal, r: String) -> Bool {
        return self.inner.holds(p, r);
    }
    fn grants(p: std::api::Principal) -> std::api::Grants {
        let mut held = "";
        let mut rest = self.inner.known;
        while len(rest) > 0 {
            let sp = std::str::index_of(rest, " ");
            let mut role = rest;
            if sp >= 0 {
                role = rest[0..sp];
                rest = rest[(sp + 1)..len(rest)];
            } else {
                rest = "";
            }
            if len(role) > 0 && self.inner.holds(p, role) {
                if len(held) > 0 {
                    held = held + ",";
                }
                held = held + role;
            }
        }
        return std::api::Grants { roles: held, revision: self.revision };
    }
}

/// What a handler of a served surface may receive in place of `Context`
/// (`fn cancel(c: CancelOrder, ctx: std::api::ServedContext)`): the same
/// fields, and the name of the exposure the call came through and the
/// execution generation of the receiver it was admitted under (spec/api.md
/// § Receiver failure and generations). (`Context` itself is unchanged: a
/// stdlib type is lowered into every program, so a field added to it would
/// move the IR of programs that serve nothing.)
type __StdApiServedContext {
    caller: std::api::Principal = std::api::Principal { };
    role: String = "";
    request_id: Int = 0;
    via: String = "local";
    exposure: String = "";
    generation: Int = 0;
}

/// The framed request a transport hands the runtime.
type __StdApiRequest {
    // 0 a call, 1 a describe, 2 malformed
    kind: Int = 0;
    member: String = "";
    bytes: Bytes;
    digest: String = "";
    correlation: Int = 0;
    credential: String = "";
    peer: std::api::Principal = std::api::Principal { mode: "unix", name: "", uid: -1 };
    reason: String = "";
}

/// The outcome the runtime hands a transport to encode.
type __StdApiOutcome = enum {
    Result(String),
    HandlerError(String),
    Refusal(String, String, String),
    ServerError,
};

/// What a transport implements (spec/api.md § The `Rpc` interface).
interface __StdApiRpc {
    fn attach(exposure: Int) -> String;
    fn frame(raw: Bytes, correlation: Int) -> std::api::Request;
    fn reply(correlation: Int, request_id: Int, caller: std::api::Principal, outcome: std::api::Outcome);
    fn close_connection(correlation: Int);
    fn stop_listening();
}

/// What an exposure's holder stops.
interface __StdApiHandle {
    fn stop();
}

/// The rows an exposure reads, generated per surface by the compiler.
interface __StdApiSurface {
    fn count() -> Int;
    fn slots() -> Int;
    fn member(name: String) -> Int;
    fn name_of(i: Int) -> String;
    fn requires(i: Int) -> String;
    fn receiver(i: Int) -> Int;
    fn check(i: Int, body: String) -> String;
    fn grants(role: String) -> String;
    // The static parts of a description (spec/api.md § The description),
    // written by the compiler from the rows: member `i` as a JSON object,
    // the names of the schemas it reaches, the schemas of the surface in
    // name order, and the roles its rows require, in name order.
    fn member_doc(i: Int) -> String;
    fn refs(i: Int) -> String;
    fn schema_count() -> Int;
    fn schema_name(k: Int) -> String;
    fn schema_doc(k: Int) -> String;
    fn roles() -> String;
}

// ---- the topics a transport, an exposure and a receiver share ----
//
// Five wire subjects: "__api.rpc.ingress" and "__api.rpc.lost" (keyed by
// `exposure`), "__api.rpc.call" and "__api.rpc.hello" (keyed by `key`,
// `on_unmatched: fail`, so a delivery no subscriber took is the
// publisher's to settle) and "__api.rpc.event" (keyed by `exposure`). They
// are declared as topics `__ApiRpcIngressT`, `__ApiRpcLostT`,
// `__ApiRpcCallT`, `__ApiRpcHelloT` and `__ApiRpcEventT` by the compiler
// (`hale_types::rpc_expand`) wherever this source joins a program, because
// a keyed topic's routing, and the `or` of a send whose delivery no
// subscriber took, belong to the program's topic rows. A transport the
// program writes publishes the ingress by its subject
// (`publish "__api.rpc.ingress" of type std::api::RpcIngress`).

/// A transport's raw message, published for the exposure it was attached to.
type __StdApiRpcIngress {
    exposure: Int;
    correlation: Int;
    raw: Bytes;
}

/// A transport's lost connection.
type __StdApiRpcLost {
    exposure: Int;
    correlation: Int;
}

/// An accepted call, handed to the receiver whose number is `key`.
type __StdApiRpcCall {
    key: Int;
    exposure: Int;
    exposure_name: String;
    member: Int;
    rid: Int;
    stamp: Int;
    generation: Int;
    via: String;
    body: String;
    caller: std::api::Principal;
    role: String;
}

/// The exposure asks the receiver whose number is `key` to announce itself.
type __StdApiRpcHello {
    key: Int;
    exposure: Int;
    slot: Int;
}

/// A receiver's word to the exposure. kind: 0 result, 1 handler error,
/// 2 server error, 3 refused by the receiver (a stale handover), 4 started,
/// 5 an incarnation is up (with its stamp), 6 the receiver is gone.
type __StdApiRpcEvent {
    exposure: Int;
    rid: Int;
    slot: Int;
    kind: Int;
    stamp: Int;
    body: String;
}

// ---- the exposure ----

/// One accepted request: the pending table's record. state: 0 free,
/// 1 queued, 2 handed over, 3 started.
type __StdApiRpcEntry {
    rid: Int = 0;
    state: Int = 0;
    slot: Int = 0;
    member: Int = 0;
    gen: Int = 0;
    correlation: Int = 0;
    lost: Bool = false;
    body: String = "";
    caller: std::api::Principal = std::api::Principal { };
    role: String = "";
}

fn __api_rpc_entry_state(e: __StdApiRpcEntry, st: Int) -> __StdApiRpcEntry {
    return __StdApiRpcEntry { rid: e.rid, state: st, slot: e.slot, member: e.member, gen: e.gen, correlation: e.correlation, lost: e.lost, body: e.body, caller: e.caller, role: e.role };
}

fn __api_rpc_entry_gen(e: __StdApiRpcEntry, g: Int) -> __StdApiRpcEntry {
    return __StdApiRpcEntry { rid: e.rid, state: e.state, slot: e.slot, member: e.member, gen: g, correlation: e.correlation, lost: e.lost, body: e.body, caller: e.caller, role: e.role };
}

fn __api_rpc_entry_lost(e: __StdApiRpcEntry) -> __StdApiRpcEntry {
    return __StdApiRpcEntry { rid: e.rid, state: e.state, slot: e.slot, member: e.member, gen: e.gen, correlation: e.correlation, lost: true, body: e.body, caller: e.caller, role: e.role };
}

/// The first role of a comma-joined list.
fn __api_rpc_first(csv: String) -> String {
    let comma = std::str::index_of(csv, ",");
    if comma >= 0 {
        return csv[0..comma];
    }
    return csv;
}

/// Whether `role` is one of a comma-joined list.
fn __api_rpc_has(csv: String, role: String) -> Bool {
    return std::str::contains("," + csv + ",", "," + role + ",");
}

// ---- the JSON tokens of a scalar payload ----
//
// A payload that is one scalar is that scalar's complete JSON token and
// nothing else (spec/api.md § Payloads): the generated decoders ask these
// first, so a token of the wrong kind is refused `malformed` before it is
// converted, never read as the type's zero or as its first characters.

fn __api_json_digit(c: Int) -> Bool {
    return c >= 48 && c <= 57;
}

fn __api_json_hex(c: Int) -> Bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

/// The index past the run of one or more digits at `i`, or -1.
fn __api_json_run(t: String, i: Int) -> Int {
    let n = len(t);
    if i >= n { return -1; }
    if !__api_json_digit(std::str::byte_at_unchecked(t, i)) { return -1; }
    let mut j = i + 1;
    while j < n && __api_json_digit(std::str::byte_at_unchecked(t, j)) { j = j + 1; }
    return j;
}

/// The index past a JSON number's integer part at `i` (`-`, then `0` or a
/// digit run without a leading zero), or -1.
fn __api_json_whole(t: String, i: Int) -> Int {
    let n = len(t);
    let mut at = i;
    if at < n && std::str::byte_at_unchecked(t, at) == 45 { at = at + 1; }
    if at >= n { return -1; }
    let c = std::str::byte_at_unchecked(t, at);
    if c == 48 { return at + 1; }
    if c < 49 || c > 57 { return -1; }
    return __api_json_run(t, at);
}

/// Whether the trimmed token is `true` or `false`.
fn __api_json_is_bool(t: String) -> Bool {
    return t == "true" || t == "false";
}

/// Whether the trimmed token is a JSON number with no fraction and no
/// exponent.
fn __api_json_is_int(t: String) -> Bool {
    return __api_json_whole(t, 0) == len(t);
}

/// Whether the trimmed token is a JSON number (an integer is one).
fn __api_json_is_float(t: String) -> Bool {
    let n = len(t);
    let mut at = __api_json_whole(t, 0);
    if at < 0 { return false; }
    if at < n && std::str::byte_at_unchecked(t, at) == 46 {
        at = __api_json_run(t, at + 1);
        if at < 0 { return false; }
    }
    if at < n && (std::str::byte_at_unchecked(t, at) == 101 || std::str::byte_at_unchecked(t, at) == 69) {
        at = at + 1;
        if at < n && (std::str::byte_at_unchecked(t, at) == 43 || std::str::byte_at_unchecked(t, at) == 45) { at = at + 1; }
        at = __api_json_run(t, at);
        if at < 0 { return false; }
    }
    return at == n;
}

/// Whether the trimmed token is one JSON string: quoted, no raw quote or
/// control character inside, every escape one JSON defines.
fn __api_json_is_string(t: String) -> Bool {
    let n = len(t);
    if n < 2 { return false; }
    if std::str::byte_at_unchecked(t, 0) != 34 || std::str::byte_at_unchecked(t, n - 1) != 34 { return false; }
    let last = n - 1;
    let mut i = 1;
    while i < last {
        let c = std::str::byte_at_unchecked(t, i);
        if c == 34 || c < 32 { return false; }
        if c == 92 {
            if i + 1 >= last { return false; }
            let e = std::str::byte_at_unchecked(t, i + 1);
            if e == 117 {
                if i + 5 >= last { return false; }
                let mut k = 2;
                while k <= 5 {
                    if !__api_json_hex(std::str::byte_at_unchecked(t, i + k)) { return false; }
                    k = k + 1;
                }
                i = i + 6;
            } else if e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116 {
                i = i + 2;
            } else {
                return false;
            }
        } else {
            i = i + 1;
        }
    }
    return true;
}

@form(vec)
locus __StdApiRpcEntries {
    capacity { heap items of __StdApiRpcEntry; }
}

/// A transport that does nothing: the default of an exposure's transport.
locus __StdApiNoRpc {
    fn attach(exposure: Int) -> String { return ""; }
    fn frame(raw: Bytes, correlation: Int) -> std::api::Request {
        return std::api::Request { kind: 2, bytes: raw, correlation: correlation, reason: "no transport" };
    }
    fn reply(correlation: Int, request_id: Int, caller: std::api::Principal, outcome: std::api::Outcome) { }
    fn close_connection(correlation: Int) { }
    fn stop_listening() { }
}

/// Rows with no member: the default of an exposure's surface.
locus __StdApiNoSurface {
    fn count() -> Int { return 0; }
    fn slots() -> Int { return 0; }
    fn member(name: String) -> Int { return -1; }
    fn name_of(i: Int) -> String { return ""; }
    fn requires(i: Int) -> String { return ""; }
    fn receiver(i: Int) -> Int { return 0; }
    fn check(i: Int, body: String) -> String { return ""; }
    fn grants(role: String) -> String { return role; }
    fn member_doc(i: Int) -> String { return ""; }
    fn refs(i: Int) -> String { return ""; }
    fn schema_count() -> Int { return 0; }
    fn schema_name(k: Int) -> String { return ""; }
    fn schema_doc(k: Int) -> String { return ""; }
    fn roles() -> String { return ""; }
}

/// A role source that holds nobody: the default of an exposure's.
locus __StdApiNoRoles {
    fn holds(p: std::api::Principal, r: String) -> Bool { return false; }
}

/// A bearer source with no expiry: the default of an exposure's.
locus __StdApiNoExpiry {
    fn expiry(token: String) -> Int { return 0; }
}

/// A role source that states no revision: the default of an exposure's.
locus __StdApiNoRevision {
    fn grants(p: std::api::Principal) -> std::api::Grants { return std::api::Grants { roles: "", revision: 0 }; }
}

/// The locus the runtime builds per serve site. Everything here is the
/// compiler's: a program names an exposure only as the handle `api::serve`
/// returns, and calls `stop()` on it.
locus __StdApiExposure {
    params {
        id: Int = 0;
        name: String = "";
        surface: String = "";
        digest: String = "";
        bound: Int = 0;
        transport: std::api::Rpc = __StdApiNoRpc { };
        rows: std::api::Surface = __StdApiNoSurface { };
        bearer: std::api::BearerSource = std::api::NoBearer { };
        roles: std::api::RoleSource = __StdApiNoRoles { };
        expiring: std::api::ExpiringBearerSource = __StdApiNoExpiry { };
        revised: std::api::RevisedRoleSource = __StdApiNoRevision { };
        has_expiry: Bool = false;
        has_revised: Bool = false;
        via: String = "";
        // the listener's address, as the description states it (`bind:`)
        address: String = "";
        accepting: Bool = true;
        stopped: Bool = false;
        next_rid: Int = 1;
        inflight: Int = 0;
        entries: __StdApiRpcEntries = __StdApiRpcEntries { };
        slot_state: [Int; 16] = [0; 16];
        slot_stamp: [Int; 16] = [0; 16];
        slot_gen: [Int; 16] = [0; 16];
        slot_busy: [Int; 16] = [0; 16];
        hello_sent: [Int; 16] = [0; 16];
        probe_ok: Bool = true;
        // how long a shutdown waits for the calls executing: stop() waits
        // for them (a handler may take a while); a teardown, which may be
        // the process's, with the pools of its receivers gone, does not
        stop_wait_ms: Int = 10000;
        teardown_wait_ms: Int = 1000;
    }
    bus {
        subscribe __ApiRpcIngressT as on_ingress where key == self.id;
        subscribe __ApiRpcLostT as on_lost where key == self.id;
        subscribe __ApiRpcEventT as on_event where key == self.id;
        publish __ApiRpcCallT;
        publish __ApiRpcHelloT;
    }
    birth() {
        self.via = self.transport.attach(self.id);
        let n = self.rows.slots();
        let mut s = 0;
        while s < n {
            self.hello(s);
            s = s + 1;
        }
    }
    drain() {
        self.shutdown(self.teardown_wait_ms);
    }
    dissolve() {
        self.shutdown(self.teardown_wait_ms);
    }
    fn key_of(slot: Int) -> Int {
        return self.id * 100 + slot;
    }
    fn hello(slot: Int) {
        self.hello_sent[slot] = 1;
        __ApiRpcHelloT <- __StdApiRpcHello { key: self.key_of(slot), exposure: self.id, slot: slot } or self.gone(slot);
    }
    fn refuse(corr: Int, rid: Int, who: std::api::Principal, kind: String, reason: String, extra: String) {
        self.transport.reply(corr, rid, who, __StdApiOutcome::Refusal(kind, reason, extra));
    }
    // Whether the caller holds `role` under this exposure's role source:
    // directly or through a role that includes it (`grants` of the rows).
    fn holds_role(held: String, p: std::api::Principal, role: String) -> Bool {
        let mut rest = self.rows.grants(role);
        while len(rest) > 0 {
            let comma = std::str::index_of(rest, ",");
            let mut g = rest;
            if comma >= 0 {
                g = rest[0..comma];
                rest = rest[(comma + 1)..len(rest)];
            } else {
                rest = "";
            }
            if self.has_revised {
                if __api_rpc_has(held, g) { return true; }
            } else {
                if self.roles.holds(p, g) { return true; }
            }
        }
        return false;
    }
    fn missing_role(p: std::api::Principal, requires: String) -> String {
        let mut held = "";
        if self.has_revised {
            held = self.revised.grants(p).roles;
        }
        let mut rest = requires;
        while len(rest) > 0 {
            let comma = std::str::index_of(rest, ",");
            let mut r = rest;
            if comma >= 0 {
                r = rest[0..comma];
                rest = rest[(comma + 1)..len(rest)];
            } else {
                rest = "";
            }
            if !self.holds_role(held, p, r) { return r; }
        }
        return "";
    }
    fn principal_json(p: std::api::Principal) -> String {
        return "{\"mode\":\"" + std::json::escape_string(p.mode) + "\",\"name\":\"" + std::json::escape_string(p.name) + "\"}";
    }
    // spec/api.md § The runtime boundaries, describing: the members the
    // caller may call, by the rows admission reads.
    fn describe(p: std::api::Principal) -> String {
        let mut held = "";
        if self.has_revised {
            held = self.revised.grants(p).roles;
        }
        let n = self.rows.count();
        let mut members = "";
        let mut i = 0;
        while i < n {
            let req = self.rows.requires(i);
            if len(self.missing_role(p, req)) == 0 {
                if len(members) > 0 { members = members + ","; }
                members = members + "{\"name\":\"" + self.rows.name_of(i) + "\",\"requires\":[";
                let mut rest = req;
                let mut first = true;
                while len(rest) > 0 {
                    let comma = std::str::index_of(rest, ",");
                    let mut r = rest;
                    if comma >= 0 {
                        r = rest[0..comma];
                        rest = rest[(comma + 1)..len(rest)];
                    } else {
                        rest = "";
                    }
                    if !first { members = members + ","; }
                    members = members + "\"" + r + "\"";
                    first = false;
                }
                members = members + "]}";
            }
            i = i + 1;
        }
        return "{\"description\":1,\"exposure\":\"" + self.surface + "@" + self.digest + "/" + self.name + "\",\"name\":\"" + self.name + "\",\"surface\":\"" + self.surface + "\",\"digest\":\"" + self.digest + "\",\"caller\":" + self.principal_json(p) + ",\"members\":[" + members + "]}";
    }
    // The full document of spec/api.md § The description, for a transport
    // that serves it whole (`http`): the caller's members and the schemas
    // they reach, from the compiler's static parts, filtered by the same
    // rows and sources admission reads.
    fn describe_full(p: std::api::Principal) -> String {
        let mut held = "";
        if self.has_revised {
            held = self.revised.grants(p).roles;
        }
        let n = self.rows.count();
        let mut members = "";
        let mut reached = ",";
        let mut i = 0;
        while i < n {
            if len(self.missing_role(p, self.rows.requires(i))) == 0 {
                if len(members) > 0 { members = members + ","; }
                members = members + self.rows.member_doc(i);
                reached = reached + self.rows.refs(i) + ",";
            }
            i = i + 1;
        }
        let mut schemas = "";
        let sc = self.rows.schema_count();
        let mut k = 0;
        while k < sc {
            let name = self.rows.schema_name(k);
            if std::str::index_of(reached, "," + name + ",") >= 0 {
                if len(schemas) > 0 { schemas = schemas + ","; }
                schemas = schemas + "\"" + name + "\":" + self.rows.schema_doc(k);
            }
            k = k + 1;
        }
        let mut roles = "";
        let mut rest = self.rows.roles();
        while len(rest) > 0 {
            let comma = std::str::index_of(rest, ",");
            let mut r = rest;
            if comma >= 0 {
                r = rest[0..comma];
                rest = rest[(comma + 1)..len(rest)];
            } else {
                rest = "";
            }
            if self.holds_role(held, p, r) {
                if len(roles) > 0 { roles = roles + ","; }
                roles = roles + "\"" + r + "\"";
            }
        }
        return "{\"description\":1,\"exposure\":\"" + self.surface + "@" + self.digest + "/" + self.name + "\",\"name\":\"" + self.name + "\",\"surface\":\"" + self.surface + "\",\"digest\":\"" + self.digest + "\",\"listener\":{\"transport\":\"" + self.via + "\",\"address\":\"" + std::json::escape_string(self.address) + "\"},\"codec\":\"json\",\"caller\":{\"principal\":" + self.principal_json(p) + ",\"roles\":[" + roles + "]},\"members\":[" + members + "],\"streams\":[],\"outcomes\":" + __api_http_outcomes() + ",\"schemas\":{" + schemas + "},\"notes\":" + __api_notes() + "}";
    }
    fn on_ingress(i: __StdApiRpcIngress) {
        let rid = self.next_rid;
        self.next_rid = rid + 1;
        let r = self.transport.frame(i.raw, i.correlation);
        let nobody = std::api::Principal { mode: r.peer.mode, name: "", via: self.via };
        if r.kind == 2 {
            self.refuse(i.correlation, rid, nobody, "malformed", r.reason, "");
            return;
        }
        // the caller's Context, from the exposure's sources: a bearer token
        // the bearer source names, or the peer the transport vouches for
        let mut who = r.peer;
        let mut named = false;
        if len(r.credential) > 0 {
            let p = self.bearer.principal(r.credential);
            who = std::api::Principal { mode: "bearer", name: p.name, uid: p.uid, gid: p.gid, pid: p.pid, groups: p.groups, via: self.via };
            named = len(p.name) > 0;
            if !named {
                let why = self.bearer.refused();
                self.refuse(i.correlation, rid, who, "unauthenticated", (if len(why) > 0 { why } else { "the bearer token is refused" }), "");
                return;
            }
            if self.has_expiry {
                let at = self.expiring.expiry(r.credential);
                if at != 0 && at < std::time::nanos(std::time::current()) {
                    self.refuse(i.correlation, rid, who, "unauthenticated", "expired", "");
                    return;
                }
            }
        } else {
            named = who.uid >= 0 && len(who.name) > 0;
        }
        if !named {
            let mut why = "the sources name nobody";
            if who.mode == "unix" { why = "the kernel did not name the peer"; }
            self.refuse(i.correlation, rid, who, "unauthenticated", why, "");
            return;
        }
        if r.kind == 1 {
            if self.via == "http" {
                self.transport.reply(i.correlation, rid, who, __StdApiOutcome::Result(self.describe_full(who)));
            } else {
                self.transport.reply(i.correlation, rid, who, __StdApiOutcome::Result(self.describe(who)));
            }
            return;
        }
        if len(r.digest) > 0 && r.digest != self.digest {
            self.refuse(i.correlation, rid, who, "digest_mismatch", "the request was generated against " + r.digest, self.digest);
            return;
        }
        let m = self.rows.member(r.member);
        if m < 0 {
            self.refuse(i.correlation, rid, who, "malformed", "unknown_member: " + r.member, "");
            return;
        }
        let req = self.rows.requires(m);
        let miss = self.missing_role(who, req);
        if len(miss) > 0 {
            self.refuse(i.correlation, rid, who, "unauthorized", r.member + " requires " + miss, req);
            return;
        }
        let body = std::str::from_bytes(r.bytes);
        let why = self.rows.check(m, body);
        if len(why) > 0 {
            self.refuse(i.correlation, rid, who, "malformed", why, "");
            return;
        }
        if !self.accepting {
            self.refuse(i.correlation, rid, who, "shutting_down", "the exposure is stopping", "");
            return;
        }
        if self.inflight >= self.bound {
            self.refuse(i.correlation, rid, who, "full", "the exposure holds its bound of requests accepted and not yet answered", "");
            return;
        }
        let slot = self.rows.receiver(m);
        if self.slot_state[slot] == 2 {
            // The receiver was unavailable when last asked. It may be back
            // (a restart lowers a failure's drain request and announces
            // nothing): ask again, and the bus says at once whether anyone
            // is there to answer.
            self.probe_ok = true;
            __ApiRpcHelloT <- __StdApiRpcHello { key: self.key_of(slot), exposure: self.id, slot: slot } or self.probe_failed();
            if !self.probe_ok {
                self.refuse(i.correlation, rid, who, "unavailable", "the receiver of " + r.member + " is unavailable; the call did not run", "");
                return;
            }
            self.slot_state[slot] = 0;
            self.hello_sent[slot] = 1;
        }
        self.inflight = self.inflight + 1;
        self.admit(__StdApiRpcEntry { rid: rid, state: 1, slot: slot, member: m, gen: self.slot_gen[slot], correlation: i.correlation, lost: false, body: body, caller: who, role: __api_rpc_first(req) });
        self.pump(slot);
    }
    // The pending table holds the requests accepted and not yet answered
    // and nothing else: a request takes the first free record (`finish`
    // frees it), so the table is never longer than the bound. A record's
    // place is not its identity (the request id is, and it only grows), and
    // the queue's order is the request ids', never the places'.
    fn admit(e: __StdApiRpcEntry) {
        let n = self.entries.len();
        let mut k = 0;
        while k < n {
            let held = self.entries.get(k) or __StdApiRpcEntry { };
            if held.state == 0 {
                self.entries.set(k, e) or discard;
                return;
            }
            k = k + 1;
        }
        self.entries.push(e);
    }
    /// The records the pending table holds, free ones included: never more
    /// than the bound.
    fn table_len() -> Int {
        return self.entries.len();
    }
    /// The requests accepted and not yet answered.
    fn pending() -> Int {
        return self.inflight;
    }
    fn on_lost(l: __StdApiRpcLost) {
        let n = self.entries.len();
        let mut k = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state != 0 && e.correlation == l.correlation && !e.lost {
                self.entries.set(k, __api_rpc_entry_lost(e)) or discard;
            }
            k = k + 1;
        }
    }
    fn index_of(rid: Int) -> Int {
        let n = self.entries.len();
        let mut k = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state != 0 && e.rid == rid { return k; }
            k = k + 1;
        }
        return -1;
    }
    // Completion's one owner: the record is removed, the unit of the
    // bound released and the outcome delivered (or dropped, the connection
    // being lost) here and nowhere else.
    fn finish(k: Int, outcome: std::api::Outcome) {
        let e = self.entries.get(k) or __StdApiRpcEntry { };
        if e.state == 0 { return; }
        self.entries.set(k, __StdApiRpcEntry { }) or discard;
        self.inflight = self.inflight - 1;
        if self.slot_busy[e.slot] == e.rid {
            self.slot_busy[e.slot] = 0;
        }
        if e.lost {
            self.transport.close_connection(e.correlation);
        } else {
            self.transport.reply(e.correlation, e.rid, e.caller, outcome);
        }
    }
    fn unavailable(k: Int) {
        let e = self.entries.get(k) or __StdApiRpcEntry { };
        self.finish(k, __StdApiOutcome::Refusal("unavailable", "the receiver of " + self.rows.name_of(e.member) + " is unavailable; the call did not run", ""));
    }
    fn settle_slot(slot: Int, state: Int) {
        let n = self.entries.len();
        let mut k = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state == state && e.slot == slot { self.unavailable(k); }
            k = k + 1;
        }
    }
    fn probe_failed() {
        self.probe_ok = false;
    }
    fn gone(slot: Int) {
        self.slot_state[slot] = 2;
        self.settle_slot(slot, 1);
    }
    // Hand the oldest queued call of `slot` to its receiver, if the
    // receiver is free and known.
    fn pump(slot: Int) {
        if self.slot_busy[slot] != 0 { return; }
        let n = self.entries.len();
        let mut best = -1;
        let mut best_rid = 0;
        let mut k = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state == 1 && e.slot == slot && (best < 0 || e.rid < best_rid) {
                best = k;
                best_rid = e.rid;
            }
            k = k + 1;
        }
        if best < 0 { return; }
        if self.slot_state[slot] == 0 {
            if self.hello_sent[slot] == 0 { self.hello(slot); }
            return;
        }
        if self.slot_state[slot] == 2 {
            self.unavailable(best);
            self.pump(slot);
            return;
        }
        let e = self.entries.get(best) or __StdApiRpcEntry { };
        if e.gen != self.slot_gen[slot] {
            self.unavailable(best);
            self.pump(slot);
            return;
        }
        self.entries.set(best, __api_rpc_entry_state(e, 2)) or discard;
        self.slot_busy[slot] = e.rid;
        __ApiRpcCallT <- __StdApiRpcCall { key: self.key_of(slot), exposure: self.id, exposure_name: self.name, member: e.member, rid: e.rid, stamp: self.slot_stamp[slot], generation: e.gen, via: self.via, body: e.body, caller: e.caller, role: e.role } or self.gone_dispatch(slot);
    }
    // The bus found no subscriber to hand the call to: the receiver is
    // draining or gone. The call, and every call queued behind it, did not run.
    fn gone_dispatch(slot: Int) {
        self.slot_busy[slot] = 0;
        self.slot_state[slot] = 2;
        self.settle_slot(slot, 2);
        self.settle_slot(slot, 1);
    }
    fn on_event(ev: __StdApiRpcEvent) {
        if ev.kind == 5 {
            // an incarnation of the receiver is up. One announced twice (its
            // birth, and its answer to the exposure's hello) is one
            // incarnation: nothing about it is new.
            if self.slot_state[ev.slot] == 1 && self.slot_stamp[ev.slot] == ev.stamp {
                self.pump(ev.slot);
                return;
            }
            let was = self.slot_state[ev.slot];
            self.slot_stamp[ev.slot] = ev.stamp;
            self.slot_state[ev.slot] = 1;
            self.slot_gen[ev.slot] = self.slot_gen[ev.slot] + 1;
            if was != 1 {
                // the first word, or the word of a receiver that was
                // unavailable and is back: calls admitted while the exposure
                // waited for it adopt its generation
                let n = self.entries.len();
                let mut k = 0;
                while k < n {
                    let e = self.entries.get(k) or __StdApiRpcEntry { };
                    if e.state == 1 && e.slot == ev.slot {
                        self.entries.set(k, __api_rpc_entry_gen(e, self.slot_gen[ev.slot])) or discard;
                    }
                    k = k + 1;
                }
            } else {
                // handed over, not started: the incarnation it was handed to
                // is gone and its successor refuses the stale stamp
                self.settle_slot(ev.slot, 2);
            }
            self.pump(ev.slot);
            return;
        }
        if ev.kind == 6 {
            // an incarnation went: the one the exposure knows, or an older
            // one a successor has already replaced (whose departure is news
            // to nobody)
            if ev.stamp != self.slot_stamp[ev.slot] {
                return;
            }
            self.slot_state[ev.slot] = 2;
            self.settle_slot(ev.slot, 2);
            self.settle_slot(ev.slot, 1);
            // (A call that started keeps its place: a violating handler's
            // owner may dissolve the receiver before the thunk answers.)
            return;
        }
        let k = self.index_of(ev.rid);
        if k < 0 { return; }
        if ev.kind == 4 {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            self.entries.set(k, __api_rpc_entry_state(e, 3)) or discard;
            return;
        }
        let e = self.entries.get(k) or __StdApiRpcEntry { };
        let slot = e.slot;
        if ev.kind == 0 { self.finish(k, __StdApiOutcome::Result(ev.body)); }
        if ev.kind == 1 { self.finish(k, __StdApiOutcome::HandlerError(ev.body)); }
        if ev.kind == 2 { self.finish(k, __StdApiOutcome::ServerError); }
        if ev.kind == 3 { self.unavailable(k); }
        self.pump(slot);
    }
    fn executing() -> Int {
        let n = self.entries.len();
        let mut k = 0;
        let mut c = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state == 2 || e.state == 3 { c = c + 1; }
            k = k + 1;
        }
        return c;
    }
    /// Close admission, refuse the queue, let the executing finish,
    /// release the listener. Idempotent; the handle's dissolution and its
    /// owner's teardown run it.
    fn stop() {
        self.shutdown(self.stop_wait_ms);
    }
    // A call whose receiver cannot finish it (its pool was shut down under
    // it, which a process teardown does) is not waited for forever: past
    // `wait_ms` it is abandoned, and its caller observes the transport
    // failure, never a refusal (spec/api.md § Receiver failure and
    // generations: the outcome of a call that may have run is uncertain).
    fn shutdown(wait_ms: Int) {
        if self.stopped { return; }
        self.stopped = true;
        self.accepting = false;
        let n = self.entries.len();
        let mut k = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state == 1 {
                self.finish(k, __StdApiOutcome::Refusal("shutting_down", "the exposure is stopping; the call did not run", ""));
            }
            k = k + 1;
        }
        // the executing calls finish: a sleep yields to the scheduler, so
        // the pool delivers their outcomes while this waits
        let started = std::time::monotonic_ns();
        while self.executing() > 0 && std::time::monotonic_ns() - started < wait_ms * 1000000 {
            std::time::sleep(1ms);
        }
        self.abandon_executing();
        self.transport.stop_listening();
    }
    // The calls that did not complete: no reply, the connection released.
    fn abandon_executing() {
        let n = self.entries.len();
        let mut k = 0;
        while k < n {
            let e = self.entries.get(k) or __StdApiRpcEntry { };
            if e.state == 2 || e.state == 3 {
                self.entries.set(k, __api_rpc_entry_lost(e)) or discard;
                self.finish(k, __StdApiOutcome::ServerError);
            }
            k = k + 1;
        }
    }
}

// ---- the wire of the Unix JSON transport (spec/api.md § Outcomes) ----

/// The kind of an outcome, as a test reads it: `result`, `handler_error`,
/// `server_error`, `refusal:<kind>`.
fn __api_outcome_kind(outcome: std::api::Outcome) -> String {
    let mut kind = "";
    match outcome {
        __StdApiOutcome::Result(b) -> { kind = "result"; },
        __StdApiOutcome::HandlerError(b) -> { kind = "handler_error"; },
        __StdApiOutcome::Refusal(k, r, x) -> { kind = "refusal:" + k; },
        __StdApiOutcome::ServerError -> { kind = "server_error"; },
    }
    return kind;
}

/// A refusal as its object: `{"kind":…,"reason":…}`, plus `"served"` on
/// `digest_mismatch` and `"requires"` on `unauthorized` (`x` is the served
/// digest, or the comma-separated roles).
fn __api_refusal_object(k: String, r: String, x: String) -> String {
    let mut extra = "";
    if k == "digest_mismatch" { extra = ",\"served\":\"" + x + "\""; }
    if k == "unauthorized" {
        let mut arr = "";
        let mut rest = x;
        while len(rest) > 0 {
            let comma = std::str::index_of(rest, ",");
            let mut one = rest;
            if comma >= 0 {
                one = rest[0..comma];
                rest = rest[(comma + 1)..len(rest)];
            } else {
                rest = "";
            }
            if len(arr) > 0 { arr = arr + ","; }
            arr = arr + "\"" + one + "\"";
        }
        extra = ",\"requires\":[" + arr + "]";
    }
    return "{\"kind\":\"" + k + "\",\"reason\":\"" + std::json::escape_string(r) + "\"" + extra + "}";
}

/// The outcome encoding the HTTP transport states in a description
/// (spec/api.md § Outcomes).
fn __api_http_outcomes() -> String {
    return "{\"transport\":\"http\",\"result\":{\"status\":200,\"body\":\"response\"},\"handler_error\":{\"status\":422,\"body\":\"error\"},\"refusal\":{\"body\":\"refusal\",\"status\":{\"malformed\":400,\"digest_mismatch\":409,\"unauthenticated\":401,\"unauthorized\":403,\"full\":429,\"shutting_down\":503,\"unavailable\":503}},\"server_error\":{\"status\":500,\"body\":\"refusal\"},\"transport_failure\":\"the transport's own: the connection ends without a response\"}";
}

/// The notes of a description, in the document's own text.
fn __api_notes() -> String {
    return "{\"authorization\":\"requires is checked against this exposure's role source at the serve site, before a request is queued: a boundary check, never a proof over the program's internal call paths\",\"lifecycle\":\"a request accepted runs to completion: a timeout or a lost connection does not mean it did not run, and ending the wait never rolls it back\",\"discovery\":\"this document lists what this caller may use under this exposure's role source; the server still authorizes every request\"}";
}

/// What an outcome says, as the members of a reply object: `"ok":true,
/// "value":…`, `"ok":false,"error":…` or `"ok":false,"refusal":{…}`.
fn __api_outcome_answer(outcome: std::api::Outcome) -> String {
    let mut answer = "";
    match outcome {
        __StdApiOutcome::Result(b) -> {
            answer = "\"ok\":true,\"value\":" + b;
        },
        __StdApiOutcome::HandlerError(b) -> {
            answer = "\"ok\":false,\"error\":" + b;
        },
        __StdApiOutcome::Refusal(k, r, x) -> {
            answer = "\"ok\":false,\"refusal\":" + __api_refusal_object(k, r, x);
        },
        __StdApiOutcome::ServerError -> {
            answer = "\"ok\":false,\"refusal\":{\"kind\":\"server\"}";
        },
    }
    return answer;
}

/// The principal as a reply's `caller`; the fixture transport adds the
/// door the call came through (`via`), a socket does not.
fn __api_caller_json(p: std::api::Principal, with_via: Bool) -> String {
    let mut j = "{\"mode\":\"" + std::json::escape_string(p.mode) + "\",\"name\":\"" + std::json::escape_string(p.name) + "\",\"uid\":" + to_string(p.uid) + ",\"gid\":" + to_string(p.gid) + ",\"pid\":" + to_string(p.pid);
    if with_via && len(p.via) > 0 { j = j + ",\"via\":\"" + p.via + "\""; }
    return j + "}";
}

/// The nth `sep`-separated field of `s` ("" past the end; the last field
/// is the rest).
fn __api_field(s: String, sep: String, n: Int) -> String {
    let mut rest = s;
    let mut i = 0;
    while i < n {
        let at = std::str::index_of(rest, sep);
        if at < 0 { return ""; }
        rest = rest[(at + 1)..len(rest)];
        i = i + 1;
    }
    let at = std::str::index_of(rest, sep);
    if at < 0 { return rest; }
    return rest[0..at];
}

// ---- the in-process transport ----

/// One outcome the fixture transport was asked to deliver.
type __StdApiTestRecord {
    correlation: Int = 0;
    request_id: Int = 0;
    kind: String = "";
    line: String = "";
}

@form(vec)
locus __StdApiTestRecords {
    capacity { heap items of __StdApiTestRecord; }
}

/// The nth tab-separated field of `s` ("" past the end).
fn __api_test_field(s: String, n: Int) -> String {
    let mut rest = s;
    let mut i = 0;
    while i < n {
        let tab = std::str::index_of(rest, "\t");
        if tab < 0 { return ""; }
        rest = rest[(tab + 1)..len(rest)];
        i = i + 1;
    }
    let tab = std::str::index_of(rest, "\t");
    if tab < 0 { return rest; }
    return rest[0..tab];
}

/// The fixture transport (`std::api::test::Rpc`): no socket. A test hands
/// it requests and reads what the runtime asked it to deliver, each as the
/// Unix JSON reply line of spec/api.md § Outcomes.
locus __StdApiTestRpc {
    params {
        principals: std::api::BearerSource = std::api::NoBearer { };
        roles: std::api::RoleSource = __StdApiNoRoles { };
        exposure: Int = 0;
        records: __StdApiTestRecords = __StdApiTestRecords { };
        closed: Int = 0;
        listening: Bool = true;
        stops: Int = 0;
        lines: String = "";
        probes: Int = 0;
    }
    bus {
        publish __ApiRpcIngressT;
        publish __ApiRpcLostT;
    }
    fn attach(id: Int) -> String {
        self.exposure = id;
        return "test";
    }
    // The fixture's raw message is the tab-separated line `call` and
    // `describe` build: kind, member, digest, credential, peer mode, peer
    // name, peer uid, payload. Anything else is not a request.
    fn frame(raw: Bytes, correlation: Int) -> std::api::Request {
        let text = std::str::from_bytes(raw);
        let kind = __api_test_field(text, 0);
        let mut k = 2;
        if kind == "call" { k = 0; }
        if kind == "describe" { k = 1; }
        if k == 2 {
            return std::api::Request { kind: 2, bytes: raw, correlation: correlation, reason: "not a request: a line is call or describe" };
        }
        let uid = std::str::parse_int(__api_test_field(text, 6)) or - 1;
        let peer = std::api::Principal { mode: __api_test_field(text, 4), name: __api_test_field(text, 5), uid: uid, gid: uid, pid: 4242 };
        let payload = __api_test_field(text, 7);
        return std::api::Request { kind: k, member: __api_test_field(text, 1), bytes: std::bytes::from_string(payload), digest: __api_test_field(text, 2), correlation: correlation, credential: __api_test_field(text, 3), peer: peer, reason: "" };
    }
    fn reply(correlation: Int, request_id: Int, caller: std::api::Principal, outcome: std::api::Outcome) {
        let kind = __api_outcome_kind(outcome);
        let answer = __api_outcome_answer(outcome);
        let line = "{\"request_id\":" + to_string(request_id) + ",\"id\":" + to_string(correlation) + "," + answer + ",\"caller\":" + __api_caller_json(caller, true) + "}";
        self.records.push(__StdApiTestRecord { correlation: correlation, request_id: request_id, kind: kind, line: line });
    }
    fn close_connection(correlation: Int) {
        self.closed = self.closed + 1;
    }
    fn stop_listening() {
        self.stops = self.stops + 1;
        self.listening = false;
    }
    // ---- what a test drives ----
    fn send(correlation: Int, line: String) {
        __ApiRpcIngressT <- __StdApiRpcIngress { exposure: self.exposure, correlation: correlation, raw: std::bytes::from_string(line) };
    }
    /// A call as a bearer (`credential`) or a Unix peer (`credential` ""
    /// and `uid` ≥ 0 under the name `uid:<n>`), with the digest the client
    /// built against ("" for none).
    fn call(correlation: Int, member: String, payload: String, credential: String) {
        self.send(correlation, "call\t" + member + "\t\t" + credential + "\tunix\tnobody\t-1\t" + payload);
    }
    fn call_as_peer(correlation: Int, member: String, payload: String, uid: Int) {
        self.send(correlation, "call\t" + member + "\t\t\tunix\tuid:" + to_string(uid) + "\t" + to_string(uid) + "\t" + payload);
    }
    fn call_digest(correlation: Int, member: String, payload: String, credential: String, digest: String) {
        self.send(correlation, "call\t" + member + "\t" + digest + "\t" + credential + "\tunix\tnobody\t-1\t" + payload);
    }
    fn describe(correlation: Int, credential: String) {
        self.send(correlation, "describe\t\t\t" + credential + "\tunix\tnobody\t-1\t");
    }
    // Returns once the exposure has marked the record: the loss and a probe
    // go to the exposure's one queue in order, so the probe's reply (a
    // malformed refusal, to a correlation no test uses) is written after the
    // exposure handled the loss.
    fn lose(correlation: Int) {
        __ApiRpcLostT <- __StdApiRpcLost { exposure: self.exposure, correlation: correlation };
        self.probes = self.probes + 1;
        let probe = -1000000 - self.probes;
        self.send(probe, "probe");
        let mut i = 0;
        while i < 3000 && self.outcomes_of(probe) == 0 {
            std::time::sleep(1ms);
            i = i + 1;
        }
    }
    // ---- what a test reads ----
    fn outcomes_of(correlation: Int) -> Int {
        let n = self.records.len();
        let mut k = 0;
        let mut c = 0;
        while k < n {
            let r = self.records.get(k) or __StdApiTestRecord { };
            if r.correlation == correlation { c = c + 1; }
            k = k + 1;
        }
        return c;
    }
    fn record_of(correlation: Int) -> __StdApiTestRecord {
        let n = self.records.len();
        let mut k = 0;
        while k < n {
            let r = self.records.get(k) or __StdApiTestRecord { };
            if r.correlation == correlation { return r; }
            k = k + 1;
        }
        return __StdApiTestRecord { };
    }
    /// The kind of the outcome delivered to `correlation`: `result`,
    /// `handler_error`, `server_error`, `refusal:<kind>`, or "" when none yet.
    fn outcome(correlation: Int) -> String {
        return self.record_of(correlation).kind;
    }
    /// The Unix JSON reply line delivered to `correlation`.
    fn line(correlation: Int) -> String {
        return self.record_of(correlation).line;
    }
    fn request_id(correlation: Int) -> Int {
        return self.record_of(correlation).request_id;
    }
    /// Wait (yielding to the scheduler) for an outcome to `correlation`
    /// and return its kind; "" if none came within `ms` milliseconds.
    fn await_outcome(correlation: Int, ms: Int) -> String {
        let mut i = 0;
        while i < ms && self.outcomes_of(correlation) == 0 {
            std::time::sleep(1ms);
            i = i + 1;
        }
        return self.outcome(correlation);
    }
}

// ---- the Unix transport (spec/api.md § The Unix JSON transport) ----
//
// `std::api::unix::Rpc` is a Unix domain stream socket carrying one JSON
// object per line. It owns three things and nothing of policy:
//
//   * the listener (`__StdApiUnixListener`): it binds at birth, so a path it
//     cannot bind fails the program's boot as a binding does (F.37), and
//     accepts on a pool of its own (`async_io`: an accept or a read parks
//     the coroutine, never the worker). It is a param of the serving main
//     locus, which the compiler adds (only a main locus places);
//   * a connection (`__StdApiUnixPeer`) per accepted socket, on the same
//     pool: it reads the peer's credentials from the kernel once, frames
//     lines, publishes each as the ingress of the exposure and writes the
//     replies the transport hands it;
//   * the transport itself (`__StdApiUnixRpc`), on the exposure's pool: it
//     frames a line into a `Request` and encodes an `Outcome` as a reply.
//
// A connection and the transport meet only on the bus, on the subject
// `__api.unix.out` keyed by `tid << 32 | connection` (a reply, or a close)
// and by `tid` (the listener and every connection of the exposure: close).
// A correlation is `connection << 24 | seq`; the
// client's `id` is kept by the connection and echoed verbatim. An ordinary
// connection failure (EOF, a write that fails, a line that is not an
// object) closes that connection and nothing else.

/// What the transport says to the listener and the connections. kind: 0 a
/// reply for the connection `key` names, 1 close (the connection, or, keyed
/// by the exposure, the listener and every connection, after the replies
/// sent before it).
type __StdApiUnixOut {
    key: Int;
    kind: Int;
    seq: Int;
    request_id: Int;
    answer: String;
    caller: String;
}

/// A request a connection has published and not yet seen answered.
type __StdApiUnixPending {
    seq: Int = 0;
    id: String = "";
}

@form(vec)
locus __StdApiUnixPendings {
    capacity { heap items of __StdApiUnixPending; }
}

/// One accepted connection.
locus __StdApiUnixPeer {
    params {
        conn: Int = 0;
        tid: Int = 0;
        route: Int = 0;
        fd: Int = -1;
        open: Bool = true;
        buf: String = "";
        next_seq: Int = 1;
        header: String = "";
        caller: String = "";
        pending: __StdApiUnixPendings = __StdApiUnixPendings { };
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
    }
    bus {
        subscribe __ApiUnixOutT as on_out where key == self.route;
        subscribe __ApiUnixOutT as on_group where key == self.tid;
        publish __ApiRpcIngressT;
        publish __ApiRpcLostT;
    }
    birth() {
        self.stream = std::io::tcp::Stream { conn_fd: self.fd, owns_fd: false };
        // The peer's credentials, as its kernel vouches for them, once per
        // connection. -1 means the kernel would not say.
        let uid = std::io::unix::peer_uid(self.fd);
        let gid = std::io::unix::peer_gid(self.fd);
        let pid = std::io::unix::peer_pid(self.fd);
        let n = std::io::unix::peer_groups_count(self.fd);
        let mut groups = "";
        let mut k = 0;
        while k < n {
            let g = std::io::unix::peer_group_at(self.fd, k);
            if g >= 0 {
                if len(groups) > 0 { groups = groups + ","; }
                groups = groups + to_string(g);
            }
            k = k + 1;
        }
        self.header = to_string(uid) + ":" + to_string(gid) + ":" + to_string(pid) + ":" + groups;
        self.caller = __api_caller_json(std::api::Principal { mode: "unix", name: "uid:" + to_string(uid), uid: uid, gid: gid, pid: pid }, false);
        // a reader that never reads cannot hold this connection's writer for long
        std::io::tcp::set_send_timeout(self.fd, 5s) or discard;
    }
    @unbounded
    run() {
        while self.open && !self.draining {
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                self.open = false;
            } else {
                self.buf = self.buf + chunk;
                if len(self.buf) > 60000 && std::str::index_of(self.buf, "\n") < 0 {
                    self.write_line("{\"request_id\":0,\"id\":null,\"ok\":false,\"refusal\":{\"kind\":\"malformed\",\"reason\":\"a request is one line of at most 60000 bytes\"},\"caller\":" + self.caller + "}");
                    self.open = false;
                } else {
                    self.drain_lines();
                }
            }
        }
        // the connection is over: the requests it still has with the
        // exposure are lost, and the descriptor is released
        self.lose_all();
        self.release_fd();
    }
    @unbounded
    fn drain_lines() {
        let mut nl = std::str::index_of(self.buf, "\n");
        while nl >= 0 && self.open {
            let line = self.buf[0..nl];
            self.buf = self.buf[(nl + 1)..len(self.buf)];
            self.handle_line(line);
            nl = std::str::index_of(self.buf, "\n");
        }
    }
    fn handle_line(line: String) {
        let t = std::str::trim(line);
        if len(t) == 0 { return; }
        if len(t) > 60000 || !std::json::valid_object(t) {
            self.write_line("{\"request_id\":0,\"id\":null,\"ok\":false,\"refusal\":{\"kind\":\"malformed\",\"reason\":\"a request is one JSON object per line\"},\"caller\":" + self.caller + "}");
            self.hangup();
            return;
        }
        let seq = self.next_seq;
        self.next_seq = (seq % 16777215) + 1;
        let mut id = std::json::find_field_raw(t, "id");
        if len(id) == 0 { id = "null"; }
        self.add(seq, id);
        __ApiRpcIngressT <- __StdApiRpcIngress { exposure: self.tid, correlation: self.conn * 16777216 + seq, raw: std::bytes::from_string(self.header + "\t" + t) };
    }
    fn add(seq: Int, id: String) {
        let n = self.pending.len();
        let mut k = 0;
        while k < n {
            let p = self.pending.get(k) or __StdApiUnixPending { };
            if p.seq == 0 {
                self.pending.set(k, __StdApiUnixPending { seq: seq, id: id }) or discard;
                return;
            }
            k = k + 1;
        }
        self.pending.push(__StdApiUnixPending { seq: seq, id: id });
    }
    fn index_of(seq: Int) -> Int {
        let n = self.pending.len();
        let mut k = 0;
        while k < n {
            let p = self.pending.get(k) or __StdApiUnixPending { };
            if p.seq == seq { return k; }
            k = k + 1;
        }
        return -1;
    }
    fn lose_all() {
        let n = self.pending.len();
        let mut k = 0;
        while k < n {
            let p = self.pending.get(k) or __StdApiUnixPending { };
            if p.seq != 0 {
                self.pending.set(k, __StdApiUnixPending { }) or discard;
                __ApiRpcLostT <- __StdApiRpcLost { exposure: self.tid, correlation: self.conn * 16777216 + p.seq };
            }
            k = k + 1;
        }
    }
    fn on_out(o: __StdApiUnixOut) {
        if o.kind == 1 {
            self.hangup();
            return;
        }
        if o.kind != 0 || !self.open { return; }
        let k = self.index_of(o.seq);
        if k < 0 { return; }
        let p = self.pending.get(k) or __StdApiUnixPending { };
        self.pending.set(k, __StdApiUnixPending { }) or discard;
        self.write_line("{\"request_id\":" + to_string(o.request_id) + ",\"id\":" + p.id + "," + o.answer + ",\"caller\":" + o.caller + "}");
    }
    fn on_group(o: __StdApiUnixOut) {
        if o.kind == 1 { self.hangup(); }
    }
    fn write_line(line: String) {
        if self.fd < 0 { return; }
        // a write that fails closes this connection, and only this one
        self.stream.send(line + "\n") or { self.hangup(); };
    }
    // Stop reading: the shutdown wakes the reader, which ends the connection.
    fn hangup() {
        self.open = false;
        if self.fd >= 0 { std::io::tcp::__shutdown_listen_socket(self.fd); }
    }
    fn release_fd() {
        if self.fd >= 0 {
            std::io::tcp::__close_fd(self.fd);
            self.fd = -1;
        }
    }
}

/// The listening socket, on its own pool (`std::api::unix::Listener`; the
/// compiler adds one to the main locus per `unix::Rpc` serve site, carrying
/// the transport's `path` and the exposure's number).
locus __StdApiUnixListener {
    params {
        path: String = "";
        tid: Int = 0;
        fd: Int = -1;
        started: Bool = false;
        stopped: Bool = false;
        next_conn: Int = 1;
    }
    bus {
        subscribe __ApiUnixOutT as on_ctl where key == self.tid;
        publish __ApiUnixOutT;
    }
    birth() {
        self.fd = std::io::unix::listen_socket(self.path) or - 1;
        if self.fd < 0 {
            // the structural failure of a binding that cannot be realized
            // (spec/semantics.md): the diagnostic and a non-zero exit
            eprintln("api: unix::Rpc could not listen on " + self.path);
            std::process::exit(2);
        }
    }
    @unbounded
    run() {
        // The path is held from birth, and a client that connects before the
        // exposure is subscribed waits in the socket's backlog: a line read
        // earlier would be published to nobody. The transport answers the
        // listener's asking (kind 4) with kind 3 from the exposure's pool,
        // whose handlers run once the program has finished booting, with the
        // exposure's subscriptions in place; the asking repeats until it does,
        // since nothing says which of the pools starts first.
        while !self.started && !self.stopped && !self.draining {
            __ApiUnixOutT <- __StdApiUnixOut { key: self.tid, kind: 4, seq: 0, request_id: 0, answer: "", caller: "" };
            std::time::sleep(2ms);
        }
        while !self.stopped && !self.draining {
            let conn = std::io::tcp::__accept_one(self.fd);
            if conn < 0 {
                if self.stopped || self.draining { break; }
                // a failed accept (out of descriptors, an aborted
                // connection) ends one connection, never the listener
                std::time::sleep(20ms);
                continue;
            }
            let n = self.next_conn;
            self.next_conn = n + 1;
            __StdApiUnixPeer { conn: n, tid: self.tid, route: self.tid * 4294967296 + n, fd: conn };
        }
    }
    accept(c: __StdApiUnixPeer) { }
    release (c: __StdApiUnixPeer) { }
    fn on_ctl(o: __StdApiUnixOut) {
        if o.kind == 3 { self.started = true; }
        if o.kind == 1 {
            self.stopped = true;
            self.release_socket();
        }
    }
    fn release_socket() {
        if self.fd < 0 { return; }
        std::io::tcp::__shutdown_listen_socket(self.fd);
        std::io::tcp::__close_fd(self.fd);
        self.fd = -1;
        std::io::fs::unlink(self.path) or discard;
    }
    dissolve() {
        self.release_socket();
    }
}

/// The Unix JSON transport (`std::api::unix::Rpc`; `unix::Rpc` at a serve
/// site). `tid` is the number of the exposure it serves, which the compiler
/// writes into the literal, together with the listener it pairs with: a
/// param of the serving locus, placed on a pool of its own (only the main
/// locus can place, so only the main locus serves over a socket). The
/// principal is the peer's kernel credentials, so there is no bearer source.
locus __StdApiUnixRpc {
    params {
        path: String = "";
        roles: std::api::RoleSource = __StdApiNoRoles { };
        tid: Int = 0;
        closed: Int = 0;
        stops: Int = 0;
    }
    bus {
        subscribe __ApiUnixOutT as on_ask where key == self.tid;
        publish __ApiUnixOutT;
    }
    fn attach(exposure: Int) -> String {
        return "unix";
    }
    // The listener asks whether the exposure is there to be published to. A
    // handler of this pool runs only after the boot, which has subscribed the
    // exposure, so any answer is a true one.
    fn on_ask(o: __StdApiUnixOut) {
        if o.kind == 4 {
            __ApiUnixOutT <- __StdApiUnixOut { key: self.tid, kind: 3, seq: 0, request_id: 0, answer: "", caller: "" };
        }
    }
    // The raw message is the connection's credentials (`uid:gid:pid:groups`),
    // a tab, and the line the client sent.
    fn frame(raw: Bytes, correlation: Int) -> std::api::Request {
        let text = std::str::from_bytes(raw);
        let tab = std::str::index_of(text, "\t");
        let head = text[0..tab];
        let line = text[(tab + 1)..len(text)];
        let uid = std::str::parse_int(__api_field(head, ":", 0)) or - 1;
        let gid = std::str::parse_int(__api_field(head, ":", 1)) or - 1;
        let pid = std::str::parse_int(__api_field(head, ":", 2)) or - 1;
        let peer = std::api::Principal { mode: "unix", name: "uid:" + to_string(uid), uid: uid, gid: gid, pid: pid, groups: __api_field(head, ":", 3) };
        let call = std::json::string_field(line, "call");
        if call.kind == "string" {
            let payload = std::json::find_field_raw(line, "payload");
            if len(payload) == 0 {
                return std::api::Request { kind: 2, bytes: raw, correlation: correlation, peer: peer, reason: "a call carries a \"payload\" object" };
            }
            return std::api::Request { kind: 0, member: call.text, bytes: std::bytes::from_string(payload), digest: std::json::find_string_field(line, "digest"), correlation: correlation, peer: peer, reason: "" };
        }
        if std::json::find_field_raw(line, "describe") == "true" {
            return std::api::Request { kind: 1, bytes: raw, correlation: correlation, peer: peer, reason: "" };
        }
        return std::api::Request { kind: 2, bytes: raw, correlation: correlation, peer: peer, reason: "a request is a \"call\" or a \"describe\"" };
    }
    fn reply(correlation: Int, request_id: Int, caller: std::api::Principal, outcome: std::api::Outcome) {
        __ApiUnixOutT <- __StdApiUnixOut { key: self.tid * 4294967296 + correlation / 16777216, kind: 0, seq: correlation % 16777216, request_id: request_id, answer: __api_outcome_answer(outcome), caller: __api_caller_json(caller, false) };
    }
    // The request's connection is gone and its work has completed: nothing
    // is written; whatever is left of the connection is closed.
    fn close_connection(correlation: Int) {
        self.closed = self.closed + 1;
        __ApiUnixOutT <- __StdApiUnixOut { key: self.tid * 4294967296 + correlation / 16777216, kind: 1, seq: 0, request_id: 0, answer: "", caller: "" };
    }
    // Close the listener and every connection, after the replies already
    // sent (one subscriber sees the bus in the order it was published).
    fn stop_listening() {
        self.stops = self.stops + 1;
        __ApiUnixOutT <- __StdApiUnixOut { key: self.tid, kind: 1, seq: 0, request_id: 0, answer: "", caller: "" };
    }
}

// ---- the HTTP transport (spec/api.md § The HTTP transport) ----
//
// `std::api::http::Rpc` serves an exposure over HTTP/1.1, one request per
// connection (`Connection: close`). It is built as the Unix transport is,
// from the stdlib's own primitives (the listen and accept of `std::io::tcp`,
// `std::http::parse_request` and `std::http::header`): the listener
// (`__StdApiHttpListener`) binds at birth and accepts on a pool of its own;
// a connection (`__StdApiHttpPeer`) per accepted socket reads one request
// and publishes its text, whole, as the exposure's ingress (the transport's
// `frame` parses it); the transport (`__StdApiHttpRpc`) frames a request and
// encodes an outcome as a status and a body. The correlation is the
// connection. A connection that fails (a request cut short, a write that
// fails, a client that goes away) ends that connection and nothing else.

/// What the transport says to the listener and the connections. kind: 0 a
/// response for the connection `key` names, 1 close (the connection, or,
/// keyed by the exposure, the listener and every connection, after the
/// responses sent before it), 4 and 3 the listener's asking and the
/// transport's answer that the exposure is there.
type __StdApiHttpOut {
    key: Int;
    kind: Int;
    status: Int;
    body: String;
}

fn __api_http_phrase(status: Int) -> String {
    if status == 200 { return "OK"; }
    if status == 400 { return "Bad Request"; }
    if status == 401 { return "Unauthorized"; }
    if status == 403 { return "Forbidden"; }
    if status == 409 { return "Conflict"; }
    if status == 422 { return "Unprocessable Entity"; }
    if status == 429 { return "Too Many Requests"; }
    if status == 503 { return "Service Unavailable"; }
    return "Internal Server Error";
}

/// The status a refusal kind has (spec/api.md § Outcomes).
fn __api_http_refusal_status(kind: String) -> Int {
    if kind == "malformed" { return 400; }
    if kind == "digest_mismatch" { return 409; }
    if kind == "unauthenticated" { return 401; }
    if kind == "unauthorized" { return 403; }
    if kind == "full" { return 429; }
    if kind == "shutting_down" { return 503; }
    if kind == "unavailable" { return 503; }
    return 500;
}

/// One accepted connection: one request in, one response out.
locus __StdApiHttpPeer {
    params {
        conn: Int = 0;
        tid: Int = 0;
        route: Int = 0;
        fd: Int = -1;
        open: Bool = true;
        published: Bool = false;
        answered: Bool = false;
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
    }
    bus {
        subscribe __ApiHttpOutT as on_out where key == self.route;
        subscribe __ApiHttpOutT as on_group where key == self.tid;
        publish __ApiRpcIngressT;
        publish __ApiRpcLostT;
    }
    birth() {
        self.stream = std::io::tcp::Stream { conn_fd: self.fd, owns_fd: false };
        // a client that stalls cannot hold this connection's reader for long
        let _ = std::io::tcp::__set_recv_timeout_ns(self.fd, 5000000000);
        std::io::tcp::set_send_timeout(self.fd, 5s) or discard;
    }
    @unbounded
    run() {
        // the whole request within 10 s, however slowly it trickles
        let deadline = std::time::monotonic_ns() + 10000000000;
        let mut buf = "";
        let mut head_end = -1;
        while self.open && head_end < 0 && len(buf) < 65536 && std::time::monotonic_ns() < deadline && !self.draining {
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                self.open = false;
            } else {
                buf = buf + chunk;
                head_end = std::str::index_of(buf, "\r\n\r\n");
            }
        }
        if self.open && ((head_end < 0 && len(buf) >= 65536) || head_end > 65536) {
            self.respond(400, "{\"refusal\":" + __api_refusal_object("malformed", "a request head is at most 65536 bytes", "") + "}");
            self.open = false;
        }
        if self.open && head_end >= 0 {
            let head = std::http::parse_request(buf[0..(head_end + 4)]);
            let want = std::str::parse_int(std::http::header(head, "Content-Length")) or 0;
            if want > 1048576 {
                self.respond(400, "{\"refusal\":" + __api_refusal_object("malformed", "a request body is at most 1048576 bytes", "") + "}");
                self.open = false;
            } else {
                let mut have = len(buf) - (head_end + 4);
                while self.open && have < want && std::time::monotonic_ns() < deadline && !self.draining {
                    let chunk = self.stream.recv(65536) or "";
                    if len(chunk) == 0 {
                        self.open = false;
                    } else {
                        buf = buf + chunk;
                        have = len(buf) - (head_end + 4);
                    }
                }
                if self.open && have >= want {
                    // the request is whole: the exposure answers it, and the
                    // wait for the answer is not on the clock of a read
                    let _ = std::io::tcp::__set_recv_timeout_ns(self.fd, 0);
                    self.published = true;
                    __ApiRpcIngressT <- __StdApiRpcIngress { exposure: self.tid, correlation: self.conn, raw: std::bytes::from_string(buf[0..(head_end + 4 + want)]) };
                    // what the client sends meanwhile is not read as a request;
                    // its end of the stream is the connection lost
                    while self.open && !self.draining {
                        let more = self.stream.recv(4096) or "";
                        if len(more) == 0 { self.open = false; }
                    }
                }
            }
        }
        // the connection is over: a request the exposure has not answered is
        // lost, and the descriptor is released
        if self.published && !self.answered {
            self.answered = true;
            __ApiRpcLostT <- __StdApiRpcLost { exposure: self.tid, correlation: self.conn };
        }
        self.release_fd();
    }
    fn on_out(o: __StdApiHttpOut) {
        if o.kind == 1 {
            self.hangup();
            return;
        }
        if o.kind != 0 || !self.open || self.answered { return; }
        self.answered = true;
        self.respond(o.status, o.body);
        self.hangup();
    }
    fn on_group(o: __StdApiHttpOut) {
        if o.kind == 1 { self.hangup(); }
    }
    fn respond(status: Int, body: String) {
        if self.fd < 0 { return; }
        // a write that fails closes this connection, and only this one
        self.stream.send("HTTP/1.1 " + to_string(status) + " " + __api_http_phrase(status) + "\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nContent-Length: " + to_string(len(body)) + "\r\nConnection: close\r\n\r\n" + body) or { self.open = false; };
    }
    // Stop reading: the shutdown wakes the reader, which ends the connection.
    fn hangup() {
        self.open = false;
        if self.fd >= 0 { std::io::tcp::__shutdown_listen_socket(self.fd); }
    }
    fn release_fd() {
        if self.fd >= 0 {
            std::io::tcp::__close_fd(self.fd);
            self.fd = -1;
        }
    }
}

/// The listening socket, on its own pool (`std::api::http::Listener`; the
/// compiler adds one to the main locus per `http::Rpc` serve site, carrying
/// the transport's `bind` and the exposure's number).
locus __StdApiHttpListener {
    params {
        bind: String = "";
        tid: Int = 0;
        fd: Int = -1;
        started: Bool = false;
        stopped: Bool = false;
        next_conn: Int = 1;
    }
    bus {
        subscribe __ApiHttpOutT as on_ctl where key == self.tid;
        publish __ApiHttpOutT;
    }
    birth() {
        // `host:port`; the port is what follows the last colon
        let mut colon = -1;
        let mut k = 0;
        while k < len(self.bind) {
            if self.bind[k..(k + 1)] == ":" { colon = k; }
            k = k + 1;
        }
        let mut host = "127.0.0.1";
        let mut port = -1;
        if colon >= 0 {
            if colon > 0 { host = self.bind[0..colon]; }
            port = std::str::parse_int(self.bind[(colon + 1)..len(self.bind)]) or - 1;
        }
        if port >= 0 && port <= 65535 {
            self.fd = std::io::tcp::__listen_socket(host, port);
        }
        if self.fd < 0 {
            // the structural failure of a binding that cannot be realized
            // (spec/semantics.md): the diagnostic and a non-zero exit
            eprintln("api: http::Rpc could not listen on " + self.bind);
            std::process::exit(2);
        }
    }
    @unbounded
    run() {
        // see the Unix listener: nothing is accepted before the exposure is
        // subscribed, and the asking repeats until the transport answers
        while !self.started && !self.stopped && !self.draining {
            __ApiHttpOutT <- __StdApiHttpOut { key: self.tid, kind: 4, status: 0, body: "" };
            std::time::sleep(2ms);
        }
        while !self.stopped && !self.draining {
            let conn = std::io::tcp::__accept_one(self.fd);
            if conn < 0 {
                if self.stopped || self.draining { break; }
                // a failed accept (out of descriptors, an aborted
                // connection) ends one connection, never the listener
                std::time::sleep(20ms);
                continue;
            }
            let n = self.next_conn;
            self.next_conn = (n % 16777215) + 1;
            __StdApiHttpPeer { conn: n, tid: self.tid, route: self.tid * 4294967296 + n, fd: conn };
        }
    }
    accept(c: __StdApiHttpPeer) { }
    release (c: __StdApiHttpPeer) { }
    fn on_ctl(o: __StdApiHttpOut) {
        if o.kind == 3 { self.started = true; }
        if o.kind == 1 {
            self.stopped = true;
            self.release_socket();
        }
    }
    fn release_socket() {
        if self.fd < 0 { return; }
        std::io::tcp::__shutdown_listen_socket(self.fd);
        std::io::tcp::__close_fd(self.fd);
        self.fd = -1;
    }
    dissolve() {
        self.release_socket();
    }
}

/// The HTTP transport (`std::api::http::Rpc`; `http::Rpc` at a serve site).
/// `tid` is the number of the exposure it serves, which the compiler writes
/// into the literal, together with the listener it pairs with. The principal
/// is the bearer `principals` names; the codec is JSON, the one v1 has.
locus __StdApiHttpRpc {
    params {
        bind: String;
        principals: std::api::BearerSource;
        roles: std::api::RoleSource = __StdApiNoRoles { };
        tid: Int = 0;
        closed: Int = 0;
        stops: Int = 0;
    }
    bus {
        subscribe __ApiHttpOutT as on_ask where key == self.tid;
        publish __ApiHttpOutT;
    }
    fn attach(exposure: Int) -> String {
        return "http";
    }
    fn on_ask(o: __StdApiHttpOut) {
        if o.kind == 4 {
            __ApiHttpOutT <- __StdApiHttpOut { key: self.tid, kind: 3, status: 0, body: "" };
        }
    }
    // The raw message is the request as the client sent it.
    fn frame(raw: Bytes, correlation: Int) -> std::api::Request {
        let req = std::http::parse_request(std::str::from_bytes(raw));
        let nobody = std::api::Principal { mode: "bearer", name: "" };
        if len(req.method) == 0 || len(req.path) == 0 {
            return std::api::Request { kind: 2, bytes: raw, correlation: correlation, peer: nobody, reason: "not an HTTP request" };
        }
        let auth = std::http::header(req, "Authorization");
        let mut token = "";
        if std::str::starts_with(auth, "Bearer ") { token = std::str::trim(auth[7..len(auth)]); }
        let mut path = req.path;
        let q = std::str::index_of(path, "?");
        if q >= 0 { path = path[0..q]; }
        if req.method == "GET" && path == "/.description" {
            return std::api::Request { kind: 1, bytes: raw, correlation: correlation, credential: token, peer: nobody, reason: "" };
        }
        if req.method == "POST" && std::str::starts_with(path, "/call/") {
            let member = std::str::replace(std::str::replace(path[6..len(path)], "%3A", ":"), "%3a", ":");
            if len(req.body) == 0 {
                return std::api::Request { kind: 2, bytes: raw, correlation: correlation, credential: token, peer: nobody, reason: "a call carries a body" };
            }
            return std::api::Request { kind: 0, member: member, bytes: std::bytes::from_string(req.body), digest: std::http::header(req, "Hale-Surface-Digest"), correlation: correlation, credential: token, peer: nobody, reason: "" };
        }
        return std::api::Request { kind: 2, bytes: raw, correlation: correlation, credential: token, peer: nobody, reason: "a request is POST /call/<member> or GET /.description" };
    }
    fn reply(correlation: Int, request_id: Int, caller: std::api::Principal, outcome: std::api::Outcome) {
        let mut status = 500;
        let mut body = "{\"refusal\":{\"kind\":\"server\"}}";
        match outcome {
            __StdApiOutcome::Result(b) -> { status = 200; body = b; },
            __StdApiOutcome::HandlerError(b) -> { status = 422; body = b; },
            __StdApiOutcome::Refusal(k, r, x) -> {
                status = __api_http_refusal_status(k);
                body = "{\"refusal\":" + __api_refusal_object(k, r, x) + "}";
            },
            __StdApiOutcome::ServerError -> { },
        }
        __ApiHttpOutT <- __StdApiHttpOut { key: self.tid * 4294967296 + correlation, kind: 0, status: status, body: body };
    }
    // The request's connection is gone and its work has completed: nothing
    // is written; whatever is left of the connection is closed.
    fn close_connection(correlation: Int) {
        self.closed = self.closed + 1;
        __ApiHttpOutT <- __StdApiHttpOut { key: self.tid * 4294967296 + correlation, kind: 1, status: 0, body: "" };
    }
    // Close the listener and every connection, after the responses already
    // sent (one subscriber sees the bus in the order it was published).
    fn stop_listening() {
        self.stops = self.stops + 1;
        __ApiHttpOutT <- __StdApiHttpOut { key: self.tid, kind: 1, status: 0, body: "" };
    }
}
