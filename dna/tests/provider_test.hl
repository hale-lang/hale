// dna/tests/provider_test.hl — the Provider interface, in memory (phase 4).
//
// A provider produces hosts with what they offer, allocates a role for an
// instance, places it on a host that offers what it needs, applies a render
// on a host and observes an allocation: `up`, `degraded` or `down`. The
// memory implementation does each in the process, so what is asserted here
// is the interface's contract, never a tool on PATH (but for what compose
// reads of the profiles a render hands it, when docker compose is there). The `local` profile's
// preset gives every role the `compose` provider; on `operator` backends the
// servers the operator holds are the `operator`'s.

import "../core" as dna;

// Every role of `roles` (space-separated) allocated for `instance` and
// placed on `host` by `p`: `<role>@<host>` for each placed, `<role>!` for
// each refused, space-separated.
fn place_all(p: dna::Provider, roles: String, instance: String, host: String) -> String {
    let h = p.offers(host);
    let mut out = "";
    let mut rest = roles + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let role = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        let placed = p.place(p.allocate(role, instance), h);
        out = out + (if len(out) > 0 { " " } else { "" })
            + (if placed.placed { role + "@" + placed.host } else { role + "!" });
    }
    return out;
}

// The services compose reads in the project at `dir` under `profiles`, as
// the habitat hands them (`render_wrap`), space-separated, sorted.
fn services_under(dir: String, profiles: String) -> String {
    let r = dna::Render { project: "p", dir: dir, files: "compose.yaml", profiles: profiles };
    let read = dna::run_tool(
        dna::render_wrap(r) + "sh\n-c\n\"$@\" | sort\nsh\ndocker\ncompose\n"
            + dna::compose_args(r, "\n") + "\nconfig\n--services",
    );
    return std::str::replace(dna::trim_nl(read.stdout), "\n", " ") + read.stderr;
}

fn main() {
    let p = dna::MemProvider { };
    std::test::assert_eq_str(p.kind(), "memory", "the memory provider names itself");

    // ---- hosts: produced by the provider, each with what it offers
    let local = p.offers("local");
    std::test::assert(
        local.reachable && local.provider == "memory" && dna::has_word(local.offers, "compose"),
        "the provider produces its host with its offers: " + local.offers,
    );
    let none = p.offers("elsewhere");
    std::test::assert(
        !none.reachable && len(none.why) > 0,
        "a host it does not produce is refused",
    );

    // ---- allocation by role
    let memory = p.allocate("memory", "0123456789ab");
    std::test::assert(
        memory.role == "memory" && memory.instance == "0123456789ab"
            && memory.service == "memory-0123456789ab" && memory.needs == "compose"
            && !memory.placed && len(memory.host) == 0,
        "a role is allocated for an instance, on no host yet: " + memory.service,
    );
    std::test::assert_eq_str(
        p.allocate("database", "0123456789ab").service,
        "memory-0123456789ab",
        "the heart's database is a tenant of the memory server",
    );
    std::test::assert(
        len(p.allocate("cache", "0123456789ab").why) > 0,
        "a role the habitat does not know is refused by name",
    );

    // ---- placement: on a host that offers what the allocation needs
    let placed = p.place(memory, local);
    std::test::assert(placed.placed && placed.host == "local", "placed on the host: " + placed.why);
    let bare = dna::MemProvider { host_offers: "systemd-user" };
    let refused = bare.place(bare.allocate("nerves", "0123456789ab"), bare.offers("local"));
    std::test::assert(
        !refused.placed && std::str::contains(refused.why, "does not offer compose"),
        "a host that does not offer what it needs is refused: " + refused.why,
    );
    // an ssh host last seen ready whose probe just failed keeps its state,
    // but is not placeable: the probe's reason is the refusal
    let ssh = dna::SshProvider { root: "" };
    let stale = dna::Host {
        name: "box-a",
        provider: "ssh",
        offers: "compose",
        state: "ready",
        reachable: false,
        why: "host-key-changed",
    };
    let gated = ssh.place(dna::Allocation { role: "probe", needs: "compose" }, stale);
    std::test::assert(
        !gated.placed && std::str::contains(gated.why, "host-key-changed"),
        "a host whose probe failed is refused with the probe's reason: " + gated.why,
    );
    std::test::assert_eq_str(
        place_all(bare, "head face nerves", "0123456789ab", "local"),
        "head@local face@local nerves!",
        "the head and the face need no offer; the nerves need compose",
    );
    std::test::assert_eq_str(
        place_all(p, "memory nerves head face", "0123456789ab", "local"),
        "memory@local nerves@local head@local face@local",
        "through the interface, every role placed",
    );
    std::test::assert_eq_str(
        place_all(p, "memory", "0123456789ab", "elsewhere"),
        "memory!",
        "never on a host the provider does not produce",
    );

    // ---- observation: down until a render is applied, then up, unless the
    // fixture says otherwise
    std::test::assert_eq_str(p.observe(placed).state, "down", "nothing applied: down");
    let applied = p.apply(
        "local",
        dna::Render {
            project: "p",
            dir: "/d",
            files: "compose.yaml",
            services: "memory-0123456789ab",
        },
    );
    std::test::assert(
        applied.ok
            && p.applied == 1
            && p.last_host == "local"
            && p.last.services == "memory-0123456789ab",
        "a render is applied on the host and kept: " + applied.why,
    );
    std::test::assert_eq_str(p.observe(placed).state, "up", "applied: up");
    let gone = p.withdraw("local", dna::Render { project: "p", dir: "/d" });
    std::test::assert(gone.ok && p.withdrawn == 1, "a render is withdrawn: " + gone.why);
    std::test::assert_eq_str(p.observe(placed).state, "down", "withdrawn: down");
    let back = p.apply("local", dna::Render { project: "p", dir: "/d" });
    std::test::assert(back.ok, "and applied again: " + back.why);
    p.degraded = "0123456789ab/memory";
    std::test::assert_eq_str(p.observe(placed).state, "degraded", "running, not well");
    p.down = "0123456789ab/memory";
    std::test::assert_eq_str(p.observe(placed).state, "down", "and down");
    std::test::assert_eq_str(
        p.observe(p.allocate("nerves", "0123456789ab")).state,
        "down",
        "an allocation never placed is down",
    );
    std::test::assert(
        !p.apply("elsewhere", dna::Render { project: "p", dir: "/d" }).ok,
        "never applied on a host it does not produce",
    );
    let stubborn = dna::MemProvider { refuse_apply: "the host refused" };
    let no = stubborn.apply("local", dna::Render { project: "p", dir: "/d" });
    std::test::assert(!no.ok && no.why == "the host refused", "a refused apply says why");

    // ---- policy: the `local` profile's preset, a provider per role
    std::test::assert(
        dna::profile_provider("local", "own", "memory") == "compose"
            && dna::profile_provider("local", "own", "broker") == "compose"
            && dna::profile_provider("local", "own", "face") == "compose",
        "local on its own backends: compose for every role",
    );
    std::test::assert(
        dna::profile_provider("local", "operator", "memory") == "operator"
            && dna::profile_provider("local", "operator", "nerves") == "operator"
            && dna::profile_provider("local", "operator", "database") == "operator"
            && dna::profile_provider("local", "operator", "head") == "compose"
            && dna::profile_provider("local", "operator", "broker") == "",
        "on operator backends the operator's servers hold memory and nerves, and no broker",
    );
    std::test::assert(
        dna::profile_provider("hosted", "own", "memory") == ""
            && dna::profile_provider("local", "own", "cache") == "",
        "no preset for a profile that is not built, nor a role the habitat does not know",
    );

    // a render whose images are named by its revision is applied without
    // `--build` (compose pulls the revision's image, builds only when none
    // is published); any other is built from its context
    std::test::assert_eq_str(
        dna::compose_up_args(dna::Render { project: "p", revision: "abc", by_revision: true }, " "),
        "up -d --wait",
        "a revision's images are pulled first",
    );
    std::test::assert_eq_str(
        dna::compose_up_args(dna::Render { project: "p", revision: "abc" }, " "),
        "up -d --build --wait",
        "images not named by revision are built",
    );
    std::test::assert_eq_str(
        dna::compose_up_args(dna::Render { project: "p", by_revision: true }, " "),
        "up -d --build --wait",
        "no revision known: built",
    );

    // an organism's own compose is told the heart roles it provides
    // itself, as its graft chose (`parts.json`): each it owns, in order, or
    // `none`, never empty; nothing when no choices were kept
    std::test::assert_eq_str(
        dna::services_profiles(
            "{\"database\": \"own\", \"broker\": \"own\", \"memory\": \"reuse\"}",
        ),
        "database,broker",
        "both its own: both profiles, in order",
    );
    std::test::assert_eq_str(
        dna::services_profiles("{\"broker\": \"own\", \"database\": \"reuse\"}"),
        "broker",
        "the broker its own, the database the habitat's",
    );
    std::test::assert_eq_str(
        dna::services_profiles("{\"database\": \"own\", \"broker\": \"reuse\"}"),
        "database",
        "the database its own",
    );
    std::test::assert_eq_str(
        dna::services_profiles(
            "{\"database\": \"reuse\", \"broker\": \"reuse\", \"memory\": \"own\"}",
        ),
        "none",
        "neither its own (an organism-plane part is no profile): the sentinel",
    );
    std::test::assert_eq_str(dna::services_profiles(""), "", "no choices kept: none handed");
    std::test::assert_eq_str(
        dna::ssh_reader_env(dna::Render { project: "p", habitat: "home", profiles: "none" }),
        "COMPOSE_PROFILES='none' HALE_DNA_HABITAT_NAME='home' ",
        "on an ssh host, on compose's command line",
    );
    let told = dna::run_tool(
        dna::render_wrap(dna::Render { project: "p", profiles: "database,broker" })
            + "sh\n-c\nprintf '%s|' \"$COMPOSE_PROFILES\"",
    );
    std::test::assert_eq_str(
        told.stdout,
        "database,broker|",
        "here, in compose's environment: " + told.stderr,
    );
    std::test::assert_eq_str(
        dna::render_wrap(dna::Render { project: "p", habitat: "home", revision: "abc" }),
        dna::services_wrap("home", "abc", "", ""),
        "a render that names no profiles is handed what it was",
    );
    // compose prefers them to a `.env` at the project's root that names
    // others (an application's default for a toolchain that hands none)
    if dna::run_tool("docker\ncompose\nversion").code == 0 {
        let scratch = dna::scratch_root("provider-profiles");
        std::io::fs::write_file(
            scratch + "/compose.yaml",
            "services:\n  app:\n    image: busybox:1.36\n  db:\n    image: busybox:1.36\n    profiles: [\"database\"]\n  nats:\n    image: busybox:1.36\n    profiles: [\"broker\"]\n",
        ) or discard;
        std::io::fs::write_file(scratch + "/.env", "COMPOSE_PROFILES=database,broker\n") or discard;
        std::test::assert_eq_str(
            services_under(scratch, "none"),
            "app",
            "none: the services under no profile",
        );
        std::test::assert_eq_str(
            services_under(scratch, "broker"),
            "app nats",
            "broker: and the broker's",
        );
        std::test::assert(
            std::str::contains(services_under(scratch, ""), "db"),
            "none handed: the `.env` chooses",
        );
        dna::scratch_done(scratch);
    }

    // what fills a role, as `docker ps` lines of `<image>|<state> <status>`
    // say: the images once each, the state lines as `container_state` reads
    let seen = dna::seen_containers(
        "pgvector/pgvector:pg16|running Up 2 minutes\nnats:2.11-alpine|running Up 2 minutes\nnats:2.11-alpine|exited Exited (0)",
    );
    std::test::assert_eq_str(
        seen.images,
        "pgvector/pgvector:pg16 nats:2.11-alpine",
        "each image once, in order",
    );
    std::test::assert_eq_str(
        seen.states,
        "running Up 2 minutes\nrunning Up 2 minutes\nexited Exited (0)",
        "the state lines without their images",
    );
    // a one-shot that finished (exit 0, a migration) is done, never down
    let st = dna::containers_state("memory", seen.states);
    std::test::assert(
        st.state == "up" && st.detail == "2 running, 1 finished",
        "a finished one-shot is done: " + st.state + " (" + st.detail + ")",
    );
    std::test::assert_eq_str(
        dna::containers_state(
            "memory",
            "running Up 2 minutes\nexited Exited (1) 5 seconds ago",
        ).state,
        "degraded",
        "one that failed is not",
    );
    // with the compose service on each line, what is not running is named
    // (a finished one-shot is not), and a state that is not up says so
    let named = dna::seen_containers(
        "postgres:17|running Up 9 seconds (healthy)|postgres\nvoice-api|created Created|api\nnats:2.11-alpine|created Created|nats\nvoice-api|exited Exited (0) 3 seconds ago|migrate",
    );
    std::test::assert_eq_str(
        named.down,
        "api (created), nats (created)",
        "the services not running, each once",
    );
    std::test::assert_eq_str(
        named.states,
        "running Up 9 seconds (healthy)\ncreated Created\ncreated Created\nexited Exited (0) 3 seconds ago",
        "the state lines without image or service",
    );
    let st = dna::naming_down(dna::containers_state("voice", named.states), named.down);
    std::test::assert_eq_str(
        st.detail,
        "1 of 3 running; not running: api (created), nats (created)",
        "a degraded state names them",
    );
    std::test::assert_eq_str(
        dna::naming_down(dna::containers_state("voice", "running Up 1 minute"), "").detail,
        "running Up 1 minute",
        "an up state is as it was",
    );

    // ---- kept running: the habitat's override of an organism's services
    // (`docker compose config --format json`, as compose reads them): every
    // service labelled, a long-running one given `restart: unless-stopped`,
    // a one-shot another waits on to finish given none, and a policy the
    // files state (`restart`, `deploy.restart_policy`) left as it is
    let config = "{\"name\": \"voice\", \"services\": {"
        + "\"api\": {\"depends_on\": {\"migrate\": {\"condition\": \"service_completed_successfully\", \"required\": true}, \"postgres\": {\"condition\": \"service_healthy\"}}, \"environment\": {\"restart\": \"x\"}, \"image\": \"voice-api:abc\"},"
        + "\"brain\": {\"depends_on\": {\"postgres\": {\"condition\": \"service_started\"}}, \"image\": \"voice-api:abc\", \"restart\": \"no\"},"
        + "\"migrate\": {\"command\": [\"migrate\"], \"image\": \"voice-api:abc\"},"
        + "\"nats\": {\"image\": \"nats:2.11-alpine\", \"deploy\": {\"restart_policy\": {\"condition\": \"on-failure\"}}},"
        + "\"postgres\": {\"image\": \"postgres:17\", \"restart\": \"always\"}}}";
    let labels = "    labels:\n      hale.role: services\n";
    std::test::assert_eq_str(
        dna::one_shot_services(std::json::find_field_raw(config, "services")),
        "migrate",
        "a service another waits on to finish is a one-shot",
    );
    std::test::assert_eq_str(
        dna::services_override(config, labels, ""),
        "services:\n"
            + "  api:\n" + labels + "    restart: unless-stopped\n"
            + "  brain:\n" + labels
            + "  migrate:\n" + labels
            + "  nats:\n" + labels
            + "  postgres:\n" + labels,
        "the long-running service without a policy is kept running; the one-shot and the stated policies are left alone",
    );
    std::test::assert_eq_str(
        dna::services_override("{\"services\": {\"web\": {\"image\": \"w\"}}}", labels, ""),
        "services:\n  web:\n" + labels + "    restart: unless-stopped\n",
        "a service nothing says of is long-running",
    );
    std::test::assert_eq_str(
        dna::services_override("not json", labels, ""),
        "",
        "no config, no override",
    );

    // ---- what a crash leaves: the code a service exited with, and how
    // often docker restarted it (`<image>|<state> <status>|<service>|<restarts>`)
    std::test::assert_eq_str(
        dna::exit_code_of("exited Exited (139) 3 minutes ago"),
        "139",
        "the exit code",
    );
    std::test::assert_eq_str(
        dna::exit_code_of("running Up 2 minutes (healthy)"),
        "",
        "none while running",
    );
    let crashed = dna::seen_containers(
        "postgres:17|running Up 2 hours (healthy)|postgres|0\nvoice-api|exited Exited (139) 5 minutes ago|api|0\nvoice-api|exited Exited (0) 2 hours ago|migrate|0\nnats:2.11-alpine|running Up 2 hours|nats|0\nvoice-api|running Up 2 hours|brain|0",
    );
    std::test::assert_eq_str(
        dna::observed_containers("voice", crashed).detail,
        "3 of 4 running; not running: api (exited 139)",
        "an exited long-running service is down with its exit code",
    );
    let looping = dna::seen_containers(
        "postgres:17|running Up 2 hours|postgres|0\nvoice-api|restarting Restarting (139) 3 seconds ago|api|7",
    );
    let st = dna::observed_containers("voice", looping);
    std::test::assert(
        st.state == "degraded"
            && st.detail == "1 of 2 running; not running: api (restarting, exited 139, 7 restarts)",
        "a crash loop between restarts is degraded, its code and count said: " + st.state + " ("
            + st.detail + ")",
    );
    let between = dna::seen_containers(
        "postgres:17|running Up 2 hours|postgres|0\nvoice-api|running Up 4 seconds|api|8",
    );
    let st = dna::observed_containers("voice", between);
    std::test::assert(
        st.state == "degraded"
            && st.detail == "2 running; restarted: api (8 restarts, up 4 seconds)",
        "and while it runs between two crashes, still degraded: " + st.state + " (" + st.detail
            + ")",
    );
    let recovered = dna::seen_containers(
        "postgres:17|running Up 2 hours|postgres|0\nvoice-api|running Up 3 hours|api|1",
    );
    let st = dna::observed_containers("voice", recovered);
    std::test::assert(
        st.state == "up"
            && st.detail == "2 running; restarted: api (1 restart)"
            && st.runs == "postgres:17 voice-api",
        "a service that came back and stayed is up, its restart said: " + st.state + " ("
            + st.detail + ")",
    );
    // the lines the probe prints, for a project's service alone
    let probe = dna::containers_probe("hale-habitat-voice", "api");
    std::test::assert(
        std::str::contains(probe, "label=com.docker.compose.project=hale-habitat-voice")
            && std::str::contains(probe, "label=com.docker.compose.service=api")
            && std::str::contains(probe, "{{.RestartCount}}")
            && !std::str::contains(probe, "\n"),
        "the probe is one line, filtered to the project and its service: " + probe,
    );

    // ---- a container that did not come up, in its own words: what a
    // failure to bring an allocation up says of it
    std::test::assert(
        dna::container_troubled("restarting", "Restarting (1) 3 seconds ago")
            && dna::container_troubled("exited", "Exited (1) 2 minutes ago")
            && dna::container_troubled("dead", "Dead")
            && dna::container_troubled("created", "Created")
            && dna::container_troubled("running", "Up 2 minutes (unhealthy)"),
        "restarting, failed, dead, never started and unhealthy are troubled",
    );
    std::test::assert(
        !dna::container_troubled("running", "Up 2 minutes (healthy)")
            && !dna::container_troubled("running", "Up 4 seconds")
            && !dna::container_troubled("exited", "Exited (0) 2 hours ago"),
        "running and a finished one-shot are not",
    );
    // a full disk: the cause is the server's own line, kept even when the
    // retry's noise comes after it
    let full = "The files belonging to this database system will be owned by user \"postgres\".\n"
        + "\n"
        + "initdb: error: could not create directory \"/var/lib/postgresql/data/pg_wal\": No space left on device\n"
        + "initdb: removing contents of data directory \"/var/lib/postgresql/data\"\n";
    let said = dna::container_trouble(
        "memory-b7db12d6d180",
        "restarting",
        "Restarting (1) 3 seconds ago",
        full,
    );
    std::test::assert(
        std::str::starts_with(
            said,
            "memory-b7db12d6d180 is restarting (Restarting (1) 3 seconds ago); its last lines:\n    The files",
        )
            && std::str::contains(
                said,
                "\n    initdb: error: could not create directory \"/var/lib/postgresql/data/pg_wal\": No space left on device\n",
            ),
        "the container's state and its last lines, indented: " + said,
    );
    let mut noisy = full;
    let mut i = 0;
    while i < 12 {
        noisy = noisy + "LOG:  retrying " + to_string(i) + "\n";
        i = i + 1;
    }
    let tail = dna::log_tail_said(noisy, 8);
    std::test::assert(
        std::str::starts_with(
            tail,
            "    initdb: error: could not create directory \"/var/lib/postgresql/data/pg_wal\": No space left on device\n    …\n    LOG:  retrying 4\n",
        )
            && std::str::ends_with(tail, "    LOG:  retrying 11"),
        "an older error line leads the last lines: " + tail,
    );
    std::test::assert_eq_str(
        dna::container_trouble("nerves-k", "exited", "Exited (1) 1 second ago", "\n\n"),
        "nerves-k is exited (Exited (1) 1 second ago); it wrote nothing",
        "a container that wrote nothing says so",
    );
    std::test::assert_eq_str(
        dna::with_trouble("docker compose up failed: x", ""),
        "docker compose up failed: x",
        "nothing troubled adds nothing",
    );
}
