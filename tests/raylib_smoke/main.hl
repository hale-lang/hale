// Phase 5 raylib smoke test — opens a real window, draws four
// colored rectangles (iris's layout sketch), polls for ESC/Q
// to exit, runs at 60fps.
//
// Build:  cd iris && hale build tests/raylib_smoke/
// Run:    ./tests/raylib_smoke/raylib_smoke
// Exit:   ESC or Q (raylib's WindowShouldClose also catches
//         window close button)

import "../../lib/raylib" as ray;

fn bg_color()  -> ray::Color { return ray::Color { r: 26,  g: 26,  b: 26  }; }
fn shell_col() -> ray::Color { return ray::Color { r: 80,  g: 80,  b: 80  }; }
fn focus_col() -> ray::Color { return ray::Color { r: 200, g: 200, b: 100 }; }
fn text_col()  -> ray::Color { return ray::Color { r: 234, g: 234, b: 234 }; }

fn draw_pane_frame(rect: ray::Rect, label: String, focused: Bool) {
    let border = if focused { focus_col() } else { shell_col() };
    ray::draw_rect_lines(rect, border);
    let label_w = ray::measure_text(label, 14);
    let cx = Int(rect.x + rect.width / 2.0) - label_w / 2;
    let cy = Int(rect.y + rect.height / 2.0) - 7;
    ray::draw_text(label, cx, cy, 14, text_col());
}

fn main() {
    ray::init_window(1280, 720, "iris — raylib smoke test");
    ray::set_target_fps(60);

    let mut focused_idx = 0;          // 0=shell, 1=source, 2=viz, 3=agent
    let mut frame_count = 0;

    while !ray::should_close() {
        // Cycle focus every 60 frames (~1s at 60fps).
        if frame_count % 60 == 0 && frame_count > 0 {
            focused_idx = (focused_idx + 1) % 4;
        }
        frame_count = frame_count + 1;

        ray::begin_frame();
        ray::clear_background(bg_color());

        // 2x2 tiled layout (matches iris's planned default).
        let margin: Float = 8.0;
        let sw = ray::get_screen_width();
        let sh = ray::get_screen_height();
        let half_w = (sw - margin * 3.0) / 2.0;
        let half_h = (sh - margin * 3.0) / 2.0;
        let lx = margin;
        let rx = margin * 2.0 + half_w;
        let ty = margin;
        let by = margin * 2.0 + half_h;

        draw_pane_frame(
            ray::Rect { x: lx, y: ty, width: half_w, height: half_h },
            "shell", focused_idx == 0
        );
        draw_pane_frame(
            ray::Rect { x: rx, y: ty, width: half_w, height: half_h },
            "source", focused_idx == 1
        );
        draw_pane_frame(
            ray::Rect { x: lx, y: by, width: half_w, height: half_h },
            "viz", focused_idx == 2
        );
        draw_pane_frame(
            ray::Rect { x: rx, y: by, width: half_w, height: half_h },
            "agent", focused_idx == 3
        );

        ray::end_frame();

        // ESC or Q closes (raylib's WindowShouldClose also covers
        // the window-close button + Ctrl+C from the terminal).
        if ray::is_key_pressed(ray::KEY_Q) { break; }
    }

    ray::close_window();
}
