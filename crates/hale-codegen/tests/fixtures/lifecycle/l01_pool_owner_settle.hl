// Decision line 1, construction-time delivery for an owner placed on a
// cooperative pool (ConstructionDelivery). Decision L0-1 names the
// pool's worker as the owner's domain and spec/semantics.md the thread
// settling the parent: for this owner both are the worker.
//
// `Owner` is placed on pool `side`; its child `Boom` fails while
// Owner's params are open. Owner's params initialize, and settle, on
// the pool's worker, as Owner's first job there (inventory C50), so the
// worker runs the handler; Owner's own birth() follows on the
// instantiating thread (main). Until C50 closed, the params settled on
// main, which ran the handler.
// The fixture pins one delivery, at settle, before Owner's birth(), and
// its trace holds the delivery to the worker; the handler's own thread
// is `failure_delivery_domain`'s (`fd_pool_owner_worker.hl`).
//
// Expected terminal outcome: `outcome: delivered-at-settle`.

locus Boom {
    params { name: String = ""; }
    closure fuse { captures: name; epoch inline; }
    run() { violate fuse; }
}

locus Owner {
    params {
        c: Boom = Boom { name: "c" };
        tag: String = "stored";
        seen: String = "";
        fired: Int = 0;
        at_birth: Int = 0;
    }
    on_failure(c: Boom, err: ClosureViolation) {
        self.seen = self.tag;
        self.fired = self.fired + 1;
    }
    birth() { self.at_birth = self.fired; }
}

main locus App {
    params { o: Owner = Owner { }; }
    placement { o: cooperative(pool = side); }
    run() {
        std::time::sleep(50ms);
        if self.o.fired == 1 && self.o.at_birth == 1 && self.o.seen == "stored" {
            println("outcome: delivered-at-settle");
        } else {
            println("outcome: fired=" + to_string(self.o.fired) + " at_birth=" + to_string(self.o.at_birth));
        }
    }
}

fn main() { App { }; }
