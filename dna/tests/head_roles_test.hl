// dna/tests/head_roles_test.hl — the head serves its commands as a surface, and
// the record answers who holds which position (GH #1109, #1104 piece 5;
// GH #1417 R4).
//
// `dna/api` serves the surface `HeadCommands` over `unix::Rpc` with
// `dna::RecordRoles` as the role source. The fixture builds the head from a
// copy of the tree, gives it a record whose graph says ada holds the board
// and maps this process's uid to ada, and drives the socket: the served
// description lists exactly the members the record's seats open (the two
// ungated ones before a seat, the owner's and a position's after the board,
// the reviewer's after that seat, and fewer again once the board's edge is
// retired: read fresh, the record moved); a call through a row whose role the
// caller holds reaches the handler, one through a row it does not is refused
// `unauthorized`, naming what the row requires. The description is the
// rows' (`hale check --api` prints the same members).
//
// The fixture is a client of the surface through the generated one
// (`dna/core/legs/head_commands`, `hale api client --lang hale`): every call
// is a typed fn returning the five outcomes, and the description is the one
// the client reads from the socket (`hc::api_describe`).

import "../core" as dna;
import "../core/legs/head_commands" as hc;
import "../operations" as ops;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn source() -> String {
    let given = if std::env::var_exists("HALE_DNA_SOURCE") { std::env::var("HALE_DNA_SOURCE") } else { "." };
    return dna::trim_nl(dna::run_tool("sh\n-c\ncd \"$1\" && pwd\nsh\n" + given).stdout);
}

locus Proc {
    params {
        child: std::process::Child = std::process::Child { };
        out: String = "";
    }

    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }

    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

// The socket, once something listens on it.
fn wait_socket(sock: String) -> Bool {
    let fd = std::io::unix::connect_wait(sock, 20s) or - 1;
    if fd < 0 {
        return false;
    }
    std::io::tcp::__close_fd(fd);
    return true;
}

fn has(s: String, needle: String) -> Bool {
    return std::str::contains(s, needle);
}

// The member names a surface's served description lists, space-separated.
@unbounded
fn members_of(description: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(std::json::find_field_raw(description, "members"));
    while !it.done {
        let name = std::json::find_string_field(it.element, "name");
        out = out + (if len(out) > 0 { " " } else { "" }) + name;
        it = std::json::array_next(it);
    }
    return out;
}

// What a call answered, as text: `result:<code>` (the handler's own reply),
// `refusal:<kind>:<reason>:<roles>`, the server error, or lost.
fn refused(f: hc::ApiRefusal) -> String {
    return "refusal:" + f.kind + ":" + f.reason + ":" + f.requires;
}

fn lookup_text(o: hc::CommandsLookupOutcome) -> String {
    return match o {
        hc::CommandsLookupOutcome::Result(r) -> "result:" + r.code,
        hc::CommandsLookupOutcome::Refusal(f) -> refused(f),
        hc::CommandsLookupOutcome::ServerError -> "server_error",
        hc::CommandsLookupOutcome::Lost(why) -> "lost:" + why,
    };
}

fn friction_text(o: hc::CommandsFileFrictionOutcome) -> String {
    return match o {
        hc::CommandsFileFrictionOutcome::Result(r) -> "result:" + r.code,
        hc::CommandsFileFrictionOutcome::Refusal(f) -> refused(f),
        hc::CommandsFileFrictionOutcome::ServerError -> "server_error",
        hc::CommandsFileFrictionOutcome::Lost(why) -> "lost:" + why,
    };
}

fn create_task_text(o: hc::CommandsCreateTaskOutcome) -> String {
    return match o {
        hc::CommandsCreateTaskOutcome::Result(r) -> "result:" + r.code,
        hc::CommandsCreateTaskOutcome::Refusal(f) -> refused(f),
        hc::CommandsCreateTaskOutcome::ServerError -> "server_error",
        hc::CommandsCreateTaskOutcome::Lost(why) -> "lost:" + why,
    };
}

fn verdict_text(o: hc::CommandsVerdictOutcome) -> String {
    return match o {
        hc::CommandsVerdictOutcome::Result(r) -> "result:" + r.code,
        hc::CommandsVerdictOutcome::Refusal(f) -> refused(f),
        hc::CommandsVerdictOutcome::ServerError -> "server_error",
        hc::CommandsVerdictOutcome::Lost(why) -> "lost:" + why,
    };
}

fn retire_person_text(o: hc::CommandsRetirePersonOutcome) -> String {
    return match o {
        hc::CommandsRetirePersonOutcome::Result(r) -> "result:" + r.code,
        hc::CommandsRetirePersonOutcome::Refusal(f) -> refused(f),
        hc::CommandsRetirePersonOutcome::ServerError -> "server_error",
        hc::CommandsRetirePersonOutcome::Lost(why) -> "lost:" + why,
    };
}

// A friction entry on the surface: the attempt it is about is the caller's to
// name (the standalone head files nothing, whatever it names).
fn friction(sock: String) -> String {
    return friction_text(hc::commands_file_friction(sock, "", hc::Friction { request_id: "f-1", record_head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", position: "position:agent", attempt_id: "attempt-1", text: "the hat named no tool grant for a judgment" }));
}

locus App {
    params { repo: String = ""; }
    fn append(j: dna::GitJournal, kind: String, entity: String, body: String) {
        std::test::assert(j.append(j.revision(), kind, entity, body).ok, "the record takes " + kind + " " + entity);
    }
    fn holds(j: dna::GitJournal, position: String, holder: String) -> String {
        let e = ops::GraphEdge { kind: "holds" };
        e.member("position", ops::graph_node_id("position", position));
        e.member("holder", holder);
        self.append(j, "graph.edge", e.id(), e.body());
        return e.id();
    }
    // The slice once it lists `name` — the record moved, and the source
    // re-reads it within its one-second bound.
    fn slice_with(sock: String, name: String) -> String {
        let mut d = hc::api_describe(sock, "");
        let mut tries = 0;
        while tries < 40 && !has(d, "\"name\":\"" + name + "\"") {
            std::time::sleep(100ms);
            std::time::sleep(100ms);
            d = hc::api_describe(sock, "");
            tries = tries + 1;
        }
        return d;
    }
    run() {
        let hale = toolchain();
        let me = std::str::trim(dna::run_tool("id\n-u").stdout);
        let scratch = dna::scratch_root("head-roles");
        // whatever this fixture starts under its scratch stops when it does
        // — on a failed assertion too
        dna::reap_on_exit(scratch);

        // The head, built from a copy of the tree so the binary lands
        // nowhere near the source.
        let copied = dna::run_tool("sh\n-c\nmkdir -p \"$1\" && cp -r \"$2/dna\" \"$1/dna\" && rm -rf \"$1/dna/tests\"\nsh\n" + scratch + "\n" + source());
        std::test::assert_eq_int(copied.code, 0, "the tree is copied: " + copied.stderr);
        let built = dna::run_tool_timeout(600, hale + "\nbuild\n" + scratch + "/dna/api");
        std::test::assert_eq_int(built.code, 0, "the head builds with its surface: " + built.stderr);
        let emitted = dna::run_tool_timeout(300, hale + "\ncheck\n--api\n" + scratch + "/dna/api");
        std::test::assert_eq_int(emitted.code, 0, "the head describes itself: " + emitted.stderr);
        std::test::assert(has(emitted.stdout, "\"app\": \"Head\"") && has(emitted.stdout, "\"name\": \"HeadCommands\""), "the description names the head's surface: " + emitted.stdout);

        // A record: three positions and nobody seated; this uid is ada.
        self.repo = scratch + "/rec";
        let made = dna::run_tool("sh\n-c\nmkdir -p \"$1/dna\" && cd \"$1\" && git init -q -b main && git config user.name t && git config user.email t@dna && git config --add dna.unix.member \"uid:$2=ada\"\nsh\n" + self.repo + "\n" + me);
        std::test::assert_eq_int(made.code, 0, "a record of its own: " + made.stderr);
        let j = dna::GitJournal { repo: self.repo };
        self.append(j, "graph.node", ops::graph_node_id("position", "board"), ops::graph_node_body("position", "board", "", ""));
        self.append(j, "graph.node", ops::graph_node_id("position", "api/dev"), ops::graph_node_body("position", "api/dev", "", ""));
        self.append(j, "graph.node", ops::graph_node_id("position", "reviewer"), ops::graph_node_body("position", "reviewer", "", ""));

        let sock = scratch + "/head.sock";
        let port = dna::free_port(0);
        let head = Proc { };
        std::test::assert(head.start("env\nHALE_DNA_RPC_SOCKET=" + sock + "\nHALE_DNA_TRUSTED_LOCAL=1\nHALE_DNA_DISCOVER=off\n" + scratch + "/dna/api/api\n" + self.repo + "\n" + to_string(port)), "the head started");
        std::test::assert(wait_socket(sock), "the head's surface is listening");

        // Seated nowhere, a principal may raise work and look a command
        // up — the ungated rows — and nothing else. The call reaches the
        // handler: the standalone head composes no provider, and the
        // handler answers the provider's refusal.
        let none = hc::api_describe(sock, "");
        std::test::assert(has(none, "\"surface\":\"HeadCommands\""), "the head serves its description: " + none);
        std::test::assert_eq_str(members_of(none), "Commands::create_task Commands::lookup Commands::lookup_knowledge", "seated nowhere: the ungated rows only");
        // the served description is the surface `hale check --api` printed:
        // one digest
        let at = std::str::index_of(emitted.stdout, "\"digest\": \"");
        let after = if at < 0 { "" } else { emitted.stdout[(at + 11)..len(emitted.stdout)] };
        let checked_digest = if at < 0 { "" } else { after[0..std::str::index_of(after, "\"")] };
        std::test::assert(std::str::starts_with(checked_digest, "fnv1a64:"), "the check prints the surface's digest: " + emitted.stdout);
        std::test::assert_eq_str(std::json::find_string_field(none, "digest"), checked_digest, "and the head serves that digest");
        std::test::assert_eq_str(hc::SURFACE_DIGEST, checked_digest, "which is the digest the generated client names and sends");
        let looked = lookup_text(hc::commands_lookup(sock, "", hc::Lookup { request_id: "look-1" }));
        std::test::assert_eq_str(looked, "result:commands_unsupported", "lookup reaches the handler");
        let denied = friction(sock);
        std::test::assert(has(denied, "refusal:unauthorized:Commands::file_friction requires position") && has(denied, ":position"), "a friction entry needs a position: " + denied);

        // ada takes the board: owner, and thereby a position — every
        // row but the reviewer's, listed the moment the record says so.
        let ada_board = self.holds(j, "board", "ada");
        let seated = self.slice_with(sock, "Commands::reassign_task");
        std::test::assert_eq_str(members_of(seated), "Commands::ask_allowance Commands::bind_knowledge Commands::claim Commands::create_task Commands::file_friction Commands::link_knowledge Commands::lookup Commands::lookup_knowledge Commands::outcome Commands::propose Commands::propose_knowledge Commands::propose_organization Commands::reassign_task Commands::release_attempt Commands::renew Commands::retire_knowledge Commands::retire_person Commands::revise_knowledge Commands::unbind_knowledge Commands::unlink_knowledge", "the board's slice: the owner's and a position's rows, not the reviewer's");
        // The exposure follows the record: once ada holds a seat the role
        // source says so (it reads the record within its one-second bound)
        // and the friction entry reaches the handler.
        let mut filed = friction(sock);
        let mut tries = 0;
        while tries < 40 && has(filed, "refusal:unauthorized") {
            std::time::sleep(100ms);
            std::time::sleep(100ms);
            filed = friction(sock);
            tries = tries + 1;
        }
        std::test::assert_eq_str(filed, "result:commands_unsupported", "the position's friction entry reaches the handler");
        let raised = create_task_text(hc::commands_create_task(sock, "", hc::TaskCreation { request_id: "ask-1", record_head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", outcome: "ship it", to: "org", kind: "" }));
        std::test::assert_eq_str(raised, "result:commands_unsupported", "the handler ran and the provider answered");
        let not_reviewer = verdict_text(hc::commands_verdict(sock, "", hc::ReviewDecision { request_id: "v-1", review_id: "r1", subject_digest: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", verdict: "approve", comment: "" }));
        std::test::assert(has(not_reviewer, "refusal:unauthorized") && has(not_reviewer, ":reviewer"), "a verdict needs the reviewer position: " + not_reviewer);

        // ada is seated as reviewer too: the verdict joins the slice.
        self.holds(j, "reviewer", "ada");
        let reviewing = self.slice_with(sock, "Commands::verdict");
        std::test::assert_eq_str(members_of(reviewing), "Commands::ask_allowance Commands::bind_knowledge Commands::claim Commands::create_task Commands::file_friction Commands::link_knowledge Commands::lookup Commands::lookup_knowledge Commands::outcome Commands::propose Commands::propose_knowledge Commands::propose_organization Commands::reassign_task Commands::release_attempt Commands::renew Commands::retire_knowledge Commands::retire_person Commands::revise_knowledge Commands::unbind_knowledge Commands::unlink_knowledge Commands::verdict", "every row");

        // The record moves: the board's edge is taken out, and the source
        // reads it fresh — it asks the git record whether it moved at
        // most once a second, so the answer changes within that bound.
        self.append(j, "graph.retired", ada_board, "{}");
        let mut gone = hc::api_describe(sock, "");
        tries = 0;
        while tries < 40 && has(gone, "\"name\":\"Commands::retire_person\"") {
            std::time::sleep(100ms);
            std::time::sleep(100ms);
            gone = hc::api_describe(sock, "");
            tries = tries + 1;
        }
        std::test::assert_eq_str(members_of(gone), "Commands::ask_allowance Commands::bind_knowledge Commands::claim Commands::create_task Commands::file_friction Commands::link_knowledge Commands::lookup Commands::lookup_knowledge Commands::outcome Commands::propose Commands::propose_knowledge Commands::release_attempt Commands::renew Commands::retire_knowledge Commands::revise_knowledge Commands::unbind_knowledge Commands::unlink_knowledge Commands::verdict", "the reviewer's seat still holds a position: the owner's three rows are gone, the rest stay");
        let not_owner = retire_person_text(hc::commands_retire_person(sock, "", hc::PersonRetirement { request_id: "p-1", person: "grace", subject_digest: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", to: "" }));
        std::test::assert(has(not_owner, "refusal:unauthorized") && has(not_owner, ":owner"), "retiring a person is the board's: " + not_owner);

        head.stop();
        std::io::fs::unlink(sock) or discard;
        dna::scratch_done(scratch);
    }
}

fn main() {
    App { };
}
