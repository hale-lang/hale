// dna/tests/attempt_commands_test.hl — the spine's commands to a leg
// (GH #946, slice 3, hardened): claim, outcome, relay, settled.
//
// A judgment leaf's attempt is admitted by the engine and asked of the
// `agent` performer, which is a leg relay: it answers pending, and the
// attempt stays outstanding. A leg claims it at the head: memory's claim
// on the attempt id is the race (no head fence on the request), an
// `attempt.claimed` row names the lease and the principal that took it,
// and the lease comes back as a value; a second leg racing the same
// attempt at an older reading of the record gets a refusal receipt, a leg
// that names no data class is handed nothing, and a refusal writes no
// row. The leg hands its outcome back with the hat it wore: a wrong
// token is stale, another principal under the lease is refused, a second
// outcome under the lease is a duplicate. The host's own relay carries
// the requested row onto the bus; the owner settles the attempt from it
// — `attempt.outcome` naming the request, so the relay stops — or refuses
// it as a row when the lease moved under it. An owner restart with a leg
// attempt in flight leaves it to its claim, and asks again when the
// claim expires. With memory (HALE_DNA_MEMORY_DSN_OWNER) the same runs
// with the store deciding the race, the hat kept by its digest, and the
// whole of it again on an organism that adopted the ledger.

import "../core" as dna;
import "../host" as host;
import "../operations" as ops;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, model discovery off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

const CALLS: String = "[{\"adapter\": \"fake\", \"backend\": \"deep\", \"requested_model\": \"deep-1\", \"prompt_digest\": \"sha256:1111\", \"input_tokens\": 1200, \"output_tokens\": 340, \"cost_micros\": 55, \"data_class\": \"internal\"}]";

// The task an attempt id is under: `t1` of `t1/wf1/s0/j/a0`.
fn task_of(attempt: String) -> String {
    let at = std::str::index_of(attempt, "/wf");
    return if at < 0 { attempt } else { attempt[0..at] };
}

// A relay as a node runs it, once, over the record and the memory named.
fn relay_once(app: String, relayed: String) -> host::NodeRelay {
    let relay = host::NodeRelay { root: app, verb: "test", live: true, relayed: relayed };
    let n = relay.relay(dna::Memory { repo: app, dsn_env: dna::own_dsn_env() });
    return relay;
}

// The merged index of an attempt's requested row in a projection, -1 when none.
@unbounded
fn requested_at(p: host::Projection, attempt: String) -> Int {
    let mut k = 0; let mut at = -1;
    while k < p.j.revision() { let e = p.j.read(k); if e.kind == "attempt.outcome_requested" && e.entity == attempt { at = k; } k = k + 1; }
    return at;
}

locus App {
    params {
        app: String = "";
        with_memory: Bool = false;
        // a placeholder until the scratch project exists
        core: dna::Dna = dna::Dna { verification: dna::HaleVerification { receipts: dna::FileReceipts { dir: "/tmp/dna-attempt-placeholder" } } };
        journal: dna::RoutedJournal = dna::RoutedJournal { };
        asks: Int = 0;
    }
    // The organism, built (or built again: a restart) over the record —
    // with the ledger, once adopted.
    fn start() {
        self.journal = dna::RoutedJournal { record: dna::GitJournal { repo: self.app }, ledger: dna::MemoryLedger { repo: self.app, dsn_env: dna::SPINE_DSN_ENV } };
        self.core = dna::Dna {
            journal: self.journal,
            work: dna::WorkSystem { agent: dna::LegRelay { name: "legs" }, agent_reconciler: dna::RelayReplay { } },
            verification: dna::HaleVerification { hale_bin: toolchain(), receipts: dna::GitReceipts { repo: self.app }, scratch: self.app + "/.hale/dna/scratch", repo: self.app },
            // the owner's memory handles, scoped to this record (the host scopes them so)
            claims: dna::MemoryLeases { repo: self.app }, knowledge_client: dna::MemoryKnowledge { repo: self.app },
            org_id: "legs"
        };
        std::test::assert_eq_str(self.core.catalog.define("judge", 1, 1, "one judgment"), "", "judge");
        std::test::assert_eq_str(self.core.catalog.leaf("judge", 1, 0, "j", dna::WorkRequest { objective: "assess the storage migration", requires: "judgment", output_contract: "Assessment" }, 2), "", "j");
    }
    @unbounded
    fn has_row(kind: String, entity: String) -> Bool { return self.count_rows(kind, entity) > 0; }
    @unbounded
    fn row_body(kind: String, entity: String) -> String {
        let moved = self.journal.refresh();
        let mut out = "";
        let mut i = 0;
        while i < self.journal.revision() {
            let e = self.journal.read(i);
            if e.kind == kind && e.entity == entity { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn count_rows(kind: String, entity: String) -> Int {
        let moved = self.journal.refresh();
        let mut n = 0;
        let mut i = 0;
        while i < self.journal.revision() {
            let e = self.journal.read(i);
            if e.kind == kind && e.entity == entity { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn wait_row(kind: String, entity: String, what: String) {
        let mut tries = 0;
        while tries < 400 * dna::wait_scale() && !self.has_row(kind, entity) { std::time::sleep(25ms); tries = tries + 1; }
        std::test::assert(self.has_row(kind, entity), what + ": no `" + kind + " " + entity + "` row within the deadline");
    }
    // One judge workflow admitted and asked of the leg relay: its attempt id.
    fn ask() -> String {
        self.asks = self.asks + 1;
        let t = self.core.run_workflow(dna::WorkflowAsk { id: "i" + to_string(self.asks), definition: "judge", revision: 1, from: "test" });
        std::test::assert(len(t) > 0, "admitted");
        let attempt = dna::attempt_id_of(t + "/wf1/s0/j", 0);
        self.wait_row("attempt.admitted", attempt, "the engine admits the attempt");
        self.wait_row("effect.requested", "attempt:" + attempt, "and asks the leg relay for it");
        std::test::assert(!self.has_row("attempt.outcome", attempt), "the relay answered pending: nothing settled");
        return attempt;
    }
    fn claim_of(request: String, identity: String, head: String, kind: String, performer: String, classes: String) -> ops::GovernanceCommand {
        return ops::GovernanceCommand {
            request_id: request, operation: "dna.attempt.claim", operation_version: "1", application_id: identity, position_id: "org",
            target_kind: "dna.work", target_id: identity, subject_digest: head, record_head: head,
            performer_kind: kind, performer: performer, effect_class: "idempotent", capabilities: "judgment analysis", data_classes: classes, ttl: 600
        };
    }
    fn outcome_of(request: String, identity: String, attempt: String, holder: String, token: Int, hat: dna::Hat) -> ops::GovernanceCommand {
        return ops::GovernanceCommand {
            request_id: request, operation: "dna.attempt.outcome", operation_version: "1", application_id: identity, position_id: "org",
            target_kind: "dna.attempt", target_id: attempt, subject_digest: "lease:" + holder + "@" + to_string(token),
            attempt_id: attempt, holder: holder, token: token, effect_class: "idempotent", disposition: "done", result: "assessment: ship it", result_ref: "receipt:assessment-1", narrative: "one call on the deep tier",
            evidence: CALLS, receipts: "[{\"class\": \"internal\", \"body\": \"the prompt as sent\"}]",
            hat_digest: hat.digest, hat_head: hat.head, hat_watermark: hat.watermark, prompt_digest: dna::digest_of("the prompt as sent"), renderer: "legs-render/1"
        };
    }
    // The hat a leg reads at the head, over the journal the facts live in.
    fn hat_of(attempt: String) -> dna::Hat {
        let head_journal = dna::RoutedJournal { record: dna::GitJournal { repo: self.app }, ledger: dna::MemoryLedger { repo: self.app, dsn_env: dna::HEAD_DSN_ENV } };
        let reader = ops::HatReader { j: head_journal, knowledge: dna::MemoryKnowledge { repo: self.app, dsn_env: dna::HEAD_DSN_ENV }, ledger_ready: self.with_memory };
        let hat = reader.read(ops::usage_work_of(attempt));
        std::test::assert(hat.ok, "the hat reads: " + hat.code + " " + hat.why);
        std::test::assert_eq_str(hat.attempt_id, attempt, "for the attempt admitted last");
        if self.with_memory {
            std::test::assert_eq_str(hat.practices_status, "resolved", "with memory the practices resolve: " + hat.practices_status);
            std::test::assert(hat.watermark >= 0, "at memory's watermark");
            std::test::assert_eq_int(reader.kept, 1, "and the hat is kept in memory by its digest");
            let memory = dna::MemoryKnowledge { repo: self.app, dsn_env: dna::HEAD_DSN_ENV };
            std::test::assert_eq_str(memory.hat(hat.digest), dna::hat_body(hat), "the body memory keeps under the digest is the hat's");
        } else {
            std::test::assert_eq_str(hat.practices_status, "no memory", "without memory the hat says so");
        }
        std::test::assert(std::str::starts_with(hat.practices, "["), "practices are structure: " + hat.practices);
        return hat;
    }
    // ---- the whole of it, over the journal as it stands (routing 0, or adopted)
    @unbounded
    fn exercise(label: String) {
        let record = dna::GitRecord { repo: self.app };
        let identity = record.identity();
        let commands = ops::GovernanceCommands { record: dna::GitRecord { repo: self.app } };
        let alice = ops::GovernanceContext { application_id: identity, principal_mode: "local", principal_name: "alice" };
        let bob = ops::GovernanceContext { application_id: identity, principal_mode: "local", principal_name: "bob" };
        let l = label + ": ";
        // the legs of this pass, named for it: an attempt a leg of the last
        // pass still holds is another leg's, and is not raced for
        // legs are positions (the graph's ids, or the organization's own), one
        // worker each per pass, so a lease a leg of the last pass still holds
        // is another leg's and is not raced for
        let pass = if label == "record" { "1" } else { "2" };
        let alice_leg = "position:agent#" + pass; let bob_leg = "position:editor#" + pass; let carol_leg = "position:leader#" + pass;
        // ---- t1: claim, outcome, relay, settled
        let a1 = self.ask();
        let head0 = record.head("journal").id;
        // a leg that names no data class is handed nothing (D4): the refusal says why
        let r0 = commands.submit(alice, self.claim_of(label + "c0", identity, head0, "agent", alice_leg, ""));
        std::test::assert(r0.ok && r0.receipt.state == "refused", l + "no class named is no class: " + r0.code + " " + r0.receipt.state);
        std::test::assert(std::str::contains(r0.receipt.reason, "data class the leg may not see"), l + "and the refusal names it: " + r0.receipt.reason);
        // a performer of a class the Work does not admit: a judgment is answered,
        // never acted on, so an uncertain performer is refused, and the refusal says so
        let mut cu = self.claim_of(label + "cu", identity, head0, "agent", alice_leg, "internal public"); cu.effect_class = "uncertain";
        let ru = commands.submit(alice, cu);
        std::test::assert(ru.ok && ru.receipt.state == "refused" && std::str::contains(ru.receipt.reason, "effect class `uncertain`"), l + "a judgment admits no uncertain performer: " + ru.code + " " + ru.receipt.state + " " + ru.receipt.reason);
        // and a claim naming no class at all is not a claim
        let mut cn = self.claim_of(label + "cn", identity, head0, "agent", alice_leg, "internal public"); cn.effect_class = "";
        let rn = commands.submit(alice, cn);
        std::test::assert(!rn.ok && rn.code == "invalid_command", l + "no class is no claim: " + rn.code + " " + rn.receipt.state);
        let r1 = commands.submit(alice, self.claim_of(label + "c1", identity, head0, "agent", alice_leg, "internal public"));
        std::test::assert(r1.ok, l + "the claim is admitted: " + r1.code + " " + r1.receipt.reason);
        std::test::assert_eq_str(r1.receipt.attempt.state, "claimed", l + "the lease comes back as a value: " + r1.receipt.reason);
        std::test::assert_eq_str(r1.receipt.attempt.attempt_id, a1, l + "on the attempt that awaited a leg");
        std::test::assert_eq_str(r1.receipt.attempt.holder, alice_leg, l + "held by the leg");
        std::test::assert(r1.receipt.attempt.until > std::time::now(), l + "until later than now");
        let token = r1.receipt.attempt.token;
        let claimed = self.row_body("attempt.claimed", a1);
        std::test::assert(len(claimed) > 0, l + "the claim is a row");
        std::test::assert_eq_str(std::json::find_string_field(claimed, "principal_name"), "alice", l + "naming the principal that took it");
        std::test::assert_eq_int(std::json::find_int_field(claimed, "token"), token, l + "and the token");
        let again = commands.lookup(alice, label + "c1");
        std::test::assert(again.ok && again.receipt.attempt.state == "claimed" && again.receipt.attempt.token == token, l + "a lookup reads the same lease");
        // a second leg racing the same attempt at the OLD head (B4): not
        // stale_subject — a refusal receipt, and no row
        let rows_before = self.count_rows("attempt.claimed", a1);
        let r2 = commands.submit(bob, self.claim_of(label + "c2", identity, head0, "agent", bob_leg, "internal"));
        std::test::assert(r2.ok && r2.receipt.state == "refused", l + "a second leg is refused, not turned away: " + r2.code + " " + r2.receipt.state);
        std::test::assert(std::str::contains(r2.receipt.reason, "held by another leg"), l + "with the reason: " + r2.receipt.reason);
        std::test::assert_eq_int(self.count_rows("attempt.claimed", a1), rows_before, l + "and writes no row");
        let r3 = commands.submit(alice, self.claim_of(label + "c3", identity, head0, "human", "position:human#" + pass, "internal"));
        std::test::assert(r3.ok && r3.receipt.state == "refused" && std::str::contains(r3.receipt.reason, "none of that kind is outstanding"), l + "nothing awaits a human leg: " + r3.receipt.reason);
        // the hat the leg wears, and the outcome under the lease
        let hat = self.hat_of(a1);
        let r4 = commands.submit(alice, self.outcome_of(label + "o0", identity, a1, alice_leg, token + 1, hat));
        std::test::assert(r4.ok && r4.receipt.state == "refused" && std::str::contains(r4.receipt.reason, "stale"), l + "a wrong token is stale: " + r4.receipt.reason);
        // another principal under the lease (B6)
        let r4b = commands.submit(bob, self.outcome_of(label + "o0b", identity, a1, alice_leg, token, hat));
        std::test::assert(r4b.ok && r4b.receipt.state == "refused" && std::str::contains(r4b.receipt.reason, "taken by local alice"), l + "another principal under the lease is refused: " + r4b.receipt.reason);
        std::test::assert(!self.has_row("attempt.outcome_requested", a1), l + "and neither writes a row");
        let r5 = commands.submit(alice, self.outcome_of(label + "o1", identity, a1, alice_leg, token, hat));
        std::test::assert(r5.ok, l + "the outcome is admitted: " + r5.code + " " + r5.receipt.reason);
        std::test::assert_eq_str(r5.receipt.attempt.state, "requested", l + "requested until the owner settles it");
        let requested = self.row_body("attempt.outcome_requested", a1);
        std::test::assert_eq_str(std::json::find_string_field(requested, "hat_digest"), hat.digest, l + "the row carries the hat the leg wore");
        std::test::assert_eq_str(std::json::find_string_field(requested, "hat_head"), hat.head, l + "the head it was rendered at");
        std::test::assert_eq_int(std::json::find_int_field(requested, "hat_watermark"), hat.watermark, l + "the watermark");
        std::test::assert_eq_str(std::json::find_string_field(requested, "renderer"), "legs-render/1", l + "and the renderer's version");
        let evidence_ref = std::json::find_string_field(requested, "evidence_ref");
        std::test::assert(std::str::starts_with(evidence_ref, "sha256:"), l + "the receipt was filed: " + evidence_ref);
        // a second outcome under the lease is a duplicate (B3), at the head
        let r5b = commands.submit(alice, self.outcome_of(label + "o1b", identity, a1, alice_leg, token, hat));
        std::test::assert(r5b.ok && r5b.receipt.state == "refused" && std::str::contains(r5b.receipt.reason, "duplicate"), l + "a second outcome under the lease is a duplicate: " + r5b.receipt.reason);
        std::test::assert_eq_int(self.count_rows("attempt.outcome_requested", a1), 1, l + "one requested row");
        // ---- the relay: the host's own, over the record and memory, onto the bus
        let relay = relay_once(self.app, "\n");
        std::test::assert_eq_str(relay.error, "", l + "the relay published: " + relay.error);
        std::test::assert_eq_int(relay.relayed_count, 1, l + "one request relayed");
        self.wait_row("attempt.outcome", a1, l + "the owner settles the attempt from the relayed row");
        let outcome = self.row_body("attempt.outcome", a1);
        std::test::assert_eq_str(std::json::find_string_field(outcome, "disposition"), "done", l + "as the leg said");
        std::test::assert_eq_str(std::json::find_string_field(outcome, "performer"), "legs", l + "under the performer the kind selects");
        std::test::assert_eq_str(std::json::find_string_field(outcome, "result_ref"), "receipt:assessment-1", l + "the result reference travels (B5)");
        std::test::assert_eq_str(std::json::find_string_field(outcome, "hat_digest"), hat.digest, l + "and the hat's digest (D1)");
        std::test::assert_eq_str(std::json::find_string_field(outcome, "request"), std::json::find_string_field(requested, "request"), l + "the outcome names the request it answers (B1)");
        self.wait_row("work.settled", ops::usage_work_of(a1), l + "the Work settles on it");
        std::test::assert(self.has_row("model.called", a1), l + "the leg's call is the attempt's evidence");
        // relayed again past the interval: answered, so nothing is published (B1)
        let p = host::open_projection(self.app, ".", "", dna::Memory { repo: self.app, dsn_env: dna::own_dsn_env() });
        let at = requested_at(p, a1);
        std::test::assert(at >= 0, l + "the requested row is in the projection");
        let expired = host::relay_mark("\n", host::fact_key(p, at), std::time::now() - host::RELAY_AGAIN_AFTER - 1);
        let again_relay = relay_once(self.app, expired);
        std::test::assert_eq_int(again_relay.relayed_count, 0, l + "an answered request is not relayed again");
        let settled = commands.lookup(alice, label + "o1");
        std::test::assert(settled.ok && settled.receipt.attempt.state == "settled" && settled.receipt.attempt.disposition == "done", l + "a lookup reads the settlement: " + settled.receipt.attempt.state);
        let r6 = commands.submit(alice, self.outcome_of(label + "o2", identity, a1, alice_leg, token, hat));
        std::test::assert(r6.ok && r6.receipt.state == "refused" && std::str::contains(r6.receipt.reason, "duplicate"), l + "an outcome after settlement is a duplicate: " + r6.receipt.reason);
        // ---- t2: the lease moves under a requested outcome; the owner refuses it as a row, through the relay
        let a2 = self.ask();
        let head2 = record.head("journal").id;
        let c2 = commands.submit(alice, self.claim_of(label + "c4", identity, head2, "agent", alice_leg, "internal"));
        std::test::assert(c2.ok && c2.receipt.attempt.state == "claimed" && c2.receipt.attempt.attempt_id == a2, l + "t2 claimed");
        let hat2 = self.hat_of(a2);
        let o2 = commands.submit(alice, self.outcome_of(label + "o3", identity, a2, alice_leg, c2.receipt.attempt.token, hat2));
        std::test::assert(o2.ok && o2.receipt.attempt.state == "requested", l + "t2 outcome requested");
        // the record says another leg holds it now (a later lease): the owner's lease check refuses the relayed outcome
        let moved = self.journal.refresh();
        // with memory the later lease is memory's too: alice's given back, carol's taken (the token moves on)
        let mut carol_token = c2.receipt.attempt.token + 1;
        if self.with_memory {
            let leases = dna::MemoryLeases { repo: self.app, dsn_env: dna::SPINE_DSN_ENV };
            let gone = leases.release_claim("attempt:" + a2, alice_leg);
            let taken = leases.claim("attempt:" + a2, carol_leg, 600);
            std::test::assert(taken.present && taken.holder == carol_leg, l + "carol's lease in memory: " + leases.last_error);
            carol_token = taken.token;
        }
        let stray = "{\"holder\": \"" + carol_leg + "\", \"token\": " + to_string(carol_token) + ", \"until\": " + to_string(std::time::now() + 600) + ", \"principal_mode\": \"local\", \"principal_name\": \"carol\"}";
        let put = self.journal.append(self.journal.revision(), "attempt.claimed", a2, stray);
        std::test::assert(put.ok, l + "a later lease row: " + put.error);
        let relay2 = relay_once(self.app, "\n");
        std::test::assert_eq_int(relay2.relayed_count, 1, l + "the t2 request relayed");
        self.wait_row("attempt.outcome_refused", a2, l + "the owner refuses the stale outcome as a row");
        let refused = self.row_body("attempt.outcome_refused", a2);
        std::test::assert(std::str::contains(std::json::find_string_field(refused, "why"), "stale"), l + "naming why: " + std::json::find_string_field(refused, "why"));
        std::test::assert_eq_str(std::json::find_string_field(refused, "request"), std::json::find_string_field(self.row_body("attempt.outcome_requested", a2), "request"), l + "and the request it answers");
        std::test::assert(!self.has_row("attempt.outcome", a2), l + "nothing settled");
        let read2 = commands.lookup(alice, label + "o3");
        std::test::assert(read2.ok && read2.receipt.state == "refused" && read2.receipt.attempt.state == "refused", l + "the lookup reads the refusal: " + read2.receipt.state + " " + read2.receipt.reason);
        let p2 = host::open_projection(self.app, ".", "", dna::Memory { repo: self.app, dsn_env: dna::own_dsn_env() });
        let expired2 = host::relay_mark("\n", host::fact_key(p2, requested_at(p2, a2)), std::time::now() - host::RELAY_AGAIN_AFTER - 1);
        std::test::assert_eq_int(relay_once(self.app, expired2).relayed_count, 0, l + "a refused request is answered: not relayed again");
        // the lease's holder now hands an outcome back: a refused request under
        // the earlier lease is nobody's duplicate (B3), and the owner settles it
        let carol = ops::GovernanceContext { application_id: identity, principal_mode: "local", principal_name: "carol" };
        let o2c = commands.submit(carol, self.outcome_of(label + "o3c", identity, a2, carol_leg, carol_token, hat2));
        std::test::assert(o2c.ok && o2c.receipt.attempt.state == "requested", l + "the lease's holder hands an outcome back after a refusal: " + o2c.code + " " + o2c.receipt.state + " " + o2c.receipt.reason);
        std::test::assert_eq_int(relay_once(self.app, "\n").relayed_count, 1, l + "and it is relayed");
        self.wait_row("attempt.outcome", a2, l + "and settles the attempt");
        // ---- t3: an owner restart with a leg attempt in flight (D3)
        let a3 = self.ask();
        let head3 = record.head("journal").id;
        let mut short = self.claim_of(label + "c5", identity, head3, "agent", alice_leg, "internal");
        short.ttl = 2;
        let c3 = commands.submit(alice, short);
        std::test::assert(c3.ok && c3.receipt.attempt.state == "claimed" && c3.receipt.attempt.attempt_id == a3, l + "t3 claimed under a short lease");
        self.start();
        std::time::sleep(300ms);
        std::test::assert(!self.has_row("effect.result", "attempt:" + a3), l + "the restarted owner leaves the attempt to its claim: no unknown result");
        std::test::assert(!self.has_row("effect.redelivered", "attempt:" + a3), l + "and does not ask again while the lease is live");
        // the lease expires with no outcome: the owner asks again, and the attempt is a leg's to claim anew
        std::time::sleep(2500ms);
        let mut tries = 0;
        while tries < 40 * dna::wait_scale() && !self.has_row("effect.redelivered", "attempt:" + a3) { let n = self.core.redrive(); std::time::sleep(250ms); tries = tries + 1; }
        std::test::assert(self.has_row("effect.redelivered", "attempt:" + a3), l + "past the lease the attempt is asked of a leg again");
        std::test::assert(!self.has_row("effect.result", "attempt:" + a3), l + "never unknown");
        // an owner restart asks nothing more: once per lease
        self.start();
        std::time::sleep(300ms);
        let n0 = self.core.redrive();
        std::test::assert_eq_int(self.count_rows("effect.redelivered", "attempt:" + a3), 1, l + "one redelivery per lease, whatever restarts since");
        let head3b = record.head("journal").id;
        let c3b = commands.submit(bob, self.claim_of(label + "c6", identity, head3b, "agent", bob_leg, "internal"));
        std::test::assert(c3b.ok && c3b.receipt.attempt.state == "claimed" && c3b.receipt.attempt.attempt_id == a3, l + "another leg claims it once the lease expired: " + c3b.code + " " + c3b.receipt.state + " " + c3b.receipt.reason + " attempt=" + c3b.receipt.attempt.attempt_id);
        // ---- t4: an outcome handed back while the lease was live settles, however late the relay (B3)
        let a4 = self.ask();
        let head4 = record.head("journal").id;
        let mut brief4 = self.claim_of(label + "c7", identity, head4, "agent", alice_leg, "internal");
        brief4.ttl = 2;
        let c4 = commands.submit(alice, brief4);
        std::test::assert(c4.ok && c4.receipt.attempt.state == "claimed" && c4.receipt.attempt.attempt_id == a4, l + "t4 claimed under a short lease");
        let hat4 = self.hat_of(a4);
        let o4 = commands.submit(alice, self.outcome_of(label + "o4", identity, a4, alice_leg, c4.receipt.attempt.token, hat4));
        std::test::assert(o4.ok && o4.receipt.attempt.state == "requested", l + "t4 outcome requested while the lease was live");
        std::time::sleep(2500ms);
        std::test::assert_eq_int(relay_once(self.app, "\n").relayed_count, 1, l + "relayed after the lease ran out");
        self.wait_row("attempt.outcome", a4, l + "the owner judges the lease as of the head's admission and settles it");
        // tokens per task hold out of process
        let usage = ops::Usage { j: self.journal };
        let t = usage.under(task_of(a1));
        std::test::assert_eq_int(t.input_tokens, 1200, l + "tokens per task hold out of process");
        std::test::assert(std::str::contains(t.by_position, "position:agent 1 1200 340 55"), l + "under the position: " + t.by_position);
    }
    // ---- the ledger adopted (D5): the same, with the attempt kinds in memory
    @unbounded
    fn adopt() {
        let moved = self.journal.refresh();
        let b = std::json::Builder { };
        b.begin_object(); b.int_field("routing", dna::ROUTING_VERSION); b.string_field("by", "test"); b.end_object();
        let asked = self.journal.append(self.journal.revision(), "ledger.adopting", "ledger", b.result());
        std::test::assert(asked.ok, "adoption asked: " + asked.error);
        let adoption = dna::LedgerAdoption { root: self.app, ledger: dna::MemoryLedger { repo: self.app, dsn_env: dna::SPINE_DSN_ENV }, holder: "test" };
        let leases = dna::MemoryLeases { repo: self.app, dsn_env: dna::SPINE_DSN_ENV };
        std::test::assert_eq_int(adoption.tick(leases), 1, "the ledger adopted: " + adoption.last_error);
        std::test::assert(self.has_row("ledger.adopted", "ledger"), "and the record says so");
        // the organism runs on the record with the ledger from here
        self.start();
    }
    run() {
        self.app = std::env::var("HALE_DNA_ATTEMPT_APP");
        self.with_memory = std::env::var_exists("HALE_DNA_MEMORY_DSN_SPINE");
        self.start();
        self.exercise("record");
        if !self.with_memory {
            eprintln("attempt_commands_test: no HALE_DNA_MEMORY_DSN_OWNER; the store's race, the hat in memory and the adopted ledger were not exercised");
            return;
        }
        self.adopt();
        let git = dna::GitJournal { repo: self.app };
        let git_rows = git.revision();
        self.exercise("adopted");
        // the attempt kinds landed in the ledger, under the head's role for the leg's rows
        let ledger = dna::MemoryLedger { repo: self.app, dsn_env: dna::HEAD_DSN_ENV };
        let mut i = 0; let mut claimed = 0; let mut requested = 0; let mut outcomes = 0;
        while i < ledger.revision() {
            let e = ledger.read(i);
            if e.kind == "attempt.claimed" { claimed = claimed + 1; }
            if e.kind == "attempt.outcome_requested" { requested = requested + 1; }
            if e.kind == "attempt.outcome" { outcomes = outcomes + 1; }
            i = i + 1;
        }
        std::test::assert(claimed >= 4 && requested >= 2 && outcomes >= 1, "the leg's rows are in the ledger: " + to_string(claimed) + " claimed, " + to_string(requested) + " requested, " + to_string(outcomes) + " outcomes");
        let git_after = dna::GitJournal { repo: self.app };
        let mut j = git_rows; let mut in_git = 0;
        while j < git_after.revision() { let e = git_after.read(j); if std::str::starts_with(e.kind, "attempt.") { in_git = in_git + 1; } j = j + 1; }
        std::test::assert_eq_int(in_git, 0, "and none of them in the record");
    }
}

// Phase 1: the scratch project, memory migrated for its record when the
// suite hands one over, and phase 2 run with the roles named.
fn main() {
    if std::env::var("HALE_DNA_ATTEMPT_PHASE") == "2" { App { }; return; }
    let scratch = dna::scratch_root("attempts");
    let made = in_dir(scratch, toolchain() + "\ndna\nnew\napp");
    std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
    let app = scratch + "/app";
    let u1 = in_dir(app, "git\nconfig\nuser.name\nriley");
    let u2 = in_dir(app, "git\nconfig\nuser.email\nriley@local");
    let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
    let identity = dna::GitRecord { repo: app }.identity();
    let mut env = "HALE_DNA_ATTEMPT_PHASE=2\nHALE_DNA_ATTEMPT_APP=" + app + "\nGIT_CONFIG_NOSYSTEM=1\nGIT_CONFIG_GLOBAL=/dev/null\nHALE_DNA_DISCOVER=off\n";
    if len(owner) > 0 {
        let spine = dna::migrated(owner, identity);
        std::test::assert(spine.ok, "memory migrated for the record: " + spine.why);
        let head = dna::migrated_head(owner, identity);
        std::test::assert(head.ok, "the head's role: " + head.why);
        env = env + "HALE_DNA_MEMORY_DSN_SPINE=" + dna::dsn_text(spine) + "\nHALE_DNA_MEMORY_DSN_HEAD=" + dna::dsn_text(head) + "\n";
    }
    let ran = dna::run_tool("env\n" + env + std::env::arg_or(0, ""));
    print(ran.stdout);
    if len(ran.stderr) > 0 { eprintln(ran.stderr); }
    if len(owner) > 0 { std::test::assert_eq_str(dna::unmigrate(owner, identity), "", "this run's schema and roles dropped"); }
    dna::scratch_done(scratch);
    std::process::exit(if ran.code < 0 { 1 } else { ran.code });
}
