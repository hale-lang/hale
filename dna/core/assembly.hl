// dna/core/assembly.hl — the Dna locus a project constructs (#521
// comment 1: constructor-shaped assembly).
//
// "Configuration" is Hale source: a project writes `Dna { memory:
// ..., work: ..., governance: ..., board: ... }` in its main's
// params, supplying concrete children behind the core's interfaces.
// The assembly is visible to the ApplicationModel, claims can reason
// about its reachability and effects, and changing it is an ordinary
// reviewed genome diff. Nothing here is a config-file loader.
//
// Four things stay distinct: construction (which concrete stores,
// models, gateways exist), genome (evolvable policy loci), law
// (constitutions adopted by the main, never a constructor flag), and
// durable state (behind the constructed stores, never a literal).

// ---- the Board: where people see and decide -------------------------

interface Membrane {
    fn offer(i: Intent) -> String; // "accepted" | "refused: ..."
    fn notify(kind: String, msg: String);
    fn notifications() -> Int;
}

// The local human: intent enters through `hale dna task create`, review
// requests and status leave through the terminal / Iris. The person
// is outside the root; this locus owns the boundary.
locus LocalHumanMembrane {
    params { who: String = "operator"; offered: Int = 0; notified: Int = 0; last: String = ""; }
    fn offer(i: Intent) -> String {
        if i.outcome == "" { return "refused: empty intent"; }
        self.offered = self.offered + 1;
        return "accepted";
    }
    fn notify(kind: String, msg: String) {
        self.notified = self.notified + 1;
        self.last = kind + ": " + msg;
    }
    fn notifications() -> Int { return self.notified; }
}

// The Board (GH #566 F2): the human authority at the top of the org
// chart. Intent enters through it, escalations and reports leave
// through it; it owns every grant. It is the organism's human side
// under its organizational name.
locus Board {
    params { who: String = "board"; offered: Int = 0; notified: Int = 0; escalations: Int = 0; last: String = ""; }
    fn offer(i: Intent) -> String {
        if i.outcome == "" { return "refused: empty intent"; }
        self.offered = self.offered + 1;
        return "accepted";
    }
    fn notify(kind: String, msg: String) {
        self.notified = self.notified + 1;
        if kind == "review" && std::str::contains(msg, "board needed") { self.escalations = self.escalations + 1; }
        self.last = kind + ": " + msg;
    }
    fn notifications() -> Int { return self.notified; }
}

// ---- governance policy (evolvable genome, bounded by law) -----------

interface ReviewPolicy {
    fn required_authority(change_class: String, m: Magnitude) -> String;
    fn blocking(change_class: String) -> Bool;
    fn name() -> String;
}

// The safe baseline (#521 open question 15): every application,
// deployment, external-effect, process-policy and constitutional
// mutation blocks on a human.
locus HumanBeforeApply {
    fn required_authority(change_class: String, m: Magnitude) -> String { return "maintainer"; }
    fn blocking(change_class: String) -> Bool { return true; }
    fn name() -> String { return "human-before-apply"; }
}

// The organization's policy (GH #566 F2): a change that touches law,
// widens effects or crosses ownership, or is of a Board-class
// (`organization`, `constitutional`, `process-policy`, `topology`), is
// the Board's; everything else inside the grant is the Leader's.
locus OrgPolicy {
    fn required_authority(change_class: String, m: Magnitude) -> String {
        if m.law_touched || m.effects_widened || m.ownership_crossed { return "board"; }
        if change_class == "organization" || change_class == "constitutional" || change_class == "process-policy" || change_class == "topology" { return "board"; }
        return "leader";
    }
    fn blocking(change_class: String) -> Bool { return true; }
    fn name() -> String { return "org"; }
}

// Post-review for reversible internal refactors; everything else blocks.
locus PostReviewRefactors {
    fn required_authority(change_class: String, m: Magnitude) -> String {
        if m.law_touched || m.effects_widened { return "maintainer"; }
        return "reviewer";
    }
    fn blocking(change_class: String) -> Bool { return change_class != "refactor"; }
    fn name() -> String { return "post-review-refactors"; }
}

// ---- deployment gateway (an EFFECT, behind an attributed gate) -----

interface Deployment {
    fn apply(candidate_digest: String) -> Bool; // express the candidate; true when it is up and judged healthy
    fn rollback(base: String) -> Bool; // express the base again after a bad window or a rejection
    fn kind() -> String;
    fn applied() -> Int;
}

// A deployment gateway that shells out (GH #566 F4): the command owns
// expressing and judging. `<command> express <candidate> <seed>` must
// return 0 once the candidate is up and healthy (it owns the window);
// `<command> rollback <base> <seed>` restores the base. Everything it
// does is outside this process — a pipeline, an orchestrator, ssh —
// and its exit code is the fact the record keeps.
locus ShellDeployment {
    params {
        command: String = "";
        seed: String = ".";
        applied_n: Int = 0;
        rolled_back: Int = 0;
        last_code: Int = 0;
        last_output: String = "";
    }
    @effects(is: { genome_apply })
    fn apply(candidate_digest: String) -> Bool {
        let r = run_tool(self.command + "\nexpress\n" + candidate_digest + "\n" + self.seed);
        self.last_code = r.code;
        self.last_output = trim_nl(r.stdout + r.stderr);
        if r.code != 0 { return false; }
        self.applied_n = self.applied_n + 1;
        return true;
    }
    @effects(is: { genome_apply })
    fn rollback(base: String) -> Bool {
        let r = run_tool(self.command + "\nrollback\n" + base + "\n" + self.seed);
        self.last_code = r.code;
        self.last_output = trim_nl(r.stdout + r.stderr);
        if r.code != 0 { return false; }
        self.rolled_back = self.rolled_back + 1;
        return true;
    }
    fn kind() -> String { return "shell"; }
    fn applied() -> Int { return self.applied_n; }
}

// A deployment that DOES apply (simulated): the one method carries
// `genome_apply`, which the law gates behind the Dna assembly.
locus LocalApplyDeployment {
    params { applied_n: Int = 0; last: String = ""; }
    @effects(is: { genome_apply })
    fn apply(candidate_digest: String) -> Bool { self.applied_n = self.applied_n + 1; self.last = candidate_digest; return true; }
    fn rollback(base: String) -> Bool { self.last = base; return true; }
    fn kind() -> String { return "local-apply"; }
    fn applied() -> Int { return self.applied_n; }
}

// Phase 1: every mutation stops at stage. This gateway refuses.
locus NoDeployment {
    params { refused: Int = 0; }
    fn apply(candidate_digest: String) -> Bool { self.refused = self.refused + 1; return false; }
    fn rollback(base: String) -> Bool { return false; }
    fn kind() -> String { return "none"; }
    fn applied() -> Int { return 0; }
}

// ---- Dna --------------------------------------------------------------

fn short_sha(sha: String) -> String {
    if len(sha) < 12 { return sha; }
    return sha[0..12];
}

// Whether a Mutation's result says the record refused its request row
// (card 14): not an outcome — nothing ran.
fn record_refused(out: String) -> Bool { return std::str::contains(out, ": refused: the record would not take the Mutation's request"); }

// Intents whose ask awaits the leader's word before its admission
// (card 18; GH #596 L): one row per ask in flight, released when its
// plan arrives.
@form(vec)
locus PendingAsks { capacity { heap rows of Intent; } }

// A step's outcome as its performer decides it: "done" or "failed" with
// what it wrote, or no disposition — it waits, and is performed again.
type StepVerdict { disposition: String = ""; result: String = ""; narrative: String = ""; }

// What a leg's reported calls spent (GH #1131): the calls made — a wait
// row (`adapter: legs`) is none — and what they cost together.
type LegSpend { calls: Int = 0; cost_micros: Int = 0; }
@unbounded
fn spend_of(calls: String) -> LegSpend {
    let mut out = LegSpend { };
    if len(calls) == 0 || !std::json::valid(calls) { return out; }
    let mut it = std::json::array_first(calls);
    let mut n = 0;
    while !it.done && n < 256 {
        if std::json::find_string_field(it.element, "adapter") != "legs" { out.calls = out.calls + 1; }
        let c = std::json::find_int_field(it.element, "cost_micros");
        out.cost_micros = out.cost_micros + (if c > 0 { c } else { 0 });
        n = n + 1;
        it = std::json::array_next(it);
    }
    return out;
}

fn step_done(result: String, narrative: String) -> StepVerdict { return StepVerdict { disposition: "done", result: result, narrative: narrative }; }
fn step_failed(why: String) -> StepVerdict { return StepVerdict { disposition: "failed", narrative: why }; }
fn step_waits() -> StepVerdict { return StepVerdict { }; }

// The outcome and who decided a `review.settled` body ("approve by ada").
fn verdict_outcome(body: String) -> String {
    if std::str::starts_with(body, "approve by ") { return "approve"; }
    if std::str::starts_with(body, "reject by ") { return "reject"; }
    if std::str::starts_with(body, "revise by ") { return "revise"; }
    return "";
}
fn verdict_by(body: String) -> String {
    let o = verdict_outcome(body);
    if len(o) == 0 { return ""; }
    return body[(len(o) + 4)..len(body)];
}

// The case a human Work's attempt is handed as (card 16): its own Task,
// `<task>.s<i>.<key>` — the Work's step index and member key under its
// Task, the child-Task form of §4 — stable across redeliveries, and
// naming the exact parent Work by construction.
// The part of an id after its last `/`, the whole id when it has none.
@unbounded
fn last_segment(id: String) -> String {
    let mut start = 0;
    let mut i = 0;
    while i < len(id) {
        if id[i..(i + 1)] == "/" { start = i + 1; }
        i = i + 1;
    }
    return id[start..len(id)];
}
fn case_id_of(req: WorkRequest) -> String {
    if len(req.step_id) == 0 || len(req.work_id) <= len(req.step_id) + 1 { return ""; }
    let step = last_segment(req.step_id);
    let key = req.work_id[(len(req.step_id) + 1)..len(req.work_id)];
    if len(step) == 0 || len(key) == 0 || std::str::contains(key, "/") { return ""; }
    return req.task_id + "." + step + "." + key;
}

// The Work whose candidate an `Applied` Work waits on (card 15): named
// in the request's `target`, as `<step>/<key>` within the same workflow
// (`s0/e`) or as a whole Work id. "" when none is named: the dependency
// is explicit, never a Task-wide guess.
fn producer_of(req: WorkRequest) -> String {
    if len(req.target) == 0 { return ""; }
    if std::str::contains(req.target, "/wf") { return req.target; }
    let wf = std::str::index_of(req.work_id, "/wf");
    if wf < 0 { return ""; }
    let rest = req.work_id[(wf + 1)..len(req.work_id)];
    let sl = std::str::index_of(rest, "/");
    if sl < 0 { return ""; }
    return req.work_id[0..(wf + 1 + sl)] + "/" + req.target;
}

// What a hand-off binds (card 16).
type Handoff { assignee: String = ""; retired_assignee: String = ""; practice: String = ""; evidence_required: Bool = false; theirs: String = ""; }

// The two output contracts an edit Work declares (card 15). `Patch` —
// the default for an edit leaf — is "a candidate prepared for review":
// the Work is done when its candidate is in review or released, and a
// later verdict cannot reverse that. `Applied` (or `Approved`) is "the
// candidate approved and applied": the Work waits for the review of
// the candidate a Work of its Task prepared, and is done when it was
// applied, failed when it was rejected or sent back. The engine never
// reinterprets one as the other.
fn review_waiting(output: String) -> Bool { return output == "Applied" || output == "Approved"; }

locus Dna {
    params {
        journal: Journal = MemJournal { };
        review_journal: ReviewJournal = ReviewJournal { };
        leases: Coordination = MemLeases { };
        knowledge: Knowledge = Knowledge { };
        work: WorkSystem = WorkSystem { };
        // card 18: the one engine. The assembly owns the committer and
        // the execution owner of its scope (the organism's id), over its
        // own record and performers, born with it; `runs_engine: false`
        // for a program that assembles them itself in the same scope
        runs_engine: Bool = true;
        runtime: WorkflowRuntime = WorkflowRuntime { };
        executions: Executions = Executions { };
        minted: Int = 0; // durable Task ids continue from the record
        executions_asked: Int = 0; // roots started or resumed through `ExecutionAsked`
        executions_settled: Int = 0; // roots whose workflow settled, heard
        boundary: AutonomyBoundary = AutonomyBoundary { child: "app" };
        // GH #596, layering: the grant above the child's — the
        // organism's, the Board's to widen. A child's grant is read
        // through it at every assessment, and a contraction of it
        // binds the child from that moment (`grant.contracted`). No
        // child on it means no ceiling.
        ceiling: AutonomyBoundary = AutonomyBoundary { };
        // a ceiling's contraction whose row the record refused: tried again
        // before anything is admitted, and nothing is until it lands (the
        // third review of #626)
        unrecorded_contraction: String = "";
        review_policy: ReviewPolicy = HumanBeforeApply { };
        deployment: Deployment = NoDeployment { };
        board: Membrane = LocalHumanMembrane { }; // the Board: where people see and decide
        // Phase 2 (GH #529): where a mutation edits, how it is verified,
        // and who edits. The gateway and the verification journal
        // through THIS assembly's Journal (handed to them per call).
        gateway: MutationGateway = MutationGateway { };
        verification: HaleVerification = HaleVerification { };
        editor: SourceEditor = SourceEditor { };
        // GH #583 M1: the organization's spend has ONE owner. The catalog
        // declares the policy; every model.called row is accounted here;
        // rehydrated from the record at birth.
        budget: Budget = Budget { };
        // GH #583 K2: the owner's line to the knowledge service; the
        // package it answers becomes the hat the attempt carries by digest
        // and the brief the editor gets (GH #946)
        knowledge_client: MemoryKnowledge = MemoryKnowledge { };
        // GH #664: who admits which position. One owner unless the graph
        // says organizations hold positions (GH #1123); then only this
        // organization's.
        ownership: Ownership = Ownership { };
        // GH #606: where a protected body goes — the knowledge service, and
        // nowhere else
        evidence: EvidenceStore = EvidenceStore { }; // C3 family 1: filing, retention and redaction of evidence
        // GH #646 workflow card 07: the definitions this organization
        // admits — the project's `dna/org/workflows.hl`, the baseline
        // catalog plus its own (GH #995); a body given none takes the
        // baseline at birth — and the limits an admission is expanded under
        // (§3 of dna/WORKFLOW-CONTRACT.md: the assembly's, not a ceiling)
        catalog: WorkflowCatalog = WorkflowCatalog { };
        admission_limits: AdmissionLimits = AdmissionLimits { };
        genome_seed: String = "."; // the genome's seed, relative to the repository
        // GH #596 L: when true, an ask is planned by the leader before
        // it becomes a Mutation (the generated org chart says so); when
        // false, routed edit Work is a Mutation of class `application`,
        // as before — fixtures with no leader keep that.
        planned: Bool = false;
        // GH #1026: claims by id. Any number of nodes may run this
        // organism over one record; an ask is claimed in memory before it
        // is planned and the optimize pass before it runs, so of the
        // nodes offered one, one spends on it. `node` names this one in
        // its claims ("" = HALE_DNA_NODE, which the host sets, else this
        // machine and process); `claim_ttl` is how long a claim to plan
        // stands before another node may take it.
        claims: MemoryLeases = MemoryLeases { };
        node: String = "";
        claim_ttl: Int = 300;
        // GH #946 slice 3: what came back from legs through the head
        submissions_settled: Int = 0;
        claimed: Lease = Lease { }; // the claim this node took last
        pending_asks: PendingAsks = PendingAsks { }; // card 18: intents awaiting the leader's word before their admission
        memory_ready: Bool = false; // GH #995: memory's projection had caught up with the record's knowledge when last asked
        optimize_asked: String = "\n"; // GH #995: the optimize-walk Tasks whose walk this incarnation asked of the leader
        mutation_refusals: Int = 0; // the Mutations' writes the record refused: nothing proceeded past them; status sums them with every family's
        plans: Int = 0;
        // GH #596 O: the optimize pass. `org_id` keys the exchange with
        // this organism's leader; the pass is an execution of
        // optimize-walk, occurring on the cadence a ratified practice
        // declares (GH #1143); the org program's loop calls `request_tick`.
        org_id: String = "org";
        optimizations: Int = 0;
        // GH #1143: the schedules the record declares, with their state
        scheduler: Scheduler = Scheduler { }; // C3 family 2: the schedules, what is due at a tick (GH #1143)
        knowledge_record: KnowledgeRecord = KnowledgeRecord { }; // C3 family 3: knowledge proposals, ratification, bindings and relationships
        org_source: OrganizationSourceRecord = OrganizationSourceRecord { }; // C3 family 4: prepared Organization source requests
        practices: PracticeRecord = PracticeRecord { }; // C3 family 5: practices asked, ratified through practice-ratify, read by the hat
        concerns: ConcernRecord = ConcernRecord { }; // C3 family 6: concerns raised and escalated, pressure toward an organ
        spending: SpendRecord = SpendRecord { }; // C3 family 7: model calls and their gate, a child's money reserved and settled
        positions: PositionRecord = PositionRecord { }; // C3 family 7: holders proposed for positions
        steps: StepRecord = StepRecord { }; // C3 family 8 (Work): the organization's own steps that wait
        cases: CaseRecord = CaseRecord { }; // C3 family 8 (Work): a person's cases, admitted, held and completed
        attempts: AttemptRecord = AttemptRecord { }; // C3 family 8 (Work): an attempt's reports, waiting edits and a leg's lease
        reviews: ReviewRecord = ReviewRecord { }; // C3 family 9: a Review's route, settlement and the Reviews born; bearing one is the assembly's
        last_refresh: Int = 0;
        last_signals: String = "";
        org_seed: String = "dna/org"; // the organization's own seed (GH #566 F3): what an `organization` change edits
        initiative: Bool = true; // persistent pressure becomes a growth Mutation, not only a note
        baseline: String = ""; // the diff's base artifact; "" = cut from the genome's seed per mutation
        asked: Int = 0;
        last_task: String = "";
        mutations_minted: Int = 0;
        last_mutation: String = "";
        applied: Int = 0; // candidates applied by this assembly (a replayed apply is not counted twice)
        restarts_requested: Int = 0;
        reviews_open: Int = 0; // live mutation Reviews (accepted children)
        rehydrated: Int = 0; // Reviews re-born from the Journal at birth
        organization_source_review_facts: OrganizationSourceReviewFacts = OrganizationSourceReviewFacts { };
    }
    // A mutation's Review is a child of the assembly: born when the
    // candidate is verified, keyed on its review id so a verdict from
    // the Board reaches exactly it. The Journal is the authority:
    // a pending mutation Review is re-born from it at birth, so an
    // organism restarted mid-review can still be answered.
    // A Review is a resident: it stays for a re-approval after it has
    // settled, and lives until the assembly does. No `release` is
    // declared for it — that would make it a flow, reclaimed the moment
    // its (empty) run completed (GH #735). `reviews_open` counts the
    // Reviews born, as it always did in practice.
    accept(r: Review) { self.reviews_open = self.reviews_open + 1; }
    birth() {
        // GH #995: the catalog — the baseline when the org chart gave none —
        // and the engine of this scope, over this record and these performers
        if self.catalog.workflow_count() == 0 { define_baseline(self.catalog); }
        self.work.bind_scope(self.org_id);
        if self.runs_engine {
            // the record and the performers are the assembly's, handed
            // to the engine as borrows at its construction (GH #730: an
            // interface value into a same-interface field; F.3 closed)
            self.runtime = WorkflowRuntime { scope: self.org_id, work: self.work, journal: self.journal };
            self.executions = Executions { scope: self.org_id };
        }
        self.review_journal.bind(self.journal);
        self.evidence.bind(self.journal, self.verification.receipts);
        self.org_source.bind(self.journal);
        self.practices.bind(self.journal);
        self.concerns.bind(self.journal);
        self.spending.bind(self.journal);
        self.positions.bind(self.journal, self.verification.receipts);
        self.cases.bind(self.journal);
        self.attempts.bind(self.journal);
        self.reviews.bind(self.journal);
        self.organization_source_review_facts.bind(self.org_source.facts);
        self.scheduler.bind(self.journal);
        self.knowledge_record.bind(self.journal, self.verification.receipts);
        self.rehydrate();
        // GH #1143: the schedules the record declares
        self.scheduler.read_rows();
        // GH #596, layering: a child grant wider than the organism's is
        // the early error — refused in the record, and bound by the
        // ceiling from here on (the use-time check does the binding)
        if len(self.ceiling.child) > 0 && !grant_within(self.boundary.current_grant(), self.ceiling.current_grant()) {
            let g = self.boundary.current_grant();
            let c = self.ceiling.current_grant();
            let x = self.journal.append(self.journal.revision(), "grant.refused", g.child,
                "wider than the ceiling `" + c.child + "` at birth: classes `" + g.classes + "` under `" + c.classes + "`, magnitude " + to_string(g.max_magnitude) + " under " + to_string(c.max_magnitude) + ", review " + g.review + " under " + c.review + resource_gap(g, c) + "; bound by the ceiling");
        }
        // GH #529 D6: the host restarted this expression on a Mutation's
        // request; the fact is journaled by the expression itself.
        if std::env::var_exists("HALE_DNA_RESTART_FOR") {
            let x = self.journal.append(self.journal.revision(), "expression.restarted", std::env::var("HALE_DNA_RESTART_FOR"),
                if std::env::var_exists("HALE_DNA_EXPRESSION") { std::env::var("HALE_DNA_EXPRESSION") } else { "" });
        }
    }
    // GH #527 B6: intent arriving on the nerves' typed channel
    // (`hale dna task create`, Iris) enters through the SAME gate as a local
    // `ask` — the Board decides, the Metabolism births the Task,
    // the Journal records both. The organism's main binds this topic
    // to the nerves (GH #986); nothing about the decision lives in the
    // transport.
    bus {
        subscribe IntentOffered as on_intent;
        subscribe ReviewSettled as on_review_settled;
        subscribe ModelCalled as on_model_called;
        subscribe ExpressionObserved as on_observed;
        // GH #529 D7: Work that changes source comes back to the
        // assembly (its editor, its gateway); a root Task's settlement
        // is journaled here; persistent pressure proposes, never grows.
        subscribe TaskPlanned as on_planned where key == self.org_id;
        publish PlanRequested;
        // card 18: an admitted ask runs in the one engine of this scope
        publish ExecutionAsked;
        subscribe WorkflowSettled as on_workflow_settled;
        // card 15: an edit leaf of a workflow execution, relayed by the
        // engine's edit performer (the runtime's scope is this organism's
        // id); its outcome goes back for that exact attempt
        subscribe EditRequested as on_edit_requested where key == self.org_id;
        subscribe RecordResumed as on_record_resumed where key == self.org_id;
        // card 16: a human leaf of a workflow execution, relayed by the
        // engine's human performer; the assembly admits its case and hands
        // it, and the attempt stays out until the person reports it done
        subscribe CaseRequested as on_case_requested where key == self.org_id;
        // GH #995: the engine's organism performer — a catalog step the
        // organization performs itself
        subscribe StepRequested as on_step_requested where key == self.org_id;
        subscribe RunLives as on_run_life;
        publish AttemptReported;
        subscribe OrgReviewed as on_org_reviewed where key == self.org_id;
        publish OptimizeRequested;
        subscribe TickRequested as on_tick where key == self.org_id;
        publish TickRequested;
        subscribe PressureRaised as on_pressure;
        subscribe ConcernRaised as on_concern;
        subscribe PracticeRequested as on_practice_requested;
        subscribe HoldRequested as on_hold_requested;
        subscribe ScheduleRequested as on_schedule_requested;
        subscribe KnowledgeNodeRequested as on_knowledge_node_requested;
        subscribe KnowledgeBindingRequested as on_knowledge_binding_requested;
        subscribe KnowledgeEdgeRequested as on_knowledge_edge_requested;
        subscribe OrganizationSourceRequested as on_organization_source_requested;
        subscribe WorkSubmit as on_work_submit;
        subscribe WorkAllowanceAsk as on_work_allowance;
        // GH #566 F2: a Review is announced as a typed fact, so a position
        // in the org (the Leader) can decide it inside its grant
        publish ReviewRequested;
        publish ReviewRouted;
    }
    // Every model call's evidence, journaled (never the prompt), what was
    // sent filed by the evidence family.
    @unbounded
    fn on_model_called(ev: ModelEvidence) { self.spending.called(ev, self.evidence.call_bodies(ev), self.budget); }
    // The window's allowance is spent: journaled once per window, the
    // Board told; the caller refuses or waits (GH #1131).
    fn budget_exhausted(now: Int) -> Bool {
        let st = self.spending.exhausted(now, self.budget);
        if st.announced { self.board.notify("budget", "exhausted: " + self.budget.describe(now) + "; model-backed work waits for the next window, Reviews wait for the Board"); }
        return st.exhausted;
    }
    // The one gate for a model call's spend, in process and out (GH #1131):
    // the window asked about first, then the family's gate.
    fn spend_gate(entity: String, ceiling_micros: Int, request: String, holder: String, token: Int, now: Int) -> SpendAdmission {
        let exhausted = self.budget_exhausted(now);
        return self.spending.gate(entity, ceiling_micros, request, holder, token, now, self.budget);
    }
    // GH #1089: what a Review requires, routed once and recorded. Opening
    // it (`open`), the organization asks memory's graph for the route its
    // definition names — change-deliver the route of the paths its
    // candidate changes, practice-ratify the Board — and writes
    // `review.routed`; afterwards, a restart included, the row is what the
    // Review requires. A change's fallback is a row too — no signers, and
    // `why`: no memory is named, or no position the route names is held —
    // and final. A proposal's writes nothing on its fallback, and is routed
    // again each time it is rebuilt, so a Board seated later signs it:
    // rebuilding the seeded proposals at a restart appends nothing. Memory
    // that is named and does not answer routes nothing: the Review is not
    // opened (`recorded: false`) and reconcile asks again, so it never
    // opens on its claimed authority alone.
    @unbounded
    fn review_routing(review_id: String, definition: String, paths: String, open: Bool, gated: Bool) -> RouteRequirement {
        return self.reviews.routing(review_id, definition, paths, open, gated, self.knowledge_client, self.verification.receipts);
    }
    // GH #1089: an open routed Review's holders routed again when who holds
    // its positions changed — a hold ratified, a holder retired — so a
    // position filled after it opened can sign, and a holder who left no
    // longer does. The positions stay the route's; the new holders are a
    // `review.routed` row that supersedes the last, and the Review takes them.
    @unbounded
    fn reroute_reviews() { self.tell_routes(self.reviews.reroute(self.knowledge_client)); }
    // GH #1161: a gate run the host observed at the forge (`gate.observed`)
    // is told to its Review, once, routed again as it stands, and the
    // Review weighs its approvals with the run in. Known by the row's
    // digest, not its position: a merged order is rebuilt when a ledger is
    // adopted. Every run again after a restart: a Review rebuilt then hears
    // them all, and one already settled ignores them.
    @unbounded
    fn announce_gate_runs() { self.tell_routes(self.reviews.gate_runs()); }
    // Each Review named, one id a line, told its holders as its latest
    // `review.routed` row has them.
    @unbounded
    fn tell_routes(lines: String) {
        let mut rest = lines;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let id = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            ReviewRouted <- ReviewRouting { review_id: id, signers: native_json_string(routed_row(self.journal, id), "signers") };
        }
    }
    @unbounded
    fn ensure_knowledge_review(review_id: String) -> Bool {
        let req = self.knowledge_record.request_of(review_id);
        if len(req) == 0 { return false; }
        if self.reviews.knowledge_known(review_id) { return true; }
        let settlement = first_row(self.journal, "review.settled", review_id);
        let outcome = if std::str::starts_with(settlement.body, "approve by ") { "approve" } else if std::str::starts_with(settlement.body, "reject by ") { "reject" } else if std::str::starts_with(settlement.body, "revise by ") { "revise" } else { "" };
        let need = self.review_routing(review_id, "practice-ratify", "", len(settlement.kind) == 0, true);
        if !need.recorded { return false; }
        Review {
            journal: self.review_journal, review_id: review_id,
            question: native_json_string(req, "question"),
            subject_digest: native_json_string(req, "subject_digest"),
            required_authority: native_json_string(req, "required_authority"),
            author: native_json_string(req, "author"),
            signers: need.signers, gates: need.gates, fallback: need.fallback,
            settled: len(settlement.kind) > 0, outcome: outcome
        };
        self.reviews.knowledge_born(review_id);
        return true;
    }
    // A knowledge proposal: its rows (the family's), then the Board's
    // Review it asks for.
    fn propose_knowledge(i: Idea, target: String) -> String {
        let digest = self.knowledge_record.propose(i, target);
        if len(digest) == 0 { return ""; }
        let review_id = knowledge_review_id(digest);
        if !self.ensure_knowledge_review(review_id) { return ""; }
        self.board.notify("knowledge", "board needed for " + review_id + ": " + knowledge_question(i, target));
        return digest;
    }
    fn resume_review_command(command_id: String) {
        let moved = self.journal.refresh();
        let decision = review_command_decision(self.journal, command_id);
        if !std::json::find_bool_field(decision, "accepted") || !std::json::find_bool_field(decision, "settled") { return; }
        let review_id = native_json_string(decision, "review_id");
        if self.resume_organization_source_verdict(command_id) { return; }
        let req = self.knowledge_record.request_of(review_id);
        let outcome = native_json_string(decision, "outcome");
        let reviewer = native_json_string(decision, "reviewer");
        let edge_codec = KnowledgeEdgeCodec { };
        let edge = edge_codec.request_of(self.journal, review_id);
        if edge_codec.valid(edge) {
            if edge.candidate_digest != native_json_string(decision, "subject_digest") || outcome != native_json_string(decision, "verdict") || (outcome != "approve" && outcome != "reject" && outcome != "revise") { return; }
            if !self.reviews.decided(review_id, outcome, reviewer, native_json_string(decision, "comment")) { return; }
            let resumed = self.resume_edge_result(review_id, outcome, reviewer, command_id);
            return;
        }
        let binding_codec = KnowledgeBindingCodec { };
        let binding = binding_codec.request_of(self.journal, review_id);
        if binding_codec.valid(binding) {
            if binding.candidate_digest != native_json_string(decision, "subject_digest") || outcome != native_json_string(decision, "verdict") || (outcome != "approve" && outcome != "reject" && outcome != "revise") { return; }
            if !self.reviews.decided(review_id, outcome, reviewer, native_json_string(decision, "comment")) { return; }
            let resumed = self.resume_binding_result(review_id, outcome, reviewer, command_id);
            return;
        }
        if len(req) == 0 || native_json_string(req, "subject_digest") != native_json_string(decision, "subject_digest") { return; }
        if (outcome != "approve" && outcome != "reject" && outcome != "revise") || outcome != native_json_string(decision, "verdict") { return; }
        if !self.reviews.decided(review_id, outcome, reviewer, native_json_string(decision, "comment")) { return; }
        // GH #995: a decision by command is ratified as every decision is,
        // by the practice-ratify execution it admits
        self.ratify_through(review_id);
        self.revisit_steps(false);
    }
    // The Review decided; the Journal records it (the file
    // `hale dna status` and `history` read).
    @unbounded
    fn on_review_settled(r: ReviewSettlement) {
        // the engine's rows are another writer's (card 15): read fresh
        let moved = self.journal.refresh();
        if len(r.command_id) > 0 {
            self.resume_review_command(r.command_id);
            return;
        }
        if r.refusal != "" {
            self.reviews.refused(r.review_id, r.refusal);
            return;
        }
        // GH #1089: an approval admitted that settled nothing — a required
        // position signed — is answered, with what the Review still awaits
        if r.signed {
            self.reviews.signed(r.review_id, r.decided_by, r.awaiting);
            return;
        }
        // An approved candidate that never applied, approved AGAIN by a
        // verdict the Review admitted in full (the fourth review round's
        // finding 1: a generic `already settled` used to stand in for
        // this, and a rejection applied the candidate). The verdict is
        // spent; the apply is not: the whole gate runs again over the
        // same pinned candidate, and a candidate or a base that moved
        // in the meantime is refused as ever.
        if r.reapproval {
            let d = mutation_disposition(self.journal, r.review_id);
            if len(mutation_review_request(self.journal, r.review_id)) == 0 { return; }
            // approved again after it already applied: nothing to do, and
            // the record answers so a waiting `hale dna review` hears it
            if d == "applied" || d == "retained" {
                self.reviews.refused(r.review_id, "already " + d + " (approved again by " + r.decided_by + ")");
                return;
            }
            let a = self.journal.append(self.journal.revision(), "mutation.apply_retried", r.review_id, "approved again by " + r.decided_by + "; the gate runs again");
            let y = self.apply_reviewed(r.review_id, std::time::now());
            // card 15: an application that landed on the retry answers the
            // attempts waiting on this candidate
            self.revisit_waiting();
            // and the record answers the verdict as it answers a first
            // one, so `hale dna review … approve` hears it: it waits on
            // `review.settled` or `review.refused` and nothing else, and
            // reported failure after applying (the fifth round's
            // finding 2). The first settlement stands above this row.
            self.reviews.settled(r.review_id, "approve", r.decided_by, "");
            return;
        }
        // the record says why (GH #566 F7): a person's note, or the Leader's
        // reasoning — the model's answer, not a digest of it
        self.reviews.settled(r.review_id, r.outcome, r.decided_by, r.comment);
        // GH #583 K1: a knowledge proposal's approval is the authoritative
        // ratification — one row naming the digest, which the knowledge
        // service applies from the record; anything else leaves the
        // proposal as it was, in lineage.
        // GH #995: a knowledge proposal is ratified through practice-ratify:
        // the verdict step of its execution — the one it was proposed under,
        // or one adopted for it now (a seeded proposal, a concern's) —
        // hears it and the steps after it write the rest
        let kreq = self.knowledge_record.request_of(r.review_id);
        if len(kreq) > 0 {
            self.ratify_through(r.review_id);
            self.revisit_steps(false);
            return;
        }
        let edge_codec = KnowledgeEdgeCodec { };
        if edge_codec.valid(edge_codec.request_of(self.journal, r.review_id)) {
            let resumed = self.resume_edge_result(r.review_id, r.outcome, r.decided_by, "");
            return;
        }
        let binding_codec = KnowledgeBindingCodec { };
        if binding_codec.valid(binding_codec.request_of(self.journal, r.review_id)) {
            let resumed = self.resume_binding_result(r.review_id, r.outcome, r.decided_by, "");
            return;
        }
        // GH #529 D5: a mutation's approval applies exactly the reviewed
        // candidate; a rejection or revision leaves genome and expression
        // untouched and keeps the Mutation in lineage.
        if mutation_review_request(self.journal, r.review_id) == "" { return; }
        let d = mutation_disposition(self.journal, r.review_id);
        let live = d == "applied" || d == "retained";
        if r.outcome == "approve" {
            // post-review: it was applied under the grant; the human concurs
            if !live { let y = self.apply_reviewed(r.review_id, std::time::now()); }
            // card 15: the attempts waiting on this candidate hear its verdict
            self.revisit_waiting();
            return;
        }
        if live {
            // post-review rejection: the applied candidate comes back out
            self.rollback_to_base(r.review_id, "review " + r.outcome + " by " + r.decided_by, std::time::now());
            self.revisit_waiting();
            return;
        }
        let z = self.journal.append(self.journal.revision(), "mutation." + (if r.outcome == "revise" { "revise" } else { "rejected" }), r.review_id,
            "review " + r.outcome + " by " + r.decided_by + "; genome and expression untouched");
        // card 15: the attempts waiting on this candidate hear its verdict
        self.revisit_waiting();
        // the worktree was scratch; the Mutation, its candidate commit,
        // its Attempts and its evidence stay in the Journal
        let now = std::time::now();
        let lease = self.gateway.take(r.review_id, "dna", now);
        let w = self.gateway.remove(self.journal, r.review_id, lease.token, now);
    }
    // Apply exactly the reviewed candidate (GH #529 D5): the Review
    // must have settled approve, the worktree's head must still be the
    // commit the reviewer looked at (a candidate that moved after the
    // review is refused by digest), and the apply goes through the
    // gateway — journaled under the candidate, fenced by the lease — so
    // a crashed and retried apply reads the recorded result and never
    // commits twice. Then the host is asked to rebuild and restart.
    @unbounded
    fn apply_reviewed(mutation_id: String, now: Int) -> String {
        let req = mutation_review_request(self.journal, mutation_id);
        if req == "" { return "refused: no mutation review " + mutation_id; }
        if len(native_json_string(req, "organization_source_request_id")) > 0 { return self.apply_organization_source(mutation_id, now); }
        let reviewed = std::json::find_string_field(req, "subject_digest");
        let wt = std::json::find_string_field(req, "worktree");
        if !self.reviews.approved(mutation_id) {
            let x = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "not approved");
            return "refused: not approved";
        }
        let head = self.gateway.head_of(wt);
        if head != reviewed {
            let x = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "candidate moved after review: " + head + " != " + reviewed);
            self.board.notify("mutation", mutation_id + " refused: the candidate moved after the review");
            return "refused: candidate moved after review";
        }
        // The DESTINATION must also be the base the review was against
        // (the shakeout's finding 2). A maintainer commit or a second
        // proposal landing while this one was under review makes the
        // apply a merge of two changes nobody reviewed together and
        // nothing verified together. Refuse; a new candidate on the new
        // base goes through the whole gate.
        // …unless this very apply is already in the record: a retried
        // apply replays what happened, and the head it left behind is
        // the candidate, not the base.
        self.bind_owner();
        let already = effect_status(self.journal, effect_key(self.ownership.me, "apply", reviewed));
        let base = std::json::find_string_field(req, "base_commit");
        let now_head = self.gateway.head();
        if len(base) > 0 && now_head != base && !(already.done && already.ok) {
            let y = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "the genome moved since the review: " + now_head + " != " + base + "; propose again on the new base");
            self.board.notify("mutation", mutation_id + " refused: the genome moved since the review (" + short_sha(base) + " -> " + short_sha(now_head) + ")");
            return "refused: the genome moved since the review";
        }
        // A destination carrying uncommitted work of its own. The
        // fast-forward would keep it, so the genome's head would be the
        // candidate while its files are not (the review's second round,
        // finding 1). Refused here, before the apply's effect row, so
        // the maintainer can commit or stash and approve again; the
        // gateway checks it once more immediately around the git call,
        // where a refusal is the race and the Mutation is done.
        let dirty = self.gateway.dirty(self.genome_seed, wt);
        if len(dirty) > 0 && !(already.done && already.ok) {
            let z = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "the genome has uncommitted changes; commit or stash them and approve again:\n" + dirty);
            self.board.notify("mutation", mutation_id + " refused: the genome has uncommitted changes");
            return "refused: the genome has uncommitted changes";
        }
        return self.apply_candidate(mutation_id, reviewed, now);
    }
    // The apply itself: through the gateway under the candidate's key
    // and the Mutation's lease, then the restart request with the
    // fitness signals the proposal declared.
    @unbounded
    fn apply_candidate(mutation_id: String, candidate: String, now: Int) -> String {
        let lease = self.gateway.take(mutation_id, "dna", now);
        let r = self.gateway.apply(self.journal, mutation_id, candidate, lease.token, now);
        if !r.ok {
            let x = self.journal.append(self.journal.revision(), "mutation.failed", mutation_id, "apply: " + r.refused);
            self.board.notify("mutation", mutation_id + " apply failed: " + r.refused);
            return "failed: " + r.refused;
        }
        if r.replayed { return "applied (replayed)"; }
        self.applied = self.applied + 1;
        self.restarts_requested = self.restarts_requested + 1;
        let req = mutation_review_request(self.journal, mutation_id);
        let fitness = std::json::find_string_field(req, "fitness_signals");
        let seed = std::json::find_string_field(req, "seed");
        // GH #566 F4: a deployment gateway expresses the candidate itself
        // and owns the window; its exit is the observation. Without one,
        // the host is asked to rebuild and restart.
        if self.deployment.kind() != "none" {
            let up = self.deployment.apply(candidate);
            let d = self.journal.append(self.journal.revision(), "expression.deployed", mutation_id, (if up { "expressed " } else { "failed " }) + candidate + " via " + self.deployment.kind());
            self.on_observed(Observation { mutation_id: mutation_id, outcome: if up { "healthy" } else { "build_failed" }, model_hash: candidate, detail: "deployment " + self.deployment.kind() });
            return "applied";
        }
        let x = self.journal.append(self.journal.revision(), "expression.restart_requested", mutation_id, "apply " + candidate + " seed " + seed + " fitness " + fitness);
        self.board.notify("restart", mutation_id + " applied as " + candidate + "; rebuild and restart requested");
        return "applied";
    }
    // Back to the Mutation's base through the gateway, and the old
    // expression asked for. Shared by a bad observation window and a
    // post-review rejection.
    @unbounded
    fn rollback_to_base(mutation_id: String, why: String, now: Int) {
        let req = mutation_review_request(self.journal, mutation_id);
        let base = std::json::find_string_field(req, "base_commit");
        let lease = self.gateway.take(mutation_id, "dna", now);
        let r = self.gateway.rollback(self.journal, mutation_id, base, lease.token, now);
        if !r.ok {
            let y = self.journal.append(self.journal.revision(), "mutation.failed", mutation_id, "rollback: " + r.refused);
            self.board.notify("mutation", mutation_id + " rollback failed: " + r.refused);
            return;
        }
        if self.deployment.kind() != "none" {
            let back = self.deployment.rollback(base);
            let d = self.journal.append(self.journal.revision(), "expression.deployed", mutation_id, (if back { "restored " } else { "failed to restore " }) + base + " via " + self.deployment.kind() + " after " + why);
            self.board.notify("restart", mutation_id + " rolled back to " + base + " after " + why + (if back { "" } else { " — the deployment did not restore it" }));
            return;
        }
        self.restarts_requested = self.restarts_requested + 1;
        let y = self.journal.append(self.journal.revision(), "expression.restart_requested", mutation_id, "rollback " + base + " seed " + std::json::find_string_field(req, "seed") + " after " + why);
        self.board.notify("restart", mutation_id + " rolled back to " + base + " after " + why);
    }
    // The host's report on the observation window (GH #529 D6). Only an
    // applied Mutation is judged: healthy retains it and dissolves its
    // worktree; anything else rolls the genome back to the Mutation's
    // base and asks for the old expression back.
    @unbounded
    fn on_observed(o: Observation) {
        let x = self.journal.append(self.journal.revision(), "expression.observed", o.mutation_id, o.outcome + " " + o.model_hash + " " + o.detail);
        if mutation_disposition(self.journal, o.mutation_id) != "applied" { return; }
        let now = std::time::now();
        let req = mutation_review_request(self.journal, o.mutation_id);
        // step 11: the originating pressure, re-measured against the
        // fitness signals the proposal declared — what the window saw
        let p = self.journal.append(self.journal.revision(), "pressure.remeasured", o.mutation_id,
            "task " + std::json::find_string_field(req, "task_id") + " fitness " + std::json::find_string_field(req, "fitness_signals") + ": " + o.outcome + " " + o.detail);
        if o.outcome == "healthy" {
            let lease = self.gateway.take(o.mutation_id, "dna", now);
            let y = self.journal.append(self.journal.revision(), "mutation.retained", o.mutation_id, "observed healthy as " + o.model_hash);
            let z = self.gateway.remove(self.journal, o.mutation_id, lease.token, now);
            // GH #604: after a restart the Work that would settle the
            // Task is gone; the Task settles from its Mutation's outcome
            return;
        }
        self.rollback_to_base(o.mutation_id, o.outcome, now);
    }
    // GH #596 O: the record's structural signals, as the leader reads
    // them — what the design's practice on signals names, counted from
    // the record. Bounded by the record.
    @unbounded
    fn signals() -> String {
        let n = self.journal.revision();
        let mut unparsed = 0;
        let mut plans = 0;
        let mut concerns = 0;
        let mut contractions = 0;
        let mut refused_reviews = 0;
        let mut rolled_back = 0;
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "task.planned" { plans = plans + 1; if std::str::contains(e.body, "\"parsed\": false") { unparsed = unparsed + 1; } }
            if e.kind == "concern.raised" { concerns = concerns + 1; }
            if e.kind == "grant.contracted" { contractions = contractions + 1; }
            if e.kind == "review.refused" { refused_reviews = refused_reviews + 1; }
            if e.kind == "mutation.rolled_back" { rolled_back = rolled_back + 1; }
            i = i + 1;
        }
        return "asks planned: " + to_string(plans) + " (" + to_string(unparsed) + " with no plan the leader could name, taking the defaults)\n"
            + "concerns raised: " + to_string(concerns) + "\n"
            + "grant contractions: " + to_string(contractions) + "\n"
            + "verdicts refused: " + to_string(refused_reviews) + "\n"
            + "mutations rolled back: " + to_string(rolled_back) + "\n"
            + "record rows: " + to_string(n);
    }
    // Enter through the owner's queue, so work arriving during a
    // journal refresh waits for its cached view to be complete. Calling
    // tick directly from the parent's loop allowed a queued handler to
    // re-enter a partially loaded journal at a subprocess drain point.
    fn request_tick(now: Int) { TickRequested <- TickRequest { org: self.org_id, now: now }; }
    fn on_tick(ev: TickRequest) { self.tick(ev.now); }
    // Synchronous cadence processing, for this owner's handler or an
    // isolated caller with no incoming bus work. Live org loops use
    // request_tick with the wall clock in milliseconds (the scaffold
    // passes `std::time::nanos(std::time::current()) / 1000000`): an
    // occurrence is a time the cadence names, so a monotonic clock names
    // none (GH #1143).
    @unbounded
    fn tick(now: Int) {
        // pause/resume rows appended from a clone reach the record the
        // organism holds; read what arrived (a git journal is re-read
        // from its ref at most every 5s of wall time)
        let wall = std::time::now();
        if wall - self.last_refresh >= 5 {
            self.last_refresh = wall;
            let moved = self.journal.refresh();
            // card 17: what a person completed since the cases were last
            // examined is observed here, live — by the revision examined,
            // not by whether THIS refresh moved: another handler's refresh
            // (a redelivery's) reads the record without examining every
            // case, and must not stand for the examination
            if self.journal.revision() > self.cases.examined_at() { let completed = self.revisit_cases(); }
            self.refresh_ownership();
            self.reconcile_governance();
            self.reroute_reviews();
            self.announce_gate_runs();
            let reopened = self.reopen_expired_claims();
        }
        // GH #667: a transfer another owner's member accepted for this
        // owner becomes this owner's handed Task
        if self.ownership.shared() { self.admit_transfers(); }
        // GH #1143: every schedule the record declares, at `now`: the
        // scheduler says which occurrence of each is due, and it is admitted
        // here
        self.scheduler.read_rows();
        let n = self.scheduler.count();
        let mut i = 0;
        while i < n {
            // on a shared record an occurrence is its convener's owner's
            // to admit: another body leaves the schedule to it, with no row
            if !self.ownership.admits(schedule_to(self.scheduler.at(i))) { i = i + 1; continue; }
            let t = self.scheduler.due(i, now, self.catalog);
            if t > 0 { self.admit_occurrence(i, t); }
            i = i + 1;
        }
    }
    // GH #1143: admit occurrence `t` of the scheduler's `i`th schedule: an
    // execution of the definition through its first store, with the ask id
    // `sched:<id>@<t>` — the occurrence's key, so a restart or a redelivery
    // asking it again is one execution — and the convener as its position:
    // its owner admits it, and the admission names it. The scheduler records
    // what it became: that execution, this one, or a refusal.
    @unbounded
    fn admit_occurrence(i: Int, t: Int) {
        let s = self.scheduler.at(i);
        let key = s.id + "@" + to_string(t);
        // asked again (a redelivery, a restart): the execution it already is
        let had = self.workflow_admission_of("sched:" + key, self.journal.revision());
        if len(had) > 0 { self.scheduler.admitted(i, t, had, true); return; }
        let task = self.run_workflow(WorkflowAsk { id: "sched:" + key, definition: s.definition, revision: self.catalog.latest(s.definition), inputs: s.args, to: schedule_to(s), convener: s.convener });
        self.scheduler.admitted(i, t, task, false);
    }
    // The leader's answer: clean, or one small proposal — which enters
    // as an ask in the leader's name and takes the whole road (planned,
    // proposed, reviewed by the Board as an organization change).
    @unbounded
    fn on_org_reviewed(r: OrgReview) {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("outcome", if len(r.proposal) > 0 { "proposed" } else { "clean" });
        b.string_field("proposal", r.proposal);
        b.string_field("narrative", r.narrative);
        b.string_field("package", r.package);
        b.string_field("by", r.by);
        b.string_field("signals", r.signals);
        // GH #995: the optimize-walk execution this answers
        b.string_field("task", r.task);
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "org.reviewed", self.org_id, b.result());
        self.revisit_steps(false);
        if len(r.proposal) > 0 {
            let id = self.ask(Intent { id: "opt:" + r.task, outcome: r.proposal, from: r.by });
        }
    }
    // A planned ask becomes a Mutation under the class and target the
    // leader named; an ask the leader calls a person's job is handed
    // rather than mutated. Bounded by the Tasks the Board admits.
    @unbounded
    fn on_planned(p: Plan) {
        // card 16: a human attempt awaiting the leader's word is handed
        // as the case the leader described; nothing of the plan runs
        let ask = self.cases.planned(p.task_id, p.work_id);
        if len(ask.attempt_id) > 0 {
            self.plans = self.plans + 1;
            self.hand_case(ask, p.assignee, p.obligation, "leader", p.narrative);
            self.give_up_claim("plan/case:" + case_id_of(ask.request), true);
            return;
        }
        // card 18: an ask awaiting the leader's word is admitted under it:
        // what the ask is (a person's job, an organism change, an
        // application change), bound into its admission
        let mut i = 0;
        while i < self.pending_asks.len() {
            let intent = self.pending_asks.get(i) or Intent { };
            if len(intent.id) > 0 && intent.id == p.task_id && p.work_id == "ask" {
                self.pending_asks.set(i, Intent { }) or discard;
                self.plans = self.plans + 1;
                let id = self.admit_ask(intent, p, true);
                // the plan is spent and its admission recorded: the claim goes
                self.give_up_claim("plan/" + p.task_id, true);
                return;
            }
            i = i + 1;
        }
    }
    // An edit leaf's attempt from the workflow engine (card 15). Under
    // the prepare-candidate contract the attempt is performed once — the
    // Mutation it produces is bound to the attempt (card 14), so an
    // attempt asked again answers from that Mutation and edits nothing
    // twice — and its outcome is reported for the attempt: done when its
    // candidate is prepared for review (or released), failed when
    // preparation failed, nothing while the record would not take its
    // request row (held for `redrive`). Under the review-waiting contract
    // the attempt performs nothing: it is answered from a review of its
    // Task's candidate already settled, or waits for one. No Work of an
    // admitted execution settles its Task: the engine's workflow does.
    @unbounded
    fn on_edit_requested(e: EditAsk) {
        // the engine's rows — the admission, the attempt — are another
        // writer's: read them fresh before deciding on them; and the
        // reports the record has been seen to hold since are released
        let moved = self.journal.refresh();
        self.attempts.release_recorded();
        self.revisit_waiting();
        let req = e.request;
        if review_waiting(req.output_contract) {
            // the Work names the Work whose candidate it waits on; that
            // Work's Mutation (card 14) is the candidate — exactly that one,
            // on this path and when a review settles later
            let producer = producer_of(req);
            if len(producer) == 0 {
                self.report(e, "failed", "", "an Applied Work names, in its target, the Work whose candidate it waits on; none is named");
                return;
            }
            // the candidate is the Mutation of the attempt the producer
            // settled on — never its first attempt's, which may have failed
            let settled = self.settlement_of(producer);
            if len(settled) > 0 && settled != "done" {
                self.report(e, "failed", producer + ": " + settled, "the producing Work settled " + settled + ": there is no candidate to wait on");
                return;
            }
            let m = self.candidate_of(producer);
            if len(m) > 0 && self.report_review(e, m) { return; }
            // asked again — a redelivery — it waits once
            self.attempts.wait(e);
            return;
        }
        let seen = self.mutation_of_attempt(e.attempt_id);
        if len(seen) > 0 { self.report_prepared(e, seen); return; }
        // GH #1131: the editor's spend is admitted by the one gate a leg's is,
        // the Work's own ceiling bounding it; refused, nothing is edited and
        // the attempt is declined with the reason
        let gate = self.spend_gate(e.attempt_id, req.cost_ceiling, "", "", 0, std::time::now());
        if !gate.ok { self.report(e, "declined", "", "the budget gate admitted no spend for the editor: " + gate.why); return; }
        // card 18: an ask's leaf edits under the leader's word bound into
        // the admission — the class (an organism change is class
        // `organization`, the Board's), and the target when it names a
        // file the genome has under the seed the class edits; a model's
        // prose is not a path. An application-authored leaf edits as
        // class `application`, at the request's own target
        let plan = self.ask_plan_of(req.task_id);
        let class = self.edit_class_of(req.task_id);
        let seed = if class == "organization" { self.org_seed } else { self.genome_seed };
        let under = self.gateway.repo.root() + "/" + (if seed == "." { "" } else { seed + "/" }) + plan.target;
        let planned_target = plan.parsed && len(plan.target) > 0 && !std::str::contains(plan.target, " ") && std::io::fs::file_exists(under);
        let target = if planned_target { plan.target } else { req.target };
        let out = self.mutate_for(req, class, req.objective, target, std::time::now());
        if record_refused(out) { self.attempts.hold(e); return; }
        let m = self.mutation_of_attempt(e.attempt_id);
        self.report_prepared(e, m);
    }
    // The class a Task's edit is made as (card 18): an organism change is
    // `organization`, the Board's; else the class the leader's plan names,
    // else `application`.
    fn edit_class_of(task_id: String) -> String {
        let plan = self.ask_plan_of(task_id);
        if !plan.parsed { return "application"; }
        if plan.kind == "organism" { return "organization"; }
        return if len(plan.change_class) > 0 { plan.change_class } else { "application" };
    }
    // A human leaf's attempt from the workflow engine (card 16): a case
    // for a person, admitted once per attempt — `case.admitted <case>`,
    // self-sufficient and versioned, before the rows the tooling of the
    // day reads (`task.born`, `task.handed`) — and left pending: the
    // parent Work is done only when the person reports the case done.
    // Asked again (a redelivery, a later attempt of the Work), the case
    // is found by its stable identity — the Work's — and its
    // compatibility rows completed; no second case, no second word from
    // the leader: the terms bound at admission stand. In an organism the
    // leader plans for, the leader says who and under what obligation,
    // as for a job today, once per case; else the case is unassigned.
    @unbounded
    fn on_case_requested(c: CaseAsk) {
        let moved = self.journal.refresh();
        let req = c.request;
        let case_id = case_id_of(req);
        if len(case_id) == 0 {
            self.board.notify("case", "attempt " + c.attempt_id + " names no Work of a step: no case for it");
            return;
        }
        if len(self.cases.recorded(case_id)) > 0 || len(self.cases.of_attempt(c.attempt_id)) > 0 {
            let x = self.ensure_case_rows(case_id);
            // asked again after its person completed it (a restart's
            // redelivery): the outcome is reported now (card 17)
            let done = self.revisit_case(case_id);
            return;
        }
        // card 18: an ask the leader called a person's job carries whom and
        // under what obligation in its admission: no second word is asked
        let plan = self.ask_plan_of(req.task_id);
        if plan.parsed && plan.kind == "person" {
            self.hand_case(c, plan.assignee, plan.obligation, "leader", plan.narrative);
            return;
        }
        if self.planned {
            // a case already awaiting the leader's word is not asked for twice
            if self.cases.awaiting(case_id) { return; }
            // GH #1026: claimed before the leader is asked, as an ask is. A
            // case another node is planning is held and driven again
            // (`redrive`) until that node has admitted it or its claim has
            // expired; claimed, the record is read again, and a case the
            // claim's last holder admitted meanwhile is completed, not
            // planned twice.
            let key = "plan/case:" + case_id;
            if !self.take_claim(key, self.claim_ttl) { self.cases.hold(c); return; }
            let again = self.journal.refresh();
            if len(self.cases.recorded(case_id)) > 0 {
                self.give_up_claim(key, false);
                let x = self.ensure_case_rows(case_id);
                return;
            }
            self.note_claim(key);
            self.cases.await_plan(c);
            PlanRequested <- PlanRequest { org: self.org_id, task_id: req.task_id, work_id: req.work_id, objective: req.objective, target: req.target, requires: req.requires, data_class: req.data_class };
            return;
        }
        self.hand_case(c, "", "", "", "");
    }
    // The case admitted and handed: the admission is the authoritative
    // row, exact at the revision read, and only then the compatibility
    // rows; an admission the record refuses holds the attempt for
    // `redrive`. What the leader proposed (whom, under what obligation)
    // is one thing; what binds is decided from the reading the append
    // is exact at — who is admissible now, which practice is in force
    // now, whose the assignee is — and a stale reading repeats the
    // decision, not only the write: a retirement that landed between
    // sends the case to the successor, never to the person retired.
    // Assignee, obligation, acceptance practice and required evidence
    // bind as a job's do today; a person of another owner's makes it a
    // transfer, as today.
    @unbounded
    fn hand_case(c: CaseAsk, assignee_named: String, obligation: String, by: String, narrative: String) {
        let req = c.request;
        let case_id = case_id_of(req);
        let mut tries = 0;
        while tries < 6 {
            tries = tries + 1;
            let moved = self.journal.refresh();
            let rev = self.journal.revision();
            if row_exists(self.journal, "case.admitted", case_id) { let x = self.ensure_case_rows(case_id); return; }
            let terms = self.handoff_terms(assignee_named, obligation);
            let body = self.cases.body(c, case_id, terms, obligation, by, narrative, self.ownership.me);
            let a = self.cases.admit(case_id, body, rev);
            if a.ok {
                let x = self.ensure_case_rows(case_id);
                return;
            }
            if a.error != "stale_revision" && a.error != "claimed" {
                self.cases.refused(c);
                self.board.notify("record", "the case of " + req.work_id + " was not admitted by the record (" + a.error + "); held");
                return;
            }
        }
        self.cases.hold(c);
        self.board.notify("record", "the case of " + req.work_id + " was not admitted: the record moved too often; held");
    }
    // The compatibility rows of an admitted case, whichever are missing:
    // `task.born <case>` and `task.handed <case>` (`task.transfer_requested`
    // where the admission binds a transfer), as the tooling of the day
    // reads them — written after the admission, and completed at a
    // restart that fell between. The rows say what the admission
    // recorded — its origin and its disposition — never what the body
    // repairing them is: only the recorded owner writes them, and a
    // transfer is the receiving owner's to hand once a member of theirs
    // accepts it (`task.transfer_accepted`, `admit_transfers`). A row the
    // record refuses holds the case for the recovery signals; the
    // hand-off is announced once it is durable. True when the rows are.
    @unbounded
    fn ensure_case_rows(case_id: String) -> Bool {
        let r = self.cases.rows(case_id, self.ownership.me);
        if len(r.held) > 0 { self.board.notify("record", "the " + r.held + " row of case " + case_id + " was refused by the record (" + r.why + "); held"); }
        if len(r.notice) > 0 { self.board.notify("task", r.notice); }
        return r.ok;
    }
    // The held compatibility rows put again: how many cases completed.
    @unbounded
    fn retry_rows() -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.cases.held_row_count() {
            let case_id = self.cases.held_row(i);
            if len(case_id) > 0 && self.ensure_case_rows(case_id) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    // What a hand-off binds (card 16, as a job's today): the assignee —
    // a retired person's successor, or nobody — the acceptance practice
    // in force for the obligation now, whether it closes only with
    // evidence, and which owner the assignee belongs to.
    fn handoff_terms(assignee_named: String, obligation: String) -> Handoff {
        let gone = retirement(self.journal, assignee_named);
        let assignee = if gone.retired { self.admissible(assignee_named) } else { assignee_named };
        let practice = if len(obligation) > 0 { self.knowledge_record.practice_in_force("acceptance/" + obligation) } else { "" };
        let practice_text = if len(practice) > 0 { std::json::find_string_field(self.verification.receipts.read(practice[7..len(practice)]), "text") } else { "" };
        let theirs = if self.ownership.shared() && len(assignee) > 0 { self.ownership.owner_of_person(assignee) } else { "" };
        return Handoff {
            assignee: assignee, retired_assignee: if gone.retired { assignee_named } else { "" },
            practice: practice, evidence_required: acceptance_requires_evidence(practice_text),
            theirs: if len(theirs) > 0 && theirs != self.ownership.me { theirs } else { "" }
        };
    }
    // Card 17: a case completed by its person — `task.done` in their
    // name, or a decision reported and accepted — is the outcome of the
    // attempt it was admitted for: reported to the runtime as an edit's
    // outcome is (card 15), judged by the bound terms of the ADMISSION,
    // never by a practice in force later, settled once by the runtime's
    // own barrier (an outcome the record holds changes nothing), and
    // kept until the record is seen to hold it. Only the recorded owner
    // connects it: the Work runs in the origin's execution. A completion
    // the bound condition refuses is noted once and connects nothing; a
    // later valid one connects. True when the attempt's outcome was
    // reported now.
    @unbounded
    fn revisit_case(case_id: String) -> Bool {
        let adm = self.cases.recorded(case_id);
        if len(adm) == 0 { return false; }
        if std::json::find_string_field(adm, "owner") != self.ownership.me { return false; }
        let attempt = std::json::find_string_field(adm, "attempt_id");
        if len(attempt) == 0 || row_exists(self.journal, "attempt.outcome", attempt) { return false; }
        let c = case_completion(self.journal, case_id, adm);
        if c.valid {
            let how = "case " + case_id + " " + c.how + " by " + c.by
                + (if len(c.evidence) > 0 { " (evidence " + c.evidence + ")" } else if len(c.exception) > 0 { " (exception: " + c.exception + ")" } else { "" });
            if !self.attempts.reported(attempt) {
                self.cases.completed_now();
                self.board.notify("case", how + "; attempt " + attempt + " is done");
            }
            self.report_attempt(self.org_id, attempt, WorkResult {
                disposition: "done", result: how, narrative: how, evidence: c.evidence,
                performer: std::json::find_string_field(adm, "performer"), attempt_id: attempt
            });
            return true;
        }
        if c.found && !self.cases.noted(case_id) {
            self.cases.refused_now(case_id);
            self.board.notify("case", "case " + case_id + " has a completion its bound condition refuses (" + c.why + "); the attempt " + attempt + " stays out");
        }
        return false;
    }
    // Every admitted case looked at for its completion: at a restart,
    // when the record resumes, on `redrive`, and at the tick whose
    // record has rows past the revision last examined here. How many
    // attempts were reported.
    @unbounded
    fn revisit_cases() -> Int {
        let n = self.journal.revision();
        let mut reported = 0;
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "case.admitted" && self.revisit_case(e.entity) { reported = reported + 1; }
            i = i + 1;
        }
        self.cases.examined(n);
        return reported;
    }
    // Every admitted case of this owner's has its compatibility rows: a
    // restart that fell between the admission and either row completes
    // them (card 16). Another owner's cases are theirs to complete; a
    // transfer to this owner is handed by `admit_transfers` once
    // accepted.
    @unbounded
    fn restore_cases() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "case.admitted" { let x = self.ensure_case_rows(e.entity); }
            i = i + 1;
        }
    }
    // The outcome of a prepare-candidate attempt, from the durable state
    // of the Mutation bound to it: prepared (in review, escalated,
    // released, applied, retained — a later verdict changes none of
    // this) is done; failed before a candidate is failed; still in
    // flight is not reported yet.
    fn report_prepared(e: EditAsk, mutation_id: String) {
        if len(mutation_id) == 0 {
            self.report(e, "failed", "", "no Mutation was bound to attempt " + e.attempt_id);
            return;
        }
        let r = self.prepared_result(mutation_id);
        // in flight: its outcome is reported when it is one
        if len(r.disposition) > 0 { self.report(e, r.disposition, r.result, r.narrative); }
    }
    // What a Mutation bound to an attempt says of it (card 15): done once
    // its candidate is prepared for review, failed when preparation failed,
    // no disposition while it is in flight.
    fn prepared_result(mutation_id: String) -> WorkResult {
        let d = mutation_disposition(self.journal, mutation_id);
        let prepared = len(mutation_review_request(self.journal, mutation_id)) > 0 || d == "release" || d == "applied" || d == "retained";
        if prepared { return WorkResult { disposition: "done", result: mutation_id + ": candidate prepared (" + d + ")", narrative: "candidate prepared for review" }; }
        if d == "failed" || d == "deny" || d == "refused" { return WorkResult { disposition: "failed", result: mutation_id + ": " + d, narrative: "preparation failed: " + self.row_body_of("mutation." + d, mutation_id) }; }
        return WorkResult { };
    }
    // The body of the latest `kind` row of `entity`, "" when none.
    @unbounded
    fn row_body_of(kind: String, entity: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.journal.revision() { let e = self.journal.read(i); if e.kind == kind && e.entity == entity { out = e.body; } i = i + 1; }
        return out;
    }
    // The outcome of a review-waiting attempt, from the durable state of
    // the candidate it waits on: rejected or sent back is failed;
    // approved AND applied (or retained) is done; approved and rolled
    // back is failed; approved but not applied — the apply refused,
    // pending, unresolved — is not an outcome yet, and the Work keeps
    // waiting. Whether it was settled.
    fn report_review(e: EditAsk, mutation_id: String) -> Bool {
        let verdict = self.reviews.outcome_of(mutation_id);
        if len(verdict) == 0 { return false; }
        if verdict != "approve" {
            self.report(e, "failed", mutation_id + ": " + verdict, "the candidate was " + (if verdict == "revise" { "sent back" } else { "rejected" }));
            return true;
        }
        let d = mutation_disposition(self.journal, mutation_id);
        if d == "applied" || d == "retained" {
            self.report(e, "done", mutation_id + ": " + d, "the candidate was approved and applied");
            return true;
        }
        if d == "rolled_back" {
            self.report(e, "failed", mutation_id + ": " + d, "the candidate was applied and rolled back");
            return true;
        }
        return false;
    }
    // Bounded by the attempts the engine admits: a kept report is released
    // when the record is seen to hold its outcome.
    @unbounded
    fn report(e: EditAsk, disposition: String, result: String, narrative: String) {
        self.attempts.edit_reported();
        self.report_attempt(e.scope, e.attempt_id, WorkResult { disposition: disposition, result: result, narrative: narrative, performer: e.performer, attempt_id: e.attempt_id });
    }
    fn refuse_submission(s: WorkSubmission, why: String) {
        self.attempts.refuse(s, why);
        self.board.notify("attempt", "attempt " + s.attempt_id + ": the outcome " + s.holder + " handed back is refused: " + why);
    }
    // The calls a leg made under the attempt, as it reported them: each
    // is one `model.called` row on the attempt id, accounted by the
    // budget like a call made here (the prompt and the context are the
    // leg's receipts, named by digest; no body travels in a submission).
    @unbounded
    fn journal_calls(attempt_id: String, calls: String) {
        if len(calls) == 0 || !std::json::valid(calls) { return; }
        let mut it = std::json::array_first(calls);
        let mut n = 0;
        while !it.done && n < 256 {
            let c = it.element;
            let refused = std::json::find_string_field(c, "refused");
            self.on_model_called(ModelEvidence {
                attempt_id: attempt_id,
                adapter: std::json::find_string_field(c, "adapter"),
                backend: std::json::find_string_field(c, "backend"),
                endpoint: std::json::find_string_field(c, "endpoint"),
                credential: std::json::find_string_field(c, "credential"),
                requested_model: std::json::find_string_field(c, "requested_model"),
                reported_model: std::json::find_string_field(c, "reported_model"),
                params: std::json::find_string_field(c, "params"),
                prompt_digest: std::json::find_string_field(c, "prompt_digest"),
                context_digest: std::json::find_string_field(c, "context_digest"),
                knowledge_bindings: std::json::find_string_field(c, "knowledge_bindings"),
                tool_grant: std::json::find_string_field(c, "tool_grant"),
                response_digest: std::json::find_string_field(c, "response_digest"),
                input_tokens: std::json::find_int_field(c, "input_tokens"),
                output_tokens: std::json::find_int_field(c, "output_tokens"),
                elapsed: std::json::find_string_field(c, "elapsed"),
                cost_micros: std::json::find_int_field(c, "cost_micros"),
                retry_of: std::json::find_string_field(c, "retry_of"),
                data_class: std::json::find_string_field(c, "data_class"),
                ok: len(refused) == 0,
                refused: refused,
                waited_ms: std::json::find_int_field(c, "waited_ms")
            });
            n = n + 1;
            it = std::json::array_next(it);
        }
    }
    // A leg's ask for its attempt's spend (GH #1131), relayed from its
    // `attempt.allowance_requested` row: the lease checked as an outcome's
    // is — this holder, this token, live as of the head's admission — then
    // the one gate, with the attempt's own cost ceiling. The answer is a
    // row naming the request: granted with the allowance, or refused.
    @unbounded
    fn on_work_allowance(a: WorkAllowance) {
        let moved = self.journal.refresh();
        if len(a.attempt_id) == 0 { return; }
        let adm = recorded_attempt_admission(self.journal, a.attempt_id, self.journal.revision());
        if !adm.ok || !owned_by(self.ownership.me, adm.value.task_id) { return; }
        if self.spending.allowance_answered(a) { return; }
        let claim = self.attempts.claim_of(a.attempt_id);
        let now = if a.at > 0 { a.at } else { std::time::now() };
        let mut why = "";
        if recorded_attempt_outcome(self.journal, a.attempt_id, self.journal.revision()).ok { why = "attempt " + a.attempt_id + " is settled; no spend is admitted for it"; }
        else if !row_exists(self.journal, "effect.relayed", execution_key(a.attempt_id)) { why = "attempt " + a.attempt_id + " was never relayed to a leg; the organism performs it"; }
        else if !claim.present { why = "attempt " + a.attempt_id + " was never claimed by a leg"; }
        else if claim.holder != a.holder || claim.token != a.token { why = "the lease on attempt " + a.attempt_id + " is " + claim.holder + "'s at token " + to_string(claim.token) + ", not " + a.holder + "'s at token " + to_string(a.token) + ": stale"; }
        else if claim.expires <= now { why = "the lease on attempt " + a.attempt_id + " expired at " + to_string(claim.expires); }
        else if self.claims.ready() {
            // memory's claim fences the lease, as it does an outcome's
            let live = self.claims.current(claim.key);
            if !self.claims.reachable { why = "memory cannot be reached to fence the lease on attempt " + a.attempt_id; }
            else if !live.present || live.holder != a.holder || live.token != a.token || live.expires <= now { why = "memory's claim on attempt " + a.attempt_id + " is not " + a.holder + "'s at token " + to_string(a.token) + " now: stale"; }
        }
        if len(why) > 0 { self.spending.allowance_refused(a, why); return; }
        let g = self.spend_gate(a.attempt_id, adm.value.request.cost_ceiling, a.request, a.holder, a.token, std::time::now());
        if !g.ok { self.board.notify("attempt", "attempt " + a.attempt_id + ": no spend admitted for " + a.holder + ": " + g.why); }
    }
    // A leg's outcome for the attempt it claimed, relayed from its
    // `attempt.outcome_requested` row. The lease is checked here as the
    // head checked it — the recorded claim, and memory's when there is
    // memory: this holder, this token, live — so a stale leg settles
    // nothing; the calls it made are journaled on the attempt; the runtime
    // settles the attempt as it settles every reply, or the refusal is a
    // row naming why. Either answers the request.
    @unbounded
    fn on_work_submit(s: WorkSubmission) {
        let moved = self.journal.refresh();
        if len(s.attempt_id) == 0 { return; }
        let adm = recorded_attempt_admission(self.journal, s.attempt_id, self.journal.revision());
        if !adm.ok || !owned_by(self.ownership.me, adm.value.task_id) { return; }
        if self.attempts.answered(s) { return; }
        let settled = recorded_attempt_outcome(self.journal, s.attempt_id, self.journal.revision());
        if settled.ok {
            // the outcome that settled it answers its own request; a second
            // outcome under the lease changes nothing, and says so as a row
            // that answers the request it came on, so the relay stops
            if settled.value.request == s.request { return; }
            self.refuse_submission(s, "duplicate: attempt " + s.attempt_id + " is settled (" + settled.value.disposition + "); this outcome changes nothing");
            return;
        }
        let claim = self.attempts.claim_of(s.attempt_id);
        // the lease is judged as of the head's admission (hardening, B3): a
        // relay that arrives after the lease ran out settles what was
        // handed back while it was live
        let now = if s.at > 0 { s.at } else { std::time::now() };
        let mut why = "";
        // only an attempt the leg relay answered is a leg's (GH #1158): one
        // the editor or a person holds settles on their word, never a leg's
        if !row_exists(self.journal, "effect.relayed", execution_key(s.attempt_id)) { why = "attempt " + s.attempt_id + " was never relayed to a leg; the organism performs it (" + self.work.identity_of(adm.value.performer_kind) + ")"; }
        else if !claim.present { why = "attempt " + s.attempt_id + " was never claimed by a leg"; }
        else if claim.holder != s.holder || claim.token != s.token { why = "the lease on attempt " + s.attempt_id + " is " + claim.holder + "'s at token " + to_string(claim.token) + ", not " + s.holder + "'s at token " + to_string(s.token) + ": stale"; }
        else if claim.expires <= now { why = "the lease on attempt " + s.attempt_id + " expired at " + to_string(claim.expires) + "; " + s.holder + " settles nothing on it"; }
        else if self.claims.ready() {
            let live = self.claims.current(claim.key);
            if !self.claims.reachable { why = "memory cannot be reached to fence the lease on attempt " + s.attempt_id; }
            else if !live.present || live.holder != s.holder || live.token != s.token || live.expires <= now { why = "memory's claim on attempt " + s.attempt_id + " is not " + s.holder + "'s at token " + to_string(s.token) + " now: stale"; }
        }
        if len(why) > 0 { self.refuse_submission(s, why); return; }
        // GH #1131: what a leg's calls cost is within what the spine granted
        // its lease — nothing, when it asked for nothing. Past it, the attempt
        // settles failed, naming the overrun, so the Work's allowance of
        // attempts bounds the repeats; the calls are journaled all the same,
        // for what was spent is spent
        let spent = spend_of(s.calls);
        let mut overrun = "";
        if spent.calls > 0 {
            let g = self.spending.granted_to(s.attempt_id, s.holder, s.token);
            overrun = if !g.ok && spent.cost_micros > 0 { "overrun: the calls cost " + to_string(spent.cost_micros) + " micro-dollars with no spend admitted for the lease (`hale dna work allowance` before the first call)" }
            else if g.ok && g.allowance_micros >= 0 && spent.cost_micros > g.allowance_micros { "overrun: the calls cost " + to_string(spent.cost_micros) + " micro-dollars, past the allowance of " + to_string(g.allowance_micros) + " granted to the lease" }
            else { "" };
        }
        let mut r = WorkResult {
            disposition: s.disposition, result: s.result, result_ref: s.result_ref, narrative: s.narrative, evidence: s.evidence_ref,
            performer: self.work.identity_of(adm.value.performer_kind), attempt_id: s.attempt_id,
            request: s.request, hat_digest: s.hat_digest, hat_head: s.hat_head, hat_watermark: s.hat_watermark, prompt_digest: s.prompt_digest, renderer: s.renderer
        };
        // GH #1156: a Patch Work's candidate is the organism's to review. The
        // leg's commit, by its own patch, is made a Mutation bound to the
        // attempt in the gateway — committed, verified and put to its Review
        // as the editor's is — and the attempt settles on what that made:
        // done once the candidate is prepared, failed when it could not be
        if len(overrun) > 0 {
            r.disposition = "failed";
            r.result = "";
            r.result_ref = "";
            r.narrative = overrun + " (the leg: " + s.narrative + ")";
        }
        if len(overrun) == 0 && adm.value.request.output_contract == "Patch" && s.disposition == "done" {
            let mut m = self.mutation_of_attempt(s.attempt_id);
            let mut interrupted = "interrupted before its candidate was prepared (the owner restarted)";
            if len(m) == 0 {
                let out = self.mutate_from_leg(attempt_request(adm.value), s, std::time::now());
                // the Mutation's request did not land: nothing proceeded, and the
                // relay asks again until the record answers
                if record_refused(out) { return; }
                m = self.mutation_of_attempt(s.attempt_id);
                interrupted = "left in flight: " + out;
            }
            if len(m) == 0 { self.refuse_submission(s, "no Mutation was bound to attempt " + s.attempt_id); return; }
            // a submission is handled whole, in turn: a Mutation still in flight
            // here was interrupted, and nothing else will finish it
            if len(self.prepared_result(m).disposition) == 0 { let failed = self.mutation_failed(m, interrupted); }
            let made = self.prepared_result(m);
            // the candidate is the bound Mutation's, whichever leg's lease
            // handed this outcome back
            let asked = self.row_body_of("mutation.requested", m);
            r.disposition = made.disposition;
            r.result = made.result + " from commit:" + std::json::find_string_field(asked, "leg_commit");
            r.result_ref = "commit:" + std::json::find_string_field(asked, "leg_commit");
            r.narrative = made.narrative + " (the leg: " + s.narrative + ")";
        }
        self.journal_calls(s.attempt_id, s.calls);
        let x = self.runtime.settle(s.attempt_id, r);
        if !x.ok { self.refuse_submission(s, x.why); return; }
        self.submissions_settled = self.submissions_settled + 1;
        if self.claims.ready() { let released = self.claims.release_claim(claim.key, s.holder); }
    }
    // An attempt's outcome, reported to the runtime of its scope (an edit
    // leaf's, card 15; a case's completion, card 17). A published report
    // is not a durable one: kept, once, until the record is seen to hold
    // the outcome — now, when the runtime settled it in place, or on the
    // next resume or redrive.
    @unbounded
    fn report_attempt(scope: String, attempt_id: String, result: WorkResult) {
        let r = AttemptReport { scope: scope, attempt_id: attempt_id, result: result };
        AttemptReported <- r;
        let moved = self.journal.refresh();
        self.attempts.keep(r);
    }
    // Every report the record has not been seen to hold is put again;
    // one it holds is released. The edit is never performed again: the
    // report is the validated outcome, re-persisted. How many were put.
    @unbounded
    fn retry_reports() -> Int {
        let moved = self.journal.refresh();
        let mut n = 0;
        let mut i = 0;
        while i < self.attempts.report_count() {
            let r = self.attempts.report_at(i);
            if len(r.attempt_id) > 0 {
                if row_exists(self.journal, "attempt.outcome", r.attempt_id) {
                    self.attempts.release_report(i);
                } else {
                    self.attempts.retried();
                    n = n + 1;
                    AttemptReported <- r;
                }
            }
            i = i + 1;
        }
        return n;
    }
    // The record is writable again: what it refused is put again, and
    // what waits is looked at again — a producer's held settlement lands
    // now too, and its end announces itself when it does.
    fn on_record_resumed(r: RecordResume) {
        let moved = self.journal.refresh();
        let n = self.retry_reports();
        let rows = self.retry_rows();
        let cases = self.revisit_cases();
        self.revisit_waiting();
    }
    // The disposition a Work settled on (`work.settled`), "" while it has
    // not.
    @unbounded
    fn settlement_of(work_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "work.settled" && e.entity == work_id {
                let o = decode_work_outcome(e.body);
                if o.ok { out = o.value.disposition; }
            }
            i = i + 1;
        }
        return out;
    }
    // The candidate a producing Work stands behind (card 15): the
    // Mutation bound (card 14) to the attempt its settlement accepted —
    // a first attempt that failed and was retried is not it. "" while
    // the Work has not settled, or its accepted attempt bound none.
    @unbounded
    fn candidate_of(work_id: String) -> String {
        if len(work_id) == 0 { return ""; }
        let n = self.journal.revision();
        let mut i = 0;
        let mut attempt = "";
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "work.settled" && e.entity == work_id {
                let o = decode_work_outcome(e.body);
                if o.ok { attempt = o.value.attempt_id; }
            }
            i = i + 1;
        }
        return self.mutation_of_attempt(attempt);
    }
    // The Mutation bound to an attempt (card 14), by the attempt's id in
    // the Mutation's own request row; "" when none.
    @unbounded
    fn mutation_of_attempt(attempt_id: String) -> String {
        if len(attempt_id) == 0 { return ""; }
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "mutation.requested" && decode_binding(e.body).attempt_id == attempt_id { return e.entity; }
            i = i + 1;
        }
        return "";
    }
    // Every waiting attempt is evaluated again from the durable state of
    // what it waits on (card 15): its producing Work's settlement, and
    // the review and application of that Work's accepted attempt's
    // candidate — prerequisites that land in either order, each landing
    // an occasion to look again. A producer settled other than done
    // fails its waiter: there is no candidate. Each waiter is answered
    // once, when its state is an outcome; the others keep waiting.
    @unbounded
    fn revisit_waiting() {
        if self.attempts.waiting_held() == 0 { return; }
        let moved = self.journal.refresh();
        let mut i = 0;
        while i < self.attempts.waiting_count() {
            let e = self.attempts.waiting_at(i);
            if len(e.attempt_id) > 0 {
                let producer = producer_of(e.request);
                let settled = self.settlement_of(producer);
                if len(settled) > 0 && settled != "done" {
                    self.attempts.waited(i);
                    self.report(e, "failed", producer + ": " + settled, "the producing Work settled " + settled + ": there is no candidate to wait on");
                } else {
                    let m = self.candidate_of(producer);
                    if len(m) > 0 && self.report_review(e, m) { self.attempts.waited(i); }
                }
            }
            i = i + 1;
        }
    }
    // A Work of the engine ended — settled, its row in the record: a
    // producer some attempt waits on may have settled. Looked at when
    // there is something waiting.
    fn on_run_life(l: RunLife) {
        if l.what == "dissolved" { self.revisit_waiting(); }
    }
    // Every responsibility the record refused to take (card 14) is driven
    // again: a held plan through `on_planned`, which finds its request
    // still pending; a held direct request through `on_work_requested`;
    // a held engine attempt (card 15) through `on_edit_requested`. One
    // round: what the record refuses again is held again, for the next.
    // How many were driven.
    // GH #946 hardening (D3): the leases that expired with no outcome,
    // each asked again through the runtime, in turn (the family's scan).
    @unbounded
    fn reopen_expired_claims() -> Int {
        let mut rest = self.attempts.expired(std::time::now(), self.ownership.me);
        let mut count = 0;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let attempt = tab_field(line, 0);
            self.attempts.reopening(attempt, tab_field(line, 1), tab_field(line, 2) == "1", tab_field(line, 3), tab_field(line, 4), tab_field(line, 5));
            let x = self.runtime.reopen(attempt);
            count = count + 1;
        }
        return count;
    }
    @unbounded
    fn redrive() -> Int {
        let moved = self.journal.refresh();
        let mut n = self.retry_reports();
        n = n + self.reopen_expired_claims();
        n = n + self.retry_rows();
        n = n + self.revisit_cases();
        self.revisit_waiting();
        let cases = self.cases.held_count();
        let mut h = 0;
        while h < cases {
            let c = self.cases.take_held(h);
            if len(c.attempt_id) > 0 {
                self.on_case_requested(c);
                n = n + 1;
            }
            h = h + 1;
        }
        let edits = self.attempts.held_count();
        let mut k = 0;
        while k < edits {
            let e = self.attempts.take_held(k);
            if len(e.attempt_id) > 0 {
                self.on_edit_requested(e);
                n = n + 1;
            }
            k = k + 1;
        }
        return n;
    }
    // Bounded by the humans offering intent; each birth is a Task the
    // Metabolism owns and settles.
    @unbounded
    fn on_intent(o: IntentOffer) {
        let mut from = o.from;
        if from == "" { from = "membrane"; }
        // Intent through the Board asks the organism to change: the
        // Task's Work is routed back to the assembly as source-editing
        // Work (GH #529 D7 steps 4-6).
        self.last_task = self.ask(Intent { id: o.intent_id, outcome: o.outcome, from: from, to: o.to, kind: o.kind });
    }
    // An uncertain exact append may have landed. Only its exact slot and
    // bytes establish that outcome; absence never becomes success.
    fn handoff_recorded(at: Int, kind: String, entity: String, document: String) -> Bool {
        let moved = self.journal.refresh();
        if at >= self.journal.revision() { return false; }
        let e = self.journal.read(at);
        return e.kind == kind && e.entity == entity && e.body == document;
    }
    // Who receives work planned for `who`: `who` while they work here,
    // else their successor's successor, and so on, to the first person
    // not retired; "" (unassigned) when the chain ends in a retirement
    // that named nobody, or comes back on itself (the second review of
    // #619: a successor who also retired still received the work).
    // Bounded by the retirements in the record.
    @unbounded
    fn admissible(who: String) -> String {
        let mut at = who;
        // Each distinct retired identity needs a Record row. More hops
        // than rows proves a cycle without splitting or normalizing names.
        let n = self.journal.revision();
        let mut hops = 0;
        while len(at) > 0 && hops <= n {
            let r = retirement(self.journal, at);
            if !r.retired { return at; }
            at = r.successor;
            hops = hops + 1;
        }
        return "";
    }
    // The last `task.<state>` journaled for an id ("" when only born).
    @unbounded
    fn task_state(task_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            // `task.resumed` is an event of a restart, not a state: a Task
            // resumed and not yet settled is still pending
            if e.entity == task_id && std::str::contains(e.kind, "task.") && e.kind != "task.born" && e.kind != "task.planned" && e.kind != "task.resumed" { out = e.kind[5..len(e.kind)]; }
            i = i + 1;
        }
        return out;
    }
    // Pressure is measured, journaled, and — when it persists — answered
    // with a PROPOSAL for an organ, never with one (GH #529 D7 extension
    // 4): growing is a Mutation like any other, asked for and reviewed.
    // A request is answered once (GH #986): the node relays a
    // `pressure.requested` row until the `pressure.raised` naming it is in
    // the record, so a redelivery finds its answer and counts nothing.
    @unbounded
    fn on_pressure(p: Pressure) {
        let a = self.concerns.pressure(p);
        if !a.proposed { return; }
        self.board.notify("appendage", p.source + ": " + p.what + " persists; an organ is proposed, not grown");
        // GH #566 F3: initiative — the proposal is a candidate commit to
        // the organization's own seed, verified like any change and
        // the Board's to decide (an `organization` change always is)
        if self.initiative {
            let out = self.mutate("pressure:" + p.source, "organization",
                "grow a position in main.hl for `" + p.what + "` (pressure from " + p.source + "): a dna::Leader beside the existing one, named for what it oversees, with `models: leader_models()` from the catalog", "", std::time::now());
            self.concerns.appendage_candidate(p.source, out);
        }
    }
    // GH #583 K2: a concern — a child's signal about the part above it
    // — is an execution of concern-escalate (GH #995): raised, routed to
    // its source's parent, and, when it persists from one source, a
    // knowledge proposal by that source bound to that parent for the
    // Board to ratify. A source with no parent has nothing to bind to and
    // is refused at the threshold, saying so.
    @unbounded
    fn on_concern(c: Concern) {
        let n = self.journal.revision();
        // the row this request already wrote, if it was delivered before
        let prior = self.concerns.prior(c);
        let mut already = prior.raised;
        let refused = prior.refused;
        // GH #689: a transport may deliver one request twice — the host
        // relays a row again while it stays unanswered, and an answer it
        // has not seen yet is enough to make that happen. One request is
        // one concern: the execution admitted for it is its answer, and the
        // count that turns concerns into a proposal counts distinct
        // requests, never redeliveries. Two distinct requests raising the
        // same words are still two concerns.
        let ask_id = if len(c.request) > 0 { "concern:" + c.source + ":" + c.request } else { "concern:" + c.source + "@" + to_string(n) };
        if len(already) == 0 && len(c.request) > 0 {
            let admitted = self.workflow_admission_of(ask_id, n);
            if len(admitted) > 0 {
                let x = self.recorded_admission(admitted).value.inputs;
                already = concern_body(std::json::find_string_field(x, "what"), std::json::find_int_field(x, "severity"), 0, c.request);
            }
        }
        if len(already) > 0 {
            if !same_concern(already, c.what, c.severity) && !refused {
                self.concerns.refuse_other(c);
            }
            return;
        }
        let t = self.run_workflow(WorkflowAsk { id: ask_id, definition: "concern-escalate", revision: self.catalog.latest("concern-escalate"), inputs: self.concerns.escalation(c) });
    }
    // A concern that persists: proposed as knowledge by its source,
    // bound to its parent (a concern by the tower rule), for the Board
    // to ratify. A source with no parent has nothing to bind to and is
    // refused, saying so. The raise that crosses the threshold takes
    // this path, and so does a restart that finds a source already over
    // it with no proposal (GH #748) — one rule, one place.
    fn propose_concern(source: String, what: String, seen: Int) {
        if !self.concerns.bindable(source) { return; }
        let parent = parent_path(source);
        let digest = self.propose_knowledge(Idea { id: "concern:" + source, kind: "concern", text: what, author: source }, parent);
        self.concerns.proposed(source, digest, seen);
        self.board.notify("concern", source + ": `" + what + "` persists; proposed as knowledge for " + parent + ", the Board's to ratify");
    }
    // A person proposes a practice for the whole organization (GH #602).
    // The proposal is the organization's — author `org`, an initiative the
    // tower rule binds to `org` — and the Board ratifies it through the
    // ordinary knowledge Review, and once decided an execution of
    // practice-ratify writes what follows (GH #995); who proposed it and
    // what prompted it stay on the `practice.proposed` row. Nothing is in
    // force until the Board approves it.
    @unbounded
    fn on_practice_requested(r: PracticeRequest) {
        let moved = self.journal.refresh();
        // GH #682: a request relayed again after a lost publish is answered once
        if self.practices.answered(r.request_id) { return; }
        if len(r.name) == 0 || len(r.text) == 0 {
            let x = self.practices.refused(r);
            return;
        }
        // The Body has actually received this request over the nerves.
        // Resume from this fact, never from an unverified incoming Record row:
        // the host owns signature checks before delivering those rows.
        if len(r.request_id) > 0 && !self.practices.started(r) { return; }
        let digest = self.propose_knowledge(Idea { id: "practice:" + r.name, kind: "practice", text: r.text, author: "org", name: r.name, supersedes: r.supersedes, provenance: "proposed by " + r.by }, "org");
        if len(digest) == 0 {
            // Storage failure is not a domain refusal. The admitted request
            // remains unanswered and resumes its missing stages on redelivery.
            return;
        }
        if !self.practices.proposed(r, digest) { return; }
        self.board.notify("practice", r.by + " proposes `" + r.name + "`: the Board's to ratify as " + knowledge_review_id(digest));
    }
    // GH #1143: a declaration asked of the organization, answered once:
    // the scheduler's, against the catalog and memory's graph.
    fn on_schedule_requested(r: ScheduleRequest) { self.scheduler.answer(r, self.catalog, self.knowledge_client); }
    // GH #1091: a holder proposed for a position, as the organization
    // proposes any hole — a graph proposal whose receipt carries the
    // `holds` edge, one Board Review of its own in the name of whoever
    // asked (who therefore may not ratify it). What a hold may be is the
    // projection's to check when it is ratified (the store is the gate);
    // here only its shape is. Answered once, however often it is relayed.
    @unbounded
    fn on_hold_requested(r: HoldRequest) {
        let moved = self.journal.refresh();
        let digest = self.positions.asked(r);
        if len(digest) == 0 { return; }
        let review_id = knowledge_review_id(digest);
        if !self.ensure_knowledge_review(review_id) { return; }
        if !self.positions.proposed(r, digest) { return; }
        self.board.notify("holds", r.by + " proposes " + r.holder + " for " + hold_name(r) + ": the Board's to ratify as " + review_id);
    }
    // A generic knowledge command carries the exact native document it means
    // to propose. Delivery is the host's trust boundary; the started row is
    // this Body's durable proof of delivery, not another incoming request.
    @unbounded
    fn on_knowledge_node_requested(r: KnowledgeNodeRequest) {
        let codec = KnowledgeNodeRequestCodec { };
        // An unrepresentable request cannot name a safe, correlated outcome.
        // The command admission layer rejects it before recording a request.
        if !codec.valid(r) { return; }
        let moved = self.journal.refresh();
        if !self.knowledge_record.node_fresh(r) { return; }
        self.bind_owner();
        // A different owner's request remains for that owner's Body. Neither
        // a delivery nor a restored started row grants cross-owner authority.
        if !self.ownership.admits(r.author) || !self.ownership.admits(r.target) { return; }
        if !self.knowledge_record.node_started(r) { return; }
        let digest = self.propose_knowledge(Idea {
            id: r.request_id, kind: r.kind, name: r.name, text: r.text,
            author: r.author, supersedes: r.supersedes, provenance: "proposed by " + r.by
        }, r.target);
        // An unavailable receipt or append is pending work, not a refusal.
        if digest != r.candidate_digest { return; }
        if !self.knowledge_record.node_proposed(r) { return; }
        self.board.notify("knowledge", r.by + " proposes " + r.kind + ": the Board's to ratify as " + knowledge_review_id(digest));
    }
    @unbounded
    fn ensure_binding_review(r: KnowledgeBindingRequest) -> Bool {
        let codec = KnowledgeBindingCodec { }; let id = codec.review_id(r.candidate_digest);
        if self.reviews.knowledge_known(id) { return true; }
        if !codec.valid(codec.request_of(self.journal, id)) { return false; }
        let settlement = first_row(self.journal, "review.settled", id);
        let outcome = if std::str::starts_with(settlement.body, "approve by ") { "approve" } else if std::str::starts_with(settlement.body, "reject by ") { "reject" } else if std::str::starts_with(settlement.body, "revise by ") { "revise" } else { "" };
        let need = self.review_routing(id, "practice-ratify", "", len(settlement.kind) == 0, true);
        if !need.recorded { return false; }
        Review { journal: self.review_journal, review_id: id, question: native_json_string(codec.review_request(r), "question"),
            subject_digest: r.candidate_digest, required_authority: "board", author: r.by, signers: need.signers, gates: need.gates, fallback: need.fallback, settled: len(settlement.kind) > 0, outcome: outcome };
        self.reviews.knowledge_born(id); return true;
    }
    @unbounded
    fn on_knowledge_binding_requested(r: KnowledgeBindingRequest) {
        let codec = KnowledgeBindingCodec { };
        if !codec.valid(r) { return; }
        let moved = self.journal.refresh();
        if !self.knowledge_record.binding_fresh(r) { return; }
        self.bind_owner();
        if !self.ownership.admits(r.author) || !self.ownership.admits(r.target) { return; }
        if !self.knowledge_record.binding_asked(r) || !self.ensure_binding_review(r) { return; }
        if !self.knowledge_record.binding_proposed(r) { return; }
        self.board.notify("knowledge", r.by + " proposes a binding change: the Board's to decide as " + codec.review_id(r.candidate_digest));
    }
    @unbounded
    fn resume_binding_result(review_id: String, outcome: String, reviewer: String, decision: String) -> Bool {
        let codec = KnowledgeBindingCodec { }; let r = codec.request_of(self.journal, review_id);
        if !codec.valid(r) || (outcome != "approve" && outcome != "reject" && outcome != "revise") { return false; }
        self.bind_owner(); if !self.ownership.admits(r.author) || !self.ownership.admits(r.target) { return false; }
        return self.knowledge_record.binding_result(r, review_id, outcome, reviewer, decision);
    }
    @unbounded
    fn ensure_edge_review(r: KnowledgeEdgeRequest) -> Bool {
        let codec = KnowledgeEdgeCodec { }; let id = codec.review_id(r.candidate_digest);
        if self.reviews.knowledge_known(id) { return true; }
        if !codec.valid(codec.request_of(self.journal, id)) { return false; }
        let settlement = first_row(self.journal, "review.settled", id);
        let outcome = if std::str::starts_with(settlement.body, "approve by ") { "approve" } else if std::str::starts_with(settlement.body, "reject by ") { "reject" } else if std::str::starts_with(settlement.body, "revise by ") { "revise" } else { "" };
        let need = self.review_routing(id, "practice-ratify", "", len(settlement.kind) == 0, true);
        if !need.recorded { return false; }
        Review { journal: self.review_journal, review_id: id, question: native_json_string(codec.review_request(r), "question"),
            subject_digest: r.candidate_digest, required_authority: "board", author: r.by, signers: need.signers, gates: need.gates, fallback: need.fallback, settled: len(settlement.kind) > 0, outcome: outcome };
        self.reviews.knowledge_born(id); return true;
    }
    @unbounded
    fn on_knowledge_edge_requested(r: KnowledgeEdgeRequest) {
        let codec = KnowledgeEdgeCodec { };
        if !codec.valid(r) { return; }
        let moved = self.journal.refresh();
        if !self.knowledge_record.edge_fresh(r) { return; }
        self.bind_owner();
        let endpoints = self.knowledge_record.edge_endpoints(r);
        if !endpoints.ok || !self.ownership.admits(endpoints.from_author) || !self.ownership.admits(endpoints.from_target)
            || !self.ownership.admits(endpoints.to_author) || !self.ownership.admits(endpoints.to_target) { return; }
        if !self.knowledge_record.edge_asked(r) || !self.ensure_edge_review(r) { return; }
        if !self.knowledge_record.edge_proposed(r) { return; }
        self.board.notify("knowledge", r.by + " proposes a relationship change: the Board's to decide as " + codec.review_id(r.candidate_digest));
    }
    @unbounded
    fn resume_edge_result(review_id: String, outcome: String, reviewer: String, decision: String) -> Bool {
        let codec = KnowledgeEdgeCodec { }; let r = codec.request_of(self.journal, review_id);
        if !codec.valid(r) || (outcome != "approve" && outcome != "reject" && outcome != "revise") { return false; }
        self.bind_owner(); let endpoints = self.knowledge_record.edge_endpoints(r);
        if !endpoints.ok || !self.ownership.admits(endpoints.from_author) || !self.ownership.admits(endpoints.from_target)
            || !self.ownership.admits(endpoints.to_author) || !self.ownership.admits(endpoints.to_target) { return false; }
        return self.knowledge_record.edge_result(r, review_id, outcome, reviewer, decision);
    }
    fn organization_source_owner(r: OrganizationSourceRequest) -> Bool {
        let codec = OrganizationSourceRequestCodec { };
        self.ownership.load(); self.bind_owner();
        if !codec.owner_token(r.source_owner) || r.source_owner != self.ownership.me { return false; }
        return !self.ownership.shared() || (len(r.source_owner) > 0 && word_in(r.source_owner, self.ownership.owners()));
    }
    @unbounded
    fn ensure_organization_source_review(r: OrganizationSourceRequest, candidate: String) -> Bool {
        let codec = OrganizationSourceRequestCodec { }; let id = codec.mutation_id(r);
        let req = codec.fact(self.journal, "review.requested", "review:" + id);
        let started = codec.fact(self.journal, "organization.source.started", r.request_id);
        let committed = codec.fact(self.journal, "mutation.candidate", id);
        if req.kind != "review.requested" || started.kind != "organization.source.started" || started.body != codec.started(r)
            || committed.kind != "mutation.candidate" || committed.body != candidate || committed.seq >= req.seq || started.seq >= committed.seq
            || !self.organization_source_owner(r) || !self.org_source.review_matches(r, candidate, req.body, self.gateway.workspaces.path_of(id)) { return false; }
        if self.reviews.source_known(id) { return true; }
        let settled = codec.fact(self.journal, "review.settled", id);
        if settled.kind == "invalid" { return false; }
        let outcome = if std::str::starts_with(settled.body, "approve by ") { "approve" } else if std::str::starts_with(settled.body, "reject by ") { "reject" } else if std::str::starts_with(settled.body, "revise by ") { "revise" } else { "" };
        let need = self.review_routing(id, "change-deliver", "", false, false);
        Review {
            journal: self.review_journal, review_id: id, question: native_json_string(req.body, "question"), subject_digest: candidate,
            signers: need.signers, gates: need.gates, fallback: need.fallback,
            organization_source_request: r, organization_source_facts: self.organization_source_review_facts,
            required_authority: native_json_string(req.body, "required_authority"), author: r.by,
            settled: len(outcome) > 0, outcome: outcome
        };
        self.reviews.source_born(id); return true;
    }
    // Only the tagged, strictly decoded incoming command can continue a
    // prepared-source Review. A generic mutation settlement or another caller's
    // approval cannot supply this command's authority or original application,
    // and the request is one this organization's owner holds.
    @unbounded
    fn organization_source_verdict(r: OrganizationSourceRequest, command_id: String) -> Verdict {
        let codec = OrganizationSourceRequestCodec { };
        if !codec.valid(r) || !self.organization_source_owner(r) { return Verdict { }; }
        return self.org_source.verdict(r, command_id, self.gateway.workspaces.path_of(codec.mutation_id(r)));
    }
    @unbounded
    fn resume_organization_source_verdict(command_id: String) -> Bool {
        let decision = review_command_decision(self.journal, command_id);
        let id = native_json_string(decision, "review_id"); let req = mutation_review_request(self.journal, id);
        let request_id = native_json_string(req, "organization_source_request_id");
        if len(request_id) == 0 { return false; }
        let r = self.org_source.request(request_id); let v = self.organization_source_verdict(r, command_id);
        if len(v.command_id) == 0 { return true; }
        if !self.reviews.decided(id, v.verdict, v.reviewer, v.comment) { return true; }
        if v.verdict == "approve" { let result = self.apply_reviewed(id, std::time::now()); return true; }
        // The fixed user candidate remains reachable for inspection; revise
        // records the native outcome and never starts a model rewrite.
        let recorded = append_once(self.journal, "mutation." + (if v.verdict == "revise" { "revise" } else { "rejected" }), id,
            "review " + v.verdict + " by " + v.reviewer + "; genome and expression untouched");
        return true;
    }
    // This is the prepared-source branch of the existing apply_reviewed gate.
    // The original native apply key and gateway remain authoritative. Claimed
    // effects are only reconciled by exact post-apply proof, never dispatched
    // again; a successful replay repairs the missing restart handoff.
    @unbounded
    fn apply_organization_source(id: String, now: Int) -> String {
        let codec = OrganizationSourceRequestCodec { }; let req = mutation_review_request(self.journal, id);
        let r = self.org_source.request(native_json_string(req, "organization_source_request_id"));
        if !codec.valid(r) || codec.mutation_id(r) != id { return "pending: exact prepared source unavailable"; }
        let mut v = Verdict { }; let mut i = 0;
        while i < self.journal.revision() {
            let e = self.journal.read(i);
            if e.kind == "review.command_decided" && native_json_string(e.body, "review_id") == id {
                let exact = self.organization_source_verdict(r, e.entity);
                if exact.verdict == "approve" { v = exact; }
            }
            i = i + 1;
        }
        if len(v.command_id) == 0 { return "pending: exact prepared source decision unavailable"; }
        let settled = codec.fact(self.journal, "review.settled", id);
        let decision = codec.fact(self.journal, "review.command_decided", v.command_id);
        if settled.kind != "review.settled" || settled.body != "approve by " + v.reviewer || settled.seq <= decision.seq { return "pending: exact prepared source settlement unavailable"; }
        let candidate = v.subject_digest; let wt = native_json_string(req, "worktree");
        let key = effect_key(r.source_owner, "apply", candidate);
        let st = effect_status(self.journal, key); let claim = codec.fact(self.journal, "effect.requested", key);
        let refused = codec.fact(self.journal, "mutation.refused", id);
        if len(refused.kind) > 0 {
            let code = native_json_string(refused.body, "reason_code");
            return if refused.kind == "mutation.refused" && refused.body == codec.apply_refused(r, v.command_id, candidate, code) { "refused: " + code } else { "pending: conflicting application refusal" };
        }
        let handoff = "apply " + candidate + " seed " + codec.seed() + " fitness " + native_json_string(req, "fitness_signals");
        if st.requested {
            if claim.kind != "effect.requested" || claim.body != id || claim.seq <= settled.seq { return "pending: conflicting application claim"; }
            if st.done && !st.ok && !st.unknown { return "failed: recorded native apply failed"; }
            let applied = codec.fact(self.journal, "mutation.applied", id);
            let handoff_fact = codec.fact(self.journal, "expression.restart_requested", id);
            if st.done && st.ok && applied.kind == "mutation.applied" && applied.body == candidate && applied.seq > claim.seq
                && handoff_fact.kind == "expression.restart_requested" && handoff_fact.body == handoff && handoff_fact.seq > applied.seq { return "applied (replayed)"; }
            let proof = self.org_source.applied(r, wt, candidate);
            if !proof.ok { return "unknown: exact prepared source application is not proved"; }
        } else {
            if !self.org_source.apply_available() { return "pending: source application proof composition unavailable"; }
            if self.deployment.kind() != "none" { return self.org_source.apply_refusal(r, v.command_id, candidate, "organization_deployment_unsupported"); }
            let current = self.org_source.current(r);
            if !current.ok { return self.org_source.apply_refusal(r, v.command_id, candidate, current.code); }
            let checked = self.org_source.candidate(r, wt, candidate);
            if !checked.ok { return self.org_source.apply_refusal(r, v.command_id, candidate, checked.code); }
            if len(self.gateway.dirty(codec.seed(), wt)) > 0 { return self.org_source.apply_refusal(r, v.command_id, candidate, "stale_subject"); }
            let lease = self.gateway.take(id, "dna", now);
            let result = self.gateway.apply(self.journal, id, candidate, lease.token, now);
            if !result.ok {
                let moved = self.journal.refresh(); let status = effect_status(self.journal, key);
                return if status.requested && status.done && !status.ok && !status.unknown { "failed: recorded native apply failed" } else { "pending: native apply outcome unavailable" };
            }
            let proof = self.org_source.applied(r, wt, candidate);
            if !proof.ok { return "unknown: exact prepared source application is not proved"; }
        }
        // No external operation below. Repair only the acknowledgments supported
        // by the same strict candidate/destination proof and native lease.
        let lease = self.gateway.take(id, "dna", now);
        if !lease_fences(self.gateway.leases, self.gateway.lease_key(id), lease.token, now) { return "pending: application recovery lease unavailable"; }
        let refreshed = self.journal.refresh(); let status = effect_status(self.journal, key);
        if !status.requested || (status.done && !status.ok && !status.unknown) { return "pending: application claim unavailable"; }
        if !(status.done && status.ok) {
            let fixed = self.journal.append_exact(self.journal.revision(), "effect.result", key, "ok (exact prepared source application recovered)");
            if !fixed.ok { return "pending: application result acknowledgment"; }
        }
        if !append_once(self.journal, "mutation.applied", id, candidate) { return "pending: application acknowledgment"; }
        if !append_once(self.journal, "expression.restart_requested", id, handoff) { return "pending: restart handoff acknowledgment"; }
        return "applied";
    }
    @unbounded
    fn on_organization_source_requested(t: OrganizationSourceTrigger) {
        let refreshed = self.journal.refresh(); let codec = OrganizationSourceRequestCodec { };
        let r = self.org_source.admitted(t.request_id);
        if !codec.valid(r) || !self.organization_source_owner(r) { return; }
        if !self.org_source.started(r) { return; }
        let resumed = self.resume_organization_source(r.request_id, std::time::now());
    }
    // Only a started proof from trusted delivery can reach this path. All
    // recovery is under the original request and deterministic mutation ID.
    fn resume_organization_source(request_id: String, now: Int) -> Bool {
        let refreshed = self.journal.refresh(); let codec = OrganizationSourceRequestCodec { };
        let r = self.org_source.request(request_id);
        if !codec.valid(r) || !self.organization_source_owner(r) { return false; }
        let id = codec.mutation_id(r);
        let proposed = codec.fact(self.journal, "organization.source.proposed", request_id);
        if len(proposed.kind) > 0 {
            let candidate = native_json_string(proposed.body, "candidate_commit");
            return proposed.kind == "organization.source.proposed" && proposed.body == codec.proposed(r, candidate) && self.ensure_organization_source_review(r, candidate);
        }
        if len(codec.fact(self.journal, "organization.source.refused", request_id).kind) > 0 || len(codec.fact(self.journal, "organization.source.failed", request_id).kind) > 0 { return false; }
        let reviewed = codec.fact(self.journal, "review.requested", "review:" + id);
        if len(reviewed.kind) > 0 {
            let candidate = native_json_string(reviewed.body, "candidate_commit");
            if !self.ensure_organization_source_review(r, candidate) { return false; }
            return self.org_source.proposed(r, candidate);
        }
        let current = self.org_source.current(r);
        if !current.ok { let refused = self.org_source.refusal(r, "source", current); return false; }
        if !self.review_policy.blocking("organization") {
            let refused = self.org_source.review_refused(r); return false;
        }
        if !append_once(self.journal, "mutation.proposed", id, "prepared organization source " + request_id + " at " + r.source_head) { return false; }
        let lease = self.gateway.take(id, "dna", now);
        let opened = self.gateway.open(self.journal, id, r.source_head, lease.token, now);
        if !opened.ok { return false; }
        let worktree = opened.value; let key = "commit:" + id + ":prepared-source";
        let previous = effect_status(self.journal, key);
        let mut candidate = "";
        if previous.requested {
            // Never recommit after an ambiguous reply. The guard proves the
            // complete exact candidate before the gateway repairs only its ack.
            candidate = self.gateway.head_of(worktree);
            if candidate == r.source_head || len(candidate) == 0 { return false; }
            let checked = self.org_source.candidate(r, worktree, candidate);
            if !checked.ok { let refused = self.org_source.refusal(r, "candidate", checked); return false; }
            let recovered = self.gateway.recover_prepared_commit(self.journal, id, "prepared-source", candidate, codec.candidate_key(r), lease.token, std::time::now());
            if !recovered.ok { return false; }
        } else {
            let materialize_key = "organization.source.materialize:" + id;
            let claim = effect_request(self.journal, materialize_key, digest_of(codec.canonical(r)));
            let status = effect_status(self.journal, materialize_key);
            if (!claim && !status.requested) || (status.done && !status.ok && !status.unknown) { return false; }
            // This stage has only idempotent owned-worktree writes. Its guard
            // always verifies the base and all exact bytes before committing.
            let prepared = self.org_source.materialize(r, worktree);
            if !prepared.ok { let refused = self.org_source.refusal(r, "materialize", prepared); return false; }
            if !status.done { let completed = effect_result(self.journal, materialize_key, true); if !completed { return false; } }
            else if status.unknown {
                let completed = self.journal.append_exact(self.journal.revision(), "effect.result", materialize_key, "ok (exact owned materialization recovered)");
                if !completed.ok { return false; }
            }
            let same = self.org_source.current(r);
            if !same.ok { let refused = self.org_source.refusal(r, "source", same); return false; }
            let committed = self.gateway.commit_prepared(self.journal, id, "prepared-source", "organization source " + id, codec.candidate_key(r), lease.token, std::time::now());
            if !committed.ok { return false; }
            candidate = committed.value;
        }
        let checked = self.org_source.candidate(r, worktree, candidate);
        if !checked.ok { let refused = self.org_source.refusal(r, "candidate", checked); return false; }
        let recovered = self.gateway.recover_prepared_commit(self.journal, id, "prepared-source", candidate, codec.candidate_key(r), lease.token, std::time::now());
        if !recovered.ok || len(checked.base_topology) == 0 { return false; }
        let m = Mutation { id: id, base_commit: r.source_head, worktree: worktree, candidate_commit: candidate, candidate_digest: candidate,
            change_class: "organization", seed: codec.seed(), rationale: r.rationale, disposition: "proposed" };
        let report = self.verification.verify(self.journal, m, checked.base_topology);
        if !self.org_source.verified(m, report) { return false; }
        if !report.evidence.check_clean || !report.evidence.fleet_clean {
            return self.org_source.failed(r);
        }
        let after = self.org_source.candidate(r, worktree, candidate);
        if !after.ok { let refused = self.org_source.refusal(r, "candidate", after); return false; }
        let destination = self.org_source.current(r);
        if !destination.ok { let refused = self.org_source.refusal(r, "source", destination); return false; }
        let disposition = self.review_mutation_mode(m, report, r.by, r);
        if disposition != "review" || !self.ensure_organization_source_review(r, candidate) { return false; }
        return self.org_source.proposed(r, candidate);
    }
    // Resume only work this Body already received, never new incoming Record
    // requests. The host owns trust verification and trigger redelivery.
    // Decided commands continue independently after the host stops relaying.
    @unbounded
    fn reconcile_governance() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "organization.source.started" { let resumed = self.resume_organization_source(e.entity, std::time::now()); }
            if e.kind == "practice.started" && len(e.entity) > 0 && native_json_string(e.body, "request_id") == e.entity {
                self.on_practice_requested(PracticeRequest {
                    request_id: e.entity,
                    name: native_json_string(e.body, "name"),
                    text: native_json_string(e.body, "text"),
                    by: native_json_string(e.body, "by"),
                    because: native_json_string(e.body, "because"),
                    supersedes: native_json_string(e.body, "supersedes")
                });
            }
            if e.kind == "knowledge.node.started" {
                let codec = KnowledgeNodeRequestCodec { };
                let request = codec.decode(e.body);
                if e.entity == request.request_id && codec.valid(request) && e.body == codec.started(request) {
                    self.on_knowledge_node_requested(request);
                }
            }
            if e.kind == "knowledge.binding.started" {
                let codec = KnowledgeBindingCodec { }; let request = codec.decode(e.body);
                if e.entity == request.request_id && codec.valid(request) && e.body == codec.started(request) { self.on_knowledge_binding_requested(request); }
            }
            if e.kind == "knowledge.edge.started" {
                let codec = KnowledgeEdgeCodec { }; let request = codec.decode(e.body);
                if e.entity == request.request_id && codec.valid(request) && e.body == codec.started(request) { self.on_knowledge_edge_requested(request); }
            }
            if e.kind == "review.command_decided" { self.resume_review_command(e.entity); }
            if e.kind == "review.settled" {
                let codec = KnowledgeBindingCodec { }; let request = codec.request_of(self.journal, e.entity);
                if codec.valid(request) {
                    let outcome = if std::str::starts_with(e.body, "approve by ") { "approve" } else if std::str::starts_with(e.body, "reject by ") { "reject" } else if std::str::starts_with(e.body, "revise by ") { "revise" } else { "" };
                    if len(outcome) > 0 {
                        // A command-specific decision is resumed by its own row.
                        // Legacy native settlement has no command identity.
                        let mut decision = ""; let mut k = 0;
                        while k < self.journal.revision() {
                            let d = self.journal.read(k);
                            if d.kind == "review.command_decided" && native_json_string(d.body, "review_id") == e.entity && std::json::find_bool_field(d.body, "accepted") && std::json::find_bool_field(d.body, "settled") { decision = d.entity; }
                            k = k + 1;
                        }
                        let resumed = self.resume_binding_result(e.entity, outcome, e.body[(len(outcome) + 4)..len(e.body)], decision);
                    }
                }
            }
            if e.kind == "review.settled" {
                let codec = KnowledgeEdgeCodec { }; let request = codec.request_of(self.journal, e.entity);
                if codec.valid(request) {
                    let outcome = if std::str::starts_with(e.body, "approve by ") { "approve" } else if std::str::starts_with(e.body, "reject by ") { "reject" } else if std::str::starts_with(e.body, "revise by ") { "revise" } else { "" };
                    if len(outcome) > 0 {
                        // A command-specific decision is resumed by its own row.
                        // Legacy native settlement has no command identity.
                        let mut decision = ""; let mut k = 0;
                        while k < self.journal.revision() {
                            let d = self.journal.read(k);
                            if d.kind == "review.command_decided" && native_json_string(d.body, "review_id") == e.entity && std::json::find_bool_field(d.body, "accepted") && std::json::find_bool_field(d.body, "settled") { decision = d.entity; }
                            k = k + 1;
                        }
                        let resumed = self.resume_edge_result(e.entity, outcome, e.body[(len(outcome) + 4)..len(e.body)], decision);
                    }
                }
            }
            // GH #995: a verdict whose ratification never ran is ratified
            // through practice-ratify, as a fresh one is
            if e.kind == "review.settled" && !self.practices.ratified(e.entity) && len(verdict_outcome(e.body)) > 0 {
                // a Review that is no knowledge proposal's is never asked again
                if len(self.knowledge_record.request_of(e.entity)) > 0 { self.ratify_through(e.entity); } else { self.practices.ratified_now(e.entity); }
            }
            i = i + 1;
        }
        self.revisit_steps(true);
    }
    // Intent enters through the Board and births a durable Task;
    // its birth and its settlement are Journal events (the causal
    // authority), the live locus is the expression.
    @unbounded
    fn ask(i: Intent) -> String {
        // GH #682: an intent offered twice — a head's publish and the host's
        // relay of the same durable row, or a re-delivery after a publish
        // that was lost — is admitted once: the execution admitted for it
        // answers again (the admission carries the ask's own identity)
        let again = self.workflow_admission_of(i.id, self.journal.revision());
        if len(again) > 0 { return again; }
        // and one whose leader's word is still out is in planning: offered
        // again meanwhile it is neither gated nor journaled a second time
        if self.in_planning(i.id) { return "planning"; }
        let gate = self.board.offer(i);
        if gate != "accepted" {
            let x = self.journal.append(self.journal.revision(), "intent.refused", i.id, gate);
            return gate;
        }
        self.bind_owner();
        // GH #664: over a shared record, only the owner of the position the
        // intent is for admits it; an offer that reached the wrong body is
        // refused by name, so the asker takes it to the record instead
        if !self.ownership.admits(i.to) {
            let why = "refused: not this organization's to admit — " + self.ownership.why_not(i.to);
            let x = self.journal.append(self.journal.revision(), "intent.refused", i.id, why);
            return why;
        }
        // GH #583 M1: no model-backed work is routed on an exhausted budget
        let now = std::time::now();
        if self.budget_exhausted(now) {
            let why = "refused: budget exhausted (" + self.budget.describe(now) + ")";
            let x = self.journal.append(self.journal.revision(), "intent.refused", i.id, why);
            return why;
        }
        // GH #1026: the ask is claimed before it is planned — a model call
        // is spend. Of the nodes offered it, the one whose claim lands
        // plans it; the others leave it to that node, and are offered it
        // again (the host relays an unanswered ask) until it is answered
        // or that node's claim expires.
        let key = "plan/" + i.id;
        if self.planned {
            if !self.take_claim(key, self.claim_ttl) {
                if !self.claims.reachable { return "not planned: memory could not be reached to claim " + key + " (" + self.claims.last_error + "); it is offered again"; }
                return "planning elsewhere: " + self.claims.holder_of(key) + " holds " + key;
            }
            // claimed, then read: the node that held it before may have
            // admitted the ask and given the claim back since this node's
            // view of the record was read
            let moved = self.journal.refresh();
            let done = self.workflow_admission_of(i.id, self.journal.revision());
            if len(done) > 0 { self.give_up_claim(key, false); return done; }
            self.note_claim(key);
        }
        self.asked = self.asked + 1;
        // The row names who asked: the person a head identified, a schedule,
        // an optimizer — the body writes the row, so the asker is in its body.
        // A node that takes an ask over from one that died does not offer it
        // a second time.
        if !row_exists(self.journal, "intent.offered", i.id) {
            let offered_body = if i.from == "" { i.outcome } else { i.outcome + " (from " + i.from + ")" };
            let born = self.journal.append(self.journal.revision(), "intent.offered", i.id, offered_body);
            if !born.ok { return "refused: journal " + born.error; }
        }
        // card 18 (GH #596 L): in an organism the leader plans for, the
        // leader says what the ask is before it is admitted — a person's
        // job, an organism change, an application change — and the
        // admission binds that word; without a leader the ask is an
        // application change, as before
        // an ask for a judgment is the asker's word: no plan is asked, the
        // assessment is admitted as one judgment leaf, a leg's to perform
        if i.kind == "judgment" { return self.admit_ask(i, Plan { kind: "judgment", change_class: "application" }, false); }
        if self.planned {
            // the intent is this resident's to keep: what a handler's arena
            // handed in dies with the handler
            self.pending_asks.push(Intent { id: std::str::clone(i.id), outcome: std::str::clone(i.outcome), from: std::str::clone(i.from), to: std::str::clone(i.to) });
            PlanRequested <- PlanRequest { org: self.org_id, task_id: i.id, work_id: "ask", objective: i.outcome, target: "", requires: "edit", data_class: "internal" };
            return "planning";
        }
        return self.admit_ask(i, Plan { kind: "app", change_class: "application" }, false);
    }
    // Whether an ask is awaiting the leader's word.
    @unbounded
    fn in_planning(intent_id: String) -> Bool {
        let mut i = 0;
        while i < self.pending_asks.len() {
            let p = self.pending_asks.get(i) or Intent { };
            if len(p.id) > 0 && p.id == intent_id { return true; }
            i = i + 1;
        }
        return false;
    }
    // The ask admitted under the leader's word (or none): a person's job
    // is a one-leaf workflow for a person, anything else a one-leaf
    // workflow for the editor, the word bound into the admission's
    // inputs — the class, the target, whom, under what obligation — so
    // the leaf that runs it reads the same plan after any restart, and
    // nothing is planned twice. An organization change for a child that
    // is not the organism is refused before anything is admitted. The
    // leader's word (`planned`) is honoured as the legacy path honoured
    // it: a person's job by its kind, whatever the class line said; an
    // answer that named no kind and no class leaves the defaults standing
    // (`parsed` false), and the admission says so.
    fn admit_ask(i: Intent, p: Plan, planned: Bool) -> String {
        let class = if p.kind == "organism" { "organization" } else if len(p.change_class) > 0 { p.change_class } else { "application" };
        if planned && p.kind != "organism" && p.kind != "person" && class == "organization" {
            let why = "refused: plan names an organization change for a child that is not the organism (kind " + p.kind + ")";
            let z = self.journal.append(self.journal.revision(), "intent.refused", i.id, why);
            return why;
        }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("objective", i.outcome);
        b.string_field("from", i.from);
        b.string_field("kind", if i.kind == "judgment" { "judgment" } else if planned { p.kind } else { "app" });
        b.string_field("class", class);
        b.string_field("target", p.target);
        b.string_field("assignee", p.assignee);
        b.string_field("obligation", p.obligation);
        b.string_field("narrative", p.narrative);
        b.string_field("package", p.package);
        b.string_field("by", if planned { p.by } else { "" });
        b.bool_field("planned", planned);
        b.bool_field("parsed", planned && p.parsed);
        b.end_object();
        let definition = if i.kind == "judgment" { "ask-judge" } else if planned && p.kind == "person" { "ask-person" } else { "ask-edit" };
        return self.run_workflow(WorkflowAsk { id: i.id, definition: definition, revision: self.catalog.latest(definition), inputs: b.result(), from: i.from, to: i.to });
    }
    // The authored-definition API (card 18): a workflow the application
    // defined (card 04), admitted (card 07) and started in the one engine
    // of this scope. The id, or why not.
    fn run_workflow(a: WorkflowAsk) -> String {
        let id = self.admit_workflow(a);
        if std::str::starts_with(id, "refused") || len(id) == 0 { return id; }
        self.start_execution(id);
        return id;
    }
    // An admitted root asked of the engine, with the performer kind of
    // every leaf the recipe bound: an edit leaf's is the editor, a person's
    // the human performer, any other the routing policy's choice for it.
    // A restart asks again for every admitted root not yet settled (card
    // 13: the engine restores it from its admission).
    fn start_execution(task_id: String) {
        self.executions_asked = self.executions_asked + 1;
        ExecutionAsked <- ExecutionAsk { scope: self.org_id, task_id: task_id, kinds: self.kinds_of(task_id) };
    }
    // "<work id>=<kind>" per leaf of the whole bound tree — the root's
    // workflow and every child's — space-separated: the kind is named for
    // the exact Work (its bound id), never for a key, which two Works of
    // different steps or workflows may share. The selection request is
    // the Work's own, under the Task that owns it.
    @unbounded
    fn kinds_of(task_id: String) -> String {
        let adm = self.recorded_admission(task_id);
        if !adm.ok { return ""; }
        let gap = self.catalog.decode_bound(adm.value.recipe);
        if len(gap) > 0 { return ""; }
        let mut out = "";
        let mut i = 0;
        while i < self.catalog.bound.len() {
            let n = self.catalog.bound.get(i) or BoundNode { };
            if n.kind == "work" {
                let req = bound_request(n, self.task_of_bound(n), n.parent);
                let kind = if std::str::contains(n.requires, "organism") { "organism" }
                else if std::str::contains(n.requires, "edit") { "edit" }
                else if std::str::contains(n.requires, "human") || std::str::contains(n.requires, "person") { "human" }
                else { self.work.selection.select(req, 0, "") };
                out = out + (if len(out) > 0 { " " } else { "" }) + n.id + "=" + kind;
            }
            i = i + 1;
        }
        return out;
    }
    // The Task a bound Work belongs to: its Step's Task, as the recipe binds
    // them ("" when the recipe does not hold the Step).
    @unbounded
    fn task_of_bound(w: BoundNode) -> String {
        let mut i = 0;
        while i < self.catalog.bound.len() {
            let n = self.catalog.bound.get(i) or BoundNode { };
            if n.kind == "step" && n.id == w.parent { return n.parent; }
            i = i + 1;
        }
        return "";
    }
    // The admission of a Task, decoded; not ok when none.
    @unbounded
    fn recorded_admission(task_id: String) -> DecodedAdmission {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "workflow.admitted" && e.entity == task_id { return decode_admission(e.body); }
            i = i + 1;
        }
        return DecodedAdmission { };
    }
    // The leader's word bound into an ask's admission (card 18), read
    // back as the plan the leaf runs under; `parsed` false when the ask
    // was not planned, or the Task is not an ask's.
    fn ask_plan_of(task_id: String) -> Plan {
        let adm = self.recorded_admission(task_id);
        if !adm.ok || len(adm.value.inputs) == 0 { return Plan { }; }
        let x = adm.value.inputs;
        return Plan {
            org: self.org_id, task_id: task_id, work_id: "ask",
            kind: std::json::find_string_field(x, "kind"), change_class: std::json::find_string_field(x, "class"),
            target: std::json::find_string_field(x, "target"), assignee: std::json::find_string_field(x, "assignee"),
            obligation: std::json::find_string_field(x, "obligation"), narrative: std::json::find_string_field(x, "narrative"),
            package: std::json::find_string_field(x, "package"), by: std::json::find_string_field(x, "by"),
            parsed: std::str::trim(std::json::find_field_raw(x, "planned")) == "true"
        };
    }
    // Every admitted root of this owner's that is not finished is asked
    // of the engine again after a restart; the engine restores each from
    // its admission and the record's facts (card 13). Finished is
    // settled AND drained: a cancelled root settles before its admitted
    // Works have, and the engine's recovery (cards 12a, 13) is what
    // drains them — so a settled root with a Work of its tree still
    // owed a settlement is asked for again, and a drained record is
    // asked for nothing and written nothing.
    @unbounded
    fn resume_executions() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "workflow.admitted" && owned_by(self.ownership.me, e.entity) {
                let a = decode_admission(e.body);
                if a.ok && len(a.value.parent_task) == 0 && (!row_exists(self.journal, "workflow.settled", e.entity) || !self.drained(e.entity)) { self.start_execution(e.entity); }
            }
            i = i + 1;
        }
    }
    // Whether every responsibility of a root's tree has settled: every
    // Work — its own workflow's and every child's, found by their
    // admissions' `parent_task` — that admitted an attempt, and every
    // admitted child itself. Bounded by the record.
    @unbounded
    fn drained(root: String) -> Bool {
        let n = self.journal.revision();
        // the tasks of the tree: the root and every admission under it
        let mut tasks = " " + root + " ";
        let mut grew = true;
        while grew {
            grew = false;
            let mut i = 0;
            while i < n {
                let e = self.journal.read(i);
                if e.kind == "workflow.admitted" && !std::str::contains(tasks, " " + e.entity + " ") {
                    let parent = std::json::find_string_field(e.body, "parent_task");
                    if len(parent) > 0 && std::str::contains(tasks, " " + parent + " ") { tasks = tasks + e.entity + " "; grew = true; }
                }
                i = i + 1;
            }
        }
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "attempt.admitted" {
                let a = decode_attempt(e.body);
                if a.ok && std::str::contains(tasks, " " + a.value.task_id + " ") && !row_exists(self.journal, "work.settled", a.value.work_id) { return false; }
            }
            // an admitted descendant is a responsibility of its own until it
            // settles — before its first attempt, or after its last Work did
            if e.kind == "workflow.admitted" && e.entity != root && std::str::contains(tasks, " " + e.entity + " ") && !row_exists(self.journal, "workflow.settled", e.entity) { return false; }
            i = i + 1;
        }
        return true;
    }
    // A root's workflow settled: the ask is answered as far as the
    // organism goes; the Board hears it.
    fn on_workflow_settled(w: WorkflowSettlement) {
        self.executions_settled = self.executions_settled + 1;
        self.board.notify("task", w.task_id + " settled " + w.disposition + (if len(w.reason) > 0 { ": " + w.reason } else { "" }));
    }
    // ---- GH #995: the catalog's steps, performed by the organization ------
    //
    // A step of a baseline definition the organization performs itself
    // (`requires: "organism"`), relayed by the engine's organism performer:
    // the definition and the inputs are the admission's of the step's Task,
    // the step is the Work's member key. A step ensures its rows — asked
    // again after a redelivery it writes none twice — and reports done or
    // failed; one that waits (a verdict, the leader's word, memory's
    // projection) is kept and performed again when what it waits on may
    // have arrived: a verdict, the leader's answer, the tick.
    @unbounded
    fn on_step_requested(s: StepAsk) {
        let moved = self.journal.refresh();
        self.attempts.release_recorded();
        if last_segment(s.request.work_id) == "hat" { self.memory_ready = self.knowledge_client.caught_up(self.journal.revision()); }
        if !self.perform_step(s) { self.steps.wait(s); }
    }
    // Every waiting step performed again; those that reported leave the
    // list, which empties when none waits.
    @unbounded
    // `on_tick` revisits the steps that wait on memory too, asking memory
    // once whether its projection caught up; a verdict or an answer
    // revisits the others, never blocking on memory.
    fn revisit_steps(on_tick: Bool) {
        if on_tick { self.memory_ready = self.knowledge_client.caught_up(self.journal.revision()); }
        let mut left = 0;
        let mut i = 0;
        while i < self.steps.count() {
            let w = self.steps.at(i);
            if len(w.attempt_id) > 0 && !on_tick && last_segment(w.request.work_id) == "hat" { left = left + 1; }
            else if len(w.attempt_id) > 0 {
                if self.perform_step(w) { self.steps.done(i); } else { left = left + 1; }
            }
            i = i + 1;
        }
        self.steps.walked(left);
    }
    // Perform one step; whether its outcome was reported.
    @unbounded
    fn perform_step(s: StepAsk) -> Bool {
        if row_exists(self.journal, "attempt.outcome", s.attempt_id) || self.attempts.reported(s.attempt_id) { return true; }
        let task = s.request.task_id;
        let adm = self.recorded_admission(task);
        if !adm.ok { return self.step_report(s, step_failed("no admission for task " + task)); }
        let definition = adm.value.definition;
        let key = last_segment(s.request.work_id);
        let x = adm.value.inputs;
        let out = if definition == "practice-ratify" { self.practice_step(task, key, x) }
        else if definition == "concern-escalate" { self.concern_step(task, key, x) }
        else if definition == "optimize-walk" { self.optimize_step(task, key, x) }
        else { step_failed("the organization performs no step " + definition + "/" + key) };
        if len(out.disposition) == 0 { return false; }
        return self.step_report(s, out);
    }
    fn step_report(s: StepAsk, out: StepVerdict) -> Bool {
        self.report_attempt(s.scope, s.attempt_id, WorkResult { disposition: out.disposition, result: out.result, narrative: out.narrative, performer: s.performer, attempt_id: s.attempt_id });
        return true;
    }
    // A verdict on a knowledge proposal: ratified through practice-ratify.
    // Whoever proposed it — a person's request, a concern, the record's
    // birth — the Board's decision is admitted as one execution, once,
    // whose steps write the ratification and what the hat reads.
    @unbounded
    fn ratify_through(review_id: String) {
        // each Review once per incarnation, once its execution exists: a
        // reconciliation walks every settled one at every tick, and the
        // scans below are the record's
        if self.practices.ratified(review_id) { return; }
        let digest = native_json_string(self.knowledge_record.request_of(review_id), "knowledge_digest");
        if len(digest) == 0 { return; }
        if len(self.practices.ratification_of(digest)) > 0 { self.practices.ratified_now(review_id); return; }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("digest", digest);
        b.string_field("review_id", review_id);
        b.end_object();
        let t = self.run_workflow(WorkflowAsk { id: "ratify:" + digest, definition: "practice-ratify", revision: self.catalog.latest("practice-ratify"), inputs: b.result() });
        // an answer is the Review's for this incarnation, a refusal too: the
        // refusal is a `workflow.refused` row naming the request, written
        // once, and a restart (a catalog fixed in between) asks again,
        // never every tick
        if len(t) > 0 {
            self.practices.ratified_now(review_id);
            if std::str::starts_with(t, "refused") { eprintln("organization: the ratification of ", review_id, " was ", t); }
        }
    }
    // GH #1143: the schedule a ratified practice carries (its receipt's
    // `schedule`, a JSON object as text), declared; "" when it carries none
    // or it was declared, else why not.
    @unbounded
    fn declare_practice_schedule(digest: String) -> String {
        let raw = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
        let doc = self.verification.receipts.read(raw);
        let sched = std::json::find_string_field(doc, "schedule");
        if len(sched) == 0 { return ""; }
        return self.scheduler.declare(Schedule {
            id: std::json::find_string_field(sched, "id"),
            every_ms: std::json::find_int_field(sched, "every_ms"),
            cron: std::json::find_string_field(sched, "cron"),
            definition: std::json::find_string_field(sched, "definition"),
            args: if len(std::json::find_string_field(sched, "args")) > 0 { std::json::find_string_field(sched, "args") } else { "{}" },
            convener: std::json::find_string_field(sched, "convener")
        }, self.catalog, self.knowledge_client);
    }
    @unbounded
    fn practice_step(task: String, key: String, x: String) -> StepVerdict {
        let digest = std::json::find_string_field(x, "digest");
        if len(digest) == 0 { return step_failed("practice-ratify names no proposal"); }
        let review_id = knowledge_review_id(digest);
        if key == "ratify" {
            let settled = first_row(self.journal, "review.settled", review_id);
            let outcome = verdict_outcome(settled.body);
            if len(outcome) == 0 { return step_waits(); }
            let by = verdict_by(settled.body);
            // the verdict binds this digest: approved, the ratification (and
            // the retirement of what it supersedes); otherwise the decline
            // done only when the whole consequence landed — the ratification
            // AND the retirement of what it supersedes; a write the record
            // refused leaves the step waiting, to be written again
            let r = self.knowledge_record.resume_result(review_id, outcome, by);
            if outcome == "approve" && r && self.knowledge_record.ratified(digest) {
                // GH #1143: a practice that carries a schedule declares it once
                // ratified — the cadence is the practice's, amended by the
                // next. The ratification stands either way: a refused
                // schedule is its own row (`schedule.refused`, naming the
                // hole), not a failed ratification
                let why = self.declare_practice_schedule(digest);
                if len(why) > 0 { return step_done(digest, "ratified by " + by + "; its schedule was refused (" + why + ")"); }
                return step_done(digest, "ratified by " + by);
            }
            if outcome != "approve" && len(first_row(self.journal, "knowledge.declined", digest).kind) > 0 { return step_failed("declined: " + settled.body); }
            let refused = first_row(self.journal, "knowledge.refused", digest);
            if len(refused.kind) > 0 { return step_failed("not ratified: " + std::json::find_string_field(refused.body, "why")); }
            return step_waits();
        }
        if key == "hat" { return self.practices.hat(task, digest, self.knowledge_client, self.memory_ready); }
        return step_failed("practice-ratify has no step `" + key + "`");
    }

    // ---- concern-escalate ----
    // One step, one burst of the record: the concern raised — its row names
    // the parent it is routed to — and, once its source crossed the
    // threshold, the proposal by that source bound to that parent.
    @unbounded
    fn concern_step(task: String, key: String, x: String) -> StepVerdict {
        if key != "raise" { return step_failed("concern-escalate has no step `" + key + "`"); }
        let source = std::json::find_string_field(x, "source");
        let parent = parent_path(source);
        let r = self.concerns.raise(task, x);
        if !r.ok { return step_waits(); }
        if r.propose {
            self.propose_concern(source, std::json::find_string_field(x, "what"), r.seen);
            return step_done(source, "raised, occurrence " + to_string(r.seen) + ", and proposed for " + (if len(parent) > 0 { parent } else { "no parent" }));
        }
        return step_done(to_string(r.seen), "raised, occurrence " + to_string(r.seen) + ", routed to " + (if len(parent) > 0 { parent } else { "no parent" }));
    }

    // ---- optimize-walk ----
    // One step: the machinery's signals read, the leader asked once per
    // incarnation, and done at the `org.reviewed` row its answer is.
    @unbounded
    fn optimize_step(task: String, key: String, x: String) -> StepVerdict {
        if key != "walk" { return step_failed("optimize-walk has no step `" + key + "`"); }
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "org.reviewed" && std::json::find_string_field(e.body, "task") == task { return step_done(std::json::find_string_field(e.body, "outcome"), std::json::find_string_field(e.body, "proposal")); }
            i = i + 1;
        }
        if !std::str::contains(self.optimize_asked, "\n" + task + "\n") {
            // GH #583 M1: the pass is model-backed work, and none is routed on
            // an exhausted budget; the occurrence fails saying so, and the
            // next one on the cadence asks again
            let now = std::time::now();
            if self.budget_exhausted(now) {
                let x = self.journal.append(self.journal.revision(), "optimize.refused", self.org_id, "budget exhausted (" + self.budget.describe(now) + "); the pass waits for the next occurrence");
                return step_failed("budget exhausted: the pass waits for the next occurrence");
            }
            self.optimize_asked = self.optimize_asked + task + "\n";
            self.optimizations = self.optimizations + 1;
            self.last_signals = self.signals();
            OptimizeRequested <- OptimizeRequest { org: self.org_id, signals: self.last_signals, task: task };
        }
        return step_waits();
    }
    // The next durable id of this owner's, minted before anything is born
    // so the record can hold the birth before the act (GH #604 rule 1).
    fn next_id() -> String {
        self.minted = self.minted + 1;
        return own_prefix(self.ownership.me) + "t" + to_string(self.minted);
    }
    // GH #646 workflow card 07: admit a defined workflow. The durable
    // fact precedes everything (GH #604 rule 1): the id is minted, the
    // definition expanded against this assembly's limits, and the
    // admission — engine, bound recipe, limits, counts, the caller's
    // identity — appended with exact compare-and-append before anything
    // could run. Only then the legacy `task.born` summary, so the tooling
    // of the day lists the Task. A refusal, by the catalog or by the
    // record, is a `workflow.refused` row and nothing else: no summary,
    // no child, no work request.
    //
    // One decision, one revision. The record is read once, at a revision
    // this body captures; whether this ask already landed and whether a
    // candidate id is already an execution's are both decided against
    // that reading; and the append is exact at that same revision. An
    // exact append protects the revision it was given — it does not make
    // a decision taken at an older reading valid at a newer one — so when
    // the record has moved (stale, or the store's unique claim on the id)
    // the whole decision is taken again, from a fresh reading. An id that
    // is taken is skipped before any append, not after a refusal.
    //
    // Over a shared record only the owner of the position admits (GH
    // #664), and a body that names no owner admits nothing; that rule is
    // the same one `ask` applies, and it is applied before an id is
    // minted. Nothing here dispatches; later cards execute.
    @unbounded
    fn admit_workflow(a: WorkflowAsk) -> String {
        if len(a.id) == 0 { return "refused: an admission names its request id"; }
        self.bind_owner();
        if !self.ownership.admits(a.to) {
            // not this body's to answer: no id, no row — the asker takes
            // it to the record, where the owner admits it
            return "refused: not this organization's to admit — " + self.ownership.why_not(a.to);
        }
        let mut tries = 0;
        let mut id = "";
        while tries < 6 {
            tries = tries + 1;
            let moved = self.journal.refresh();
            let rev = self.journal.revision();
            let had = self.workflow_admission_of(a.id, rev);
            if len(had) > 0 { return had; }
            // the candidate: the next id of this owner's that the record,
            // as read, does not already hold as an execution or a refusal.
            // A candidate from an earlier reading that is still free is
            // kept; one that was taken meanwhile is skipped.
            let mut skipped = 0;
            while (len(id) == 0 || self.task_id_taken(id, rev)) && skipped < 64 {
                id = self.next_id();
                skipped = skipped + 1;
            }
            if self.task_id_taken(id, rev) {
                return self.refuse_ask(a, "no free id within 64 of this owner's count");
            }
            let x = self.catalog.expand(id, a.definition, a.revision, self.admission_limits);
            if !x.ok { return self.refuse_task(id, rev, a, x.why); }
            // GH #995: a step the organization would perform, of a
            // definition whose path has not moved onto the catalog
            let unperformed = self.catalog.unperformed(a.definition, a.revision);
            if len(unperformed) > 0 { return self.refuse_task(id, rev, a, unperformed); }
            // card 18: a leaf that binds no objective of its own takes the
            // ask's, from the inputs, before the recipe is bound
            let objective = if len(a.inputs) > 0 { std::json::find_string_field(a.inputs, "objective") } else { "" };
            if len(objective) > 0 { self.catalog.bind_objective(objective); }
            let body = encode_admission(AdmittedWorkflow {
                task_id: id, definition: a.definition, revision: a.revision,
                inputs: a.inputs, inputs_ref: a.inputs_ref, request: a.id, convener: a.convener,
                recipe: self.catalog.encode_bound(), limits: self.admission_limits,
                works: x.works, tasks: x.tasks, steps: x.steps, depth: x.depth,
                transition: TransitionRef { scope: self.org_id, key: id, proposal_id: transition_id(id, "admitted") }
            });
            let r = self.journal.append_exact(rev, "workflow.admitted", id, body);
            if r.ok {
                // the compatibility summary, after the authoritative row: a
                // crash between the two leaves an admitted execution the
                // restart recognizes by its admission (see `rehydrate`)
                let s = self.journal.append(self.journal.revision(), "task.born", id, a.id + ": " + definition_name(a.definition, a.revision) + " (workflow)");
                return id;
            }
            if r.error != "stale_revision" && r.error != "claimed" {
                self.board.notify("journal", "append failed; workflow " + a.id + " not admitted");
                return self.refuse_task(id, rev, a, "the record refused the admission: " + r.error);
            }
            // the record moved under the decision: it is taken again — and
            // an id the store's unique claim refused (GH #666: another
            // body's birth) is not tried again; the next is minted
            if r.error == "claimed" { id = ""; }
        }
        return self.refuse_ask(a, "the record moved under the admission " + to_string(tries) + " times");
    }

    // A refusal bound to a Task id carries the admission's own guarantee:
    // it is appended exactly at the revision that found the id free. When
    // the record has moved, it is read again — the ask may have landed
    // from another body, in which case that execution is the answer, and
    // the id may be another execution's now, in which case the refusal is
    // written under the ask instead. A refusal never attaches to an
    // execution another body admitted.
    @unbounded
    fn refuse_task(id: String, rev: Int, a: WorkflowAsk, why: String) -> String {
        let mut at = rev;
        let mut tries = 0;
        while tries < 6 {
            tries = tries + 1;
            let r = self.journal.append_exact(at, "workflow.refused", id, self.refusal_body(id, a, why));
            if r.ok { return "refused: " + why; }
            if r.error != "stale_revision" && r.error != "claimed" {
                return "refused: " + why + "; and the record would not take the refusal either: " + r.error;
            }
            let moved = self.journal.refresh();
            at = self.journal.revision();
            let landed = self.workflow_admission_of(a.id, at);
            if len(landed) > 0 { return landed; }
            if self.task_id_taken(id, at) { return self.refuse_ask(a, why); }
        }
        return self.refuse_ask(a, why);
    }

    // A refusal bound to no Task — no id was reached, or the one reached
    // is another execution's now — is a fact of its own kind under the
    // ask's own identity and a decision ordinal (`<ask>#<n>`), which can
    // alias no Task under any owner's name. The same ask refused again
    // for the same reason is the same decision, answered without another
    // row; refused for another reason, it is the next decision under the
    // next ordinal — never a changed body under a recorded identity.
    //
    // The decision is one reading of the record: the decisions already
    // taken on this ask are counted at a revision this body captures,
    // the ordinal is chosen against that count, and the append is exact
    // at that same revision. Another body deciding on the same ask
    // between this body's reading and its append moves the record, the
    // append is refused, and the decision is taken again from a fresh
    // reading — a competing decision for the same reason becomes this
    // body's answer with no row of its own; one for another reason takes
    // the ordinal, and this body's takes the next. Written and checked:
    // when the record will not take even that, the answer says so.
    @unbounded
    fn refuse_ask(a: WorkflowAsk, why: String) -> String {
        let mut tries = 0;
        while tries < 6 {
            tries = tries + 1;
            let moved = self.journal.refresh();
            let rev = self.journal.revision();
            let mut decisions = 0;
            let mut last = "";
            let mut i = 0;
            while i < rev {
                let e = self.journal.read(i);
                if e.kind == "workflow.ask_refused" && std::json::find_string_field(e.body, "request") == a.id {
                    decisions = decisions + 1;
                    last = std::json::find_string_field(e.body, "why");
                }
                i = i + 1;
            }
            if decisions > 0 && last == why { return "refused: " + why; }
            let decision = decisions + 1;
            let entity = ask_refusal_id(a.id, decision);
            let r = self.journal.append_exact(rev, "workflow.ask_refused", entity, encode_ask_refusal(RefusedAsk {
                request: a.id, decision: decision, definition: a.definition, revision: a.revision, why: why,
                limits: self.admission_limits,
                transition: TransitionRef { scope: self.org_id, key: entity, proposal_id: transition_id(entity, "refused") }
            }));
            if r.ok { return "refused: " + why; }
            if r.error != "stale_revision" && r.error != "claimed" {
                return "refused: " + why + "; and the record would not take the refusal either: " + r.error;
            }
            // the record moved under the decision: it is taken again
        }
        return "refused: " + why + "; and the record moved under the refusal " + to_string(tries) + " times, so it went unrecorded";
    }

    fn refusal_body(entity: String, a: WorkflowAsk, why: String) -> String {
        return encode_refusal(RefusedWorkflow {
            task_id: entity, definition: a.definition, revision: a.revision, why: why,
            limits: self.admission_limits,
            transition: TransitionRef { scope: self.org_id, key: entity, proposal_id: transition_id(entity, "refused") }
        });
    }

    // The Task an admission under this request id created, "" when none
    // did — as the record read at `rev`, so the decision and the append
    // that follows it are about one reading.
    @unbounded
    fn workflow_admission_of(request: String, rev: Int) -> String {
        let mut i = 0;
        while i < rev {
            let e = self.journal.read(i);
            if e.kind == "workflow.admitted" && std::json::find_string_field(e.body, "request") == request { return e.entity; }
            i = i + 1;
        }
        return "";
    }

    // Whether a Task id is already spoken for as the record read at
    // `rev`: admitted as a workflow, refused as one (the id was minted
    // for it, as the restart's count also has it), or born the legacy way.
    @unbounded
    fn task_id_taken(id: String, rev: Int) -> Bool {
        let mut i = 0;
        while i < rev {
            let e = self.journal.read(i);
            if (e.kind == "workflow.admitted" || e.kind == "workflow.refused" || e.kind == "task.born") && e.entity == id { return true; }
            i = i + 1;
        }
        return false;
    }

    // Whether a Task is an admitted workflow execution: the one positive
    // discriminator (§8). Such a Task is never legacy edit work, whatever
    // summary rows it has or lacks; its recovery is the new engine's
    // (later cards), not `resume_work`'s.
    @unbounded
    fn workflow_admitted(task_id: String) -> Bool {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "workflow.admitted" && e.entity == task_id { return true; }
            i = i + 1;
        }
        return false;
    }

    // The child's boundary reads the ceiling as it is NOW, before each
    // assessment (GH #596, layering).
    fn bind_ceiling() {
        if len(self.ceiling.child) > 0 { self.boundary.ceiling = self.ceiling.current_grant(); }
    }
    // An outcome under the organism's ceiling: a contraction binds
    // every child at once, and the record names them.
    // The contraction is recorded before it takes effect, with the
    // magnitude and epoch it leaves, so a restart restores it (the second
    // review of #626: a contraction lived only in the live boundary, and an
    // organism born again over the same record had its authority back).
    fn ceiling_outcome(ok: Bool) {
        if self.ceiling.would_contract(ok) {
            let before = self.ceiling.current_grant().max_magnitude;
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("boundary", "ceiling");
            b.int_field("from", before);
            b.int_field("to", before / 2);
            b.int_field("epoch", self.ceiling.current_grant().authority_epoch + 1);
            b.string_field("binds", self.boundary.child);
            b.string_field("note", "ceiling " + to_string(before) + " -> " + to_string(before / 2) + " on repeated failure; binds " + self.boundary.child + " from now");
            b.end_object();
            let x = self.journal.append(self.journal.revision(), "grant.contracted", self.ceiling.child, b.result());
            // the last contraction's row is the whole state a restart needs
            self.unrecorded_contraction = if x.ok { "" } else { b.result() };
        }
        // contracted whether or not the record took the row: less
        // authority is never the unsafe direction
        self.ceiling.note_outcome(ok);
    }
    // ---- resources (GH #605) -------------------------------------
    // A spend is admitted against the child's grant as it binds now
    // (through the ceiling), and the admission is a row. A window's
    // remainder is read from the record at a revision and the row is
    // appended only at that revision (`append_exact`): another child
    // that reserved in between moved the record, this append is refused
    // as stale, and the remainder is read again. The child's own window
    // counts its reservations; the ceiling's counts every child's under
    // it, so two children cannot each spend the same remainder.
    fn reserve(s: Spend) -> Admission {
        self.bind_ceiling();
        let unrecorded = self.contraction_unrecorded();
        if len(unrecorded) > 0 { return Admission { op: s.id, amount: s.amount, currency: s.currency, refused: unrecorded }; }
        return self.spending.reserve(s, self.boundary.effective(), self.boundary.current_grant(), self.ceiling.current_grant(), self.boundary.child, self.ceiling.child, std::time::now());
    }
    // GH #667: every `task.transfer_requested` naming this owner that a
    // member of this owner accepted (`task.transfer_accepted`) and this
    // controller has not yet handed is handed now, to the assignee the
    // request named, in this owner's name — the same `task.handed` row a
    // job of its own gets, so completion is admitted in the assignee's
    // name as always. Bounded by the transfers in the ledger; idempotent.
    @unbounded
    fn admit_transfers() -> Int {
        self.bind_owner();
        let me = self.ownership.me;
        if len(me) == 0 { return 0; }
        let moved = self.journal.refresh();
        let n = self.journal.revision();
        let mut handed_n = 0;
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "task.transfer_requested" && native_json_string(e.body, "to") == me {
                if self.admit_transfer(e.entity, me) { handed_n = handed_n + 1; }
            }
            i = i + 1;
        }
        return handed_n;
    }
    @unbounded
    fn admit_transfer(task_id: String, me: String) -> Bool {
        let mut attempt = 0;
        while attempt < 8 {
            attempt = attempt + 1;
            let moved = self.journal.refresh();
            let n = self.journal.revision();
            let mut requested = Event { };
            let mut accepted = Event { };
            let mut blocked = false;
            let mut i = 0;
            while i < n {
                let e = self.journal.read(i);
                if e.entity == task_id {
                    if e.kind == "task.transfer_requested" { requested = e; accepted = Event { }; blocked = false; }
                    else if len(requested.kind) > 0 && e.kind == "task.transfer_accepted" { accepted = e; }
                    else if len(requested.kind) > 0 && std::str::starts_with(e.kind, "task.") { blocked = true; }
                }
                i = i + 1;
            }
            if blocked || len(requested.kind) == 0 || len(accepted.kind) == 0 { return false; }
            let from = native_json_string(requested.body, "owner");
            let assignee = native_json_string(requested.body, "assignee");
            let by = native_json_string(accepted.body, "by");
            if native_json_string(requested.body, "to") != me || len(from) == 0 || from == me || len(assignee) == 0 || len(by) == 0 { return false; }
            if native_json_string(accepted.body, "owner") != me || native_json_string(accepted.body, "from") != from || native_json_string(accepted.body, "assignee") != assignee { return false; }
            // Acceptance pins this recipient. A retirement cannot silently
            // replace it with a successor or another owner's member.
            if retirement(self.journal, assignee).retired || self.ownership.owner_of_person(assignee) != me || self.ownership.owner_of_person(by) != me { return false; }
            let hb = std::json::Builder { };
            hb.begin_object();
            hb.string_field("work", "");
            hb.string_field("assignee", assignee);
            hb.string_field("obligation", native_json_string(requested.body, "obligation"));
            hb.string_field("acceptance", native_json_string(requested.body, "acceptance"));
            hb.bool_field("evidence_required", std::str::trim(std::json::find_field_raw(requested.body, "evidence_required")) == "true");
            hb.string_field("by", me);
            hb.string_field("transferred_from", from);
            hb.string_field("accepted_by", by);
            hb.string_field("narrative", "transferred from " + from + ", accepted by " + by + ": " + native_json_string(requested.body, "narrative"));
            hb.end_object();
            let document = hb.result();
            let x = self.journal.append_exact(n, "task.handed", task_id, document);
            if x.ok || self.handoff_recorded(n, "task.handed", task_id, document) {
                self.board.notify("task", task_id + " transferred from " + from + " and handed to " + assignee);
                return true;
            }
            if x.error != "stale_revision" { return false; }
        }
        return false;
    }
    // GH #666: the owner this body mints and claims for, handed to the
    // metabolism and the gateway once the ownership map is read.
    fn bind_owner() {
        self.gateway.namespace = self.ownership.me;
    }
    // GH #1123: who owns which position is the graph's, read from memory
    // on every reconciliation. An answer memory does not give ("") is no
    // ownership at all: a body that names its organization then admits
    // nothing rather than keep a view that may have moved; with no memory
    // named the view stays as born (one owner, or nothing for a named body).
    @unbounded
    fn refresh_ownership() {
        if !self.knowledge_client.ready() { return; }
        self.ownership.reload(self.knowledge_client.ownership());
    }
    // A reservation settles at what an attempt actually spent, and every
    // attempt is retained (GH #668): a second settlement is attempt 2,
    // and the window counts the sum. Under contention a settlement is
    // once: appended only at the revision "not yet settled by another"
    // was read at, and a settlement another writer landed in between is
    // read as the answer, never doubled.
    fn settle_spend(op: String, spent: String) -> String { return self.spending.settle(op, spent, self.boundary.child); }
    // GH #668: money that came back is a compensation someone authorized,
    // never an implied rollback: `spend.compensated <op> {child, attempt,
    // amount, by}`, and the window counts it from then on.
    fn compensate_spend(op: String, amount: String, by: String) -> String { return self.spending.compensate(op, amount, by, self.boundary.child); }
    // An admission is carried out only under the grant it was made
    // under: a contraction or revocation since then advanced the epoch,
    // and the admission is fenced, in the record.
    fn admits(a: Admission) -> String {
        if !a.ok { return "not admitted: " + a.refused; }
        let unrecorded = self.contraction_unrecorded();
        if len(unrecorded) > 0 { return unrecorded; }
        self.bind_ceiling();
        let now_epoch = self.boundary.effective().authority_epoch;
        if now_epoch != a.authority_epoch {
            let why = "fenced: the grant changed after `" + a.op + "` was admitted (epoch " + to_string(a.authority_epoch) + " -> " + to_string(now_epoch) + ")";
            let x = self.journal.append(self.journal.revision(), "grant.fenced", self.boundary.child, why);
            return why;
        }
        // time is authority too: an admission is carried out only while the
        // grant it was made under has not expired
        let expires = self.boundary.effective().expires;
        if expires > 0 && std::time::now() >= expires {
            let why = "expired: the grant `" + a.op + "` was admitted under expired at " + std::time::iso8601(std::time::time_from_unix(expires));
            let y = self.journal.append(self.journal.revision(), "grant.fenced", self.boundary.child, why);
            return why;
        }
        return "";
    }
    // A contraction the record refused is appended again before any
    // admission; "" once the record holds it, else why nothing is admitted.
    // A restart knows only what the record holds, so an organism that
    // cannot record its narrower grant admits nothing under either.
    fn contraction_unrecorded() -> String {
        if len(self.unrecorded_contraction) == 0 { return ""; }
        let x = self.journal.append(self.journal.revision(), "grant.contracted", self.ceiling.child, self.unrecorded_contraction);
        if x.ok {
            self.unrecorded_contraction = "";
            return "";
        }
        return "the grant's contraction could not be recorded (" + x.error + "); nothing is admitted until the record holds it";
    }
    // A ceiling's contractions are the record's too: read back at birth,
    // the last one leaves the ceiling's magnitude and epoch where it left
    // them, before anything is admitted. A row from before the body was
    // structured (`ceiling <from> -> <to> …`) is read too, each such row
    // one epoch.
    @unbounded
    fn restore_contractions() {
        let parent = self.ceiling.child;
        if len(parent) == 0 { return; }
        let n = self.journal.revision();
        let mut to = -1;
        let mut last_epoch = 0;
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "grant.contracted" && e.entity == parent {
                if std::str::starts_with(e.body, "{") {
                    to = std::json::find_int_field(e.body, "to");
                    last_epoch = std::json::find_int_field(e.body, "epoch");
                } else {
                    let arrow = std::str::index_of(e.body, "-> ");
                    let rest = if arrow < 0 { "" } else { e.body[(arrow + 3)..len(e.body)] };
                    let sp = std::str::index_of(rest, " ");
                    to = std::str::parse_int(if sp < 0 { rest } else { rest[0..sp] }) or 0;
                    last_epoch = last_epoch + 1;
                }
            }
            i = i + 1;
        }
        // the recorded epoch and review hold whatever the authored magnitude
        // is now; the magnitude is the stricter of the two (the third review
        // of #626: an authored ceiling already at the contracted limit lost
        // the epoch and went back to post-review)
        if to >= 0 {
            let authored = self.ceiling.current_grant().max_magnitude;
            self.ceiling.restore_contraction(if to < authored { to } else { authored }, last_epoch);
        }
    }
    // A revocation is the record's, not the live boundary's alone: read
    // back at birth, it leaves nothing granted and the epoch where it left
    // it, before anything is admitted. A row from before the body was
    // structured (`by <who>; epoch <n>`) is read too.
    @unbounded
    fn restore_revocations() {
        let child = self.boundary.child;
        if len(child) == 0 { return; }
        let n = self.journal.revision();
        let mut revoked_at = -1;
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "grant.revoked" && e.entity == child {
                let recorded = std::json::find_int_field(e.body, "epoch");
                if recorded > 0 {
                    revoked_at = recorded;
                } else {
                    let at = std::str::index_of(e.body, "epoch ");
                    revoked_at = if at < 0 { 1 } else { std::str::parse_int(std::str::trim(e.body[(at + 6)..len(e.body)])) or 1 };
                }
            }
            i = i + 1;
        }
        if revoked_at >= 0 { self.boundary.restore_revocation(revoked_at); }
    }
    // The parent revokes the child's grant: nothing is left granted,
    // and every earlier admission is fenced.
    fn revoke_grant(requested_by: String) -> Bool {
        let parent = if len(self.ceiling.child) > 0 { self.ceiling.child } else { "board" };
        // the parent's alone: a refusal is the boundary's to audit
        if requested_by == self.boundary.child || requested_by != parent { return self.boundary.revoke(requested_by, parent); }
        // recorded before it takes effect, so a restart restores it; a
        // revocation the record refuses did not happen
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("by", requested_by);
        b.string_field("parent", parent);
        b.int_field("epoch", self.boundary.current_grant().authority_epoch + 1);
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "grant.revoked", self.boundary.child, b.result());
        if !x.ok { return false; }
        return self.boundary.revoke(requested_by, parent);
    }
    // A staged mutation: assessed under the boundary, reviewed per
    // policy, and NEVER applied by this assembly's deployment.
    fn stage(change_class: String, candidate_digest: String, m: Magnitude, e: Evidence) -> String {
        self.bind_ceiling();
        let d = self.boundary.assess(change_class, m, e);
        let name = disposition_name(d);
        let r = self.journal.append(self.journal.revision(), "mutation." + name, candidate_digest, change_class);
        return match d {
            Disposition::Release -> {
                // the grant would allow it; the deployment gateway
                // decides whether expression is possible here at all
                if self.deployment.apply(candidate_digest) {
                    "applied"
                } else {
                    self.board.notify("mutation", "staged (no deployment): " + candidate_digest);
                    "stage"
                }
            },
            Disposition::Review -> {
                self.board.notify("review", self.review_policy.required_authority(change_class, m) + " needed for " + candidate_digest);
                name
            },
            Disposition::Stage -> {
                self.board.notify("review", self.review_policy.required_authority(change_class, m) + " needed for " + candidate_digest);
                name
            },
            Disposition::Escalate -> name,
            Disposition::Deny -> name,
        };
    }
    // ---- Phase 2: a Mutation, end to end up to its Review (GH #529 D4)
    // Open a worktree at the genome's head, let the editor propose
    // inside it, commit the candidate, verify it with receipts, and put
    // it under a blocking Review pinned to the exact candidate commit.
    // Returns "<id>: review" or "<id>: failed: <why>".
    // Which seed a change class edits: the organization's own for an
    // `organization` change, the genome's for the rest.
    fn seed_for(change_class: String) -> String {
        if change_class == "organization" { return self.org_seed; }
        return self.genome_seed;
    }
    @unbounded
    fn mutate(task_id: String, change_class: String, objective: String, target: String, now: Int) -> String {
        return self.mutate_for(WorkRequest { task_id: task_id }, change_class, objective, target, now);
    }
    // The Mutation one Work's attempt asks for (card 14): the request as
    // asked binds it. `mutate` above is the Task-level entry — an ask
    // with no Work behind it binds nothing and is the Task's alone.
    @unbounded
    fn mutate_for(req: WorkRequest, change_class: String, objective: String, target: String, now: Int) -> String {
        let task_id = req.task_id;
        self.bind_owner();
        self.mutations_minted = self.mutations_minted + 1;
        let id = own_prefix(self.ownership.me) + "m" + to_string(self.mutations_minted);
        self.last_mutation = id;
        let seed = self.seed_for(change_class);
        let base = self.gateway.head();
        // card 14: which exact Work and attempt asked for this Mutation,
        // with the request as asked — written first, so the association
        // exists from the Mutation's first row; the Task-level summary
        // follows, as every reader of the day expects it
        let asked = std::json::Builder { };
        asked.begin_object();
        asked.string_field("task_id", task_id);
        asked.string_field("change_class", change_class);
        asked.string_field("objective", objective);
        asked.string_field("target", target);
        asked.string_field("base", base);
        asked.field("binding", encode_binding(binding_of(req)));
        asked.end_object();
        let xr = self.journal.append(self.journal.revision(), "mutation.requested", id, asked.result());
        if !xr.ok {
            // the Mutation's identity is not durable: nothing proceeds
            // under it — no summary row, no worktree, no effect. The
            // caller holds the request; a restart never sees this id
            self.mutation_refusals = self.mutation_refusals + 1;
            self.board.notify("record", id + ": the record would not take the Mutation's request (" + xr.error + "); nothing proceeds under it");
            return id + ": refused: the record would not take the Mutation's request (" + xr.error + ")";
        }
        let x0 = self.journal.append(self.journal.revision(), "mutation.proposed", id, "task " + task_id + " " + change_class + ": " + objective + " (" + target + ") at " + base);
        if !x0.ok {
            // the summary is compatibility: the Mutation exists by its
            // request row and recovery reads every row it has; the refusal
            // is counted and said, and the Mutation proceeds on its request
            self.mutation_refusals = self.mutation_refusals + 1;
            self.board.notify("record", id + ": the record would not take the Mutation's summary row (" + x0.error + "); it proceeds on its request row");
        }
        let lease = self.gateway.take(id, "dna", now);
        let opened = self.gateway.open(self.journal, id, base, lease.token, now);
        if !opened.ok { return self.mutation_failed(id, "worktree: " + opened.refused); }
        let wt = opened.value;
        // GH #583 K2: the owner asks the knowledge service what the
        // organization ratified for this target and folds it into the
        // objective; the editor never reaches knowledge, it receives a
        // package by way of its owner, and its evidence names the package
        let pkg = self.knowledge_client.package_for(knowledge_target(change_class, self.boundary.child, seed), objective);
        // GH #946 hardening: the ask stays the ask. The practices reach the
        // editor as its brief, and the attempt carries the hat — the
        // position, the practices as structure, the bindings, the grant,
        // the contract, the class, the head and watermark — by its digest;
        // the body is kept in memory under that digest, so replay renders
        // from the recorded hat and never the live graph.
        let hat = hat_sealed(hat_with_package(Hat {
            ok: true, work_id: id, task_id: task_id, step_id: req.step_id, attempt_id: attempt_id_of(id, req.attempt_no), performer_kind: "edit",
            position_id: hat_position_of("edit"), charter: hat_node_text(self.journal, hat_position_of("edit")),
            objective: objective, target: req.target, output_contract: req.output_contract, data_class: req.data_class, requires: req.requires,
            cost_ceiling: req.cost_ceiling, tool_grant: hat_tool_grant("edit"), knowledge_bindings: bindings_of(pkg), head: self.journal.head()
        }, pkg, self.knowledge_client.ready()));
        if self.knowledge_client.ready() { let kept = self.knowledge_client.keep_hat(hat.digest, hat.head, hat.watermark, hat_body(hat)); }
        self.editor.brief(objective_with("", pkg));
        if self.knowledge_client.ready() {
            let kb = std::json::Builder { };
            kb.begin_object();
            kb.string_field("target", pkg.target);
            kb.string_field("hat", hat.digest);
            kb.string_field("digest", pkg.digest);
            kb.int_field("revision", pkg.revision);
            kb.int_field("included_n", pkg.included_n);
            kb.string_field("included", pkg.included);
            kb.string_field("error", pkg.error);
            kb.end_object();
            let kx = self.journal.append(self.journal.revision(), "knowledge.consulted", id, kb.result());
        }
        // the grant is the seed this change edits, inside THIS worktree;
        // the worktree is what a harness's export copies, the repository
        // what it must never reach (GH #583 M3)
        self.editor.place(wt, seed, self.gateway.repo.root());
        let mut file = target;
        // step 5: the Attempt inspects the listing under its grant — unless
        // its backend works in place (GH #583 M3): a harness finds its own
        // files, and the import says which it changed
        if len(file) == 0 && !self.editor.in_place("internal") {
            file = self.editor.locate(attempt_id_of(id, req.attempt_no), objective);
            if len(file) == 0 {
                let x = self.gateway.remove(self.journal, id, lease.token, now);
                return self.mutation_failed(id, "attempt: no file in the grant answers `" + objective + "`");
            }
            let x1 = self.journal.append(self.journal.revision(), "mutation.located", id, file + " under " + self.editor.grant());
        } else if len(file) > 0 {
            // named by the asker or by the leader's plan: the record still
            // says what the Attempt inspected, and under what grant
            let x1 = self.journal.append(self.journal.revision(), "mutation.located", id, file + " under " + self.editor.grant() + " (named)");
        }
        // GH #583 M3: the genome must not move while an attempt runs —
        // an editor's process (a harness with tools) could reach it only
        // around the boundary, and the record says so instead of the
        // candidate quietly building on a moved base
        let head_before = self.gateway.head();
        let wt_before = self.gateway.repo.head(wt);
        // the request's own capability words, data class and attempt
        // (card 14): the editor works the ask as it was asked, and its
        // evidence is classed as the ask was
        let r = self.editor.perform(WorkRequest {
            work_id: id, task_id: task_id, step_id: req.step_id, objective: objective, target: file,
            requires: req.requires, data_class: req.data_class, attempt_no: req.attempt_no,
            output_contract: req.output_contract, cost_ceiling: req.cost_ceiling,
            context_digest: hat.digest, knowledge_bindings: bindings_of(pkg)
        });
        if self.gateway.head() != head_before || self.gateway.repo.head(wt) != wt_before {
            let x = self.gateway.remove(self.journal, id, lease.token, now);
            return self.mutation_failed(id, "the genome moved during the attempt (" + head_before + " -> " + self.gateway.head() + "; worktree " + wt_before + " -> " + self.gateway.repo.head(wt) + "): nothing built on it is a candidate");
        }
        if r.disposition != "done" {
            let x = self.gateway.remove(self.journal, id, lease.token, now);
            return self.mutation_failed(id, "attempt: " + r.narrative);
        }
        return self.candidate_review(Mutation {
            id: id, task_id: task_id, base_commit: base, worktree: wt,
            change_class: change_class, seed: seed, rationale: objective,
            fitness_signals: std::json::find_string_field(r.result, "fitness_signals"),
            disposition: "proposed"
        }, "a" + to_string(req.attempt_no), self.editor.identity(), lease.token, now);
    }
    // The worktree of a Mutation committed as its candidate, verified, and
    // put to its Review (or denied): the one tail of every candidate — the
    // editor's in process (`mutate_for`) and a leg's (`mutate_from_leg`).
    // `m` names everything but the candidate; `author` is whose change it is.
    @unbounded
    fn candidate_review(prepared: Mutation, step: String, author: String, token: Int, now: Int) -> String {
        let id = prepared.id;
        let committed = self.gateway.commit(self.journal, id, step, prepared.change_class + ": " + prepared.rationale, token, now);
        if !committed.ok { return self.mutation_failed(id, "commit: " + committed.refused); }
        let m = Mutation {
            id: id, task_id: prepared.task_id, base_commit: prepared.base_commit, worktree: prepared.worktree,
            candidate_commit: committed.value, candidate_digest: committed.value,
            change_class: prepared.change_class, seed: prepared.seed, rationale: prepared.rationale,
            fitness_signals: prepared.fitness_signals, disposition: "proposed"
        };
        let report = self.verification.verify(self.journal, m, self.baseline);
        // a genome with no Hale source has nothing for the check to judge
        // (GH #1156): the evidence says so, and the Review decides
        if report.evidence.hale_source && !report.evidence.check_clean {
            let x = self.journal.append(self.journal.revision(), "mutation.deny", id, "candidate does not check (" + report.steps + ")");
            return id + ": denied: candidate does not check";
        }
        // GH #566 F5: a change to one service that breaks a claim the fleet
        // makes over all of them is denied with the witness in the evidence
        if !report.evidence.fleet_clean {
            let x = self.journal.append(self.journal.revision(), "mutation.deny", id, "candidate breaks the fleet (" + report.steps + ")");
            return id + ": denied: candidate breaks the fleet";
        }
        // a candidate that names a plan or the manifest changes the fleet's
        // shape: it is a topology mutation whatever it was asked as
        let mut reviewed = m;
        if report.evidence.topology_changed && m.change_class != "topology" {
            reviewed = Mutation {
                id: m.id, task_id: m.task_id, base_commit: m.base_commit, worktree: m.worktree,
                candidate_commit: m.candidate_commit, candidate_digest: m.candidate_digest,
                change_class: "topology", seed: m.seed, rationale: m.rationale,
                fitness_signals: m.fitness_signals, disposition: m.disposition
            };
            let y = self.journal.append(self.journal.revision(), "mutation.topology", id, "names a plan or the manifest: the fleet's shape changes, the Board decides");
        }
        let d = self.review_mutation(reviewed, report, author);
        // a Review that could not open (its routing unrecorded, its paths
        // unknown) or a post-review apply that failed is the Mutation's
        // failure, a row: nothing is left in flight that nothing finishes
        if std::str::starts_with(d, "failed") { return self.mutation_failed(id, d[(if std::str::starts_with(d, "failed: ") { 8 } else { 6 })..len(d)]); }
        return id + ": " + d;
    }
    // A leg's candidate made a Mutation (GH #1156): the outcome of a Patch
    // Work names its commit (`result_ref: commit:<sha>`) and files that
    // commit's own patch (`git format-patch`, its `From <sha>` line naming
    // it) among its receipts. Bound to the attempt as the editor's is (card
    // 14), the Mutation is opened at the genome's head, the patch applied
    // in its worktree — only under the seed its class edits — and the
    // candidate committed, verified and put to its Review by the leg that
    // made it. What stands in the way is the Mutation's failure, a row.
    @unbounded
    fn mutate_from_leg(req: WorkRequest, s: WorkSubmission, now: Int) -> String {
        let class = self.edit_class_of(req.task_id);
        let seed = self.seed_for(class);
        let sha = if std::str::starts_with(s.result_ref, "commit:") { s.result_ref[7..len(s.result_ref)] } else { "" };
        let found = self.leg_patch(sha, s.evidence_ref);
        self.bind_owner();
        self.mutations_minted = self.mutations_minted + 1;
        let id = own_prefix(self.ownership.me) + "m" + to_string(self.mutations_minted);
        self.last_mutation = id;
        let base = self.gateway.head();
        let asked = std::json::Builder { };
        asked.begin_object();
        asked.string_field("task_id", req.task_id);
        asked.string_field("change_class", class);
        asked.string_field("objective", req.objective);
        asked.string_field("target", req.target);
        asked.string_field("base", base);
        asked.field("binding", encode_binding(binding_of(req)));
        // whose candidate, and by what: the leg's commit and the receipt that is its patch
        asked.string_field("leg", s.holder);
        asked.string_field("leg_commit", sha);
        asked.string_field("patch", found);
        asked.end_object();
        let xr = self.journal.append(self.journal.revision(), "mutation.requested", id, asked.result());
        if !xr.ok {
            self.mutation_refusals = self.mutation_refusals + 1;
            self.board.notify("record", id + ": the record would not take the Mutation's request (" + xr.error + "); nothing proceeds under it");
            return id + ": refused: the record would not take the Mutation's request (" + xr.error + ")";
        }
        let x0 = self.journal.append(self.journal.revision(), "mutation.proposed", id, "task " + req.task_id + " " + class + ": " + req.objective + " (" + s.holder + "'s commit " + sha + ") at " + base);
        if len(sha) == 0 { return self.mutation_failed(id, "the leg's outcome names no candidate: a Patch Work's result_ref is `commit:<sha>`, not `" + s.result_ref + "`"); }
        if len(found) == 0 { return self.mutation_failed(id, "no receipt of the leg's outcome is commit " + sha + "'s patch (`git format-patch`, its `From " + sha + "` line naming it)"); }
        let text = self.verification.receipts.read(found[7..len(found)]);
        let lease = self.gateway.take(id, "dna", now);
        let opened = self.gateway.open(self.journal, id, base, lease.token, now);
        if !opened.ok { return self.mutation_failed(id, "worktree: " + opened.refused); }
        let wt = opened.value;
        let applied = apply_patch_in(wt, text);
        if applied.code != 0 {
            let x = self.gateway.remove(self.journal, id, lease.token, now);
            return self.mutation_failed(id, "the leg's patch does not apply at " + base + ": " + trim_nl(applied.stderr));
        }
        // the grant: the seed the class edits, nothing beside it — every path
        // the patch touches, a rename's source too — and never the
        // organization's own seed unless the change is the organization's
        let touched = staged_paths(wt);
        let fenced = if class == "organization" { "" } else { self.org_seed };
        let outside = if touched.code != 0 { "(its paths are unknown: " + trim_nl(touched.stderr) + ")" } else { paths_outside(touched.stdout, seed, fenced) };
        if len(outside) > 0 {
            let x = self.gateway.remove(self.journal, id, lease.token, now);
            return self.mutation_failed(id, "the leg's patch edits outside what a " + class + " change may (the seed `" + seed + "`" + (if len(fenced) > 0 { ", never the organization's `" + fenced + "`" } else { "" }) + "): " + outside);
        }
        let x1 = self.journal.append(self.journal.revision(), "mutation.located", id, trim_nl(touched.stdout) + " under " + seed + " (the leg's patch)");
        return self.candidate_review(Mutation {
            id: id, task_id: req.task_id, base_commit: base, worktree: wt,
            change_class: class, seed: seed, rationale: req.objective, disposition: "proposed"
        }, "a" + to_string(req.attempt_no), s.holder, lease.token, now);
    }
    // The receipt among `digests` (space-separated `sha256:<hex>`) that is
    // commit `sha`'s own patch: its first line `From <sha> `. "" when none.
    @unbounded
    fn leg_patch(sha: String, digests: String) -> String {
        if len(sha) == 0 { return ""; }
        let mut rest = digests + " ";
        while len(rest) > 0 {
            let sp = std::str::index_of(rest, " "); let d = rest[0..sp]; rest = rest[(sp + 1)..len(rest)];
            if std::str::starts_with(d, "sha256:") && std::str::starts_with(self.verification.receipts.read(d[7..len(d)]), "From " + sha + " ") { return d; }
        }
        return "";
    }
    fn mutation_failed(id: String, why: String) -> String {
        let x = self.journal.append(self.journal.revision(), "mutation.failed", id, why);
        self.board.notify("mutation", id + " failed: " + why);
        return id + ": failed: " + why;
    }
    // Assess under the boundary, record the disposition, and — Phase 2,
    // whatever the grant says — block on a human Review pinned to the
    // exact candidate. The request carries everything a reviewer
    // renders: the evidence steps, the magnitude, where the diffs are.
    @unbounded
    fn review_mutation(m: Mutation, r: VerificationReport, author: String) -> String {
        return self.review_mutation_mode(m, r, author, OrganizationSourceRequest { });
    }
    fn review_mutation_mode(m: Mutation, r: VerificationReport, author: String, source: OrganizationSourceRequest) -> String {
        let prepared = len(source.request_id) > 0;
        if prepared && !self.review_policy.blocking(m.change_class) { return "refused: blocking Review required"; }
        self.bind_ceiling();
        let d = self.boundary.assess(m.change_class, r.magnitude, r.evidence);
        let name = disposition_name(d);
        if prepared {
            if !append_once(self.journal, "mutation." + name, m.id, m.change_class + " candidate " + m.candidate_commit) { return "pending"; }
        } else { let x = self.journal.append(self.journal.revision(), "mutation." + name, m.id, m.change_class + " candidate " + m.candidate_commit); }
        // Outside the grant nobody below the Board decides (escalate);
        // inside it, the policy names the authority.
        let authority = if name == "escalate" { "board" } else { self.review_policy.required_authority(m.change_class, r.magnitude) };
        // Post-review autonomy (GH #529 D7 extension 2): inside the grant,
        // no hard boundary, evidence sufficient, and a policy that does
        // not block this class — the candidate is applied NOW and the
        // Review follows; a rejection then rolls it back. Every step is
        // the same gate, the same fences, the same Journal.
        // GH #1089: the positions the candidate's route requires, and the
        // gates whose runs are its evidence, recorded before the Review
        // opens and before anything is applied; paths git cannot name, or
        // memory that does not answer, open nothing and are asked again
        let changed = changed_paths(m.worktree, m.base_commit, m.candidate_commit);
        if changed.code != 0 { return (if prepared { "pending" } else { "failed" }) + ": the candidate's changed paths are unknown: " + trim_nl(changed.stderr); }
        let need = self.review_routing(m.id, "change-deliver", changed.stdout, true, !prepared);
        if !need.recorded { return (if prepared { "pending" } else { "failed" }) + ": the Review's routing is not recorded (memory did not answer, or the record did not take it)"; }
        let post = name == "release" && !self.review_policy.blocking(m.change_class);
        if post {
            let applied = self.apply_candidate(m.id, m.candidate_commit, std::time::now());
            if applied != "applied" { return "failed: " + applied; }
        }
        let question = (if post { "post-review: applied " } else { "apply " }) + m.id + " (" + m.change_class + "): " + m.rationale + "?";
        if !prepared {
            Review {
                journal: self.review_journal,
                review_id: m.id, question: question, subject_digest: m.candidate_commit,
                required_authority: authority, author: author,
                signers: need.signers, gates: need.gates, fallback: need.fallback
            };
        }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("question", question);
        b.string_field("subject_digest", m.candidate_commit);
        b.string_field("required_authority", authority);
        b.string_field("author", author);
        b.string_field("mutation_id", m.id);
        b.string_field("task_id", m.task_id);
        b.string_field("change_class", m.change_class);
        b.string_field("seed", m.seed);
        b.string_field("disposition", name);
        b.string_field("base_commit", m.base_commit);
        b.string_field("candidate_commit", m.candidate_commit);
        b.string_field("candidate_shape", r.candidate_shape);
        b.string_field("worktree", m.worktree);
        b.string_field("fitness_signals", m.fitness_signals);
        b.string_field("evidence", r.steps);
        b.field("magnitude", magnitude_json(r.magnitude));
        b.string_field("diff_text", r.diff_text);
        b.string_field("diff_json", r.diff_json);
        if prepared {
            b.string_field("organization_source_request_id", source.request_id);
            b.string_field("organization_source_digest", source.source_digest);
        }
        b.end_object();
        if prepared {
            if !append_once(self.journal, "review.requested", "review:" + m.id, b.result()) || !self.ensure_organization_source_review(source, m.candidate_commit) { return "pending"; }
        } else { let y = self.journal.append(self.journal.revision(), "review.requested", "review:" + m.id, b.result()); }
        self.board.notify("review", (if len(need.signers) > 0 { "signers " + approver_owners(need.signers) } else { authority }) + " needed for " + m.id + " (" + name + "): " + m.candidate_commit);
        // GH #583 M1, #1131: a model-backed position decides only on a spend
        // the one gate admits; refused, the refusal is the row a leg's is
        // (`attempt.allowance_refused review:<id>`) and the Review waits for
        // the Board (`hale dna review`), which needs no model.
        let gate = self.spend_gate("review:" + m.id, 0, "", "", 0, std::time::now());
        if gate.ok {
            ReviewRequested <- ReviewRequest {
                review_id: m.id, question: question, subject_digest: m.candidate_commit, required_authority: authority, signers: need.signers,
                mutation_id: m.id, change_class: m.change_class, seed: m.seed, disposition: name, base_commit: m.base_commit,
                diff_text: r.diff_text, evidence: r.steps, magnitude: magnitude_json(r.magnitude)
            };
        }
        return if post { "release" } else { "review" };
    }
    // Pending mutation Reviews, re-born from the Journal: every
    // `review.requested` that names a mutation and has no settlement.
    // The purpose Review is the Genome's own static child, never
    // rehydrated here.
    @unbounded
    fn rehydrate() {
        // who owns which position, before anything is admitted
        self.refresh_ownership();
        // a revocation in the record binds before anything is admitted
        self.restore_contractions();
        self.restore_revocations();
        let n = self.journal.revision();
        let mut i = 0;
        // durable ids continue where the Journal left them — this owner's
        // own (GH #666: a shared ledger holds every owner's births)
        self.bind_owner();
        let mut tasks = 0;
        let mut mutations = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "review.requested" && len(native_json_string(e.body, "organization_source_request_id")) > 0 {
                let request = self.org_source.request(native_json_string(e.body, "organization_source_request_id"));
                let codec = OrganizationSourceRequestCodec { };
                if codec.valid(request) && self.organization_source_owner(request) {
                    let restored = self.ensure_organization_source_review(request, native_json_string(e.body, "candidate_commit"));
                }
                i = i + 1; continue;
            }
            if e.kind == "task.born" && owned_by(self.ownership.me, e.entity) && id_number(e.entity, "t") > tasks { tasks = id_number(e.entity, "t"); }
            // card 07: an admitted (or refused) execution minted its id
            // before any summary row; a crash between the two must not
            // let that id be minted again
            if (e.kind == "workflow.admitted" || e.kind == "workflow.refused") && owned_by(self.ownership.me, e.entity) && id_number(e.entity, "t") > tasks { tasks = id_number(e.entity, "t"); }
            // card 14: a Mutation's request row precedes its proposal; a
            // crash between the two must not let that id be minted again
            if (e.kind == "mutation.proposed" || e.kind == "mutation.requested") && owned_by(self.ownership.me, e.entity) && id_number(e.entity, "m") > mutations { mutations = id_number(e.entity, "m"); }
            if e.kind == "review.requested" && len(native_json_string(e.body, "knowledge_binding_digest")) > 0 {
                let codec = KnowledgeBindingCodec { }; let request = codec.request_of(self.journal, e.entity[7..len(e.entity)]);
                if codec.valid(request) && self.ownership.admits(request.author) && self.ownership.admits(request.target) { let restored = self.ensure_binding_review(request); }
            }
            if e.kind == "review.requested" && len(native_json_string(e.body, "knowledge_edge_digest")) > 0 {
                let codec = KnowledgeEdgeCodec { }; let request = codec.request_of(self.journal, e.entity[7..len(e.entity)]);
                let endpoints = codec.endpoints(self.journal, self.verification.receipts, request, self.journal.revision());
                if codec.valid(request) && endpoints.ok && self.ownership.admits(endpoints.from_author) && self.ownership.admits(endpoints.from_target)
                    && self.ownership.admits(endpoints.to_author) && self.ownership.admits(endpoints.to_target) { let restored = self.ensure_edge_review(request); }
            }
            // a mutation's Review, or a knowledge proposal's (GH #583 K1)
            if e.kind == "review.requested" && (std::str::contains(e.body, "\"mutation_id\"") || std::str::contains(e.body, "\"knowledge_digest\"")) {
                let id = if std::str::contains(e.body, "\"mutation_id\"") { std::json::find_string_field(e.body, "mutation_id") } else { e.entity[7..len(e.entity)] };
                let mut settled = false;
                let mut settlement = "";
                let mut k = i + 1;
                while k < n {
                    let s = self.journal.read(k);
                    if s.kind == "review.settled" && s.entity == id { settled = true; settlement = s.body; }
                    k = k + 1;
                }
                if std::str::contains(e.body, "\"knowledge_digest\"") {
                    let restored = self.ensure_knowledge_review(id);
                    if restored && !settled { self.rehydrated = self.rehydrated + 1; }
                } else if !settled {
                    let need = self.review_routing(id, "change-deliver", "", false, true);
                    Review {
                        journal: self.review_journal,
                        signers: need.signers, gates: need.gates, fallback: need.fallback,
                        review_id: id,
                        question: std::json::find_string_field(e.body, "question"),
                        subject_digest: std::json::find_string_field(e.body, "subject_digest"),
                        required_authority: std::json::find_string_field(e.body, "required_authority"),
                        author: std::json::find_string_field(e.body, "author")
                    };
                    self.rehydrated = self.rehydrated + 1;
                } else if std::str::starts_with(settlement, "approve by ") && std::str::contains(e.body, "\"mutation_id\"") {
                    // Approved and never applied — the destination was
                    // dirty, and the organization stopped before it was
                    // cleared. The Review comes back settled, so that
                    // approving again after the restart is admitted by
                    // the same locus under the same rules (the fourth
                    // review round's finding 3: with no Review, the
                    // second approval met nothing at all).
                    let d = mutation_disposition(self.journal, id);
                    if d != "applied" && d != "retained" && d != "rejected" && d != "rolled_back" {
                        let need = self.review_routing(id, "change-deliver", "", false, true);
                        Review {
                            journal: self.review_journal,
                            signers: need.signers, gates: need.gates, fallback: need.fallback,
                            review_id: id,
                            question: std::json::find_string_field(e.body, "question"),
                            subject_digest: std::json::find_string_field(e.body, "subject_digest"),
                            required_authority: std::json::find_string_field(e.body, "required_authority"),
                            author: std::json::find_string_field(e.body, "author"),
                            settled: true, outcome: "approve", decided_by: settlement[11..len(settlement)]
                        };
                        self.rehydrated = self.rehydrated + 1;
                    }
                }
            }
            i = i + 1;
        }
        if tasks > self.minted { self.minted = tasks; }
        if mutations > self.mutations_minted { self.mutations_minted = mutations; }
        self.budget.rehydrate(self.journal, std::time::now());
        self.restore_cases();
        let completed = self.revisit_cases();
        self.reconcile_effects();
        self.fail_in_flight();
        self.note_unrecovered_intents();
        // card 18: every admitted root not yet settled runs again in the
        // one engine, from its admission
        self.resume_executions();
        self.escalate_owed_concerns();
        self.reconcile_governance();
    }
    // GH #748: a source whose concerns are in the record, over the
    // threshold, with no proposal of its own and no concern-escalate
    // execution still running for it, is owed one — rows a stopped
    // organism left, or that reached the record another way. The count is
    // the record's, so it is still there to be read: each such source is
    // escalated once, here, by an execution of concern-escalate that
    // raises nothing more (its raises are the record's) and proposes by
    // the rule that would have. A source with no parent was already
    // refused where it crossed the threshold and is left alone.
    @unbounded
    fn escalate_owed_concerns() {
        let mut rest = self.concerns.owed();
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let tab = std::str::index_of(line, "\t");
            let t = self.run_workflow(WorkflowAsk { id: line[0..tab], definition: "concern-escalate", revision: self.catalog.latest("concern-escalate"), inputs: line[(tab + 1)..len(line)] });
        }
    }
    // GH #604 rule 3: an effect requested and never resulted was in
    // dispatch when the organism stopped, and the outside may have
    // changed. Each is resolved by evidence where evidence exists and
    // marked unknown where it does not; an unknown effect is never
    // re-dispatched in silence — the gate refuses it until a person
    // resolves it (`hale dna effect resolve`).
    @unbounded
    fn reconcile_effects() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            // an execution attempt's claim (`attempt:<id>`) is reconciled
            // by the workflow runtime through its effect adapter, before
            // it decides on a redelivery (GH #646 card 12c), not here
            if e.kind == "effect.requested" && !std::str::starts_with(e.entity, "attempt:") {
                let key = e.entity;
                let st = effect_status(self.journal, key);
                if !st.done {
                    let mut verdict = "unknown (reconciled after a restart: no evidence either way)";
                    if effect_family(key) == "apply" {
                        let cand = effect_subject(key);
                        let head = self.gateway.head();
                        let req = mutation_review_request(self.journal, e.body);
                        if len(native_json_string(req, "organization_source_request_id")) == 0 {
                            verdict = if head == cand { "ok (reconciled after a restart: the genome is at the candidate)" } else { "unknown (reconciled after a restart: the genome is at " + head + ", not the candidate)" };
                        }
                    } else if effect_family(key) == "rollback" {
                        let after = effect_subject(key);
                        let c = std::str::index_of(after, ":");
                        let base = if c < 0 { after } else { after[(c + 1)..len(after)] };
                        let head = self.gateway.head();
                        verdict = if head == base { "ok (reconciled after a restart: the genome is at the base)" } else { "unknown (reconciled after a restart: the genome is at " + head + ", not the base)" };
                    } else if std::str::starts_with(key, "worktree.open:") {
                        let m = key[14..len(key)];
                        verdict = if std::io::fs::file_exists(self.gateway.workspaces.path_of(m)) { "ok (reconciled after a restart: the worktree is there)" } else { "failed (reconciled after a restart: no worktree was opened)" };
                    }
                    let x = self.journal.append(self.journal.revision(), "effect.result", key, verdict);
                    if std::str::starts_with(verdict, "unknown") { self.board.notify("effect", key + ": outcome unknown after a restart; `hale dna effect resolve " + key + " --outcome ok|failed`"); }
                }
            }
            i = i + 1;
        }
    }
    // GH #604 rule 1, the shape from before it: an `intent.offered` with
    // no admission naming it (card 18) was admitted and lost, or never admitted —
    // the record cannot tell which, and work may already have run. It
    // is not re-offered; the record says so, and the asker asks again.
    @unbounded
    fn note_unrecovered_intents() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "intent.offered" {
                let mut born = false;
                let mut noted = false;
                let mut k = i + 1;
                while k < n {
                    let s = self.journal.read(k);
                    if s.kind == "workflow.admitted" && std::json::find_string_field(s.body, "request") == e.entity { born = true; }
                    if s.kind == "intent.unrecovered" && s.entity == e.entity { noted = true; }
                    k = k + 1;
                }
                if !born && !noted {
                    let x = self.journal.append(self.journal.revision(), "intent.unrecovered", e.entity, "offered before a restart and no Task was born; not re-admitted — ask again");
                }
            }
            i = i + 1;
        }
    }
    // The task a mutation was proposed for ("task <id> <class>: …").
    fn task_of_mutation(mutation_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut exact = "";
        let mut summary = "";
        while i < n {
            let e = self.journal.read(i);
            // card 14: the Mutation's own request row names its Task; the
            // summary row from before it is read when there is no other
            if e.kind == "mutation.requested" && e.entity == mutation_id && len(exact) == 0 { exact = std::json::find_string_field(e.body, "task_id"); }
            if e.kind == "mutation.proposed" && e.entity == mutation_id && std::str::starts_with(e.body, "task ") {
                let rest = e.body[5..len(e.body)];
                let sp = std::str::index_of(rest, " ");
                summary = if sp < 0 { rest } else { rest[0..sp] };
            }
            i = i + 1;
        }
        return if len(exact) > 0 { exact } else { summary };
    }
    // The Mutation proposed for a Task, by the Task it names; "" when none.
    @unbounded
    fn mutation_of_task(task_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "mutation.proposed" && std::str::starts_with(e.body, "task " + task_id + " ") { return e.entity; }
            if e.kind == "mutation.requested" && std::json::find_string_field(e.body, "task_id") == task_id { return e.entity; }
            i = i + 1;
        }
        return "";
    }
    // A Mutation whose last word in the record is `proposed`, `worktree`
    // or `located` was in flight — an editor mid-attempt — when the
    // organization stopped (GH #566 F7). Nobody resumes an attempt: it
    // failed, and the record says so instead of showing it in flight
    // forever. Bounded by the mutations the record holds.
    @unbounded
    fn fail_in_flight() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            // A Mutation's recovery is derived from every row it has, from
            // its first: its request row (card 14) — or, from before that
            // row, its proposal, when no request names it. The summary row
            // is compatibility: its absence is not the absence of progress.
            let first = e.kind == "mutation.requested" || (e.kind == "mutation.proposed" && !row_exists(self.journal, "mutation.requested", e.entity));
            if first {
                // Exact prepared source has its own resumable stages. Only a
                // proven admitted request and prior matching started pin can
                // exempt it from abandoned model-attempt cleanup.
                if self.org_source.prepared(e) { i = i + 1; continue; }
                let id = e.entity;
                let mut last = e.kind[9..len(e.kind)];
                let mut removed = false;
                let mut k = i + 1;
                while k < n {
                    let s = self.journal.read(k);
                    if s.entity == id && std::str::starts_with(s.kind, "mutation.") {
                        last = s.kind[9..len(s.kind)];
                        removed = s.kind == "mutation.worktree" && std::str::starts_with(s.body, "removed");
                    }
                    k = k + 1;
                }
                // in flight: nothing past the request, the proposal, an open
                // worktree (`mutation.worktree … removed` is the worktree
                // GONE, not opened) or a located file. A candidate, a Review,
                // an outcome — or an earlier failure — after them is the
                // Mutation's own state, and this fails nothing twice
                if last == "requested" || last == "proposed" || (last == "worktree" && !removed) || last == "located" {
                    let x = self.journal.append(self.journal.revision(), "mutation.failed", id, "in flight (" + last + ") when the organization stopped; nothing resumes an attempt");
                    let y = self.gateway.workspaces.remove(id);
                }
            }
            i = i + 1;
        }
    }
    // Whether the journal holds a row of `kind` for `entity`, anywhere.
    @unbounded
    // This node's name in its claims (GH #1026).
    fn node_name() -> String {
        if len(self.node) > 0 { return self.node; }
        if std::env::var_exists("HALE_DNA_NODE") && len(std::env::var("HALE_DNA_NODE")) > 0 {
            self.node = std::env::var("HALE_DNA_NODE");
        } else {
            let h = run_tool("hostname");
            self.node = (if h.code == 0 { trim_nl(h.stdout) } else { "localhost" }) + ":" + to_string(std::process::pid());
        }
        return self.node;
    }
    // Take `key` for `ttl` seconds in memory (GH #1026): true when this
    // node holds it now. Nothing is recorded yet: a claim is recorded
    // once the node has read that the act is still its to take.
    @unbounded
    fn take_claim(key: String, ttl: Int) -> Bool {
        let me = self.node_name();
        let l = self.claims.claim(key, me, ttl);
        if !l.present || l.holder != me { return false; }
        self.claimed = l;
        return true;
    }
    // The claim just taken, as a `claim.taken` row naming this node, its
    // token and until when: the record shows who took what, and a second
    // node's take after the first one's expiry. Without memory there is
    // no one to race and nothing to record.
    @unbounded
    fn note_claim(key: String) {
        if !self.claims.ready() { return; }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("holder", self.claimed.holder);
        b.int_field("token", self.claimed.token);
        b.int_field("until", self.claimed.expires);
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "claim.taken", key, b.result());
    }
    // Give `key` back on completion; a claim that was recorded is given
    // back as a `claim.released` row.
    @unbounded
    fn give_up_claim(key: String, noted: Bool) {
        let me = self.node_name();
        if !self.claims.release_claim(key, me) || !noted || !self.claims.ready() { return; }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("holder", me);
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "claim.released", key, b.result());
    }
    fn status() -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.int_field("asked", self.asked);
        b.int_field("mutations", self.mutations_minted);
        b.string_field("last_mutation", self.last_mutation);
        b.int_field("reviews_open", self.reviews_open);
        b.int_field("rehydrated", self.rehydrated);
        b.int_field("applied", self.applied);
        b.int_field("restarts_requested", self.restarts_requested);
        b.int_field("journal_revision", self.journal.revision());
        b.int_field("executions_asked", self.executions_asked);
        b.int_field("executions_settled", self.executions_settled);
        // one count per family of the writes the record refused, summed: the
        // Mutations' and Work's cases'
        b.int_field("record_refusals", self.mutation_refusals + self.cases.record_refusals);
        b.string_field("routing", self.work.policy());
        b.string_field("review_policy", self.review_policy.name());
        b.string_field("deployment", self.deployment.kind());
        b.int_field("knowledge_revision", self.knowledge.revision);
        b.int_field("notifications", self.board.notifications());
        b.string_field("last_task", self.last_task);
        b.end_object();
        return b.result();
    }
}

// A `review.routed` body: the definition, the signers with their holders,
// the gates, and whether a path was left to the Review's own authority.
fn routed_body(definition: String, need: RouteRequirement, why: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("definition", definition);
    b.string_field("signers", need.signers);
    b.string_field("gates", need.gates);
    b.bool_field("fallback", need.fallback);
    if len(why) > 0 { b.string_field("why", why); }
    b.end_object();
    return b.result();
}
