// The existing Host authority read, shared with the co-located runtime reader.
// It reads the lease row in memory; it never acquires or renews a lease.
import "../core" as dna;

const FENCE_MARGIN: Int = 5;

type BodyLeaseView {
    ok: Bool = true;
    present: Bool = false;
    holder: String = "";
    token: Int = 0;
    expires: Int = 0;
    sha: String = "";
}

locus HostAuthority {
    params { root: String = ""; }
    fn record_head() -> dna::Head {
        let r = dna::MemoryRecord { repo: self.root };
        return r.head("journal");
    }
    fn owner() -> String {
        let r = dna::MemoryRecord { repo: self.root };
        return r.setting("owner");
    }
    fn trust() -> String {
        let r = dna::MemoryRecord { repo: self.root };
        let t = r.setting("trust");
        return if len(t) == 0 { "local" } else { t };
    }
    fn row_verified(sha: String) -> Bool {
        let r = dna::MemoryRecord { repo: self.root };
        return r.signer(sha).verified;
    }
    // GH #1123: a body that names its organization (`dna.owner`) is one
    // of a shared record's bodies; which positions it owns is the graph's.
    fn shared() -> Bool { return len(self.owner()) > 0; }
    fn lease_key() -> String { if self.shared() { return "owner/" + self.owner(); } return "body"; }
    fn store_lease(sl: dna::MemoryLeases) -> BodyLeaseView {
        // GH #985: the lease table in memory, through the process's own
        // handle, under whichever role it holds (the body's spine, or a head)
        let l = sl.current(self.lease_key());
        if !sl.reachable { return BodyLeaseView { ok: false }; }
        if len(l.holder) == 0 && l.token == 0 { return BodyLeaseView { }; }
        return BodyLeaseView {
            present: l.present,
            holder: l.holder,
            token: l.token,
            expires: l.expires,
            sha: to_string(l.token),
        };
    }
    // GH #1590: the lease is a row of memory, as the record is
    fn body_lease(leases: dna::MemoryLeases) -> BodyLeaseView { return self.store_lease(leases); }
}
