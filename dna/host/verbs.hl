// dna/host/verbs.hl — the projections `hale dna` prints, from the
// record alone (GH #566 F8): status, history, the Reviews, the Board's
// queue, a report, pressure, the fleet; and the catalog's probe.

import "../core" as dna;
import "../organization_runtime" as org_runtime;

// One verb's answer: lines to print, or an error.
type Answer {
    ok: Bool = true;
    text: String = "";
}

fn fail(why: String) -> Answer {
    return Answer { ok: false, text: why };
}

fn answer(text: String) -> Answer {
    return Answer { ok: true, text: text };
}

// A loaded projection, or the reason there is none.
// The ledger half is the process's own memory handle (GH #985): a
// projection never opens memory of its own.
fn open_projection(root: String, seed: String, toolchain: String, memory: dna::Memory) -> Projection {
    return Projection { root: root, seed: seed, toolchain: toolchain, j: dna::RoutedJournal { record: dna::GitJournal { repo: root, author: "host" }, ledger: memory.ledger } };
}

fn no_record(root: String) -> String {
    return "no record at " + RECORD_REF + " in " + root + " (run `hale dna init`)";
}

// "" when the record has a head; otherwise why a verb cannot go on: no
// record, or a head that could not be read, which is never "no record"
// (GH #961).
fn record_refusal(root: String) -> String {
    let h = record_head(root);
    if !h.ok { return "the record at " + RECORD_REF + " in " + root + " could not be read: " + h.why; }
    if h.absent { return no_record(root); }
    return "";
}

// ---- status ---------------------------------------------------------

fn status_verb(root: String, seed: String, toolchain: String, json: Bool, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, toolchain, memory);
    if json { return answer(p.json() + "\n"); }
    // GH #617: the combination this organism is, detected from its
    // pieces, and who runs it — never a stored label
    let now = std::time::now();
    let gap = credential_gap(p);
    return answer(p.text() + "profile:    " + profile_name(root, memory) + "\n" + "body:       " + body_line(root, now, memory) + (if len(gap) > 0 { "; no credential for the model (none of " + gap + " is set where the body runs): `hale dna secret set <NAME> [--body <user@host>]`" } else { "" }) + "\n" + "memory:     " + routing_line(root, memory) + "\n");
}

// ---- the organism's combination (GH #617) ---------------------------
// An organism is one point in a space of independent capabilities —
// where the body runs, whether a hosted head exists, whether a fleet
// expresses it, which records it is connected to — declared by its
// pieces and detected here, never stored. Each line is one axis.

fn fleet_name(root: String) -> String {
    let toml = std::io::fs::read_file(root + "/hale.toml") or "";
    let at = std::str::index_of(toml, "[dna]");
    if at < 0 { return ""; }
    let sect = toml[at..len(toml)];
    let f = std::str::index_of(sect, "fleet");
    if f < 0 { return ""; }
    let rest = sect[f..len(sect)];
    let q1 = std::str::index_of(rest, "\"");
    if q1 < 0 { return ""; }
    let after = rest[(q1 + 1)..len(rest)];
    let q2 = std::str::index_of(after, "\"");
    if q2 < 0 { return ""; }
    return after[0..q2];
}

fn this_host() -> String {
    let h = dna::run_tool("hostname");
    return if h.code == 0 { dna::trim_nl(h.stdout) } else { "localhost" };
}

fn holder_host(holder: String) -> String {
    let at = std::str::index_of(holder, "@");
    let colon = std::str::index_of(holder, ":");
    if at < 0 || colon < at { return ""; }
    return holder[(at + 1)..colon];
}

fn profile_name(root: String, memory: dna::Memory) -> String {
    let remote = record_remote(root);
    let l = body_lease_read(root, memory);
    let live = l.ok && body_live(l, std::time::now());
    let here = live && holder_host(l.holder) == this_host();
    let mut name = if len(remote) == 0 { "local" } else if live && !here { "remote body" } else if live { "local body, shared record" } else { "shared record, no body" };
    if len(fleet_name(root)) > 0 { name = name + " + fleet"; }
    if forge_kind(root) != "none" { name = name + " + " + forge_kind(root); }
    return name + " (detected)";
}

fn profile_verb(root: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let now = std::time::now();
    let remote = record_remote(root);
    let url = if len(remote) > 0 { rec(root).remote_url(remote) } else { "" };
    let mut out = "profile:     " + profile_name(root, memory) + "\n";
    out = out + "record:      " + (if len(remote) == 0 { "this clone only (no remote; `git remote add origin …` shares it)" } else { "shared over " + remote + " (" + url + ")" }) + "\n";
    out = out + "body:        " + body_line(root, now, memory) + "\n";
    out = out + "head:        this clone (" + root + "); hosted head: none\n";
    let fleet = fleet_name(root);
    out = out + "fleet:       " + (if len(fleet) == 0 { "none (`[dna] fleet = \"<name>\"` in hale.toml names one)" } else { fleet }) + "\n";
    let owner = std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER");
    let compose = std::io::fs::file_exists(root + "/dna/compose.yaml");
    out = out + "memory:      " + (if owner { "a Postgres of your own (HALE_DNA_MEMORY_DSN_OWNER)" } else if compose { "compose (dna/compose.yaml, under `hale dna dev`)" } else { "none" }) + (if dna::dsn_set(dna::HEAD_DSN_ENV) { "; this head reads it (HALE_DNA_MEMORY_DSN_HEAD)" } else { "" }) + "\n";
    out = out + "trust:       " + trust_mode(root) + (if trust_mode(root) == "signed" { " (rows from the record are admitted only with a signature git verifies)" } else { " (every writer to the record is trusted)" }) + "\n";
    // GH #648: the forge the host found, whichever it is
    out = out + "github:      " + forge_name(root) + "\n";
    out = out + "connections: none\n";
    return answer(out);
}

// `hale dna body [claim [--force] | release] [--as <who>]`
// Release the lease `holder` holds at `token`, against the version the
// authority has now, re-read after each lost race (a renewal in between):
// five tries, then false.
fn body_lease_take(root: String, holder: String, token: Int, memory: dna::Memory) -> Bool {
    let mut tries = 0;
    while tries < 5 {
        tries = tries + 1;
        let cur = body_lease_read(root, memory);
        if !cur.ok { return false; }
        if !cur.present || cur.holder != holder || cur.token != token { return !cur.present; }
        if body_lease_write(root, BodyLease { present: false, holder: cur.holder, token: cur.token, expires: 0 }, cur.sha, memory) { return true; }
    }
    return false;
}

fn body_verb(root: String, sub: String, force: Bool, who_flag: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let now = std::time::now();
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    if len(sub) == 0 { return answer("body: " + body_line(root, now, memory) + "\n"); }
    let cur = body_lease_read(root, memory);
    if !cur.ok { return fail("body: the record's remote cannot be reached"); }
    if sub == "claim" {
        // nothing to take: no body ever ran this record, or the last one
        // released its lease; `hale dna run` takes it
        if !cur.present { return answer("body: " + body_line(root, now, memory) + "\n"); }
        // a lease that has expired is a body that is gone. Without
        // --force the claim says so, as the status line does, and leaves
        // it to `hale dna run`; with --force it takes the lease the same
        // way it takes a live one — a body that died a second ago and one
        // that died a minute ago are the same body, and the operator who
        // asked for the lease to be taken should not be told to ask again
        // because the clock crossed the TTL between their reading and
        // their claim (a CI runner did exactly that).
        if !body_live(cur, now) && !force { return answer("body: " + body_line(root, now, memory) + "\n"); }
        if body_live(cur, now) && !force { return fail("body: live on " + cur.holder + ", ticked " + ago(now - (cur.expires - BODY_TTL)) + "; a record admits one body. `hale dna body claim --force` takes the lease from a body that is gone (it stops itself when it next asserts the lease)"); }
        // the body renews its lease every few seconds: a claim that read
        // the lease just before a renewal reads it again and claims the
        // renewed one, a few times, before giving up
        if !body_lease_take(root, cur.holder, cur.token, memory) { return fail("body: the lease moved while claiming; try again"); }
        let ok = append_as(root, "body.claimed", cur.holder, "{\"token\": " + to_string(cur.token) + ", \"forced\": true, \"from\": " + quote(cur.holder) + ", \"by\": " + quote(who) + "}", who);
        let s = sync_record(root, memory);
        return answer("body: the lease of " + cur.holder + " was taken by " + who + " (body.claimed, forced); that body stops when it next asserts the lease, and the next `hale dna run` takes it\n");
    }
    if sub == "release" {
        if !cur.present { return answer("body: " + body_line(root, now, memory) + "\n"); }
        let mine = body_holder(root);
        if cur.holder != mine && !force { return fail("body: the lease is held by " + cur.holder + ", not this clone (" + mine + "); `hale dna body release --force` releases another's"); }
        if !body_lease_take(root, cur.holder, cur.token, memory) { return fail("body: the lease moved while releasing; try again"); }
        let ok = append_as(root, "body.released", cur.holder, "{\"token\": " + to_string(cur.token) + ", \"by\": " + quote(who) + "}", who);
        let s = sync_record(root, memory);
        return answer("body: released the lease of " + cur.holder + " (body.released)\n");
    }
    return fail("body: `hale dna body`, `body claim [--force]`, `body release [--force]`, `body provision <user@host> [--dsn …] [--dir …] [--dry-run]`, `body start|stop|logs [--body <user@host>]`");
}

// ---- history --------------------------------------------------------

fn looks_like_id(t: String) -> Bool {
    // GH #666: an owner's prefix, `acme:t3`
    let colon = std::str::index_of(t, ":");
    if colon > 0 && colon < len(t) - 1 { return looks_like_id(t[(colon + 1)..len(t)]); }
    if len(t) < 2 || len(t) > 20 { return false; }
    let c = t[0..1];
    if !(c == "i" || c == "t" || c == "w" || c == "a" || c == "r") { return false; }
    let mut i = 1;
    while i < len(t) {
        let b = std::str::byte_at_unchecked(t, i);
        let alnum = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
        if !alnum { return false; }
        i = i + 1;
    }
    return true;
}

fn mentions(e: dna::Event, id: String) -> Bool {
    return e.entity == id || std::str::ends_with(e.entity, ":" + id) || std::str::contains(e.body, id);
}

fn strip_prefixes(entity: String) -> String {
    let mut s = entity;
    if std::str::starts_with(s, "review:") { s = s[7..len(s)]; }
    if std::str::starts_with(s, "locus:") { s = s[6..len(s)]; }
    return s;
}

fn has(ids: String, id: String) -> Bool {
    return std::str::contains(ids, "\n" + id + "\n");
}

@unbounded
fn history_verb(root: String, entity: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, ".", "", memory);
    let n = p.rows();
    let mut ids = "\n";
    if len(entity) > 0 {
        ids = ids + entity + "\n";
        // rows about the entity; expand through ids that co-occur
        let mut round = 0;
        while round < 3 {
            round = round + 1;
            let snapshot = ids;
            let mut i = 0;
            while i < n {
                let e = p.row(i);
                if mentioned_by_any(e, snapshot) {
                    let se = strip_prefixes(e.entity);
                    if !has(ids, se) { ids = ids + se + "\n"; }
                    let mut tok = "";
                    let mut k = 0;
                    while k <= len(e.body) {
                        let ch = if k < len(e.body) { e.body[k..(k + 1)] } else { " " };
                        if ch == ":" || ch == " " || ch == "\n" || ch == "\t" || ch == "," || ch == "\"" {
                            if looks_like_id(tok) && !has(ids, tok) { ids = ids + tok + "\n"; }
                            tok = "";
                        } else {
                            tok = tok + ch;
                        }
                        k = k + 1;
                    }
                }
                i = i + 1;
            }
        }
    }
    let mut out = "record " + RECORD_REF + " — " + to_string(n) + " event(s), " + p.chain_line() + "\n";
    let mut lines = "";
    let mut selected = 0;
    let mut i = 0;
    while i < n {
        let e = p.row(i);
        if len(entity) == 0 || mentioned_by_any(e, ids) {
            selected = selected + 1;
            let b = if len(e.body) > 96 { e.body[0..96] + "…" } else { e.body };
            lines = lines + std::str::pad_left(to_string(e.seq), 5, " ") + "  " + std::str::pad_right(e.kind, 22, " ") + " " + std::str::pad_right(e.entity, 28, " ") + " " + b + "\n";
            // GH #611: an attempt's own history shows what each of its
            // model calls sent, from the receipt, never re-composed. A
            // wider history names the calls and leaves the bodies to the
            // attempt's (an editor's prompt carries whole files).
            if len(entity) > 0 && e.entity == entity && e.kind == "model.called" {
                let bodies = std::json::find_string_field(e.body, "bodies");
                lines = lines + body_block(root, "prompt", std::json::find_string_field(e.body, "prompt_digest"), bodies);
                lines = lines + body_block(root, "context", std::json::find_string_field(e.body, "context_digest"), bodies);
            }
        }
        i = i + 1;
    }
    if len(entity) > 0 { out = out + "history of " + entity + ": " + to_string(selected) + " event(s)\n"; }
    return answer(out + lines);
}

// One body of a model call, as the receipt has it: a header naming
// the digest and the byte count, then exactly those bytes, then a
// newline and `end of <what>`. The count is what makes the block
// unambiguous whatever the text ends with.
fn body_block(root: String, what: String, digest: String, bodies: String) -> String {
    if len(digest) == 0 { return ""; }
    let pad = "       ";
    if std::str::starts_with(bodies, "withheld") { return pad + what + " " + digest + " " + bodies + ": no body is stored\n"; }
    let hexd = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
    let r = receipt_read(root, hexd);
    let redacted = redaction_line(root, digest);
    if !r.present && len(redacted) > 0 { return pad + what + " " + digest + " " + redacted + "\n"; }
    if !r.present {
        let why = if len(bodies) == 0 { " (the call was recorded before prompts were receipts)" } else { " (`hale dna sync` fetches receipts)" };
        return pad + what + " " + digest + " is not among this clone's receipts" + why + "\n";
    }
    return pad + what + " " + digest + " (" + to_string(len(r.text)) + " bytes)\n" + r.text + "\n" + pad + "end of " + what + "\n";
}

fn mentioned_by_any(e: dna::Event, ids: String) -> Bool {
    let mut rest = ids;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let id = if nl < 0 { rest } else { rest[0..nl] };
        if len(id) > 0 && mentions(e, id) { return true; }
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return false;
}

// ---- reviews --------------------------------------------------------

@unbounded
fn review_list(p: Projection) -> Answer {
    let ids = p.review_ids();
    let n = list_len(ids);
    let mut out = to_string(p.pending_reviews()) + " pending review(s) of " + to_string(n) + "\n";
    let mut i = 0;
    let mut design = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        if r.state == "pending" && r.group != "design" {
            out = out + "  " + r.id + " needs " + r.required_authority + " — " + r.question + "\n";
            if r.is_mutation {
                out = out + "      " + r.change_class + " · candidate " + short(r.candidate_commit) + " · evidence " + r.evidence + " · disposition " + r.disposition + "\n";
            }
        }
        if r.state == "pending" && r.group == "design" { design = design + 1; }
        i = i + 1;
    }
    // GH #596 C: the toolchain's seeded design, one Review per practice
    // (a Review pins one digest and settles with one outcome), listed
    // under one heading so the Board can read them as a set
    if design > 0 {
        out = out + "  design — " + to_string(design) + " seeded practice(s), each its own Review:\n";
        i = 0;
        while i < n {
            let r = p.review_of(nth(ids, i));
            if r.state == "pending" && r.group == "design" { out = out + "      " + r.id + " — " + r.question + "\n"; }
            i = i + 1;
        }
        out = out + "      decide one with `hale dna review <id> …`, or all pending with `hale dna review design approve|reject`\n";
    }
    return answer(out + "render one with `hale dna review <id>`; decide with `hale dna review <id> approve|revise|reject|abstain`\n");
}

fn pending_ids(p: Projection) -> String {
    let mut out = "";
    let ids = p.review_ids();
    let n = list_len(ids);
    let mut i = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        if r.state == "pending" { out = out + (if len(out) > 0 { ", " } else { "" }) + r.id; }
        i = i + 1;
    }
    return out;
}

// The magnitude vector's facets, in the order the projection listed
// them (by name), never a score.
fn magnitude_facets(raw: String) -> String {
    let mut out = "";
    let bools = "contract_change effects_widened irreversible law_touched ownership_crossed placement_change state_migration ";
    let ints = "external_blast loci novelty ";
    // alphabetical over both kinds
    let order = "contract_change effects_widened external_blast irreversible law_touched loci novelty ownership_crossed placement_change state_migration ";
    let mut rest = order;
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let k = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        if std::str::contains(bools, k + " ") {
            if std::json::find_bool_field(raw, k) { out = out + (if len(out) > 0 { ", " } else { "" }) + k; }
        } else {
            let v = std::json::find_int_field(raw, k);
            if v != 0 { out = out + (if len(out) > 0 { ", " } else { "" }) + k + " " + to_string(v); }
        }
    }
    if len(out) == 0 { return "nothing moved in the model"; }
    return out;
}

fn indent_lines(text: String, prefix: String) -> String {
    let mut out = "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        out = out + prefix + line + "\n";
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return out;
}

@unbounded
fn render_review(p: Projection, id: String, iris: Bool) -> Answer {
    let r = p.review_of(id);
    if len(r.id) == 0 { return fail("no `review.requested` for `" + id + "` in the Journal (pending: " + pending_ids(p) + ")"); }
    let mut out = "review " + id + " [" + r.state + "]: " + r.question + "\n";
    out = out + "  needs " + r.required_authority + " · candidate " + r.subject_digest + (if r.state == "pending" { "" } else { " · settled " + r.settled }) + "\n";
    if r.refusal_count > 0 { out = out + indent_lines(dna::trim_nl(r.refusals), "  refused a verdict: "); }
    if r.has_reasoned { out = out + "  why:\n" + indent_lines(dna::trim_nl(r.reasoned), "    "); }
    if !r.is_mutation {
        return answer(out + "decide: hale dna review " + id + " approve|revise|reject|abstain [--as <you>] [--comment <c>]\n");
    }
    out = out + "  mutation " + r.mutation_id + " (" + r.change_class + ") by " + r.author + " · disposition under the grant: " + r.disposition + " · shape " + r.candidate_shape + "\n";
    if len(r.magnitude_raw) > 0 { out = out + "  magnitude: " + magnitude_facets(r.magnitude_raw) + "\n"; }
    out = out + "\nsource diff (git " + short(r.base_commit) + " .. " + short(r.candidate_commit) + "):\n";
    let d = genome_diff(p.root, r.base_commit, r.candidate_commit);
    if d.code == 0 { out = out + indent_lines(dna::trim_nl(d.stdout), "  "); } else { out = out + "  (git diff failed: " + dna::trim_nl(d.stderr) + ")\n"; }
    out = out + "\nsemantic diff (hale model diff, baseline .. candidate):\n";
    let sem = receipt_read(p.root, r.diff_text);
    if sem.present { out = out + indent_lines(dna::trim_nl(sem.text), "  "); } else { out = out + "  (no semantic diff receipt " + r.diff_text + ")\n"; }
    out = out + "\nevidence (" + r.evidence + "):\n";
    out = out + "  " + std::str::pad_right("step", 10, " ") + " " + std::str::pad_right("ok", 6, " ") + " " + std::str::pad_right("code", 5, " ") + " " + std::str::pad_right("receipt", 14, " ") + " bytes\n";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if std::str::starts_with(e.kind, "evidence.") && e.entity == r.candidate_commit && e.kind != "evidence.magnitude" {
            let ok = if std::json::find_bool_field(e.body, "ok") { "yes" } else { "NO" };
            out = out + "  " + std::str::pad_right(e.kind[9..len(e.kind)], 10, " ") + " " + std::str::pad_right(ok, 6, " ") + " " + std::str::pad_right(to_string(std::json::find_int_field(e.body, "code")), 5, " ") + " " + std::str::pad_right(short(std::json::find_string_field(e.body, "output_digest")), 14, " ") + " " + to_string(std::json::find_int_field(e.body, "bytes")) + "\n";
        }
        i = i + 1;
    }
    out = out + "  receipts: refs/dna/receipts/<digest> (git cat-file -p)\n\n";
    out = out + "decide: hale dna review " + id + " approve|revise|reject|abstain [--as <you>] [--comment <c>] [--digest " + short(r.candidate_commit) + "]\n";
    if iris {
        if len(r.diff_json) == 0 { return fail("--iris: this review has no semantic diff document"); }
        let doc = receipt_read(p.root, r.diff_json);
        if !doc.present { return fail("--iris: no diff receipt " + r.diff_json); }
        std::io::fs::mkdir(p.root + "/.hale/dna/scratch") or discard;
        let doc_path = p.root + "/.hale/dna/scratch/review-" + id + ".diff.json";
        let wrote = write_text(doc_path, doc.text) or false;
        if !wrote { return fail("--iris: cannot write " + doc_path); }
        let hale = std::env::var("HALE_BIN");
        let launched = dna::run_tool("sh\n-c\ncd " + p.root + " && nohup " + hale + " iris --diff " + doc_path + " >/dev/null 2>&1 & echo $!");
        out = out + "iris: review perspective [4] on " + r.diff_json + " (pid " + dna::trim_nl(launched.stdout) + "); iris shows the diff, the verdict is given with hale dna review " + id + " approve|revise|reject|abstain\n";
    }
    return answer(out);
}

// ---- board ----------------------------------------------------------

@unbounded
fn board_verb(p: Projection) -> Answer {
    let mut mine = 0;
    let mut lines = "";
    let mut leaders = 0;
    let ids = p.review_ids();
    let n = list_len(ids);
    let mut i = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        if r.state == "pending" && (r.required_authority == "board" || r.required_authority == "maintainer") {
            mine = mine + 1;
            let why = if r.is_mutation { " — " + r.change_class + " · " + (if len(r.seed) == 0 { "the application" } else { r.seed }) + " · disposition " + r.disposition } else { "" };
            lines = lines + "  " + r.id + "  " + r.question + why + "\n";
        }
        if r.state == "pending" && r.required_authority == "leader" { leaders = leaders + 1; }
        i = i + 1;
    }
    let mut out = "board: " + to_string(mine) + " review(s) need your verdict\n" + lines;
    if leaders > 0 { out = out + "leader: " + to_string(leaders) + " review(s) inside the grant, being decided\n"; }
    // GH #616: a handed Task a reported decision could not settle
    let tids = p.task_ids();
    let ntasks = list_len(tids);
    let mut waits = "";
    let mut k = 0;
    while k < ntasks {
        let t = p.task_of(nth(tids, k));
        if t.state == "handed" && len(t.waiting) > 0 { waits = waits + "  " + t.id + " (" + t.assignee + ") waits on a native decision: " + t.waiting + "\n"; }
        k = k + 1;
    }
    if len(waits) > 0 { out = out + "tasks waiting:\n" + waits; }
    let proposals = p.count("appendage.proposed");
    if proposals > 0 {
        out = out + "proposals: " + to_string(proposals) + "\n";
        i = 0;
        while i < p.rows() {
            let e = p.row(i);
            if e.kind == "appendage.proposed" {
                let mut cand = "";
                let mut k = 0;
                while k < p.rows() {
                    let c = p.row(k);
                    if c.kind == "appendage.candidate" && c.entity == e.entity && len(cand) == 0 { cand = " → " + c.body; }
                    k = k + 1;
                }
                out = out + "  " + e.entity + ": " + e.body + cand + "\n";
            }
            i = i + 1;
        }
    }
    let last = p.last_of("report.filed");
    if last.seq >= 0 { out = out + "last report (#" + to_string(last.seq) + "): " + last.body + "\n"; }
    let grant = p.count("grant.changed");
    if grant > 0 { out = out + "grant changes: " + to_string(grant) + "\n"; }
    // GH #617: a missing credential surfaces here at once, not on a task hours later
    let gap = credential_gap(p);
    if len(gap) > 0 { out = out + "body: no credential for the model (none of " + gap + " is set where the body runs); `hale dna secret set <NAME> [--body <user@host>]` puts one there\n"; }
    return answer(out + "decide with `hale dna review <id> approve|revise|reject`; `hale dna review <id>` renders one\n");
}

// ---- report ---------------------------------------------------------

@unbounded
fn report_verb(p: Projection, memory: dna::Memory) -> Answer {
    let last = p.last_of("report.filed");
    let since = if last.seq >= 0 { last.seq + 1 } else { 0 };
    let mut proposed = 0;
    let mut reviewed = 0;
    let mut applied = 0;
    let mut retained = 0;
    let mut rolled = 0;
    let mut rejected = 0;
    let mut escalated = 0;
    let mut pressure = 0;
    let mut proposals = 0;
    let mut calls = 0;
    let mut cost = 0;
    let mut settled = "";
    let mut i = since;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "mutation.proposed" { proposed = proposed + 1; }
        if e.kind == "review.requested" { reviewed = reviewed + 1; if std::str::contains(e.body, "\"required_authority\": \"board\"") { escalated = escalated + 1; } }
        if e.kind == "mutation.applied" { applied = applied + 1; }
        if e.kind == "mutation.retained" { retained = retained + 1; }
        if e.kind == "mutation.rolled_back" { rolled = rolled + 1; }
        if e.kind == "mutation.rejected" { rejected = rejected + 1; }
        if e.kind == "pressure.raised" { pressure = pressure + 1; }
        if e.kind == "appendage.proposed" { proposals = proposals + 1; }
        if e.kind == "model.called" { calls = calls + 1; cost = cost + std::json::find_int_field(e.body, "cost_micros"); }
        if e.kind == "review.settled" { settled = settled + (if len(settled) > 0 { ", " } else { "" }) + e.entity + " " + e.body; }
        i = i + 1;
    }
    let body = "since #" + to_string(since) + ": proposed " + to_string(proposed) + " · reviewed " + to_string(reviewed) + " · applied " + to_string(applied) + " · retained " + to_string(retained) + " · rolled back " + to_string(rolled) + " · rejected " + to_string(rejected) + " · escalated " + to_string(escalated) + " · pressure " + to_string(pressure) + " · proposals " + to_string(proposals) + " · model calls " + to_string(calls) + " (" + to_string(cost) + " µ$) · settled: " + (if len(settled) == 0 { "none" } else { settled });
    let id = "r" + to_string(p.rows());
    if !append_as(p.root, "report.filed", id, body, "") { return fail("report: the record refused the append"); }
    let s = sync_record(p.root, memory);
    return answer("report " + id + " filed: " + body + "\n");
}

// ---- pressure -------------------------------------------------------

@unbounded
fn pressure_list(p: Projection) -> Answer {
    let raised = p.count("pressure.raised");
    let mut out = "pressure: " + to_string(raised) + " signal(s) raised\n";
    let mut taken = 0;
    let mut i = p.rows() - 1;
    while i >= 0 && taken < 10 {
        let e = p.row(i);
        if e.kind == "pressure.raised" {
            out = out + "  " + std::str::pad_left(to_string(e.seq), 5, " ") + "  " + e.entity + "  " + e.body + "\n";
            taken = taken + 1;
        }
        i = i - 1;
    }
    i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "appendage.proposed" || e.kind == "appendage.candidate" || e.kind == "pressure.remeasured" {
            out = out + "  " + std::str::pad_left(to_string(e.seq), 5, " ") + "  " + std::str::pad_right(e.kind, 20, " ") + " " + e.entity + "  " + e.body + "\n";
        }
        i = i + 1;
    }
    return answer(out);
}

// ---- fleet ----------------------------------------------------------

@unbounded
fn fleet_list(p: Projection, fleet: String, plan_rel: String) -> Answer {
    if len(fleet) == 0 { return fail("no `[dna] fleet = \"<name>\"` in hale.toml: the DNA expresses no fleet here"); }
    let plan = std::io::fs::read_file(p.root + "/" + plan_rel) or "";
    if len(plan) == 0 { return fail("no plan at " + plan_rel); }
    let mut out = "fleet " + fleet + " (" + plan_rel + ")\n";
    let d = p.last_of("fleet.deploy");
    if d.seq >= 0 {
        let seed = std::json::find_string_field(d.body, "seed");
        let mut touched = 0;
        let mut it = std::json::array_first(std::json::find_field_raw(d.body, "touched"));
        while !it.done { touched = touched + 1; it = std::json::array_next(it); }
        out = out + "last deploy: " + std::json::find_string_field(d.body, "reason") + " " + short(std::json::find_string_field(d.body, "revision")) + " (" + d.entity + ") touching " + to_string(touched) + " — " + (if len(seed) == 0 { "the whole genome" } else { seed }) + "\n";
    } else {
        out = out + "no deploy yet: `hale dna deploy <revision>`\n";
    }
    let mut it = std::json::array_first(std::json::find_field_raw(plan, "instances"));
    while !it.done {
        let id = std::json::find_string_field(it.element, "id");
        let node = std::json::find_string_field(it.element, "node");
        // the last instance.* row about it
        let mut last = dna::Event { seq: -1 };
        let mut i = p.rows() - 1;
        while i >= 0 && last.seq < 0 {
            let e = p.row(i);
            if std::str::starts_with(e.kind, "instance.") && e.entity == id { last = e; }
            i = i - 1;
        }
        if last.seq < 0 {
            out = out + "  " + std::str::pad_right(id, 12, " ") + " " + std::str::pad_right(if len(node) > 0 { node } else { "-" }, 10, " ") + " never expressed\n";
        } else {
            let state = if last.kind == "instance.up" { "up" } else { "exited " + to_string(std::json::find_int_field(last.body, "code")) };
            let n = std::json::find_string_field(last.body, "node");
            out = out + "  " + std::str::pad_right(id, 12, " ") + " " + std::str::pad_right(if len(n) > 0 { n } else { if len(node) > 0 { node } else { "-" } }, 10, " ") + " " + std::str::pad_right(state, 8, " ") + " rev " + short(std::json::find_string_field(last.body, "revision")) + " model " + short(std::json::find_string_field(last.body, "model_hash")) + "\n";
        }
        it = std::json::array_next(it);
    }
    return answer(out);
}

// ---- models (GH #583 M1) --------------------------------------------
//
// `hale dna models`: the catalog (dna/org/models.hl) built beside a
// one-line main into the project's scratch and run from the root, so
// its `probe_catalog()` sees the same environment the organization
// would. The organization itself is not started and its membrane is
// not touched.
fn models_verb(root: String, hale: String) -> Answer {
    let src = root + "/dna/org/models.hl";
    let catalog = std::io::fs::read_file(src) or "";
    if len(catalog) == 0 { return fail("no catalog at dna/org/models.hl (run `hale dna upgrade`)"); }
    let dir = root + "/.hale/dna/probe";
    std::io::fs::mkdir(root + "/.hale") or discard;
    std::io::fs::mkdir(root + "/.hale/dna") or discard;
    std::io::fs::mkdir(dir) or discard;
    let w1 = write_text(dir + "/models.hl", catalog) or false;
    let w2 = write_text(dir + "/main.hl", "// generated by `hale dna models`: the catalog's probe\nfn main() { print(probe_catalog()); }\n") or false;
    if !w1 || !w2 { return fail("cannot write " + dir); }
    let b = dna::run_tool(hale + "\nbuild\n" + dir);
    if b.code != 0 { return fail("the catalog does not build:\n" + b.stderr + b.stdout); }
    let r = dna::run_tool(dir + "/probe");
    if r.code != 0 { return fail("the probe failed:\n" + r.stderr + r.stdout); }
    let head = "catalog dna/org/models.hl\n" + std::str::pad_right("backend", 10, " ") + "  " + std::str::pad_right("slot", 8, " ") + "  " + std::str::pad_right("model", 28, " ") + "  answer\n";
    return answer(head + r.stdout);
}

// ---- the body on a server (GH #617 asks 3 and 4) ---------------------
// Postgres, Docker, ssh and systemd are the reference setup; the
// definition — install the toolchain the lock pins, clone the record's
// remote, a database from compose or a DSN, a supervisor that restarts
// the host so failure flows up one more level — admits others.

fn lock_toolchain(root: String) -> String {
    let lock = std::io::fs::read_file(root + "/hale.lock") or "";
    let at = std::str::index_of(lock, "toolchain = \"");
    if at < 0 { return ""; }
    let rest = lock[(at + 13)..len(lock)];
    let q = std::str::index_of(rest, "\"");
    return if q < 0 { "" } else { rest[0..q] };
}

fn project_name(root: String) -> String {
    let abs = dna::run_tool("sh\n-c\ncd \"$1\" && pwd -P\nsh\n" + root);
    let p = if abs.code == 0 { dna::trim_nl(abs.stdout) } else { root };
    let sl = last_index_of(p, "/");
    return if sl < 0 { p } else { p[(sl + 1)..len(p)] };
}

// A body's name on a machine: the project and the first twelve hex digits
// of its record's identity (the journal's genesis), so two records whose
// directories share a name never share a secrets file or a unit (#635).
fn body_key(root: String) -> String {
    let id = record_identity(root);
    return project_name(root) + (if len(id) >= 12 { "-" + id[0..12] } else { "" });
}

// `--body <user@host>` or `git config dna.body`.
fn body_target(root: String, flag: String) -> String {
    if len(flag) > 0 { return flag; }
    return rec(root).setting("body");
}

fn sq(s: String) -> String { return "'" + std::str::replace(s, "'", "'\\''") + "'"; }

// A path for the body's shell: `$HOME/...` keeps `$HOME` expandable (the
// default directory is under the body's home, which only its shell
// knows); anything else is quoted as given.
fn shell_path(dir: String) -> String {
    if std::str::starts_with(dir, "$HOME/") { return "\"$HOME\"/" + sq(dir[6..len(dir)]); }
    return sq(dir);
}

fn unit_text(name: String, dir: String) -> String {
    // systemd expands %h, not $HOME
    let wd = if std::str::starts_with(dir, "$HOME/") { "%h/" + dir[6..len(dir)] } else { dir };
    return "[Unit]\nDescription=hale dna body for " + name + "\nAfter=network-online.target\nStartLimitIntervalSec=600\nStartLimitBurst=5\n\n[Service]\nWorkingDirectory=" + wd + "\nEnvironment=PATH=%h/.hale/bin:/usr/local/bin:/usr/bin:/bin\nEnvironment=HALE_BIN=%h/.hale/bin/hale\nEnvironmentFile=-%h/.config/hale-dna/" + name + ".env\nExecStart=%h/.hale/bin/hale dna dev . --no-iris\nRestart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=default.target\n";
}

// The script the body runs, in order: the toolchain the lock pins (or
// stop), the clone (or a fetch into one that exists), vendor and the
// record, the database (compose, or the DSN into the body's env
// file), the unit, enabled and started.
fn provision_script(name: String, pin: String, remote_url: String, dir: String, dsn: String) -> String {
    let infra = ReferenceInfrastructure { };
    let mut s = "set -eu\nPIN=" + sq(pin) + "\nREMOTE=" + sq(remote_url) + "\nDIR=" + shell_path(dir) + "\nNAME=" + sq(name) + "\nDSN=" + sq(dsn) + "\n";
    // `hale --version` has a second line since GH #726 (the embedded
    // DNA source's digest), so the version is field 2 of the FIRST
    // line — over both lines this read installed the toolchain again
    // on every provision.
    s = s + "have=$(\"$HOME/.hale/bin/hale\" --version 2>/dev/null | awk 'NR==1{print $2}' || true)\n";
    s = s + "if [ \"$have\" != \"$PIN\" ]; then echo \"installing hale $PIN\"; HALE_VERSION=\"v$PIN\" sh -c \"$(curl -fsSL https://hale-lang.org/install.sh)\" >/dev/null; fi\n";
    s = s + "\"$HOME/.hale/bin/hale\" --version | head -1 | grep -q \"$PIN\" || { echo \"the toolchain did not install at $PIN; nothing else was written\"; exit 4; }\n";
    s = s + "export PATH=\"$HOME/.hale/bin:$PATH\"\n";
    s = s + "if [ -d \"$DIR/.git\" ]; then git -C \"$DIR\" fetch -q; echo \"fetched into $DIR\"; else mkdir -p \"$(dirname \"$DIR\")\"; git clone -q \"$REMOTE\" \"$DIR\"; echo \"cloned into $DIR\"; fi\n";
    s = s + "cd \"$DIR\" && hale dna upgrade . >/dev/null && (hale dna sync >/dev/null 2>&1 || true)\n";
    // GH #647: the database's and the supervisor's parts are theirs to
    // write; a body with another supervisor or another database gets
    // another implementation's, not another `if`
    s = s + "umask 077; mkdir -p \"$HOME/.config/hale-dna\"\n";
    s = s + infra.database_fragment();
    s = s + infra.supervisor_fragment(name, unit_text(name, dir));
    return s;
}

// `hale dna body provision <user@host> [--dsn <url>] [--dir <path>] [--dry-run] [--as <who>]`
fn body_provision_verb(root: String, target: String, dsn: String, dir_flag: String, dry: Bool, who_flag: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    if len(target) == 0 { return fail("body provision: `hale dna body provision <user@host> [--dsn <postgres://…>] [--dir <path on the body>] [--dry-run]`"); }
    let remote = record_remote(root);
    if len(remote) == 0 { return fail("body provision: this record has no remote; the body clones the record from one (`git remote add origin <url>`, `hale dna sync`) — nothing was written"); }
    let url = rec(root).remote_url(remote);
    if !(std::str::contains(url, "://") || (std::str::contains(url, "@") && std::str::contains(url, ":"))) { return fail("body provision: the record's remote is local to this machine (" + url + "); the body must reach it — `git remote set-url " + remote + " <ssh or https url>` first. Nothing was written"); }
    let pin = lock_toolchain(root);
    if len(pin) == 0 { return fail("body provision: hale.lock pins no toolchain (`hale dna upgrade` writes it); the body installs exactly what the lock pins — nothing was written"); }
    let name = project_name(root);
    let dir = if len(dir_flag) > 0 { dir_flag } else { "$HOME/dna/" + name };
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    let script = provision_script(body_key(root), pin, url, dir, dsn);
    if dry {
        return answer("body provision (dry run): nothing was written. On " + target + " this would run:\n" + indent_lines(script, "    ") + "\nthen here: git config dna.body " + target + "; a `body.provisioned` row in the record\n");
    }
    // 1. reachable, and the pieces a body is made of: stop before writing anything otherwise
    let scratch_dir = root + "/.hale/dna";
    let infra = ReferenceInfrastructure { root: root, target: target, local: LocalTransport { scratch: scratch_dir }, ssh: SshTransport { scratch: scratch_dir } };
    let probe = infra.probe(target);
    if !probe.reachable { return fail("body provision: " + transport_kind() + " " + target + " is not reachable (" + probe.why + "); nothing was written"); }
    let lacks = infra.missing(probe.facts, dsn);
    if len(lacks) > 0 { return fail("body provision: " + target + " " + lacks + " — nothing was written"); }
    // 2. the script, in the body's shell, through the transport
    let r = infra.run_at(script, "");
    if r.code != 0 { return fail("body provision on " + target + " stopped (" + to_string(r.code) + "):\n" + indent_lines(r.stdout + r.stderr, "    ")); }
    // 3. remembered here, and in the record — the target and the pin, never a credential
    let c1 = rec(root).set_setting("body", target);
    let c2 = rec(root).set_setting("body.dir", dir);
    let row = append_as(root, "body.provisioned", target, "{\"dir\": " + quote(dir) + ", \"toolchain\": " + quote(pin) + ", \"knowledge\": " + quote(if len(dsn) > 0 { "dsn" } else { "compose" }) + ", \"by\": " + quote(who) + "}", who);
    let s = sync_record(root, memory);
    return answer("body provision: " + target + "\n" + indent_lines(dna::trim_nl(r.stdout), "    ") + "\n    dna.body = " + target + " (start/stop/logs go there); the body takes the lease when its unit starts\n");
}

// `hale dna body start|stop|logs` on the provisioned body, over ssh.
fn body_ctl_verb(root: String, sub: String, body_flag: String) -> Answer {
    let target = body_target(root, body_flag);
    if len(target) == 0 { return fail("body " + sub + ": no body is known here (`hale dna body provision <user@host>` sets `dna.body`; `--body <user@host>` names one)"); }
    // GH #647: the supervisor is the infrastructure's; the host names the unit
    let scratch_dir = root + "/.hale/dna";
    let infra = ReferenceInfrastructure { root: root, target: target, local: LocalTransport { scratch: scratch_dir }, ssh: SshTransport { scratch: scratch_dir } };
    let key = body_key(root);
    if sub == "logs" { let text = infra.logs(key, 200); return answer("body logs on " + target + ":\n" + indent_lines(dna::trim_nl(text), "    ") + "\n"); }
    let ok = if sub == "stop" { infra.stop(key) } else { infra.start(key) };
    if !ok { return fail("body " + sub + " on " + target + ": " + infra.last); }
    return answer("body " + sub + " on " + target + ":\n" + indent_lines(infra.last, "    ") + "\n");
}

// ---- secrets (GH #617 ask 4) ----------------------------------------
// A credential is read from stdin (a prompt on a terminal, a pipe
// otherwise), never from argv, and lands in `~/.config/hale-dna/
// <project>-<record>.env` (mode 600) — on the body over ssh's stdin when one is
// named, here otherwise; the host loads that file for its children.
// The record gets `secret.rotated <NAME>` and nothing else.

fn env_var_name_ok(name: String) -> Bool {
    if len(name) == 0 { return false; }
    let mut i = 0;
    while i < len(name) {
        let b = std::str::byte_at_unchecked(name, i);
        let ok = (b >= 65 && b <= 90) || (b >= 48 && b <= 57 && i > 0) || b == 95;
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

fn secret_verb(root: String, sub: String, name: String, body_flag: String, who_flag: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    if sub != "set" && sub != "rotate" { return fail("secret: `hale dna secret set <NAME> [--body <user@host>]` (the value from stdin) or `hale dna secret rotate <NAME> [--body …]`"); }
    if std::str::contains(name, "=") { return fail("secret " + sub + ": the value never goes on the command line (it would sit in every shell history and process list); name the variable alone and give the value on stdin"); }
    if !env_var_name_ok(name) { return fail("secret " + sub + ": `" + name + "` is not an environment variable name (A-Z, 0-9, _)"); }
    let project = body_key(root);
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    let target = body_target(root, body_flag);
    let p = open_projection(root, ".", "", memory);
    let mut known = false;
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "secret.rotated" && e.entity == name { known = true; }
        i = i + 1;
    }
    if sub == "rotate" && !known { return fail("secret rotate: " + name + " was never set (`hale dna secret set " + name + "` first)"); }
    eprintln("value for ", name, (if len(target) > 0 { " on " + target } else { " (this machine)" }), ", on one line:");
    let value = dna::trim_nl(std::io::stdin::read_line());
    if len(value) == 0 { return fail("secret " + sub + ": no value was given on stdin"); }
    // GH #647: the credential is the infrastructure's to keep — the value
    // reaches the body's shell on its stdin through a private file, never
    // in argv, here or over the transport
    let scratch_dir = root + "/.hale/dna";
    let infra = ReferenceInfrastructure { root: root, target: target, local: LocalTransport { scratch: scratch_dir }, ssh: SshTransport { scratch: scratch_dir } };
    if !infra.put_credential(project + "/" + name, value) { return fail("secret " + sub + (if len(target) > 0 { " on " + target } else { "" }) + ": " + infra.last + "; nothing was recorded"); }
    let row = append_as(root, "secret.rotated", name, "{\"where\": " + quote(if len(target) > 0 { target } else { "local" }) + ", \"by\": " + quote(who) + "}", who);
    let s = sync_record(root, memory);
    return answer("secret " + sub + ": " + name + " is in " + infra.last + (if len(target) > 0 { " on " + target } else { "" }) + " (secret.rotated " + name + "; the value is nowhere in the record). A running body reads it at its next start: `hale dna body stop && hale dna body start`\n");
}

// The model credentials the catalog names (`env_var: "X"` in
// dna/org/models.hl), space-separated.
fn catalog_credentials(root: String) -> String {
    let catalog = std::io::fs::read_file(root + "/dna/org/models.hl") or "";
    let mut out = "";
    let mut rest = catalog;
    while true {
        let at = std::str::index_of(rest, "env_var: \"");
        if at < 0 { break; }
        let after = rest[(at + 10)..len(rest)];
        let q = std::str::index_of(after, "\"");
        if q < 0 { break; }
        let name = after[0..q];
        if len(name) > 0 && !std::str::contains(" " + out + " ", " " + name + " ") { out = if len(out) == 0 { name } else { out + " " + name }; }
        rest = after[(q + 1)..len(after)];
    }
    return out;
}

// What the record says of the body's credentials: the names the body
// last reported none of (`body.credential_missing model {any_of}`),
// "" once a `body.credential_present` followed.
fn credential_gap(p: Projection) -> String {
    let mut missing = "";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "body.credential_missing" { missing = std::json::find_string_field(e.body, "any_of"); }
        if e.kind == "body.credential_present" { missing = ""; }
        i = i + 1;
    }
    return missing;
}

// ---- schedules (GH #610) ---------------------------------------------
// `hale dna schedule [list | pause <id> | resume <id>]`: the schedules
// the org chart declared, as the record has them; pause and resume are
// rows in your name that the organism reads at its next tick.
@unbounded
fn schedule_verb(root: String, sub: String, id: String, who_flag: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    if sub == "pause" || sub == "resume" {
        if len(id) == 0 { return fail("schedule " + sub + ": which one? `hale dna schedule` lists them"); }
        let s = sync_record(root, memory);
        let p = open_projection(root, ".", "", memory);
        let mut known = false;
        let mut paused = false;
        let mut i = 0;
        while i < p.rows() {
            let e = p.row(i);
            if e.entity == id && e.kind == "schedule.declared" { known = true; }
            if e.entity == id && e.kind == "schedule.paused" { paused = true; }
            if e.entity == id && e.kind == "schedule.resumed" { paused = false; }
            i = i + 1;
        }
        if !known { return fail("schedule " + sub + ": no schedule `" + id + "` is declared in the record"); }
        if sub == "pause" && paused { return answer("schedule " + id + " is already paused\n"); }
        if sub == "resume" && !paused { return answer("schedule " + id + " is not paused\n"); }
        let ok = append_as(root, "schedule." + (if sub == "pause" { "paused" } else { "resumed" }), id, "{\"by\": " + quote(who) + "}", who);
        if !ok { return fail("the record refused the append"); }
        let s2 = sync_record(root, memory);
        return answer("schedule " + id + " " + (if sub == "pause" { "paused (schedule.paused; it never fires until resumed)" } else { "resumed (schedule.resumed)" }) + "\n");
    }
    if len(sub) > 0 && sub != "list" { return fail("schedule: `hale dna schedule`, `schedule pause <id>`, or `schedule resume <id>`"); }
    let p = open_projection(root, ".", "", memory);
    let mut out = "";
    let mut ids = "\n";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "schedule.declared" && !std::str::contains(ids, "\n" + e.entity + "\n") { ids = ids + e.entity + "\n"; }
        i = i + 1;
    }
    let mut rest = ids[1..len(ids)];
    let mut n = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let sid = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(sid) == 0 { continue; }
        n = n + 1;
        let mut decl = "";
        let mut paused = false;
        let mut fired = 0;
        let mut skipped = 0;
        let mut task = "";
        let mut k = 0;
        while k < p.rows() {
            let e = p.row(k);
            if e.entity == sid {
                if e.kind == "schedule.declared" { decl = e.body; }
                if e.kind == "schedule.paused" { paused = true; }
                if e.kind == "schedule.resumed" { paused = false; }
                if e.kind == "schedule.fired" { fired = fired + 1; let t = std::json::find_string_field(e.body, "task"); if len(t) > 0 { task = t; } }
                if e.kind == "schedule.admitted" { let at = std::json::find_string_field(e.body, "task"); if len(at) > 0 { task = at; } }
                if e.kind == "schedule.skipped" { skipped = skipped + 1; }
            }
            k = k + 1;
        }
        let every = std::json::find_int_field(decl, "every_ms");
        let cron = std::json::find_string_field(decl, "cron");
        let when = if every > 0 { "every " + to_string(every) + "ms" } else { "cron `" + cron + "` (UTC)" };
        let what = if std::json::find_string_field(decl, "action") == "optimize" { "the optimize pass" } else { "ask: " + std::json::find_string_field(decl, "ask") };
        out = out + "  " + sid + " [" + (if paused { "paused" } else { "live" }) + "] " + when + " — " + what + " · fired " + to_string(fired) + ", skipped " + to_string(skipped) + (if len(task) > 0 { " · last task " + task } else { "" }) + "\n";
    }
    if n == 0 { return answer("schedules: none declared (the org chart's `birth()` declares them: `self.core.schedule(dna::Schedule { … })`)\n"); }
    return answer("schedules: " + to_string(n) + "\n" + out);
}

// ---- protected evidence (GH #606) --------------------------------------
// `hale dna receipt` lists what the record says of protected evidence;
// `receipt disclose <digest> --to <who> --purpose <p>` authorizes a
// reader for a purpose, as a row in your name; `receipt show <digest>
// --purpose <p>` reads it from memory in your name (GH #985).

@unbounded
fn receipt_verb(root: String, sub: String, digest: String, to: String, purpose: String, who_flag: String, why: String, policy: String, memory: dna::Memory) -> Answer {
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    if sub == "disclose" {
        if len(digest) == 0 || len(to) == 0 || len(purpose) == 0 { return fail("receipt disclose: `hale dna receipt disclose <digest> --to <recipient> --purpose <purpose> [--as <who>]`"); }
        let s = sync_record(root, memory);
        let p = open_projection(root, ".", "", memory);
        let mut known = false;
        let mut i = 0;
        while i < p.rows() {
            let e = p.row(i);
            if e.entity == digest && (e.kind == "receipt.classified" || e.kind == "receipt.withheld") { known = true; }
            i = i + 1;
        }
        if !known { return fail("receipt disclose: " + digest + " is not protected evidence in the record (an internal receipt needs no disclosure)"); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("recipient", to);
        b.string_field("purpose", purpose);
        b.string_field("by", who);
        b.end_object();
        if !append_as(root, "receipt.disclosed", digest, b.result(), who) { return fail("the record refused the append"); }
        let s2 = sync_record(root, memory);
        return answer("receipt " + digest + " disclosed to " + to + " for " + purpose + " (receipt.disclosed, by " + who + ")\n");
    }
    if sub == "hold" || sub == "release-hold" {
        if len(digest) == 0 || len(why) == 0 { return fail("receipt " + sub + ": `hale dna receipt " + sub + " <digest> --why <why> [--as <who>]`"); }
        let s = sync_record(root, memory);
        let p = open_projection(root, ".", "", memory);
        let mut held = false;
        let mut i = 0;
        while i < p.rows() {
            let e = p.row(i);
            if e.entity == digest && e.kind == "receipt.held" { held = true; }
            if e.entity == digest && e.kind == "receipt.hold_released" { held = false; }
            i = i + 1;
        }
        if sub == "hold" && held { return fail("receipt hold: " + digest + " is already held"); }
        if sub == "release-hold" && !held { return fail("receipt release-hold: " + digest + " is not held"); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("by", who);
        b.string_field("why", why);
        b.end_object();
        let kind = if sub == "hold" { "receipt.held" } else { "receipt.hold_released" };
        if !append_as(root, kind, digest, b.result(), who) { return fail("the record refused the append"); }
        let s2 = sync_record(root, memory);
        return answer("receipt " + digest + " " + (if sub == "hold" { "held" } else { "released from its hold" }) + " (" + kind + ", by " + who + ")\n");
    }
    if sub == "redact" {
        if len(digest) == 0 || len(why) == 0 || len(policy) == 0 { return fail("receipt redact: `hale dna receipt redact <digest> --why <why> --policy <policy> [--as <who>]`"); }
        let s = sync_record(root, memory);
        // the point the hold is read at — the record's head, and the
        // ledger's revision once the organism has adopted it: the
        // redaction lands only there (#636)
        let read_head = record_head(root);
        if !read_head.ok { return fail("receipt redact: the record's head could not be read: " + read_head.why); }
        let read_at = read_head.id;
        let ledger_at = ledger_revision(root, memory);
        let p = open_projection(root, ".", "", memory);
        let mut held = "";
        let mut redacted = false;
        let mut classified = false;
        let mut withheld = false;
        let mut class = "internal";
        let mut i = 0;
        while i < p.rows() {
            let e = p.row(i);
            if e.entity == digest {
                if e.kind == "receipt.held" { held = std::json::find_string_field(e.body, "by") + ": " + std::json::find_string_field(e.body, "why"); }
                if e.kind == "receipt.hold_released" { held = ""; }
                if e.kind == "receipt.redacted" { redacted = true; }
                if e.kind == "receipt.classified" { classified = true; class = std::json::find_string_field(e.body, "class"); }
                if e.kind == "receipt.withheld" { withheld = true; class = std::json::find_string_field(e.body, "class"); }
            }
            i = i + 1;
        }
        if len(held) > 0 { return fail("receipt redact: held: " + held + "; redaction waits for the hold's release"); }
        let local_hex = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
        // a protected body is memory's (GH #985): the redaction is recorded
        // here, at the head the hold was read at, and the body — the spine,
        // the only writer of protected evidence — erases it on its next tick
        if redacted && !classified && (withheld || !receipt_read(root, local_hex).present) { return fail("receipt redact: " + digest + " is already redacted"); }
        if classified {
            if redacted { return answer("receipt " + digest + ": the redaction is in the record; the body erases it from memory on its next tick\n"); }
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("by", who);
            b.string_field("why", why);
            b.string_field("policy", policy);
            b.string_field("class", class);
            b.string_field("store", "memory");
            b.end_object();
            let r = rec(root);
            let a = r.append(JOURNAL, read_at, dna::Row { kind: "receipt.redacted", entity: digest, body: b.result(), author: who }, signing(root), "");
            if !a.ok && a.error == "stale" { return fail("receipt redact: the record moved while redacting " + digest + " (a hold may have arrived); nothing was recorded — redact again"); }
            if !a.ok { return fail("receipt redact: the record refused the redaction of " + digest + " (" + a.error + ")"); }
            let s2 = sync_record(root, memory);
            return answer("receipt " + digest + " redacted (" + class + "; receipt.redacted, by " + who + " under " + policy + "); the body erases it from memory on its next tick\n");
        }
        let hexd = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
        let had = receipt_read(root, hexd).present;
        if !withheld && !had { return fail("receipt redact: no receipt " + digest + " in this clone or the record"); }
        // the decision is in the record before the ref goes; a redaction the
        // record refuses removes nothing (one recorded before a failed removal
        // is completed here)
        if !redacted {
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("by", who);
            b.string_field("why", why);
            b.string_field("policy", policy);
            b.string_field("class", class);
            b.string_field("store", if withheld { "none (withheld)" } else { "git" });
            b.end_object();
            let landed = append_as_at(root, read_at, ledger_at, "receipt.redacted", digest, b.result(), who);
            if landed == "stale_revision" { return fail("receipt redact: the record moved while redacting " + digest + " (a hold may have arrived); nothing was erased — redact again"); }
            if len(landed) > 0 { return fail("receipt redact: the record refused the redaction of " + digest + " (" + landed + "); nothing was erased"); }
        }
        if had { let d = rec(root).forget(hexd); }
        let s2 = sync_record(root, memory);
        return answer("receipt " + digest + " redacted (" + (if withheld { "withheld, so no body was kept" } else { "its ref removed here and from the remote" }) + "; receipt.redacted, by " + who + " under " + policy + "). The blob stays in each object store until git collects it.\n");
    }
    if sub == "show" {
        if len(digest) == 0 || len(purpose) == 0 { return fail("receipt show: `hale dna receipt show <digest> --purpose <purpose> [--as <who>]`"); }
        // read from memory under this head's role, in your name (GH #985)
        let vault = dna::MemoryVault { repo: root, dsn_env: dna::own_dsn_env() };
        let got = vault.read(digest, who, purpose);
        if !got.present { return fail("receipt show: " + got.refused); }
        let s2 = sync_record(root, memory);
        return answer("receipt " + digest + " (" + got.class + ", " + to_string(len(got.text)) + " bytes, disclosed to " + who + " for " + purpose + ")\n" + got.text + "\nend of receipt\n");
    }
    if len(sub) > 0 && sub != "list" { return fail("receipt: `hale dna receipt`, `receipt disclose <digest> --to <who> --purpose <p>`, `receipt show <digest> --purpose <p>`, `receipt hold|release-hold <digest> --why <w>`, or `receipt redact <digest> --why <w> --policy <p>`"); }
    let p = open_projection(root, ".", "", memory);
    let mut out = "";
    let mut n = 0;
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "receipt.classified" || e.kind == "receipt.withheld" {
            n = n + 1;
            let mut disclosures = "";
            let mut reads = 0;
            let mut refusals = 0;
            let mut redaction = "";
            let mut hold = "";
            let mut k = 0;
            while k < p.rows() {
                let f = p.row(k);
                if f.entity == e.entity {
                    if f.kind == "receipt.disclosed" { disclosures = disclosures + (if len(disclosures) > 0 { "; " } else { "" }) + "disclosed to " + std::json::find_string_field(f.body, "recipient") + " for " + std::json::find_string_field(f.body, "purpose"); }
                    if f.kind == "receipt.read" { reads = reads + 1; }
                    if f.kind == "receipt.read_refused" { refusals = refusals + 1; }
                    if f.kind == "receipt.redacted" { redaction = "redacted by " + std::json::find_string_field(f.body, "by") + " under " + std::json::find_string_field(f.body, "policy"); }
                    if f.kind == "receipt.held" { hold = "held by " + std::json::find_string_field(f.body, "by"); }
                    if f.kind == "receipt.hold_released" { hold = ""; }
                }
                k = k + 1;
            }
            let state = if len(redaction) > 0 { redaction + (if len(hold) > 0 { " · " + hold } else { "" }) } else if len(hold) > 0 { hold } else if e.kind == "receipt.withheld" { "withheld: " + std::json::find_string_field(e.body, "why") } else { "kept by the knowledge service" };
            out = out + "  " + e.entity + " [" + std::json::find_string_field(e.body, "class") + "] " + state + (if len(disclosures) > 0 { " · " + disclosures } else { "" }) + " · read " + to_string(reads) + ", refused " + to_string(refusals) + "\n";
        }
        i = i + 1;
    }
    if n == 0 { return answer("receipts: no protected evidence in the record\n"); }
    return answer("receipts: " + to_string(n) + " protected\n" + out);
}

// "redacted by <who> under <policy>: <why>" when the record redacted
// `digest` (GH #606), else "".
@unbounded
fn redaction_line(root: String, digest: String) -> String {
    // display only: a record that could not be read shows no redaction,
    // and the receipt beside it is still withheld or absent on its own
    let r = rec(root);
    let text = r.text_at(r.head(JOURNAL).id);
    let needle = "\"entity\": \"" + digest + "\"";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::contains(line, needle) && std::json::find_string_field(line, "kind") == "receipt.redacted" {
            let body = std::json::find_string_field(line, "body");
            return "redacted by " + std::json::find_string_field(body, "by") + " under " + std::json::find_string_field(body, "policy") + ": " + std::json::find_string_field(body, "why");
        }
    }
    return "";
}
