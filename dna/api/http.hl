// Read-only HTTP boundary. Native identifiers are decoded once, never cleaned.

const API_VERSION: String = "hale.v1";
const API_PREFIX: String = "/api/hale/v1/applications";

type Query {
    ok: Bool = true;
    error: String = "";
    id: String = "";
    snapshot: String = "";
    limit: Int = 25;
    offset: Int = 0;
}

type Decoded { ok: Bool = false; text: String = ""; }

locus Http {
    params { }
    fn response(status: Int, body: String) -> std::http::Response {
        return std::http::Response { status: status, content_type: "application/json; charset=utf-8", headers: "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff", body: body };
    }
    fn error(status: Int, code: String, message: String, retryable: Bool) -> std::http::Response {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("api_version", API_VERSION);
        b.begin_object_field("error");
        b.string_field("code", code);
        b.string_field("message", message);
        b.bool_field("retryable", retryable);
        b.end_object();
        b.end_object();
        return self.response(status, b.result());
    }
    fn success(source: Source, data: String) -> std::http::Response {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("api_version", API_VERSION);
        b.begin_object_field("source");
        b.string_field("record_id", source.identity);
        b.string_field("record_head", source.head);
        b.string_field("record_revision", to_string(source.revision));
        b.end_object();
        b.field("data", data);
        b.end_object();
        return self.response(200, b.result());
    }
    fn digit(c: Int) -> Int {
        if c >= 48 && c <= 57 { return c - 48; }
        if c >= 65 && c <= 70 { return c - 55; }
        if c >= 97 && c <= 102 { return c - 87; }
        return -1;
    }
    fn utf8(text: String) -> Bool {
        let mut i = 0;
        while i < len(text) {
            let c = std::str::byte_at_unchecked(text, i);
            if c < 128 { i = i + 1; continue; }
            let n = if c >= 194 && c <= 223 { 2 } else if c >= 224 && c <= 239 { 3 } else if c >= 240 && c <= 244 { 4 } else { 0 };
            if n == 0 || i + n > len(text) { return false; }
            let second = std::str::byte_at_unchecked(text, i + 1);
            if (c == 224 && second < 160) || (c == 237 && second > 159) || (c == 240 && second < 144) || (c == 244 && second > 143) { return false; }
            let mut k = 1;
            while k < n {
                let part = std::str::byte_at_unchecked(text, i + k);
                if part < 128 || part > 191 { return false; }
                k = k + 1;
            }
            i = i + n;
        }
        return true;
    }
    fn decode(raw: String) -> Decoded {
        let out = std::bytes::BytesBuilder { };
        let mut i = 0;
        while i < len(raw) {
            let c = std::str::byte_at_unchecked(raw, i);
            if c == 37 {
                if i + 2 >= len(raw) { return Decoded { }; }
                let a = self.digit(std::str::byte_at_unchecked(raw, i + 1));
                let b = self.digit(std::str::byte_at_unchecked(raw, i + 2));
                if a < 0 || b < 0 { return Decoded { }; }
                let byte = a * 16 + b;
                if byte < 32 || byte == 127 { return Decoded { }; }
                out.append_u8(byte);
                i = i + 3;
            } else {
                if c < 32 || c == 127 { return Decoded { }; }
                out.append_u8(if c == 43 { 32 } else { c });
                i = i + 1;
            }
        }
        let text = std::str::from_bytes(out.snapshot());
        return Decoded { ok: self.utf8(text), text: text };
    }
    fn integer(raw: String, maximum: Int) -> Int {
        if len(raw) == 0 || len(raw) > 7 { return -1; }
        let mut n = 0;
        let mut i = 0;
        while i < len(raw) {
            let c = std::str::byte_at_unchecked(raw, i);
            if c < 48 || c > 57 { return -1; }
            n = n * 10 + c - 48;
            if n > maximum { return -1; }
            i = i + 1;
        }
        return n;
    }
    fn query(raw: String) -> Query {
        let mut q = Query { };
        let mut seen = "|";
        let mut rest = raw;
        if len(raw) > 8192 { return Query { ok: false, error: "query is too long" }; }
        while len(rest) > 0 {
            let amp = std::str::index_of(rest, "&");
            let pair = if amp < 0 { rest } else { rest[0..amp] };
            let eq = std::str::index_of(pair, "=");
            if eq <= 0 { return Query { ok: false, error: "query fields require a name and value" }; }
            let key = self.decode(pair[0..eq]);
            let value = self.decode(pair[(eq + 1)..len(pair)]);
            if !key.ok || !value.ok { return Query { ok: false, error: "invalid query encoding" }; }
            if key.text != "id" && key.text != "limit" && key.text != "offset" && key.text != "snapshot" { return Query { ok: false, error: "unsupported query field" }; }
            if std::str::contains(seen, "|" + key.text + "|") { return Query { ok: false, error: "duplicate query field" }; }
            seen = seen + key.text + "|";
            if key.text == "id" {
                if len(value.text) == 0 { return Query { ok: false, error: "id must not be empty" }; }
                q.id = value.text;
            }
            if key.text == "snapshot" {
                if len(value.text) == 0 { return Query { ok: false, error: "snapshot must not be empty" }; }
                q.snapshot = value.text;
            }
            if key.text == "limit" {
                q.limit = self.integer(value.text, 100);
                if q.limit < 1 { return Query { ok: false, error: "limit must be an integer from 1 through 100" }; }
            }
            if key.text == "offset" {
                q.offset = self.integer(value.text, 1000000);
                if q.offset < 0 { return Query { ok: false, error: "offset must be an integer from 0 through 1000000" }; }
            }
            if amp < 0 { rest = ""; } else {
                rest = rest[(amp + 1)..len(rest)];
                if len(rest) == 0 { return Query { ok: false, error: "empty query field" }; }
            }
        }
        if q.offset > 0 && len(q.snapshot) == 0 { return Query { ok: false, error: "snapshot is required after the first page" }; }
        if len(q.id) > 0 && q.offset != 0 { return Query { ok: false, error: "id lookup requires offset zero" }; }
        return q;
    }
    fn page(limit: Int, offset: Int, total: Int, snapshot: String) -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.int_field("limit", limit);
        b.int_field("offset", offset);
        b.int_field("total", total);
        b.int_field("next_offset", if offset + limit < total { offset + limit } else { -1 });
        b.string_field("snapshot", snapshot);
        b.end_object();
        return b.result();
    }
}
