// The heart's pulse (GH #987).
//
// An application's one hookup to DNA is its events, which it declares as
// its own topics and publishes on its own subjects, `<org>.app.<app>.
// <event>`, through the bus's NATS adapter. The host reads them through
// the organization's durable `heart` (dna/core/nerves.hl) and lands each
// as a `reading.recorded` row before anything acts on it. A reading is a
// signal, never a fact: it acts on nothing itself, and what the spine
// does with one (a concern, below; a reflex's firing, reflex.hl) is a row
// of its own. What the organism does to the application goes the other
// way, through its API.
//
// The row comes first in delivery too: the durable's message is
// acknowledged only once its row has landed or it has been refused for
// good (a duplicate, or not a reading). Anything else leaves it
// unacknowledged, and the stream delivers it again.
//
// An event names itself: its body is a JSON object whose string `id` the
// application chose, and the row's entity is `<app>/<event>/<id>`. A
// second arrival of an entity already recorded — a redelivery, a replay —
// is refused. Whether it is there is decided at the revision the row is
// appended at, so two hosts pulling the same durable land it once. Over a
// shared record that holds its rows in git (routing 0), each owner's clone
// appends on its own, so only the ledger can decide an id across owners:
// there a reading waits in the stream until the ledger is adopted.

const READING_KIND: String = "reading.recorded";
// The largest event body a reading keeps; a larger one is refused.
const READING_MAX_BYTES: Int = 65536;

// What an inbound message on the heart's subjects says, or why it is not
// a reading.
type Reading {
    app: String = "";
    event: String = "";
    id: String = "";
    payload: String = "";
    why: String = "";
}

// What landing a reading came to: `landed`; `duplicate` (its entity is
// recorded already); `waiting` (it cannot be decided here yet: leave it in
// the stream); `failed` (the write did not happen: it comes again).
type Landing {
    outcome: String = "";
    why: String = "";
}

// An id or a name as a row's entity carries it: letters, digits and
// `-_.:`, at most 128 bytes.
@unbounded
fn reading_token(s: String) -> Bool {
    if len(s) == 0 || len(s) > 128 { return false; }
    let mut i = 0;
    while i < len(s) {
        let c = s[i..(i + 1)];
        let ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "-" || c == "_" || c == "." || c == ":";
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

// The reading `subject` and `body` make, under the heart's `prefix`
// (`<org>.app.`): the application and the event from the subject, the id
// from the body, which is one well-formed JSON object in UTF-8.
fn reading_of(subject: String, prefix: String, body: String) -> Reading {
    if len(prefix) == 0 || !std::str::starts_with(subject, prefix) { return Reading { why: "not under " + prefix }; }
    let rest = subject[len(prefix)..len(subject)];
    let dot = std::str::index_of(rest, ".");
    if dot <= 0 || dot + 1 >= len(rest) { return Reading { why: "names no application and event" }; }
    let app = rest[0..dot];
    let event = rest[(dot + 1)..len(rest)];
    if !reading_token(app) || !reading_token(event) { return Reading { why: "the application's or the event's name is not a token (letters, digits and -_.:, at most 128)" }; }
    if len(body) > READING_MAX_BYTES { return Reading { app: app, event: event, why: "the body is over " + to_string(READING_MAX_BYTES) + " bytes" }; }
    if std::str::cp_count(body) < 0 { return Reading { app: app, event: event, why: "the body is not UTF-8" }; }
    if !std::json::valid_object(body) { return Reading { app: app, event: event, why: "the body is not a JSON object" }; }
    let id = std::json::string_field(body, "id");
    if id.kind != "string" || !reading_token(id.text) { return Reading { app: app, event: event, why: "the body names no string `id` (letters, digits and -_.:, at most 128)" }; }
    return Reading { app: app, event: event, id: id.text, payload: body };
}

fn reading_entity(r: Reading) -> String { return r.app + "/" + r.event + "/" + r.id; }

// Whether `entity`'s reading is in the organism's memory.
@unbounded
fn reading_landed(p: Projection, entity: String) -> Bool {
    let mut i = p.rows() - 1;
    while i >= 0 {
        let e = p.row(i);
        if e.kind == READING_KIND && e.entity == entity { return true; }
        i = i - 1;
    }
    return false;
}

// Land `r` as its row, where the routing table puts the kind, at the
// revisions its absence was read at; when a memory moved under it, it is
// read and decided again.
@unbounded
fn record_reading(root: String, subject: String, r: Reading, memory: dna::Memory) -> Landing {
    if shared_here(root) && dna::route(routing_here(root), READING_KIND) == "record" {
        return Landing { outcome: "waiting", why: "this record is shared and keeps its rows in git, where each owner's clone appends on its own; only the ledger decides an id across owners (`hale dna ledger adopt`)" };
    }
    let entity = reading_entity(r);
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("app", r.app);
    b.string_field("event", r.event);
    b.string_field("id", r.id);
    b.string_field("subject", subject);
    b.string_field("payload", r.payload);
    b.end_object();
    let body = b.result();
    let mut tries = 0;
    while tries < 50 {
        tries = tries + 1;
        let head = record_head(root);
        if !head.ok { return Landing { outcome: "failed", why: "the record's head could not be read: " + head.why }; }
        // the projection refreshes the ledger: its revision is read after,
        // so it is the one the scan saw
        let p = open_projection(root, ".", "", memory);
        let at = ledger_revision(root, memory);
        if reading_landed(p, entity) { return Landing { outcome: "duplicate" }; }
        let why = append_as_at(root, head.id, at, READING_KIND, entity, body, "host", memory);
        if len(why) == 0 { return Landing { outcome: "landed" }; }
        if why != "stale_revision" { return Landing { outcome: "failed", why: why }; }
    }
    return Landing { outcome: "failed", why: "the organism's memory kept moving under it" };
}

// An application's concern (GH #986, #987): not a socket of the node's
// and not a subject of DNA's, but one of its own events, `concern.raised`
// on `<org>.app.<app>.concern.raised`, whose body names the concern's
// `source`, `what` and `severity` beside its `id`. The heart lands it as
// a reading first; then the spine puts it into the record as
// `concern.requested`, entity its source, request the reading's entity,
// and the relay carries that onto the nerves until the organization
// answers — row first, relayed until answered, admitted once by that
// request, whichever delivery reads it.
const CONCERN_EVENT: String = "concern.raised";

// A concern's source as the record may carry it: `/`-separated tokens
// (letters, digits and `-_.`), at most 128 bytes, one of them the
// application whose subject it came on — an application speaks for its
// own parts, never another's. "" when it is not one.
@unbounded
fn concern_source(source: String, app: String) -> String {
    if len(source) == 0 || len(source) > 128 { return ""; }
    let mut named = false;
    let mut seg = "";
    let mut i = 0;
    while i <= len(source) {
        let c = if i < len(source) { source[i..(i + 1)] } else { "/" };
        if c == "/" {
            if len(seg) == 0 { return ""; }
            if seg == app { named = true; }
            seg = "";
        } else {
            let ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "-" || c == "_" || c == ".";
            if !ok { return ""; }
            seg = seg + c;
        }
        i = i + 1;
    }
    return if named { source } else { "" };
}

// Put `r`, a concern the heart landed as `entity`, into the record as
// `concern.requested`, once for that request, at the revisions its
// absence was read at. `asked` when it landed; nothing when it was there
// already; `why` when it was refused for good (a source that is not the
// application's — the event is acknowledged, and nothing is recorded) or
// could not be written (it comes again: `retry`).
@unbounded
fn reading_concern(root: String, entity: String, r: Reading, author: String, memory: dna::Memory) -> Escalation {
    let named = std::json::string_field(r.payload, "source");
    let source = concern_source(if named.kind == "string" { named.text } else { "" }, r.app);
    if len(source) == 0 { return Escalation { why: "the concern " + entity + " names no source of its application `" + r.app + "` (a `/`-path of letters, digits and -_., one of its parts " + r.app + "); refused", refused: true }; }
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("request", entity);
    b.string_field("source", source);
    b.string_field("what", std::json::find_string_field(r.payload, "what"));
    b.int_field("severity", std::json::find_int_field(r.payload, "severity"));
    b.string_field("app", r.app);
    b.end_object();
    let body = b.result();
    let mut tries = 0;
    while tries < 50 {
        tries = tries + 1;
        let head = record_head(root);
        if !head.ok { return Escalation { why: "the record's head could not be read: " + head.why }; }
        let p = open_projection(root, ".", "", memory);
        let at = ledger_revision(root, memory);
        let mut j = p.rows() - 1;
        while j >= 0 {
            let e = p.row(j);
            if e.kind == "concern.requested" && dna::request_named(e.body) == entity { return Escalation { }; }
            j = j - 1;
        }
        let why = append_as_at(root, head.id, at, "concern.requested", source, body, author, memory);
        if len(why) == 0 { return Escalation { asked: "a concern from " + source + " (" + entity + ")" }; }
        if why != "stale_revision" { return Escalation { why: "the record refused the concern from " + source + ": " + why }; }
    }
    return Escalation { why: "the organism's memory kept moving under the concern from " + source };
}
