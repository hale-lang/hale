// The hat as a read (GH #946, slice 2): `GET /dna/context?id=<work>`
// answers one Work's context as structure — the position and its
// charter, the practices with ids, the bindings, the grant, the
// contract, the class, the history as facts — fenced to the Record head
// and memory's watermark and named by its digest. Rendered twice at one
// head it is one digest; a row that moves the head moves the digest.
// Native handler test over an owned Record: no body, database or model
// runs, and every response is checked against the contract.
import ".." as api;
import "../../core" as dna;
import "./fixture" as fixture;

const ROOT: String = "hat-close";
const STEP: String = "hat-close/wf1/s0";
const WORK: String = "hat-close/wf1/s0/judge";
const ORG_ROOT: String = "hat-org";
const ORG_STEP: String = "hat-org/wf1/s0";
const ORG_WORK: String = "hat-org/wf1/s0/judge";
const CHARTER: String = "Judges what the organization asks of it, by its ratified practices; proposes, never applies.";

locus HatCases {
    params { f: fixture::Fixture; json: fixture::Json = fixture::Json { }; }
    fn get(service: api::Api, path: String, status: Int, schema: String) -> String {
        let response = service.handle(std::http::Request { method: "GET", path: self.f.prefix + path });
        std::test::assert_eq_int(response.status, status, response.body);
        if len(schema) > 0 {
        }
        return response.body;
    }
    fn seed() {
        let cat = dna::WorkflowCatalog { };
        std::test::assert_eq_str(cat.define("judge", 1, "record", "one judgment"), "", "definition");
        let request = dna::WorkRequest { objective: "assess the storage migration", target: "org", requires: "judgment", output_contract: "Assessment", knowledge_bindings: "package:sha256:none" };
        std::test::assert_eq_str(cat.leaf("judge", 1, 0, "judge", request, 2), "", "leaf");
        let limits = dna::AdmissionLimits { };
        let bound = cat.expand(ROOT, "judge", 1, limits);
        std::test::assert(bound.ok, "bound recipe: " + bound.why);
        // the graph names the position and its charter (GH #1085); the hat reads it from the record
        self.f.append("graph.node", "position:agent", "{\"kind\": \"position\", \"name\": \"agent\", \"text\": " + dna::record_json_quote(CHARTER) + "}");
        // the record attaches an application written in Hale (what `init` seeds)
        self.f.append("application.attached", ".", "{\"name\": \"hatapp\"}");
        self.f.append("graph.node", "language:hale", "{\"kind\": \"language\", \"name\": \"hale\"}");
        self.f.append("graph.node", "application:hatapp", "{\"kind\": \"application\", \"name\": \"hatapp\"}");
        self.f.append("graph.edge", "written_in:application:hatapp|language:hale", "{\"kind\": \"written_in\", \"members\": [{\"role\": \"application\", \"node\": \"application:hatapp\"}, {\"role\": \"language\", \"node\": \"language:hale\"}]}");
        self.f.append("task.born", ROOT, "hat-ask: judge (workflow)");
        self.f.append("workflow.admitted", ROOT, dna::encode_admission(dna::AdmittedWorkflow { task_id: ROOT, definition: "judge", revision: 1, recipe: cat.encode_bound(), limits: limits, works: 1, tasks: 1, steps: 1, depth: 1 }));
        self.f.append("step.registered", STEP, dna::encode_members(dna::RegisteredMembers { step_id: STEP, task_id: ROOT, workflow_id: ROOT + "/wf1", step_index: 0, members: "judge:leaf:" + WORK }));
        self.f.append("step.activated", STEP, dna::encode_activation(dna::ActivatedStep { step_id: STEP, task_id: ROOT, workflow_id: ROOT + "/wf1", step_index: 0, dispatched: "judge" }));
        self.f.append("attempt.admitted", dna::attempt_id_of(WORK, 0), dna::encode_attempt(dna::AdmittedAttempt { attempt_id: dna::attempt_id_of(WORK, 0), work_id: WORK, step_id: STEP, task_id: ROOT, attempt_no: 0, performer_kind: "agent", request: request }));
    }
    // A second Task whose admission carries the leader's plan for an
    // organism change: its Work is the organization's, not the application's.
    fn seed_change(root: String, inputs: String) {
        let step = root + "/wf1/s0";
        let work = step + "/judge";
        let cat = dna::WorkflowCatalog { };
        std::test::assert_eq_str(cat.define("judge", 1, "record", "one judgment"), "", "definition");
        let request = dna::WorkRequest { objective: "shape the genome by a proposal", target: "org", requires: "judgment", output_contract: "Assessment" };
        std::test::assert_eq_str(cat.leaf("judge", 1, 0, "judge", request, 2), "", "leaf");
        let limits = dna::AdmissionLimits { };
        let bound = cat.expand(root, "judge", 1, limits);
        std::test::assert(bound.ok, "bound recipe: " + bound.why);
        self.f.append("task.born", root, "hat-org-ask: judge (workflow)");
        self.f.append("workflow.admitted", root, dna::encode_admission(dna::AdmittedWorkflow { task_id: root, definition: "judge", revision: 1, recipe: cat.encode_bound(), inputs: inputs, limits: limits, works: 1, tasks: 1, steps: 1, depth: 1 }));
        self.f.append("step.registered", step, dna::encode_members(dna::RegisteredMembers { step_id: step, task_id: root, workflow_id: root + "/wf1", step_index: 0, members: "judge:leaf:" + work }));
        self.f.append("step.activated", step, dna::encode_activation(dna::ActivatedStep { step_id: step, task_id: root, workflow_id: root + "/wf1", step_index: 0, dispatched: "judge" }));
        self.f.append("attempt.admitted", dna::attempt_id_of(work, 0), dna::encode_attempt(dna::AdmittedAttempt { attempt_id: dna::attempt_id_of(work, 0), work_id: work, step_id: step, task_id: root, attempt_no: 0, performer_kind: "agent", request: request }));
    }
    fn seed_organization_change() {
        self.seed_change(ORG_ROOT, "{\"planned\": true, \"kind\": \"organism\", \"class\": \"organization\"}");
    }
    fn run_cases() {
        self.seed();
        let service = api::Api { root: self.f.root, local_name: "riley" };
        let capabilities = self.get(service, "/capabilities", 200, "CapabilitiesResponse");
        self.json.is_bool(self.json.raw(self.json.data(capabilities), "reads"), "context", true);
        // the hat, twice at one head: one digest
        let first = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        let hat = self.json.data(first);
        self.json.eq(hat, "work_id", WORK);
        self.json.eq(hat, "task_id", ROOT);
        self.json.eq(hat, "attempt_id", dna::attempt_id_of(WORK, 0));
        self.json.eq(hat, "performer_kind", "agent");
        self.json.eq(self.json.raw(hat, "position"), "id", "position:agent");
        self.json.eq(self.json.raw(hat, "position"), "charter", CHARTER);
        self.json.eq(hat, "objective", "assess the storage migration");
        self.json.eq(hat, "output_contract", "Assessment");
        self.json.eq(hat, "data_class", "internal");
        self.json.eq(hat, "requires", "judgment");
        // an Assessment's hands are the read-only infrastructure (dna/core/contracts.hl)
        self.json.eq(hat, "tool_grant", "record_status record_history org_chart");
        self.json.eq(hat, "validators", "");
        self.json.eq(hat, "knowledge_bindings", "package:sha256:none");
        self.json.eq(hat, "head", self.json.string(self.json.raw(first, "source"), "record_head"));
        // the targets the package is drawn for (seed/pull): the Work's path, the
        // codebase's language, the performer's position — and the digest covers them
        self.json.eq(hat, "targets", "org language:hale position:agent");
        let narrower = dna::Hat { ok: true, work_id: WORK, targets: "org position:agent" };
        let wider = dna::Hat { ok: true, work_id: WORK, targets: "org language:hale position:agent" };
        std::test::assert(dna::hat_digest(narrower) != dna::hat_digest(wider), "the hat digest changes when the target set does");
        std::test::assert_eq_str(dna::hat_digest(wider), dna::hat_digest(dna::Hat { ok: true, work_id: WORK, targets: "org language:hale position:agent" }), "and only then");
        let status = self.json.string(hat, "practices_status");
        std::test::assert(status == "no memory" || status == "resolved" || status == "unavailable", "the hat says how its practices were read: " + status);
        if status != "resolved" { self.json.eq(hat, "watermark", "-1"); std::test::assert_eq_str(self.json.raw(hat, "practices"), "[]", "no practices without memory"); }
        std::test::assert(std::str::contains(self.json.raw(hat, "history"), "{\"kind\": \"attempt.admitted\", \"id\": \"" + dna::attempt_id_of(WORK, 0) + "\""), "the Work's history as facts: " + self.json.raw(hat, "history"));
        let digest = self.json.string(hat, "digest");
        std::test::assert(std::str::starts_with(digest, "sha256:") && len(digest) == 71, "the digest names the hat: " + digest);
        let again = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        std::test::assert_eq_str(self.json.string(self.json.data(again), "digest"), digest, "rendered twice at one head, one digest");
        // the digest is over the body: what the hat says is what it hashes
        let body = self.json.data(first);
        let cut = std::str::index_of(body, ", \"digest\": ");
        std::test::assert(cut > 0, "the digest is the last field: " + body);
        std::test::assert_eq_str(dna::digest_of(body[0..cut] + "}"), digest, "sha256 over the canonical body, the digest itself left out");
        // a row that moves the head moves the digest: the hat is fenced to the head it was rendered at
        self.f.append("task.born", "hat-other", "hat-ask-2: another judge (workflow)");
        let moved = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        std::test::assert(self.json.string(self.json.data(moved), "head") != self.json.string(hat, "head"), "the head moved");
        std::test::assert(self.json.string(self.json.data(moved), "digest") != digest, "and so did the digest");
        // an organization change is the design's, not the application's: its
        // set holds system:dna and no language
        self.seed_organization_change();
        let org = self.get(service, "/dna/context?id=" + dna::url_encode(ORG_WORK), 200, "ContextResponse");
        self.json.eq(self.json.data(org), "targets", "org system:dna position:agent");
        // an organization change needs a recorded plan, as the owner's edit
        // class reads it: an admission that is not planned is application work
        let shapes = ["{\"planned\": false, \"kind\": \"organism\"}", "{\"kind\": \"organism\"}", "{\"class\": \"organization\"}"];
        let mut n = 0;
        while n < 3 {
            let root = "hat-unplanned" + to_string(n);
            self.seed_change(root, shapes[n]);
            let unplanned = self.get(service, "/dna/context?id=" + dna::url_encode(root + "/wf1/s0/judge"), 200, "ContextResponse");
            self.json.eq(self.json.data(unplanned), "targets", "org language:hale position:agent");
            n = n + 1;
        }
        // an edge contributes its language only while both its nodes are live:
        // retiring the language node, or the application node, takes it out
        // though the edge row stays; stating the node again brings it back
        self.f.append("graph.retired", "language:hale", "{}");
        let no_language = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        self.json.eq(self.json.data(no_language), "targets", "org position:agent");
        self.f.append("graph.node", "language:hale", "{\"kind\": \"language\", \"name\": \"hale\"}");
        let language_back = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        self.json.eq(self.json.data(language_back), "targets", "org language:hale position:agent");
        self.f.append("graph.retired", "application:hatapp", "{}");
        let no_application = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        self.json.eq(self.json.data(no_application), "targets", "org position:agent");
        self.f.append("graph.node", "application:hatapp", "{\"kind\": \"application\", \"name\": \"hatapp\"}");
        let application_back = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        self.json.eq(self.json.data(application_back), "targets", "org language:hale position:agent");
        // a retired edge leaves the set, and the digest with it
        self.f.append("graph.retired", "written_in:application:hatapp|language:hale", "{}");
        let unwritten = self.get(service, "/dna/context?id=" + dna::url_encode(WORK), 200, "ContextResponse");
        self.json.eq(self.json.data(unwritten), "targets", "org position:agent");
        // a Work the record does not bind, and a read that names none
        self.get(service, "/dna/context?id=hat-close%2Fwf1%2Fs0%2Fnobody", 404, "ErrorResponse");
        self.get(service, "/dna/context", 400, "ErrorResponse");
        eprintln("PASS the hat as a read");
    }
}

fn main() {
    let f = fixture::Fixture { root: "/tmp/hale-api-context." + to_string(std::process::pid()) };
    let cases = HatCases { f: f };
    cases.run_cases();
}
