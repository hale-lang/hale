// Decision line 4, the failure route bound at birth in every spine
// (FailureDelivery, Reclaim). Shipped at inventory row C25.
//
// `Flowing` is accepted and released by App. Its empty run completes
// through the reclaim spine; the failing dissolve closure must read the
// route stored at construction and reach App exactly once before reclaim.
// Before the fix, resolving with Flowing itself as parent exited instead.
//
// Expected terminal outcome: `outcome: owner-handled-once`.

locus Flowing {
    params { left: Int = 1; }
    closure clean { self.left ~~ 0 within 0; epoch dissolve; }
    run() { }
}

main locus App {
    params { fired: Int = 0; }
    accept(c: Flowing) { }
    release(c: Flowing) { }
    on_failure(c: Flowing, err: ClosureViolation) { self.fired = self.fired + 1; }
    run() {
        Flowing { };
        std::time::sleep(50ms);
        if self.fired == 1 {
            println("outcome: owner-handled-once");
        } else {
            println("outcome: fired=" + to_string(self.fired));
        }
    }
}

fn main() { App { }; }
