// dna/tests/relay_repeated_request_test.hl — each request in the record
// gets its own relay, even when several share one entity (GH #689).
//
// A concern's entity is its source, so three concerns from one worker are
// three `concern.requested` rows with one entity. The host relays each row
// once and treats it as answered when its own answer is journaled; with
// the answer matched by entity alone, the first `concern.raised` answered
// every later request and the third concern was never relayed (the trio
// and knowledge fixtures failed on it under load). Here two concerns from
// one source go into the record of a running organism; the first one's
// relay is lost on the nerves (the fixture takes it off the
// organization's consumer while the organization is stopped, GH #986),
// and both must become `concern.raised`, each once.

import "../core" as dna;
import "../core/pond/realtime/nats" as nats;

// Whether the organization is reading its facts: its durable consumer has
// a pull outstanding ("" when it has; otherwise why not). The host asks
// the same of the stream; the core, which imports no NATS, cannot.
fn listening(c: nats::NatsClient, org: String) -> String {
    let info = nats::js_call(c, dna::nerves_info_subject_of(org, ""), "") or "";
    if len(info) == 0 { return c.last_error; }
    if std::json::find_int_field(info, "num_waiting") > 0 { return ""; }
    return "no pull outstanding on " + dna::nerves_stream(org) + "." + dna::nerves_durable_of("");
}

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`: discovery and hosted models off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && unset ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

// How many times the host said it relayed something onto the nerves.
@unbounded
fn relays(app: String) -> Int {
    let needle = "fact(s) from the record onto the nerves";
    let mut rest = std::io::fs::read_file(app + "/host.log") or "";
    let mut n = 0;
    let mut at = std::str::index_of(rest, needle);
    while at >= 0 {
        n = n + 1;
        rest = rest[(at + len(needle))..len(rest)];
        at = std::str::index_of(rest, needle);
    }
    return n;
}

fn log_has(app: String, needle: String) -> Bool {
    return std::str::contains(std::io::fs::read_file(app + "/host.log") or "", needle);
}

// Whether the organization's durable consumer has a pull outstanding,
// waiting up to `secs` for it to be `want`.
fn wait_listening(c: nats::NatsClient, org: String, want: Bool, secs: Int) -> Bool {
    let deadline = std::time::now() + dna::wait_secs(secs);
    while std::time::now() <= deadline {
        if (len(listening(c, org)) == 0) == want { return true; }
        std::time::sleep(100ms);
    }
    return false;
}

// Take the next message off the organization's durable consumer and
// acknowledge it, as the organization would once it had dispatched it:
// the fact is gone from the stream's view of what the organization has
// still to read. Its subject and its payload (the bus's encoding, in
// hex), "" when there was none.
fn steal(c: nats::NatsClient, org: String) -> String {
    let m = nats::js_next(c, dna::nerves_stream(org), dna::nerves_durable_of(""), 2000) or nats::NatsMsg { };
    if len(m.reply) == 0 { return ""; }
    nats::js_ack(c, m) or discard;
    c.flush() or discard;
    return m.subject + " " + dna::hex(m.data);
}

// Whether a message `steal` took carries `text` in its payload.
fn carries(taken: String, text: String) -> Bool { return std::str::contains(taken, dna::hex(std::bytes::from_string(text))); }

// How many rows answer this request, by identity: the id is a field of
// its own in the body, read back whole and compared whole (GH #689
// review). An answer to `c10` must not count as an answer to `c1`.
@unbounded
fn answers(repo: String, request: String) -> Int {
    let j = dna::GitJournal { repo: repo };
    let mut n = 0;
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "concern.raised" && dna::request_named(e.body) == request { n = n + 1; }
        i = i + 1;
    }
    return n;
}

@unbounded
fn rows(repo: String, kind: String, needle: String) -> Int {
    let j = dna::GitJournal { repo: repo };
    let mut n = 0;
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == kind && (std::str::contains(e.entity, needle) || std::str::contains(e.body, needle)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn record(app: String) -> String {
    let j = dna::GitJournal { repo: app };
    return journal_text(j);
}

@unbounded
fn journal_text(j: dna::GitJournal) -> String {
    let mut out = "";
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        out = out + e.kind + " " + e.entity + " " + e.body + "\n";
        i = i + 1;
    }
    return out;
}

main locus App {
    run() {
        let scratch = dna::scratch_root("relayrepeat");
        // whatever this fixture starts under its scratch stops when it does (#637)
        dna::reap_on_exit(scratch);
        let nats_owner = if std::env::var_exists("HALE_DNA_NATS_URL_OWNER") { std::env::var("HALE_DNA_NATS_URL_OWNER") } else { "" };
        if len(nats_owner) == 0 {
            eprintln("relay_repeated_request_test: not exercised (HALE_DNA_NATS_URL_OWNER is not set)");
            dna::scratch_done(scratch);
            return;
        }
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\nrepeated");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let a = scratch + "/repeated";
        let g1 = in_dir(a, "git\nconfig\nuser.name\norganism-host");
        let g2 = in_dir(a, "git\nconfig\nuser.email\nhost@dna");
        let g3 = in_dir(a, "git\nadd\n-A");
        let g4 = in_dir(a, "git\ncommit\n-q\n-m\nthe app");

        // the organization's stream, and what the spine connects with
        let nerves = in_dir(a, "sh\n-c\nHALE_DNA_NATS_URL_OWNER=\"$2\" exec \"$1\" dna nerves migrate\nsh\n" + toolchain() + "\n" + nats_owner);
        let spine = line_value(nerves.stdout, "HALE_DNA_NATS_URL_SPINE");
        let org = line_value(nerves.stdout, "HALE_DNA_NATS_ORG");
        std::test::assert(nerves.code == 0 && len(spine) > 0 && len(org) > 0, "the nerves' stream is in place: " + nerves.stdout + nerves.stderr);

        let started = in_dir(a, "sh\n-c\nHALE_DNA_NATS_URL_SPINE=\"$2\" HALE_DNA_NATS_ORG=\"$3\" nohup timeout 300 \"$1\" dna run . --no-iris >host.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + spine + "\n" + org);
        let host_pid = dna::trim_nl(started.stdout);
        let mut up = false;
        let deadline = std::time::now() + dna::wait_secs(300);
        while !up && std::time::now() <= deadline {
            if log_has(a, "the organization reads its facts from the nerves") && log_has(a, "hale dna run: genome ") { up = true; } else { std::time::sleep(500ms); }
        }
        std::test::assert(up, "the organization came up and reads its facts from the nerves: " + (std::io::fs::read_file(a + "/host.log") or ""));
        let org_pid = dna::trim_nl(std::io::fs::read_file(a + "/.hale/dna/org.pid") or "");
        std::test::assert(len(org_pid) > 0, "the organization's pid is written");

        // Two concerns from one source. The first delivery is lost, the
        // second is answered. The lost one must still be delivered: its
        // answer is named by its own id, not by any answer for its source
        // (GH #689). Each concern says something of its own, so the answers
        // can be told apart.
        //
        // The ids are `c1` and `c10`, one a prefix of the other (the review
        // of the first fix): matching the id by searching the body for it
        // lets c10's answer pass for c1's, and c1 — whose delivery was lost
        // — is then never relayed again.
        let j = dna::GitJournal { repo: a, author: "edge" };
        let first = "{\"request\": \"c1\", \"source\": \"org/repeated/worker\", \"what\": \"mail backlog behind fulfilment\", \"severity\": 2}";
        let second = "{\"request\": \"c10\", \"source\": \"org/repeated/worker\", \"what\": \"the printer is out of paper\", \"severity\": 1}";

        // The first delivery is lost on the nerves: the organization stops
        // reading (once its outstanding pull has expired, a second, nothing
        // reaches it), the host relays the concern, and the fixture takes
        // it off the organization's consumer and acknowledges it.
        let c = nats::NatsClient { url: spine, name: "relay-repeat-thief", timeout: 2s };
        std::test::assert(c.open(), "the fixture reaches the nerves: " + c.last_error);
        let stopped = dna::run_tool("kill\n-STOP\n" + org_pid);
        std::test::assert_eq_int(stopped.code, 0, "the organization is stopped: " + stopped.stderr);
        std::test::assert(wait_listening(c, org, false, 10), "and its pull expires: " + listening(c, org));
        let before = relays(a);
        let w1 = j.append(j.revision(), "concern.requested", "org/repeated/worker", first);
        std::test::assert(w1.ok, "the first concern is in the record: " + w1.error);
        let mut relayed = false;
        let relay_deadline = std::time::now() + dna::wait_secs(30);
        while !relayed && std::time::now() <= relay_deadline {
            if relays(a) > before { relayed = true; } else { std::time::sleep(250ms); }
        }
        std::test::assert(relayed, "the host relayed the first concern: " + (std::io::fs::read_file(a + "/host.log") or ""));
        let taken = steal(c, org);
        std::test::assert(std::str::contains(taken, "dna.concern.raised") && carries(taken, "mail backlog behind fulfilment"), "its delivery was lost: " + taken + " " + c.last_error);
        let resumed = dna::run_tool("kill\n-CONT\n" + org_pid);
        std::test::assert_eq_int(resumed.code, 0, "the organization runs again: " + resumed.stderr);
        std::test::assert(wait_listening(c, org, true, 10), "and reads the nerves again: " + listening(c, org));
        c.close();
        let w2 = j.append(j.revision(), "concern.requested", "org/repeated/worker", second);
        std::test::assert(w2.ok, "a second concern follows it");
        let mut answered_second = false;
        let mut tries = 0;
        while !answered_second && tries < 240 {
            answered_second = answers(a, "c10") == 1;
            if !answered_second { std::time::sleep(500ms); }
            tries = tries + 1;
        }
        std::test::assert(answered_second, "the second concern was raised: " + (std::io::fs::read_file(a + "/host.log") or ""));
        std::test::assert_eq_int(answers(a, "c1"), 0, "and the lost one is still unanswered, whatever c10's answer looks like");

        // the host relays an unanswered request again; the answer to the
        // second must not pass for the first's
        let mut answered_first = false;
        tries = 0;
        while !answered_first && tries < 300 {
            answered_first = answers(a, "c1") == 1;
            if !answered_first { std::time::sleep(500ms); }
            tries = tries + 1;
        }
        std::test::assert(answered_first, "the lost concern was delivered again and answered: " + (std::io::fs::read_file(a + "/host.log") or ""));
        std::test::assert_eq_int(rows(a, "concern.raised", "org/repeated/worker"), 2, "two concerns, two answers, neither doubled");
        std::test::assert_eq_int(rows(a, "concern.requested", "org/repeated/worker"), 2, "and two requests");

        let k1 = dna::run_tool("kill\n" + host_pid);
        let rest = dna::run_tool("sh\n-c\ncd \"$1\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -CONT $(cat .hale/dna/$f.pid) 2>/dev/null && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; done; true\nsh\n" + a);
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
