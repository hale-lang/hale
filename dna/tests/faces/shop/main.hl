// dna/tests/faces/shop — an organism that names two faces (named faces,
// Phase 3 DNA item 6). Its two ports are placeholders (1, 2) that a test
// rewrites to ports of its own (`dna::free_port`). `admin` consumes the
// `Orders` surface the shop serves and acts as an operator; `product` consumes `Catalog` and acts as
// a shopper. Each is a seed of its own under faces/, started on its port.
import "../../../core" as dna;

role operator;
role shopper;

type Ask { n: Int = 0; }
type Counted { n: Int = 0; }

locus Orders {
    fn count(a: Ask) -> Counted { return Counted { n: a.n }; }
}

locus Catalog {
    fn count(a: Ask) -> Counted { return Counted { n: a.n + 1 }; }
}

api OrdersSurface {
    rpc Orders::count requires: [operator];
}

api CatalogSurface {
    rpc Catalog::count requires: [shopper];
}

main locus Shop {
    params {
        orders: Orders = Orders { };
        catalog: Catalog = Catalog { };
        staff: std::api::StaticRoles = std::api::StaticRoles { known: "operator shopper" };
        office: api::Exposure = api::serve(OrdersSurface, unix::Rpc { path: "/tmp/hale-faces-fixture-orders.sock", roles: self.staff }, as: "office", receivers: { Orders: self.orders }, bound: 8, on_full: refuse);
        front: api::Exposure = api::serve(CatalogSurface, unix::Rpc { path: "/tmp/hale-faces-fixture-catalog.sock", roles: self.staff }, as: "front", receivers: { Catalog: self.catalog }, bound: 8, on_full: refuse);
        admin: dna::Face = dna::Face { app: "faces/admin", roles: "operator", consumes: "OrdersSurface", port: 1 };
        product: dna::Face = dna::Face { app: "faces/product", roles: "shopper", consumes: "CatalogSurface", port: 2 };
    }
    placement { orders: cooperative(pool = work) where async_io; catalog: cooperative(pool = work) where async_io; }
    run() {
        while !self.draining { std::time::sleep(100ms); }
        self.office.stop();
        self.front.stop();
    }
}

fn main() { Shop { }; }
