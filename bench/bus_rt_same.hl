// bus_rt_same — a bus round trip on one thread.
//
// main's run() publishes a Ping; Echo, on main's own pool, answers it
// with a Pong; main's handler counts it. main yields until the Pong is
// in, then sends the next Ping: one round trip at a time, so the time
// per round trip is the latency of two publishes and two dispatches
// through main's queue. Prints `iters=`, `got=` and `ns_per_rt=`.

type Ping {
    n: Int;
}

type Pong {
    n: Int;
}

locus Echo {
    bus {
        subscribe "bench.rt.ping" as on_ping of type Ping;
        publish "bench.rt.pong" of type Pong;
    }
    fn on_ping(p: Ping) {
        "bench.rt.pong" <- Pong { n: p.n };
    }
}

main locus App {
    params {
        echo: Echo = Echo { };
        got: Int = 0;
    }
    bus {
        publish "bench.rt.ping" of type Ping;
        subscribe "bench.rt.pong" as on_pong of type Pong;
    }
    fn on_pong(p: Pong) {
        self.got = self.got + 1;
    }
    run() {
        let iters = 200000;
        // warm-up: the first round trips build the queues' cells
        let mut i = 0;
        while i < 1000 {
            "bench.rt.ping" <- Ping { n: i };
            while self.got <= i { yield; }
            i = i + 1;
        }
        let base = self.got;
        let t0 = std::time::monotonic_ns();
        let mut k = 0;
        while k < iters {
            "bench.rt.ping" <- Ping { n: k };
            while self.got - base <= k { yield; }
            k = k + 1;
        }
        let t1 = std::time::monotonic_ns();
        println(f"iters={iters}");
        println(f"got={self.got - base}");
        println(f"ns_per_rt={(t1 - t0) / iters}");
    }
}

fn main() {
    App { };
}
