// dna/operations/context.hl — the hat (GH #946, slice 2), as a READ.
//
// The hat itself — the type, its canonical body, its digest, the ids a
// position and its grant take — is the core's (dna/core/hat.hl), since
// the owner builds one for the edits it asks and a head builds one for
// the leg that asks; this is the head's reader. It reads a journal the
// caller loaded — the record alone, or the record with the ledger an
// organism adopted (a routed journal under the head's role) — and memory
// under the head's role for the practices, as structure; keeps the hat in
// memory by its digest when memory is there; and says how the practices
// were read when it is not. Rendered twice at one head it is one digest;
// a row that moves the head moves it.
import "../core" as dna;

// What a hat's practices are drawn from: memory under a role, or a
// source a test hands in. `MemoryKnowledge` is one.
interface KnowledgeSource {
    fn ready() -> Bool;
    fn package_for(target: String, query: String) -> dna::ContextPackage;
    fn keep_hat(digest: String, head: String, watermark: Int, body: String) -> Bool;
}

// The reader: a caller-owned, already loaded journal, and memory under
// the caller's role for the practices (a head's; without memory the hat
// says so and carries none). `ledger_ready` says the journal carries the
// adopted ledger's rows: an adoption the journal cannot follow is a hat
// the reader refuses.
locus HatReader {
    params {
        j: dna::Journal;
        knowledge: KnowledgeSource = dna::MemoryKnowledge { };
        ledger_ready: Bool = false;
        p: dna::WorkflowProjection = dna::WorkflowProjection { };
        loaded: Bool = false;
        code: String = "";
        problem: String = "";
        kept: Int = 0; // hats kept in memory by this reader
    }
    fn fail(code: String, why: String) -> Bool { self.code = code; self.problem = why; return false; }
    fn workflow_fact(kind: String) -> Bool {
        return kind == "workflow.admitted" || kind == "workflow.refused" || kind == "workflow.settled" || kind == "step.registered" || kind == "step.activated"
            || kind == "step.completed" || kind == "step.failed" || kind == "attempt.admitted" || kind == "attempt.outcome" || kind == "work.settled";
    }
    // The execution facts, replayed into the projection under the same
    // bounds the execution reader keeps.
    @unbounded
    fn load() -> Bool {
        if self.loaded { return true; }
        if self.j.revision() > 2048 { return self.fail("context_read_limit", "the context reader's event budget was exceeded"); }
        let mut i = 0;
        let mut bytes = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "ledger.adopted" && !self.ledger_ready { return self.fail("context_source_unavailable", "this application has adopted a Ledger; the hat reads it from memory under the head's role (HALE_DNA_MEMORY_DSN_HEAD), which is not named here"); }
            if self.workflow_fact(e.kind) {
                bytes = bytes + len(e.body);
                if len(e.body) > 65536 || bytes > 524288 || self.p.fact_count() >= 512 { return self.fail("context_read_limit", "the context reader's fact budget was exceeded"); }
                let applied = dna::replay(self.p, e.kind, e.entity, e.body);
                if !applied.ok { return self.fail("context_source_invalid", "a recorded execution fact was refused by the native projection: " + applied.why); }
                if self.p.node_count() > 256 { return self.fail("context_read_limit", "the context reader's bound-node budget was exceeded"); }
            }
            i = i + 1;
        }
        self.loaded = true;
        return true;
    }
    // The Work's history as facts: every execution fact about the Work —
    // its attempts admitted and settled, its settlement — by record order.
    @unbounded
    fn history_json(work_id: String) -> String {
        let b = std::json::Builder { };
        b.begin_array();
        let mut i = 0;
        while i < self.p.fact_count() {
            let f = self.p.facts.get(i) or dna::Fact { };
            let node = if f.kind == "attempt.admitted" || f.kind == "attempt.outcome" { std::json::find_string_field(f.body, "work_id") } else { f.id };
            if node == work_id {
                b.begin_object();
                b.string_field("kind", f.kind);
                b.string_field("id", f.id);
                b.string_field("order", to_string(i));
                b.end_object();
            }
            i = i + 1;
        }
        b.end_array();
        return b.result();
    }
    // The hat for a Work, at this reading of the record: built, digested,
    // and kept in memory under its digest when memory is there.
    @unbounded
    fn read(work_id: String) -> dna::Hat {
        if !self.load() { return dna::Hat { code: self.code, why: self.problem }; }
        let mut node = dna::BoundNode { };
        let mut i = 0;
        while i < self.p.node_count() {
            let n = self.p.tree.get(i) or dna::BoundNode { };
            if n.kind == "work" && n.id == work_id { node = n; }
            i = i + 1;
        }
        if len(node.id) == 0 { return dna::Hat { code: "work_not_found", why: "no bound Work `" + work_id + "` in any admitted execution" }; }
        let w = self.p.work(work_id);
        let admitted = if len(w.attempt_id) > 0 { dna::recorded_attempt_admission(self.j, w.attempt_id, self.j.revision()) } else { dna::DecodedAttempt { } };
        let kind = if admitted.ok { admitted.value.performer_kind } else { dna::hat_kind_of(node.requires) };
        let position = dna::hat_position_of(kind);
        let h = dna::Hat {
            ok: true, work_id: work_id, task_id: w.task_id, step_id: w.step_id, attempt_id: w.attempt_id, performer_kind: kind,
            position_id: position, charter: dna::hat_node_text(self.j, position),
            objective: node.objective, target: node.target, output_contract: node.output_contract, data_class: node.data_class,
            requires: node.requires, cost_ceiling: node.cost_ceiling, tool_grant: dna::hat_tool_grant(kind), knowledge_bindings: node.knowledge_bindings,
            history: self.history_json(work_id), head: self.j.head()
        };
        let ready = self.knowledge.ready();
        let pkg = if ready { self.knowledge.package_for(dna::hat_knowledge_target(h.target), h.objective) } else { dna::ContextPackage { } };
        let sealed = dna::hat_sealed(dna::hat_with_package(h, pkg, ready));
        if ready && self.knowledge.keep_hat(sealed.digest, sealed.head, sealed.watermark, dna::hat_body(sealed)) { self.kept = self.kept + 1; }
        return sealed;
    }
}

// The hat on the wire, as the core renders it.
fn hat_json(h: dna::Hat) -> String { return dna::hat_json(h); }
fn hat_body(h: dna::Hat) -> String { return dna::hat_body(h); }
fn hat_digest(h: dna::Hat) -> String { return dna::hat_digest(h); }
fn hat_position_of(kind: String) -> String { return dna::hat_position_of(kind); }
