import "../validator" as wire_contract;

locus Cases {
    // expect() checks every case against the one contract schema text, so it
    // shares one Validator, which profiles that text once (#1009).
    params { root: String; schema: String; fixtures: String; validator: wire_contract::Validator = wire_contract::Validator { }; }
    fn expect(name: String, json: String, valid: Bool, note: String) {
        let result = self.validator.validate_schema(self.schema, name, json);
        std::test::assert(result.ok == valid, note + ": " + result.error);
        if !valid { std::test::assert(len(result.error) > 0, note + ": rejection must explain failure"); }
    }
    fn custom(spec: String, json: String, valid: Bool, note: String) {
        let validator = wire_contract::Validator { root: self.root };
        let result = validator.validate_schema("{\"$defs\":{\"Case\":" + spec + "}}", "Case", json);
        std::test::assert(result.ok == valid, note + ": " + result.error);
    }
    fn unsupported(schema: String, note: String) {
        let validator = wire_contract::Validator { root: self.root };
        let result = validator.schema_profile(schema);
        std::test::assert(!result.ok && len(result.error) > 0, note);
    }
    fn example(name: String) -> String {
        let mut items = std::json::array_first(self.fixtures);
        while !items.done {
            if std::json::find_string_field(items.element, "name") == name { return std::json::find_field_raw(items.element, "value"); }
            items = std::json::array_next(items);
        }
        std::test::assert(false, "missing fixture " + name);
        return "";
    }
    fn field(json: String, name: String, raw: String) -> String {
        // Empty raw omits the property; otherwise replace/add exactly one key.
        let builder = std::json::Builder { };
        builder.begin_object();
        let mut fields = std::json::object_first(json);
        while !fields.done {
            let key = std::json::obj_key_string(fields, json);
            if key != name { builder.field(key, std::json::obj_value_raw(fields, json)); }
            fields = std::json::object_next(fields, json);
        }
        if len(raw) > 0 { builder.field(name, raw); }
        builder.end_object();
        return builder.result();
    }
    fn first(json: String) -> String {
        let data = std::json::find_field_raw(json, "data");
        let items = std::json::array_first(std::json::find_field_raw(data, "items"));
        std::test::assert(!items.done, "fixture contains an item");
        return items.element;
    }
    fn wire_cases() {
        let application = self.example("application-discovery");
        let source = std::json::find_field_raw(application, "source");
        self.expect("Source", source, true, "source baseline");
        self.expect("Source", self.field(source, "record_id", ""), false, "missing required identity");
        self.expect("Source", self.field(source, "record_id", "\"\""), false, "empty identity");
        self.expect("Source", self.field(source, "record_revision", "\"00\""), false, "leading zero revision");
        self.expect("Source", self.field(source, "record_revision", "\"+1\""), false, "signed revision");
        self.expect("Source", self.field(source, "record_revision", "\"1e3\""), false, "exponent revision");
        self.expect("Source", self.field(source, "record_revision", "\"999999999999999999999999999999\""), true, "decimal revision has no machine integer truncation");
        self.expect("Source", self.field(source, "record_revision", "123"), false, "revision must remain a string");
        let page = std::json::find_field_raw(std::json::find_field_raw(application, "data"), "page");
        self.expect("Page", self.field(page, "limit", "0"), false, "positive limit");
        self.expect("Page", self.field(page, "limit", "101"), false, "bounded limit");
        self.expect("Page", self.field(page, "offset", "1000001"), false, "bounded offset");
        self.expect("Page", self.field(page, "next_offset", "-2"), false, "next offset lower bound");
        self.expect("Page", self.field(page, "total", "true"), false, "bool is not integer");
        self.expect("Page", self.field(page, "limit", "1.0"), false, "wire integers use integer tokens");
        self.expect("Page", self.field(page, "limit", "1e0"), false, "wire integers disallow exponent tokens");
        self.expect("Page", self.field(page, "limit", "999999999999999999999999999999"), false, "bounds do not overflow");
        self.expect("Page", self.field(page, "total", "-999999999999999999999999999999"), false, "negative bound does not overflow");
        self.expect("Page", self.field(page, "total", "999999999999999999999999999999"), true, "unbounded integer comparison is exact");
        self.expect("Page", self.field(page, "actor", "\"spoof\""), false, "nested unknown field");
        let practice = self.first(self.example("approved-is-not-ratified"));
        self.expect("Practice", self.field(practice, "state", "\"active\""), false, "unknown practice state");
        self.expect("Practice", self.field(practice, "ratified", "1"), false, "integer is not bool");
        self.expect("Practice", self.field(practice, "text_status", "\"available\\u0000\""), false, "NUL cannot truncate enum");
        self.expect("Practice", self.field(practice, "text_available", "false"), false, "hidden practice body is forbidden");
        let mut hidden = self.field(practice, "text_available", "false");
        hidden = self.field(hidden, "text", "\"\"");
        hidden = self.field(hidden, "rationale", "\"\"");
        hidden = self.field(hidden, "review_settled", "\"\"");
        hidden = self.field(hidden, "text_status", "\"source_unavailable\"");
        self.expect("Practice", hidden, true, "hidden practice retains state and typed outcome");
        self.expect("Practice", self.field(hidden, "text", "\"leak\""), false, "hidden body leak");
        self.expect("Practice", self.field(hidden, "rationale", "\"leak\""), false, "hidden rationale leak");
        self.expect("Practice", self.field(hidden, "review_settled", "\"approve leak\""), false, "hidden settlement leak");
        let review = self.first(self.example("review-settlement"));
        let mut protected = self.field(review, "text_status", "\"protected\"");
        protected = self.field(protected, "text_available", "false");
        protected = self.field(protected, "question", "\"\"");
        protected = self.field(protected, "settled", "\"\"");
        self.expect("Review", protected, true, "protected review");
        self.expect("Review", self.field(protected, "question", "\"leak\""), false, "hidden review question leak");
        self.expect("Review", self.field(protected, "settled", "\"approve leak\""), false, "hidden review settlement leak");
        self.expect("Review", self.field(protected, "text_available", "true"), false, "hidden review availability");
        self.expect("Review", self.field(protected, "outcome", "\"activate\""), false, "unknown outcome");
        let ordinary = self.field(self.field(review, "text_status", "\"not_applicable\""), "text_available", "false");
        self.expect("Review", ordinary, true, "ordinary review question has no canonical practice receipt");
        let error = self.example("source-unavailable");
        self.expect("ErrorResponse", self.field(error, "api_version", "\"hale.v1\\u0000\""), false, "NUL cannot truncate constant");
        self.expect("ErrorResponse", self.field(error, "api_version", "\"hale.v1\\n\""), false, "escaped suffix is unequal");
        self.expect("ErrorResponse", self.field(error, "api_version", "\"hale.v\\u0031\""), true, "escaped constant decoded exactly");
        self.expect("NoSuchResponse", error, false, "unknown named schema");
        self.expect("ErrorResponse", error + " true", false, "trailing JSON token");
        self.expect("ErrorResponse", "{\"api_version\":\"hale.v1\",\"api_version\":\"hale.v1\"}", false, "duplicate keys");
        self.expect("ErrorResponse", "{\"api_\\u0076ersion\":\"hale.v1\"}", false, "escaped keys fail closed");
    }
    fn definition_cases() {
        let catalog = self.example("definitions-declared-catalog");
        self.expect("DefinitionsResponse", catalog, true, "declared definitions baseline");
        let data = std::json::find_field_raw(catalog, "data");
        let basis = std::json::find_field_raw(data, "basis");
        self.expect("DefinitionBasis", self.field(basis, "provenance_kind", "\"current_git_head\""), false, "provenance is a loaded-source host claim");
        self.expect("DefinitionBasis", self.field(basis, "catalog_digest", "\"\""), false, "catalog digest is required");
        let limits = std::json::find_field_raw(basis, "limits");
        self.expect("DefinitionLimits", self.field(limits, "max_attempts", "8"), false, "admission limits remain exact decimal strings");
        self.expect("DefinitionLimits", self.field(limits, "max_depth", "\"-1\""), false, "limits cannot be signed");
        self.expect("DefinitionDecimal", "\"-9223372036854775808\"", true, "signed native Int minimum is preserved");
        self.expect("DefinitionDecimal", "\"9007199254740993\"", true, "revision beyond JavaScript safe integer remains exact");
        self.expect("DefinitionDecimal", "\"0\"", true, "native definition reads preserve zero");
        self.expect("DefinitionDecimal", "\"-0\"", false, "negative zero is not canonical");
        self.expect("DefinitionDecimal", "\"-01\"", false, "negative leading zero is not canonical");
        self.expect("DefinitionDecimal", "\"+1\"", false, "positive sign is not canonical");
        self.expect("DefinitionDecimal", "\"1e3\"", false, "exponent string is not decimal");
        self.expect("DefinitionDecimal", "\"-\"", false, "minus alone is not decimal");
        self.expect("DefinitionDecimal", "1", false, "JSON number cannot replace exact string");
        let capabilities = std::json::find_field_raw(self.example("read-only-capabilities"), "data");
        let reads = std::json::find_field_raw(capabilities, "reads");
        self.expect("Capabilities", self.field(capabilities, "reads", self.field(reads, "definitions", "")), false, "definition support is explicit even for the default head");
    }
    // The record's commands are the head's api binding: capabilities say
    // where (`api`) and carry no write flags or command profiles.
    fn capabilities_cases() {
        let response = self.example("read-only-capabilities");
        self.expect("CapabilitiesResponse", response, true, "a read-only head names its api socket");
        let data = std::json::find_field_raw(response, "data");
        self.expect("Capabilities", self.field(data, "read_only", "false"), false, "HTTP writes nothing itself: every command is the binding's");
        let api = std::json::find_field_raw(data, "api");
        self.expect("Capabilities", self.field(data, "api", ""), false, "where the commands are is required");
        self.expect("Capabilities", self.field(data, "api", self.field(api, "transport", "\"tcp\"")), false, "the api binding is a unix socket");
        self.expect("Capabilities", self.field(data, "api", self.field(api, "socket", "")), false, "the socket is named, even when empty");
        self.expect("Capabilities", self.field(data, "api", self.field(api, "socket", "\"\"")), true, "an in-process listener has no socket");
        self.expect("Capabilities", self.field(data, "api", self.field(api, "roles", "[]")), false, "gates are the socket's description, not capabilities");
        self.expect("Capabilities", self.field(data, "writes", "{\"practice_propose\":false,\"review_verdict\":false}"), false, "no record write flags over HTTP");
        self.expect("Capabilities", self.field(data, "commands", "{}"), false, "no record command profile over HTTP");
    }
    fn profile_cases() {
        self.custom("{\"type\":\"array\",\"maxItems\":1}", "[1]", true, "array at bound");
        self.custom("{\"type\":\"array\",\"maxItems\":1}", "[1,2]", false, "array exceeds bound");
        self.custom("{\"type\":\"array\",\"maxItems\":0}", "[]", true, "empty bound");
        self.custom("{\"type\":\"string\",\"maxItems\":1}", "\"text\"", false, "array bound requires array type");
        let nullable = "{\"anyOf\":[{\"type\":\"integer\",\"minimum\":0},{\"type\":\"null\"}]}";
        self.custom(nullable, "null", true, "absent native capacity stays null");
        self.custom(nullable, "0", true, "zero native capacity is distinct from null");
        self.custom(nullable, "999999999999999999999", true, "nullable integer has no machine truncation");
        self.custom(nullable, "-1", false, "bounds apply inside anyOf");
        self.custom(nullable, "\"unknown\"", false, "nullable capacity refuses another type");
        self.custom(nullable, "true", false, "boolean is not an integer alternative");
        self.custom("{\"anyOf\":[{}, {\"type\":\"null\"}]}", "null", true, "anyOf permits overlapping matches");
        self.unsupported("{\"$defs\":{\"X\":{\"anyOf\":[]}}}", "empty alternative list refused");
        self.unsupported("{\"$defs\":{\"X\":{\"anyOf\":[{}, {\"format\":\"email\"}]}}}", "unsupported alternate cannot hide behind a matching branch");
        self.unsupported("{\"$defs\":{\"X\":{\"anyOf\":[{}, {\"$ref\":\"#/$defs/X\"}]}}}", "reference cycles cannot hide behind a matching alternate");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":\"string\",\"format\":\"email\"}}}", "unsupported keyword cannot silently pass");
        self.unsupported("{\"$defs\":{\"X\":{\"pattern\":\".*\"}}}", "unsupported regex cannot silently pass");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"#/$defs/Missing\"}}}", "unresolved reference");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"https://example.invalid/schema\"}}}", "external reference never fetched");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"#/$defs/X\"}}}", "direct reference cycle");
        self.unsupported("{\"$defs\":{\"X\":{\"if\":{\"$ref\":\"#/$defs/X\"},\"then\":{\"const\":false}}}}", "conditional reference cycle");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"#/$defs/Y\"},\"Y\":{\"$ref\":\"#/$defs/X\"}}}", "indirect reference cycle");
        self.unsupported("{\"$defs\":{\"X\":{\"minimum\":1}}}", "numeric bounds cannot silently skip noninteger values");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":\"number\"}}}", "unsupported number type");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":[\"string\",\"boolean\"]}}}", "unsupported union type");
        self.unsupported("{\"$defs\":{\"X\":{\"additionalProperties\":true}}}", "unsupported open additional properties keyword");
        self.unsupported("{\"$defs\":{\"X\":{\"required\":[\"missing\"]}}}", "required names need declared properties");
        self.unsupported("{\"$defs\":{\"X\":{\"if\":{}}}}", "unpaired condition");
        self.unsupported("{\"$defs\":{\"X\":{\"allOf\":[]}}}", "empty conjunction");
        self.unsupported("{\"$defs\":{\"X\":{\"enum\":[\"a\",\"\\u0061\"]}}}", "decoded duplicate enum values");
        self.custom("{\"type\":\"string\",\"minLength\":2}", "\"é\"", false, "minLength counts codepoints not bytes");
        self.custom("{\"type\":\"string\",\"minLength\":2}", "\"\\u00e9\"", false, "escaped BMP counts one codepoint");
        self.custom("{\"type\":\"string\",\"minLength\":2}", "\"\\ud83d\\ude00\"", false, "surrogate pair counts one codepoint");
        self.custom("{\"type\":\"string\",\"minLength\":1}", "\"\\ud83d\\ude00\"", true, "surrogate pair accepted");
        self.custom("{\"const\":\"😀\"}", "\"\\ud83d\\ude00\"", true, "escaped astral constant matches literal Unicode");
        self.custom("{\"type\":\"string\"}", "\"\\ud83d\"", false, "unpaired high surrogate");
        self.custom("{\"type\":\"string\"}", "\"\\ude00\"", false, "unpaired low surrogate");
        self.custom("{\"type\":\"string\"}", "\"\\u0000\"", false, "NUL fails closed");
        self.custom("{\"type\":\"integer\"}", "01", false, "leading zero token");
        self.custom("{\"type\":\"array\"}", "[1,]", false, "dangling array comma");
        self.custom("{\"type\":\"object\"}", "{\"x\":true,}", false, "dangling object comma");
        self.custom("{\"type\":\"integer\",\"minimum\":-2,\"maximum\":-1}", "-2", true, "negative bounds inclusive");
        self.custom("{\"type\":\"integer\",\"minimum\":-2,\"maximum\":-1}", "-3", false, "negative comparison reverses magnitude");
        self.custom("{\"type\":\"integer\",\"minimum\":0}", "-0", true, "negative zero equals zero");
        let validator = wire_contract::Validator { root: self.root };
        let escaped_reference = "{\"$defs\":{\"Case\":{\"$ref\":\"#/$defs/\\u0058\"},\"X\":{\"const\":false}}}";
        std::test::assert(!validator.validate_schema(escaped_reference, "Case", "true").ok, "escaped reference resolves the same definition during profile and evaluation");
        self.custom("{\"if\":{\"properties\":{\"hidden\":{\"const\":true}}},\"then\":{\"properties\":{\"text\":{\"const\":\"\"}}}}", "{\"text\":\"leak\"}", false, "conditional properties only tests present properties");
        self.custom("{\"if\":{\"properties\":{\"hidden\":{\"const\":true}}},\"then\":{\"properties\":{\"text\":{\"const\":\"\"}}}}", "{\"hidden\":false,\"text\":\"visible\"}", true, "false condition skips consequent");
        let bytes = std::bytes::BytesBuilder { };
        bytes.append_u8(34); bytes.append_u8(255); bytes.append_u8(34);
        self.custom("{\"type\":\"string\"}", std::str::from_bytes(bytes.snapshot()), false, "invalid UTF-8");
    }
    fn knowledge_cases() {
        self.expect("KnowledgeInt64", "\"-9223372036854775808\"", true, "minimum signed native revision");
        self.expect("KnowledgeInt64", "\"9223372036854775807\"", true, "maximum signed native revision");
        self.expect("KnowledgeInt64", "\"9007199254740993\"", true, "preserve revision beyond JavaScript precision");
        self.expect("KnowledgeInt64", "\"9223372036854775808\"", false, "positive Int64 overflow");
        self.expect("KnowledgeInt64", "\"-9223372036854775809\"", false, "negative Int64 overflow");
        self.expect("KnowledgeInt64", "\"-0\"", false, "canonical negative zero rejected");
        self.expect("KnowledgeInt64", "\"01\"", false, "canonical leading zero rejected");
        self.expect("KnowledgeInt64", "1", false, "native revision remains a JSON string");
        self.expect("KnowledgeCounter", "\"-1\"", false, "basis counters are unsigned");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":\"string\",\"format\":\"date-time\"}}}", "unknown format cannot silently become annotation");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":\"integer\",\"format\":\"int64-decimal\"}}}", "decimal format requires string type");
        let value = self.example("knowledge-nodes");
        let data = std::json::find_field_raw(value, "data");
        let page = std::json::find_field_raw(data, "page");
        self.expect("KnowledgePage", self.field(page, "next_cursor", "\"unexpected\""), false, "complete page has null cursor");
        self.expect("KnowledgePage", self.field(page, "has_more", "true"), false, "continuation requires cursor");
        self.expect("KnowledgePage", self.field(page, "offset", "0"), false, "graph pages have no offset");
        self.expect("KnowledgePage", self.field(page, "total", "1"), false, "graph pages have no total");
        let basis = std::json::find_field_raw(data, "basis");
        self.expect("KnowledgeBasis", self.field(basis, "routing_version", "\"1\""), false, "adopted Ledger requires both captured fields");
        self.expect("KnowledgeBasis", self.field(basis, "visibility_ledger_head", "\"unpaired\""), false, "Record-only view has no Ledger claim");
    }
    // The head's four paths and seven definitions (GH #965): the envelope
    // is not a Record envelope, the request's arguments are closed (a
    // secret request can never carry a value), the state set is fixed,
    // and the OpenAPI describes the command headers, the count and the
    // read-only recovery.
    fn head_cases() {
        self.expect("HeadResponse", self.example("head-detached"), true, "detached head state");
        self.expect("HeadResponse", self.example("head-attached"), true, "attached head state");
        let detached = self.example("head-detached");
        self.expect("HeadResponse", self.field(detached, "source", "{\"record_id\":\"x\",\"record_head\":\"y\",\"record_revision\":\"1\"}"), false, "a head envelope is not a Record envelope");
        let identity = std::json::find_field_raw(detached, "head");
        self.expect("HeadResponse", self.field(detached, "head", self.field(identity, "profile", "\"dna.head.v2\"")), false, "the head profile is fixed");
        self.expect("HeadResponse", self.field(detached, "head", self.field(identity, "principal", "{\"mode\":\"position\",\"name\":\"riley\"}")), false, "the head principal is an authenticated mode");
        let state = std::json::find_field_raw(detached, "data");
        self.expect("HeadState", self.field(state, "state", "\"attaching\""), false, "unknown head state");
        self.expect("HeadState", self.field(state, "operations", "[]"), false, "every operation is listed");
        self.expect("HeadProjectsResponse", self.example("head-projects-list"), true, "registry list");
        self.expect("HeadProjectsResponse", self.example("head-project-detail"), true, "registry detail with projections");
        let request = self.example("head-secret-by-source-request");
        self.expect("HeadCommandRequest", request, true, "a secret names its source");
        let arguments = std::json::find_field_raw(request, "arguments");
        self.expect("HeadCommandRequest", self.field(request, "arguments", self.field(arguments, "value", "\"sk-never\"")), false, "a secret request never carries a value");
        self.expect("HeadCommandRequest", self.field(request, "arguments", self.field(arguments, "source", "{\"kind\":\"stdin\",\"name\":\"X\"}")), false, "a source is a file or an env name");
        self.expect("HeadCommandRequest", self.field(request, "operation_version", "1"), false, "operation version remains a string");
        self.expect("HeadCommandRequest", self.field(request, "operation", "\"dna.project.delete\""), false, "unknown head operation");
        self.expect("HeadCommandRequest", self.field(request, "request_id", "\"\""), false, "request identity cannot be empty");
        self.expect("HeadCommandRequest", self.field(request, "actor", "\"caller-selected\""), false, "injected actor");
        let context = std::json::find_field_raw(request, "context");
        self.expect("HeadCommandRequest", self.field(request, "context", self.field(context, "head", "\"remote\"")), false, "the head context is local");
        let receipt = self.example("head-command-succeeded");
        let data = std::json::find_field_raw(receipt, "data");
        self.expect("HeadCommandResponse", receipt, true, "succeeded receipt with record evidence");
        self.expect("HeadCommandResponse", self.field(receipt, "data", self.field(data, "state", "\"published\"")), false, "publication is not a receipt state");
        self.expect("HeadCommandResponse", self.field(receipt, "data", self.field(data, "run", "")), false, "a receipt always says how it ran, or null");
        self.expect("HeadCommandResponse", self.field(receipt, "data", self.field(data, "run", "null")), true, "an inline receipt has no run");
        self.expect("HeadCommandResponse", self.example("head-command-outcome-unknown"), true, "an external deadline is outcome_unknown");
        self.expect("HeadCommandResponse", self.example("head-command-refused"), true, "a refusal is a receipt");
        self.expect("HeadLogResponse", self.example("head-log-page"), true, "a log page");
        let page = std::json::find_field_raw(self.example("head-log-page"), "data");
        self.expect("HeadLogPage", self.field(page, "offset", "-1"), false, "offsets are non-negative");
        // OpenAPI: the head command path mirrors the Record command path.
        let files = wire_contract::ContractFiles { root: self.root };
        let spec = std::io::fs::read_file(self.root + "/openapi.json") or raise;
        let paths = std::json::find_field_raw(spec, "paths");
        let head_path = "/api/hale/v1/head/commands";
        let command = std::json::find_field_raw(paths, head_path);
        let post = std::json::find_field_raw(command, "post");
        let get = std::json::find_field_raw(command, "get");
        std::test::assert(files.openapi(spec, self.schema).ok, files.openapi(spec, self.schema).error);
        let no_origin = self.field(command, "post", self.field(post, "parameters", "[{\"name\":\"X-Hale-Command\",\"in\":\"header\",\"required\":true,\"schema\":{\"type\":\"string\",\"const\":\"1\"}}]"));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, head_path, no_origin)), self.schema).ok, "head command submission requires Origin");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, "/api/hale/v1/head/logs", "")), self.schema).ok, "the head path count is pinned");
        let events_path = "/api/hale/v1/head/events";
        let events = std::json::find_field_raw(paths, events_path);
        let events_get = std::json::find_field_raw(events, "get");
        let as_json = self.field(events_get, "responses", "{\"200\":{\"description\":\"x\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"./schema.json#/$defs/HeadResponse\"}}}}}");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, events_path, self.field(events, "get", as_json))), self.schema).ok, "the head's event stream is not a JSON read");
        let with_query = self.field(events_get, "parameters", "[{\"name\":\"since\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"string\"}}]");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, events_path, self.field(events, "get", with_query))), self.schema).ok, "the head's event stream takes no query");
        let body = std::json::find_field_raw(post, "requestBody");
        let get_body = self.field(command, "get", self.field(get, "requestBody", body));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, head_path, get_body)), self.schema).ok, "head recovery is a read without a command body");
        let wrong_body = self.field(body, "content", "{\"application/json\":{\"schema\":{\"$ref\":\"./schema.json#/$defs/DefinitionDraftRequest\"}}}");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, head_path, self.field(command, "post", self.field(post, "requestBody", wrong_body)))), self.schema).ok, "the head request is its own envelope");
        let projects_path = "/api/hale/v1/head/projects";
        let projects = std::json::find_field_raw(paths, projects_path);
        let projects_get = std::json::find_field_raw(projects, "get");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, projects_path, self.field(projects, "get", self.field(projects_get, "parameters", "[]")))), self.schema).ok, "the projects read declares its optional id");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, projects_path, self.field(projects, "post", post))), self.schema).ok, "head reads take no submission");
        // The closed arguments are what keeps a value off the wire: opened,
        // the fixture batch loses its negative and is refused.
        let defs = std::json::find_field_raw(self.schema, "$defs");
        let request_def = std::json::find_field_raw(defs, "HeadCommandRequest");
        let properties = std::json::find_field_raw(request_def, "properties");
        let arguments_def = std::json::find_field_raw(defs, "HeadCommandArguments");
        let open_arguments = self.field(self.schema, "$defs", self.field(defs, "HeadCommandArguments", self.field(arguments_def, "additionalProperties", "")));
        let opened = files.fixtures(self.fixtures, open_arguments);
        std::test::assert(!opened.ok && std::str::contains(opened.error, "head-secret-request-with-value"), "open arguments admit a value: " + opened.error);
        std::test::assert(len(properties) > 0 && len(request_def) > 0, "the head request definition is present");
    }
    fn file_cases() {
        let files = wire_contract::ContractFiles { root: self.root };
        let result = files.check();
        std::test::assert(result.ok, result.error);
        let spec = std::io::fs::read_file(self.root + "/openapi.json") or raise;
        let paths = std::json::find_field_raw(spec, "paths");
        let route = std::json::find_field_raw(paths, "/api/hale/v1/applications");
        let mutated = self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications", self.field(route, "post", "{}")));
        std::test::assert(!files.openapi(mutated, self.schema).ok, "OpenAPI mutation route rejected");
        let operation = std::json::find_field_raw(route, "get");
        let responses = std::json::find_field_raw(operation, "responses");
        let bad_responses = self.field(responses, "200", "{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"./schema.json#/$defs/Missing\"}}}}");
        let bad_route = self.field(route, "get", self.field(operation, "responses", bad_responses));
        let broken = self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications", bad_route));
        std::test::assert(!files.openapi(broken, self.schema).ok, "OpenAPI broken response link rejected");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications", "")), self.schema).ok, "missing route rejected");
        std::test::assert(!files.fixtures("[]", self.schema).ok, "empty fixture coverage rejected");
        let unsupported_schema = self.field(self.schema, "format", "\"unsupported\"");
        let unsupported_fixtures = files.fixtures(self.fixtures, unsupported_schema);
        std::test::assert(!unsupported_fixtures.ok && std::str::contains(unsupported_fixtures.error, "format"), "fixture batch rejects unsupported schema before evaluating examples");
        let gone = self.field(paths, "/api/hale/v1/applications/{application_id}/commands", std::json::find_field_raw(paths, "/api/hale/v1/head/commands"));
        std::test::assert(!files.openapi(self.field(spec, "paths", gone), self.schema).ok, "the record's commands are the api binding, not an HTTP route");
        // Every command-route rule, on the one command route this contract
        // keeps: the head's own.
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications/{application_id}/dna/knowledge/commands", std::json::find_field_raw(paths, "/api/hale/v1/head/commands"))), self.schema).ok, "Knowledge commands are the api binding, not an HTTP route");
        let command_path = "/api/hale/v1/head/commands";
        let command = std::json::find_field_raw(paths, command_path);
        let post = std::json::find_field_raw(command, "post");
        let get = std::json::find_field_raw(command, "get");
        let post_responses = std::json::find_field_raw(post, "responses");
        let no_accepted = self.field(command, "post", self.field(post, "responses", self.field(post_responses, "202", "")));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, command_path, no_accepted)), self.schema).ok, "command submission must describe its recorded receipt");
        let body = std::json::find_field_raw(post, "requestBody");
        let wrong_body = self.field(body, "content", "{\"application/json\":{\"schema\":{\"$ref\":\"./schema.json#/$defs/HeadCommandResponse\"}}}");
        let wrong_post = self.field(command, "post", self.field(post, "requestBody", wrong_body));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, command_path, wrong_post)), self.schema).ok, "command request reference cannot be a receipt");
        let optional_body = self.field(command, "post", self.field(post, "requestBody", self.field(body, "required", "false")));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, command_path, optional_body)), self.schema).ok, "command envelope is required");
        let no_headers = self.field(command, "post", self.field(post, "parameters", "[]"));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, command_path, no_headers)), self.schema).ok, "command headers must be advertised");
        let no_lookup = self.field(command, "get", self.field(get, "parameters", "[]"));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, command_path, no_lookup)), self.schema).ok, "recovery requires caller request identity");
        let unexpected_put = self.field(command, "put", post);
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, command_path, unexpected_put)), self.schema).ok, "other command mutation methods remain unsupported");
        let draft_path = "/api/hale/v1/applications/{application_id}/dna/definitions/draft";
        let draft = std::json::find_field_raw(paths, draft_path);
        let draft_post = std::json::find_field_raw(draft, "post");
        let draft_get = self.field(draft, "get", draft_post);
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, draft_path, draft_get)), self.schema).ok, "draft has no lookup or GET surface");
        let draft_no_headers = self.field(draft, "post", self.field(draft_post, "parameters", "[]"));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, draft_path, draft_no_headers)), self.schema).ok, "draft transport framing must be explicit");
        let draft_wrong_body = self.field(draft, "post", self.field(draft_post, "requestBody", body));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, draft_path, draft_wrong_body)), self.schema).ok, "draft preparation is not a command envelope");
        let missing = wire_contract::Validator { root: self.root + "/does-not-exist" };
        std::test::assert(!missing.validate("ErrorResponse", "{}").ok, "missing schema is a hard failure");
    }
}

fn main() {
    let root = if std::env::var_exists("HALE_API_CONTRACT_ROOT") { std::env::var("HALE_API_CONTRACT_ROOT") } else { "dna/api/contract/v1" };
    let suite = Cases { root: root, schema: std::io::fs::read_file(root + "/schema.json") or raise, fixtures: std::io::fs::read_file(root + "/fixtures.json") or raise, validator: wire_contract::Validator { root: root } };
    suite.file_cases();
    suite.wire_cases();
    suite.definition_cases();
    suite.profile_cases();
    suite.knowledge_cases();
    suite.capabilities_cases();
    suite.head_cases();
}
