// tests/hale/api_decimal_field_test.hl — a `Decimal<S>` crosses the api
// codec (spec/api.md § Codecs, spec/types.md § Decimal<S>): a field, a
// list's element and a whole value, as a JSON number read at the field's
// scale with every digit kept, written back as its digits; a number with a
// nonzero digit past the scale is the field's `wrong_type`, never a
// truncation. A JSON string holding a number is read the same way
// (`api_decimal_string_test.hl`); a string holding anything else is no
// number. Downstream handoff: a request with a `price: Decimal<2>` field
// was refused by law 5 ("which the JSON codec does not carry").

type Line { sku: String; px: Decimal<2>; }
type Order {
    total: Decimal<2>;
    rate: Decimal<18> = 0.000000000000000001d;
    lines: bounded[Line; 2];
}

fn refused(text: String, field: String, what: String) {
    let got = Order::api_decode(text) or {
        std::test::assert_eq_str(err.kind, "wrong_type", what + ": the kind");
        std::test::assert_eq_str(err.field, field, what + ": the field");
        return;
    };
    std::test::assert(false, what + ": decoded " + Order::api_encode(got));
}

fn main() {
    let o = Order::api_decode(
        "{\"total\":12.34,\"lines\":[{\"sku\":\"a\",\"px\":0.5},{\"sku\":\"b\",\"px\":-2}]}",
    ) or raise;
    std::test::assert(o.total == 12.34d, "a field at its scale");
    std::test::assert(o.rate == 0.000000000000000001d, "a default at scale 18");
    std::test::assert_eq_int(count(o.lines), 2, "a list of records with a Decimal");
    let first = at(o.lines, 0) or raise;
    std::test::assert(first.px == 0.5d, "an element's field");
    std::test::assert_eq_str(
        Order::api_encode(o),
        "{\"total\":12.34,\"rate\":0.000000000000000001,\"lines\":[{\"sku\":\"a\",\"px\":0.5},{\"sku\":\"b\",\"px\":-2}]}",
        "written as its digits",
    );
    let back = Order::api_decode(Order::api_encode(o)) or raise;
    std::test::assert(back.total == o.total && back.rate == o.rate, "round trip");

    // zeros past the scale are the same number; a nonzero digit is not
    let z = Order::api_decode("{\"total\":12.3400}") or raise;
    std::test::assert(z.total == 12.34d, "trailing zeros past the scale");
    refused("{\"total\":12.345}", "total", "a third place is no Decimal<2>");
    // a mantissa no i128 holds is the field's wrong_type, never a wrong
    // number (downstream handoff: it decoded to a negative value)
    refused(
        "{\"total\":12345678901234567890123456789012345678.5}",
        "total",
        "a number past i128 at scale 2",
    );
    refused(
        "{\"total\":1,\"lines\":[{\"sku\":\"a\",\"px\":99999999999999999999999999999999999999}]}",
        "px",
        "an element past i128, named by its own field",
    );
    refused("{\"total\":\"twelve\"}", "total", "a string holding no number is no number");
    refused("{\"total\":true}", "total", "a bool is no number");
    refused(
        "{\"total\":1,\"lines\":[{\"sku\":\"a\",\"px\":0.001}]}",
        "px",
        "an element past its scale, named by its own field",
    );

    // a JSON number of any spelling, read exactly at the scale: an exponent
    // is applied (downstream handoff: a JavaScript client writes a small
    // number as `1e-7`, and the codec refused every exponent)
    let e = Order::api_decode(
        "{\"total\":1.50E+1,\"rate\":1e-7,\"lines\":[{\"sku\":\"a\",\"px\":125e-2}]}",
    ) or raise;
    std::test::assert(e.total == 15d, "a positive exponent with a fraction");
    std::test::assert(e.rate == 0.0000001d, "a negative exponent at scale 18");
    let el = at(e.lines, 0) or raise;
    std::test::assert(el.px == 1.25d, "an element's exponent");
    let big = Order::api_decode("{\"total\":1e2}") or raise;
    std::test::assert(big.total == 100d, "a bare exponent");
    refused("{\"total\":1e-3}", "total", "an exponent landing past the scale");
    // a spelling that is no JSON number is refused, though the Decimal
    // literal would read some of them
    refused("{\"total\":+1}", "total", "a leading plus");
    refused("{\"total\":.5}", "total", "a leading dot");
    refused("{\"total\":1.}", "total", "a trailing dot");
    refused("{\"total\":01}", "total", "a leading zero");
    refused("{\"total\":1e}", "total", "an exponent with no digits");
    refused(
        "{\"total\":1,\"lines\":[{\"sku\":\"a\",\"px\":01}]}",
        "lines",
        "an element's leading zero makes the element no JSON, refused by the list",
    );
}
