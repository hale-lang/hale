// dna/api/project_service/main.hl — the head's entrypoint
// (GH #965, §2.1 of the head's contract). One process the browser
// talks to: it serves the shell, owns the project registry and the
// receipt journal under a state directory, and proxies the Record
// routes to a per-project API child. Every verb it runs is the CLI
// verb, detached; children outlive the head by design and are
// re-adopted by the next one over the same state directory.
//
//   project_service <port 1..65535> <webroot> <api-binary> [<api-port> = 8793] [<project-root>]
//
// Build: hale build dna/api/project_service
// Run:   HALE_BIN=/abs/hale ./dna/api/project_service/project_service 8792 dna/face/web dna/api/practice_review/practice_review
import ".." as api;
import "../../core" as dna;
import "../../operations" as ops;

const USAGE: String = "hale dna head: expected <port 1..65535> <webroot> <api-binary> [<api-port> = 8793] [<project-root>], with HALE_BIN naming the compiler by an absolute path";

fn path_ok(p: String) -> Bool {
    return len(p) > 0 && !std::str::contains(p, "\n") && !std::str::contains(p, "\r");
}

// `STATE = ${HALE_DNA_HEAD_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/hale/dna/head}`
fn state_dir_of() -> String {
    let chosen = std::env::var("HALE_DNA_HEAD_STATE");
    if len(chosen) > 0 { return chosen; }
    let xdg = std::env::var("XDG_STATE_HOME");
    let base = if len(xdg) > 0 { xdg } else { std::env::var("HOME") + "/.local/state" };
    return base + "/hale/dna/head";
}

// `SOURCES = ${XDG_CONFIG_HOME:-$HOME/.config}/hale-dna/sources`
fn sources_dir_of() -> String {
    let xdg = std::env::var("XDG_CONFIG_HOME");
    let base = if len(xdg) > 0 { xdg } else { std::env::var("HOME") + "/.config" };
    return base + "/hale-dna/sources";
}

// A private directory (`umask 077 && mkdir -p`), created when absent.
fn private_dir(path: String) -> Bool {
    return dna::run_tool("sh\n-c\numask 077 && mkdir -p \"$1\"\nsh\n" + path).code == 0;
}

// The pid in `head.pid` when it is alive and not this process, else -1.
fn other_head(state_dir: String) -> Int {
    let text = dna::trim_nl(std::io::fs::read_file(state_dir + "/head.pid") or "");
    if len(text) == 0 { return -1; }
    let pid = std::str::parse_int(text) or - 1;
    if pid <= 0 || pid == std::process::pid() { return -1; }
    if dna::run_tool("kill\n-0\n" + to_string(pid)).code != 0 { return -1; }
    return pid;
}

// An attach the head submits to itself: the browser's own request
// shape, under the head's principal.
fn attach_request(request_id: String, principal_name: String, root: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("request_id", request_id);
    b.string_field("operation", "dna.project.attach");
    b.string_field("operation_version", "1");
    b.begin_object_field("context"); b.string_field("head", "local"); b.string_field("application_id", ""); b.end_object();
    b.begin_object_field("target"); b.string_field("kind", "dna.head"); b.string_field("id", "local"); b.end_object();
    b.begin_object_field("preconditions"); b.begin_object_field("principal"); b.string_field("mode", "local"); b.string_field("name", principal_name); b.end_object(); b.end_object();
    b.begin_object_field("arguments"); b.string_field("root", root); b.end_object();
    b.end_object();
    return b.result();
}

// The startup work, as one locus's methods: re-adoption, the restore
// of the last activated project, the attach of an argv project, the
// first settle. A method's frame is reclaimed when it returns, so the
// values these steps build do not live in main's frame until the head
// exits — main only parses argv, loads the assets and serves.
locus Startup {
    params { cfg: HeadConfig = HeadConfig { }; }

    // Attaches `root` under `request_id` through the journal (recorded,
    // then admitted or refused, then the inline terminal line), the way a
    // browser's attach is. "" when attached, else the reason.
    fn attach(request_id: String, root: String) -> String {
        let j = HeadJournal { state_dir: self.cfg.state_dir };
        let s = j.submit(self.cfg.principal_mode, self.cfg.principal_name, attach_request(request_id, self.cfg.principal_name, root), own_arguments("dna.project.attach"), "");
        if len(s.code) > 0 { return s.code; }
        if s.replayed { return if s.receipt.state == "succeeded" { "" } else { s.receipt.reason_code + " " + s.receipt.reason }; }
        let id = s.receipt.command_id;
        let a = attach_project(self.cfg, root, id);
        if len(a.refused) > 0 {
            j.refuse(id, a.refused, a.reason);
            return a.refused + ": " + a.reason;
        }
        j.admit(id);
        j.running(id, "inline", -1, "", std::time::now() + 20, false);
        if !a.ok {
            j.finish(id, "failed", -1, "", a.reason, "{}");
            return "failed: " + a.reason;
        }
        j.finish(id, "succeeded", 0, "", "", a.outcome);
        return "";
    }

    // Re-adopts live children, re-attaches the last activated project
    // (a refusal is journaled and the head starts detached), attaches
    // `project_root` when given, settles. "" or what stops the head.
    fn prepare(project_root: String) -> String {
        let kept = readopt_children(self.cfg);
        if len(kept) > 0 { eprintln("hale dna head: re-adopted " + kept); }
        let reg = Registry { state_dir: self.cfg.state_dir };
        let restore = reg.restore();
        if restore.ok {
            let outcome = self.attach("restart-" + to_string(std::process::pid()), restore.root);
            if len(outcome) > 0 {
                eprintln("hale dna head: " + restore.name + " could not be re-attached (" + outcome + "); starting detached");
                let d = reg.deactivate(restore.application_id, "");
                stop_child(self.cfg, "api");
            }
        }
        if len(project_root) > 0 {
            let outcome = self.attach("startup-" + to_string(std::process::pid()), project_root);
            if len(outcome) > 0 { return "hale dna head: cannot attach " + project_root + ": " + outcome; }
        }
        settle_all(self.cfg);
        std::io::fs::write_file(self.cfg.state_dir + "/head.url", head_origin(self.cfg) + "\n") or discard;
        return "";
    }

    // The banner the server prints once it listens (§2.1).
    fn banner() -> String {
        let reg = Registry { state_dir: self.cfg.state_dir };
        let active = reg.active();
        let mut projects = 0;
        let mut rest = reg.ids();
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            projects = projects + 1;
        }
        return "hale dna head: " + head_origin(self.cfg) + "/ (trusted local; " + to_string(projects) + " project(s), active: " + (if active.ok { active.name } else { "none" }) + ")";
    }
}

// The F.3 rule: the loaded assets reach the server literal through a
// parameter, never from a `let` in the same scope. The banner is the
// server's ready signal, printed once the listener is bound.
fn serve(cfg: HeadConfig, web: api::WebAssets, banner: String) {
    std::http::Server { host: "127.0.0.1", port: cfg.port, ready_signal: banner, handler: Head { cfg: cfg, web: web } };
}

fn main() {
    let http = api::Http { };
    let count = std::env::args_count();
    let port = http.integer(std::env::arg_or(1, ""), 65535);
    let webroot = std::env::arg_or(2, "");
    let api_binary = std::env::arg_or(3, "");
    let api_port = if count > 4 { http.integer(std::env::arg_or(4, ""), 65535) } else { 8793 };
    let project_root = std::env::arg_or(5, "");
    let hale = std::env::var("HALE_BIN");
    let executable = dna::run_tool("test\n-x\n" + api_binary).code == 0 && dna::run_tool("test\n-f\n" + api_binary).code == 0;
    if count < 4 || count > 6 || port < 1 || api_port < 1 || !path_ok(webroot) || !path_ok(api_binary) || (count > 5 && !path_ok(project_root)) || !executable || !std::str::starts_with(hale, "/") {
        eprintln(USAGE);
        std::process::exit(2);
    }
    let web = api::WebAssets { };
    if !web.load(webroot) {
        eprintln("hale dna head: " + web.error + "; refusing to start");
        std::process::exit(2);
    }
    let state_dir = state_dir_of();
    if !path_ok(state_dir) || !private_dir(state_dir) || !private_dir(state_dir + "/runs") || !private_dir(state_dir + "/children") {
        eprintln("hale dna head: cannot create the state directory " + state_dir);
        std::process::exit(1);
    }
    let holder = other_head(state_dir);
    if holder > 0 {
        eprintln("hale dna head: already running at " + dna::trim_nl(std::io::fs::read_file(state_dir + "/head.url") or "") + " (pid " + to_string(holder) + ")");
        std::process::exit(2);
    }
    let user = std::env::var("USER");
    let cfg = HeadConfig { port: port, api_port: api_port, api_binary: api_binary, hale: hale, state_dir: state_dir, sources_dir: sources_dir_of(),
        principal_mode: "local", principal_name: if len(user) > 0 { user } else { "local" } };
    std::io::fs::write_file(state_dir + "/head.pid", to_string(std::process::pid()) + "\n") or discard;
    let boot = Startup { cfg: cfg };
    let fatal = boot.prepare(if count > 5 { project_root } else { "" });
    if len(fatal) > 0 {
        eprintln(fatal);
        std::process::exit(2);
    }
    serve(cfg, web, boot.banner());
}
