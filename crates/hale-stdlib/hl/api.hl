// std::api — the caller at an api binding (GH #1108).
//
// A `Principal` is who is calling, established at the binding and
// nowhere else: the mode says how (`local` for a publish inside the
// program, `unix` for a peer on the api socket, later `bearer` for
// an HTTP token), the name says who as that mode spells it (`local`,
// `uid:1000`), and the three credentials are what a Unix socket's
// kernel vouches for (-1 when the mode has none). The shape is the
// one DNA carried by hand as `principal_mode` / `principal_name`.
//
// A `Context` is what a handler that declares a second parameter
// receives: `fn on_x(p: T, ctx: std::api::Context)`. Through the api
// binding it names the caller, the request id, the binding (`via`)
// and, once roles exist, the role that authorized the message. A
// handler reached in-process receives `local_context()`: the local
// principal, `via: "local"`, request id 0. Both are ordinary
// structs: constructible in a test, forwardable in a payload;
// `via` is the provenance that tells a binding-produced one apart.

/// Who is calling, as the binding established it.
type __StdApiPrincipal {
    mode: String = "local";
    name: String = "local";
    uid: Int = -1;
    gid: Int = -1;
    pid: Int = -1;
    // GH #1109: the peer's supplementary groups as the kernel holds them
    // for the connection (SO_PEERGROUPS on Linux; empty elsewhere),
    // comma-separated. Not on the receipt.
    groups: String = "";
    // How the caller reached the binding when a transport of the
    // program's own forwarded it (`"http-session"`): the wire's `via`,
    // honoured only from the program's own uid; "" for the socket peer
    // itself. On the receipt when set; `Context.via` carries it.
    via: String = "";
}

/// A handler's view of the message that reached it.
type __StdApiContext {
    caller: std::api::Principal = std::api::Principal { };
    role: String = "";
    request_id: Int = 0;
    via: String = "local";
}

/// The context of a message that never crossed a binding.
fn __api_local_context() -> std::api::Context {
    return std::api::Context { };
}

// GH #1109: roles at the binding.
//
// A `RoleSource` is what the binding consults at its gate: does this
// principal hold this role, directly. The hierarchy (`role owner
// includes x;`) is the program's and the binding walks it, so a
// source answers only the direct question. `StaticRoles` is the
// stdlib's source: a table baked from `[environments.<env>.roles]`
// in hale.toml by `hale build --env <env>` and overridden at run
// time by `LOTUS_API_ROLES`, spelled `role=member,member;role=`.
// A member is `uid:<n>`, `gid:<n>` (the peer's primary group or one
// of the supplementary groups the kernel holds for the connection),
// `user:<name>` or `group:<name>` (resolved once, at birth, per the
// host's account database; an unknown name is reported and holds
// nobody) or `*` (any authenticated peer). A principal the binding
// could not authenticate (uid -1) holds no role whatever the table
// says.

/// A membership source: the binding asks, the deployment answers.
interface __StdApiRoleSource {
    fn holds(p: std::api::Principal, r: String) -> Bool;
}

/// The static table, from the environment's `roles` section. Its birth
/// refuses (and the process exits, saying why) a table that names a
/// role the program does not declare or a member outside the five
/// spellings — the rule `hale.toml` is held to, applied to
/// `LOTUS_API_ROLES` as well, since the table travels as one line.
locus __StdApiStaticRoles {
    params {
        table: String = "";
        known: String = ""; // the roles the program declares, space-separated
    }
    birth() {
        let mut from = "the baked [environments.<env>.roles]";
        if std::env::var_exists("LOTUS_API_ROLES") {
            self.table = std::env::var("LOTUS_API_ROLES");
            from = "LOTUS_API_ROLES";
        }
        let why = __api_table_refusal(self.table, self.known);
        if len(why) > 0 {
            eprintln("api roles: refusing to start: " + from + ": " + why);
            std::process::exit(2);
        }
        self.table = __api_resolve_role_names(self.table);
    }
    fn holds(p: std::api::Principal, r: String) -> Bool {
        if p.uid < 0 {
            return false;
        }
        let mut rest = self.table;
        while len(rest) > 0 {
            let semi = std::str::index_of(rest, ";");
            let mut seg = rest;
            if semi >= 0 {
                seg = rest[0..semi];
                rest = rest[(semi + 1)..len(rest)];
            } else {
                rest = "";
            }
            let eq = std::str::index_of(seg, "=");
            if eq > 0 && std::str::trim(seg[0..eq]) == r {
                if __api_role_members_match(p, seg[(eq + 1)..len(seg)]) {
                    return true;
                }
            }
        }
        return false;
    }
}

/// Whether every byte of `s` is a letter, a digit or one of `extra`.
@unbounded
fn __api_chars_ok(s: String, extra: String) -> Bool {
    let mut i = 0;
    while i < len(s) {
        let c = std::str::byte_at_unchecked(s, i);
        let alnum = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if !alnum && !std::str::contains(extra, s[i..(i + 1)]) {
            return false;
        }
        i = i + 1;
    }
    return len(s) > 0;
}

/// Why a table is refused ("" when it is not): a key must be a declared
/// role (an identifier), a member one of `uid:<n>`, `gid:<n>`,
/// `user:<name>`, `group:<name>` (an account name: letters, digits,
/// `.`, `_`, `-`, `@`, at most 64) or `*`.
@unbounded
fn __api_table_refusal(table: String, known: String) -> String {
    let mut rest = table;
    while len(rest) > 0 {
        let semi = std::str::index_of(rest, ";");
        let mut seg = rest;
        if semi >= 0 {
            seg = rest[0..semi];
            rest = rest[(semi + 1)..len(rest)];
        } else {
            rest = "";
        }
        if len(std::str::trim(seg)) == 0 {
            continue;
        }
        let eq = std::str::index_of(seg, "=");
        if eq <= 0 {
            return "`" + seg + "` is not `role=member,member`";
        }
        let role = std::str::trim(seg[0..eq]);
        if !__api_chars_ok(role, "_") || !std::str::contains(" " + known + " ", " " + role + " ") {
            return "`" + role + "` is not a role this program declares (declared: " + known + ")";
        }
        let mut mrest = seg[(eq + 1)..len(seg)];
        while len(mrest) > 0 {
            let comma = std::str::index_of(mrest, ",");
            let mut m = mrest;
            if comma >= 0 {
                m = mrest[0..comma];
                mrest = mrest[(comma + 1)..len(mrest)];
            } else {
                mrest = "";
            }
            m = std::str::trim(m);
            if len(m) == 0 || m == "*" {
                continue;
            }
            let mut ok = false;
            if std::str::starts_with(m, "uid:") || std::str::starts_with(m, "gid:") {
                ok = __api_chars_ok(m[4..len(m)], "") && (std::str::parse_int(m[4..len(m)]) or - 1) >= 0;
            }
            if std::str::starts_with(m, "user:") {
                ok = __api_chars_ok(m[5..len(m)], "._-@") && len(m) <= 69;
            }
            if std::str::starts_with(m, "group:") {
                ok = __api_chars_ok(m[6..len(m)], "._-@") && len(m) <= 70;
            }
            if !ok {
                return "role `" + role + "`: `" + m + "` is not a role member (uid:<n>, gid:<n>, user:<name>, group:<name> or *)";
            }
        }
    }
    return "";
}

/// One role's member list against a principal.
fn __api_role_members_match(p: std::api::Principal, members: String) -> Bool {
    let mut rest = members;
    while len(rest) > 0 {
        let comma = std::str::index_of(rest, ",");
        let mut m = rest;
        if comma >= 0 {
            m = rest[0..comma];
            rest = rest[(comma + 1)..len(rest)];
        } else {
            rest = "";
        }
        m = std::str::trim(m);
        if m == "*" {
            return true;
        }
        if std::str::starts_with(m, "uid:") {
            let n = std::str::parse_int(m[4..len(m)]) or - 1;
            if n >= 0 && n == p.uid {
                return true;
            }
        }
        if std::str::starts_with(m, "gid:") {
            let n = std::str::parse_int(m[4..len(m)]) or - 1;
            if n >= 0 && (n == p.gid || std::str::contains("," + p.groups + ",", "," + to_string(n) + ",")) {
                return true;
            }
        }
    }
    return false;
}

/// `user:<name>` and `group:<name>` become `uid:<n>` and `gid:<n>`
/// once, per the host's account database; a name it does not know is
/// reported and dropped, so it holds nobody rather than someone else.
fn __api_resolve_role_names(table: String) -> String {
    let mut out = "";
    let mut rest = table;
    while len(rest) > 0 {
        let semi = std::str::index_of(rest, ";");
        let mut seg = rest;
        if semi >= 0 {
            seg = rest[0..semi];
            rest = rest[(semi + 1)..len(rest)];
        } else {
            rest = "";
        }
        let eq = std::str::index_of(seg, "=");
        if eq <= 0 {
            continue;
        }
        let role = std::str::trim(seg[0..eq]);
        let mut members = "";
        let mut mrest = seg[(eq + 1)..len(seg)];
        while len(mrest) > 0 {
            let comma = std::str::index_of(mrest, ",");
            let mut m = mrest;
            if comma >= 0 {
                m = mrest[0..comma];
                mrest = mrest[(comma + 1)..len(mrest)];
            } else {
                mrest = "";
            }
            m = std::str::trim(m);
            let mut resolved = m;
            if std::str::starts_with(m, "user:") {
                let name = m[5..len(m)];
                let id = std::io::unix::user_id(name);
                if id < 0 {
                    eprintln("api roles: role " + role + " names user " + name + ", which this host does not know; it holds nobody");
                    resolved = "";
                } else {
                    resolved = "uid:" + to_string(id);
                }
            }
            if std::str::starts_with(m, "group:") {
                let name = m[6..len(m)];
                let id = std::io::unix::group_id(name);
                if id < 0 {
                    eprintln("api roles: role " + role + " names group " + name + ", which this host does not know; it holds nobody");
                    resolved = "";
                } else {
                    resolved = "gid:" + to_string(id);
                }
            }
            if len(resolved) > 0 {
                if len(members) > 0 {
                    members = members + ",";
                }
                members = members + resolved;
            }
        }
        if len(out) > 0 {
            out = out + ";";
        }
        out = out + role + "=" + members;
    }
    return out;
}
