// GH #617 (the review of #622) — the body lease fences startup, not only
// the first tick. A host takes the lease and then builds its organization;
// the build outlasts a takeover (here a head force-claims the lease while
// the build runs). The host must start nothing: it proves the lease again
// the moment before it starts a process, finds it is no longer its own,
// and exits 3 with no organization started.
//
// The host binary runs directly (as `hale dna run` would exec it) so its
// toolchain can be a wrapper whose `build` is slow.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`: discovery off, a cache of this
// fixture's own so the host binary is found in one place.
fn in_dir(dir: String, cache: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off XDG_CACHE_HOME=\"$1\" && shift && exec \"$@\"\nsh\n" + dir + "\n" + cache + "\n" + argv);
}

fn alive(pid: String) -> Bool {
    return len(pid) > 0 && dna::run_tool("kill\n-0\n" + pid).code == 0;
}

// An organization whose worker tool says it is alive every 200ms.
const WORKER_ORG: String = "fn main() {\n    let r = std::process::run(\"sh\\n-c\\necho $$ > worker.pid; while :; do date +%s >> worker.tick; sleep 0.2; done\") or std::process::ProcessOutput { code: -1, signal: 0, stdout: \"\", stderr: \"\" };\n}\n";

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

fn log_has(path: String, needle: String) -> Bool {
    return std::str::contains(std::io::fs::read_file(path) or "", needle);
}

main locus App {
    run() {
        let scratch = dna::scratch_root("leasestart");
        // whatever this fixture starts under its scratch stops when it does (#637)
        dna::reap_on_exit(scratch);
        let cache = scratch + "/cache";
        std::io::fs::mkdir(cache) or discard;
        let bare = scratch + "/origin.git";
        let b0 = in_dir(scratch, cache, "git\ninit\n-q\n--bare\n-b\nmain\n" + bare);
        let made = in_dir(scratch, cache, toolchain() + "\ndna\nnew\nbodied\n--profile\nremote-body\n--remote\n" + bare + "\n--body\nriley@srv");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let a = scratch + "/bodied";
        let g1 = in_dir(a, cache, "git\nconfig\nuser.name\norganism-host");
        let g2 = in_dir(a, cache, "git\nconfig\nuser.email\nhost@dna");
        let g3 = in_dir(a, cache, "git\nadd\n-A");
        let g4 = in_dir(a, cache, "git\ncommit\n-q\n-m\nthe app");
        let g5 = in_dir(a, cache, "git\npush\n-q\norigin\nmain\nrefs/dna/*:refs/dna/*");
        std::test::assert_eq_int(g5.code, 0, "pushed: " + g5.stderr);
        // a head elsewhere, with the record
        let head = scratch + "/head";
        let c1 = in_dir(scratch, cache, "git\nclone\n-q\n-b\nmain\n" + bare + "\n" + head);
        let c2 = in_dir(head, cache, "git\nconfig\nuser.name\nriley");
        let c3 = in_dir(head, cache, "git\nconfig\nuser.email\nriley@l");
        let c4 = in_dir(head, cache, toolchain() + "\ndna\nupgrade\n.");
        let c5 = in_dir(head, cache, toolchain() + "\ndna\nsync");
        std::test::assert(std::str::contains(c5.stdout, "pulled the record"), "the head has the record: " + c5.stdout + c5.stderr);

        // the host binary, built into this fixture's cache
        let built = in_dir(a, cache, toolchain() + "\ndna\nprofile\n.");
        let host = dna::trim_nl(in_dir(scratch, cache, "sh\n-c\nfind \"$1\" -path '*/dna/host/host' -type f | head -1\nsh\n" + cache).stdout);
        std::test::assert(len(host) > 0, "the host is built: " + built.stdout + built.stderr);
        // the first line alone is the version: `hale --version` has a
        // second one since GH #726 (the embedded DNA digest)
        let version = dna::trim_nl(in_dir(scratch, cache, "sh\n-c\n\"$1\" --version | head -1\nsh\n" + toolchain()).stdout);

        // a toolchain whose build takes twenty seconds
        let slow = scratch + "/slowhale";
        std::io::fs::write_file(slow, "#!/bin/sh\nif [ \"$1\" = build ]; then sleep 20; fi\nexec \"" + toolchain() + "\" \"$@\"\n") or discard;
        let x = dna::run_tool("chmod\n+x\n" + slow);

        // host A takes the lease and builds
        let started = in_dir(a, cache, "sh\n-c\nHALE_BIN=\"$1\" HALE_DNA_TOOLCHAIN=\"$2\" HALE_DNA_GENOME=\"$3\" nohup sh -c 'timeout 240 \"$0\" run \"$1\" . \"\" \"\" --no-iris; echo $? > a.exit' \"$4\" \"$3\" >a.log 2>&1 </dev/null & echo $!\nsh\n" + slow + "\n" + version + "\n" + a + "\n" + host);
        let mut taken = false;
        let mut tries = 0;
        while !taken && tries < 120 {
            if log_has(a + "/a.log", "body lease taken") { taken = true; } else { std::time::sleep(250ms); }
            tries = tries + 1;
        }
        std::test::assert(taken, "host A took the lease: " + (std::io::fs::read_file(a + "/a.log") or ""));

        // while A builds, the head takes the lease over
        let claimed = in_dir(head, cache, toolchain() + "\ndna\nbody\nclaim\n--force\n--as\nriley");
        std::test::assert(std::str::contains(claimed.stdout, "was taken by riley"), "the head took the lease: " + claimed.stdout + claimed.stderr);

        // A finishes its build and starts nothing
        let mut ended = false;
        tries = 0;
        while !ended && tries < 240 {
            if std::io::fs::file_exists(a + "/a.exit") { ended = true; } else { std::time::sleep(500ms); }
            tries = tries + 1;
        }
        let log = std::io::fs::read_file(a + "/a.log") or "";
        std::test::assert(ended, "host A ended: " + log);
        std::test::assert_eq_str(dna::trim_nl(std::io::fs::read_file(a + "/a.exit") or ""), "3", "host A exited 3: " + log);
        std::test::assert(std::str::contains(log, "before starting the organization: the body lease is no longer mine") && !std::str::contains(log, "organization (pid"), "no organization was started under a lease that was not A's: " + log);
        std::test::assert(!std::io::fs::file_exists(a + "/.hale/dna/org.pid"), "no organization process");

        // ---- every exit takes what the body started (the fifth review of
        // #622): under `dev` the organization starts and its tool runs, then
        // the host stops before the application starts — here because the
        // lease is taken over while it waits for this organization, which
        // never reads the nerves, to read its facts from them (GH #986; GH
        // #1026: the genome is checked and built whole before anything
        // starts, so a build that fails stops the host earlier, with nothing
        // to take). The tool must not outlive the host. Without nerves the
        // host has nothing to wait for, so this half needs a NATS server.
        let nats_owner = if std::env::var_exists("HALE_DNA_NATS_URL_OWNER") { std::env::var("HALE_DNA_NATS_URL_OWNER") } else { "" };
        if len(nats_owner) == 0 {
            eprintln("body_lease_start_test: the `dev` half was not exercised (HALE_DNA_NATS_URL_OWNER is not set)");
            dna::scratch_done(scratch);
            return;
        }
        let nerves = in_dir(a, cache, "sh\n-c\nHALE_DNA_NATS_URL_OWNER=\"$2\" exec \"$1\" dna nerves migrate\nsh\n" + toolchain() + "\n" + nats_owner);
        let nats_spine = line_value(nerves.stdout, "HALE_DNA_NATS_URL_SPINE");
        let nats_org = line_value(nerves.stdout, "HALE_DNA_NATS_ORG");
        std::test::assert(nerves.code == 0 && len(nats_spine) > 0 && len(nats_org) > 0, "the nerves' stream is in place: " + nerves.stdout + nerves.stderr);
        std::io::fs::write_file(a + "/dna/org/main.hl", WORKER_ORG) or discard;
        let gc = in_dir(a, cache, "sh\n-c\ngit add -A && git commit -q -m 'an organization with a worker tool' && git push -q origin main");
        std::test::assert_eq_int(gc.code, 0, "the worker organization is the genome: " + gc.stderr);
        let dev = in_dir(a, cache, "sh\n-c\nHALE_BIN=\"$1\" HALE_DNA_TOOLCHAIN=\"$2\" HALE_DNA_GENOME=\"$3\" HALE_DNA_NATS_URL_SPINE=\"$5\" HALE_DNA_NATS_ORG=\"$6\" nohup sh -c 'timeout 240 \"$0\" dev \"$1\" . \"\" \"\" --no-iris; echo $? > b.exit' \"$4\" \"$3\" >b.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + version + "\n" + a + "\n" + host + "\n" + nats_spine + "\n" + nats_org);
        let mut org_up = false;
        tries = 0;
        while !org_up && tries < 360 {
            if log_has(a + "/b.log", "organization (pid") && std::io::fs::file_exists(a + "/worker.pid") { org_up = true; } else { std::time::sleep(500ms); }
            tries = tries + 1;
        }
        std::test::assert(org_up, "the organization started and its tool ran: " + (std::io::fs::read_file(a + "/b.log") or ""));
        let retaken = in_dir(head, cache, toolchain() + "\ndna\nbody\nclaim\n--force\n--as\nriley");
        std::test::assert(std::str::contains(retaken.stdout, "was taken by riley"), "the head takes the lease while the host waits: " + retaken.stdout + retaken.stderr);
        let mut dev_ended = false;
        tries = 0;
        while !dev_ended && tries < 360 {
            if std::io::fs::file_exists(a + "/b.exit") { dev_ended = true; } else { std::time::sleep(500ms); }
            tries = tries + 1;
        }
        let dev_log = std::io::fs::read_file(a + "/b.log") or "";
        std::test::assert(dev_ended && dna::trim_nl(std::io::fs::read_file(a + "/b.exit") or "") != "0" && !std::str::contains(dev_log, "expression bodied (pid"), "the host stopped before the application started: " + dev_log);
        let worker = dna::trim_nl(std::io::fs::read_file(a + "/worker.pid") or "");
        std::test::assert(len(worker) > 0, "the organization's tool ran: " + dev_log);
        let tick = dna::trim_nl(dna::run_tool("tail\n-n\n1\n" + a + "/worker.tick").stdout);
        std::time::sleep(1500ms);
        let later = dna::trim_nl(dna::run_tool("tail\n-n\n1\n" + a + "/worker.tick").stdout);
        std::test::assert(!alive(worker) && tick == later, "the tool did not outlive the host: alive " + (if alive(worker) { "yes" } else { "no" }) + ", ticks " + tick + " then " + later);
        if alive(worker) { let k = dna::run_tool("kill\n-KILL\n" + worker); }

        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
