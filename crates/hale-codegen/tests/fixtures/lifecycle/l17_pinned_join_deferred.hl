// Decision line 17, the pinned join set and order (PinnedJoin,
// TeardownDelivery), deferred half. Pending, as
// `l17_pinned_join_eager.hl`.
//
// The same tree as the eager half, with App subscribing to a topic of
// its own, which defers its teardown to fn main's frame flush. The
// flush joins subscription-less pinned entries first and leaves a
// pinned subscriber in its slot. But a locus's own pinned entries are
// moved after its frame entry, so the reverse flush joins `sink`
// before App's cascade reaches `src`, and the final publish is lost
// here too. The inventory's "under C16 it is delivered" (§ The five
// teardown spines, 2) does not hold for a main locus's own fields;
// line 17's condition has to account for it.
//
// Expected terminal outcome today: `final-dropped`.

type Fin { n: Int; }
topic Finals { payload: Fin; subject: "lifecycle.l17.deferred"; }
type Tick { n: Int; }
topic Ticks { payload: Tick; subject: "lifecycle.l17.ticks"; }

locus Sink {
    bus { subscribe Finals as on_final; }
    fn on_final(f: Fin) { println("ev sink-heard-final"); }
}

locus Src {
    bus { publish Finals; }
    dissolve() { Finals <- Fin { n: 1 }; }
}

main locus App {
    params {
        sink: Sink = Sink { };
        src: Src = Src { };
    }
    placement { sink: pinned; }
    bus { subscribe Ticks as on_tick; }
    fn on_tick(t: Tick) { }
    run() { std::time::sleep(20ms); }
}

fn main() { App { }; }
