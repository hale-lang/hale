// tests/hale/u64_storage_test.hl — `U64` (GH #2121) where a value is
// stored: a record field, a locus param written from a method, a
// `bounded[U64; N]` buffer, a fixed array (inline), an enum payload, a
// hashmap cell, a generic record's field, a fn's parameter and return,
// and a bus payload (its 8 bytes, a field and a buffer). Each at the top
// of the range, past `Int`'s max, so a value read back as signed, or a
// field copied as the wrong width, shows.

const MAX: String = "18446744073709551615";
const BIG = 18446744073709551615;
const SMALL: U64 = 7;

type Counter {
    hits: U64;
    misses: U64;
    name: String;
}

type Amount = enum { Nothing, Exact(U64), Pair(Int, U64) };
type Bag { items: bounded[U64; 4]; }
type Words { w: [U64; 3]; }
type Box<T> { value: T; }
type Cell { key: String = ""; seen: U64 = 0; }

@form(hashmap)
locus Seen {
    capacity { pool rows of Cell indexed_by key; }
}

locus Holder {
    params { total: U64 = 0; }
    fn add(x: U64) {
        self.total = self.total + x;
    }
}

type Tick {
    from: String = "";
    seq: U64 = 0;
    batch: bounded[U64; 2];
}
topic Ticks { payload: Tick; }

locus Sink {
    params { got: String = ""; }
    bus { subscribe Ticks as h; }
    fn h(t: Tick) {
        let first = at(t.batch, 0) or 0;
        self.got = t.from + " " + to_string(t.seq) + " " + to_string(first);
    }
}

locus Source {
    bus { publish Ticks; }
    birth() {
        let t = Tick { from: "a", seq: U64::max() };
        push(t.batch, U64::max() - 1) or raise;
        Ticks <- t;
    }
}

fn exact_of(a: Amount) -> U64 {
    return match a {
        Amount::Exact(v) -> v,
        Amount::Pair(_, v) -> v,
        _ -> 0,
    };
}

fn top(n: U64) -> U64 {
    return U64::max() - n;
}

fn main() {
    let c = Counter { hits: U64::max(), misses: 9223372036854775808, name: "x" };
    std::test::assert_eq_str(to_string(c.hits), MAX, "a record field at max");
    std::test::assert_eq_str(to_string(c.misses), "9223372036854775808", "beside it, 2^63");
    std::test::assert_eq_str(c.name, "x", "the field after them");
    let d = c;
    std::test::assert(d.hits == c.hits && d.misses > d.hits / 2, "a copied record");
    std::test::assert_eq_str(
        "" + c,
        "Counter { hits: " + MAX + ", misses: 9223372036854775808, name: \"x\" }",
        "a record prints its U64 fields unsigned",
    );

    std::test::assert(exact_of(Amount::Exact(U64::max())) == U64::max(), "an enum payload at max");
    std::test::assert(
        exact_of(Amount::Pair(7, U64::max() - 2)) == U64::max() - 2,
        "a payload after an Int",
    );

    // a bounded buffer and a fixed array
    let bag = Bag { };
    push(bag.items, 1) or raise;
    push(bag.items, U64::max()) or raise;
    push(bag.items, 3) or raise;
    std::test::assert_eq_int(count(bag.items), 3, "three pushed");
    let mut sum: U64 = 0;
    for x in bag.items {
        sum = sum + x % 1000;
    }
    std::test::assert(sum == 619, "each element read back (max % 1000 is 615)");
    let second = at(bag.items, 1) or 0;
    std::test::assert(second == U64::max(), "an element at max");
    let w = Words { w: [1, U64::max(), 2] };
    std::test::assert(w.w[1] == U64::max() && w.w[2] == 2, "a fixed array, inline");
    std::test::assert_eq_str("" + w.w, "[1, " + MAX + ", 2]", "a fixed array prints its U64s");
    std::test::assert_eq_str(to_string(bag.items), "[1, " + MAX + ", 3]", "and a bounded list");
    std::test::assert(BIG == U64::max() && SMALL + 1 == 8, "a const of each kind");

    // a generic record, a fn's parameter and return, a locus param, a
    // hashmap cell
    let bx: Box<U64> = Box { value: U64::max() };
    std::test::assert(bx.value == U64::max(), "Box<U64>");
    std::test::assert(top(5) == 18446744073709551610, "a parameter and a return");
    let h = Holder { };
    h.add(U64::max() - 5);
    h.add(5);
    std::test::assert(h.total == U64::max(), "a locus param written from a method");
    let seen = Seen { };
    seen.set(Cell { key: "a", seen: U64::max() });
    seen.set(Cell { key: "b", seen: 2 });
    let got = seen.get("a") or Cell { };
    std::test::assert(got.seen == U64::max(), "a hashmap cell");
    let mut total: U64 = 0;
    for cell in seen.entries {
        total = total + cell.seen % 1000;
    }
    std::test::assert(total == 617, "each cell iterated (615 + 2)");

    // a bus payload
    let sink = Sink { };
    Source { };
    std::test::assert_eq_str(
        sink.got,
        "a " + MAX + " " + to_string(U64::max() - 1),
        "a bus payload's U64 field and buffer",
    );
}
