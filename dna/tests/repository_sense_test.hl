// dna/tests/repository_sense_test.hl — a repository's application is
// attached, and what it says reaches the heart (ruling 11, 2026-10-12).
//
// `hale dna init` on a repository root (no Hale source of its own) is the
// repository mode: its application is its compose services, which the
// compose file expresses. It used to record no `application.attached`, so
// no broker account was drawn and the application's sense had nowhere to
// speak. Now the record attaches the application by the project's name —
// no `main`, no artifact, `repository: true` — `app-<name>` is minted in
// the vault like any application's, `hale dna nerves migrate` hands out
// its URL, user and vault entry, and the todo api's own `Nerves` (the
// sense its `main.hl` wires) says an overdue item as
// `<org>.app.todo.concern.raised`, which the organization's heart puts
// into the record. A repository is still re-ingested: its attachment is
// not an application's artifact. Without a NATS server
// (HALE_DNA_NATS_URL_OWNER) only the record half is exercised.

import "../core" as dna;
import "./onboarding/todo/api/nerves" as todo;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn source() -> String {
    let given = if std::env::var_exists("HALE_DNA_SOURCE") { std::env::var("HALE_DNA_SOURCE") } else { "." };
    return dna::trim_nl(dna::run_tool("sh\n-c\ncd \"$1\" && pwd\nsh\n" + given).stdout);
}

// Run `argv` (newline-separated) in `dir`: discovery and hosted models off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && unset ANTHROPIC_API_KEY OPENAI_API_KEY && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

fn host_log(app: String) -> String { return std::io::fs::read_file(app + "/host.log") or ""; }

// Whether the host's log comes to say `text` within `secs`.
fn logged(app: String, text: String, secs: Int) -> Bool {
    let deadline = std::time::now() + dna::wait_secs(secs);
    while std::time::now() <= deadline {
        if std::str::contains(host_log(app), text) { return true; }
        std::time::sleep(250ms);
    }
    return false;
}

// The body of the record's first row of `kind`, "" when it holds none.
fn first_body(repo: String, kind: String) -> String {
    let j = dna::GitJournal { repo: repo };
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == kind { return e.body; }
        i = i + 1;
    }
    return "";
}

// Rows of `kind` whose body's `request` is `request`.
fn concerns(repo: String, kind: String, request: String) -> Int {
    let j = dna::GitJournal { repo: repo };
    let mut n = 0;
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == kind && dna::request_named(e.body) == request { n = n + 1; }
        i = i + 1;
    }
    return n;
}

main locus App {
    run() {
        let scratch = dna::scratch_root("reposense");
        dna::reap_on_exit(scratch);
        let repo = scratch + "/todo";
        let made = dna::run_tool("sh\n-c\nmkdir -p \"$1\" && cp -r \"$2/dna/tests/onboarding/todo/.\" \"$1/\" && cd \"$1\" && git init -q -b main && git config user.name organism-host && git config user.email host@dna && git add -A && git commit -q -m todo\nsh\n" + repo + "\n" + source());
        std::test::assert_eq_int(made.code, 0, "the todo fixture, a repository of its own: " + made.stderr);
        let init = in_dir(repo, toolchain() + "\ndna\ninit\n.\n--no-library");
        std::test::assert_eq_int(init.code, 0, "hale dna init: " + init.stdout + init.stderr);
        std::test::assert(std::str::contains(init.stdout, "application.attached `todo`"), "init says the repository's application is attached: " + init.stdout);

        // ---- the record: the application attached by the project's name
        let attached = first_body(repo, "application.attached");
        std::test::assert_eq_str(std::json::find_string_field(attached, "name"), "todo", "attached by the project's name: " + attached);
        std::test::assert(std::json::find_bool_field(attached, "repository") && len(std::json::find_string_field(attached, "main")) == 0, "as a repository's, naming no main: " + attached);
        let shown = in_dir(repo, toolchain() + "\ndna\nstatus");
        std::test::assert(std::str::contains(shown.stdout, "expression: the repository's compose services, attached as todo"), "the status names the expression: " + shown.stdout + shown.stderr);
        let committed = dna::run_tool("sh\n-c\ncd \"$1\" && git add -A && git commit -qm organism\nsh\n" + repo);
        std::test::assert_eq_int(committed.code, 0, "the organism committed: " + committed.stderr);
        let ingested = in_dir(repo, toolchain() + "\ndna\ningest");
        std::test::assert(ingested.code == 0 && std::str::contains(ingested.stdout, "ingested "), "a repository is still re-ingested: " + ingested.stdout + ingested.stderr);

        let nats_owner = if std::env::var_exists("HALE_DNA_NATS_URL_OWNER") { std::env::var("HALE_DNA_NATS_URL_OWNER") } else { "" };
        if len(nats_owner) == 0 {
            eprintln("repository_sense_test: the sense half not exercised (HALE_DNA_NATS_URL_OWNER is not set)");
            dna::scratch_done(scratch);
            return;
        }
        // ---- the account: what an attached application connects with
        let nerves = in_dir(repo, "sh\n-c\nHALE_DNA_NATS_URL_OWNER=\"$2\" exec \"$1\" dna nerves migrate\nsh\n" + toolchain() + "\n" + nats_owner);
        let spine = line_value(nerves.stdout, "HALE_DNA_NATS_URL_SPINE");
        let app_url = line_value(nerves.stdout, "HALE_DNA_NATS_URL_APP");
        let app_vault = line_value(nerves.stdout, "HALE_DNA_NATS_VAULT_APP");
        let app_user = line_value(nerves.stdout, "HALE_DNA_NATS_USER_APP");
        let org = line_value(nerves.stdout, "HALE_DNA_NATS_ORG");
        std::test::assert(nerves.code == 0 && len(spine) > 0 && len(app_url) > 0 && app_user == "app-todo" && app_vault == "nats-" + org + "-app-todo", "the repository's application has its account: " + nerves.stdout + nerves.stderr);

        let started = in_dir(repo, "sh\n-c\nHALE_DNA_NATS_URL_SPINE=\"$2\" HALE_DNA_NATS_ORG=\"$3\" nohup timeout --foreground 300 \"$1\" dna run . --no-iris >host.log 2>&1 </dev/null & echo $!\nsh\n" + toolchain() + "\n" + spine + "\n" + org);
        let host_pid = dna::trim_nl(started.stdout);
        std::test::assert(logged(repo, "the organization reads its facts from the nerves", 300) && logged(repo, "hale dna run: genome ", 60), "the organization came up on the repository record: " + host_log(repo));

        // ---- the application's own sense, as its main.hl wires it
        let sense = todo::Nerves { url: app_url, user: app_user, credential: std::secret::Credential { vault: app_vault }, org: org };
        sense.overdue(7, "file the report", "2026-10-01T00:00:00Z");
        std::test::assert_eq_int(sense.said, 1, "the nerves took the application's concern: " + sense.last_error);
        let request = "todo/concern.raised/overdue-7";
        std::test::assert(logged(repo, "a concern from todo/overdue (" + request + ") put into the record", 60), "the heart put the application's concern into the record: " + host_log(repo));
        std::test::assert_eq_int(concerns(repo, "concern.requested", request), 1, "once");

        let k1 = dna::run_tool("kill\n" + host_pid);
        let rest = dna::run_tool("sh\n-c\ncd \"$1\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; done; true\nsh\n" + repo);
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
