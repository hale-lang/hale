    // A change to the structure (ops::StructureCommandCodec): the rows its
    // CLI verb writes, admitted as every command is.
    fn open_position(p: PositionOpening, ctx: std::api::Context) -> CommandReply {
        return self.submit(
            ctx,
            CommandRequest {
                request_id: p.request_id,
                operation: "dna.position.open",
                target_kind: "dna.position",
                target_id: seat_named(p.position, false),
                subject_digest: p.record_head,
                record_head: p.record_head,
                text: p.text, mandate: p.mandate, under: p.under });
