// A bus handler's cell holds its subscriber (inventory row R52), and a
// worker carries that hold to its next cell only when the cell is the
// same subscriber's. `a` and `b` share pool `right` and both subscribe
// to the topic that `f`, on pool `left`, publishes to until App writes
// its stop file, so the worker's cells alternate between the two
// subscribers and each ends the other's hold. Each handler reads its
// heap name, and the old `b`'s sleeps 1 ms. App's run() replaces `b`
// once it has run fifty cells, mid-stream: the old `b`'s reclaim
// completes while `a`'s cells go on, and every handler reads its own
// name whole. The new `b`'s cells are delivered on main's queue, which a
// function's exit drains: App's run() calls none of its own between the
// replacement and the stop file (the paths are made before), since that
// drain would run the flood's cells as fast as they come.
// Expected outcome: `replaced a-after read-whole dissolved-once-each
// finished`.

type Go { k: Int; }
topic Gos { payload: Go; subject: "fd.cellmix.go"; }

fn gate() -> String { return "/tmp/hale-fd-cellmix-" + to_string(std::process::pid()); }
fn stop() -> String { return "/tmp/hale-fd-cellmix-stop-" + to_string(std::process::pid()); }

locus Kid {
    params { tag: Int = 0; name: String = ""; heard: Int = 0; }
    bus { subscribe Gos as on_go; }
    birth() { self.name = "kid-" + to_string(self.tag) + "-name"; }
    fn on_go(g: Go) {
        self.heard = self.heard + 1;
        if self.heard == 50 && self.tag == 2 { std::io::fs::write_file(gate(), "go") or discard; }
        if self.name != "kid-" + to_string(self.tag) + "-name" { println("ev handler-torn " + self.name); }
        if self.tag == 2 { std::time::sleep(1ms); }
    }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag) + " " + self.name); }
}

locus Flood {
    params { sent: Int = 0; }
    bus { publish Gos; }
    run() {
        let mut going = true;
        while going {
            Gos <- Go { k: self.sent };
            self.sent = self.sent + 1;
            if self.sent % 16 == 0 { going = !std::io::fs::file_exists(stop()); }
        }
    }
}

main locus App {
    params { a: Kid = Kid { tag: 1 }; b: Kid = Kid { tag: 2 }; f: Flood = Flood { }; }
    placement {
        a: cooperative(pool = right);
        b: cooperative(pool = right);
        f: cooperative(pool = left);
    }
    run() {
        let opened = gate();
        let stopped = stop();
        let until = std::time::monotonic_ns() + 10000000000;
        while (!std::io::fs::file_exists(opened) && std::time::monotonic_ns() < until) { std::time::sleep(1ms); }
        self.b = Kid { tag: 3 };
        println("ev replaced");
        let a = self.a.heard;
        let spin = std::time::monotonic_ns() + 50000000;
        while (std::time::monotonic_ns() < spin) { }
        if self.a.heard > a { println("ev a-after"); }
        std::io::fs::write_file(stopped, "stop") or discard;
        println("ev finished");
    }
    dissolve() {
        std::io::fs::unlink(gate()) or discard;
        std::io::fs::unlink(stop()) or discard;
    }
}

fn main() { App { }; }
