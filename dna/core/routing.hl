// dna/core/routing.hl — three memories, one routing table (GH #646 stage
// 1, #650). Every row kind belongs to exactly one memory. Version 0 is
// every kind in the record (git); version 1 is the split: what changes
// the organism stays in the record, what the organism did today goes to
// the Ledger. An organism's version is a fact in its record
// (`ledger.adopted`), never a build's opinion. There is no dual-write:
// a kind has one home, and a writer that cannot reach it fails.
//
// `RoutedJournal` is the `Journal` an assembly and the host stand on: two
// journals underneath — the record's and the Ledger's — read as one
// merged sequence, appended to by kind. `MemoryLedger` (memory_spine.hl)
// is the Ledger as the organism and the host reach it, under the record's
// spine role; a head writes it directly under its own role, and memory's
// insert function is the gate (GH #985, #1026).

const ROUTING_VERSION: Int = 1;

// The routing table of version 1, as data: the families that are the
// Ledger's whole, and the kinds of other families that are. `memory_of`
// reads it, and so does memory's insert function (`ledger_kind`, GH
// #1026), which refuses a record kind asked of the Ledger — one table,
// read in two languages.
//
// The whole family is operational: cases, intents, tasks, decisions,
// completions, exceptions, schedules, receipts, handoffs, pressure,
// instances, effects, reports, leases and claims.
const LEDGER_FAMILIES: String = "case intent task decision completion exception schedule receipt handoff pressure instance effect report lease claim";
// Families split by kind — concerns, money, a body's liveness, model
// calls — and, GH #646 card 05, a workflow execution's own facts: the
// `workflow`, `step` and `attempt` families and `work.settled` are the
// day's work, named here rather than left to the default.
const LEDGER_KINDS: String = "concern.requested concern.raised concern.refused grant.reserved grant.released grant.fenced grant.reservation_refused spend.reserved spend.settled spend.compensated body.claimed body.released body.credential_missing body.credential_present model.called knowledge.consulted optimize.refused budget.exhausted workflow.admitted workflow.refused workflow.ask_refused workflow.settled step.registered step.activated step.completed step.failed work.settled attempt.admitted attempt.outcome";

// Where a kind lives under routing version 1. Everything the table does
// not name — mutations, reviews, knowledge, practices, grants as
// authority, connections, provisioning, secrets, expression, the fleet's
// deploys, people, the structure observed at init, and the adoption rows
// themselves — is the record's.
fn memory_of(kind: String) -> String {
    let dot = std::str::index_of(kind, ".");
    let family = if dot < 0 { kind } else { kind[0..dot] };
    if word_in(family, LEDGER_FAMILIES) || word_in(kind, LEDGER_KINDS) { return "ledger"; }
    return "record";
}

// Where a kind lives under a routing version.
fn route(routing: Int, kind: String) -> String {
    if routing <= 0 { return "record"; }
    return memory_of(kind);
}

// The routing an organism's record says it is on: the last
// `ledger.adopted` row sets it, a later `ledger.abandoned` returns it
// to 0. Rows are read from a journal of the record's rows.
@unbounded
fn routing_of(record: Journal) -> Int {
    let mut routing = 0;
    let mut i = 0;
    let n = record.revision();
    while i < n {
        let e = record.read(i);
        if e.kind == "ledger.adopted" { routing = std::json::find_int_field(e.body, "routing"); }
        if e.kind == "ledger.abandoned" { routing = 0; }
        i = i + 1;
    }
    return routing;
}

// The checkpoint an adopted record names: the record's head at
// adoption ("" when not adopted).
@unbounded
fn checkpoint_of(record: Journal) -> String {
    let mut at = "";
    let mut i = 0;
    let n = record.revision();
    while i < n {
        let e = record.read(i);
        if e.kind == "ledger.adopted" { at = std::json::find_string_field(e.body, "checkpoint"); }
        if e.kind == "ledger.abandoned" { at = ""; }
        i = i + 1;
    }
    return at;
}

// ---- the routed journal ------------------------------------------------

// One entry of the merged order: which memory, and the row's index there.
type Placed {
    ledger: Bool = false;
    index: Int = 0;
}

@form(vec)
locus PlacedRows {
    capacity { heap rows of Placed; }
}

// Two journals read as one. The merged order is arrival: at birth every
// record row then every Ledger row, then each row as it is appended or
// seen at a refresh. A row's `seq` as read here is its merged position,
// so a writer that appends and looks for its row by `revision - 1`
// finds it whichever memory holds it. Rows name each other by id, never
// by seq (GH #603), so no reader depends on the interleaving.
locus RoutedJournal {
    params {
        record: Journal = MemJournal { };
        ledger: Journal = MemoryLedger { };
        routing: Int = 0; // learned from the record at birth and on refresh
        order: PlacedRows = PlacedRows { };
        seen_record: Int = 0;
        seen_ledger: Int = 0;
        last_error: String = "";
    }
    birth() {
        self.routing = routing_of(self.record);
        self.take_new();
    }
    // Append every row a memory has that the order does not. Under
    // routing 1 a record row of a Ledger kind is not read: the rows from
    // before the checkpoint were copied to the Ledger at adoption and are
    // read there, and one written into the record after it was refused
    // admission (#646 decision 3) — the Ledger is the authority for those
    // kinds, and the record's copies stay as history git keeps.
    @unbounded
    fn take_new() {
        while self.seen_record < self.record.revision() {
            let e = self.record.read(self.seen_record);
            if route(self.routing, e.kind) != "ledger" { self.order.push(Placed { ledger: false, index: self.seen_record }); }
            self.seen_record = self.seen_record + 1;
        }
        // on routing 0 the ledger is not a memory of this organism: it is
        // neither read nor asked (a service ledger's refresh is a round
        // trip, and an organism on the record alone makes none)
        if self.routing <= 0 { return; }
        while self.seen_ledger < self.ledger.revision() {
            self.order.push(Placed { ledger: true, index: self.seen_ledger });
            self.seen_ledger = self.seen_ledger + 1;
        }
    }
    fn revision() -> Int { return self.order.len(); }
    fn head() -> String {
        if self.order.len() == 0 { return "genesis"; }
        return self.read(self.order.len() - 1).digest;
    }
    fn refresh() -> Bool {
        let a = self.record.refresh();
        let b = if self.routing > 0 { self.ledger.refresh() } else { false };
        let before = self.order.len();
        let seen = self.seen_record;
        // new record rows may carry an adoption (or its abandonment): the
        // order is rebuilt under the routing they name
        if self.seen_record < self.record.revision() {
            let now = routing_of(self.record);
            if now != self.routing {
                self.routing = now;
                while self.order.len() > 0 { let gone = self.order.pop() or Placed { }; }
                self.seen_record = 0;
                self.seen_ledger = 0;
            }
        }
        self.take_new();
        return self.order.len() != before || a || b || self.seen_record != seen;
    }
    fn read(i: Int) -> Event {
        let p = self.order.get(i) or Placed { };
        let e = if p.ledger { self.ledger.read(p.index) } else { self.record.read(p.index) };
        return Event { seq: i, kind: e.kind, entity: e.entity, body: e.body, prev: e.prev, digest: e.digest };
    }
    fn verify_chain() -> Bool { return self.record.verify_chain() && (self.routing <= 0 || self.ledger.verify_chain()); }
    fn to_ledger(kind: String) -> Bool { return route(self.routing, kind) == "ledger"; }
    // Compare-and-append against the merged revision, then the memory's
    // own tail: the memory retries a lost race at its tail as it always
    // did, and the row's merged position is where it lands here. (Each
    // memory is called on its own typed field: the law's claim walk
    // follows a typed receiver, never one a method handed back.)
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let rev = self.order.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let r = if self.to_ledger(kind) { self.ledger.append(self.ledger.revision(), kind, entity, body) } else { self.record.append(self.record.revision(), kind, entity, body) };
        if !r.ok { self.last_error = r.error; return AppendResult { error: r.error, expected: expected, actual: self.order.len() }; }
        self.take_new();
        return AppendResult { ok: true, revision: self.order.len() };
    }
    // Exact: neither memory may have moved since the caller read the
    // merged revision, and the memory's own swap is one attempt.
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let moved = self.refresh();
        let rev = self.order.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let r = if self.to_ledger(kind) { self.ledger.append_exact(self.ledger.revision(), kind, entity, body) } else { self.record.append_exact(self.record.revision(), kind, entity, body) };
        if !r.ok {
            self.take_new();
            return AppendResult { error: r.error, expected: expected, actual: self.order.len() };
        }
        self.take_new();
        return AppendResult { ok: true, revision: self.order.len() };
    }
}

// ---- coordination in the store (GH #646 stage 2, #651) ---------------------
//
// A lease is a cell the store swaps by its token: `current(key)` reads
// it, `put(key, lease, expected_token)` lands only when the store's
// token is the one expected (0 for an absent lease). Mutation leases
// (`Coordination`) and the body lease both stand on those two calls,
// so a partitioned host or a stale token is refused by the store
// itself, with no git transport in the path.

// The routing an organism's record is on, read from the record's own
// text (for a caller that holds a `Record` and no journal).
@unbounded
fn routing_of_text(text: String) -> Int {
    let mut routing = 0;
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let kind = std::json::find_string_field(line, "kind");
        if kind == "ledger.adopted" { routing = std::json::find_int_field(std::json::find_string_field(line, "body"), "routing"); }
        if kind == "ledger.abandoned" { routing = 0; }
    }
    return routing;
}
