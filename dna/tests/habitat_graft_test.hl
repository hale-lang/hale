// dna/tests/habitat_graft_test.hl — a fixture's organisms are grafted
// from a habitat of the test's (GH #1653).
//
// Every organism but the habitat is grafted from one, so a fixture makes
// its organisms with `dna::grafted`, into `dna::test_habitat`: the DNA
// suite's slice habitat when the suite runs it (born once per slice, on
// the operator's backends in CI, its secrets lent into this file's vault),
// or this test file's own, born here the first time with no body. Two
// organisms grafted into it are two children of one parent: each record's
// genesis names the habitat's record, and the habitat records each graft.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn main() {
    let scratch = dna::scratch_root("habitat-graft");
    let habitat = dna::test_habitat();
    std::test::assert(len(habitat) > 0, "the test has a habitat to graft into");
    let parent = dna::record_scope(habitat + "/genome");
    std::test::assert_eq_int(len(parent), 64, "a born one, with a record");
    let one = dna::grafted(scratch, "one\n--no-library");
    std::test::assert(one.code == 0 && std::str::contains(one.stdout, "as the habitat's child (parent " + parent[0..12]), "the first organism is grafted: " + one.stdout + one.stderr);
    let two = dna::grafted(scratch, "two\n--no-library");
    std::test::assert(two.code == 0, "and the second: " + two.stdout + two.stderr);
    let rows = dna::run_tool("sh\n-c\ncd \"$1\" && HALE_DNA_HABITAT=\"$2\" exec \"$3\" dna record-rows .\nsh\n" + scratch + "/two\n" + habitat + "\n" + toolchain()).stdout;
    std::test::assert(std::str::contains(rows, "\"kind\": \"record.genesis\"") && std::str::contains(rows, "\\\"parent\\\":\\\"" + parent + "\\\""), "each genesis names the habitat's record: " + rows);
    std::test::assert(dna::record_scope(scratch + "/one") != dna::record_scope(scratch + "/two"), "two organisms, two identities");
    dna::scratch_done(scratch);
}
