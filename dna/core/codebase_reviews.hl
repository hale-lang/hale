// dna/core/codebase_reviews.hl — what became of the reviews a leg opened
// at a codebase's forge (phase 3, heart-protocol item 4).
//
// A leg's change in an attached codebase ends in a review at that
// codebase's forge: its attempt settles done with `result_ref:
// review:<ref>`. The forge decides the rest, and the organism learns it
// through the `Forge` interface (dna/core/forge.hl), the host's
// `github_sync` being the real path:
//
//   merged            task.delivered   {task, review, codebase, leg_commit,
//                                       merge_commit, edited, edit_receipt,
//                                       comment_receipts}
//   closed, unmerged  task.refused     {task, review, codebase, why,
//                                       comment_receipts}
//
// A change the team edited before merging is still delivered: the diff
// between the leg's last commit (named in the review it opened) and the
// merge commit is the `edit_receipt`, what the organism learns from. Every
// comment on the review is a receipt on the task, the verdict row's
// `comment_receipts` (space-separated, in the forge's order), and there is
// no row kind of a comment's own. The rows are the `task` family's, so they
// live in the Ledger.
//
// `codebase_intake` reads and decides; it returns the rows to append, one
// per line as `kind\tentity\tbody`, and appends nothing, so the host (which
// writes as a named author) and a fixture (which writes to a journal) both
// apply them.

// The task an attempt belongs to: the id before its first `/`.
fn task_of_attempt(attempt: String) -> String {
    let at = std::str::index_of(attempt, "/");
    return if at < 0 { attempt } else { attempt[0..at] };
}

// Whether the record holds a terminal row for the task's codebase review.
@bounded_by(j)
fn codebase_review_decided(j: Journal, task: String) -> Bool {
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.entity == task && (e.kind == "task.delivered" || e.kind == "task.refused") { return true; }
        i = i + 1;
    }
    return false;
}

// The codebase reviews still undecided, one per line as `task\treview`:
// the latest `review:<ref>` a task's attempt settled done with.
@bounded_by(j)
fn codebase_reviews_open(j: Journal) -> String {
    let mut seen = "\n";
    let mut out = "";
    let mut i = j.revision() - 1;
    while i >= 0 {
        let e = j.read(i);
        if e.kind == "attempt.outcome" && std::json::find_string_field(e.body, "disposition") == "done" {
            let ref = std::json::find_string_field(e.body, "result_ref");
            let task = task_of_attempt(e.entity);
            if std::str::starts_with(ref, "review:") && !std::str::contains(seen, "\n" + task + "\n") {
                seen = seen + task + "\n";
                if task_codebase(j, task).present && !codebase_review_decided(j, task) { out = out + task + "\t" + ref[7..len(ref)] + "\n"; }
            }
        }
        i = i - 1;
    }
    return out;
}

fn intake_row(kind: String, entity: String, body: String) -> String { return kind + "\t" + entity + "\t" + body + "\n"; }

// The n-th tab-separated field of a line ("" past the last).
fn intake_field(line: String, n: Int) -> String {
    let mut rest = line;
    let mut i = 0;
    while i < n {
        let t = std::str::index_of(rest, "\t");
        if t < 0 { return ""; }
        rest = rest[(t + 1)..len(rest)];
        i = i + 1;
    }
    let t = std::str::index_of(rest, "\t");
    return if t < 0 { rest } else { rest[0..t] };
}

// What the forge says of every undecided codebase review, as the rows that
// record it. Bodies kept as receipts (a comment, an edit's diff) are stored
// in `receipts` first. `only` names one codebase's reviews ("" for all of them).
@bounded_by(j)
fn codebase_intake(j: Journal, forge: Forge, receipts: Receipts, only: String) -> String {
    let mut rows = "";
    let mut rest = codebase_reviews_open(j);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let task = intake_field(line, 0);
        let ref = intake_field(line, 1);
        let c = task_codebase(j, task);
        if !c.present || (len(only) > 0 && c.name != only) { continue; }
        // the people's words on the review, once each, kept as receipts the
        // verdict row names
        let mut said = forge.review_comments(ref);
        let mut keys = "\n";
        let mut comments = "";
        while len(said) > 0 {
            let cn = std::str::index_of(said, "\n");
            let cl = said[0..cn];
            said = said[(cn + 1)..len(said)];
            let who = intake_field(cl, 0);
            let key = intake_field(cl, 1);
            let text = std::str::replace(intake_field(cl, 2), "\\n", "\n");
            if len(key) == 0 || len(text) == 0 || std::str::contains(keys, "\n" + key + "\n") { continue; }
            keys = keys + key + "\n";
            let kept = receipts.store(who + " on review " + ref + ":\n" + text);
            if len(kept) == 0 { continue; }
            comments = comments + (if len(comments) > 0 { " " } else { "" }) + kept;
        }
        let state = forge.review_state(ref);
        let head = intake_field(state, 0);
        if head == "merged" {
            let merge = intake_field(state, 1);
            let leg = leg_commit_in(forge.review_body(ref));
            let diff = codebase_diff(c, leg, merge);
            let edited = len(std::str::trim(diff)) > 0;
            let kept = if edited { receipts.store(diff) } else { "" };
            if edited && len(kept) == 0 { continue; }
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("task", task);
            b.string_field("review", ref);
            b.string_field("codebase", c.name);
            b.string_field("via", "review");
            b.string_field("leg_commit", leg);
            b.string_field("merge_commit", merge);
            b.bool_field("edited", edited);
            b.string_field("edit_receipt", kept);
            b.string_field("comment_receipts", comments);
            b.end_object();
            rows = rows + intake_row("task.delivered", task, b.result());
        } else if head == "closed" {
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("task", task);
            b.string_field("review", ref);
            b.string_field("codebase", c.name);
            b.string_field("via", "review");
            b.string_field("why", "closed without merging");
            b.string_field("comment_receipts", comments);
            b.end_object();
            rows = rows + intake_row("task.refused", task, b.result());
        }
    }
    return rows;
}

// The rows `codebase_intake` returned, appended to `j` in order. How many landed.
@bounded_by(rows)
fn codebase_intake_apply(j: Journal, rows: String) -> Int {
    let mut n = 0;
    let mut rest = rows;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let r = j.append(j.revision(), intake_field(line, 0), intake_field(line, 1), line[(len(intake_field(line, 0)) + len(intake_field(line, 1)) + 2)..len(line)]);
        if r.ok { n = n + 1; }
    }
    return n;
}
