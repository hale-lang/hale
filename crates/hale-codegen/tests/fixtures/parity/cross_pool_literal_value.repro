// A locus literal used as a value where its birth is a cross-pool post in some instances.
// == main/main.hl ==
locus I {
    params {
        x: Int = 0;
    }
}

fn id<T>(x: T) -> T {
    return x;
}

locus Worker {
    fn spawn() {
        id(I { });
    }
}

locus Owner {
    params {
        w: Worker = Worker { };
    }
}

main locus App {
    params {
        a: Worker = Worker { };
        o: Owner = Owner { };
    }
    placement {
        o: pinned;
    }
    accept(c: I) { }
}

fn main() {
    App { };
}
