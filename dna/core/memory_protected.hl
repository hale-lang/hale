// dna/core/memory_protected.hl — protected evidence (GH #606).
//
// A customer or confidential body never enters the record: not a git
// receipt, so `sync` cannot carry it to a clone. Memory is its only
// keeper, in the record's own schema (GH #613), and every read of it is
// an act the record names. Each body is encrypted at rest with
// pgcrypto's OpenPGP symmetric cipher (AES-256) under a key memory holds
// (GH #985): `PqProtected` files, reads and erases through memory's own
// functions (receipt_file, receipt_read, receipt_erase), so no client
// ever holds the key. A dump of the database carries the key and the
// ciphertext together; treat it as the evidence itself (GH #989).

type Protected {
    present: Bool = false;
    class: String = "";
    text: String = "";
    stored_at: Int = 0;
}

interface ProtectedBodies {
    fn kind() -> String;
    // Whether bodies can be kept at all (a key is present); `why_not`
    // says what is missing when not.
    fn ready() -> Bool;
    fn why_not() -> String;
    fn scope(record: String);
    // Keep one body under its digest; a second put of the same digest
    // keeps the first.
    fn put(digest: String, class: String, text: String, at: Int) -> Bool;
    fn get(digest: String) -> Protected;
    // Remove a body (GH #606 redaction); true when it is gone.
    fn erase(digest: String) -> Bool;
    fn last_error() -> String;
}

type ProtectedRow {
    digest: String = "";
    class: String = "";
    text: String = "";
    stored_at: Int = 0;
}

@sealed locus PqProtected {
    params {
        conn: pq::PgConn = pq::PgConn { sslmode: "prefer" };
        // GH #985: the environment variable naming this store's DSN, read
        // at open; "" when the connection was built from a DSN in hand
        dsn_env: String = "";
        record_id: String = "";
        opened: Bool = false;
        error: String = "";
    }
    // a store holds one connection, and gives it back when it goes (GH #985)
    dissolve() { self.conn.close(); }
    fn kind() -> String { return "postgres (pgcrypto, AES-256)"; }
    // The record this store is scoped to, and the environment variable its
    // DSN is read from at open (GH #985): set through the store, which is
    // sealed.
    fn record() -> String { return self.record_id; }
    fn use_dsn_env(env_name: String) {
        if env_name == self.dsn_env { return; }
        self.dsn_env = env_name;
        self.opened = false;
    }
    // The key is memory's, not this process's (GH #985): a store is ready
    // when it knows where memory is; one that holds no key says so when a
    // body is filed or read.
    fn ready() -> Bool { return len(self.dsn_env) > 0 || len(self.conn.user) > 0; }
    fn why_not() -> String { return "no memory named (HALE_DNA_MEMORY_DSN_SPINE / HALE_DNA_MEMORY_DSN_HEAD)"; }
    fn scope(record: String) {
        if record == self.record_id { return; }
        self.record_id = record;
        self.opened = false;
    }
    fn last_error() -> String { return self.error; }
    @unbounded
    fn open() -> Bool {
        if self.opened { return true; }
        let dialled = dial_from_env(self.conn, self.dsn_env);
        if len(dialled) > 0 { self.error = dialled; return false; }
        let st = self.conn.open();
        if !st.ok { self.error = "open: " + st.err.kind + " " + st.err.detail; return false; }
        // the schema (and pgcrypto) are the owner's to create (GH #985):
        // checked here
        let sch = schema_for(self.record_id);
        let ns = self.conn.exec("SET search_path TO " + sch + ", public");
        if !ns.ok { self.error = "scope (schema " + sch + "): " + ns.err.kind + " " + ns.err.detail; return false; }
        let fence = memory_fence(self.conn, sch);
        if len(fence) > 0 { self.error = fence; self.conn.close(); return false; }
        self.opened = true;
        return true;
    }
    // Drop the connection and open it again, schema and all. The knowledge
    // projection's store has done this since its own connection went stale
    // (the review's second round, finding 4); the protected store never
    // did, so a database restart left every protected read and erase
    // failing until the service was restarted (#637).
    fn redial() -> Bool {
        self.conn.close();
        self.opened = false;
        return self.open();
    }
    fn put(digest: String, class: String, text: String, at: Int) -> Bool {
        if !self.ready() { self.error = self.why_not(); return false; }
        if !self.open() { return false; }
        let a = db::Args { };
        a.add(digest);
        a.add(class);
        a.add(text);
        a.add(to_string(at));
        // sealed inside memory, under a key this process never holds
        let r = self.conn.exec_params("SELECT receipt_file($1, $2, $3, $4::bigint)", a);
        if r.ok { return true; }
        // the connection may be gone (a restart, a failover, an idle
        // timeout): dial again once and try again (#637)
        if self.redial() {
            let again = self.conn.exec_params("SELECT receipt_file($1, $2, $3, $4::bigint)", a);
            if again.ok { self.error = ""; return true; }
            self.error = "put: " + again.err.kind + " " + again.err.detail;
            return false;
        }
        self.error = "put: " + r.err.kind + " " + r.err.detail + "; dialling again: " + self.error;
        return false;
    }
    @unbounded
    fn erase(digest: String) -> Bool {
        if !self.open() { return false; }
        let a = db::Args { };
        a.add(digest);
        a.add(to_string(std::time::now()));
        // through memory's own function: the body goes, and its digest is
        // kept so that filing it again is refused (GH #985)
        let r = self.conn.exec_params("SELECT receipt_erase($1, $2::bigint)", a);
        if r.ok { return true; }
        if self.redial() {
            let again = self.conn.exec_params("SELECT receipt_erase($1, $2::bigint)", a);
            if again.ok { self.error = ""; return true; }
            self.error = "erase: " + again.err.kind + " " + again.err.detail;
            return false;
        }
        self.error = "erase: " + r.err.kind + " " + r.err.detail + "; dialling again: " + self.error;
        return false;
    }
    // Read as JSON built by the server: a body is an ordinary paragraph,
    // and the driver's tab-separated rows cannot carry one.
    @unbounded
    fn get(digest: String) -> Protected {
        // the error is this read's, not one left by an earlier call: an
        // absent body with no error is absent
        self.error = "";
        if !self.ready() { self.error = self.why_not(); return Protected { }; }
        if !self.open() { return Protected { }; }
        let a = db::Args { };
        a.add(digest);
        // opened inside memory; the process never holds the key
        let mut rows = self.conn.query_params("SELECT receipt_read($1)", a);
        if !rows.ok {
            let first = "get: " + rows.err.kind + " " + rows.err.detail;
            if !self.redial() { self.error = first + "; dialling again: " + self.error; return Protected { }; }
            rows = self.conn.query_params("SELECT receipt_read($1)", a);
            if !rows.ok { self.error = "get: " + rows.err.kind + " " + rows.err.detail; return Protected { }; }
            self.error = "";
        }
        if rows.n == 0 { return Protected { }; }
        let nl = std::str::index_of(rows.csv, "\n");
        let row = if nl < 0 { rows.csv } else { rows.csv[0..nl] };
        // no such body: the function answers null
        if len(trim_nl(row)) == 0 { return Protected { }; }
        return Protected {
            present: true,
            class: std::json::find_string_field(row, "class"),
            text: std::json::find_string_field(row, "text"),
            stored_at: std::json::find_int_field(row, "stored_at")
        };
    }
}
