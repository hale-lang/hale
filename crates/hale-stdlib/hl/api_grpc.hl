// ---- the gRPC transport (spec/api.md § gRPC) ----
//
// `std::api::grpc::Rpc` serves an exposure over gRPC, unary calls only, on
// the HTTP/2 server of `std::io::h2` (io_h2.hl): that file's listener and
// connections do the sockets, the framing of HTTP/2, the windows, the
// pings; what is this transport's own is the stream. A connection raises a
// stream's events on the bus (`__api.h2.event`, keyed by the transport's
// number); the transport reads the request headers, collects the body to
// its end, and publishes the whole of it as the exposure's ingress, its
// correlation the connection and the stream; the exposure's answer comes
// back through `reply`, which asks the connection (`__api.h2.cmd`) to write
// it as a gRPC response. Many calls are in flight on a connection, and on
// many connections; a stream that breaks is that stream's.

/// A stream the transport holds. state: 0 free, 1 receiving (the headers are
/// in, the body is coming), 2 handed to the exposure and not answered, 3
/// handed over and lost (the peer reset the stream, or its connection ended).
type __StdApiGrpcStream {
    conn: Int = -1;
    stream: Int = 0;
    state: Int = 0;
    over: Bool = false;
    // a reflection call: its answer is started (the headers are out) and the
    // call stays open until the client ends its side
    sent: Bool = false;
    headers: String = "";
    body: Bytes;
}

fn __api_grpc_free() -> __StdApiGrpcStream {
    return __StdApiGrpcStream { conn: -1, stream: 0, state: 0, over: false, headers: "", body: std::bytes::from_string("") };
}

@form(vec)
locus __StdApiGrpcStreams {
    capacity { heap items of __StdApiGrpcStream; }
}

/// A request message is at most this long (the HTTP transport's body limit).
fn __api_grpc_max() -> Int {
    return 1048576;
}

/// The value of header `name` in the text of a stream's headers
/// ("name: value" lines), "" when it has none.
fn __api_grpc_header(h: String, name: String) -> String {
    let text = "\n" + h;
    let at = std::str::index_of(text, "\n" + name + ": ");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 3)..len(text)];
    let end = std::str::index_of(rest, "\n");
    if end < 0 { return rest; }
    return rest[0..end];
}

/// The media type of a content-type value, without its parameters.
fn __api_grpc_media(ctype: String) -> String {
    let semi = std::str::index_of(ctype, ";");
    if semi >= 0 { return std::str::trim(ctype[0..semi]); }
    return std::str::trim(ctype);
}

/// The gRPC status of a refusal kind (spec/api.md § Outcomes).
fn __api_grpc_code(kind: String) -> Int {
    if kind == "malformed" { return 3; }
    if kind == "digest_mismatch" { return 9; }
    if kind == "unauthenticated" { return 16; }
    if kind == "unauthorized" { return 7; }
    if kind == "full" { return 8; }
    if kind == "shutting_down" { return 14; }
    if kind == "unavailable" { return 14; }
    return 13;
}

/// A `grpc-message`: percent-encoded as the protocol states, every byte
/// outside printable ASCII, and `%`, as `%XX`.
fn __api_grpc_message(s: String) -> String {
    let hex = "0123456789ABCDEF";
    let b = std::bytes::from_string(s);
    let n = len(b);
    let mut out = "";
    let mut i = 0;
    while i < n {
        let c = std::bytes::read_u8(b, i) or 0;
        if c >= 32 && c <= 126 && c != 37 {
            out = out + s[i..(i + 1)];
        } else {
            out = out + "%" + hex[(c / 16)..(c / 16 + 1)] + hex[(c % 16)..(c % 16 + 1)];
        }
        i = i + 1;
    }
    return out;
}

/// A protobuf varint.
fn __api_pb_varint(n: Int) -> Bytes {
    let mut out = std::bytes::from_string("");
    let mut v = n;
    while v >= 128 {
        out = std::bytes::concat(out, std::bytes::from_int(v % 128 + 128));
        v = v / 128;
    }
    return std::bytes::concat(out, std::bytes::from_int(v));
}

/// A protobuf length-delimited field: its tag byte, the length, the bytes.
fn __api_pb_field(tag: Int, body: Bytes) -> Bytes {
    return std::bytes::concat(std::bytes::concat(std::bytes::from_int(tag), __api_pb_varint(len(body))), body);
}

// ---- protobuf (spec/api.md § gRPC): proto3's wire format ----
//
// What the generated codecs `__api_pb_decode_<T>` / `__api_pb_encode_<T>`
// (hale_syntax::json_gen) call, and what the reflection service reads and
// writes. A message crosses the exposure as text (`pb::` and the message in
// base64: a String ends at its first NUL, a message does not), and these are
// the bytes it is made of.

/// The position after the varint at `p`: -1 when it runs past the end of `b`
/// or is longer than ten bytes.
fn __api_pb_vend(b: Bytes, p: Int) -> Int {
    let n = len(b);
    let mut q = p;
    while q < n && q < p + 10 {
        let c = std::bytes::read_u8(b, q) or 0;
        q = q + 1;
        if c < 128 { return q; }
    }
    return -1;
}

/// The varint at `p`, ending at `e` (what `__api_pb_vend` answered), as a
/// 64-bit two's-complement integer.
fn __api_pb_vval(b: Bytes, p: Int, e: Int) -> Int {
    let mut v = 0;
    let mut k = e - 1;
    while k >= p {
        let c = std::bytes::read_u8(b, k) or 0;
        v = (v << 7) | (c & 127);
        k = k - 1;
    }
    return v;
}

/// The position after a field's value of wire type `wire` that starts at
/// `p`: -1 when it is cut short, or the wire type is not one proto3 writes.
fn __api_pb_skip(b: Bytes, p: Int, wire: Int) -> Int {
    let n = len(b);
    if wire == 0 { return __api_pb_vend(b, p); }
    if wire == 1 {
        if p + 8 > n { return -1; }
        return p + 8;
    }
    if wire == 5 {
        if p + 4 > n { return -1; }
        return p + 4;
    }
    if wire == 2 {
        let e = __api_pb_vend(b, p);
        if e < 0 { return -1; }
        let l = __api_pb_vval(b, p, e);
        if l < 0 || e + l > n { return -1; }
        return e + l;
    }
    return -1;
}

/// A varint of any 64-bit integer (a negative one is ten bytes).
fn __api_pb_uvarint(n: Int) -> Bytes {
    let mut out = std::bytes::from_string("");
    let mut v = n;
    let mut more = true;
    while more {
        let low = v & 127;
        v = (v >> 7) & 144115188075855871;
        if v == 0 {
            out = std::bytes::concat(out, std::bytes::from_int(low));
            more = false;
        } else {
            out = std::bytes::concat(out, std::bytes::from_int(low | 128));
        }
    }
    return out;
}

/// A varint field.
fn __api_pb_put_int(no: Int, n: Int) -> Bytes {
    return std::bytes::concat(__api_pb_uvarint(no * 8), __api_pb_uvarint(n));
}

fn __api_pb_put_bool(no: Int, b: Bool) -> Bytes {
    let mut n = 0;
    if b { n = 1; }
    return __api_pb_put_int(no, n);
}

/// A `double` field: the tag and eight bytes, little endian.
fn __api_pb_put_f64(no: Int, x: Float) -> Bytes {
    let h = std::bytes::builder::__new(16);
    let _ = std::bytes::builder::__append_f64(h, x, 0);
    return std::bytes::concat(__api_pb_uvarint(no * 8 + 1), std::bytes::builder::__finish(h));
}

/// A length-delimited field: its tag, the length, the bytes.
fn __api_pb_put_msg(no: Int, body: Bytes) -> Bytes {
    return std::bytes::concat(std::bytes::concat(__api_pb_uvarint(no * 8 + 2), __api_pb_uvarint(len(body))), body);
}

fn __api_pb_put_str(no: Int, s: String) -> Bytes {
    return __api_pb_put_msg(no, std::bytes::from_string(s));
}

/// Where the value of field `no` (of wire type `wire`) starts in the message
/// `b`, the last of it if it was sent twice: -1 when it is absent, -2 when the
/// message is not proto3, -3 when the field has another wire type.
fn __api_pb_find(b: Bytes, no: Int, wire: Int) -> Int {
    let n = len(b);
    let mut p = 0;
    let mut at = -1;
    while p < n {
        let te = __api_pb_vend(b, p);
        if te < 0 { return -2; }
        let tag = __api_pb_vval(b, p, te);
        p = te;
        let w = tag & 7;
        if (tag >> 3) == no {
            if w != wire { return -3; }
            at = p;
        }
        let e = __api_pb_skip(b, p, w);
        if e < 0 { return -2; }
        p = e;
    }
    return at;
}

/// The message of a row whose request, response or error is a scalar: one
/// field, `value = 1` (the `.proto`'s `<rpc>Request`, `<rpc>Response` and
/// `<rpc>Error`). The readings fail as a record's field does.
fn __api_pb_box_at(b: Bytes, wire: Int) -> Int fallible(JsonError) {
    let p = __api_pb_find(b, 1, wire);
    if p == -1 { fail JsonError { kind: "missing_field", field: "value" }; }
    if p == -3 { fail JsonError { kind: "wrong_type", field: "value" }; }
    if p < 0 { fail JsonError { kind: "wrong_type", field: "payload" }; }
    return p;
}

fn __api_pb_box_int(b: Bytes) -> Int fallible(JsonError) {
    let p = __api_pb_box_at(b, 0) or raise;
    return __api_pb_vval(b, p, __api_pb_vend(b, p));
}

fn __api_pb_box_bool(b: Bytes) -> Bool fallible(JsonError) {
    let p = __api_pb_box_at(b, 0) or raise;
    return __api_pb_vval(b, p, __api_pb_vend(b, p)) != 0;
}

fn __api_pb_box_float(b: Bytes) -> Float fallible(JsonError) {
    let p = __api_pb_box_at(b, 1) or raise;
    if p + 8 > len(b) { fail JsonError { kind: "wrong_type", field: "payload" }; }
    return std::bytes::read_f64_le(b, p) or 0.0;
}

fn __api_pb_box_str(b: Bytes) -> String fallible(JsonError) {
    let p = __api_pb_box_at(b, 2) or raise;
    let e = __api_pb_vend(b, p);
    let l = __api_pb_vval(b, p, e);
    let s = std::str::from_bytes(std::bytes::slice(b, e, e + l));
    if len(s) != l { fail JsonError { kind: "wrong_type", field: "value" }; }
    return s;
}

/// `grpc-status-details-bin`: a `google.rpc.Status` (code, message, and one
/// detail, an `Any` whose value is the JSON object `value`), base64.
fn __api_grpc_details(code: Int, message: String, type_url: String, value: String) -> String {
    return __api_grpc_details_bytes(code, message, type_url, std::bytes::from_string(value));
}

/// The same, the detail's value the bytes of a message (protobuf, which may
/// hold a NUL).
fn __api_grpc_details_bytes(code: Int, message: String, type_url: String, value: Bytes) -> String {
    let any = std::bytes::concat(__api_pb_field(10, std::bytes::from_string(type_url)), __api_pb_field(18, value));
    let status = std::bytes::concat(std::bytes::concat(std::bytes::from_int(8), __api_pb_varint(code)), std::bytes::concat(__api_pb_field(18, std::bytes::from_string(message)), __api_pb_field(26, any)));
    return std::text::base64::encode(status);
}

/// A gRPC message: the compression flag (0), the length as four bytes, big
/// endian, and the text.
fn __api_grpc_prefix(text: String) -> Bytes {
    return __api_grpc_frame(std::bytes::from_string(text));
}

/// A gRPC message of bytes.
fn __api_grpc_frame(body: Bytes) -> Bytes {
    let n = len(body);
    let size = std::bytes::concat(std::bytes::concat(std::bytes::from_int(n / 16777216), std::bytes::from_int((n / 65536) % 256)), std::bytes::concat(std::bytes::from_int((n / 256) % 256), std::bytes::from_int(n % 256)));
    return std::bytes::concat(std::bytes::concat(std::bytes::from_int(0), size), body);
}

/// The message in a protobuf body (`pb:<message name>:<base64>`).
fn __api_pb_text_bytes(text: String) -> Bytes {
    let rest = text[3..len(text)];
    let colon = std::str::index_of(rest, ":");
    return std::text::base64::decode(rest[(colon + 1)..len(rest)]);
}

/// The name of the message in a protobuf body.
fn __api_pb_text_name(text: String) -> String {
    let rest = text[3..len(text)];
    return rest[0..std::str::index_of(rest, ":")];
}

/// A refusal as its message (`HaleRefusal`): the kind and the reason, the
/// roles an unauthorized one requires (one field a role), the digest a
/// digest_mismatch one is served.
fn __api_pb_refusal(k: String, r: String, x: String) -> Bytes {
    let mut out = __api_pb_put_str(1, k);
    if len(r) > 0 { out = std::bytes::concat(out, __api_pb_put_str(2, r)); }
    if k == "digest_mismatch" { out = std::bytes::concat(out, __api_pb_put_str(4, x)); }
    if k == "unauthorized" {
        let mut rest = x;
        while len(rest) > 0 {
            let comma = std::str::index_of(rest, ",");
            let mut one = rest;
            if comma >= 0 {
                one = rest[0..comma];
                rest = rest[(comma + 1)..len(rest)];
            } else {
                rest = "";
            }
            out = std::bytes::concat(out, __api_pb_put_str(3, one));
        }
    }
    return out;
}

/// The string field `no` of a message, "" when it has none.
fn __api_pb_str_field(b: Bytes, no: Int) -> String {
    let p = __api_pb_find(b, no, 2);
    if p < 0 { return ""; }
    let e = __api_pb_vend(b, p);
    let l = __api_pb_vval(b, p, e);
    return std::str::from_bytes(std::bytes::slice(b, e, e + l));
}

/// A request `frame` refuses `malformed`, with the credential it carried.
fn __api_grpc_bad(raw: Bytes, correlation: Int, token: String, reason: String) -> std::api::Request {
    return std::api::Request { kind: 2, bytes: raw, correlation: correlation, credential: token, peer: std::api::Principal { mode: "bearer", name: "" }, reason: reason };
}

/// The gRPC transport (`std::api::grpc::Rpc`; `grpc::Rpc` at a serve site).
/// `tid` is the number of the exposure it serves and `surface` its name,
/// which the compiler writes into the literal, together with the HTTP/2
/// listener it pairs with, and the descriptors it reflects (`files`). The
/// principal is the bearer `principals` names, read from the `authorization`
/// metadata. The codec is the request's: protobuf for `application/grpc` and
/// `application/grpc+proto` (the messages of the surface's `.proto`), the
/// row's JSON for `application/grpc+json`; the reply speaks the same.
locus __StdApiGrpcRpc {
    params {
        bind: String;
        principals: std::api::BearerSource;
        roles: std::api::RoleSource = __StdApiNoRoles { };
        surface: String = "";
        // the descriptors server reflection answers, written by the compiler
        // (rpc_expand::grpc_files): a line a file, name, symbols, base64
        files: String = "";
        tid: Int = 0;
        closed: Int = 0;
        stops: Int = 0;
        streams: __StdApiGrpcStreams = __StdApiGrpcStreams { };
    }
    bus {
        subscribe __ApiH2CmdT as on_ask where key == self.tid;
        subscribe __ApiH2EventT as on_event where key == self.tid;
        publish __ApiH2CmdT;
        publish __ApiRpcIngressT;
        publish __ApiRpcLostT;
    }
    fn attach(exposure: Int) -> String {
        return "grpc";
    }
    fn on_ask(c: __StdIoH2Cmd) {
        if c.kind == 4 {
            __ApiH2CmdT <- __StdIoH2Cmd { key: self.tid, kind: 3, stream: 0, code: 0, headers: __h2_none(), body: __h2_none(), trailers: __h2_none() };
        }
    }
    // ---- the streams ----
    @unbounded
    fn find(conn: Int, stream: Int) -> Int {
        let n = self.streams.len();
        let mut k = 0;
        while k < n {
            let s = self.streams.get(k) or __api_grpc_free();
            if s.state != 0 && s.conn == conn && s.stream == stream { return k; }
            k = k + 1;
        }
        return -1;
    }
    // The table holds the streams of every connection; a stream past 4096 is
    // refused (REFUSED_STREAM), never queued without a bound.
    @unbounded
    fn put(rec: __StdApiGrpcStream) -> Bool {
        let n = self.streams.len();
        let mut k = 0;
        while k < n {
            let s = self.streams.get(k) or __api_grpc_free();
            if s.state == 0 {
                self.streams.set(k, rec) or discard;
                return true;
            }
            k = k + 1;
        }
        if n >= 4096 { return false; }
        self.streams.push(rec);
        return true;
    }
    fn on_event(e: __StdIoH2Event) {
        if e.kind == 1 { self.opened(e); }
        if e.kind == 2 { self.chunk(e); }
        if e.kind == 3 { self.ended(e); }
        if e.kind == 4 || e.kind == 6 { self.gone(e.conn, e.stream); }
        if e.kind == 7 { self.drop_conn(e.conn); }
    }
    fn opened(e: __StdIoH2Event) {
        let rec = __StdApiGrpcStream { conn: e.conn, stream: e.stream, state: 1, over: false, headers: std::str::from_bytes(e.bytes), body: std::bytes::from_string("") };
        if self.put(rec) { return; }
        __ApiH2CmdT <- __StdIoH2Cmd { key: self.tid * 4294967296 + e.conn, kind: 1, stream: e.stream, code: 7, headers: __h2_none(), body: __h2_none(), trailers: __h2_none() };
    }
    // The body, to its end; one past the message limit it is dropped and
    // stands as a prefix that declares more than the limit, which `frame`
    // refuses.
    fn chunk(e: __StdIoH2Event) {
        let k = self.find(e.conn, e.stream);
        if k < 0 { return; }
        let s = self.streams.get(k) or __api_grpc_free();
        if s.state != 1 || s.over { return; }
        if len(s.body) + len(e.bytes) > __api_grpc_max() + 5 {
            if self.is_reflection(s) {
                // a reflection call ends at once, with its status
                let mut code = 0;
                if !s.sent { code = self.reflect_refusal(s); }
                if code == 0 { code = 8; }
                self.streams.set(k, __api_grpc_free()) or discard;
                self.reflect_end(s, code);
                return;
            }
            let huge = std::bytes::concat(std::bytes::from_int(0), std::bytes::concat(std::bytes::from_int(255), std::bytes::concat(std::bytes::from_int(255), std::bytes::concat(std::bytes::from_int(255), std::bytes::from_int(255)))));
            self.streams.set(k, __StdApiGrpcStream { conn: s.conn, stream: s.stream, state: 1, over: true, headers: s.headers, body: huge }) or discard;
            return;
        }
        self.streams.set(k, __StdApiGrpcStream { conn: s.conn, stream: s.stream, state: 1, over: false, sent: s.sent, headers: s.headers, body: std::bytes::concat(s.body, e.bytes) }) or discard;
        if self.is_reflection(s) { self.reflect_ready(k); }
    }
    // ---- server reflection (grpc.reflection.v1.ServerReflection) ----
    //
    // The service is bidirectional, and a client (grpcurl) waits for the
    // answer to a request before it ends its side of the stream, so a call is
    // answered as its messages are whole, not at the end of the stream: each
    // whole message gets its answer as a DATA frame, the call stays open and
    // the bytes of a message not yet whole are kept for the next chunk, and
    // the status goes out once, when the client ends its side (`ended`) or the
    // transport stops (`stop_listening`). The principal is the bearer the
    // exposure's source names, as for every call. What the service knows is
    // `files`, the descriptors the compiler wrote from the rows: the
    // surface's `.proto`, the reserved description method's and this
    // service's own.
    fn is_reflection(s: __StdApiGrpcStream) -> Bool {
        return std::str::starts_with(__api_grpc_header(s.headers, ":path"), "/grpc.reflection.v1.ServerReflection/");
    }
    // The status that refuses the call, 0 when it is allowed. The bearer is
    // asked again at every message, so a source that stops naming the caller
    // ends a call that is already answering.
    fn reflect_refusal(s: __StdApiGrpcStream) -> Int {
        let auth = __api_grpc_header(s.headers, "authorization");
        let mut token = "";
        if std::str::starts_with(auth, "Bearer ") { token = std::str::trim(auth[7..len(auth)]); }
        let who = self.principals.principal(token);
        if len(token) == 0 || len(who.name) == 0 { return 16; }
        let enc = __api_grpc_header(s.headers, "grpc-encoding");
        if enc != "" && enc != "identity" { return 12; }
        return 0;
    }
    fn reflect_why(code: Int) -> String {
        if code == 16 { return "the bearer token is refused"; }
        if code == 12 { return "compression is not supported: send grpc-encoding identity"; }
        if code == 8 { return "the request message is over the limit"; }
        if code == 13 { return "a request message ends before its length"; }
        return "";
    }
    // The one end of a reflection call, whatever ends it: a refusal, an
    // oversize or unfinished message, the client's half-close, the stop. A
    // call not yet answered has no response, so it ends as a trailers-only
    // response, the status in the headers; one that has answered has its
    // headers out and DATA flowing, so the status is the trailers of that
    // response, which then ends. The caller has freed the stream's slot.
    fn reflect_end(s: __StdApiGrpcStream, code: Int) {
        let mut status = "grpc-status: " + to_string(code) + "\n";
        let why = self.reflect_why(code);
        if len(why) > 0 { status = status + "grpc-message: " + __api_grpc_message(why) + "\n"; }
        let mut head = "";
        let mut trailers = status;
        if !s.sent {
            head = ":status: 200\ncontent-type: application/grpc\n" + status;
            trailers = "";
        }
        __ApiH2CmdT <- __StdIoH2Cmd { key: self.tid * 4294967296 + s.conn, kind: 0, stream: s.stream, code: 0, headers: std::bytes::from_string(head), body: __h2_none(), trailers: std::bytes::from_string(trailers) };
    }
    fn reflect_ready(k: Int) {
        let s = self.streams.get(k) or __api_grpc_free();
        if s.state != 1 || s.over || len(s.body) < 5 { return; }
        let no = self.reflect_refusal(s);
        if no != 0 {
            self.streams.set(k, __api_grpc_free()) or discard;
            self.reflect_end(s, no);
            return;
        }
        // every whole message, in order; the rest waits for its bytes
        let mut body = __h2_none();
        let mut at = 0;
        while at + 5 <= len(s.body) {
            let size = std::bytes::read_u32_be(s.body, at + 1) or 0;
            if at + 5 + size > len(s.body) { break; }
            body = std::bytes::concat(body, __api_grpc_frame(self.reflect_one(std::bytes::slice(s.body, at + 5, at + 5 + size))));
            at = at + 5 + size;
        }
        if at == 0 { return; }
        self.streams.set(k, __StdApiGrpcStream { conn: s.conn, stream: s.stream, state: 1, over: false, sent: true, headers: s.headers, body: std::bytes::slice(s.body, at, len(s.body)) }) or discard;
        let mut head = "";
        if !s.sent { head = ":status: 200\ncontent-type: application/grpc\n"; }
        // "+" leaves the response open for the next answer
        __ApiH2CmdT <- __StdIoH2Cmd { key: self.tid * 4294967296 + s.conn, kind: 0, stream: s.stream, code: 0, headers: std::bytes::from_string(head), body: body, trailers: std::bytes::from_string("+") };
    }
    // The client ended its side, or the transport stops: the status, after the
    // answers already sent. A message left unfinished is the client's error.
