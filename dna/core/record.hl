// dna/core/record.hl — the record's own API (GH #646 stage 0, #649).
//
// The record is the organism's evolutionary memory, and memory's (GH
// #1590): one chain of signed rows and content-addressed bodies. `Record`
// is the boundary the organism's readers and writers stand on, with a
// vocabulary that never names the store; `MemoryRecord`
// (`memory_record.hl`) is the implementation over Postgres and
// `MemRecord` the one for fixtures. The record's one chain only grows,
// through memory's insert functions: nothing builds a chain beside it,
// swaps it or moves it, and nothing of it travels to or from a remote.
// The genome's own git (`workspace.hl`,
// `verification.hl`, `org.hl`, the host's `genome.hl`) is the Structure,
// not the record.
//
// Vocabulary:
// - a CHAIN is an ordered list of rows under a name (`journal` is the
//   record). A row's id is its digest.
// - a BODY is text kept under the digest of its content (a receipt).

type Row {
    seq: Int = 0;
    kind: String = "";
    entity: String = "";
    body: String = "";
    author: String = "";
    id: String = ""; // the row's durable identity once appended ("" before)
}

// F.7: interface methods cannot be `fallible(E)`; results carry their failure.
type Appended {
    ok: Bool = false;
    id: String = "";
    error: String = ""; // "stale" (the chain moved past `at`) | "refused: <why>" (nothing landed) | "io: <why>" (it may have)
}

type Kept {
    present: Bool = false;
    text: String = "";
}

// A chain's head as read. `ok` when the read happened; then `absent`
// when the chain holds no row (`id` ""). A read that failed (memory
// unreachable for a moment) is `ok: false` with `why`, and is never an
// absent chain (GH #961).
type Head {
    ok: Bool = false;
    absent: Bool = false;
    id: String = "";
    why: String = "";
}

type Signer {
    signed: Bool = false; // the row carries a signature at all
    verified: Bool = false; // and the record's trust accepts it
    key: String = ""; // the verified key, "" when unverified
}

// Rows and receipt texts offered to the record together.
@form(vec)
locus RowBatch { capacity { heap rows of Row; } }

@form(vec)
locus Texts { capacity { heap rows of String; } }

interface Record {
    fn kind() -> String;
    // ---- the record itself
    fn is_repository() -> Bool;
    fn root() -> String;
    // The record's identity: its first row's id, the same in every clone.
    fn identity() -> String;
    // ---- chains
    fn head(chain: String) -> Head;
    fn count(chain: String) -> Int;
    // The rows at `id` as the record's own line format (one JSON object
    // per line, newline-terminated; "" for no id).
    fn text_at(id: String) -> String;
    // Every row id of the chain, oldest first, newline-terminated.
    fn ids(chain: String) -> String;
    // The row an id was appended as.
    fn row_of(id: String) -> Row;
    // The ids after `from` up to and including `to`, oldest first.
    fn between(from: String, to: String) -> String;
    fn precedes(a: String, b: String) -> Bool;
    // One row on top of `at`, moving `chain` there under compare-and-swap:
    // `stale` when the chain is no longer at `at` ("" = empty). `sign`
    // signs the row as this record's writer; `note` is kept with it.
    fn append(chain: String, at: String, row: Row, sign: Bool, note: String) -> Appended;
    // Many rows on top of `at`, made visible together: the same rows as
    // that many `append`s, every one or none (`refused`). `id` is the last
    // row's.
    fn append_batch(chain: String, at: String, rows: RowBatch, sign: Bool, note: String) -> Appended;
    // ---- bodies
    fn keep(text: String) -> String;
    // Every text kept as `keep` keeps it, in one pass.
    fn keep_batch(texts: Texts) -> Bool;
    fn body(digest: String) -> Kept;
    fn forget(digest: String) -> Bool;
    // ---- the genome's remote, its forge (`dna.remote`, else `origin`):
    // what revisions and candidates travel to and from. The record has none.
    fn remote() -> String;
    fn remote_url(name: String) -> String;
    // ---- provenance (#639)
    fn signer(id: String) -> Signer;
    // The key this record signs with, "" when it cannot sign.
    fn own_key() -> String;
    // ---- settings the record carries (`dna.*`)
    fn setting(name: String) -> String;
    fn set_setting(name: String, value: String) -> Bool;
    fn unset_setting(name: String) -> Bool;
    fn why() -> String;
}

// ---- admission, as a reader checks it (GH #1026) -------------------------

// Why the record's row `e` does not count, "" when it does. Admission is a
// property a reader checks on a row, not a gate a process grants: every
// reader runs this, and a row it refuses is never acted on — never
// projected into memory. Under `dna.trust = signed` a row counts only when
// its commit carries a signature the record's trust verifies (git's
// keyring or allowed-signers file is the list of who may act), so an
// unsigned row, or one signed with a key the record does not know, is
// refused. Under `local` trust every writer to the record is trusted. A
// Ledger row needs no reader's check: memory's insert function refused it
// before it landed.
fn row_admissible(r: Record, e: Event, trust: String) -> String {
    if trust != "signed" { return ""; }
    let s = r.signer(e.digest);
    if !s.signed { return "row " + to_string(e.seq) + " (" + e.kind + " " + e.entity + ") is not signed, and this record admits signed rows alone"; }
    if !s.verified { return "row " + to_string(e.seq) + " (" + e.kind + " " + e.entity + ") is signed with " + (if len(s.key) > 0 { "key " + s.key } else { "a key" }) + " this record's trust does not know"; }
    return "";
}

// ---- the line format ---------------------------------------------------

// A command contains its canonical payload inside a native event, itself
// inside a Record row. Quote that row linearly: repeated growing String
// prefixes exhaust the process budget for valid, heavily escaped payloads.
fn record_json_quote(value: String) -> String {
    let b = std::bytes::BytesBuilder { }; let digits = "0123456789abcdef";
    b.append_u8(34); let mut i = 0; let size = len(value);
    while i < size {
        let c = std::str::byte_at_unchecked(value, i);
        if c == 34 || c == 92 { b.append_u8(92); b.append_u8(c); }
        else if c == 8 { b.append_str("\\b"); }
        else if c == 12 { b.append_str("\\f"); }
        else if c == 10 { b.append_str("\\n"); }
        else if c == 13 { b.append_str("\\r"); }
        else if c == 9 { b.append_str("\\t"); }
        else if c < 32 {
            b.append_str("\\u00"); b.append_u8(std::str::byte_at_unchecked(digits, c / 16)); b.append_u8(std::str::byte_at_unchecked(digits, c % 16));
        } else { b.append_u8(c); }
        i = i + 1;
    }
    b.append_u8(34); return std::str::from_bytes(b.snapshot() or raise);
}
fn row_line(seq: Int, row: Row, author: String) -> String {
    let b = std::bytes::BytesBuilder { };
    b.append_str("{\"seq\": "); b.append_str(to_string(seq));
    b.append_str(", \"kind\": "); b.append_str(record_json_quote(row.kind));
    b.append_str(", \"entity\": "); b.append_str(record_json_quote(row.entity));
    b.append_str(", \"body\": "); b.append_str(record_json_quote(row.body));
    b.append_str(", \"author\": "); b.append_str(record_json_quote(author));
    b.append_str("}\n"); return std::str::from_bytes(b.snapshot() or raise);
}

fn parse_row(line: String, id: String) -> Row {
    return Row {
        seq: std::json::find_int_field(line, "seq"),
        kind: native_json_string(line, "kind"),
        entity: native_json_string(line, "entity"),
        body: native_json_string(line, "body"),
        author: native_json_string(line, "author"),
        id: id
    };
}

// The end of the line that starts at `from` in `v`: the index of its
// newline, or the text's end. Text that grows with the record (the journal,
// its shas) is walked by offset, never by re-slicing its tail: `rest =
// rest[(nl + 1)..len(rest)]` copies the whole remainder into the arena once
// per row, and the arena keeps every copy until the program ends (rows x
// size per scan: gigabytes for a record of a few thousand rows).
fn line_end(v: std::str::ByteView, from: Int) -> Int {
    let mut i = from;
    while i < v.n && std::str::byte_at(v, i) != 10 { i = i + 1; }
    return i;
}

// Whether the bytes `[at, end)` of `v` are all what `trim_nl` strips.
fn blank_span(v: std::str::ByteView, at: Int, end: Int) -> Bool {
    let mut j = at;
    while j < end {
        let b = std::str::byte_at(v, j);
        if b != 13 && b != 32 { return false; }
        j = j + 1;
    }
    return true;
}

// The last non-empty line of a text.
fn last_line(text: String) -> String {
    let v = std::str::bytes_view(text);
    let mut at = 0;
    let mut from = 0;
    let mut to = 0;
    while at < v.n {
        let end = line_end(v, at);
        if !blank_span(v, at, end) { from = at; to = end; }
        at = end + 1;
    }
    return std::str::slice(v, from, to);
}

// The non-empty lines of `text` from the offset `from` on.
fn lines_from(text: String, from: Int) -> Int {
    let v = std::str::bytes_view(text);
    let mut at = from;
    let mut n = 0;
    while at < v.n {
        let end = line_end(v, at);
        if end > at { n = n + 1; }
        at = end + 1;
    }
    return n;
}

fn count_lines(text: String) -> Int {
    let v = std::str::bytes_view(text);
    let mut at = 0;
    let mut n = 0;
    while at < v.n {
        let end = line_end(v, at);
        if !blank_span(v, at, end) { n = n + 1; }
        at = end + 1;
    }
    return n;
}

// The k-th line (0-based) of a newline-separated list, "" past the end.
fn line_at(list: String, k: Int) -> String {
    let v = std::str::bytes_view(list);
    let mut at = 0;
    let mut i = 0;
    while at < v.n {
        let end = line_end(v, at);
        if i == k { return std::str::slice(v, at, end); }
        i = i + 1;
        at = end + 1;
    }
    return "";
}

fn hex_digest(text: String) -> String {
    return hex(std::crypto::sha256(std::bytes::from_string(text)));
}

// ---- in memory -----------------------------------------------------------

type MemRow {
    chain: String = ""; // "" while built beside every chain
    parent: String = "";
    row: Row = Row { };
}

@form(vec)
locus MemRows {
    capacity { heap rows of MemRow; }
}

type MemBody { digest: String = ""; text: String = ""; }

@form(hashmap)
locus MemBodies {
    capacity { pool rows of MemBody indexed_by digest; }
}

type MemSetting { name: String = ""; value: String = ""; }

@form(hashmap)
locus MemSettings {
    capacity { pool rows of MemSetting indexed_by name; }
}

// The record in process: every row and body for the life of the process;
// there is no remote, and nothing is signed.
locus MemRecord {
    params {
        rows: MemRows = MemRows { };
        bodies: MemBodies = MemBodies { };
        settings: MemSettings = MemSettings { };
        next_id: Int = 1;
        last_error: String = "";
    }
    fn kind() -> String { return "memory"; }
    fn why() -> String { return self.last_error; }
    fn is_repository() -> Bool { return true; }
    fn root() -> String { return "."; }
    fn location() -> String { return ""; }
    fn identity() -> String { return self.first_id("journal"); }
    fn first_id(chain: String) -> String {
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.chain == chain { return r.row.id; }
            i = i + 1;
        }
        return "";
    }
    // The head is the last of the rows on `chain`.
    @bounded_by(self.rows)
    fn head(chain: String) -> Head {
        let mut last = "";
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.chain == chain { last = r.row.id; }
            i = i + 1;
        }
        return Head { ok: true, absent: len(last) == 0, id: last };
    }
    fn count(chain: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.chain == chain { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    // The chain an id belongs to ("" when unknown).
    fn chain_of(id: String) -> String {
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.row.id == id { return r.chain; }
            i = i + 1;
        }
        return "";
    }
    // The rows from the first up to and including `id`, following parents.
    fn text_at(id: String) -> String {
        if len(id) == 0 { return ""; }
        let mut out = "";
        let mut cur = id;
        while len(cur) > 0 {
            let r = self.row_at(cur);
            if len(r.row.id) == 0 { break; }
            out = row_line(r.row.seq, r.row, r.row.author) + out;
            cur = r.parent;
        }
        return out;
    }
    fn ids(chain: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.chain == chain { out = out + r.row.id + "\n"; }
            i = i + 1;
        }
        return out;
    }
    fn row_of(id: String) -> Row {
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.row.id == id { return r.row; }
            i = i + 1;
        }
        return Row { };
    }
    fn between(from: String, to: String) -> String {
        let chain = self.chain_of(to);
        let mut out = "";
        let mut after = len(from) == 0;
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.chain == chain {
                if after { out = out + r.row.id + "\n"; }
                if r.row.id == from { after = true; }
                if r.row.id == to { return out; }
            }
            i = i + 1;
        }
        return out;
    }
    fn precedes(a: String, b: String) -> Bool {
        if a == b { return true; }
        let ids = self.ids(self.chain_of(b));
        let ia = std::str::index_of(ids, a);
        let ib = std::str::index_of(ids, b);
        return ia >= 0 && ib >= 0 && ia < ib;
    }
    fn append(chain: String, at: String, row: Row, sign: Bool, note: String) -> Appended {
        if self.head(chain).id != at { return Appended { error: "stale" }; }
        let id = "mem" + to_string(self.next_id);
        self.next_id = self.next_id + 1;
        let author = if len(row.author) > 0 { row.author } else { "host" };
        self.rows.push(MemRow { chain: chain, parent: at, row: Row { seq: self.count(chain), kind: row.kind, entity: row.entity, body: row.body, author: author, id: id } });
        return Appended { ok: true, id: id };
    }
    fn append_batch(chain: String, at: String, rows: RowBatch, sign: Bool, note: String) -> Appended {
        let mut cur = at;
        let mut i = 0;
        while i < rows.len() {
            let a = self.append(chain, cur, rows.get(i) or Row { }, sign, note);
            if !a.ok { return a; }
            cur = a.id;
            i = i + 1;
        }
        return Appended { ok: true, id: cur };
    }
    fn keep_batch(texts: Texts) -> Bool {
        let mut i = 0;
        while i < texts.len() {
            let d = self.keep(texts.get(i) or "");
            i = i + 1;
        }
        return true;
    }
    // The number of rows from the first up to and including `id` on its
    // chain, following parents: the seq a built row gets.
    fn depth(id: String) -> Int {
        let mut n = 0;
        let mut cur = id;
        while len(cur) > 0 {
            n = n + 1;
            let mut i = 0;
            let mut parent = "";
            while i < self.rows.len() {
                let r = self.rows.get(i) or MemRow { };
                if r.row.id == cur { parent = r.parent; }
                i = i + 1;
            }
            cur = parent;
        }
        return n;
    }
    fn row_at(id: String) -> MemRow {
        let mut i = 0;
        while i < self.rows.len() {
            let r = self.rows.get(i) or MemRow { };
            if r.row.id == id { return r; }
            i = i + 1;
        }
        return MemRow { };
    }
    fn keep(text: String) -> String {
        let digest = hex_digest(text);
        self.bodies.set(MemBody { digest: digest, text: text });
        return digest;
    }
    fn body(digest: String) -> Kept {
        let b = self.bodies.get(digest) or MemBody { };
        return Kept { present: len(b.digest) > 0, text: b.text };
    }
    fn forget(digest: String) -> Bool {
        self.bodies.remove(digest) or discard;
        return true;
    }
    fn remote() -> String { return ""; }
    fn remote_url(name: String) -> String { return ""; }
    fn signer(id: String) -> Signer { return Signer { }; }
    fn own_key() -> String { return ""; }
    fn setting(name: String) -> String {
        let s = self.settings.get(name) or MemSetting { };
        return s.value;
    }
    fn set_setting(name: String, value: String) -> Bool {
        self.settings.set(MemSetting { name: name, value: value });
        return true;
    }
    fn unset_setting(name: String) -> Bool {
        self.settings.remove(name) or discard;
        return true;
    }
}

// ---- the genome's fetches ---------------------------------------------------

// A fetch that lost a ref's lock to another fetch is tried again this
// many times in all, waiting FETCH_RETRY longer before each (GH #1072).
const FETCH_TRIES: Int = 5;
const FETCH_RETRY: Duration = 100ms;

// Whether a fetch failed only because another process held, or moved, a
// ref it was updating: `cannot lock ref '…': is at X but expected Y`,
// or `…: Unable to create '….lock': File exists`.
fn lost_ref_lock(stderr: String) -> Bool { return std::str::contains(stderr, "cannot lock ref"); }
// The wait before a fetch's `tries`+1-th try.
fn fetch_backoff(tries: Int) { std::time::sleep(FETCH_RETRY * tries); }
