// dna/knowledge — the knowledge graph as a service (GH #583 K1).
//
// The record holds the decided half: every ratified idea is a
// `knowledge.ratified` row naming a receipt. This library holds the
// live, queryable, shared half: a `KnowledgeStore` that a service
// (service/) applies the record's rows into and answers from. `Pq` is
// Postgres through pond's driver; `Mem` is the same contract in
// memory, for tests and for a laptop with nothing. Nothing here lives
// on the local filesystem.

import "../core" as dna;
import "../pond/db" as db;
import "../pond/pq" as pq;

// ---- the store ----------------------------------------------------------

interface KnowledgeStore {
    fn kind() -> String;
    // Migrate and connect; false with `last_error` set when it cannot.
    fn open() -> Bool;
    fn last_error() -> String;
    // The next record seq to apply (0 = nothing applied yet).
    fn watermark() -> Int;
    fn set_watermark(seq: Int) -> Bool;
    // Idempotent by id: a second write with the same id updates in place.
    fn upsert(i: dna::Idea, ratified_seq: Int) -> Bool;
    fn bind(b: dna::KnowledgeBinding) -> Bool;
    fn link(e: dna::KnowledgeEdge) -> Bool;
    // One idea by id (`present` false when absent).
    fn idea(id: String) -> Stored;
    // Ids of accepted ideas bound to `target` or any of its ancestors
    // (goals flow down), space-separated, at most `budget`, in
    // ratification order.
    fn context_ids(target: String, budget: Int) -> String;
    // The same bounded set, ranked by similarity to `query_vec` (an
    // `embed_text` literal) so the budget keeps the most relevant;
    // an empty literal is `context_ids` (GH #583 K3).
    fn ranked_ids(target: String, budget: Int, query_vec: String) -> String;
    // "ideas" | "ratified" | "proposed" | "bindings" | "edges"
    fn count(what: String) -> Int;
    // ---- projections (K3): the code's structure by record row, and the
    // operational signals, so the graph has what ideas bind to and what
    // the fleet is saying ----
    fn put_structure(kind: String, name: String, seq: Int, body: String) -> Bool;
    fn structure_count(kind: String) -> Int; // "" = every kind
    fn structure_names(kind: String) -> String; // space-separated
    // one row per (kind, source, what): the count and the last record row
    fn put_signal(kind: String, source: String, what: String, seq: Int) -> Bool;
    fn signals() -> String; // a JSON array of {kind, source, what, count, last_seq}
}

type Signal { kind: String = ""; source: String = ""; what: String = ""; count: Int = 0; last_seq: Int = 0; }
type Structure { kind: String = ""; name: String = ""; seq: Int = 0; }

fn signal_json(x: Signal) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("kind", x.kind);
    b.string_field("source", x.source);
    b.string_field("what", x.what);
    b.int_field("count", x.count);
    b.int_field("last_seq", x.last_seq);
    b.end_object();
    return b.result();
}

type Stored {
    present: Bool = false;
    idea: dna::Idea = dna::Idea { };
    ratified_seq: Int = 0;
}

// ---- in memory ----------------------------------------------------------

@form(vec)
locus IdeaRows { capacity { heap rows of dna::Idea; } }
@form(vec)
locus SeqRows { capacity { heap rows of Int; } }
@form(vec)
locus BindingRows { capacity { heap rows of dna::KnowledgeBinding; } }
@form(vec)
locus EdgeRows { capacity { heap rows of dna::KnowledgeEdge; } }
@form(vec)
locus SignalRows { capacity { heap rows of Signal; } }
@form(vec)
locus StructureRows { capacity { heap rows of Structure; } }

locus Mem {
    params {
        ideas: IdeaRows = IdeaRows { };
        seqs: SeqRows = SeqRows { };
        embeds: Words = Words { }; // one literal per idea, in step with `ideas`
        bindings: BindingRows = BindingRows { };
        edges: EdgeRows = EdgeRows { };
        signal_rows: SignalRows = SignalRows { };
        structure: StructureRows = StructureRows { };
        mark: Int = 0;
    }
    fn kind() -> String { return "memory"; }
    fn open() -> Bool { return true; }
    fn last_error() -> String { return ""; }
    fn watermark() -> Int { return self.mark; }
    fn set_watermark(seq: Int) -> Bool { if seq > self.mark { self.mark = seq; } return true; }
    @unbounded
    fn index_of(id: String) -> Int {
        let mut i = 0;
        while i < self.ideas.len() {
            let x = self.ideas.get(i) or dna::Idea { };
            if x.id == id { return i; }
            i = i + 1;
        }
        return -1;
    }
    fn upsert(i: dna::Idea, ratified_seq: Int) -> Bool {
        let at = self.index_of(i.id);
        if at < 0 {
            self.ideas.push(dna::Idea { id: i.id, kind: i.kind, text: i.text, author: i.author, provenance: i.provenance, revision: i.revision, accepted: i.accepted });
            self.seqs.push(ratified_seq);
            self.embeds.push(embed_text(i.text));
            return true;
        }
        self.ideas.set(at, dna::Idea { id: i.id, kind: i.kind, text: i.text, author: i.author, provenance: i.provenance, revision: i.revision, accepted: i.accepted }) or discard;
        self.seqs.set(at, ratified_seq) or discard;
        self.embeds.set(at, embed_text(i.text)) or discard;
        return true;
    }
    @unbounded
    fn bind(b: dna::KnowledgeBinding) -> Bool {
        let mut i = 0;
        while i < self.bindings.len() {
            let x = self.bindings.get(i) or dna::KnowledgeBinding { };
            if x.idea == b.idea && x.target == b.target && x.author == b.author { return true; }
            i = i + 1;
        }
        self.bindings.push(dna::KnowledgeBinding { idea: b.idea, target: b.target, author: b.author, class: b.class });
        return true;
    }
    @unbounded
    fn link(e: dna::KnowledgeEdge) -> Bool {
        let mut i = 0;
        while i < self.edges.len() {
            let x = self.edges.get(i) or dna::KnowledgeEdge { };
            if x.from == e.from && x.to == e.to && x.rel == e.rel { return true; }
            i = i + 1;
        }
        self.edges.push(dna::KnowledgeEdge { from: e.from, to: e.to, rel: e.rel });
        return true;
    }
    fn idea(id: String) -> Stored {
        let at = self.index_of(id);
        if at < 0 { return Stored { }; }
        return Stored { present: true, idea: self.ideas.get(at) or dna::Idea { }, ratified_seq: self.seqs.get(at) or 0 };
    }
    @unbounded
    fn context_ids(target: String, budget: Int) -> String {
        let mut out = "";
        let mut n = 0;
        let mut i = 0;
        while i < self.bindings.len() && n < budget {
            let b = self.bindings.get(i) or dna::KnowledgeBinding { };
            i = i + 1;
            if !(b.target == target || dna::is_ancestor(b.target, target)) { continue; }
            if std::str::contains(out, b.idea + " ") { continue; }
            let s = self.idea(b.idea);
            if !s.present || !s.idea.accepted { continue; }
            out = out + b.idea + " ";
            n = n + 1;
        }
        return dna::trim_nl(out);
    }
    // The bounded set as `context_ids` finds it, then the `budget` most
    // similar to the query, by selection (the set is small by design).
    @unbounded
    fn ranked_ids(target: String, budget: Int, query_vec: String) -> String {
        if len(query_vec) == 0 { return self.context_ids(target, budget); }
        let all = self.context_ids(target, 1000000);
        let mut picked = "";
        let mut n = 0;
        while n < budget {
            let mut best = "";
            let mut best_score = 0.0 - 2.0;
            let mut rest = all + " ";
            while len(rest) > 1 {
                let sp = std::str::index_of(rest, " ");
                let id = rest[0..sp];
                rest = rest[(sp + 1)..len(rest)];
                if len(id) == 0 || std::str::contains(picked + " ", " " + id + " ") { continue; }
                let at = self.index_of(id);
                let score = cosine(self.embeds.get(at) or "", query_vec);
                if score > best_score { best_score = score; best = id; }
            }
            if len(best) == 0 { break; }
            picked = picked + " " + best;
            n = n + 1;
        }
        return dna::trim_nl(if len(picked) > 0 { picked[1..len(picked)] } else { "" });
    }
    @unbounded
    fn put_structure(kind: String, name: String, seq: Int, body: String) -> Bool {
        let mut i = 0;
        while i < self.structure.len() {
            let x = self.structure.get(i) or Structure { };
            if x.kind == kind && x.name == name { self.structure.set(i, Structure { kind: kind, name: name, seq: seq }) or discard; return true; }
            i = i + 1;
        }
        self.structure.push(Structure { kind: kind, name: name, seq: seq });
        return true;
    }
    @unbounded
    fn structure_count(kind: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.structure.len() {
            let x = self.structure.get(i) or Structure { };
            if len(kind) == 0 || x.kind == kind { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn structure_names(kind: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.structure.len() {
            let x = self.structure.get(i) or Structure { };
            if len(kind) == 0 || x.kind == kind { out = out + x.name + " "; }
            i = i + 1;
        }
        return dna::trim_nl(out);
    }
    @unbounded
    fn put_signal(kind: String, source: String, what: String, seq: Int) -> Bool {
        let mut i = 0;
        while i < self.signal_rows.len() {
            let x = self.signal_rows.get(i) or Signal { };
            if x.kind == kind && x.source == source && x.what == what {
                self.signal_rows.set(i, Signal { kind: kind, source: source, what: what, count: x.count + 1, last_seq: seq }) or discard;
                return true;
            }
            i = i + 1;
        }
        self.signal_rows.push(Signal { kind: kind, source: source, what: what, count: 1, last_seq: seq });
        return true;
    }
    @unbounded
    fn signals() -> String {
        let out = std::str::builder_new();
        std::str::builder_append(out, "[");
        let mut i = 0;
        while i < self.signal_rows.len() {
            if i > 0 { std::str::builder_append(out, ", "); }
            std::str::builder_append(out, signal_json(self.signal_rows.get(i) or Signal { }));
            i = i + 1;
        }
        std::str::builder_append(out, "]");
        return std::str::builder_finish(out);
    }
    @unbounded
    fn count(what: String) -> Int {
        if what == "bindings" { return self.bindings.len(); }
        if what == "edges" { return self.edges.len(); }
        if what == "ideas" { return self.ideas.len(); }
        let mut n = 0;
        let mut i = 0;
        while i < self.ideas.len() {
            let x = self.ideas.get(i) or dna::Idea { };
            if (what == "ratified" && x.accepted) || (what == "proposed" && x.provenance == "proposed") { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
}

// ---- Postgres -----------------------------------------------------------
//
// One connection, the schema migrated at open. Every write is an upsert
// keyed by the idea's digest, so applying the record twice converges.

fn tab_field(line: String, n: Int) -> String {
    let mut rest = line;
    let mut k = 0;
    while true {
        let t = std::str::index_of(rest, "\t");
        let f = if t < 0 { rest } else { rest[0..t] };
        if k == n { return f; }
        if t < 0 { return ""; }
        rest = rest[(t + 1)..len(rest)];
        k = k + 1;
    }
    return "";
}

// The first column of every row, space-separated.
@unbounded
fn ids_of(csv: String) -> String {
    let mut out = "";
    let mut rest = csv;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
        let id = tab_field(line, 0);
        if len(id) > 0 { out = out + id + " "; }
    }
    return dna::trim_nl(out);
}

fn first_line(s: String) -> String {
    let nl = std::str::index_of(s, "\n");
    return if nl < 0 { s } else { s[0..nl] };
}

locus Pq {
    params {
        conn: pq::PgConn = pq::PgConn { sslmode: "prefer" };
        opened: Bool = false;
        error: String = "";
    }
    fn kind() -> String { return "postgres"; }
    fn fail(what: String, e: db::DbError) -> Bool {
        self.error = what + ": " + e.kind + " " + e.detail;
        return false;
    }
    fn open() -> Bool {
        if self.opened { return true; }
        let st = self.conn.open();
        if !st.ok { return self.fail("open", st.err); }
        // pgvector ranks inside the bound (K3); the extension ships with the
        // image compose and CI use, and a Postgres without it says so here
        let ext = self.conn.exec("CREATE EXTENSION IF NOT EXISTS vector");
        if !ext.ok { return self.fail("pgvector (CREATE EXTENSION vector)", ext.err); }
        let ddl = "CREATE TABLE IF NOT EXISTS knowledge_meta (key text PRIMARY KEY, value text NOT NULL);"
            + "CREATE TABLE IF NOT EXISTS knowledge_ideas (id text PRIMARY KEY, kind text NOT NULL, text text NOT NULL, author text NOT NULL, provenance text NOT NULL, revision bigint NOT NULL DEFAULT 0, accepted boolean NOT NULL DEFAULT false, ratified_seq bigint NOT NULL DEFAULT 0, embedding vector(" + to_string(DIM) + "));"
            + "ALTER TABLE knowledge_ideas ADD COLUMN IF NOT EXISTS embedding vector(" + to_string(DIM) + ");"
            + "CREATE TABLE IF NOT EXISTS knowledge_bindings (idea text NOT NULL, target text NOT NULL, author text NOT NULL, class text NOT NULL, PRIMARY KEY (idea, target, author));"
            + "CREATE TABLE IF NOT EXISTS knowledge_edges (src text NOT NULL, dst text NOT NULL, rel text NOT NULL, PRIMARY KEY (src, dst, rel));"
            + "CREATE TABLE IF NOT EXISTS knowledge_structure (kind text NOT NULL, name text NOT NULL, seq bigint NOT NULL, body text NOT NULL, PRIMARY KEY (kind, name));"
            + "CREATE TABLE IF NOT EXISTS knowledge_signals (kind text NOT NULL, source text NOT NULL, what text NOT NULL, count bigint NOT NULL DEFAULT 0, last_seq bigint NOT NULL DEFAULT 0, PRIMARY KEY (kind, source, what));";
        let r = self.conn.exec(ddl);
        if !r.ok { return self.fail("migrate", r.err); }
        self.opened = true;
        return true;
    }
    fn last_error() -> String { return self.error; }
    fn watermark() -> Int {
        let row = self.conn.query_one("SELECT value FROM knowledge_meta WHERE key = 'watermark'");
        if !row.ok { return 0; }
        return std::str::parse_int(dna::trim_nl(row.data)) or 0;
    }
    fn set_watermark(seq: Int) -> Bool {
        let a = db::Args { };
        a.add(to_string(seq));
        let r = self.conn.exec_params("INSERT INTO knowledge_meta (key, value) VALUES ('watermark', $1) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value WHERE EXCLUDED.value::bigint > knowledge_meta.value::bigint", a);
        if !r.ok { return self.fail("watermark", r.err); }
        return true;
    }
    fn upsert(i: dna::Idea, ratified_seq: Int) -> Bool {
        let a = db::Args { };
        a.add(i.id);
        a.add(i.kind);
        a.add(i.text);
        a.add(i.author);
        a.add(i.provenance);
        a.add(to_string(i.revision));
        a.add(if i.accepted { "true" } else { "false" });
        a.add(to_string(ratified_seq));
        a.add(embed_text(i.text));
        let r = self.conn.exec_params("INSERT INTO knowledge_ideas (id, kind, text, author, provenance, revision, accepted, ratified_seq, embedding) VALUES ($1, $2, $3, $4, $5, $6::bigint, $7::boolean, $8::bigint, $9::vector) ON CONFLICT (id) DO UPDATE SET kind = EXCLUDED.kind, text = EXCLUDED.text, author = EXCLUDED.author, provenance = EXCLUDED.provenance, revision = EXCLUDED.revision, accepted = EXCLUDED.accepted, ratified_seq = EXCLUDED.ratified_seq, embedding = EXCLUDED.embedding", a);
        if !r.ok { return self.fail("upsert", r.err); }
        return true;
    }
    fn bind(b: dna::KnowledgeBinding) -> Bool {
        let a = db::Args { };
        a.add(b.idea);
        a.add(b.target);
        a.add(b.author);
        a.add(b.class);
        let r = self.conn.exec_params("INSERT INTO knowledge_bindings (idea, target, author, class) VALUES ($1, $2, $3, $4) ON CONFLICT (idea, target, author) DO UPDATE SET class = EXCLUDED.class", a);
        if !r.ok { return self.fail("bind", r.err); }
        return true;
    }
    fn link(e: dna::KnowledgeEdge) -> Bool {
        let a = db::Args { };
        a.add(e.from);
        a.add(e.to);
        a.add(e.rel);
        let r = self.conn.exec_params("INSERT INTO knowledge_edges (src, dst, rel) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", a);
        if !r.ok { return self.fail("link", r.err); }
        return true;
    }
    fn idea(id: String) -> Stored {
        let a = db::Args { };
        a.add(id);
        let rows = self.conn.query_params("SELECT id, kind, text, author, provenance, revision, accepted, ratified_seq FROM knowledge_ideas WHERE id = $1", a);
        if !rows.ok || rows.n == 0 { return Stored { }; }
        let line = first_line(rows.csv);
        return Stored {
            present: true,
            idea: dna::Idea {
                id: tab_field(line, 0), kind: tab_field(line, 1), text: tab_field(line, 2), author: tab_field(line, 3),
                provenance: tab_field(line, 4), revision: std::str::parse_int(tab_field(line, 5)) or 0,
                accepted: tab_field(line, 6) == "t" || tab_field(line, 6) == "true"
            },
            ratified_seq: std::str::parse_int(tab_field(line, 7)) or 0
        };
    }
    // The tower rule in one query: bound to the target, or to any prefix
    // of its path; goals flow down, initiatives stay local.
    @unbounded
    fn context_ids(target: String, budget: Int) -> String {
        let a = db::Args { };
        a.add(target);
        a.add(to_string(budget));
        let rows = self.conn.query_params("SELECT i.id FROM knowledge_ideas i WHERE i.accepted AND EXISTS (SELECT 1 FROM knowledge_bindings b WHERE b.idea = i.id AND ($1 = b.target OR $1 LIKE b.target || '/%')) ORDER BY i.ratified_seq, i.id LIMIT $2::bigint", a);
        if !rows.ok { return ""; }
        return ids_of(rows.csv);
    }
    // The same bound, ranked by pgvector's cosine distance to the query.
    fn ranked_ids(target: String, budget: Int, query_vec: String) -> String {
        if len(query_vec) == 0 { return self.context_ids(target, budget); }
        let a = db::Args { };
        a.add(target);
        a.add(query_vec);
        a.add(to_string(budget));
        let rows = self.conn.query_params("SELECT i.id FROM knowledge_ideas i WHERE i.accepted AND EXISTS (SELECT 1 FROM knowledge_bindings b WHERE b.idea = i.id AND ($1 = b.target OR $1 LIKE b.target || '/%')) ORDER BY i.embedding <=> $2::vector, i.ratified_seq, i.id LIMIT $3::bigint", a);
        if !rows.ok { self.error = "ranked: " + rows.err.kind + " " + rows.err.detail; return ""; }
        return ids_of(rows.csv);
    }
    fn put_structure(kind: String, name: String, seq: Int, body: String) -> Bool {
        let a = db::Args { };
        a.add(kind);
        a.add(name);
        a.add(to_string(seq));
        a.add(body);
        let r = self.conn.exec_params("INSERT INTO knowledge_structure (kind, name, seq, body) VALUES ($1, $2, $3::bigint, $4) ON CONFLICT (kind, name) DO UPDATE SET seq = EXCLUDED.seq, body = EXCLUDED.body", a);
        if !r.ok { return self.fail("structure", r.err); }
        return true;
    }
    fn structure_count(kind: String) -> Int {
        let a = db::Args { };
        a.add(kind);
        let rows = self.conn.query_params("SELECT count(*) FROM knowledge_structure WHERE $1 = '' OR kind = $1", a);
        if !rows.ok { return 0; }
        return std::str::parse_int(dna::trim_nl(first_line(rows.csv))) or 0;
    }
    fn structure_names(kind: String) -> String {
        let a = db::Args { };
        a.add(kind);
        let rows = self.conn.query_params("SELECT name FROM knowledge_structure WHERE $1 = '' OR kind = $1 ORDER BY seq, name", a);
        if !rows.ok { return ""; }
        return ids_of(rows.csv);
    }
    fn put_signal(kind: String, source: String, what: String, seq: Int) -> Bool {
        let a = db::Args { };
        a.add(kind);
        a.add(source);
        a.add(what);
        a.add(to_string(seq));
        let r = self.conn.exec_params("INSERT INTO knowledge_signals (kind, source, what, count, last_seq) VALUES ($1, $2, $3, 1, $4::bigint) ON CONFLICT (kind, source, what) DO UPDATE SET count = knowledge_signals.count + 1, last_seq = EXCLUDED.last_seq", a);
        if !r.ok { return self.fail("signal", r.err); }
        return true;
    }
    @unbounded
    fn signals() -> String {
        let rows = self.conn.query_all("SELECT kind, source, what, count, last_seq FROM knowledge_signals ORDER BY last_seq DESC, source");
        let out = std::str::builder_new();
        std::str::builder_append(out, "[");
        if rows.ok {
            let mut rest = rows.csv;
            let mut first = true;
            while len(rest) > 0 {
                let nl = std::str::index_of(rest, "\n");
                let line = if nl < 0 { rest } else { rest[0..nl] };
                if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
                if len(line) == 0 { continue; }
                if !first { std::str::builder_append(out, ", "); }
                first = false;
                std::str::builder_append(out, signal_json(Signal {
                    kind: tab_field(line, 0), source: tab_field(line, 1), what: tab_field(line, 2),
                    count: std::str::parse_int(tab_field(line, 3)) or 0, last_seq: std::str::parse_int(tab_field(line, 4)) or 0
                }));
            }
        }
        std::str::builder_append(out, "]");
        return std::str::builder_finish(out);
    }
    fn count(what: String) -> Int {
        let sql = if what == "bindings" { "SELECT count(*) FROM knowledge_bindings" }
        else if what == "edges" { "SELECT count(*) FROM knowledge_edges" }
        else if what == "ratified" { "SELECT count(*) FROM knowledge_ideas WHERE accepted" }
        else if what == "proposed" { "SELECT count(*) FROM knowledge_ideas WHERE provenance = 'proposed'" }
        else { "SELECT count(*) FROM knowledge_ideas" };
        let row = self.conn.query_one(sql);
        if !row.ok { return 0; }
        return std::str::parse_int(dna::trim_nl(row.data)) or 0;
    }
}

// ---- the DSN ------------------------------------------------------------
//
// `postgres://user:password@host:port/database?sslmode=…`, the shape
// every tool prints. The password never leaves the connection's params.

type Dsn {
    ok: Bool = false;
    user: String = "postgres";
    password: String = "";
    host: String = "127.0.0.1";
    port: Int = 5432;
    database: String = "postgres";
    sslmode: String = "prefer";
    why: String = "";
}

fn parse_dsn(s: String) -> Dsn {
    let mut rest = s;
    if std::str::starts_with(rest, "postgresql://") { rest = rest[13..len(rest)]; }
    else if std::str::starts_with(rest, "postgres://") { rest = rest[11..len(rest)]; }
    else { return Dsn { why: "not a postgres:// URL" }; }
    let mut d = Dsn { ok: true };
    let q = std::str::index_of(rest, "?");
    if q >= 0 {
        let query = rest[(q + 1)..len(rest)];
        rest = rest[0..q];
        let m = std::str::index_of(query, "sslmode=");
        if m >= 0 {
            let v = query[(m + 8)..len(query)];
            let amp = std::str::index_of(v, "&");
            d.sslmode = if amp < 0 { v } else { v[0..amp] };
        }
    }
    let at = std::str::index_of(rest, "@");
    if at >= 0 {
        let cred = rest[0..at];
        rest = rest[(at + 1)..len(rest)];
        let colon = std::str::index_of(cred, ":");
        if colon < 0 { d.user = cred; } else { d.user = cred[0..colon]; d.password = cred[(colon + 1)..len(cred)]; }
    }
    let slash = std::str::index_of(rest, "/");
    let hostport = if slash < 0 { rest } else { rest[0..slash] };
    if slash >= 0 && slash + 1 < len(rest) { d.database = rest[(slash + 1)..len(rest)]; }
    let pc = std::str::index_of(hostport, ":");
    if pc < 0 { d.host = hostport; } else { d.host = hostport[0..pc]; d.port = std::str::parse_int(hostport[(pc + 1)..len(hostport)]) or 5432; }
    if len(d.host) == 0 { d.host = "127.0.0.1"; }
    return d;
}

// The connection a DSN names; a `Pq` is built around it in place
// (`Pq { conn: pq_conn(d) }`), since a locus is structure, not a
// value a factory hands back into a field.
fn pq_conn(d: Dsn) -> pq::PgConn {
    return pq::PgConn { host: d.host, port: d.port, user: d.user, password: d.password, database: d.database, sslmode: d.sslmode };
}
