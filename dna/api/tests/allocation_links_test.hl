// dna/api/tests/allocation_links_test.hl — the operator face's links to
// what an organism's services publish (`allocation_links_at`), and the apply
// they are read from (`habitat_latest_applied`).
//
// A port bound to another host's loopback is linked at this machine's
// loopback only when that host and the habitat are both this machine: a
// remote habitat's head resolving a host to the loopback says nothing of
// the person's browser, so the port keeps its note, and that host's
// wildcard ports are linked at the habitat's declared address. What a services
// allocation publishes is its last successful apply's: an apply or a
// withdrawal that failed leaves it, one that took and publishes nothing
// replaces it.
import ".." as api;
import "../../core" as dna;

fn applied(j: dna::MemJournal, entity: String, body: String) {
    std::test::assert(j.append(j.revision(), "habitat.applied", entity, body).ok, "row landed");
}

fn main() {
    let published = "[{\"service\":\"api\",\"port\":\"8080\",\"bind\":\"\"},{\"service\":\"admin\",\"port\":\"9090\",\"bind\":\"127.0.0.1\"}]";

    // a local habitat: no declared address, or the loopback
    std::test::assert(api::habitat_is_local(""), "no declared address is local");
    std::test::assert(api::habitat_is_local("127.0.0.1"), "the loopback is local");
    std::test::assert(!api::habitat_is_local("rack-a.lan"), "a declared host is remote");
    std::test::assert(api::publishes_loopback(published), "admin is on the loopback");

    // the host is this machine and so is the habitat: the loopback is linked
    std::test::assert_eq_str(
        api::allocation_links_at(published, "localhost", false, "localhost", true, ""),
        "[{\"service\": \"api\", \"url\": \"http://localhost:8080\", \"note\": \"\"}, {\"service\": \"admin\", \"url\": \"http://127.0.0.1:9090\", \"note\": \"\"}]",
        "colocated host and habitat",
    );
    // a remote habitat (`up --host rack-a`) with a host whose listen address
    // is the loopback there: the host is the habitat's machine, which the
    // browser reaches at the declared address, never at its loopback
    std::test::assert_eq_str(
        api::allocation_links_at(published, "localhost", false, "localhost", true, "rack-a.lan"),
        "[{\"service\": \"api\", \"url\": \"http://rack-a.lan:8080\", \"note\": \"\"}, {\"service\": \"admin\", \"url\": \"\", \"note\": \"loopback only on localhost\"}]",
        "a remote habitat links its own machine at its declared address",
    );
    // the remote habitat's own `local` host alike
    std::test::assert_eq_str(
        api::allocation_links_at(published, "local", true, "127.0.0.1", true, "rack-a.lan"),
        "[{\"service\": \"api\", \"url\": \"http://rack-a.lan:8080\", \"note\": \"\"}, {\"service\": \"admin\", \"url\": \"\", \"note\": \"loopback only on local\"}]",
        "a remote habitat's local host is reached at its declared address",
    );
    // another host under a remote habitat: at the host's own address
    std::test::assert_eq_str(
        api::allocation_links_at(published, "rack-b.lan", false, "rack-b.lan", false, "rack-a.lan"),
        "[{\"service\": \"api\", \"url\": \"http://rack-b.lan:8080\", \"note\": \"\"}, {\"service\": \"admin\", \"url\": \"\", \"note\": \"loopback only on rack-b.lan\"}]",
        "another host is linked at its address",
    );
    // this machine under a local habitat
    std::test::assert_eq_str(
        api::allocation_links_at(published, "local", true, "127.0.0.1", true, ""),
        "[{\"service\": \"api\", \"url\": \"http://127.0.0.1:8080\", \"note\": \"\"}, {\"service\": \"admin\", \"url\": \"http://127.0.0.1:9090\", \"note\": \"\"}]",
        "a local habitat's local host links its loopback",
    );

    // the last successful apply is the one read; a failure never replaces it
    let j = dna::MemJournal { };
    applied(
        j,
        "shop/services",
        "{\"host\":\"rack-b.lan\",\"ok\":true,\"published\":" + published + "}",
    );
    applied(
        j,
        "shop/services",
        "{\"host\":\"rack-b.lan\",\"ok\":false,\"why\":\"withdraw failed\"}",
    );
    let kept = api::habitat_latest_applied(j).get("shop/services") or api::LatestRow { };
    std::test::assert_eq_int(kept.at, 0, "a failed apply leaves the last that took");
    applied(j, "shop/services", "{\"host\":\"rack-b.lan\",\"ok\":true,\"published\":[]}");
    applied(j, "shop/services", "{\"host\":\"rack-b.lan\",\"ok\":false,\"why\":\"apply failed\"}");
    let empty = api::habitat_latest_applied(j).get("shop/services") or api::LatestRow { };
    std::test::assert_eq_int(empty.at, 2, "a successful empty publication replaces it");
    std::test::assert_eq_str(
        std::json::find_field_raw(j.read(empty.at).body, "published"),
        "[]",
        "and publishes nothing",
    );
}
