// GH #1129 (the macOS red of head_roles_test): replies that overfill
// the socket's send buffer reach the client whole.
//
// The binding's peer shares one socket between two coroutines of its
// async_io pool: run() sits parked on the fd for the next request line
// while a reply handler writes the answer. The poller holds one
// registration per fd, so the writer could not park on EAGAIN — on
// Linux the second registration was refused and the write gave up with
// the rest of the reply unsent (the next reply then followed the
// fragment on the wire); on macOS it was taken, and the first resume
// deregistered both, orphaning the other coroutine. Linux only showed
// it past its 208 KB buffer, macOS at 8 KB (the head's 13 KB
// description). The client here asks for four 64 KB replies and does
// not read for a while, so the server's writes fill the buffer on any
// platform; every reply must still arrive complete and in order.

fn app_source(sock: String) -> String {
    return "type Ask { doublings: Int; }\n"
        + "type Blob { text: String; }\n"
        + "topic Asks { payload: Ask; subject: \"t.ask\"; }\n"
        + "locus Head {\n"
        + "    bus { subscribe Asks as on_ask; }\n"
        + "    fn on_ask(a: Ask) -> Blob {\n"
        + "        let mut t = \"0123456789abcdef\";\n"
        + "        let mut i = 0;\n"
        + "        while i < a.doublings { t = t + t; i = i + 1; }\n"
        + "        return Blob { text: t };\n"
        + "    }\n"
        + "}\n"
        + "main locus App {\n"
        + "    params { head: Head = Head { }; }\n"
        + "    placement { head: cooperative(pool = work) where async_io; }\n"
        + "    bindings { api: unix(\"" + sock + "\", bound: 4, on_full: refuse); }\n"
        + "    run() { std::time::sleep(20s); }\n"
        + "}\n"
        + "fn main() { App { }; }\n";
}

locus Proc {
    params {
        child: std::process::Child = std::process::Child { };
        out: String = "";
    }

    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }

    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
    }

    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 {
            return false;
        }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }

    fn send(line: String) {
        self.stream.send(line + "\n") or discard;
    }

    // The next complete line, or "" after ~4s without one.
    fn next_line() -> String {
        let mut i = 0;
        while i < 20 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let line = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return line;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                i = i + 1;
            } else {
                self.buf = self.buf + chunk;
            }
        }
        return "";
    }
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let tag = to_string(std::process::pid());
    let sock = "/tmp/hale-api-big-" + tag + ".sock";
    let src = std::io::fs::mktemp("/tmp/hale-1129-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source(sock)) or discard;
    let built = std::process::run(hale + "\nbuild\n" + src)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(built.code, 0, "the app builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];
    let p = Proc { };
    std::test::assert(p.start(bin), "the app started");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);

    // 12 doublings of 16 bytes: a 64 KB value; four of them, asked
    // before any is read, are past any platform's socket buffer, so
    // the server's writes would-block for certain.
    let mut i = 1;
    while i <= 4 {
        api.send("{\"id\":" + to_string(i) + ",\"call\":\"Asks\",\"payload\":{\"doublings\":12}}");
        i = i + 1;
    }
    std::time::sleep(1500ms);
    let mut k = 1;
    while k <= 4 {
        let reply = api.next_line();
        std::test::assert(std::str::starts_with(reply, "{\"request_id\":" + to_string(k) + ",\"id\":" + to_string(k) + ","), "reply " + to_string(k) + " arrived, in order: " + reply[0..80]);
        std::test::assert(std::str::contains(reply, "\"ok\":true"), "and it is the handler's answer");
        let value = std::json::find_field_raw(reply, "value");
        std::test::assert_eq_int(len(value), 65536 + len("{\"text\":\"\"}"), "the whole 64 KB value arrived");
        std::test::assert(std::str::ends_with(reply, "}"), "the line is closed");
        k = k + 1;
    }

    p.stop();
    std::io::fs::unlink(src) or discard;
    std::io::fs::unlink(bin) or discard;
}
