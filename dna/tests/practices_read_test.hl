// dna/tests/practices_read_test.hl — the practices read is linear (GH #1653).
//
// A grafted organism's record holds the practices its birth proposed, each
// with Reviews. The API child answers a page of them to every poll, and
// voice polls once a second, so a page that costs more than the poll's
// interval never catches up. The read is timed here over a real record,
// and a second read of the unmoved record costs the same, not more.

import "../core" as dna;
import "../operations" as ops;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// The catalog by the plain quadratic rule the read replaced: a named
// proposal's first row, counted by a scan back over the rows before it.
fn plain_count(j: dna::Journal) -> Int {
    let mut n = 0;
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "knowledge.proposed" && len(std::json::find_string_field(e.body, "name")) > 0 {
            let mut first = true;
            let mut k = 0;
            while k < i {
                let earlier = j.read(k);
                if earlier.entity == e.entity
                    && earlier.kind == "knowledge.proposed"
                    && len(std::json::find_string_field(earlier.body, "name")) > 0
                {
                    first = false;
                }
                k = k + 1;
            }
            if first { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

fn check() {
    let scratch = dna::scratch_root("practices-read");
    let made = dna::grafted(scratch, "app");
    std::test::assert_eq_int(made.code, 0, "an organism grafted: " + made.stderr);
    let repo = scratch + "/app";
    let j = dna::RecordJournal { repo: repo };
    let q = ops::Queries { j: j, receipts: dna::MemoryReceipts { repo: repo }, location: repo };
    let total = q.practice_count();
    std::test::assert(
        total > 100,
        "the birth proposed more practices than a page holds: " + to_string(total),
    );
    std::test::assert_eq_int(
        total,
        plain_count(j),
        "the linear read counts what the plain rule counts",
    );
    // every item of a page, in the order of the record, none twice
    let mut seen = "\n";
    let mut i = 0;
    while i < total && i < 100 {
        let p = q.practice_at(i);
        std::test::assert(
            len(p.id) > 0 && !std::str::contains(seen, "\n" + p.id + "\n"),
            "item " + to_string(i) + " is a practice of its own: " + p.id,
        );
        seen = seen + p.id + "\n";
        i = i + 1;
    }
    std::test::assert_eq_str(q.practice_at(total).id, "", "past the end");
    std::test::assert_eq_int(
        q.practice_count(),
        total,
        "a second count of the unmoved record is the same",
    );
    dna::scratch_done(scratch);
}
main locus App { run() { check(); } }
fn main() { App { }; }
