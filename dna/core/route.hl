// dna/core/route.hl — a change set to the positions that must
// sign it (GH #1087).
//
// Routing is read from the graph, never guessed: the paths a change
// touches name nodes — a seed (the longest one holding the path), a
// contract (its file, or a file of its directory), a document — and the
// edges say who signs:
//
//   a seed        — the reviewer of every process that unfolds into it;
//   a contract    — every position that `reviews` it (its servers'
//                   reviewers), and the reviewer of every consumer: a
//                   consuming process, the processes a consuming seed
//                   belongs to, the positions reviewing a consuming
//                   contract; and the `board` where the contract is law
//                   (a practice ratified as law — its receipt says
//                   `law: true` — is bound to it; advice is not law);
//   a document    — every position that `reviews` it;
//   a deployment  — its file (the file the deployment was read from),
//                   signed by the `operator` it unfolds into, against the
//                   gates guarding it.
//
// A process's `dev` never signs for it: a `/dev` position is never a
// signer. The evidence a verdict is given against is the run of every gate
// guarding a node the change touches. A consumer no position reviews is
// said, not dropped; a path that names no node, or whose nodes no
// position signs, is left to the fallback — the Review's own authority
// (review.hl), the task routers of GH #697 when they exist.

type Route {
    signers: String = ""; // `<position>\t<because>` per line, first reason kept
    evidence: String = ""; // gate ids, one per line
    unsigned: String = ""; // `<node>\t<because>` per line
    fallback: String = ""; // `<path>\t<because>` per line
}

// `<a>\t<b>` pairs from a JSON array of two-element arrays.
@unbounded
fn route_pairs(raw: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(raw);
    while !it.done {
        let pair = show_strings(it.element);
        let nl = std::str::index_of(pair, "\n");
        if nl > 0 { out = out + pair[0..nl] + "\t" + trim_nl(pair[(nl + 1)..len(pair)]) + "\n"; }
        it = std::json::array_next(it);
    }
    return out;
}

// Whether `lines` holds `line`.
fn route_has(lines: String, line: String) -> Bool { return std::str::contains("\n" + lines, "\n" + line + "\n"); }

locus Router {
    params {
        nodes: String = ""; // `<id>\t<kind>\t<name>\t<source>` per line
        unfold: String = "";
        reviews: String = "";
        holds: String = "";
        meets: String = ""; // the query's meets array, raw
        gates: String = ""; // the query's gates array, raw
        law: String = "\n";
        route: Route = Route { };
    }
    @unbounded
    fn load(json: String) {
        let mut it = std::json::array_first(std::json::find_field_raw(json, "nodes"));
        while !it.done {
            self.nodes = self.nodes + std::json::find_string_field(it.element, "id") + "\t" + std::json::find_string_field(it.element, "kind") + "\t" + std::json::find_string_field(it.element, "name") + "\t" + std::json::find_string_field(it.element, "source") + "\n";
            it = std::json::array_next(it);
        }
        self.unfold = route_pairs(std::json::find_field_raw(json, "unfold"));
        self.reviews = route_pairs(std::json::find_field_raw(json, "reviews"));
        self.holds = route_pairs(std::json::find_field_raw(json, "holds"));
        self.meets = std::json::find_field_raw(json, "meets");
        self.gates = std::json::find_field_raw(json, "gates");
    }
    // The node a path names: a contract (its file or a file under its
    // directory), else a document, else a deployment (the file it was read
    // from, when that is no document), else the seed holding it; "" for
    // none.
    @unbounded
    fn node_of(path: String) -> String {
        let mut seed = "";
        let mut deployment = "";
        let mut rest = self.nodes;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let t1 = std::str::index_of(line, "\t");
            let id = line[0..t1];
            let after = line[(t1 + 1)..len(line)];
            let t2 = std::str::index_of(after, "\t");
            let kind = after[0..t2];
            let tail = after[(t2 + 1)..len(after)];
            let t3 = std::str::index_of(tail, "\t");
            let name = tail[0..t3];
            let source = tail[(t3 + 1)..len(tail)];
            if kind == "contract" && (path == name || std::str::starts_with(path, name + "/")) { return id; }
            if kind == "document" && path == name { return id; }
            if kind == "deployment" && len(source) > 0 && !std::str::ends_with(source, ".md") && path == source { deployment = id; }
            if kind == "seed" && (path == name || std::str::starts_with(path, name + "/")) && len(name) > len(seed) { seed = name; }
        }
        if len(deployment) > 0 { return deployment; }
        return if len(seed) > 0 { "seed:" + seed } else { "" };
    }
    // The `<b>`s of the pairs whose `<a>` is `a`, or with `reverse` the
    // `<a>`s whose `<b>` is `b`.
    @unbounded
    fn related(pairs: String, key: String, reverse: Bool) -> String {
        let mut out = "";
        let mut rest = pairs;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let tab = std::str::index_of(line, "\t");
            let a = line[0..tab];
            let b = line[(tab + 1)..len(line)];
            if !reverse && a == key { out = out + b + "\n"; }
            if reverse && b == key { out = out + a + "\n"; }
        }
        return out;
    }
    // A process's reviewer: the `reviewer` positions it unfolds into.
    @unbounded
    fn reviewers_of(process: String) -> String {
        let mut out = "";
        let mut rest = self.related(self.unfold, process, false);
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let p = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if std::str::starts_with(p, "position:") && std::str::ends_with(p, "/reviewer") { out = out + p + "\n"; }
        }
        return out;
    }
    // A signer, once, with the first reason it signs; never a dev. Whether
    // the position signs: a dev is refused, and one already signing for
    // another path signs this one too.
    @unbounded
    fn sign(position: String, because: String) -> Bool {
        if std::str::ends_with(position, "/dev") { return false; }
        if std::str::contains("\n" + self.route.signers, "\n" + position + "\t") { return true; }
        self.route.signers = self.route.signers + position + "\t" + because + "\n";
        return true;
    }
    // How many of `positions` sign: only those `sign` accepts count, so a
    // reviews row naming a dev leaves its node to the fallback, never to
    // nobody.
    fn sign_all(positions: String, because: String) -> Int {
        let mut n = 0;
        let mut rest = positions;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            if self.sign(rest[0..nl], because) { n = n + 1; }
            rest = rest[(nl + 1)..len(rest)];
        }
        return n;
    }
    // Who signs for a consumer of `contract`: a process's reviewer, the
    // reviewers of the processes a seed belongs to, the positions
    // reviewing a contract; said when there is none.
    @unbounded
    fn consumer(node: String, spec: String) -> Int {
        let because = "consumes " + show_name(spec);
        let mut n = 0;
        if std::str::starts_with(node, "process:") { n = self.sign_all(self.reviewers_of(node), because); }
        else if std::str::starts_with(node, "seed:") {
            let mut ps = self.related(self.unfold, node, true);
            while len(ps) > 0 {
                let nl = std::str::index_of(ps, "\n");
                n = n + self.sign_all(self.reviewers_of(ps[0..nl]), because + " (through " + show_name(node) + ")");
                ps = ps[(nl + 1)..len(ps)];
            }
        } else { n = self.sign_all(self.related(self.reviews, node, true), because); }
        if n == 0 && !route_has(self.route.unsigned, node + "\t" + because + "; no position reviews it") { self.route.unsigned = self.route.unsigned + node + "\t" + because + "; no position reviews it\n"; }
        return n;
    }
    // One path of the change set: its node, who signs it, the gates that
    // are its evidence; to the fallback when no position signs it.
    @unbounded
    fn path(p: String) {
        let node = self.node_of(p);
        if len(node) == 0 { self.route.fallback = self.route.fallback + p + "\tnames no seed, contract, document or deployment file the graph holds\n"; return; }
        let mut signed = 0;
        if std::str::starts_with(node, "seed:") {
            let mut ps = self.related(self.unfold, node, true);
            while len(ps) > 0 {
                let nl = std::str::index_of(ps, "\n");
                signed = signed + self.sign_all(self.reviewers_of(ps[0..nl]), "reviews " + show_name(ps[0..nl]) + ", whose seed " + show_name(node) + " it changes");
                ps = ps[(nl + 1)..len(ps)];
            }
        } else if std::str::starts_with(node, "deployment:") {
            // a deployment's file: the operator it unfolds into signs it
            let mut under = self.related(self.unfold, node, false);
            while len(under) > 0 {
                let cut = std::str::index_of(under, "\n");
                let operator = under[0..cut];
                under = under[(cut + 1)..len(under)];
                if std::str::starts_with(operator, "position:") && std::str::ends_with(operator, "/operator") && self.sign(operator, "operates " + show_name(node)) { signed = signed + 1; }
            }
        } else {
            signed = signed + self.sign_all(self.related(self.reviews, node, true), "signs " + show_name(node));
        }
        if std::str::starts_with(node, "contract:") {
            let mut it = std::json::array_first(self.meets);
            while !it.done {
                if std::json::find_string_field(it.element, "contract") == node {
                    let mut cs = show_strings(std::json::find_field_raw(it.element, "consumers"));
                    while len(cs) > 0 {
                        let nl = std::str::index_of(cs, "\n");
                        signed = signed + self.consumer(cs[0..nl], node);
                        cs = cs[(nl + 1)..len(cs)];
                    }
                }
                it = std::json::array_next(it);
            }
            if route_has(self.law, node) && self.sign("position:board", show_name(node) + " is law") { signed = signed + 1; }
        }
        // the evidence: every gate guarding the node
        let mut g = std::json::array_first(self.gates);
        while !g.done {
            let gate = std::json::find_string_field(g.element, "gate");
            if route_has(show_strings(std::json::find_field_raw(g.element, "guarded")), node) && !route_has(self.route.evidence, gate) { self.route.evidence = self.route.evidence + gate + "\n"; }
            g = std::json::array_next(g);
        }
        if signed == 0 { self.route.fallback = self.route.fallback + p + "\tno position " + (if std::str::starts_with(node, "deployment:") { "operates " } else { "signs " }) + show_name(node) + "\n"; }
    }
}

// The route for `paths` (one per line) over the routing query's answer.
@unbounded
// `law` is the contracts (and other nodes) a practice ratified as law is
// bound to, one per line: the caller reads each bound practice's receipt
// (`law_targets`), for memory holds a practice's binding but not whether
// the Board ratified it as law or as advice.
fn graph_route(json: String, paths: String, law: String) -> Route {
    let r = Router { };
    r.load(json);
    r.law = "\n" + law;
    let mut rest = paths;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let p = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(std::str::trim(p)) > 0 { r.path(std::str::trim(p)); }
    }
    return r.route;
}

// The holders of `position`, `, `-joined, from the routing query's holds.
@unbounded
fn route_holders(json: String, position: String) -> String {
    let r = Router { };
    r.holds = route_pairs(std::json::find_field_raw(json, "holds"));
    return show_list(r.related(r.holds, position, false), false);
}

// The `<idea>\t<target>` pairs of the routing query's `bound`: a ratified
// practice and what it is bound to, for the caller to keep those ratified
// as law.
@unbounded
fn route_bound(json: String) -> String { return route_pairs(std::json::find_field_raw(json, "bound")); }

// ---- what a Review requires, from its route (GH #1089) ----------------------
//
// A Review a definition opens records who must sign it and the gates whose
// runs are its evidence, as the route computes them for its candidate. A
// signer is a position with the holders it has when the Review opens,
// `<position>=<holder>,<holder>`, and every one must approve; a position
// nobody holds is required all the same, and keeps the Review open until
// its holders are routed again (the organization re-routes an open Review
// when who holds its positions changes). A route that names no held
// position defines no signers: the Review falls back to its own required
// authority, which is how an organization with no Board holder yet
// ratifies the hold that gives it one. A route that signs some paths and
// leaves others to the fallback requires both: every position, and an
// approval carrying the Review's own required authority.

type RouteRequirement {
    signers: String = ""; // `<position>=<holder>,<holder>`, space-separated; "" is the fallback
    gates: String = ""; // the gate ids whose passing run at the candidate is its evidence, space-separated
    fallback: Bool = false; // some path is left to the Review's own required authority as well
    recorded: Bool = true; // false when the record did not take the routing: the Review is not opened
}

// The targets of the bound practices ratified as law, one per line: a
// practice's receipt says whether it was ratified as law (`law: true`) or
// as advice, which memory's binding does not (GH #1087 review, G3).
@unbounded
fn route_law(bound: String, receipts: Receipts) -> String {
    let mut out = "";
    let mut rest = bound;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let tab = std::str::index_of(line, "\t");
        let idea = line[0..tab];
        let target = line[(tab + 1)..len(line)];
        let raw = if std::str::starts_with(idea, "sha256:") { idea[7..len(idea)] } else { idea };
        if std::json::find_bool_field(receipts.read(raw), "law") && !route_has(out, target) { out = out + target + "\n"; }
    }
    return out;
}

// The holders of `position`, `,`-joined, from the routing query's holds.
@unbounded
fn route_held_by(json: String, position: String) -> String {
    let r = Router { };
    r.holds = route_pairs(std::json::find_field_raw(json, "holds"));
    let mut out = "";
    let mut rest = r.related(r.holds, position, false);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        out = out + (if len(out) > 0 { "," } else { "" }) + rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
    }
    return out;
}

// What a Review of `r` requires over the routing query's answer `json`.
@unbounded
fn route_requirement(json: String, r: Route) -> RouteRequirement {
    let mut signers = "";
    let mut held = false;
    let mut rest = r.signers;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let position = line[0..std::str::index_of(line, "\t")];
        let holders = route_held_by(json, position);
        if len(holders) > 0 { held = true; }
        signers = signers + (if len(signers) > 0 { " " } else { "" }) + position + "=" + holders;
    }
    if !held { return RouteRequirement { }; }
    let fallback = len(r.fallback) > 0;
    let mut gates = "";
    let mut g = r.evidence;
    while len(g) > 0 {
        let nl = std::str::index_of(g, "\n");
        gates = gates + (if len(gates) > 0 { " " } else { "" }) + g[0..nl];
        g = g[(nl + 1)..len(g)];
    }
    return RouteRequirement { signers: signers, gates: gates, fallback: fallback };
}

// `signers` with each position's holders read again from the routing
// query's answer: the positions a Review requires stay the route's, and
// who holds them is who holds them now.
@unbounded
fn signers_held_now(json: String, signers: String) -> String {
    let mut out = "";
    let mut i = 0;
    while len(nth_word(signers, i)) > 0 {
        let entry = nth_word(signers, i);
        let eq = std::str::index_of(entry, "=");
        let position = if eq > 0 { entry[0..eq] } else { entry };
        out = out + (if len(out) > 0 { " " } else { "" }) + position + "=" + route_held_by(json, position);
        i = i + 1;
    }
    return out;
}

// The Board's requirement: the `board` position under the purpose, with
// its holders — what practice-ratify's Review requires. None while nobody
// holds it (the fallback).
@unbounded
fn board_requirement(json: String) -> RouteRequirement {
    let holders = route_held_by(json, "position:board");
    if len(holders) == 0 { return RouteRequirement { }; }
    return RouteRequirement { signers: "position:board=" + holders };
}

// ---- how the graph's names are shown ---------------------------------------

// The last segment of a path.
@unbounded
fn ingest_base(path: String) -> String {
    let mut rest = path;
    let mut slash = std::str::index_of(rest, "/");
    while slash >= 0 {
        rest = rest[(slash + 1)..len(rest)];
        slash = std::str::index_of(rest, "/");
    }
    return rest;
}

// How a node is shown: the last segment of its name.
fn show_name(id: String) -> String {
    let colon = std::str::index_of(id, ":");
    return ingest_base(if colon >= 0 { id[(colon + 1)..len(id)] } else { id });
}

// A JSON array of strings, one per line.
@unbounded
fn show_strings(raw: String) -> String {
    let mut out = "";
    if !std::str::starts_with(std::str::trim(raw), "[") { return out; }
    let mut it = std::json::array_first(raw);
    while !it.done {
        let e = std::str::trim(it.element);
        if len(e) >= 2 && std::str::starts_with(e, "\"") { out = out + std::json::unescape_string(e[1..(len(e) - 1)]) + "\n"; }
        it = std::json::array_next(it);
    }
    return out;
}

// Lines as a `, `-joined list, each shown by `show_name` when `names`.
@unbounded
fn show_list(lines: String, names: Bool) -> String {
    let mut out = "";
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let v = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        out = out + (if len(out) > 0 { ", " } else { "" }) + (if names { show_name(v) } else { v });
    }
    return out;
}
