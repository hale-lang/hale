// An HTTP exchange under one deadline (voice#8): the dial, the request
// and the whole answer within `within`, never tried twice. hale's
// `std::http::Client` bounds its dial alone (`timeout_ms`) and then reads
// an answer for as long as the peer takes (FRICTION.md); the reads a
// locus makes on a schedule (governance.hl) must cost a peer that accepts
// and never answers the deadline and no more.
//
// HTTP/1.1 with `Connection: close`, over `std::io::tcp` or, for `https`,
// `std::io::tls`; an answer is read to its `Content-Length`, to the end of
// its chunks or to the peer's close, whichever it gives. An answer short
// of its length, or chunked without its last (empty) chunk and the end of
// its trailer, is cut, never whole. One that gives neither (read to the
// close) cannot be told from a cut one: it says so (`framed` false), and
// a reader that must not take part of an answer for all of it refuses it.

/// What an exchange answered: its status and body, or `why` there was no
/// whole answer (`status` 0); `framed` when the answer gave its length or
/// its chunks, so that it is known to be whole.
type Answer { status: Int = 0; body: String = ""; why: String = ""; framed: Bool = false; }

/// A chunked body, its chunks joined; `whole` when its last chunk and the
/// end of its trailer were there.
type Dechunked { body: String = ""; whole: Bool = false; }

/// An open exchange: its connection, the URL it was opened for and the
/// instant it must be over by; `why` it did not open (`handle` -1).
type Exchange {
    handle: Int = -1;
    tls: Bool = false;
    url: std::http::Url = std::http::Url { };
    deadline_ns: Int = 0;
    why: String = "";
}

/// The largest answer read: a page of practices is far smaller.
const ANSWER_MAX: Int = 8388608;

fn no_url(e: std::http::HttpError) -> std::http::Url {
    return std::http::Url { };
}

/// What is left of `x`'s deadline, at least a millisecond.
fn left_of(x: Exchange) -> Duration {
    let rem = x.deadline_ns - std::time::monotonic_ns();
    return if rem > 1000000 { rem * 1ns } else { 1ms };
}

/// A connection to `target`'s host, dialled within `within`, the deadline
/// of the whole exchange starting now.
fn exchange_open(target: String, within: Duration) -> Exchange {
    let u = std::http::parse_url(target) or no_url(err);
    if len(u.host) == 0 || (u.scheme != "http" && u.scheme != "https") { return Exchange { why: "not an http or https URL: " + target }; }
    let tls = u.scheme == "https";
    let deadline = std::time::monotonic_ns() + within / 1ns;
    let mut why = "";
    let h = if tls {
        std::io::tls::connect_within(u.host, u.port, within) or {
            why = err.kind;
                -1
        }
    } else {
        std::io::tcp::connect_within(u.host, u.port, within) or {
            why = err.kind;
                -1
        }
    };
    if h < 0 { return Exchange { why: "no connection to " + u.host + ":" + to_string(u.port) + " (" + why + ")" }; }
    return Exchange { handle: h, tls: tls, url: u, deadline_ns: deadline };
}

fn exchange_close(x: Exchange) {
    if x.handle < 0 { return; }
    if x.tls { std::io::tls::close(x.handle); } else { std::io::tcp::close_fd(x.handle); }
}

/// The request's line and headers up to its `Content-Length`.
fn request_head(x: Exchange, method: String, headers: String) -> String {
    return method + " " + (if len(x.url.path) > 0 { x.url.path } else { "/" }) + " HTTP/1.1\r\nHost: " + x.url.host + ":" + to_string(x.url.port) + "\r\nConnection: close\r\nAccept: application/json\r\n" + (if len(headers) > 0 { headers + "\r\n" } else { "" });
}

/// A write that cannot wait past the deadline.
fn bound_writes(x: Exchange) {
    if x.tls { std::io::tls::set_send_timeout(x.handle, left_of(x)) or discard; } else { std::io::tcp::set_send_timeout(x.handle, left_of(x)) or discard; }
}

/// Send `method` with `headers` (CRLF-joined, no trailing CRLF) and
/// `body`; false when the write failed.
fn exchange_send(x: Exchange, method: String, headers: String, body: String) -> Bool {
    bound_writes(x);
    let wire = std::bytes::from_string(request_head(x, method, headers) + "Content-Length: " + to_string(len(body)) + "\r\n\r\n" + body);
    if x.tls { return std::io::tls::send_bytes(x.handle, wire) >= 0; }
    std::io::tcp::send_fd(x.handle, wire) or { return false; };
    return true;
}

/// `exchange_send` of a form whose last value is a secret: `form` ends
/// with that value's `name=`, and the secret goes on the wire as it is,
/// consumed by the write (spec/semantics.md, "@sealed").
fn exchange_send_secret(x: Exchange, method: String, headers: String, form: String, @secret secret: String) -> Bool {
    bound_writes(x);
    if x.tls { return std::io::tls::send_bytes(x.handle, std::bytes::from_string(request_head(x, method, headers) + "Content-Length: " + to_string(len(form) + len(secret)) + "\r\n\r\n" + form + secret)) >= 0; }
    std::io::tcp::send_fd(x.handle, std::bytes::from_string(request_head(x, method, headers) + "Content-Length: " + to_string(len(form) + len(secret)) + "\r\n\r\n" + form + secret)) or { return false; };
    return true;
}

/// The answer to what was sent on `x`, read within its deadline; the
/// connection is closed after.
@unbounded
fn exchange_answer(x: Exchange) -> Answer {
    let s = std::io::tcp::Stream { conn_fd: x.handle, owns_fd: false };
    let mut got = b"";
    let mut why = "";
    while len(why) == 0 {
        if std::time::monotonic_ns() >= x.deadline_ns {
            why = "no whole answer within the deadline";
            break;
        }
        if x.tls { std::io::tls::set_recv_timeout(x.handle, left_of(x)) or discard; } else { std::io::tcp::set_recv_timeout(x.handle, left_of(x)) or discard; }
        let chunk = if x.tls { std::io::tls::recv_bytes(x.handle, 65536) } else { s.recv_bytes(65536) or b"" };
        if len(chunk) == 0 {
            // the peer closed, or the deadline passed waiting
            if std::time::monotonic_ns() >= x.deadline_ns { why = "no whole answer within the deadline"; }
            break;
        }
        got = std::bytes::concat(got, chunk);
        if len(got) > ANSWER_MAX {
            why = "an answer over " + to_string(ANSWER_MAX) + " bytes";
        } else if answer_whole(std::str::from_bytes(got)) {
            break;
        }
    }
    exchange_close(x);
    if len(why) > 0 { return Answer { why: why }; }
    return parse_answer(std::str::from_bytes(got));
}

/// `x` sent `method` and answered, all within the deadline.
fn exchange(target: String, within: Duration, method: String, headers: String, body: String) -> Answer {
    let x = exchange_open(target, within);
    if x.handle < 0 { return Answer { why: x.why }; }
    if !exchange_send(x, method, headers, body) {
        exchange_close(x);
        return Answer { why: "the request was not written" };
    }
    return exchange_answer(x);
}

/// Where an answer's head ends, -1 before it has.
fn head_end(text: String) -> Int {
    return std::str::index_of(text, "\r\n\r\n");
}

/// A header's value in a head lowered to lower case, "" without it.
@unbounded
fn header_value(head: String, name: String) -> String {
    let at = std::str::index_of(head, "\r\n" + name + ":");
    if at < 0 { return ""; }
    let rest = head[(at + len(name) + 3)..len(head)];
    let end = std::str::index_of(rest, "\r\n");
    return std::str::trim(if end < 0 { rest } else { rest[0..end] });
}

/// The answer read so far is whole: its head, and all its body says it
/// has.
@unbounded
fn answer_whole(text: String) -> Bool {
    let end = head_end(text);
    if end < 0 { return false; }
    let head = std::str::lower(text[0..end]);
    let body = text[(end + 4)..len(text)];
    // the last chunk is the empty one, and the (empty) trailer after it
    if header_value(head, "transfer-encoding") == "chunked" { return std::str::ends_with(body, "0\r\n\r\n") && (std::str::starts_with(body, "0\r\n") || std::str::index_of(body, "\r\n0\r\n") >= 0); }
    let length = header_value(head, "content-length");
    if len(length) == 0 { return false; }
    return len(body) >= (std::str::parse_int(length) or 0);
}

/// A whole answer's status and body.
@unbounded
fn parse_answer(text: String) -> Answer {
    let end = head_end(text);
    if end < 12 || !std::str::starts_with(text, "HTTP/1.") { return Answer { why: "not an HTTP answer" }; }
    let status = std::str::parse_int(text[9..12]) or 0;
    if status < 100 { return Answer { why: "not an HTTP answer" }; }
    let head = std::str::lower(text[0..end]);
    let body = text[(end + 4)..len(text)];
    if header_value(head, "transfer-encoding") == "chunked" {
        let d = dechunk(body);
        if !d.whole { return Answer { why: "a chunked answer cut short" }; }
        return Answer { status: status, body: d.body, framed: true };
    }
    let length = header_value(head, "content-length");
    if len(length) == 0 { return Answer { status: status, body: body }; }
    let n = std::str::parse_int(length) or - 1;
    if n < 0 || len(body) < n { return Answer { why: "an answer cut short" }; }
    return Answer { status: status, body: body[0..n], framed: true };
}

/// A hexadecimal size, -1 when `text` is not one.
@unbounded
fn hex_size(text: String) -> Int {
    if len(text) == 0 { return -1; }
    let mut n = 0;
    let mut i = 0;
    while i < len(text) {
        let c = std::str::byte_at_unchecked(text, i);
        let d = if c >= 48 && c <= 57 { c - 48 } else if c >= 97 && c <= 102 { c - 87 } else if c >= 65 && c <= 70 { c - 55 } else { -1 };
        if d < 0 { return -1; }
        n = n * 16 + d;
        i = i + 1;
    }
    return n;
}

/// A chunked body, its chunks joined, and whether it ended: a size that
/// is not one, a chunk short of its size or no last chunk is not whole.
@unbounded
fn dechunk(body: String) -> Dechunked {
    let mut out = "";
    let mut rest = body;
    while true {
        let line = std::str::index_of(rest, "\r\n");
        if line < 0 { return Dechunked { body: out }; }
        let word = rest[0..line];
        let semi = std::str::index_of(word, ";");
        let size = hex_size(std::str::trim(if semi < 0 { word } else { word[0..semi] }));
        if size < 0 { return Dechunked { body: out }; }
        if size == 0 {
            // the trailer: header lines, then an empty one
            let trailer = rest[(line + 2)..len(rest)];
            return Dechunked { body: out, whole: std::str::starts_with(trailer, "\r\n") || std::str::index_of(trailer, "\r\n\r\n") >= 0 };
        }
        // the chunk and the CRLF after it
        if line + 4 + size > len(rest) || rest[(line + 2 + size)..(line + 4 + size)] != "\r\n" { return Dechunked { body: out }; }
        out = out + rest[(line + 2)..(line + 2 + size)];
        rest = rest[(line + 4 + size)..len(rest)];
    }
    return Dechunked { body: out };
}
