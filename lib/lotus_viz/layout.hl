// layout.hl — radial geometry math for the lotus flower.
//
// Pure functions over a LocusTree. Walks the tree and writes
// position fields (x, y, z, radius, angle, size) onto each
// petal. The renderer consumes the populated tree.
//
// Algorithm pinned by DESIGN.md § "Geometry — radial layout":
//   - Root petals on ring 0; spread evenly around the circle.
//   - Children of each parent span the parent's allocated
//     child-arc, centered on the parent's angle.
//   - Ring radius grows superlinearly: r(d) = R0 + R1 * d^1.3
//   - Petals lie on a shallow dome: z = DOME_CURVE * radius
//
// F.9 closed (hale 4a24b77): std::math now ships
// sin / cos / tan / asin / acos / atan / atan2. Earlier
// Taylor approximations deleted; sin_approx / cos_approx
// are now thin re-exports of std::math::sin / std::math::cos
// so call sites stay stable across the migration.

// ---- Constants ----

fn pi() -> Float { return 3.14159265358979; }
fn two_pi() -> Float { return 6.28318530717958; }

// ---- Trig helpers (std::math thin wrappers) ----

fn sin_approx(x: Float) -> Float { return std::math::sin(x); }
fn cos_approx(x: Float) -> Float { return std::math::cos(x); }

// ---- Ring + petal sizing ----

fn ring_radius(depth: Int) -> Float {
    // r(d) = R0 + R1 * d^1.3
    // Aesthetic constants live in aesthetics.hl; we read them
    // by name (same seed, top-level scope sharing per F.19).
    if depth == 0 {
        return RING_R0;
    }
    // pow takes Float, Float — widen depth.
    let d_f = depth + 0.0;
    let scaled = std::math::pow(d_f, RING_EXPONENT);
    return RING_R0 + (RING_R1 * scaled);
}

fn petal_size_at_depth(depth: Int) -> Float {
    // size = SIZE_BASE / (1 + SIZE_DECAY * d)
    let d_f = depth + 0.0;
    return SIZE_BASE / (1.0 + (SIZE_DECAY * d_f));
}

fn dome_z_for(radius: Float) -> Float {
    return DOME_CURVE * radius;
}

// ---- Layout: assign positions to every petal in the tree ----
//
// Three passes:
//   Pass 1: count root petals (parent_id == "").
//   Pass 2: place roots evenly around ring 0.
//   Pass 3: for each non-root petal (in vec order), place it
//           within its parent's allocated child-arc, indexed
//           among its siblings.
//
// O(N) per pass + O(N) sibling-lookup per child → O(N²) overall.
// Fine for trees up to several hundred petals.

fn layout_tree(tree: LocusTree) {
    let total = tree.len();
    if total == 0 { return; }

    // ---- Pass 1: count roots. ----
    let mut root_count = 0;
    let mut i = 0;
    while i < total {
        let p = tree.get(i) or raise;
        if p.parent_id == "" {
            root_count = root_count + 1;
        }
        i = i + 1;
    }

    if root_count == 0 {
        // No roots — every petal claims to have a parent. The
        // parser shouldn't produce this. Fail soft: nothing
        // gets laid out.
        return;
    }

    // ---- Pass 2: place roots on ring 0. ----
    let root_radius = ring_radius(0);
    let root_size = petal_size_at_depth(0);
    let root_z = dome_z_for(root_radius);
    let angle_step = two_pi() / (root_count + 0.0);

    let mut placed_roots = 0;
    i = 0;
    while i < total {
        let p = tree.get(i) or raise;
        if p.parent_id == "" {
            let angle = angle_step * (placed_roots + 0.0);
            let x = root_radius * cos_approx(angle);
            let y = root_radius * sin_approx(angle);
            tree.set(i, with_position(p, root_radius, angle, x, y, root_z, root_size))
                or raise;
            placed_roots = placed_roots + 1;
        }
        i = i + 1;
    }

    // ---- Pass 3: place non-root petals. ----
    //
    // For each non-root petal, find its parent and compute its
    // angle within the parent's allocated child-arc.
    i = 0;
    while i < total {
        let p = tree.get(i) or raise;
        if p.parent_id != "" {
            let parent_idx = find_petal_by_id(tree, p.parent_id);
            if parent_idx >= 0 {
                let parent = tree.get(parent_idx) or raise;
                let my_depth = parent.depth + 1;
                let r = ring_radius(my_depth);
                let sz = petal_size_at_depth(my_depth);
                let z = dome_z_for(r);

                // Count siblings under this parent and find my
                // index among them. (Stable: index by vec
                // position among petals sharing parent_id.)
                let sibling_count = count_children(tree, p.parent_id);
                let my_sibling_idx = sibling_index_under(tree, i, p.parent_id);

                let angle = child_angle(parent.angle, my_sibling_idx, sibling_count);
                let x = r * cos_approx(angle);
                let y = r * sin_approx(angle);

                let mut updated = with_position(p, r, angle, x, y, z, sz);
                updated.depth = my_depth;
                tree.set(i, updated) or raise;
            }
            // If parent not found, the petal stays at its
            // default (origin). Diagnostic surface deferred.
        }
        i = i + 1;
    }
}

// ---- Angle computation for a child within its parent's arc ----
//
// The parent's child-arc spans up to MAX_CHILD_ARC_DEGREES,
// centered on the parent's angle. With N children, child i is
// at:
//   arc_width = min(MAX_CHILD_ARC, π/3 * N) in radians
//   arc_start = parent_angle - arc_width/2
//   step = arc_width / (N + 1)   (so children sit at 1/(N+1), 2/(N+1), ...)
//   child_i_angle = arc_start + step * (i + 1)
//
// The +1 / N+1 spacing keeps children off the arc's
// endpoints (where they'd collide with siblings' children).

fn child_angle(parent_angle: Float, child_idx: Int, sibling_count: Int) -> Float {
    if sibling_count <= 0 { return parent_angle; }
    if sibling_count == 1 {
        // Single child sits directly outward from parent.
        return parent_angle;
    }
    let max_arc = (MAX_CHILD_ARC_DEGREES * pi()) / 180.0;
    // Natural spread proportional to count, capped at max.
    let natural = (pi() / 3.0) * (sibling_count + 0.0);
    let mut arc_width = max_arc;
    if natural < arc_width {
        arc_width = natural;
    }
    let arc_start = parent_angle - (arc_width * 0.5);
    let step = arc_width / ((sibling_count + 1) + 0.0);
    return arc_start + (step * ((child_idx + 1) + 0.0));
}

// ---- Tree-walk helpers ----

fn find_petal_by_id(tree: LocusTree, id: String) -> Int {
    let n = tree.len();
    let mut i = 0;
    while i < n {
        let p = tree.get(i) or raise;
        if p.id == id { return i; }
        i = i + 1;
    }
    return -1;
}

fn count_children(tree: LocusTree, parent_id: String) -> Int {
    let n = tree.len();
    let mut i = 0;
    let mut c = 0;
    while i < n {
        let p = tree.get(i) or raise;
        if p.parent_id == parent_id { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn sibling_index_under(tree: LocusTree, petal_vec_idx: Int, parent_id: String) -> Int {
    // The index of petal_vec_idx among petals sharing
    // parent_id, by vec order. (vec order is the parser's
    // declaration order — stable across re-parses.)
    let mut i = 0;
    let mut sib_idx = 0;
    while i < petal_vec_idx {
        let p = tree.get(i) or raise;
        if p.parent_id == parent_id { sib_idx = sib_idx + 1; }
        i = i + 1;
    }
    return sib_idx;
}

// ---- Petal mutation helper ----
//
// Hale's struct literals are nominal — to "update" a petal
// we construct a fresh one carrying the new position fields
// and the old identity / classification fields. set() into
// the vec replaces in place.

fn with_position(p: Petal, radius: Float, angle: Float,
                 x: Float, y: Float, z: Float, size: Float) -> Petal {
    return Petal {
        id:         p.id,
        name:       p.name,
        kind:       p.kind,
        projection: p.projection,
        parent_id:  p.parent_id,
        depth:      p.depth,
        x:          x,
        y:          y,
        z:          z,
        radius:     radius,
        angle:      angle,
        size:       size,
        file:       p.file,
        line:       p.line,
    };
}
