// GH #604 rule 4 — a Task the leader hands to a person stays HANDED in
// the record until the person reports it done. The metabolism settles
// the handed Work at once (the organism's part is over), and that
// settlement used to be journaled as `task.done` right after
// `task.handed`, so a live handed Task showed done and `hale dna task
// done` refused it as not handed.

import "../core" as dna;

main locus App {
    params {
        one: dna::Dna = dna::Dna { planned: true, org_id: "hand" };
        lead: dna::Leader = dna::Leader {
            name: "leader", org: "hand", charter: "You are the architect.",
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answer: "kind: person\nclass: none\ntarget: none\ncount: 1\nassignee: noor\ncall the supplier" },
                deep: dna::FakeModel { name: "deep", answer: "kind: person\nclass: none\ntarget: none\ncount: 1\nassignee: noor\ncall the supplier" }
            }
        };
    }
    @unbounded
    fn rows(kind: String, entity: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && e.entity == entity { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    // card 18: an ask is admitted once the leader's word lands; the
    // execution admitted under the intent's identity, "" when none yet.
    @unbounded
    fn admitted(intent: String) -> String {
        let mut tries = 0;
        while tries < 300 {
            let mut i = 0;
            while i < self.one.journal.revision() {
                let e = self.one.journal.read(i);
                if e.kind == "workflow.admitted" && std::json::find_string_field(e.body, "request") == intent { return e.entity; }
                i = i + 1;
            }
            std::time::sleep(20ms);
            tries = tries + 1;
        }
        return "";
    }
    run() {
        let asked = self.one.ask(dna::Intent { id: "i1", outcome: "get the invoice paid", from: "riley" });
        std::test::assert_eq_str(asked, "planning", "the leader's word comes first");
        let t = self.admitted("i1");
        std::test::assert(std::str::starts_with(t, "t"), "the ask was admitted once the leader answered: " + t);
        std::test::assert_eq_str(self.one.ask_plan_of(t).kind + "|" + self.one.ask_plan_of(t).assignee, "person|noor", "planned by the leader, the word bound in the admission");
        let case = t + ".s0.p";
        let mut tries = 0;
        while tries < 300 && self.rows("task.handed", case) == 0 { std::time::sleep(20ms); tries = tries + 1; }
        std::test::assert_eq_int(self.rows("task.handed", case), 1, "and handed to a person as its case");
        std::test::assert_eq_int(self.rows("task.done", case) + self.rows("workflow.settled", t), 0, "not settled by the organism: the person reports it done");
        std::test::assert_eq_str(self.one.task_state(case), "handed", "it stays handed in the record");
        // the person's report is the settlement (`hale dna task done` appends it in their name)
        let r = self.one.journal.append(self.one.journal.revision(), "task.done", case, "by noor: paid");
        std::test::assert_eq_str(self.one.task_state(case), "done", "done once the person says so");
        let n = self.one.redrive();
        tries = 0;
        while tries < 300 && self.rows("workflow.settled", t) == 0 { std::time::sleep(20ms); tries = tries + 1; }
        std::test::assert_eq_int(self.rows("workflow.settled", t), 1, "and the ask's workflow settles on it (card 17)");
    }
}

fn main() { App { }; }
