// dna/api/commands.hl — the head's commands (GH #1104 piece 5, #1110).
//
// Every command the record takes is a topic on the head's api binding,
// gated by what the record says the caller holds: `owner` (the board)
// for organization and person commands, `reviewer` (`position:reviewer`)
// for verdicts, `position` (any live position) for a leg's verbs and a
// practice proposal; raising work and looking a command up need only an
// authenticated peer. The binding authenticates (SO_PEERCRED) and gates;
// `dna.unix.member` maps the peer to a person; the composed provider
// (`ops::GovernanceCommands` behind `CommandProvider`) admits, records
// and recovers exactly as before — the policy's authority label, the
// review's approvers, eligibility. The description the binding emits
// (`hale check --dump-api dna/api`) is the contract; there is no HTTP
// command route.
import "../core" as dna;
import "../operations" as ops;

type CommandContext {
    root: String = "";
    source: Source = Source { };
    principal_mode: String = "";
    principal_name: String = "";
}
type CommandRequest {
    valid: Bool = false;
    request_id: String = "";
    operation: String = "dna.practice.propose";
    operation_version: String = "1";
    application_id: String = "";
    position_id: String = "org";
    target_kind: String = "dna.practice";
    target_id: String = "";
    subject_digest: String = "";
    expected_principal_mode: String = "";
    expected_principal_name: String = "";
    text: String = "";
    rationale: String = "";
    expected_review_state: String = "";
    verdict: String = "";
    comment: String = "";
    // Exact Organization source fields. Deployment enablement is separate;
    // historical Practice/Review payloads leave this branch empty.
    source_head: String = "";
    dependency_source: String = "";
    dependency_digest: String = "";
    record_head: String = "";
    source_text: String = "";
    expected_assignee: String = "";
    new_assignee: String = "";
    // Raising work: the intent's outcome and the position it is for.
    outcome: String = "";
    to: String = "";
    // A leg's claim and outcome (GH #946): typed copies of the wire.
    performer_kind: String = "";
    performer: String = "";
    capabilities: String = "";
    data_classes: String = "";
    organizations: String = "";
    ttl: Int = 0;
    attempt_id: String = "";
    holder: String = "";
    token: Int = 0;
    disposition: String = "";
    result: String = "";
    result_ref: String = "";
    // GH #946 hardening: the hat the leg wore, on an outcome ("" and -1 when none)
    hat_digest: String = "";
    hat_head: String = "";
    hat_watermark: Int = -1;
    prompt_digest: String = "";
    renderer: String = "";
    narrative: String = "";
    evidence: String = "";
    receipts: String = "";
    hat_digest: String = "";
    prompt_digest: String = "";
    renderer: String = "";
}
type TaskCommandOutcome { state: String = ""; from: String = ""; to: String = ""; event_id: String = ""; }
type PersonRetirementOutcome { state: String = ""; from: String = ""; to: String = ""; event_id: String = ""; transferred: Int = -1; }
// The admitted ask and, re-derived on every read, the organism's answer to it.
type TaskCreateOutcome { intent_id: String = ""; intent_state: String = ""; task_id: String = ""; event_id: String = ""; }
// A leg's claim or outcome as it reads back (GH #946): the attempt and its lease, or the refusal.
type AttemptCommandOutcome {
    state: String = ""; attempt_id: String = ""; work_id: String = ""; task_id: String = ""; performer_kind: String = "";
    holder: String = ""; token: Int = -1; until: Int = 0; disposition: String = ""; reason: String = ""; event_id: String = "";
}
type OrganizationCommandOutcome {
    proposal_state: String = "pending";
    source_head: String = "";
    source_digest: String = "";
    mutation_id: String = "";
    candidate_commit: String = "";
    application_state: String = "pending";
    application_reason_code: String = "";
    restart_handoff_state: String = "pending";
}
type CommandReceipt {
    command_id: String = "";
    request_id: String = "";
    application_id: String = "";
    operation: String = "dna.practice.propose";
    operation_version: String = "1";
    principal_mode: String = "";
    principal_name: String = "";
    position_id: String = "org";
    target_kind: String = "dna.practice";
    target_id: String = "";
    subject_digest: String = "";
    fingerprint: String = "";
    state: String = "";
    reason: String = "";
    // Only the branch selected by operation may contain values.
    proposal_state: String = "pending";
    verdict_value: String = "";
    verdict_state: String = "";
    candidate_digest: String = "";
    review_id: String = "";
    review_state: String = "unavailable";
    review_outcome: String = "";
    review_subject_digest: String = "";
    activation_state: String = "unknown";
    activation_reason: String = "";
    organization: OrganizationCommandOutcome = OrganizationCommandOutcome { };
    task: TaskCommandOutcome = TaskCommandOutcome { };
    person: PersonRetirementOutcome = PersonRetirementOutcome { };
    task_create: TaskCreateOutcome = TaskCreateOutcome { };
    attempt: AttemptCommandOutcome = AttemptCommandOutcome { };
}
type CommandResult {
    ok: Bool = false;
    code: String = "commands_unavailable";
    source: Source = Source { };
    receipt: CommandReceipt = CommandReceipt { };
}
interface CommandProvider {
    fn supported(operation: String, version: String) -> Bool;
    fn submit(context: CommandContext, command: CommandRequest) -> CommandResult;
    fn lookup(context: CommandContext, request_id: String) -> CommandResult;
}
locus NoCommands {
    params { }
    fn supported(operation: String, version: String) -> Bool { return false; }
    fn submit(context: CommandContext, command: CommandRequest) -> CommandResult { return CommandResult { code: "commands_unsupported" }; }
    fn lookup(context: CommandContext, request_id: String) -> CommandResult { return CommandResult { code: "commands_unsupported" }; }
}

type CommandHeader {
    valid: Bool = true;
    count: Int = 0;
    value: String = "";
}

locus CommandWire {
    params { }
    fn raw(object: String, key: String) -> String { return std::json::find_field_raw(object, key); }
    fn is_text(raw: String) -> Bool { return len(raw) >= 2 && std::str::starts_with(raw, "\"") && std::str::ends_with(raw, "\""); }
    fn text(object: String, key: String) -> String {
        let raw = self.raw(object, key);
        if !self.is_text(raw) { return ""; }
        let syntax = ops::OrganizationJson { };
        return syntax.decode(raw);
    }
    // Call only after strict syntax validation. Every object has its own
    // allowlist; permissive stdlib cursors alone are not schema validation.
    fn fields(object: String, names: String, expected: Int) -> Bool {
        if !std::str::starts_with(std::str::trim(object), "{") { return false; }
        let mut count = 0;
        let mut it = std::json::object_first(object);
        while !it.done {
            let key = std::json::obj_key_string(it, object);
            if !std::str::contains(" " + names + " ", " " + key + " ") { return false; }
            count = count + 1;
            it = std::json::object_next(it, object);
        }
        return count == expected;
    }
    fn header(headers: String, name: String) -> CommandHeader {
        let size = len(headers);
        if size > 16384 { return CommandHeader { valid: false }; }
        let mut result = CommandHeader { };
        let mut start = 0;
        while start < size {
            let tail = headers[start..size];
            let split = std::str::index_of(tail, "\r\n");
            let line = if split < 0 { tail } else { tail[0..split] };
            let colon = std::str::index_of(line, ":");
            // Obsolete folded headers and malformed names are ambiguous.
            if colon < 1 { return CommandHeader { valid: false }; }
            let key = line[0..colon];
            if key != std::str::trim(key) || std::str::contains(key, " ") || std::str::contains(key, "\t") { return CommandHeader { valid: false }; }
            if std::str::lower(key) == std::str::lower(name) {
                result.count = result.count + 1;
                result.value = std::str::trim(line[(colon + 1)..len(line)]);
            }
            if split < 0 { break; }
            start = start + split + 2;
        }
        return result;
    }
    fn origin_valid(origin: String) -> Bool {
        let scheme = if std::str::starts_with(origin, "https://") { 8 } else if std::str::starts_with(origin, "http://") { 7 } else { 0 };
        let size = len(origin);
        if scheme == 0 || size <= scheme || size > 2048 { return false; }
        let mut i = scheme;
        while i < size {
            let c = std::str::byte_at_unchecked(origin, i);
            if c <= 32 || c >= 127 || c == 47 || c == 92 || c == 64 || c == 63 || c == 35 { return false; }
            i = i + 1;
        }
        return true;
    }

    fn bounded(value: String, maximum: Int, nonempty: Bool, controls: Bool) -> Bool {
        let size = len(value);
        let syntax = ops::OrganizationJson { };
        if size > maximum || (nonempty && size == 0) || !syntax.utf8(value, size) { return false; }
        if controls { return true; }
        let mut i = 0;
        while i < size {
            let c = std::str::byte_at_unchecked(value, i);
            if c < 32 || c == 127 { return false; }
            i = i + 1;
        }
        return true;
    }
    fn lookup_id(query: String) -> String {
        if !std::str::starts_with(query, "request_id=") || std::str::contains(query, "&") || len(query) > 1024 { return ""; }
        let http = Http { };
        let id = http.decode(query[11..len(query)]);
        if !id.ok || !self.bounded(id.text, 128, true, false) { return ""; }
        return id.text;
    }
    fn guard(req: std::http::Request, origin: String) -> String {
        if !self.origin_valid(origin) { return "commands_unsupported"; }
        let supplied = self.header(req.headers, "Origin");
        if !supplied.valid || supplied.count != 1 || supplied.value != origin { return "invalid_origin"; }
        let content = self.header(req.headers, "Content-Type");
        if !content.valid || content.count != 1 || std::str::lower(content.value) != "application/json" { return "unsupported_media_type"; }
        let marker = self.header(req.headers, "X-Hale-Command");
        if !marker.valid || marker.count != 1 || marker.value != "1" { return "invalid_command"; }
        let length = self.header(req.headers, "Content-Length");
        let transfer = self.header(req.headers, "Transfer-Encoding");
        if !length.valid || length.count > 1 || !transfer.valid || transfer.count > 0 { return "invalid_command"; }
        if length.count == 1 && length.value != to_string(len(req.body)) { return "invalid_command"; }
        if len(req.body) > 32768 { return "command_too_large"; }
        return "";
    }
    fn recipients_valid(value: String) -> Bool {
        let syntax = ops::OrganizationJson { };
        if len(value) > 65536 || !syntax.valid(value) || !std::str::starts_with(std::str::trim(value), "[") { return false; }
        let mut it = std::json::array_first(value); let mut count = 0; let mut seen = "\n";
        while !it.done {
            if !self.is_text(it.element) { return false; }
            let name = syntax.decode(it.element);
            if !self.bounded(name, 256, true, false) || std::str::contains(seen, "\n" + name + "\n") || count >= 64 { return false; }
            seen = seen + name + "\n"; count = count + 1; it = std::json::array_next(it);
        }
        return true;
    }
    fn words(raw: String) -> String {
        let value = std::str::trim(raw);
        if !std::str::starts_with(value, "[") || !std::json::valid(value) { return "!"; }
        let syntax = ops::OrganizationJson { };
        let mut out = ""; let mut it = std::json::array_first(value); let mut n = 0;
        while !it.done {
            if !self.is_text(it.element) || n >= 64 { return "!"; }
            let word = syntax.decode(it.element);
            if !self.bounded(word, 128, true, false) || std::str::contains(word, " ") { return "!"; }
            out = out + (if len(out) > 0 { " " } else { "" }) + word; n = n + 1; it = std::json::array_next(it);
        }
        return out;
    }
    fn error(code: String) -> std::http::Response {
        let http = Http { };
        if code == "invalid_command" { return http.error(400, code, "invalid command fields, values, or required headers", false); }
        if code == "invalid_query" { return http.error(400, code, "lookup requires exactly one request_id", false); }
        if code == "unauthenticated" { return http.error(401, code, "sign in at /auth/login", false); }
        if code == "forbidden" { return http.error(403, code, "this command operation is not authorized", false); }
        if code == "invalid_origin" { return http.error(403, code, "the command origin is not permitted", false); }
        if code == "command_context_changed" { return http.error(409, code, "the authenticated principal changed; review the command under the current identity", false); }
        if code == "stale_subject" { return http.error(409, code, "the selected subject is no longer eligible; load its current state", false); }
        if code == "request_conflict" { return http.error(409, code, "this request identity belongs to different command content", false); }
        if code == "command_not_found" { return http.error(404, code, "no visible command was found for this request identity", false); }
        if code == "command_too_large" { return http.error(413, code, "the command body exceeds the supported byte limit", false); }
        if code == "unsupported_media_type" { return http.error(415, code, "commands require Content-Type application/json", false); }
        if code == "commands_unsupported" { return http.error(503, code, "this application does not configure command submission", false); }
        return http.error(503, "commands_unavailable", "the command result is unavailable; retain the request identity for lookup", true);
    }
}

// ---- the topics --------------------------------------------------------

role position; // holds any live position in the record's org chart
role reviewer; // holds `position:reviewer`

// The payloads: the old envelope's arguments and preconditions, flat,
// under the request id the caller mints. The head supplies the context
// (this record), the target's application and the principal.
type PracticeProposal { request_id: String = ""; subject_digest: String = ""; text: String = ""; rationale: String = ""; }
type ReviewDecision { request_id: String = ""; review_id: String = ""; subject_digest: String = ""; verdict: String = ""; comment: String = ""; }
type OrganizationProposal {
    request_id: String = ""; source_head: String = ""; module_digest: String = ""; dependency_source: String = ""; dependency_digest: String = "";
    record_head: String = ""; source_text: String = ""; rationale: String = "";
}
type TaskCreation { request_id: String = ""; record_head: String = ""; outcome: String = ""; to: String = ""; }
type TaskReassignment { request_id: String = ""; task_id: String = ""; assignment_digest: String = ""; assignee: String = ""; to: String = ""; }
type PersonRetirement { request_id: String = ""; person: String = ""; subject_digest: String = ""; to: String = ""; }
// A leg's claim (GH #946): the three lists are space-separated words.
type Claim {
    request_id: String = ""; record_head: String = ""; performer_kind: String = ""; performer: String = "";
    capabilities: String = ""; data_classes: String = ""; organizations: String = ""; ttl: Int = 0;
}
// A leg's outcome: `evidence` and `receipts` are JSON arrays as text;
// the hat fields are empty and -1 when no hat was worn.
type Outcome {
    request_id: String = ""; attempt_id: String = ""; holder: String = ""; token: Int = 0;
    disposition: String = ""; result: String = ""; result_ref: String = ""; narrative: String = ""; evidence: String = ""; receipts: String = "";
    hat_digest: String = ""; hat_head: String = ""; hat_watermark: Int = -1; prompt_digest: String = ""; renderer: String = "";
}
type Renewal { request_id: String = ""; attempt_id: String = ""; holder: String = ""; token: Int = 0; ttl: Int = 0; }
type Release { request_id: String = ""; attempt_id: String = ""; holder: String = ""; token: Int = 0; why: String = ""; }
type Friction { request_id: String = ""; record_head: String = ""; position: String = ""; attempt_id: String = ""; text: String = ""; }
type Lookup { request_id: String = ""; }
// Every command's answer: the provider's result and the receipt as the
// record wrote it (the per-operation branch filled, the rest empty).
type CommandReply {
    ok: Bool = false;
    code: String = "";
    application_id: String = "";
    head: String = "";
    revision: Int = 0;
    receipt: CommandReceipt = CommandReceipt { };
}

topic PracticePropose { payload: PracticeProposal; subject: "dna.commands.practice.propose"; }
topic ReviewVerdict { payload: ReviewDecision; subject: "dna.commands.review.verdict"; }
topic OrganizationPropose { payload: OrganizationProposal; subject: "dna.commands.organization.propose"; }
topic TaskCreate { payload: TaskCreation; subject: "dna.commands.task.create"; }
topic TaskReassign { payload: TaskReassignment; subject: "dna.commands.task.reassign"; }
topic PersonRetire { payload: PersonRetirement; subject: "dna.commands.person.retire"; }
topic AttemptClaim { payload: Claim; subject: "dna.commands.attempt.claim"; }
topic AttemptOutcome { payload: Outcome; subject: "dna.commands.attempt.outcome"; }
topic AttemptRenew { payload: Renewal; subject: "dna.commands.attempt.renew"; }
topic AttemptRelease { payload: Release; subject: "dna.commands.attempt.release"; }
topic FrictionFile { payload: Friction; subject: "dna.commands.friction.file"; }
topic CommandLookup { payload: Lookup; subject: "dna.commands.lookup"; }

// The typed request as the operations' command: a pure field mapping,
// which the provider and the admissibility check below share.
fn native_of(command: CommandRequest) -> ops::GovernanceCommand {
    return ops::GovernanceCommand {
        request_id: command.request_id, operation: command.operation, operation_version: command.operation_version,
        application_id: command.application_id, position_id: command.position_id, target_kind: command.target_kind,
        target_id: command.target_id, subject_digest: command.subject_digest, text: command.text, rationale: command.rationale,
        expected_review_state: command.expected_review_state, verdict: command.verdict, comment: command.comment,
        source_head: command.source_head, dependency_source: command.dependency_source, dependency_digest: command.dependency_digest,
        record_head: command.record_head, source_text: command.source_text,
        expected_assignee: command.expected_assignee, new_assignee: command.new_assignee,
        outcome: command.outcome, to: command.to,
        performer_kind: command.performer_kind, performer: command.performer, capabilities: command.capabilities, data_classes: command.data_classes,
        organizations: command.organizations, ttl: command.ttl, attempt_id: command.attempt_id, holder: command.holder, token: command.token,
        disposition: command.disposition, result: command.result, result_ref: command.result_ref, narrative: command.narrative,
        evidence: command.evidence, receipts: command.receipts,
        hat_digest: command.hat_digest, hat_head: command.hat_head, hat_watermark: command.hat_watermark, prompt_digest: command.prompt_digest, renderer: command.renderer
    };
}

// The head's command handlers. One per topic; each builds the typed
// request, checks it against the operations' own codec (the rule the
// HTTP wire used to restate), and hands it to the provider under the
// caller the binding established. On its own pool: a command is git
// work, and the HTTP head shares no thread with it.
locus Commands {
    params {
        root: String = ".";
        roles: dna::RecordRoles = dna::RecordRoles { };
        provider: CommandProvider = NoCommands { };
        local_name: String = "local"; // the local session's name, for the head's own uid when the record maps it to nobody
        // the helpers, held: a handler allocates nothing per message
        reader: SourceReader = SourceReader { };
        wire: CommandWire = CommandWire { };
        attempts: ops::AttemptCommandCodec = ops::AttemptCommandCodec { };
        person_codec: ops::PersonRetirementCodec = ops::PersonRetirementCodec { };
        create_codec: ops::TaskCreateCommandCodec = ops::TaskCreateCommandCodec { };
        task_codec: ops::TaskCommandCodec = ops::TaskCommandCodec { };
        organization_codec: ops::OrganizationCommandCodec = ops::OrganizationCommandCodec { };
        codec: ops::GovernanceCommandCodec = ops::GovernanceCommandCodec { };
    }
    birth() { self.reader.root = self.root; }
    bus {
        subscribe PracticePropose as propose;
        subscribe ReviewVerdict as verdict;
        subscribe OrganizationPropose as propose_organization;
        subscribe TaskCreate as create_task;
        subscribe TaskReassign as reassign_task;
        subscribe PersonRetire as retire_person;
        subscribe AttemptClaim as claim;
        subscribe AttemptOutcome as outcome;
        subscribe AttemptRenew as renew;
        subscribe AttemptRelease as release_attempt;
        subscribe FrictionFile as file_friction;
        subscribe CommandLookup as lookup;
    }
    // The caller as the record knows them: the person `dna.unix.member`
    // maps the peer to; the head's own uid unmapped is the local session
    // (what `/capabilities` names, so a forwarded receipt matches it);
    // any other unmapped peer is its account name (only an ungated
    // command reaches here unmapped). Rows say `local`: the peer is a
    // local account the kernel vouched for.
    fn context(ctx: std::api::Context) -> CommandContext {
        let source = self.reader.read();
        let person = self.roles.person(ctx.caller);
        let name = if len(person) > 0 { person } else if ctx.caller.uid == std::process::uid() { self.local_name } else { ctx.caller.name };
        return CommandContext { root: self.root, source: source, principal_mode: "local", principal_name: name };
    }
    fn refused(code: String) -> CommandReply { return CommandReply { code: code }; }
    fn reply(result: CommandResult) -> CommandReply {
        return CommandReply { ok: result.ok, code: result.code, application_id: result.source.identity, head: result.source.head, revision: result.source.revision, receipt: result.receipt };
    }
    // The operations' own rule for this operation, as GovernanceCommands
    // restates it before admission.
    fn admissible(context: CommandContext, command: CommandRequest) -> Bool {
        if !self.wire.bounded(command.request_id, 128, true, false) || !self.wire.bounded(command.target_id, 256, true, false) || !self.wire.bounded(command.subject_digest, 256, true, false) { return false; }
        let native_context = ops::GovernanceContext { application_id: command.application_id, principal_mode: context.principal_mode, principal_name: context.principal_name };
        let native = native_of(command);
        if self.attempts.known(command.operation, "1") { return self.attempts.valid(native_context, native); }
        if !self.attempts.absent(native) { return false; }
        if self.person_codec.known(command.operation, "1") { return self.person_codec.valid(native_context, native); }
        if self.create_codec.known(command.operation, "1") { return self.create_codec.valid(native_context, native); }
        if self.task_codec.known(command.operation, "1") { return self.task_codec.valid(native_context, native); }
        if self.organization_codec.known(command.operation, "1") { return self.organization_codec.valid(native_context, native); }
        return self.codec.valid(native_context, native);
    }
    fn submit(ctx: std::api::Context, command: CommandRequest) -> CommandReply {
        let context = self.context(ctx);
        if !context.source.ok { return self.refused(context.source.code); }
        let mut request = command;
        request.application_id = context.source.identity;
        if request.target_kind == "dna.record" || request.target_kind == "dna.work" || request.target_kind == "dna.friction" { request.target_id = context.source.identity; }
        request.expected_principal_mode = context.principal_mode;
        request.expected_principal_name = context.principal_name;
        if !self.admissible(context, request) { return self.refused("invalid_command"); }
        request.valid = true;
        if !self.provider.supported(request.operation, request.operation_version) { return self.refused("commands_unsupported"); }
        return self.reply(self.provider.submit(context, request));
    }
    @gated(role: position)
    fn propose(p: PracticeProposal, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: p.request_id, operation: "dna.practice.propose", target_kind: "dna.practice", target_id: p.subject_digest, subject_digest: p.subject_digest, text: p.text, rationale: p.rationale });
    }
    @gated(role: reviewer)
    fn verdict(v: ReviewDecision, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: v.request_id, operation: "dna.review.verdict", target_kind: "dna.review", target_id: v.review_id, subject_digest: v.subject_digest, expected_review_state: "pending", verdict: v.verdict, comment: v.comment });
    }
    @gated(role: owner)
    fn propose_organization(o: OrganizationProposal, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: o.request_id, operation: "dna.organization.propose", target_kind: "dna.organization.module", target_id: "dna/org/main.hl", subject_digest: o.module_digest,
            source_head: o.source_head, dependency_source: o.dependency_source, dependency_digest: o.dependency_digest, record_head: o.record_head, source_text: o.source_text, rationale: o.rationale });
    }
    fn create_task(t: TaskCreation, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: t.request_id, operation: "dna.task.create", target_kind: "dna.record", subject_digest: t.record_head, record_head: t.record_head, outcome: t.outcome, to: t.to });
    }
    @gated(role: owner)
    fn reassign_task(t: TaskReassignment, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: t.request_id, operation: "dna.task.reassign", target_kind: "dna.task", target_id: t.task_id, subject_digest: t.assignment_digest, expected_assignee: t.assignee, new_assignee: t.to });
    }
    @gated(role: owner)
    fn retire_person(p: PersonRetirement, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: p.request_id, operation: "dna.person.retire", target_kind: "dna.person", target_id: p.person, subject_digest: p.subject_digest, new_assignee: p.to });
    }
    @gated(role: position)
    fn claim(c: Claim, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: c.request_id, operation: "dna.attempt.claim", target_kind: "dna.work", subject_digest: c.record_head, record_head: c.record_head,
            performer_kind: c.performer_kind, performer: c.performer, capabilities: c.capabilities, data_classes: c.data_classes, organizations: c.organizations, ttl: c.ttl });
    }
    @gated(role: position)
    fn outcome(o: Outcome, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: o.request_id, operation: "dna.attempt.outcome", target_kind: "dna.attempt", target_id: o.attempt_id, subject_digest: lease_of(o.holder, o.token),
            attempt_id: o.attempt_id, holder: o.holder, token: o.token, disposition: o.disposition, result: o.result, result_ref: o.result_ref, narrative: o.narrative,
            evidence: if o.evidence == "[]" { "" } else { o.evidence }, receipts: if o.receipts == "[]" { "" } else { o.receipts },
            hat_digest: o.hat_digest, hat_head: o.hat_head, hat_watermark: o.hat_watermark, prompt_digest: o.prompt_digest, renderer: o.renderer });
    }
    @gated(role: position)
    fn renew(r: Renewal, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: r.request_id, operation: "dna.attempt.renew", target_kind: "dna.attempt", target_id: r.attempt_id, subject_digest: lease_of(r.holder, r.token), attempt_id: r.attempt_id, holder: r.holder, token: r.token, ttl: r.ttl });
    }
    @gated(role: position)
    fn release_attempt(r: Release, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: r.request_id, operation: "dna.attempt.release", target_kind: "dna.attempt", target_id: r.attempt_id, subject_digest: lease_of(r.holder, r.token), attempt_id: r.attempt_id, holder: r.holder, token: r.token, narrative: r.why });
    }
    @gated(role: position)
    fn file_friction(f: Friction, ctx: std::api::Context) -> CommandReply {
        return self.submit(ctx, CommandRequest { request_id: f.request_id, operation: "dna.friction.file", target_kind: "dna.friction", subject_digest: f.record_head, record_head: f.record_head, performer: f.position, attempt_id: f.attempt_id, result: f.text });
    }
    // Recovery: a command by the request id the caller minted, under the
    // provider's own recovery grant.
    fn lookup(l: Lookup, ctx: std::api::Context) -> CommandReply {
        if !self.wire.bounded(l.request_id, 128, true, false) { return self.refused("invalid_query"); }
        let context = self.context(ctx);
        if !context.source.ok { return self.refused(context.source.code); }
        return self.reply(self.provider.lookup(context, l.request_id));
    }
}

// A leased command's subject: the lease it settles under.
fn lease_of(holder: String, token: Int) -> String {
    return "lease:" + holder + "@" + to_string(token);
}
