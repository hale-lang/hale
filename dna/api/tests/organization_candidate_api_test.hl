// Actual Git admission and Body-prepared source candidate. No source apply or
// host launch is needed to read retained immutable Review evidence.
import ".." as api;
import "../../operations" as ops;
import "../../core" as dna;
import "../../organization_source" as orgsource;

const ORIGINAL: String = "main locus Org {\n    params { title: String = \"Original\"; }\n    run() { }\n}\nfn main() { Org { }; }\n";
const PREPARED: String = "// Exact équipe 🧭 <literal>\r\nmain locus Org {\n    params { title: String = \"Prepared\"; }\n    run() { }\n}\nfn main() { Org { }; }\n";

const OWNERS_BEFORE: String = "org = acme\norg/support = north\nacme: alice, carol\nnorth: bob\nhost = acme\n";
const OWNERS_AFTER: String = "# Exact équipe 🧭 <literal>\r\norg = acme\r\norg/support = south\r\nacme: alice, carol\r\nnorth: bob\r\nsouth: dora\r\nhost = acme\r\n";

locus SourceCandidateCases {
    params { ownership: Bool = false; }
    fn setup(root: String) {
        std::test::assert_eq_int(dna::run_tool("mkdir\n-p\n" + root + "/dna/org").code, 0, "isolated source directory");
        std::io::fs::write_file(root + "/dna/org/main.hl", ORIGINAL) or raise;
        if self.ownership { std::io::fs::write_file(root + "/dna/org/owners", OWNERS_BEFORE) or raise; }
        std::io::fs::write_file(root + "/.gitignore", "/.hale/\n/vendor/\n") or raise;
        let record = dna::GitRecord { repo: root };
        std::test::assert_eq_int(record.git("init\n-q\n-b\nmain").code, 0, "initialize source Git");
        std::test::assert_eq_int(record.git("add\n-A").code, 0, "track original source");
        std::test::assert_eq_int(record.git("-c\nuser.name=SourceTest\n-c\nuser.email=source@test\ncommit\n-q\n-m\nbase").code, 0, "commit original source");
        let j = dna::GitJournal { repo: root }; std::test::assert(j.append_exact(0, "application.observed", "org", "{}").ok, "Record genesis");
    }
    fn body(root: String, id: String) {
        let inputs = orgsource::OrganizationPublicationInputs { root: root, source_owner: if self.ownership { "acme" } else { "" } }; let journal = dna::GitJournal { repo: root };
        let body = dna::Dna {
            journal: journal, organization_source_facts: ops::StrictOrganizationSourceFacts { }, organization_source_inputs: inputs,
            ownership: dna::Ownership { me: if self.ownership { "acme" } else { "" }, me_env: "" },
            gateway: dna::MutationGateway { leases: dna::GitLeases { repo: root }, workspaces: dna::IsolatedWorktrees { repo: root, root: root + "/.hale/dna/worktrees" }, repo: dna::LocalGit { repo: root } },
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: root }, repo: root, scratch: root + "/.hale/dna/verification", seed: "dna/org" },
            review_policy: dna::OrgPolicy { }, membrane: dna::Board { }
        }; body.on_organization_source_requested(dna::OrganizationSourceTrigger { request_id: id });
    }
    fn first(response: std::http::Response) -> String {
        std::test::assert_eq_int(response.status, 200, response.body);
        let w = api::CommandWire { }; return std::json::array_first(w.raw(w.raw(response.body, "data"), "items")).element;
    }
    fn hidden(row: String) {
        let w = api::CommandWire { };
        std::test::assert_eq_str(w.raw(row, "text_available"), "false", "source unavailable");
        std::test::assert_eq_str(w.text(row, "question"), "", "source question masked");
        std::test::assert_eq_str(w.text(row, "settled"), "", "source settlement prose masked");
        std::test::assert_eq_str(w.text(row, "author"), "", "source proposer masked");
        std::test::assert_eq_str(w.text(row, "approvers"), "", "source owner membership masked");
        std::test::assert_eq_str(w.text(row, "organization_source_digest"), "", "source digest masked");
        std::test::assert_eq_str(w.text(row, "organization_source_request_id"), "", "source request link masked");
    }
    fn run_cases(root: String) {
        let original = if self.ownership { OWNERS_BEFORE } else { ORIGINAL };
        let prepared = if self.ownership { OWNERS_AFTER } else { PREPARED };
        let module_path = if self.ownership { "dna/org/owners" } else { "dna/org/main.hl" };
        self.setup(root); let record = dna::GitRecord { repo: root }; let app = record.identity();
        let policy_wire = ops::OrganizationAuthorityPolicyCodec { };
        let policy = policy_wire.decode("{\"format\":\"dna.organization-authority/1\",\"application_id\":\"" + app + "\",\"grants\":[{\"mode\":\"local\",\"name\":\"alice\",\"authority\":\"board\",\"organization_propose\":true,\"organization_ownership_propose\":true,\"organization_review\":false,\"recover\":true},{\"mode\":\"local\",\"name\":\"bob\",\"authority\":\"board\",\"organization_propose\":false,\"organization_review\":true,\"recover\":true}]}", app, "local");
        std::test::assert(policy.valid, "separate explicit source policy");
        let authority = ops::FixedOrganizationAuthority { policy: policy }; let inputs = orgsource::OrganizationPublicationInputs { root: root, source_owner: if self.ownership { "acme" } else { "" } };
        let service = ops::GovernanceCommands { record: record, organization_authority: authority, organization_enabled: true, organization_ownership_enabled: true, organization_inputs: inputs };
        let inspector = orgsource::OrganizationSource { root: root, allow_drafts: true }; let basis = inspector.read(); std::test::assert(basis.ok, "actual source basis");
        let alice = ops::GovernanceContext { application_id: app, principal_mode: "local", principal_name: "alice" };
        let command = ops::GovernanceCommand { request_id: "immutable-source", operation: if self.ownership { "dna.organization.ownership.propose" } else { "dna.organization.propose" }, application_id: app, target_kind: "dna.organization.module", target_id: module_path, subject_digest: dna::digest_of(original), source_head: basis.source_head, dependency_source: basis.dependency_source, dependency_digest: basis.dependency_digest, record_head: record.head("journal").id, source_text: prepared, rationale: "Clarify the exact source." };
        let admitted = service.submit(alice, command); std::test::assert(admitted.ok, "actual source admission: " + admitted.code);
        self.body(root, admitted.receipt.command_id);
        let result = service.lookup(alice, command.request_id); std::test::assert(result.ok && result.receipt.organization.proposal_state == "created", "actual candidate and Review: " + result.code);
        let snapshot = service.capture(); let journal = ops::GovernanceJournal { snapshot: snapshot }; let projection_view = ops::OrganizationProjection { };
        let candidate = projection_view.candidate(journal, result.receipt.organization.mutation_id, snapshot.text); std::test::assert(candidate.ok, "exact native proof chain");
        let reader = api::OrganizationCandidateWire { authority: authority }; let head = api::Api { root: root, local_name: "bob", organization_candidates: reader };
        let prefix = api::API_PREFIX + "/" + app; let suffix = "?id=" + dna::url_encode(candidate.mutation_id) + "&snapshot=" + snapshot.head;
        let path = prefix + "/dna/reviews/candidate" + suffix; let review_path = prefix + "/dna/reviews" + suffix;
        let response = head.handle(std::http::Request { method: "GET", path: path }); std::test::assert_eq_int(response.status, 200, response.body);
        let w = api::CommandWire { }; let data = w.raw(response.body, "data"); let document = w.text(data, "document"); let syntax = ops::OrganizationJson { };
        std::test::assert(syntax.valid(document), "closed exact evidence JSON document");
        std::test::assert_eq_str(w.text(data, "kind"), "organization_source_change", "source discriminator");
        std::test::assert_eq_str(w.text(data, "candidate_commit"), candidate.candidate_commit, "Review subject is Git commit");
        std::test::assert_eq_str(w.raw(data, "candidate_digest"), "", "source evidence is not a native Knowledge document");
        let module_data = w.raw(document, "module"); let pin = w.raw(document, "candidate"); let verify = w.raw(document, "verification");
        std::test::assert_eq_str(w.text(module_data, "base_text"), original, "exact original bytes from retained Git object");
        std::test::assert_eq_str(w.text(module_data, "text"), prepared, "exact Unicode and CRLF candidate bytes");
        std::test::assert_eq_str(w.text(module_data, "digest"), dna::digest_of(prepared), "module digest exact");
        std::test::assert_eq_str(w.text(pin, "parent"), basis.source_head, "one exact source parent");
        std::test::assert_eq_str(w.raw(document, "changed_files"), "[\"" + module_path + "\"]", "only fixed module changes");
        let semantic = w.raw(verify, "semantic_diff"); let projected = w.text(semantic, "document");
        std::test::assert_eq_str(w.text(semantic, "digest"), dna::digest_of(projected), "returned semantic projection hash is exact");
        std::test::assert_eq_str(w.text(semantic, "receipt_digest"), "sha256:" + ops::raw_digest(w.text(candidate.review_body, "diff_json")), "retained receipt digest is explicitly separate");
        std::test::assert_eq_str(w.text(projected, "coverage"), "classification_summary_declarations", "semantic coverage is explicit");
        std::test::assert_eq_str(w.text(projected, "classification"), if self.ownership { "identical" } else { "source-only" }, "actual native semantic classification");
        std::test::assert(!std::str::contains(projected, "path") && w.raw(projected, "contracts") == "" && w.raw(projected, "effects") == "", "no raw compiler location or diagnostics escape");
        std::test::assert(!std::str::contains(document, root) && !std::str::contains(document, "activation_state") && !std::str::contains(document, "application_state"), "read exposes neither local paths nor lifecycle claims");
        if self.ownership {
            std::test::assert_eq_str(w.text(document, "format"), "dna.organization-ownership-candidate/1", "ownership has a distinct exact profile");
            std::test::assert_eq_str(w.text(module_data, "path"), "dna/org/owners", "fixed ownership module");
            std::test::assert_eq_str(w.text(w.raw(document, "review"), "approvers"), "north=bob south=dora", "exact affected-owner quorum");
            let impact = w.raw(document, "ownership_impact");
            std::test::assert_eq_str(w.text(impact, "live_obligations"), "unavailable", "source comparison does not claim operational handover");
            std::test::assert(std::str::contains(impact, "north") && std::str::contains(impact, "south"), "both sides of scope transfer are visible");
            let altered = ops::OrganizationCandidateEvidence { ok: true, request: candidate.request, candidate_commit: candidate.candidate_commit, candidate_key: candidate.candidate_key, review_body: std::str::replace(candidate.review_body, "north=bob south=dora", "south=dora") };
            std::test::assert(!reader.source_objects(record, journal, altered).ok, "a reduced recorded quorum cannot expose an ownership candidate");
        }
        let review_response = head.handle(std::http::Request { method: "GET", path: review_path });
        let row = self.first(review_response);
        let evidence_root = root;
        if evidence_root != "" {
            std::io::fs::write_file(evidence_root + "/candidate-response.json", response.body) or raise;
            std::io::fs::write_file(evidence_root + "/review-response.json", review_response.body) or raise;
            std::io::fs::write_file(evidence_root + "/candidate-document.json", document) or raise;
            std::io::fs::write_file(evidence_root + "/semantic-document.json", projected) or raise;
        }
        std::test::assert_eq_str(w.raw(row, "organization_source"), "true", "source Review tagged");
        std::test::assert_eq_str(w.raw(row, "text_available"), "true", "independent reviewer recover grant permits read despite propose=false");
        let denied = api::Api { root: root, local_name: "bob" };
        std::test::assert_eq_int(denied.handle(std::http::Request { method: "GET", path: path }).status, 403, "default source authority denies");
        self.hidden(self.first(denied.handle(std::http::Request { method: "GET", path: review_path })));
        let eve = api::Api { root: root, local_name: "eve", organization_candidates: reader };
        std::test::assert_eq_int(eve.handle(std::http::Request { method: "GET", path: path }).status, 403, "unlisted actor cannot borrow source grant");
        self.hidden(self.first(eve.handle(std::http::Request { method: "GET", path: review_path })));
        // Destination edits and retired scratch are irrelevant to an immutable
        // historical read; only retained candidate/receipt objects are used.
        std::test::assert_eq_int(record.git("worktree\nremove\n--force\n" + root + "/.hale/dna/worktrees/" + candidate.mutation_id).code, 0, "remove original owned candidate workspace");
        std::io::fs::write_file(root + "/later.txt", "unrelated destination change\n") or raise;
        std::test::assert_eq_int(record.git("add\nlater.txt").code, 0, "track unrelated later file");
        std::test::assert_eq_int(record.git("-c\nuser.name=SourceTest\n-c\nuser.email=source@test\ncommit\n-q\n-m\nlater").code, 0, "move source checkout after candidate preparation");
        std::test::assert_eq_str(head.handle(std::http::Request { method: "GET", path: path }).body, response.body, "historical evidence independent of destination checkout and workspace");
        let object_read = reader.objects(record, journal, candidate); std::test::assert(object_read.ok && reader.unchanged(record, snapshot, object_read), "retained evidence fence");
        let candidate_ref = record.ref_of("candidates/" + candidate.candidate_key);
        std::test::assert_eq_int(record.git("update-ref\n" + candidate_ref + "\n" + basis.source_head).code, 0, "retained pointer mismatch fixture");
        std::test::assert(!reader.unchanged(record, snapshot, object_read), "retained pointer movement fails final fence");
        std::test::assert_eq_int(head.handle(std::http::Request { method: "GET", path: path }).status, 404, "wrong retained candidate is unavailable");
        std::test::assert_eq_int(record.git("update-ref\n" + candidate_ref + "\n" + candidate.candidate_commit).code, 0, "restore exact retained pointer");
        let diff_ref = record.ref_of("receipts/" + ops::raw_digest(w.text(semantic, "receipt_digest")));
        std::test::assert_eq_int(record.git("update-ref\n-d\n" + diff_ref).code, 0, "remove retained diff fixture");
        std::test::assert(!reader.unchanged(record, snapshot, object_read), "diff pointer loss fails final fence");
        std::test::assert_eq_int(head.handle(std::http::Request { method: "GET", path: path }).status, 404, "missing native diff is not invented");
        std::test::assert_eq_int(record.git("update-ref\n" + diff_ref + "\n" + object_read.diff_json.object).code, 0, "restore exact native diff");
        std::test::assert(record.append("journal", record.head("journal").id, dna::Row { kind: "receipt.withheld", entity: candidate.request.source_digest, author: "privacy", body: "{}" }, false, "").ok, "real source visibility input");
        std::test::assert(!reader.unchanged(record, snapshot, object_read), "new restriction changes Record fence");
        std::test::assert_eq_int(head.handle(std::http::Request { method: "GET", path: path }).status, 409, "old snapshot invalidated");
        let latest = record.head("journal").id; let hidden_suffix = "?id=" + dna::url_encode(candidate.mutation_id) + "&snapshot=" + latest;
        let protected_read = head.handle(std::http::Request { method: "GET", path: prefix + "/dna/reviews/candidate" + hidden_suffix });
        let missing = head.handle(std::http::Request { method: "GET", path: prefix + "/dna/reviews/candidate?id=missing&snapshot=" + latest });
        std::test::assert_eq_int(protected_read.status, 404, "protected source candidate hidden"); std::test::assert_eq_str(protected_read.body, missing.body, "protected and missing evidence are identical");
        self.hidden(self.first(head.handle(std::http::Request { method: "GET", path: prefix + "/dna/reviews" + hidden_suffix })));
        std::test::assert(record.append("journal", record.head("journal").id, dna::Row { kind: "review.requested", entity: "review:" + candidate.mutation_id, author: "malformed", body: "{\"question\":\"private duplicate question\"}" }, false, "").ok, "malformed duplicate input");
        let hidden_duplicate = head.handle(std::http::Request { method: "GET", path: prefix + "/dna/reviews?id=" + dna::url_encode(candidate.mutation_id) + "&snapshot=" + record.head("journal").id });
        self.hidden(self.first(hidden_duplicate)); std::test::assert(!std::str::contains(hidden_duplicate.body, "private duplicate"), "untagged later duplicate cannot remove source masking");
        eprintln("PASS immutable Organization candidate: real admission/Body, recovery grant, pinned objects, history, masking and races");
    }
}
fn main() {
    let given = std::env::arg(1);
    if len(given) > 0 { let cases = SourceCandidateCases { ownership: std::env::arg(2) == "ownership" }; cases.run_cases(given); return; }
    // under `hale test`: the main-module profile over a scratch root of its
    // own; the ownership profile is the unfinished increment of the
    // checkpoint (its runtime cases never ran) and stays by hand
    let made = dna::run_tool("mktemp\n-d\n/tmp/hale-dna-candidate.XXXXXX");
    std::test::assert_eq_int(made.code, 0, "candidate fixture scratch: " + made.stderr);
    let root = dna::trim_nl(made.stdout);
    let cases = SourceCandidateCases { }; cases.run_cases(root);
    let removed = dna::run_tool("rm\n-rf\n" + root);
}
