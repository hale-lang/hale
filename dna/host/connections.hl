// dna/host/connections.hl — cross-record handoff (GH #615).
//
// A replica of this record is inside the horizon: sync carries all of
// it, to equally trusted readers. A handoff crosses a horizon into a
// SEPARATE record: one selected fact written with its origin, lineage and
// purpose. A connection is the only path. It names the other record by
// its identity, the position this record acts as there, its purpose and
// the data classes it may carry; it is proposed as a Review for the
// Board, is in force once a board member other than its proposer approves
// it, and stays in force until it is closed.
//
// Neither record reads the other's journal (the review of #631: a
// connection that fetched the peer's journal copied its whole private
// history into this clone). A record publishes only its identity — the
// root commit of its journal, as a blob under `refs/dna/identity` — and a
// handoff is an envelope in the other record's mailbox for this record,
// `refs/dna/exchange/<this record's identity>`: a chain of rows only this
// record writes. Each record reads its own mailboxes, which its sync
// fetches from its remote. The other record admits what arrives under its
// OWN connection back, and its acceptance returns the same way: a Task
// handed across settles here only when that acceptance arrives
// (`task.transfer_accepted`).

import "../core" as dna;

const PEERS_DIR: String = ".hale/dna/peers";
const EXCHANGE_PREFIX: String = "refs/dna/exchange/";

type Connection {
    present: Bool = false;
    name: String = "";
    url: String = "";
    peer: String = ""; // the other record's identity
    position: String = "";
    purpose: String = "";
    classes: String = "";
    by: String = "";
    review_id: String = "";
    approved_by: String = "";
    settled: Bool = false;
    closed: String = ""; // why, once closed
}

type PeerWrite {
    commit: String = "";
    why: String = "";
    unreachable: Bool = false; // the peer could not be reached at all: delivered again later
}

// GH #646 stage 5 (#662): a connection whose url is a service (`http://…`)
// exchanges envelopes service to service; one whose url is a record's
// remote exchanges them as mailbox refs in a private peer cache. Both
// are the core's `Exchange`: a stable identity per envelope, delivery
// repeated after an interruption landing once, the connection's classes
// as the disclosure scope, settlement only on the receiver's acceptance.
fn service_url(url: String) -> Bool { return std::str::starts_with(url, "http://") || std::str::starts_with(url, "https://"); }

fn exchange_kind(url: String) -> String { return if service_url(url) { "service" } else { "git" }; }

fn http_failed(e: std::http::HttpError) -> std::http::ClientResponse {
    return std::http::ClientResponse { status: 0, body: std::bytes::from_string(e.kind + " " + e.detail) };
}

// A path relative to the project, made absolute (git resolves a relative
// url against the directory it runs in, which is the peer cache).
fn absolute_url(root: String, url: String) -> String {
    if std::str::starts_with(url, "/") || std::str::contains(url, "://") || std::str::contains(url, "@") { return url; }
    return rec(root).root() + "/" + url;
}

// A bare repository of this clone's own for one connection, checked to be
// its own before anything is fetched into it, so a fetch can never land in
// this project's repository. It holds the other record's identity and this
// record's mailbox there — nothing else of the other record.
fn peer_cache(root: String, name: String) -> String {
    std::io::fs::mkdir(root + "/.hale") or discard;
    std::io::fs::mkdir(root + "/.hale/dna") or discard;
    std::io::fs::mkdir(root + "/" + PEERS_DIR) or discard;
    let cache = root + "/" + PEERS_DIR + "/" + name + ".git";
    if !rec(root).private_store(cache) { return ""; }
    return cache;
}

// The identity the record at `url` publishes ("" when it publishes none):
// its service's `/identity`, or the identity ref at its remote.
fn peer_identity(root: String, name: String, url: String) -> String {
    if service_url(url) {
        let resp = std::http::get(url + "/identity") or http_failed(err);
        if resp.status != 200 { return ""; }
        return std::json::find_string_field(std::str::from_bytes(resp.body), "identity");
    }
    let cache = peer_cache(root, name);
    if len(cache) == 0 { return ""; }
    let pc = rec(cache);
    if !pc.receive(url, "peer/identity").ok { return ""; }
    return dna::trim_nl(pc.cell("peer/identity").text);
}

// This record's mailbox in the connected record, fetched fresh into the
// cache: the envelopes this record sent there, and nothing else. Its head
// as read: one that could not be read is never an empty mailbox.
fn outbound_mailbox(cache: String, c: Connection, mine: String) -> dna::Head {
    let chain = "exchange/" + mine;
    let pc = rec(cache);
    let dropped = pc.drop_chain(chain);
    let fetched = pc.receive(c.url, chain);
    return pc.head(chain);
}

// One envelope into the connected record's mailbox for this record,
// pushed there under compare-and-swap, re-read and re-appended when it moved.
@unbounded
fn peer_append(root: String, c: Connection, kind: String, entity: String, body: String, author: String) -> PeerWrite {
    let mine = record_identity(root);
    if len(mine) == 0 { return PeerWrite { why: "this record has no identity yet (no journal)" }; }
    if service_url(c.url) {
        // unreachable is not "another record": a service that does not
        // answer is delivered to again later
        let probe = std::http::get(c.url + "/identity") or http_failed(err);
        if probe.status == 0 { return PeerWrite { why: "the other record's service cannot be reached (" + std::str::from_bytes(probe.body) + "); deliver again later", unreachable: true }; }
        if probe.status != 200 || std::json::find_string_field(std::str::from_bytes(probe.body), "identity") != c.peer { return PeerWrite { why: c.url + " no longer serves record " + short(c.peer) }; }
        let e = std::json::Builder { };
        e.begin_object();
        e.string_field("kind", kind);
        e.string_field("entity", entity);
        e.string_field("body", body);
        e.string_field("author", author);
        e.end_object();
        let resp = std::http::post(c.url + "/exchange/" + dna::url_encode(mine), std::bytes::from_string(e.result()), "application/json") or http_failed(err);
        let text = std::str::from_bytes(resp.body);
        if resp.status == 0 { return PeerWrite { why: "the other record's service cannot be reached (" + text + "); deliver again later", unreachable: true }; }
        if resp.status != 200 { return PeerWrite { why: "the other record's service refused the envelope: " + std::json::find_string_field(text, "error") }; }
        return PeerWrite { commit: std::json::find_string_field(text, "ref") };
    }
    let chain = "exchange/" + mine;
    let mut tries = 0;
    while tries < 5 {
        tries = tries + 1;
        let cache = peer_cache(root, c.name);
        if len(cache) == 0 { return PeerWrite { why: "no cache for connection " + c.name }; }
        if peer_identity(root, c.name, c.url) != c.peer { return PeerWrite { why: c.url + " no longer serves record " + short(c.peer) }; }
        let pc = rec(cache);
        let read = outbound_mailbox(cache, c, mine);
        if !read.ok { return PeerWrite { why: "this record's mailbox in the other record could not be read (" + read.why + "); deliver again later", unreachable: true }; }
        let before = read.id;
        let commit = pc.build(before, dna::Row { kind: kind, entity: entity, body: body, author: author }, false, "");
        if len(commit) == 0 { return PeerWrite { why: "the envelope could not be written" }; }
        if !pc.move_chain(chain, commit, "*") { continue; }
        if pc.share(c.url, chain, if len(before) == 0 { "new" } else { before }).ok { return PeerWrite { commit: commit }; }
    }
    return PeerWrite { why: "the other record's mailbox kept moving; nothing was written" };
}

// The commit in this record's mailbox in the connected record that carries
// an envelope of `kind` about `entity` (`commit` "" when none is there): a
// handoff retried after its envelope landed and before this record's own
// row did reuses it instead of writing a second (#637). A mailbox that
// could not be read says so in `why` and is never one without the
// envelope: taken for that, the envelope was written twice (GH #961).
@unbounded
fn delivered_commit(root: String, c: Connection, kind: String, entity: String) -> PeerWrite {
    if service_url(c.url) {
        let mine = record_identity(root);
        let resp = std::http::get(c.url + "/exchange/has?sender=" + dna::url_encode(mine) + "&kind=" + dna::url_encode(kind) + "&entity=" + dna::url_encode(entity)) or http_failed(err);
        if resp.status != 200 { return PeerWrite { }; }
        if !std::json::find_bool_field(std::str::from_bytes(resp.body), "has") { return PeerWrite { }; }
        return PeerWrite { commit: mine + "/" + kind + "/" + entity };
    }
    let cache = peer_cache(root, c.name);
    if len(cache) == 0 { return PeerWrite { }; }
    let mine = record_identity(root);
    let head = outbound_mailbox(cache, c, mine);
    if !head.ok { return PeerWrite { why: "this record's mailbox in the other record could not be read (" + head.why + ")", unreachable: true }; }
    if head.absent { return PeerWrite { }; }
    let pc = rec(cache);
    // the k-th row of the mailbox is its k-th id (oldest first)
    let ids = pc.ids("exchange/" + mine);
    let mut rest = pc.text_at(head.id);
    let mut k = 0;
    let mut found = -1;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(dna::trim_nl(line)) == 0 { continue; }
        if std::json::find_string_field(line, "kind") == kind && std::json::find_string_field(line, "entity") == entity { found = k; }
        k = k + 1;
    }
    if found < 0 { return PeerWrite { }; }
    return PeerWrite { commit: dna::line_at(ids, found) };
}

// The envelope rows a mailbox holds ("" when absent): a ref in this
// clone, or `service:<sender>` — the envelopes that sender put in this
// record's service.
@unbounded
fn mailbox_text(root: String, ref: String) -> String {
    if std::str::starts_with(ref, "service:") {
        let sender = ref[8..len(ref)];
        let mut out = "";
        let mut rest = service_mailboxes(root);
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = if nl < 0 { rest } else { rest[0..nl] };
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            if std::json::find_string_field(line, "sender") == sender { out = out + line + "\n"; }
        }
        return out;
    }
    let chain = if std::str::starts_with(ref, "refs/dna/") { ref[9..len(ref)] } else { ref };
    // a lookup: a mailbox that could not be read lists nothing, as the
    // service branch above lists nothing for a service that does not answer
    let r = rec(root);
    return r.text_at(r.head(chain).id);
}

// The sender a mailbox ref names.
fn mailbox_sender(ref: String) -> String {
    if std::str::starts_with(ref, "service:") { return ref[8..len(ref)]; }
    return ref[len(EXCHANGE_PREFIX)..len(ref)];
}

// Every envelope in this record's service ("" with no service known here).
fn service_mailboxes(root: String) -> String {
    let url = knowledge_url(root);
    if len(url) == 0 { return ""; }
    let resp = std::http::get(url + "/exchange") or http_failed(err);
    if resp.status != 200 { return ""; }
    return std::str::from_bytes(resp.body);
}

// The rows a peer put in this record's mailboxes, by either exchange.
fn mailbox_text_for(root: String, peer: String) -> String {
    return mailbox_text(root, EXCHANGE_PREFIX + peer) + mailbox_text(root, "service:" + peer);
}

// This clone's inbound mailboxes (its sync fetches them from its remote),
// newline-separated ref names.
@unbounded
fn mailboxes(root: String) -> String {
    let mut out = "";
    let mut rest = rec(root).pointers("exchange");
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let name = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(name) > 0 { out = out + "refs/dna/" + name + "\n"; }
    }
    // and the senders with envelopes in this record's service, once each
    let mut senders = "\n";
    let mut lines = service_mailboxes(root);
    while len(lines) > 0 {
        let nl = std::str::index_of(lines, "\n");
        let line = if nl < 0 { lines } else { lines[0..nl] };
        lines = if nl < 0 { "" } else { lines[(nl + 1)..len(lines)] };
        let sender = std::json::find_string_field(line, "sender");
        if len(sender) > 0 && !std::str::contains(senders, "\n" + sender + "\n") { senders = senders + sender + "\n"; out = out + "service:" + sender + "\n"; }
    }
    return out + "\n";
}

// A connection as the record has it: its latest proposal, an approval by
// a board member other than its proposer (a verified row under signed
// trust), its Review's settlement, its closing.
@unbounded
fn connection_of(p: Projection, name: String) -> Connection {
    let ent = "connection:" + name;
    let signed = trust_mode(p.root) == "signed";
    let mut c = Connection { };
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "connection.proposed" && e.entity == ent {
            let b = e.body;
            c = Connection {
                present: true, name: name,
                url: std::json::find_string_field(b, "url"),
                peer: std::json::find_string_field(b, "peer"),
                position: std::json::find_string_field(b, "position"),
                purpose: std::json::find_string_field(b, "purpose"),
                classes: std::json::find_string_field(b, "classes"),
                by: std::json::find_string_field(b, "by"),
                review_id: std::json::find_string_field(b, "review_id")
            };
        } else if c.present && e.kind == "review.verdict" && p.review_id_of(e) == c.review_id && len(c.approved_by) == 0 && len(c.closed) == 0 && (!signed || row_verified(p.root, e.digest)) {
            let reviewer = std::json::find_string_field(e.body, "reviewer");
            if std::json::find_string_field(e.body, "verdict") == "approve" && std::json::find_string_field(e.body, "authority") == "board" && reviewer != c.by { c.approved_by = reviewer; }
        } else if c.present && e.kind == "review.settled" && p.review_id_of(e) == c.review_id {
            c.settled = true;
        } else if c.present && e.kind == "connection.closed" && e.entity == ent {
            c.closed = std::json::find_string_field(e.body, "why");
        }
        i = i + 1;
    }
    return c;
}

fn connection_live(c: Connection) -> Bool { return c.present && len(c.approved_by) > 0 && len(c.closed) == 0; }

fn connection_state(c: Connection) -> String {
    if len(c.closed) > 0 { return "closed: " + c.closed; }
    if len(c.approved_by) > 0 { return "in force (approved by " + c.approved_by + ")"; }
    return "proposed: Review " + c.review_id + " needs an approval by a board member other than " + c.by;
}

// An approved connection's Review is settled once, in its approver's name.
fn settle_connection(root: String, c: Connection) {
    if len(c.approved_by) == 0 || c.settled { return; }
    let ok = append_as(root, "review.settled", "review:" + c.review_id, "approve by " + c.approved_by + " (board): connection `" + c.name + "` in force", c.approved_by);
}

// The connection names the record holds, newline-separated, first-proposed first.
@unbounded
fn connection_names(p: Projection) -> String {
    let mut names = "\n";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "connection.proposed" && std::str::starts_with(e.entity, "connection:") {
            let name = e.entity[11..len(e.entity)];
            if !std::str::contains(names, "\n" + name + "\n") { names = names + name + "\n"; }
        }
        i = i + 1;
    }
    return names;
}

// The connection in force to record `peer`, if any.
@unbounded
fn connection_to(p: Projection, peer: String) -> Connection {
    let mut rest = connection_names(p);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let name = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(name) == 0 { continue; }
        let c = connection_of(p, name);
        if connection_live(c) && c.peer == peer { return c; }
    }
    return Connection { };
}

// ---- hale dna connect | disconnect ------------------------------------

@unbounded
fn connect_verb(root: String, seed: String, url_in: String, name: String, position: String, purpose: String, classes: String, by_flag: String) -> Answer {
    if len(url_in) == 0 { return connections_list(root, seed); }
    if len(name) == 0 || len(position) == 0 || len(purpose) == 0 || len(classes) == 0 {
        return fail("connect: `hale dna connect <record-url> --name <name> --as <position> --purpose <purpose> --classes <internal,customer,…> [--by <who>]`");
    }
    let bad_name = dna::connection_name_refusal(name);
    if len(bad_name) > 0 { return fail("connect: " + bad_name); }
    let bad_classes = dna::classes_refusal(classes);
    if len(bad_classes) > 0 { return fail("connect: " + bad_classes); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let prior = connection_of(p, name);
    if prior.present && len(prior.closed) == 0 { return fail("connect: a connection `" + name + "` exists (" + connection_state(prior) + ")"); }
    let url = absolute_url(root, url_in);
    let peer = peer_identity(root, name, url);
    if len(peer) == 0 { return fail("connect: no record identity at " + url + " (`" + IDENTITY_REF + "`; a record publishes it when it syncs — `hale dna sync` there)"); }
    if peer == record_identity(root) { return fail("connect: " + url + " serves this record itself; a replica is inside the horizon and sync carries it — a connection crosses to a separate record"); }
    let published = publish_identity(root);
    let by = if len(by_flag) > 0 { by_flag } else { who_am_i() };
    let review_id = "c-" + name + "-" + to_string(p.rows());
    let norm = dna::classes_normal(classes);
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("name", name);
    b.string_field("url", url);
    b.string_field("peer", peer);
    b.string_field("position", position);
    b.string_field("purpose", purpose);
    b.string_field("classes", norm);
    b.string_field("by", by);
    b.string_field("review_id", review_id);
    b.string_field("exchange", exchange_kind(url));
    b.end_object();
    if !append_as(root, "connection.proposed", "connection:" + name, b.result(), by) { return fail("the record refused the append"); }
    let question = "connect this record to record " + short(peer) + " at " + url + " as `" + position + "` for `" + purpose + "`, carrying " + norm + "?";
    let q = std::json::Builder { };
    q.begin_object();
    q.string_field("question", question);
    q.string_field("subject_digest", peer);
    q.string_field("required_authority", "board");
    q.string_field("author", by);
    q.string_field("kind", "connection");
    q.string_field("target", position);
    q.end_object();
    if !append_as(root, "review.requested", "review:" + review_id, q.result(), by) { return fail("the record refused the append"); }
    let s2 = sync_record(root);
    return answer("connection " + name + " proposed: record " + short(peer) + " at " + url + " (" + exchange_kind(url) + " exchange), as `" + position + "`, for `" + purpose + "`, carrying " + norm + "\nthe Board decides it: `hale dna review " + review_id + " approve --authority board`, by someone other than " + by + "\n");
}

@unbounded
fn connections_list(root: String, seed: String) -> Answer {
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let mut out = "";
    let mut n = 0;
    let mut rest = connection_names(p);
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let name = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(name) == 0 { continue; }
        let c = connection_of(p, name);
        settle_connection(root, c);
        out = out + "  " + name + " → record " + short(c.peer) + " (" + c.url + ") as `" + c.position + "` for `" + c.purpose + "`, carrying " + c.classes + " — " + connection_state(c) + "\n";
        n = n + 1;
    }
    return answer("connections: " + (if n == 0 { "none" } else { to_string(n) }) + "\n" + out);
}

fn disconnect_verb(root: String, seed: String, name: String, why: String, by_flag: String) -> Answer {
    if len(name) == 0 || len(why) == 0 { return fail("disconnect: `hale dna disconnect <name> --why <why> [--by <who>]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let c = connection_of(p, name);
    if !c.present { return fail("disconnect: no connection `" + name + "`"); }
    if len(c.closed) > 0 { return fail("disconnect: `" + name + "` is already closed: " + c.closed); }
    let by = if len(by_flag) > 0 { by_flag } else { who_am_i() };
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("by", by);
    b.string_field("why", why);
    b.end_object();
    if !append_as(root, "connection.closed", "connection:" + name, b.result(), by) { return fail("the record refused the append"); }
    let s2 = sync_record(root);
    return answer("connection " + name + " closed by " + by + ": " + why + "; its history stays in both records, and nothing further crosses it\n");
}

// ---- hale dna handoff -------------------------------------------------

@unbounded
fn handoff_publish_verb(root: String, seed: String, name: String, kind: String, subject_in: String, note: String, who_flag: String) -> Answer {
    if (kind != "task" && kind != "receipt") || len(subject_in) == 0 {
        return fail("handoff: `hale dna handoff <connection> task <id> | receipt <digest> [--note …] [--as <who>]`, `handoff accept <id>`, `handoff sync`, or `hale dna handoff` to list");
    }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let c = connection_of(p, name);
    if !c.present { return fail("handoff: no connection `" + name + "`; `hale dna connect <record-url> --name " + name + " …` proposes one"); }
    settle_connection(root, c);
    if len(c.closed) > 0 { return fail("handoff: connection `" + name + "` is closed (" + c.closed + "): nothing further crosses it"); }
    if len(c.approved_by) == 0 { return fail("handoff: connection `" + name + "` is " + connection_state(c)); }
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    let mine = record_identity(root);
    let published = publish_identity(root);
    let mut subject = subject_in;
    let mut class = "internal";
    let mut fact = "";
    if kind == "task" {
        let t = p.task_of(subject);
        if len(t.id) == 0 { return fail("handoff: no Task `" + subject + "` in the record"); }
        if t.state != "handed" { return fail("handoff: Task `" + subject + "` is " + t.state + "; only a person's job, handed and not yet transferred, crosses to another record"); }
        fact = t.outcome;
    } else {
        subject = dna::evidence_digest(subject_in);
        if !dna::digest_well_formed(subject) { return fail("handoff: `" + subject_in + "` is not a receipt digest (sha256:<64 hex digits>)"); }
        let mut known = receipt_read(root, subject[7..len(subject)]).present;
        let mut redacted = false;
        let mut i = 0;
        while i < p.rows() {
            let e = p.row(i);
            if e.entity == subject {
                if e.kind == "receipt.filed" || e.kind == "receipt.classified" || e.kind == "receipt.withheld" { known = true; class = std::json::find_string_field(e.body, "class"); }
                if e.kind == "receipt.redacted" { redacted = true; }
            }
            i = i + 1;
        }
        if !known { return fail("handoff: no receipt " + subject + " in the record"); }
        if redacted { return fail("handoff: receipt " + subject + " is redacted"); }
        fact = subject + " (" + class + "; its body stays in this record)";
    }
    // the subject's lineage here, and the row it is handed from
    let mut lineage = "";
    let mut source = "";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.entity == subject {
            lineage = lineage + (if len(lineage) > 0 { " " } else { "" }) + e.kind + "#" + to_string(e.seq);
            source = if len(e.digest) > 0 { e.digest } else { dna::digest_of(e.kind + "\n" + e.entity + "\n" + e.body) };
        }
        i = i + 1;
    }
    let hid = dna::handoff_id(mine, c.peer, kind, subject);
    if !dna::classes_allow(c.classes, class) {
        let why = "`" + class + "` does not cross connection `" + name + "` (it carries " + c.classes + ")";
        let rb = std::json::Builder { };
        rb.begin_object();
        rb.string_field("connection", name);
        rb.string_field("kind", kind);
        rb.string_field("subject", subject);
        rb.string_field("class", class);
        rb.string_field("by", who);
        rb.string_field("why", why);
        rb.end_object();
        let refused = append_as(root, "handoff.refused", "handoff:" + hid, rb.result(), who);
        let s3 = sync_record(root);
        return fail("handoff: " + why + "; refused at the edge (handoff.refused), nothing was written across");
    }
    if p.has_row("handoff.published", "handoff:" + hid) {
        // published, and a crash before the Task's own row: the row now (#637)
        if kind == "task" && !has_row(p, "task.transfer_requested", subject, "\"handoff\": \"" + hid + "\"") {
            let rb = std::json::Builder { };
            rb.begin_object();
            rb.string_field("connection", name);
            rb.string_field("peer", c.peer);
            rb.string_field("handoff", hid);
            rb.string_field("by", who);
            rb.end_object();
            if !append_as(root, "task.transfer_requested", subject, rb.result(), who) { return fail("the record refused the append"); }
            let sr = sync_record(root);
            return answer("handoff " + hid + ": task " + subject + " was already written into record " + short(c.peer) + "; its transfer is recorded here now\n");
        }
        return fail("handoff: " + kind + " " + subject + " was already handed into record " + short(c.peer) + " as " + hid);
    }
    let remote = record_remote(root);
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("handoff", hid);
    b.string_field("origin_record", mine);
    b.string_field("origin_url", if len(remote) > 0 { rec(root).remote_url(remote) } else { "" });
    b.string_field("origin_author", who);
    b.string_field("origin_row", source);
    b.string_field("lineage", lineage);
    b.string_field("purpose", c.purpose);
    b.string_field("position", c.position);
    b.string_field("via", name);
    b.string_field("kind", kind);
    b.string_field("subject", subject);
    b.string_field("class", class);
    b.string_field("fact", fact);
    b.string_field("note", note);
    b.end_object();
    // an envelope already in the other record's mailbox (a crash after it
    // landed and before this record's row) is not written twice (#637)
    let existing = delivered_commit(root, c, "handoff.received", "handoff:" + hid);
    let landed = if len(existing.commit) > 0 || len(existing.why) > 0 { existing } else { peer_append(root, c, "handoff.received", "handoff:" + hid, b.result(), who) };
    if len(landed.commit) == 0 { return fail("handoff: " + landed.why + "; nothing was recorded here" + (if landed.unreachable { " — `hale dna handoff " + name + " " + kind + " " + subject_in + "` again delivers it" } else { "" })); }
    let pb = std::json::Builder { };
    pb.begin_object();
    pb.string_field("connection", name);
    pb.string_field("peer", c.peer);
    pb.string_field("kind", kind);
    pb.string_field("subject", subject);
    pb.string_field("class", class);
    pb.string_field("purpose", c.purpose);
    pb.string_field("peer_row", landed.commit);
    pb.string_field("by", who);
    pb.string_field("note", note);
    // the envelope as delivered: a delivery the peer lost is made again from it
    pb.string_field("envelope", b.result());
    pb.end_object();
    if !append_as(root, "handoff.published", "handoff:" + hid, pb.result(), who) { return fail("handoff: written into record " + short(c.peer) + "'s mailbox as " + short(landed.commit) + ", but this record refused the append"); }
    if kind == "task" {
        let tb = std::json::Builder { };
        tb.begin_object();
        tb.string_field("connection", name);
        tb.string_field("peer", c.peer);
        tb.string_field("handoff", hid);
        tb.string_field("by", who);
        tb.end_object();
        let t = append_as(root, "task.transfer_requested", subject, tb.result(), who);
    }
    let s2 = sync_record(root);
    return answer("handoff " + hid + ": " + kind + " " + subject + " [" + class + "] written into record " + short(c.peer) + "'s mailbox as " + short(landed.commit) + ", for `" + c.purpose + "`" + (if kind == "task" { "; the Task settles here when that record accepts it (`hale dna handoff sync`)" } else { "" }) + "\n");
}

// Why a received handoff is not admitted here ("" when it is): a
// connection in force back to its origin record, carrying its class.
fn admission_refusal(p: Projection, body: String) -> String {
    let origin = std::json::find_string_field(body, "origin_record");
    let class = std::json::find_string_field(body, "class");
    let c = connection_to(p, origin);
    if !c.present { return "no connection in force to record " + short(origin) + ": this record admits nothing from it (`hale dna connect <its url>`)"; }
    if !dna::classes_allow(c.classes, class) { return "`" + class + "` does not cross connection `" + c.name + "` (it carries " + c.classes + ")"; }
    return "";
}

// A received envelope: its row line from this clone's mailboxes, the one a
// mailbox holds under its own sender's name ("" when none).
@unbounded
fn received_line(root: String, entity: String) -> String {
    let mut refs = mailboxes(root);
    while len(refs) > 0 {
        let nl = std::str::index_of(refs, "\n");
        let ref = if nl < 0 { refs } else { refs[0..nl] };
        refs = if nl < 0 { "" } else { refs[(nl + 1)..len(refs)] };
        if len(ref) == 0 { continue; }
        let sender = mailbox_sender(ref);
        let mut rest = mailbox_text(root, ref);
        while len(rest) > 0 {
            let lnl = std::str::index_of(rest, "\n");
            let line = if lnl < 0 { rest } else { rest[0..lnl] };
            rest = if lnl < 0 { "" } else { rest[(lnl + 1)..len(rest)] };
            if std::json::find_string_field(line, "kind") != "handoff.received" { continue; }
            if len(entity) > 0 && std::json::find_string_field(line, "entity") != entity { continue; }
            // a row claiming another origin than the mailbox it is in is not its sender's
            if std::json::find_string_field(std::json::find_string_field(line, "body"), "origin_record") != sender { continue; }
            return line;
        }
    }
    return "";
}

@unbounded
fn handoff_list_verb(root: String, seed: String) -> Answer {
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let mut sent = "";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "handoff.published" {
            let b = e.body;
            let back = if p.has_row("handoff.accepted_by_peer", e.entity) { "accepted there" } else { "awaiting acceptance" };
            sent = sent + "  " + e.entity[8..len(e.entity)] + " → " + std::json::find_string_field(b, "connection") + ": " + std::json::find_string_field(b, "kind") + " " + std::json::find_string_field(b, "subject") + " [" + std::json::find_string_field(b, "class") + "] by " + std::json::find_string_field(b, "by") + " — " + back + "\n";
        }
        i = i + 1;
    }
    let mut got = "";
    let mut refs = mailboxes(root);
    while len(refs) > 0 {
        let nl = std::str::index_of(refs, "\n");
        let ref = if nl < 0 { refs } else { refs[0..nl] };
        refs = if nl < 0 { "" } else { refs[(nl + 1)..len(refs)] };
        if len(ref) == 0 { continue; }
        let sender = mailbox_sender(ref);
        let mut rest = mailbox_text(root, ref);
        while len(rest) > 0 {
            let lnl = std::str::index_of(rest, "\n");
            let line = if lnl < 0 { rest } else { rest[0..lnl] };
            rest = if lnl < 0 { "" } else { rest[(lnl + 1)..len(rest)] };
            if std::json::find_string_field(line, "kind") != "handoff.received" { continue; }
            let ent = std::json::find_string_field(line, "entity");
            let b = std::json::find_string_field(line, "body");
            if std::json::find_string_field(b, "origin_record") != sender { continue; }
            let why = admission_refusal(p, b);
            let c = connection_to(p, sender);
            let state = if p.has_row("handoff.accepted", ent) { "accepted" } else if len(why) == 0 { "admitted under `" + c.name + "`" } else { "not admitted: " + why };
            got = got + "  " + ent[8..len(ent)] + " ← " + std::json::find_string_field(b, "kind") + " " + std::json::find_string_field(b, "subject") + " from record " + short(sender) + " (" + std::json::find_string_field(b, "origin_author") + " as `" + std::json::find_string_field(b, "position") + "`, for `" + std::json::find_string_field(b, "purpose") + "`) [" + std::json::find_string_field(b, "class") + "] " + std::json::find_string_field(b, "fact") + " · lineage " + std::json::find_string_field(b, "lineage") + " — " + state + "\n";
        }
    }
    return answer("handed across: " + (if len(sent) == 0 { "none\n" } else { "\n" + sent }) + "received: " + (if len(got) == 0 { "none\n" } else { "\n" + got }));
}

@unbounded
fn handoff_accept_verb(root: String, seed: String, hid: String, note: String, who_flag: String) -> Answer {
    if len(hid) == 0 { return fail("handoff accept: `hale dna handoff accept <id> [--note …] [--as <who>]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let ent = "handoff:" + hid;
    let line = received_line(root, ent);
    if len(line) == 0 { return fail("handoff accept: no handoff `" + hid + "` received in this record's mailboxes"); }
    let body = std::json::find_string_field(line, "body");
    let why = admission_refusal(p, body);
    if len(why) > 0 { return fail("handoff accept: " + hid + " is not admitted — " + why); }
    let origin = std::json::find_string_field(body, "origin_record");
    let c = connection_to(p, origin);
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    let already = p.has_row("handoff.accepted", ent);
    let accepted = if already { delivered_commit(root, c, "handoff.accepted", ent) } else { PeerWrite { } };
    if len(accepted.why) > 0 { return fail("handoff accept: " + accepted.why + "; nothing was recorded here"); }
    if len(accepted.commit) > 0 { return fail("handoff accept: " + hid + " is already accepted"); }
    if !already {
        // admitted into this record: the fact, with its origin and purpose
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("by", who);
        b.string_field("note", note);
        b.string_field("connection", c.name);
        b.string_field("origin_record", origin);
        b.string_field("origin_author", std::json::find_string_field(body, "origin_author"));
        b.string_field("origin_row", std::json::find_string_field(body, "origin_row"));
        b.string_field("lineage", std::json::find_string_field(body, "lineage"));
        b.string_field("purpose", std::json::find_string_field(body, "purpose"));
        b.string_field("kind", std::json::find_string_field(body, "kind"));
        b.string_field("subject", std::json::find_string_field(body, "subject"));
        b.string_field("class", std::json::find_string_field(body, "class"));
        b.string_field("fact", std::json::find_string_field(body, "fact"));
        b.end_object();
        if !append_as(root, "handoff.accepted", ent, b.result(), who) { return fail("the record refused the append"); }
        let s2 = sync_record(root);
    }
    // the acceptance goes back into the origin's mailbox for this record
    let ab = std::json::Builder { };
    ab.begin_object();
    ab.string_field("by", who);
    ab.string_field("note", note);
    ab.string_field("origin_record", origin);
    ab.string_field("connection", c.name);
    ab.end_object();
    let back = peer_append(root, c, "handoff.accepted", ent, ab.result(), who);
    if len(back.commit) == 0 { return fail("handoff accept: " + hid + " is accepted here, but the acceptance could not reach record " + short(origin) + " (" + back.why + "); `hale dna handoff accept " + hid + "` again delivers it"); }
    return answer("handoff " + hid + " accepted by " + who + " under connection `" + c.name + "`: " + std::json::find_string_field(body, "kind") + " " + std::json::find_string_field(body, "subject") + " from record " + short(origin) + "; that record settles it when it reads this acceptance\n");
}

// Every connection in force: the acceptances its other record sent to this
// record's own mailbox, each admitted once. A closed connection is not read.
@unbounded
fn handoff_sync_verb(root: String, seed: String) -> Answer {
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let mine = record_identity(root);
    let mut out = "";
    let mut n = 0;
    let mut names = connection_names(p);
    while len(names) > 0 {
        let nl = std::str::index_of(names, "\n");
        let name = if nl < 0 { names } else { names[0..nl] };
        names = if nl < 0 { "" } else { names[(nl + 1)..len(names)] };
        if len(name) == 0 { continue; }
        let c = connection_of(p, name);
        if len(c.closed) > 0 { out = out + "  " + name + ": closed — nothing admitted from it\n"; continue; }
        if !connection_live(c) { continue; }
        // durable delivery (#662): a handoff published here whose envelope
        // the peer does not hold — a delivery interrupted, a mailbox lost —
        // is delivered again, once, from the envelope kept with the row
        let mut k = 0;
        while k < p.rows() {
            let e = p.row(k);
            k = k + 1;
            if e.kind != "handoff.published" || std::json::find_string_field(e.body, "connection") != name { continue; }
            if p.has_row("handoff.accepted_by_peer", e.entity) { continue; }
            let envelope = std::json::find_string_field(e.body, "envelope");
            if len(envelope) == 0 { continue; }
            let held = delivered_commit(root, c, "handoff.received", e.entity);
            if len(held.why) > 0 { out = out + "  " + name + ": " + e.entity[8..len(e.entity)] + " not checked: " + held.why + "\n"; continue; }
            if len(held.commit) > 0 { continue; }
            let again = peer_append(root, c, "handoff.received", e.entity, envelope, std::json::find_string_field(e.body, "by"));
            out = out + "  " + name + ": " + e.entity[8..len(e.entity)] + (if len(again.commit) > 0 { " delivered again (the other record did not hold it)" } else { " not delivered: " + again.why }) + "\n";
        }
        let mut rest = mailbox_text_for(root, c.peer);
        while len(rest) > 0 {
            let lnl = std::str::index_of(rest, "\n");
            let line = if lnl < 0 { rest } else { rest[0..lnl] };
            rest = if lnl < 0 { "" } else { rest[(lnl + 1)..len(rest)] };
            if std::json::find_string_field(line, "kind") != "handoff.accepted" { continue; }
            let ent = std::json::find_string_field(line, "entity");
            let body = std::json::find_string_field(line, "body");
            if std::json::find_string_field(body, "origin_record") != mine { continue; }
            if !has_row(p, "handoff.published", ent, "\"connection\": \"" + name + "\"") { continue; }
            let mut kind = "";
            let mut subject = "";
            let mut i = 0;
            while i < p.rows() {
                let e = p.row(i);
                if e.kind == "handoff.published" && e.entity == ent { kind = std::json::find_string_field(e.body, "kind"); subject = std::json::find_string_field(e.body, "subject"); }
                i = i + 1;
            }
            // each row on its own, so a crash between the two is completed at
            // the next sync instead of suppressing it (#637)
            let peer_row = p.has_row("handoff.accepted_by_peer", ent);
            let transfer = kind == "task" && !has_row(p, "task.transfer_accepted", subject, "\"handoff\": \"" + ent[8..len(ent)] + "\"");
            if peer_row && !transfer { continue; }
            let by = std::json::find_string_field(body, "by");
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("connection", name);
            b.string_field("peer", c.peer);
            b.string_field("handoff", ent[8..len(ent)]);
            b.string_field("accepted_by", by);
            b.string_field("note", std::json::find_string_field(body, "note"));
            b.end_object();
            if !peer_row {
                if !append_as(root, "handoff.accepted_by_peer", ent, b.result(), "") { return fail("the record refused the append"); }
            }
            if transfer {
                if !append_as(root, "task.transfer_accepted", subject, b.result(), "") { return fail("the record refused the append"); }
            }
            out = out + "  " + ent[8..len(ent)] + ": " + kind + " " + subject + " accepted by " + by + " in record " + short(c.peer) + "\n";
            n = n + 1;
        }
    }
    let s2 = sync_record(root);
    return answer("handoff sync: " + to_string(n) + " acceptance(s) admitted\n" + out);
}
