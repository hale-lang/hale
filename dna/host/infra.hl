// dna/host/infra.hl — what a body runs on, and how a head reaches it,
// as the reference tools implement it (GH #647). The interfaces are the
// core's (`dna::Infrastructure`, `dna::Transport`, infrastructure.hl);
// this is the one file in the host that spells `ssh`, `systemctl`,
// `journalctl` and `docker compose`. The host picks an implementation
// by `HALE_DNA_TRANSPORT` (`ssh`, the default; `local` runs every
// script in this machine's shell, for fixtures) and never spells a tool
// itself: a body without systemd, a database not started by compose, a
// transport that is not ssh plug in here, by implementation.

import "../core" as dna;

// ---- transports -------------------------------------------------------------

// Over ssh, `-o BatchMode=yes` so nothing ever prompts inside a tool.
// A script goes to the body's shell from a private file (it can carry
// a credential: a DSN, a secret's line), never on the command line.
locus SshTransport {
    params { scratch: String = ".hale/dna"; }
    fn kind() -> String { return "ssh"; }
    fn probe(target: String) -> dna::Facts {
        let r = dna::run_tool(
            "sh\n-c\nssh -o BatchMode=yes -o ConnectTimeout=15 \"$1\" 'command -v git >/dev/null && echo git=yes || echo git=no; command -v systemctl >/dev/null && echo systemd=yes || echo systemd=no; docker compose version >/dev/null 2>&1 && echo compose=yes || echo compose=no; command -v curl >/dev/null && echo curl=yes || echo curl=no; uname -sm'\nsh\n"
                + target,
        );
        if r.code != 0 { return dna::Facts { why: dna::trim_nl(r.stderr) }; }
        return dna::Facts { reachable: true, facts: r.stdout };
    }
    // `stdin` empty: the script is the body's shell's input (`sh -s`).
    // Otherwise the script is the command and `stdin` is its input —
    // the shape a secret's install takes, the value never in argv.
    fn execute(target: String, script: String, stdin: String) -> dna::RunResult {
        let tmp = self.scratch + "/transport." + to_string(std::process::pid()) + ".tmp";
        let mk = dna::run_tool(
            "sh\n-c\numask 077 && mkdir -p \"$(dirname \"$1\")\" && : > \"$1\"\nsh\n" + tmp,
        );
        if mk.code != 0 {
            return dna::RunResult { code: -1, stderr: "cannot create " + tmp + " privately" };
        }
        let w = write_text(tmp, if len(stdin) == 0 { script } else { stdin }) or false;
        if !w { return dna::RunResult { code: -1, stderr: "cannot write " + tmp }; }
        let r = if len(stdin) == 0 {
            dna::run_tool(
                "sh\n-c\nssh -o BatchMode=yes -o ConnectTimeout=15 \"$1\" 'sh -s' < \"$2\"\nsh\n"
                    + target + "\n" + tmp,
            )
        } else {
            dna::run_tool(
                "sh\n-c\nssh -o BatchMode=yes -o ConnectTimeout=15 \"$1\" \"$2\" < \"$3\"\nsh\n"
                    + target + "\n" + script + "\n" + tmp,
            )
        };
        std::io::fs::unlink(tmp) or discard;
        return r;
    }
}

// This machine's shell as the body's: every script runs here, under
// the HOME the fixture names (HALE_DNA_TRANSPORT_HOME), so what a
// provisioning writes lands where the fixture looks, with no tool
// stubbed on PATH to stand in for ssh.
locus LocalTransport {
    params { home: String = ""; scratch: String = ".hale/dna"; }
    fn kind() -> String { return "local"; }
    fn probe(target: String) -> dna::Facts {
        // Asked in the body's environment, as `execute` runs there: the
        // fixture's home and its stubs first on PATH. Asking this
        // machine's own PATH answered for the developer's box — no
        // systemd on a Mac — instead of for the body (GH #970).
        let env = if len(self.home) > 0 {
            "export HOME=\"" + self.home + "\" PATH=\"" + self.home + "/.hale/bin:$PATH\"; "
        } else {
            ""
        };
        let r = dna::run_tool(
            "sh\n-c\n" + env
                + "command -v git >/dev/null && echo git=yes || echo git=no; command -v systemctl >/dev/null && echo systemd=yes || echo systemd=no; docker compose version >/dev/null 2>&1 && echo compose=yes || echo compose=no; command -v curl >/dev/null && echo curl=yes || echo curl=no; uname -sm",
        );
        return dna::Facts { reachable: true, facts: r.stdout };
    }
    fn execute(target: String, script: String, stdin: String) -> dna::RunResult {
        let tmp = self.scratch + "/transport." + to_string(std::process::pid()) + ".tmp";
        let mk = dna::run_tool(
            "sh\n-c\numask 077 && mkdir -p \"$(dirname \"$1\")\" && : > \"$1\"\nsh\n" + tmp,
        );
        if mk.code != 0 {
            return dna::RunResult { code: -1, stderr: "cannot create " + tmp + " privately" };
        }
        let w = write_text(tmp, if len(stdin) == 0 { script } else { stdin }) or false;
        if !w { return dna::RunResult { code: -1, stderr: "cannot write " + tmp }; }
        // the fixture's home is the body's: its stubs on PATH, its files
        let home = if len(self.home) > 0 {
            "export HOME=\"" + self.home + "\" PATH=\"" + self.home
                + "/.hale/bin:$PATH\"; cd \"$HOME\"; "
        } else {
            ""
        };
        let r = if len(stdin) == 0 {
            dna::run_tool("sh\n-c\n" + home + "sh -s < \"$1\"\nsh\n" + tmp)
        } else {
            dna::run_tool("sh\n-c\n" + home + "sh -c \"$1\" < \"$2\"\nsh\n" + script + "\n" + tmp)
        };
        std::io::fs::unlink(tmp) or discard;
        return r;
    }
}

// The transport the host uses: ssh unless HALE_DNA_TRANSPORT says
// `local` (then HALE_DNA_TRANSPORT_HOME is the body's home).
fn transport_kind() -> String {
    let t = std::env::var("HALE_DNA_TRANSPORT");
    return if len(t) == 0 { "ssh" } else { t };
}

// ---- the reference infrastructure -------------------------------------------
//
// compose for the knowledge database, a systemd user unit for the
// supervisor, an env file under ~/.config/hale-dna for the owner's DSN
// (a credential a person supplies fills its slot of the vault, GH #989) —
// each reached through the transport at `target` ("" is this machine).
// The three compose independently: choosing a database never chooses a
// deployment platform.

locus ReferenceInfrastructure {
    params {
        root: String = ".";
        target: String = ""; // "" = this machine
        ssh: SshTransport = SshTransport { };
        local: LocalTransport = LocalTransport { };
        last: String = "";
    }
    fn kind() -> String { return "compose+systemd+envfile"; }
    fn run_at(script: String, stdin: String) -> dna::RunResult {
        if len(self.target) == 0 { return self.local.execute("", script, stdin); }
        if transport_kind() == "local" {
            self.local.home = std::env::var("HALE_DNA_TRANSPORT_HOME");
            return self.local.execute(self.target, script, stdin);
        }
        return self.ssh.execute(self.target, script, stdin);
    }
    fn probe(target: String) -> dna::Facts {
        if transport_kind() == "local" {
            self.local.home = std::env::var("HALE_DNA_TRANSPORT_HOME");
            return self.local.probe(target);
        }
        return self.ssh.probe(target);
    }
    // GH #1653: an organism's memory, nerves and senses' store are the local
    // habitat's allocations for it (dna/core/memory_spine.hl), brought up
    // here when they are not, by the compose provider: one compose project
    // per machine, a service per allocation named for the organism and the
    // role, never a checkout's.
    // `why` says what is needed instead, when there is no docker compose or
    // the organism has no identity yet.
    fn allocation(role: String) -> String {
        if len(dna::allocation_key(self.root)) == 0 {
            return "the organism has no record identity yet: its allocations in the local habitat are named for it (`hale habitat graft` pins one)";
        }
        if dna::run_tool("docker\ncompose\nversion").code != 0 {
            return "the local habitat's " + role
                + " runs under docker compose, which is not on PATH";
        }
        return "";
    }
    // Whether the organism's allocations were ever written: a command that
    // only reads them writes nothing into the habitat.
    fn allocated() -> Bool {
        let dir = dna::allocation_dir(self.root);
        return len(dir) > 0
            && std::io::fs::file_exists(dir + "/compose.yaml")
            && std::io::fs::file_exists(dir + "/ports.yaml");
    }
    // `service`'s published `inner` port, as `host:port`, "" when it is not up.
    fn published(service: String, inner: String) -> String {
        if !self.allocated() { return ""; }
        // placed off this machine: the host's name and the port the
        // allocation publishes there (dna/core/placement.hl)
        let dash = std::str::index_of(service, "-");
        let elsewhere = if dash > 0 {
            dna::placed_address(dna::allocation_key(self.root), service[0..dash])
        } else {
            ""
        };
        if len(elsewhere) > 0 { return elsewhere; }
        let port = dna::run_tool(
            dna::allocation_compose(self.root) + "\nport\n" + service + "\n" + inner,
        );
        let hp = dna::trim_nl(port.stdout);
        if port.code != 0 || std::str::index_of(hp, ":") < 0 { return ""; }
        return hp;
    }
    // The organism's memory, its allocation brought up when it is not: the
    // owner's DSN.
    fn knowledge_database(project: String) -> dna::Database {
        let not = self.allocation("memory");
        if len(not) > 0 {
            return dna::Database {
                why: not + "; or set HALE_DNA_MEMORY_DSN_OWNER to a Postgres of your own",
            };
        }
        // GH #989: the superuser's password is the vault's, and reaches the
        // server through the file compose mounts: both before `up`, which
        // would otherwise make a directory where the file belongs
        let key = dna::allocation_key(self.root);
        let owner = std::secret::Credential { vault: postgres_owner_vault(key) };
        if !owner.ready() || !std::io::fs::file_exists(postgres_secrets_path(self.root)) {
            return dna::Database {
                why: "the memory allocation's password is not provisioned ("
                    + postgres_owner_vault(key)
                    + " in the vault, and its file beside the allocation; `hale dna upgrade` provisions them, `hale dna secrets` lists them)",
            };
        }
        let service = dna::allocation_service(self.root, "memory");
        // its files written the first time, then brought up where it is
        // placed, by that host's provider
        if len(dna::allocation_compose(self.root)) == 0 {
            return dna::Database { why: "the allocation's files could not be written" };
        }
        let up = dna::placed_apply(key, "memory");
        if !up.ok { return dna::Database { why: up.why }; }
        let hp = self.published(service, "5432");
        if len(hp) == 0 {
            return dna::Database { why: "cannot read the memory allocation's port from compose" };
        }
        // a database made with another password adopts the vault's, from
        // the file compose mounts (read inside the container, never on a
        // command line)
        let adopt = "printf \"ALTER USER dna PASSWORD '%s';\\n\" \"$(cat /run/secrets/postgres-owner)\" | psql -q -v ON_ERROR_STOP=1 -U dna -d dna";
        let mut tries = 0;
        let mut adopted = dna::placed_exec(key, "memory", adopt);
        while adopted.code != 0 && tries < 20 {
            std::time::sleep(500ms);
            tries = tries + 1;
            adopted = dna::placed_exec(key, "memory", adopt);
        }
        if adopted.code != 0 {
            return dna::Database {
                why: "the memory allocation did not take the vault's password: "
                    + dna::trim_nl(adopted.stderr),
            };
        }
        // the owner's DSN names the vault entry, never the password: the
        // connection presents it in its handshake
        return dna::Database {
            present: true,
            dsn: "postgres://dna@" + hp + "/dna?sslmode=disable&vault=" + postgres_owner_vault(key),
        };
    }
    // The organism's memory, when its allocation is already up: the owner's
    // DSN, never bringing it up (GH #1653: only the habitat's acts do).
    fn knowledge_database_if_up() -> dna::Database {
        let service = dna::allocation_service(self.root, "memory");
        if len(service) == 0 {
            return dna::Database {
                why: "the organism has no record identity yet: its memory is the local habitat's allocation named for it (`hale habitat graft` pins one)",
            };
        }
        let hp = if dna::run_tool("docker\ncompose\nversion").code == 0 {
            self.published(service, "5432")
        } else {
            ""
        };
        if len(hp) == 0 {
            return dna::Database {
                why: "the organism's memory allocation in the local habitat (" + service
                    + ") is not up: `hale habitat migrate " + self.root
                    + "` brings it up and migrates it; or set HALE_DNA_MEMORY_DSN_OWNER to a Postgres of your own",
            };
        }
        return dna::Database {
            present: true,
            dsn: "postgres://dna@" + hp + "/dna?sslmode=disable&vault="
                + postgres_owner_vault(dna::allocation_key(self.root)),
        };
    }
    // The organism's senses' store, when its allocation is already up.
    fn senses_if_up() -> dna::Database {
        let service = dna::allocation_service(self.root, "senses");
        let hp = if len(service) > 0 && dna::run_tool("docker\ncompose\nversion").code == 0 {
            self.published(service, "9090")
        } else {
            ""
        };
        if len(hp) == 0 {
            return dna::Database {
                why: "the organism's senses' store in the local habitat is not up (`hale habitat migrate "
                    + self.root + "` brings it up)",
            };
        }
        return dna::Database { present: true, dsn: "http://" + hp };
    }
    // The organism's allocation for `role`, restarted when it is up (GH
    // #989: a server that reads a secrets file rereads it); "" when it was
    // not up or restarted, else why not.
    fn restart_if_up(role: String) -> String {
        let service = dna::allocation_service(self.root, role);
        if len(service) == 0
            || !self.allocated()
            || dna::run_tool("docker\ncompose\nversion").code != 0
        {
            return "";
        }
        let up = dna::run_tool(dna::allocation_compose(self.root) + "\nps\n-q\n" + service);
        if up.code != 0 || len(dna::trim_nl(up.stdout)) == 0 { return ""; }
        let r = dna::run_tool(dna::allocation_compose(self.root) + "\nrestart\n" + service);
        return if r.code == 0 {
            ""
        } else {
            "exit " + to_string(r.code) + ": " + dna::trim_nl(r.stderr)
        };
    }
    // The organism's nerves (GH #986), its allocation brought up when it is
    // not: its URL, without a user.
    fn nerves_server(project: String) -> dna::Database {
        let not = self.allocation("nerves");
        if len(not) > 0 {
            return dna::Database {
                why: not + "; or set " + dna::NATS_OWNER_URL_ENV + " to a NATS server of your own",
            };
        }
        let service = dna::allocation_service(self.root, "nerves");
        // its files written the first time, then brought up where it is
        // placed, by that host's provider
        if len(dna::allocation_compose(self.root)) == 0 {
            return dna::Database { why: "the allocation's files could not be written" };
        }
        let up = dna::placed_apply(dna::allocation_key(self.root), "nerves");
        if !up.ok { return dna::Database { why: up.why }; }
        let hp = self.published(service, "4222");
        if len(hp) == 0 {
            return dna::Database { why: "cannot read the nerves allocation's port from compose" };
        }
        return dna::Database { present: true, dsn: "nats://" + hp };
    }
    // The organism's nerves if their allocation is up, never brought up from
    // here: its URL, without a user ("" when it is not up).
    fn nerves_if_up() -> String {
        let service = dna::allocation_service(self.root, "nerves");
        if len(service) == 0 || dna::run_tool("docker\ncompose\nversion").code != 0 { return ""; }
        let hp = self.published(service, "4222");
        return if len(hp) > 0 { "nats://" + hp } else { "" };
    }
    // The organism's senses' store (GH #988), its allocation brought up when
    // it is not: its read URL.
    fn senses_store(project: String) -> dna::Database {
        let not = self.allocation("senses' store");
        if len(not) > 0 { return dna::Database { why: not }; }
        let service = dna::allocation_service(self.root, "senses");
        // its files written the first time, then brought up where it is
        // placed, by that host's provider
        if len(dna::allocation_compose(self.root)) == 0 {
            return dna::Database { why: "the allocation's files could not be written" };
        }
        let up = dna::placed_apply(dna::allocation_key(self.root), "senses");
        if !up.ok { return dna::Database { why: up.why }; }
        let hp = self.published(service, "9090");
        if len(hp) == 0 {
            return dna::Database { why: "cannot read the senses' store's port from compose" };
        }
        return dna::Database { present: true, dsn: "http://" + hp };
    }
    // ---- the supervisor: a systemd user unit
    fn unit_name(name: String) -> String { return "hale-dna-" + name; }
    fn install_unit(name: String, unit: String) -> Bool {
        let script = "umask 077; mkdir -p \"$HOME/.config/systemd/user\"; cat > \"$HOME/.config/systemd/user/"
            + self.unit_name(name) + ".service\" <<'UNIT'\n" + unit
            + "UNIT\nloginctl enable-linger \"$USER\" >/dev/null 2>&1 || true; systemctl --user daemon-reload";
        let r = self.run_at(script, "");
        self.last = dna::trim_nl(r.stderr + r.stdout);
        return r.code == 0;
    }
    fn start(name: String) -> Bool {
        let r = self.run_at(
            "systemctl --user enable --now " + self.unit_name(name)
                + " && systemctl --user is-active " + self.unit_name(name),
            "",
        );
        self.last = dna::trim_nl(r.stdout + r.stderr);
        return r.code == 0;
    }
    // A stopped unit is `inactive`, and `is-active` exits non-zero for
    // it: stop succeeds when the unit is no longer active.
    fn stop(name: String) -> Bool {
        let u = self.unit_name(name);
        let r = self.run_at(
            "systemctl --user stop " + u + " || exit 1; if systemctl --user is-active --quiet " + u
                + "; then echo still active; exit 1; else echo inactive; fi",
            "",
        );
        self.last = dna::trim_nl(r.stdout + r.stderr);
        return r.code == 0;
    }
    fn status(name: String) -> dna::UnitStatus {
        let r = self.run_at("systemctl --user is-active " + self.unit_name(name), "");
        let detail = dna::trim_nl(r.stdout + r.stderr);
        self.last = detail;
        return dna::UnitStatus { known: len(detail) > 0, active: r.code == 0, detail: detail };
    }
    fn logs(name: String, lines: Int) -> String {
        let r = self.run_at(
            "journalctl --user -u " + self.unit_name(name) + " -n " + to_string(lines)
                + " --no-pager 2>/dev/null || tail -n " + to_string(lines)
                + " \"$HOME\"/dna/*/.hale/dna/org.log",
            "",
        );
        self.last = dna::trim_nl(r.stderr);
        return r.stdout;
    }
    // ---- credentials: a slot of the vault where the body runs (GH #989:
    // the local vault's directory, mode 600), the value on the shell's
    // stdin, never in argv
    fn put_credential(vault: String, value: String) -> Bool {
        if !std::secret::vault_name_is_safe(vault) {
            self.last = "the vault name " + vault + " is not safe";
            return false;
        }
        let install = "umask 077; d=\"${HALE_VAULT_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hale/vault}\"; f=\"$d/"
            + vault
            + "\"; mkdir -p \"$d\"; cat > \"$f.tmp\" && mv \"$f.tmp\" \"$f\" && echo \"$f\"";
        // the value whole on the shell's stdin, as it was given (several
        // lines, no newline added)
        let r = self.run_at(install, value);
        self.last = dna::trim_nl(r.stdout + r.stderr);
        return r.code == 0;
    }
    fn credential(vault: String) -> dna::Credential {
        let r = self.run_at(
            "f=\"${HALE_VAULT_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hale/vault}/" + vault
                + "\"; [ -s \"$f\" ] && echo present || echo absent",
            "",
        );
        return dna::Credential { name: vault, present: std::str::contains(r.stdout, "present") };
    }
    // ---- the pieces a provisioning script is composed from
    // The supervisor's part: the unit written and enabled.
    // (`$NAME` is the script's own variable: the plan a dry run prints
    // names the unit as the body's shell will)
    fn supervisor_fragment(name: String, unit: String) -> String {
        return "umask 077; mkdir -p \"$HOME/.config/systemd/user\" \"$HOME/.config/hale-dna\"\n"
            + "cat > \"$HOME/.config/systemd/user/hale-dna-$NAME.service\" <<'UNIT'\n" + unit
            + "UNIT\n"
            + "loginctl enable-linger \"$USER\" >/dev/null 2>&1 || true\n"
            + "systemctl --user daemon-reload && systemctl --user enable --now \"hale-dna-$NAME\" && echo \"unit hale-dna-$NAME enabled and started (systemctl --user)\"\n";
    }
    // The database's part: a DSN given lands in the env file; none
    // given means the body's local habitat, under docker compose, which it
    // must have. GH #1653: provisioning is the habitat's act, so the body's
    // memory and nerves are migrated here, once, and the unit's `dev`
    // migrates nothing.
    fn database_fragment() -> String {
        return "if [ -n \"$DSN\" ]; then f=\"$HOME/.config/hale-dna/$NAME.env\"; { [ -f \"$f\" ] && grep -v '^HALE_DNA_MEMORY_DSN_OWNER=' \"$f\" || true; echo \"HALE_DNA_MEMORY_DSN_OWNER=$DSN\"; } > \"$f.tmp\" && mv \"$f.tmp\" \"$f\"; echo \"memory: the DSN given\"; else docker compose version >/dev/null 2>&1 || { echo \"no docker compose on the body and no --dsn: memory has to come from one of them\"; exit 4; }; echo \"memory: the body's local habitat\"; fi\n"
            + "HALE_DNA_MEMORY_DSN_OWNER=\"$DSN\" hale habitat migrate . >/dev/null || { echo \"the organism's memory and nerves did not migrate on the body (hale habitat migrate)\"; exit 4; }; echo \"memory and nerves: migrated (hale habitat migrate)\"\n";
    }
    // What the probe must have found for this infrastructure to be
    // installable; "" when it can.
    fn missing(facts: String, dsn: String) -> String {
        if std::str::contains(facts, "git=no") {
            return "has no git; the body clones the record with it";
        }
        if std::str::contains(facts, "systemd=no") {
            return "has no systemd (`systemctl`); the reference supervisor is a user unit — write your own supervisor around `hale dna dev . --no-iris`";
        }
        if std::str::contains(facts, "curl=no") {
            return "has no curl; the toolchain installs with it";
        }
        if len(dsn) == 0 && std::str::contains(facts, "compose=no") {
            return "has no docker compose and no --dsn was given; memory has to come from one of them";
        }
        return "";
    }
}

// ---- a repository's compose services (ruling 11, 2026-10-12) ----------------
//
// In repository mode the compose file at the repository's root is the
// expression. The body brings its services up (`up -d --wait`: running,
// and healthy where a service declares a healthcheck), looks at them every
// COMPOSE_CHECK seconds and brings up again one that is gone, and brings
// them down when it stops. The project is the organism's own
// (`<record schema>-<application>`), so two organisms on one machine, or a
// person's own `docker compose up` of the same file, never share
// containers. Compose runs without the organism's credentials in its
// environment (the ones an application's start removes, procs.hl), so a
// compose file cannot interpolate them; what it is handed of the nerves is
// the application's, the variables `env` names.
const COMPOSE_CHECK: Int = 10;
// How long `up` waits for the services to be running and healthy (scaled
// by HALE_DNA_WAIT_SCALE): a first start pulls images.
const COMPOSE_WAIT: Int = 300;
// The vault entry holding the application's broker password, as a path:
// compose mounts that file read-only as a secret (`secrets: file:`), so
// the password is never copied, never in an environment and never in the
// repository (GH #989: the vault is its one ingress).
const NATS_APP_SECRET_ENV: String = "HALE_DNA_NATS_SECRET_APP";
// Which body owns the services compose brought up, beside org.pid and
// app.pid under .hale/dna, written before `up`: the host's pid, the body's
// mark, the project, the compose file, the project directory and the
// override that labels every service with the mark (COMPOSE_LABEL), a line
// each. Both files are the body's own — `compose.owner.<key>` and
// `compose.body.<key>.yaml`, keyed by its lease token and host pid
// (`compose_key`) — so a body creates, reads and removes only its own, and
// a replacement host on the same clone never loses its files to the
// cleanup of the body before it. The body fence reads the lost body's when
// its host is gone (`fence_compose_down`); a host starting sweeps those of
// bodies whose host is gone (`compose_sweep`).
const COMPOSE_OWNER: String = "compose.owner.";
const COMPOSE_OVERRIDE: String = "compose.body.";

// The key of a body's compose files: its mark's lease token and host pid
// (`<holder>#<token>#<pid>#`), a file name's characters only.
fn compose_key(mark: String) -> String {
    let m = if std::str::ends_with(mark, "#") { mark[0..(len(mark) - 1)] } else { mark };
    let p = last_index_of(m, "#");
    if p <= 0 { return dna::nerves_token(m); }
    let q = last_index_of(m[0..p], "#");
    return dna::nerves_token(m[(q + 1)..len(m)]);
}
fn compose_owner_path(dir: String, mark: String) -> String {
    return dir + "/" + COMPOSE_OWNER + compose_key(mark);
}
fn compose_override_path(dir: String, mark: String) -> String {
    return dir + "/" + COMPOSE_OVERRIDE + compose_key(mark) + ".yaml";
}
const COMPOSE_LABEL: String = "hale.dna.body";
// How a body's compose services go, by the host and by the fence alike:
// the containers of the project that carry the body's mark — the daemon's
// own label filter, evaluated per container, so a replacement body's
// containers in the same project (another clone of the record on this
// daemon, labelled with its own mark) are never among them — stopped
// within `grace` seconds (0: at once) and removed; then the project's
// networks, which the daemon refuses to remove while any container is
// attached, so one a replacement uses stays. Volumes are never removed.
// Never a project-wide `docker compose down`: that acts on whatever the
// project holds at that moment, a replacement's services included.
// Arguments: project, mark, grace.
const COMPOSE_REMOVE_MARKED: String = "proj=$1 mark=$2 grace=$3; ours=$(docker ps -aq --filter \"label=com.docker.compose.project=$proj\" --filter \"label="
    + COMPOSE_LABEL
    + "=$mark\") || exit 1; if [ -n \"$ours\" ]; then if [ \"$grace\" -gt 0 ]; then docker stop --time \"$grace\" $ours >/dev/null 2>&1; fi; docker rm -f $ours >/dev/null || exit 1; fi; for n in $(docker network ls -q --filter \"label=com.docker.compose.project=$proj\"); do docker network rm \"$n\" >/dev/null 2>&1 || true; done";

// The repository's compose file, where compose itself looks for one; ""
// when there is none.
fn compose_file_at(root: String) -> String {
    if std::io::fs::file_exists(root + "/compose.yaml") { return root + "/compose.yaml"; }
    if std::io::fs::file_exists(root + "/compose.yml") { return root + "/compose.yml"; }
    if std::io::fs::file_exists(root + "/docker-compose.yaml") {
        return root + "/docker-compose.yaml";
    }
    if std::io::fs::file_exists(root + "/docker-compose.yml") {
        return root + "/docker-compose.yml";
    }
    return "";
}

// The organism's compose project for its repository's services.
fn compose_project(record_id: String, app: String) -> String {
    return dna::schema_for(record_id) + "-"
        + (if len(app) > 0 { dna::nerves_app_name(app) } else { "app" });
}

locus RepositoryCompose {
    params {
        root: String = ".";
        file: String = ""; // the compose file ("" none)
        project: String = "";
        // `NAME=value` lines compose is handed, beside what it inherits
        env: String = "";
        // brought up by this body, and brought down when it stops
        active: Bool = false;
        checked: Int = 0; // when the services were last looked at
        last: String = "";
        // the ownership record, the labelling override and the mark (own)
        owner: String = "";
        override: String = "";
        mark: String = "";
    }
    // `docker compose` on this project and file, newline-separated, run
    // under `env` without the organism's credentials and with `self.env`
    fn base() -> String {
        return "env\n-u\n" + std::str::replace(APPLICATION_UNSET, " ", "\n-u\n") + "\n" + self.env
            + "docker\ncompose\n-p\n" + self.project + "\n-f\n" + self.file
            + (if len(self.override) > 0 { "\n-f\n" + self.override } else { "" })
            + "\n--project-directory\n" + self.root;
    }
    // Before `up`: every service labelled with the body's mark, and the
    // record of who owns them, so the body fence can bring down what this
    // body brought up when the host is gone, and only that. "" when both
    // are written, else why not.
    fn own(dir: String, host_pid: Int, mark: String) -> String {
        let record = compose_owner_path(dir, mark);
        let labels = compose_override_path(dir, mark);
        let script = "ovr=$1 rec=$2 pid=$3 mark=$4 proj=$5 file=$6 pdir=$7; shift 7; svcs=$(\"$@\" config --services) || exit 1; umask 077; { echo services:; for s in $svcs; do printf '  %s:\\n    labels:\\n      "
            + COMPOSE_LABEL
            + ": \"%s\"\\n' \"$s\" \"$mark\"; done; } > \"$ovr\" && printf '%s\\n' \"$pid\" \"$mark\" \"$proj\" \"$file\" \"$pdir\" \"$ovr\" > \"$rec\"";
        let r = dna::run_tool(
            "sh\n-c\n" + script + "\nsh\n" + labels + "\n" + record + "\n" + to_string(host_pid)
                + "\n" + mark + "\n" + self.project + "\n" + self.file + "\n" + self.root + "\n"
                + self.base(),
        );
        if r.code != 0 { return dna::last_line(dna::trim_nl(r.stderr)); }
        self.owner = record;
        self.override = labels;
        self.mark = mark;
        return "";
    }
    fn argv(args: String) -> String { return self.base() + "\n" + args; }
    // Hand compose a variable (no newline in it: none of these carries one).
    fn hand(name: String, value: String) { self.env = self.env + name + "=" + value + "\n"; }
    // Up, waited for: "" when every service is running (and healthy where it
    // declares a healthcheck), else why not.
    fn up(wait: Int) -> String {
        // from here on something may be up: it goes down with the body
        self.active = true;
        let r = dna::run_tool(
            self.argv("up\n-d\n--wait\n--wait-timeout\n" + to_string(wait) + "\n--remove-orphans"),
        );
        self.checked = std::time::now();
        if r.code != 0 { return dna::last_line(dna::trim_nl(r.stderr + "\n" + r.stdout)); }
        return "";
    }
    // The services, one a line.
    fn services() -> String {
        let r = dna::run_tool(self.argv("config\n--services"));
        return if r.code == 0 { dna::trim_nl(r.stdout) } else { "" };
    }
    // Every COMPOSE_CHECK seconds: a service with no container, or whose
    // container stopped other than by finishing (exit 0), is brought up
    // again. One compose itself is restarting (its `restart:` policy) is
    // left to it. What it did, "" when nothing.
    fn check(now: Int) -> String {
        if !self.active || now - self.checked < COMPOSE_CHECK { return ""; }
        self.checked = now;
        let script = "all=$(\"$@\" config --services) || exit 1; st=$(\"$@\" ps -a --format '{{.Service}} {{.State}} {{.ExitCode}}') || exit 1; printf '%s\\n' \"$st\" | awk -v all=\"$all\" 'BEGIN { n = split(all, a, \"\\n\"); for (i = 1; i <= n; i++) if (a[i] != \"\") want[a[i]] = 1 } { seen[$1] = 1; if ($2 != \"running\" && $2 != \"restarting\" && !($2 == \"exited\" && $3 == \"0\")) print $1 \" \" $2 \" \" $3 } END { for (s in want) if (!(s in seen)) print s \" gone\" }'";
        let r = dna::run_tool("sh\n-c\n" + script + "\nsh\n" + self.base());
        if r.code != 0 { return ""; }
        let down = dna::trim_nl(r.stdout);
        if len(down) == 0 { return ""; }
        let again = dna::run_tool(self.argv("up\n-d\n--remove-orphans"));
        let said = std::str::replace(down, "\n", ", ");
        if again.code != 0 {
            return "compose: " + said + "; bringing it up again failed: "
                + dna::last_line(dna::trim_nl(again.stderr));
        }
        return "compose: " + said + "; brought up again";
    }
    // Down with the body: "" when it went, else why not.
    // Its containers stopped within 10s and removed, as the fence would
    // (COMPOSE_REMOVE_MARKED): this exit may be one whose lease is already
    // lost (`stop_body`), with a replacement's services in the project.
    fn down() -> String {
        if !self.active { return ""; }
        self.active = false;
        if len(self.mark) == 0 { return ""; }
        let r = dna::run_tool(
            "sh\n-c\n" + COMPOSE_REMOVE_MARKED + "\nsh\n" + self.project + "\n" + self.mark
                + "\n10",
        );
        if r.code != 0 { return dna::last_line(dna::trim_nl(r.stderr)); }
        if len(self.owner) > 0 { std::io::fs::unlink(self.owner) or discard; }
        if len(self.override) > 0 { std::io::fs::unlink(self.override) or discard; }
        return "";
    }
}

// The body fence's share of a lost body (`fence_stop`): the compose
// services the host at `host_pid` brought up, removed — when the ownership
// record under `dir` is that host's and names `mark` — by
// COMPOSE_REMOVE_MARKED, at once: only containers carrying `mark` go, so a
// replacement body's services in the same project stay whenever they
// start. A record another body wrote (a replacement host on this clone) is
// left, with its services. The record and its override — the lost body's
// own files, never another body's — go once its containers are gone.
fn fence_compose_down(dir: String, host_pid: Int, mark: String) -> String {
    let script = "f=$1 pid=$2 mark=$3; [ -f \"$f\" ] || exit 0; { read -r p; read -r m; read -r proj; read -r file; read -r pdir; read -r ovr; } < \"$f\"; [ \"$p\" = \"$pid\" ] && [ \"$m\" = \"$mark\" ] || { echo \"not this body's: $proj\"; exit 0; }; sh -c \"$4\" sh \"$proj\" \"$mark\" 0 || { echo \"this body's containers of $proj not removed\"; exit 0; }; rm -f \"$f\" \"$ovr\"; echo \"removed this body's containers of $proj\"";
    let r = dna::run_tool(
        "sh\n-c\n" + script + "\nsh\n" + compose_owner_path(dir, mark) + "\n" + to_string(host_pid)
            + "\n" + mark + "\n" + COMPOSE_REMOVE_MARKED,
    );
    return dna::trim_nl(r.stdout + r.stderr);
}

// When a host starts its compose services: the records of other bodies of
// this clone whose host is gone (a fence that died with it, or never ran)
// have their containers removed by their mark, as the fence would, and
// then their files. A record whose host still runs is that body's, and its
// fence's, to settle. The marks swept, one a line.
fn compose_sweep(dir: String, own_mark: String) -> String {
    let script = "dir=$1 own=$2 rm=$3; for f in \"$dir\"/" + COMPOSE_OWNER
        + "*; do [ -f \"$f\" ] || continue; [ \"$f\" = \"$own\" ] && continue; { read -r p; read -r m; read -r proj; read -r file; read -r pdir; read -r ovr; } < \"$f\"; [ -n \"$p\" ] && ps -p \"$p\" >/dev/null 2>&1 && continue; sh -c \"$rm\" sh \"$proj\" \"$m\" 0 || continue; rm -f \"$f\" \"$ovr\"; echo \"$m\"; done";
    let r = dna::run_tool(
        "sh\n-c\n" + script + "\nsh\n" + dir + "\n" + compose_owner_path(dir, own_mark) + "\n"
            + COMPOSE_REMOVE_MARKED,
    );
    return dna::trim_nl(r.stdout);
}

// ---- the habitat's forge (phase 4 ruling) ----------------------------------

// The habitat's Forgejo up and answering, its administrator made: "" once
// it is, else why not. The administrator's password is drawn into the vault
// the first time (dna::FORGEJO_ADMIN_VAULT) and reaches the server through
// the file compose mounts, read inside the container by its root shell,
// never on a command line of this machine's.
fn forgejo_up() -> String {
    if dna::run_tool("docker\ncompose\nversion").code != 0 {
        return "the habitat's forge runs under docker compose, which is not on PATH";
    }
    let argv = dna::forgejo_compose();
    if len(argv) == 0 { return "cannot make " + dna::forgejo_dir(); }
    if !secret_present(dna::FORGEJO_ADMIN_VAULT) {
        let value = draw_secret();
        if len(value) == 0 { return "no randomness for the forge administrator's password"; }
        let put = vault_put(dna::FORGEJO_ADMIN_VAULT, value);
        if len(put) > 0 { return put; }
    }
    let secret = dna::forgejo_dir() + "/admin.secret";
    if dna::run_tool(
        "sh\n-c\numask 077 && cp \"$1\" \"$2\" && chmod 600 \"$2\"\nsh\n"
            + std::secret::vault_local_dir() + "/" + dna::FORGEJO_ADMIN_VAULT + "\n" + secret,
    ).code != 0 {
        return "cannot write " + secret;
    }
    let up = dna::run_tool_timeout(600, argv + "\nup\n-d\n--quiet-pull\nforge");
    if up.code != 0 { return "the habitat's forge did not come up: " + dna::trim_nl(up.stderr); }
    if !forgejo_healthy(120) {
        return "the habitat's forge did not answer at " + dna::forgejo_address() + " within 120 s";
    }
    let listed = forgejo_exec("su-exec git forgejo admin user list --admin");
    if std::str::contains(listed.stdout, " " + dna::FORGEJO_ADMIN + " ") { return ""; }
    let made = forgejo_exec(
        "su-exec git forgejo admin user create --admin --username " + dna::FORGEJO_ADMIN
            + " --email " + dna::FORGEJO_ADMIN
            + "@habitat.invalid --must-change-password=false --password \"$(cat /run/secrets/forgejo-admin)\" >/dev/null",
    );
    if made.code != 0 {
        return "the forge's administrator was not made: " + dna::trim_nl(made.stderr);
    }
    return "";
}

// `script` run by the habitat's Forgejo container's shell.
fn forgejo_exec(script: String) -> dna::RunResult {
    return dna::run_tool(dna::forgejo_compose() + "\nexec\n-T\nforge\nsh\n-c\n" + script);
}

// Whether the habitat's Forgejo answers healthy within `secs`.
fn forgejo_healthy(secs: Int) -> Bool {
    let deadline = std::time::now() + secs;
    while std::time::now() <= deadline {
        let u = std::http::parse_url(dna::reach_url(dna::forgejo_address()) + "/api/healthz") or {
            return false;
        };
        let r = std::http::request(
            std::http::ClientRequest { method: "GET", url: u, body: b"" },
        ) or std::http::ClientResponse {
            status: 0,
            body: b""
        };
        if r.status == 200 { return true; }
        std::time::sleep(500ms);
    }
    return false;
}

// The Forgejo user `user` the organism keyed `key` is, made when it is not,
// and its token drawn into the vault slot dna::forgejo_vault(key) when the
// vault holds none: "" once both are, else why not. Its password is
// Forgejo's own random one, never read; the token goes from the server
// into the vault and nowhere else.
fn forgejo_user(user: String, key: String) -> String {
    let listed = forgejo_exec("su-exec git forgejo admin user list");
    if !std::str::contains(listed.stdout, " " + user + " ") {
        let made = forgejo_exec(
            "su-exec git forgejo admin user create --username " + user + " --email " + user
                + "@habitat.invalid --random-password --must-change-password=false >/dev/null",
        );
        if made.code != 0 {
            return "the forge's user " + user + " was not made: " + dna::trim_nl(made.stderr);
        }
    }
    let slot = dna::forgejo_vault(key);
    if secret_present(slot) { return ""; }
    let t = forgejo_exec(
        "su-exec git forgejo admin user generate-access-token --username " + user
            + " --token-name hale-" + key + "-" + to_string(std::time::now())
            + " --scopes all --raw",
    );
    let token = dna::trim_nl(t.stdout);
    if t.code != 0 || len(token) < 20 || std::str::contains(token, " ") {
        return "the forge's user " + user + " was given no token: " + dna::trim_nl(t.stderr);
    }
    return vault_put(slot, token);
}
