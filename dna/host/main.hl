// dna/host — the host: what `hale dna` does beside the compiler, as Hale
// (GH #566 F8). Two programs share this seed. This one is the host's
// body: `run`, `dev` and `node` start the `main locus` (`Host`), and
// `body-fence` is the renewer a body starts beside itself. The one-shot
// verbs — status, review, apply and the rest — are the verb program's
// (`dna/host/verb`), which imports this seed and answers one verb per
// process (GH #1490). `hale dna <verb>` builds both once into the
// toolchain cache and execs the one the verb belongs to, with the
// project resolved:
//
//   <program> <verb> <root> <seed> <fleet> <plan> [args…]
//
// with HALE_BIN (the toolchain) and HALE_DNA_TOOLCHAIN (its version) in
// the environment. It decides nothing. A one-shot verb never publishes:
// it writes its row, and a node — `run` or `dev`, this program's `main
// locus` (`Host`) — relays it onto the nerves (GH #986).

import "../core" as dna;

fn arg(i: Int) -> String { return std::env::arg_or(i, ""); }

// An argument's own backslashes and newlines are escaped in the
// newline-separated argument list, and unescaped when a value is read back
// (`flag`, `word`), so a multi-line value — a practice's text — arrives
// whole, byte for byte (the review of #633).
fn escape_arg(s: String) -> String {
    return std::str::replace(std::str::replace(s, "\\", "\\\\"), "\n", "\\n");
}

@unbounded
fn unescape_arg(s: String) -> String {
    if !std::str::contains(s, "\\") { return s; }
    let mut out = "";
    let mut i = 0;
    while i < len(s) {
        let c = s[i..(i + 1)];
        if c == "\\" && i + 1 < len(s) {
            let d = s[(i + 1)..(i + 2)];
            out = out + (if d == "n" { "\n" } else { d });
            i = i + 2;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

fn rest_args(from: Int) -> String {
    let mut out = "";
    let mut i = from;
    while i < std::env::args_count() {
        out = out + escape_arg(std::env::arg(i)) + "\n";
        i = i + 1;
    }
    return out;
}

// `--flag value` and positionals from the verb's args, newline-separated.
type Args {
    words: String = ""; // positionals, newline-separated
    flags: String = ""; // "\n--name\nvalue" pairs, newline-separated
}

fn has_flag(a: Args, name: String) -> Bool {
    return std::str::contains(a.flags, "\n" + name + "\n");
}

fn flag(a: Args, name: String) -> String {
    let i = std::str::index_of(a.flags, "\n" + name + "\n");
    if i < 0 { return ""; }
    let rest = a.flags[(i + len(name) + 2)..len(a.flags)];
    let nl = std::str::index_of(rest, "\n");
    if nl < 0 { return unescape_arg(rest); }
    return unescape_arg(rest[0..nl]);
}

fn word(a: Args, n: Int) -> String {
    let mut rest = a.words;
    let mut k = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if k == n { return unescape_arg(w); }
        k = k + 1;
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return "";
}

// positionals joined by spaces
fn join_words(words: String) -> String {
    let mut out = "";
    let mut rest = words;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if len(w) > 0 { out = out + (if len(out) > 0 { " " } else { "" }) + unescape_arg(w); }
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return out;
}

fn drop_first_word(words: String) -> String {
    let nl = std::str::index_of(words, "\n");
    if nl < 0 { return ""; }
    return words[(nl + 1)..len(words)];
}

fn parse_args(raw: String, valued: String) -> Args {
    let mut a = Args { flags: "\n" };
    let mut rest = raw;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
        if std::str::starts_with(w, "--") && std::str::contains(valued, " " + w + " ") {
            let nl2 = std::str::index_of(rest, "\n");
            let v = if nl2 < 0 { rest } else { rest[0..nl2] };
            if nl2 < 0 { rest = ""; } else { rest = rest[(nl2 + 1)..len(rest)]; }
            a.flags = a.flags + w + "\n" + v + "\n";
        } else if std::str::starts_with(w, "--") {
            a.flags = a.flags + w + "\n\n";
        } else if len(w) > 0 {
            a.words = a.words + w + "\n";
        }
    }
    return a;
}

// The flags that take a value, for every verb of both programs.
fn verb_args() -> Args {
    return parse_args(rest_args(6), " --to --as --authority --comment --digest --port --observe --repo --fleet --tick --severity --note --dsn --dir --body --outcome --purpose --why --policy --decided-by --via --evidence --class --name --classes --by --exception --authorized-by --text --because --supersedes --holder --token --expires --host-pid --request-id --diff --every --cron --definition --args --convener --rows --app --description --size --permit --price-in --price-out --mandate --under --at --pack --steps --retire-pack ");
}

// The host's body: `run` and `dev` start the `main locus` (`Host`), `node`
// starts it over a Node, and `body-fence` is the renewer a body starts
// beside itself from this binary. Each runs until it is stopped.
fn main() {
    let verb = arg(1);
    let root = arg(2);
    // this process's one handle on memory (GH #985), closed when it exits
    let memory = dna::Memory { repo: root, dsn_env: dna::own_dsn_env() };
    let seed = arg(3);
    let fleet = arg(4);
    let plan = arg(5);
    let toolchain = std::env::var("HALE_DNA_TOOLCHAIN");
    let a = verb_args();
    if verb == "body-fence" {
        fence_main(flag(a, "--holder"), std::str::parse_int(flag(a, "--token")) or 0, std::str::parse_int(flag(a, "--expires")) or 0, std::str::parse_int(flag(a, "--host-pid")) or 0, memory);
        return;
    }
    if verb == "run" || verb == "dev" {
        host_main(verb, root, seed, fleet, plan, toolchain, a);
        return;
    }
    if verb == "node" {
        let tick = flag(a, "--tick");
        node_main(word(a, 0), root, flag(a, "--fleet"), if len(tick) > 0 { std::str::parse_int(tick) or 1000 } else { 1000 });
        return;
    }
    eprintln("hale dna: `", verb, "` is a one-shot verb, which the host's verb program answers (dna/host/verb); this program is the host's body: run, dev, node and body-fence");
    std::process::exit(1);
}
