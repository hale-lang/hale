// dna/core/ownership.hl — who admits which position (GH #664, stage B2),
// read from the graph (GH #1123).
//
// A shared record's org chart has one owner per organism position: the
// firm whose controller admits intents for it, reserves against its own
// allowances and answers for its work. The graph is the one org chart: a
// firm is an `organization` node, it owns a position by holding it
// (`holds(position:org/collections, organization:north)`), and a person is
// its member by holding it (`holds(organization:north, bob)`). A position
// no organization holds takes its nearest held ancestor's owner; with none
// held it is unowned, and no controller admits it. A graph in which no
// organization holds a position is one owner, the organization itself,
// and every position is its own: nothing about a single-owner organism
// changes. This body learns which organization it is from HALE_DNA_OWNER
// (the host reads `dna.owner`, the organization node's name); a body over a
// shared record that names none admits nothing.
//
// The view is built from memory's `graph_ownership()` — JSON `[node,
// holder]` pairs — so the Ledger's gate (`org_members`, a view over the
// same edges) and every admission read one projection.

type Owned { position: String = ""; owner: String = ""; }
@form(vec)
locus OwnedRows { capacity { heap rows of Owned; } }
type Membership { owner: String = ""; members: String = ""; } // members space-separated
@form(vec)
locus MembershipRows { capacity { heap rows of Membership; } }

// Blanks off both ends.
@unbounded
fn strip_blanks(s: String) -> String {
    let mut a = 0;
    let mut b = len(s);
    while a < b && (s[a..(a + 1)] == " " || s[a..(a + 1)] == "\t" || s[a..(a + 1)] == "\r") { a = a + 1; }
    while b > a && (s[(b - 1)..b] == " " || s[(b - 1)..b] == "\t" || s[(b - 1)..b] == "\r") { b = b - 1; }
    return s[a..b];
}
// `list` with `word` added once, space-separated.
fn word_add(list: String, word: String) -> String {
    if len(word) == 0 || word_in(word, list) { return list; }
    return if len(list) == 0 { word } else { list + " " + word };
}
// Every word of `words` added to `list`, once each.
@unbounded
fn words_add(list: String, words: String) -> String {
    let mut out = list;
    let mut i = 0;
    while len(nth_word(words, i)) > 0 { out = word_add(out, nth_word(words, i)); i = i + 1; }
    return out;
}
// Whether every word of `words` is in `list`.
@unbounded
fn words_within(words: String, list: String) -> Bool {
    let mut i = 0;
    while len(nth_word(words, i)) > 0 {
        if !word_in(nth_word(words, i), list) { return false; }
        i = i + 1;
    }
    return true;
}
// Commas and runs of blanks made into single spaces: "alice, carol" -> "alice carol".
@unbounded
fn words_of(s: String) -> String {
    let mut out = "";
    let mut tok = "";
    let mut k = 0;
    while k <= len(s) {
        let ch = if k < len(s) { s[k..(k + 1)] } else { " " };
        if ch == "," || ch == " " || ch == "\t" {
            out = word_add(out, tok);
            tok = "";
        } else {
            tok = tok + ch;
        }
        k = k + 1;
    }
    return out;
}
// A position as the map spells it: "" is the organization, `org`.
@unbounded
fn position_name(p: String) -> String {
    let mut s = strip_blanks(p);
    while len(s) > 1 && s[(len(s) - 1)..len(s)] == "/" { s = s[0..(len(s) - 1)]; }
    return if len(s) == 0 { "org" } else { s };
}

locus Ownership {
    params {
        graph: String = ""; // memory's `graph_ownership()`: JSON `[node, holder]` pairs ("" = one owner)
        me_env: String = "HALE_DNA_OWNER";
        me: String = ""; // the organization this body is ("" = unnamed)
        loaded: Bool = false;
        positions: OwnedRows = OwnedRows { };
        memberships: MembershipRows = MembershipRows { };
    }
    birth() {
        if len(self.me) == 0 && len(self.me_env) > 0 && std::env::var_exists(self.me_env) { self.me = std::env::var(self.me_env); }
    }
    @unbounded
    fn load() {
        if self.loaded { return; }
        self.loaded = true;
        let mut it = std::json::array_first(self.graph);
        while !it.done {
            let two = show_strings(it.element);
            let nl = std::str::index_of(two, "\n");
            let node = if nl < 0 { two } else { two[0..nl] };
            let holder = if nl < 0 { "" } else { trim_nl(two[(nl + 1)..len(two)]) };
            if std::str::starts_with(node, "position:") && std::str::starts_with(holder, "organization:") {
                self.positions.push(Owned { position: position_name(node[9..len(node)]), owner: holder[13..len(holder)] });
            } else if std::str::starts_with(node, "organization:") {
                self.join(node[13..len(node)], holder);
            }
            it = std::json::array_next(it);
        }
    }
    @unbounded
    fn join(owner: String, person: String) {
        let mut i = 0;
        while i < self.memberships.len() {
            let m = self.memberships.get(i) or Membership { };
            if m.owner == owner {
                self.memberships.set(i, Membership { owner: owner, members: word_add(m.members, person) }) or discard;
                return;
            }
            i = i + 1;
        }
        self.memberships.push(Membership { owner: owner, members: person });
    }
    // The graph's ownership again, when memory's answer changed: the view
    // is rebuilt from it on the next read.
    @unbounded
    fn reload(graph: String) {
        if graph == self.graph && self.loaded { return; }
        self.graph = graph;
        self.loaded = false;
        while self.positions.len() > 0 { let gone = self.positions.pop() or Owned { }; }
        while self.memberships.len() > 0 { let gone = self.memberships.pop() or Membership { }; }
    }
    // Whether the record is shared: an organization holds a position, or
    // this body names which organization it is — then only what the graph
    // says it holds is admitted, and nothing before memory has said it.
    fn shared() -> Bool { self.load(); return self.positions.len() > 0 || len(self.me) > 0; }
    // The owner of a position: named, or its nearest named ancestor's; ""
    // when no ancestor is named (unowned).
    @unbounded
    fn owner_of(position: String) -> String {
        self.load();
        let mut p = position_name(position);
        while len(p) > 0 {
            let mut i = 0;
            while i < self.positions.len() {
                let o = self.positions.get(i) or Owned { };
                if o.position == p { return o.owner; }
                i = i + 1;
            }
            let slash = last_slash(p);
            if slash < 0 { return ""; }
            p = p[0..slash];
        }
        return "";
    }
    // The positions an organization holds, in the record's order.
    @unbounded
    fn holdings(owner: String) -> String {
        self.load();
        let mut out = "";
        let mut i = 0;
        while i < self.positions.len() {
            let o = self.positions.get(i) or Owned { };
            if o.owner == owner { out = word_add(out, o.position); }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn members_of(owner: String) -> String {
        self.load();
        let mut i = 0;
        while i < self.memberships.len() {
            let m = self.memberships.get(i) or Membership { };
            if m.owner == owner { return m.members; }
            i = i + 1;
        }
        return "";
    }
    @unbounded
    fn owner_of_person(person: String) -> String {
        self.load();
        let mut i = 0;
        while i < self.memberships.len() {
            let m = self.memberships.get(i) or Membership { };
            if word_in(person, m.members) { return m.owner; }
            i = i + 1;
        }
        return "";
    }
    // Every organization the graph names, owners first then memberships, once each.
    @unbounded
    fn owners() -> String {
        self.load();
        let mut out = "";
        let mut i = 0;
        while i < self.positions.len() {
            let o = self.positions.get(i) or Owned { };
            out = word_add(out, o.owner);
            i = i + 1;
        }
        i = 0;
        while i < self.memberships.len() {
            let m = self.memberships.get(i) or Membership { };
            out = word_add(out, m.owner);
            i = i + 1;
        }
        return out;
    }
    // Whether this body admits an intent for the position: always, for an
    // organism with one owner; over a shared record, only for positions
    // this owner holds.
    fn admits(position: String) -> Bool {
        if !self.shared() { return true; }
        return len(self.me) > 0 && self.owner_of(position) == self.me;
    }
    // Why not, for the refusal and the status line.
    fn why_not(position: String) -> String {
        let p = position_name(position);
        let owner = self.owner_of(p);
        if len(owner) == 0 { return "`" + p + "` has no owner: no organization holds it or a position above it in the graph; no controller admits it"; }
        if len(self.me) == 0 { return "`" + p + "` is owned by " + owner + ", and this body names no owner (HALE_DNA_OWNER)"; }
        return "`" + p + "` is owned by " + owner + ", not " + self.me;
    }
    fn describe() -> String {
        self.load();
        if !self.shared() { return "one owner"; }
        return "owners " + self.owners() + (if len(self.me) > 0 { " (this body: " + self.me + ")" } else { " (this body names none)" });
    }
}

// The key a person is listed under among `k=v,v` entries (a route's
// signers, `position:board=alice,carol`), "" when none.
@unbounded
fn approver_owner(approvers: String, person: String) -> String {
    let mut i = 0;
    while len(nth_word(approvers, i)) > 0 {
        let entry = nth_word(approvers, i);
        let eq = std::str::index_of(entry, "=");
        if eq > 0 && word_in(person, words_of(entry[(eq + 1)..len(entry)])) { return entry[0..eq]; }
        i = i + 1;
    }
    return "";
}
// The keys of `k=v,v` entries (a route's positions), space-separated.
@unbounded
fn approver_owners(approvers: String) -> String {
    let mut out = "";
    let mut i = 0;
    while len(nth_word(approvers, i)) > 0 {
        let entry = nth_word(approvers, i);
        let eq = std::str::index_of(entry, "=");
        out = word_add(out, if eq > 0 { entry[0..eq] } else { entry });
        i = i + 1;
    }
    return out;
}

// ---- GH #666: ids and effect keys carry their owner ------------------
//
// Over a shared record each controller mints in its own namespace —
// `acme:t3`, `acme:m2` — and claims its effects under it, `acme:apply:
// <candidate>`, so two controllers never contend for one id and the
// ledger's unique constraint on a claim kind decides a first claim
// without any coordination between them. With one owner nothing is
// prefixed: `t3`, `m2`, `apply:<candidate>`, as before.

fn own_prefix(owner: String) -> String {
    return if len(owner) == 0 { "" } else { owner + ":" };
}
// The owner an id names ("acme" of `acme:t3`), "" when none.
fn id_owner(id: String) -> String {
    let c = std::str::index_of(id, ":");
    return if c <= 0 { "" } else { id[0..c] };
}
// The number of an id of `family` ("t", "m"), with or without an owner: 3 of
// `t3` and of `acme:t3`; -1 when the id is not of that family.
fn id_number(id: String, family: String) -> Int {
    let c = std::str::index_of(id, ":");
    let bare = if c < 0 { id } else { id[(c + 1)..len(id)] };
    if len(bare) <= len(family) || bare[0..len(family)] != family { return -1; }
    return std::str::parse_int(bare[len(family)..len(bare)]) or - 1;
}
// Whether an id is minted in `owner`'s namespace ("" for the one owner's).
fn owned_by(owner: String, id: String) -> Bool { return id_owner(id) == owner; }
// An effect claim's key: `<owner>:<family>:<subject>`, unprefixed for one owner.
fn effect_key(owner: String, family: String, subject: String) -> String {
    return own_prefix(owner) + family + ":" + subject;
}
const EFFECT_FAMILIES: String = "apply rollback commit worktree.open";
// The family of a claim's key ("apply" of `apply:<c>` and of `acme:apply:<c>`).
fn effect_family(key: String) -> String {
    let c = std::str::index_of(key, ":");
    if c < 0 { return key; }
    let first = key[0..c];
    if word_in(first, EFFECT_FAMILIES) { return first; }
    let rest = key[(c + 1)..len(key)];
    let d = std::str::index_of(rest, ":");
    return if d < 0 { rest } else { rest[0..d] };
}
// What the claim is about: the text after `<family>:`.
fn effect_subject(key: String) -> String {
    let fam = effect_family(key);
    let at = std::str::index_of(key, fam + ":");
    if at < 0 { return ""; }
    return key[(at + len(fam) + 1)..len(key)];
}
