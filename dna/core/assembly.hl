// dna/core/assembly.hl — the Dna locus a project constructs (#521
// comment 1: constructor-shaped assembly).
//
// "Configuration" is Hale source: a project writes `Dna { memory:
// ..., work: ..., governance: ..., membrane: ... }` in its main's
// params, supplying concrete children behind the core's interfaces.
// The assembly is visible to the ApplicationModel, claims can reason
// about its reachability and effects, and changing it is an ordinary
// reviewed genome diff. Nothing here is a config-file loader.
//
// Four things stay distinct: construction (which concrete stores,
// models, gateways exist), genome (evolvable policy loci), law
// (constitutions adopted by the main, never a constructor flag), and
// durable state (behind the constructed stores, never a literal).

// ---- the human/external membrane -----------------------------------

interface Membrane {
    fn offer(i: Intent) -> String; // "accepted" | "refused: ..."
    fn notify(kind: String, msg: String);
    fn notifications() -> Int;
}

// The local human: intent enters through `hale dna ask`, review
// requests and status leave through the terminal / Iris. The person
// is outside the root; this locus owns the boundary.
locus LocalHumanMembrane {
    params { who: String = "operator"; offered: Int = 0; notified: Int = 0; last: String = ""; }
    fn offer(i: Intent) -> String {
        if i.outcome == "" { return "refused: empty intent"; }
        self.offered = self.offered + 1;
        return "accepted";
    }
    fn notify(kind: String, msg: String) {
        self.notified = self.notified + 1;
        self.last = kind + ": " + msg;
    }
    fn notifications() -> Int { return self.notified; }
}

// The Board (GH #566 F2): the human authority at the top of the org
// chart. Intent enters through it, escalations and reports leave
// through it; it owns every grant. It is the membrane's human side
// under its organizational name.
locus Board {
    params { who: String = "board"; offered: Int = 0; notified: Int = 0; escalations: Int = 0; last: String = ""; }
    fn offer(i: Intent) -> String {
        if i.outcome == "" { return "refused: empty intent"; }
        self.offered = self.offered + 1;
        return "accepted";
    }
    fn notify(kind: String, msg: String) {
        self.notified = self.notified + 1;
        if kind == "review" && std::str::contains(msg, "board needed") { self.escalations = self.escalations + 1; }
        self.last = kind + ": " + msg;
    }
    fn notifications() -> Int { return self.notified; }
}

// ---- governance policy (evolvable genome, bounded by law) -----------

interface ReviewPolicy {
    fn required_authority(change_class: String, m: Magnitude) -> String;
    fn blocking(change_class: String) -> Bool;
    fn name() -> String;
}

// The safe baseline (#521 open question 15): every application,
// deployment, external-effect, process-policy and constitutional
// mutation blocks on a human.
locus HumanBeforeApply {
    fn required_authority(change_class: String, m: Magnitude) -> String { return "maintainer"; }
    fn blocking(change_class: String) -> Bool { return true; }
    fn name() -> String { return "human-before-apply"; }
}

// The organization's policy (GH #566 F2): a change that touches law,
// widens effects or crosses ownership, or is of a Board-class
// (`organization`, `constitutional`, `process-policy`, `topology`), is
// the Board's; everything else inside the grant is the Leader's.
locus OrgPolicy {
    fn required_authority(change_class: String, m: Magnitude) -> String {
        if m.law_touched || m.effects_widened || m.ownership_crossed { return "board"; }
        if change_class == "organization" || change_class == "constitutional" || change_class == "process-policy" || change_class == "topology" { return "board"; }
        return "leader";
    }
    fn blocking(change_class: String) -> Bool { return true; }
    fn name() -> String { return "org"; }
}

// Post-review for reversible internal refactors; everything else blocks.
locus PostReviewRefactors {
    fn required_authority(change_class: String, m: Magnitude) -> String {
        if m.law_touched || m.effects_widened { return "maintainer"; }
        return "reviewer";
    }
    fn blocking(change_class: String) -> Bool { return change_class != "refactor"; }
    fn name() -> String { return "post-review-refactors"; }
}

// ---- deployment gateway (an EFFECT, behind an attributed gate) -----

interface Deployment {
    fn apply(candidate_digest: String) -> Bool; // express the candidate; true when it is up and judged healthy
    fn rollback(base: String) -> Bool; // express the base again after a bad window or a rejection
    fn kind() -> String;
    fn applied() -> Int;
}

// A deployment gateway that shells out (GH #566 F4): the command owns
// expressing and judging. `<command> express <candidate> <seed>` must
// return 0 once the candidate is up and healthy (it owns the window);
// `<command> rollback <base> <seed>` restores the base. Everything it
// does is outside this process — a pipeline, an orchestrator, ssh —
// and its exit code is the fact the record keeps.
locus ShellDeployment {
    params {
        command: String = "";
        seed: String = ".";
        applied_n: Int = 0;
        rolled_back: Int = 0;
        last_code: Int = 0;
        last_output: String = "";
    }
    @effects(is: { genome_apply })
    fn apply(candidate_digest: String) -> Bool {
        let r = run_tool(self.command + "\nexpress\n" + candidate_digest + "\n" + self.seed);
        self.last_code = r.code;
        self.last_output = trim_nl(r.stdout + r.stderr);
        if r.code != 0 { return false; }
        self.applied_n = self.applied_n + 1;
        return true;
    }
    @effects(is: { genome_apply })
    fn rollback(base: String) -> Bool {
        let r = run_tool(self.command + "\nrollback\n" + base + "\n" + self.seed);
        self.last_code = r.code;
        self.last_output = trim_nl(r.stdout + r.stderr);
        if r.code != 0 { return false; }
        self.rolled_back = self.rolled_back + 1;
        return true;
    }
    fn kind() -> String { return "shell"; }
    fn applied() -> Int { return self.applied_n; }
}

// A deployment that DOES apply (simulated): the one method carries
// `genome_apply`, which the law gates behind the Dna assembly.
locus LocalApplyDeployment {
    params { applied_n: Int = 0; last: String = ""; }
    @effects(is: { genome_apply })
    fn apply(candidate_digest: String) -> Bool { self.applied_n = self.applied_n + 1; self.last = candidate_digest; return true; }
    fn rollback(base: String) -> Bool { self.last = base; return true; }
    fn kind() -> String { return "local-apply"; }
    fn applied() -> Int { return self.applied_n; }
}

// Phase 1: every mutation stops at stage. This gateway refuses.
locus NoDeployment {
    params { refused: Int = 0; }
    fn apply(candidate_digest: String) -> Bool { self.refused = self.refused + 1; return false; }
    fn rollback(base: String) -> Bool { return false; }
    fn kind() -> String { return "none"; }
    fn applied() -> Int { return 0; }
}

// ---- Dna --------------------------------------------------------------

fn short_sha(sha: String) -> String {
    if len(sha) < 12 { return sha; }
    return sha[0..12];
}

// Routed Work waiting for the leader's plan (GH #596 L): one row per
// ask in flight, released when its plan arrives.
@form(vec)
locus PendingWork { capacity { heap rows of WorkRequest; } }

locus Dna {
    params {
        journal: Journal = MemJournal { };
        leases: Coordination = MemLeases { };
        knowledge: Knowledge = Knowledge { };
        work: WorkSystem = WorkSystem { };
        metabolism: Metabolism = Metabolism { };
        boundary: AutonomyBoundary = AutonomyBoundary { child: "app" };
        // GH #596, layering: the grant above the child's — the
        // organism's, the Board's to widen. A child's grant is read
        // through it at every assessment, and a contraction of it
        // binds the child from that moment (`grant.contracted`). No
        // child on it means no ceiling.
        ceiling: AutonomyBoundary = AutonomyBoundary { };
        review_policy: ReviewPolicy = HumanBeforeApply { };
        deployment: Deployment = NoDeployment { };
        membrane: Membrane = LocalHumanMembrane { };
        // Phase 2 (GH #529): where a mutation edits, how it is verified,
        // and who edits. The gateway and the verification journal
        // through THIS assembly's Journal (handed to them per call).
        gateway: MutationGateway = MutationGateway { };
        verification: HaleVerification = HaleVerification { };
        editor: SourceEditor = SourceEditor { };
        // GH #583 M1: the organization's spend has ONE owner. The catalog
        // declares the policy; every model.called row is accounted here;
        // rehydrated from the record at birth.
        budget: Budget = Budget { };
        // GH #583 K2: the owner's line to the knowledge service; the
        // package it answers is folded into the objective the editor gets
        knowledge_client: KnowledgeClient = KnowledgeClient { };
        concern_threshold: Int = 3; // a concern raised this often from one source is proposed as knowledge
        genome_seed: String = "."; // the genome's seed, relative to the repository
        // GH #596 L: when true, an ask is planned by the leader before
        // it becomes a Mutation (the generated org chart says so); when
        // false, routed edit Work is a Mutation of class `application`,
        // as before — fixtures with no leader keep that.
        planned: Bool = false;
        pending_plans: PendingWork = PendingWork { };
        plans: Int = 0;
        // GH #596 O: the optimize pass. `org_id` keys the exchange with
        // this organism's leader; `optimize_every_ms` is the cadence
        // the Board sets on the org chart (0 = never); the org program's
        // loop calls `tick`.
        org_id: String = "org";
        optimize_every_ms: Int = 0;
        last_optimized: Int = 0;
        optimizations: Int = 0;
        // GH #610: the schedules the org chart declared (`schedule`),
        // with their state; `optimize_every_ms` becomes one at birth
        schedules: ScheduleRows = ScheduleRows { };
        schedules_read: Int = 0; // record rows read for pause/resume
        last_refresh: Int = 0;
        last_signals: String = "";
        org_seed: String = "dna/org"; // the organization's own seed (GH #566 F3): what an `organization` change edits
        initiative: Bool = true; // persistent pressure becomes a growth Mutation, not only a note
        baseline: String = ""; // the diff's base artifact; "" = cut from the genome's seed per mutation
        asked: Int = 0;
        last_task: String = "";
        mutations_minted: Int = 0;
        last_mutation: String = "";
        applied: Int = 0; // candidates applied by this assembly (a replayed apply is not counted twice)
        restarts_requested: Int = 0;
        reviews_open: Int = 0; // live mutation Reviews (accepted children)
        rehydrated: Int = 0; // Reviews re-born from the Journal at birth
        appendage_threshold: Int = 3; // pressure raised this often from one source proposes an organ
    }
    // A mutation's Review is a child of the assembly: born when the
    // candidate is verified, keyed on its review id so a verdict from
    // the membrane reaches exactly it. The Journal is the authority:
    // a pending mutation Review is re-born from it at birth, so an
    // organism restarted mid-review can still be answered.
    accept(r: Review) { self.reviews_open = self.reviews_open + 1; }
    release (r: Review) { self.reviews_open = self.reviews_open - 1; }
    birth() {
        self.rehydrate();
        // GH #610: the optimize pass is a schedule, not a special case
        if self.optimize_every_ms > 0 {
            let why = self.schedule(Schedule { id: "optimize", every_ms: self.optimize_every_ms, action: "optimize", requires: "" });
        }
        // GH #596, layering: a child grant wider than the organism's is
        // the early error — refused in the record, and bound by the
        // ceiling from here on (the use-time check does the binding)
        if len(self.ceiling.child) > 0 && !grant_within(self.boundary.current_grant(), self.ceiling.current_grant()) {
            let g = self.boundary.current_grant();
            let c = self.ceiling.current_grant();
            let x = self.journal.append(self.journal.revision(), "grant.refused", g.child,
                "wider than the ceiling `" + c.child + "` at birth: classes `" + g.classes + "` under `" + c.classes + "`, magnitude " + to_string(g.max_magnitude) + " under " + to_string(c.max_magnitude) + ", review " + g.review + " under " + c.review + "; bound by the ceiling");
        }
        // GH #529 D6: the host restarted this expression on a Mutation's
        // request; the fact is journaled by the expression itself.
        if std::env::var_exists("HALE_DNA_RESTART_FOR") {
            let x = self.journal.append(self.journal.revision(), "expression.restarted", std::env::var("HALE_DNA_RESTART_FOR"),
                if std::env::var_exists("HALE_DNA_EXPRESSION") { std::env::var("HALE_DNA_EXPRESSION") } else { "" });
        }
    }
    // GH #527 B6: intent crossing the membrane on the typed channel
    // (`hale dna ask`, Iris) enters through the SAME gate as a local
    // `ask` — the membrane decides, the Metabolism births the Task,
    // the Journal records both. The organism's main binds this topic
    // on a unix socket; nothing about the decision lives in the
    // transport.
    bus {
        subscribe IntentOffered as on_intent;
        subscribe ReviewSettled as on_review_settled;
        subscribe ModelCalled as on_model_called;
        subscribe ExpressionObserved as on_observed;
        // GH #529 D7: Work that changes source comes back to the
        // assembly (its editor, its gateway); a root Task's settlement
        // is journaled here; persistent pressure proposes, never grows.
        subscribe WorkRequested as on_work_requested;
        subscribe TaskPlanned as on_planned where key == self.org_id;
        publish PlanRequested;
        subscribe OrgReviewed as on_org_reviewed where key == self.org_id;
        publish OptimizeRequested;
        subscribe TaskSettled as on_task_settled;
        subscribe PressureRaised as on_pressure;
        subscribe ConcernRaised as on_concern;
        publish WorkDone;
        // GH #566 F2: a Review is announced as a typed fact, so a position
        // in the org (the Leader) can decide it inside its grant
        publish ReviewRequested;
    }
    // Every model call's evidence, journaled (never the prompt).
    @unbounded
    fn on_model_called(ev: ModelEvidence) {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("adapter", ev.adapter);
        b.string_field("backend", ev.backend);
        b.string_field("endpoint", ev.endpoint);
        b.string_field("credential", ev.credential);
        b.string_field("requested_model", ev.requested_model);
        b.string_field("reported_model", ev.reported_model);
        b.string_field("params", ev.params);
        b.string_field("prompt_digest", ev.prompt_digest);
        b.string_field("context_digest", ev.context_digest);
        b.string_field("knowledge_bindings", ev.knowledge_bindings);
        b.string_field("tool_grant", ev.tool_grant);
        b.string_field("response_digest", ev.response_digest);
        b.string_field("artifact_digest", ev.artifact_digest);
        b.int_field("input_tokens", ev.input_tokens);
        b.int_field("output_tokens", ev.output_tokens);
        b.string_field("elapsed", ev.elapsed);
        b.int_field("cost_micros", ev.cost_micros);
        b.string_field("validation", ev.validation);
        b.string_field("retry_of", ev.retry_of);
        b.string_field("data_class", ev.data_class);
        b.bool_field("ok", ev.ok);
        b.string_field("refused", ev.refused);
        let now = std::time::now();
        b.int_field("at", now);
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "model.called", ev.attempt_id, b.result());
        self.budget.account(ev.cost_micros, now);
    }
    // The window's allowance is spent: journaled once per window, the
    // membrane told; the caller refuses or waits.
    fn budget_exhausted(now: Int) -> Bool {
        if !self.budget.exhausted(now) { return false; }
        if self.budget.announce() {
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("detail", self.budget.describe(now));
            b.int_field("spent_micros", self.budget.spent_micros);
            b.int_field("allowance_micros", self.budget.policy.allowance_micros);
            b.string_field("window", self.budget.policy.window);
            b.int_field("at", now);
            b.end_object();
            let x = self.journal.append(self.journal.revision(), "budget.exhausted", "budget", b.result());
            self.membrane.notify("budget", "exhausted: " + self.budget.describe(now) + "; model-backed work waits for the next window, Reviews wait for the Board");
        }
        return true;
    }
    // ---- knowledge (GH #583 K1): the record's half ------------------
    // A proposal enters the record as a receipt (its canonical document,
    // by digest), a `knowledge.proposed` row naming that digest, and a
    // Review pinned to it — the Board's, since ratified knowledge is the
    // organization's. Returns the digest. The tower rule decides the
    // class of the binding (goal / concern / initiative) from who
    // proposes and where it binds; a lateral proposal is refused.
    fn propose_knowledge(i: Idea, target: String) -> String {
        let class = classify_binding(i.author, target);
        if class == "lateral" {
            let x = self.journal.append(self.journal.revision(), "knowledge.refused", i.id, "lateral: `" + i.author + "` may not bind knowledge to `" + target + "` (siblings do not privately coordinate)");
            return "";
        }
        let doc = knowledge_document(i, target);
        let digest = "sha256:" + self.verification.receipts.store(doc);
        let review_id = knowledge_review_id(digest);
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("digest", digest);
        b.string_field("review_id", review_id);
        b.string_field("kind", i.kind);
        b.string_field("author", i.author);
        b.string_field("target", target);
        b.string_field("class", class);
        if len(i.name) > 0 { b.string_field("name", i.name); }
        if len(i.supersedes) > 0 { b.string_field("supersedes", i.supersedes); }
        b.int_field("at", std::time::now());
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "knowledge.proposed", digest, b.result());
        let question = "ratify " + i.kind + " `" + i.text + "` as a " + class + " for " + target + "?";
        Review { review_id: review_id, question: question, subject_digest: digest, required_authority: "board", author: i.author };
        let q = std::json::Builder { };
        q.begin_object();
        q.string_field("question", question);
        q.string_field("subject_digest", digest);
        q.string_field("required_authority", "board");
        q.string_field("author", i.author);
        q.string_field("knowledge_digest", digest);
        q.string_field("kind", i.kind);
        q.string_field("target", target);
        q.string_field("class", class);
        q.end_object();
        let y = self.journal.append(self.journal.revision(), "review.requested", "review:" + review_id, q.result());
        self.membrane.notify("knowledge", "board needed for " + review_id + ": " + question);
        return digest;
    }
    // The `review.requested` body of a knowledge proposal's Review, ""
    // for any other.
    @unbounded
    fn knowledge_request_of(review_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "review.requested" && e.entity == "review:" + review_id && std::str::contains(e.body, "\"knowledge_digest\"") { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    // The Review decided; the Journal records it (the file
    // `hale dna status` and `history` read).
    @unbounded
    fn on_review_settled(r: ReviewSettlement) {
        if r.refusal != "" {
            let x = self.journal.append(self.journal.revision(), "review.refused", r.review_id, r.refusal);
            return;
        }
        // An approved candidate that never applied, approved AGAIN by a
        // verdict the Review admitted in full (the fourth review round's
        // finding 1: a generic `already settled` used to stand in for
        // this, and a rejection applied the candidate). The verdict is
        // spent; the apply is not: the whole gate runs again over the
        // same pinned candidate, and a candidate or a base that moved
        // in the meantime is refused as ever.
        if r.reapproval {
            let d = self.disposition_of(r.review_id);
            if len(self.request_of(r.review_id)) == 0 { return; }
            // approved again after it already applied: nothing to do, and
            // the record answers so a waiting `hale dna review` hears it
            if d == "applied" || d == "retained" {
                let x = self.journal.append(self.journal.revision(), "review.refused", r.review_id, "already " + d + " (approved again by " + r.decided_by + ")");
                return;
            }
            let a = self.journal.append(self.journal.revision(), "mutation.apply_retried", r.review_id, "approved again by " + r.decided_by + "; the gate runs again");
            let y = self.apply_reviewed(r.review_id, std::time::now());
            // and the record answers the verdict as it answers a first
            // one, so `hale dna review … approve` hears it: it waits on
            // `review.settled` or `review.refused` and nothing else, and
            // reported failure after applying (the fifth round's
            // finding 2). The first settlement stands above this row.
            let z = self.journal.append(self.journal.revision(), "review.settled", r.review_id, "approve by " + r.decided_by);
            return;
        }
        let x = self.journal.append(self.journal.revision(), "review.settled", r.review_id, r.outcome + " by " + r.decided_by);
        // the record says why (GH #566 F7): a person's note, or the Leader's
        // reasoning — the model's answer, not a digest of it
        if len(r.comment) > 0 {
            let w = self.journal.append(self.journal.revision(), "review.reasoned", r.review_id, r.comment);
        }
        // GH #583 K1: a knowledge proposal's approval is the authoritative
        // ratification — one row naming the digest, which the knowledge
        // service applies from the record; anything else leaves the
        // proposal as it was, in lineage.
        let kreq = self.knowledge_request_of(r.review_id);
        if len(kreq) > 0 {
            let digest = std::json::find_string_field(kreq, "knowledge_digest");
            let b = std::json::Builder { };
            b.begin_object();
            b.string_field("digest", digest);
            b.string_field("review_id", r.review_id);
            b.string_field("outcome", r.outcome);
            b.string_field("decided_by", r.decided_by);
            b.string_field("kind", std::json::find_string_field(kreq, "kind"));
            b.string_field("target", std::json::find_string_field(kreq, "target"));
            b.string_field("class", std::json::find_string_field(kreq, "class"));
            b.int_field("at", std::time::now());
            b.end_object();
            // GH #596 C: supersession is the Board's decision, not a
            // side effect. Declining a proposal retires nothing (the
            // projection keeps a ratified idea a later `declined`
            // names); ratifying a proposal that SUPERSEDES another
            // retires the other, here, as its own row. A `retirement`
            // proposal carries only that. And a replacement is ratified
            // only while what it replaces is still active: two pending
            // replacements of one version both name it, the first
            // approved retires it, and ratifying the second would leave
            // the first in force beside it, never retired (a review
            // found both served). The second is refused, in the record,
            // with what retired its predecessor; the Board sees a fresh
            // proposal against the active version at the next `upgrade`.
            let mut old = "";
            if r.outcome == "approve" {
                let raw = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
                let doc = self.verification.receipts.read(raw);
                old = std::json::find_string_field(doc, "supersedes");
                let gone = if len(old) > 0 { self.retired_by(old) } else { "" };
                if len(gone) > 0 {
                    let fb = std::json::Builder { };
                    fb.begin_object();
                    fb.string_field("digest", digest);
                    fb.string_field("supersedes", old);
                    fb.string_field("retired_by", gone);
                    fb.string_field("review_id", r.review_id);
                    fb.string_field("decided_by", r.decided_by);
                    fb.string_field("why", "supersedes a version already retired by " + gone + "; not ratified — propose again against the active version");
                    fb.end_object();
                    let f = self.journal.append(self.journal.revision(), "knowledge.refused", digest, fb.result());
                    self.membrane.notify("knowledge", digest + " not ratified: it supersedes a version already retired by " + gone + "; `hale dna upgrade` proposes again against the active one");
                    return;
                }
            }
            let k = self.journal.append(self.journal.revision(), if r.outcome == "approve" { "knowledge.ratified" } else { "knowledge.declined" }, digest, b.result());
            if r.outcome == "approve" && len(old) > 0 {
                let rb = std::json::Builder { };
                rb.begin_object();
                rb.string_field("digest", old);
                rb.string_field("by", digest);
                rb.string_field("review_id", r.review_id);
                rb.string_field("decided_by", r.decided_by);
                rb.end_object();
                let z = self.journal.append(self.journal.revision(), "knowledge.retired", old, rb.result());
            }
            return;
        }
        // GH #529 D5: a mutation's approval applies exactly the reviewed
        // candidate; a rejection or revision leaves genome and expression
        // untouched and keeps the Mutation in lineage.
        if self.request_of(r.review_id) == "" { return; }
        let d = self.disposition_of(r.review_id);
        let live = d == "applied" || d == "retained";
        if r.outcome == "approve" {
            if live { return; } // post-review: it was applied under the grant; the human concurs
            let y = self.apply_reviewed(r.review_id, std::time::now());
            return;
        }
        if live {
            // post-review rejection: the applied candidate comes back out
            self.rollback_to_base(r.review_id, "review " + r.outcome + " by " + r.decided_by, std::time::now());
            return;
        }
        let z = self.journal.append(self.journal.revision(), "mutation." + (if r.outcome == "revise" { "revise" } else { "rejected" }), r.review_id,
            "review " + r.outcome + " by " + r.decided_by + "; genome and expression untouched");
        if r.outcome != "revise" { self.settle_task_of(r.review_id, "failed", "review " + r.outcome + " after a restart"); }
        // the worktree was scratch; the Mutation, its candidate commit,
        // its Attempts and its evidence stay in the Journal
        let now = std::time::now();
        let lease = self.gateway.take(r.review_id, "dna", now);
        let w = self.gateway.remove(self.journal, r.review_id, lease.token, now);
    }
    // The digest that retired `digest` (`knowledge.retired <digest>`,
    // its `by`), "" while it is not retired.
    @unbounded
    fn retired_by(digest: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "knowledge.retired" && e.entity == digest { out = std::json::find_string_field(e.body, "by"); }
            i = i + 1;
        }
        return out;
    }
    // The `review.requested` body of a mutation's Review, "" for any
    // other (the purpose Review, an unknown id).
    @unbounded
    fn request_of(review_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "review.requested" && e.entity == "review:" + review_id && std::str::contains(e.body, "\"mutation_id\"") { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    // The last `mutation.<disposition>` recorded for an id.
    @unbounded
    fn disposition_of(mutation_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.entity == mutation_id && std::str::contains(e.kind, "mutation.") && e.kind != "mutation.worktree" && e.kind != "mutation.candidate" {
                out = e.kind[9..len(e.kind)];
            }
            i = i + 1;
        }
        return out;
    }
    // Apply exactly the reviewed candidate (GH #529 D5): the Review
    // must have settled approve, the worktree's head must still be the
    // commit the reviewer looked at (a candidate that moved after the
    // review is refused by digest), and the apply goes through the
    // gateway — journaled under the candidate, fenced by the lease — so
    // a crashed and retried apply reads the recorded result and never
    // commits twice. Then the host is asked to rebuild and restart.
    @unbounded
    fn apply_reviewed(mutation_id: String, now: Int) -> String {
        let req = self.request_of(mutation_id);
        if req == "" { return "refused: no mutation review " + mutation_id; }
        let reviewed = std::json::find_string_field(req, "subject_digest");
        let wt = std::json::find_string_field(req, "worktree");
        if !self.approved(mutation_id) {
            let x = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "not approved");
            return "refused: not approved";
        }
        let head = self.gateway.head_of(wt);
        if head != reviewed {
            let x = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "candidate moved after review: " + head + " != " + reviewed);
            self.membrane.notify("mutation", mutation_id + " refused: the candidate moved after the review");
            return "refused: candidate moved after review";
        }
        // The DESTINATION must also be the base the review was against
        // (the shakeout's finding 2). A maintainer commit or a second
        // proposal landing while this one was under review makes the
        // apply a merge of two changes nobody reviewed together and
        // nothing verified together. Refuse; a new candidate on the new
        // base goes through the whole gate.
        // …unless this very apply is already in the record: a retried
        // apply replays what happened, and the head it left behind is
        // the candidate, not the base.
        let already = effect_status(self.journal, "apply:" + reviewed);
        let base = std::json::find_string_field(req, "base_commit");
        let now_head = self.gateway.head();
        if len(base) > 0 && now_head != base && !(already.done && already.ok) {
            let y = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "the genome moved since the review: " + now_head + " != " + base + "; propose again on the new base");
            self.membrane.notify("mutation", mutation_id + " refused: the genome moved since the review (" + short_sha(base) + " -> " + short_sha(now_head) + ")");
            return "refused: the genome moved since the review";
        }
        // A destination carrying uncommitted work of its own. The
        // fast-forward would keep it, so the genome's head would be the
        // candidate while its files are not (the review's second round,
        // finding 1). Refused here, before the apply's effect row, so
        // the maintainer can commit or stash and approve again; the
        // gateway checks it once more immediately around the git call,
        // where a refusal is the race and the Mutation is done.
        let dirty = self.gateway.dirty(self.genome_seed, wt);
        if len(dirty) > 0 && !(already.done && already.ok) {
            let z = self.journal.append(self.journal.revision(), "mutation.refused", mutation_id, "the genome has uncommitted changes; commit or stash them and approve again:\n" + dirty);
            self.membrane.notify("mutation", mutation_id + " refused: the genome has uncommitted changes");
            return "refused: the genome has uncommitted changes";
        }
        return self.apply_candidate(mutation_id, reviewed, now);
    }
    // The apply itself: through the gateway under the candidate's key
    // and the Mutation's lease, then the restart request with the
    // fitness signals the proposal declared.
    @unbounded
    fn apply_candidate(mutation_id: String, candidate: String, now: Int) -> String {
        let lease = self.gateway.take(mutation_id, "dna", now);
        let r = self.gateway.apply(self.journal, mutation_id, candidate, lease.token, now);
        if !r.ok {
            let x = self.journal.append(self.journal.revision(), "mutation.failed", mutation_id, "apply: " + r.refused);
            self.membrane.notify("mutation", mutation_id + " apply failed: " + r.refused);
            return "failed: " + r.refused;
        }
        if r.replayed { return "applied (replayed)"; }
        self.applied = self.applied + 1;
        self.restarts_requested = self.restarts_requested + 1;
        let req = self.request_of(mutation_id);
        let fitness = std::json::find_string_field(req, "fitness_signals");
        let seed = std::json::find_string_field(req, "seed");
        // GH #566 F4: a deployment gateway expresses the candidate itself
        // and owns the window; its exit is the observation. Without one,
        // the host is asked to rebuild and restart.
        if self.deployment.kind() != "none" {
            let up = self.deployment.apply(candidate);
            let d = self.journal.append(self.journal.revision(), "expression.deployed", mutation_id, (if up { "expressed " } else { "failed " }) + candidate + " via " + self.deployment.kind());
            self.on_observed(Observation { mutation_id: mutation_id, outcome: if up { "healthy" } else { "build_failed" }, model_hash: candidate, detail: "deployment " + self.deployment.kind() });
            return "applied";
        }
        let x = self.journal.append(self.journal.revision(), "expression.restart_requested", mutation_id, "apply " + candidate + " seed " + seed + " fitness " + fitness);
        self.membrane.notify("restart", mutation_id + " applied as " + candidate + "; rebuild and restart requested");
        return "applied";
    }
    // Back to the Mutation's base through the gateway, and the old
    // expression asked for. Shared by a bad observation window and a
    // post-review rejection.
    @unbounded
    fn rollback_to_base(mutation_id: String, why: String, now: Int) {
        let req = self.request_of(mutation_id);
        let base = std::json::find_string_field(req, "base_commit");
        let lease = self.gateway.take(mutation_id, "dna", now);
        let r = self.gateway.rollback(self.journal, mutation_id, base, lease.token, now);
        if !r.ok {
            let y = self.journal.append(self.journal.revision(), "mutation.failed", mutation_id, "rollback: " + r.refused);
            self.membrane.notify("mutation", mutation_id + " rollback failed: " + r.refused);
            return;
        }
        if self.deployment.kind() != "none" {
            let back = self.deployment.rollback(base);
            let d = self.journal.append(self.journal.revision(), "expression.deployed", mutation_id, (if back { "restored " } else { "failed to restore " }) + base + " via " + self.deployment.kind() + " after " + why);
            self.membrane.notify("restart", mutation_id + " rolled back to " + base + " after " + why + (if back { "" } else { " — the deployment did not restore it" }));
            return;
        }
        self.restarts_requested = self.restarts_requested + 1;
        let y = self.journal.append(self.journal.revision(), "expression.restart_requested", mutation_id, "rollback " + base + " seed " + std::json::find_string_field(req, "seed") + " after " + why);
        self.membrane.notify("restart", mutation_id + " rolled back to " + base + " after " + why);
    }
    @unbounded
    fn approved(mutation_id: String) -> Bool {
        let n = self.journal.revision();
        let mut i = 0;
        let mut ok = false;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "review.settled" && e.entity == mutation_id { ok = e.body[0..7] == "approve"; }
            i = i + 1;
        }
        return ok;
    }
    // The host's report on the observation window (GH #529 D6). Only an
    // applied Mutation is judged: healthy retains it and dissolves its
    // worktree; anything else rolls the genome back to the Mutation's
    // base and asks for the old expression back.
    @unbounded
    fn on_observed(o: Observation) {
        let x = self.journal.append(self.journal.revision(), "expression.observed", o.mutation_id, o.outcome + " " + o.model_hash + " " + o.detail);
        if self.disposition_of(o.mutation_id) != "applied" { return; }
        let now = std::time::now();
        let req = self.request_of(o.mutation_id);
        // step 11: the originating pressure, re-measured against the
        // fitness signals the proposal declared — what the window saw
        let p = self.journal.append(self.journal.revision(), "pressure.remeasured", o.mutation_id,
            "task " + std::json::find_string_field(req, "task_id") + " fitness " + std::json::find_string_field(req, "fitness_signals") + ": " + o.outcome + " " + o.detail);
        if o.outcome == "healthy" {
            let lease = self.gateway.take(o.mutation_id, "dna", now);
            let y = self.journal.append(self.journal.revision(), "mutation.retained", o.mutation_id, "observed healthy as " + o.model_hash);
            let z = self.gateway.remove(self.journal, o.mutation_id, lease.token, now);
            // GH #604: after a restart the Work that would settle the
            // Task is gone; the Task settles from its Mutation's outcome
            self.settle_task_of(o.mutation_id, "done", "retained after a restart");
            return;
        }
        self.rollback_to_base(o.mutation_id, o.outcome, now);
    }
    // GH #596 O: the record's structural signals, as the leader reads
    // them — what the design's practice on signals names, counted from
    // the record. Bounded by the record.
    @unbounded
    fn signals() -> String {
        let n = self.journal.revision();
        let mut unparsed = 0;
        let mut plans = 0;
        let mut concerns = 0;
        let mut contractions = 0;
        let mut refused_reviews = 0;
        let mut rolled_back = 0;
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "task.planned" { plans = plans + 1; if std::str::contains(e.body, "\"parsed\": false") { unparsed = unparsed + 1; } }
            if e.kind == "concern.raised" { concerns = concerns + 1; }
            if e.kind == "grant.contracted" { contractions = contractions + 1; }
            if e.kind == "review.refused" { refused_reviews = refused_reviews + 1; }
            if e.kind == "mutation.rolled_back" { rolled_back = rolled_back + 1; }
            i = i + 1;
        }
        return "asks planned: " + to_string(plans) + " (" + to_string(unparsed) + " with no plan the leader could name, taking the defaults)\n"
            + "concerns raised: " + to_string(concerns) + "\n"
            + "grant contractions: " + to_string(contractions) + "\n"
            + "verdicts refused: " + to_string(refused_reviews) + "\n"
            + "mutations rolled back: " + to_string(rolled_back) + "\n"
            + "record rows: " + to_string(n);
    }
    // Ask the leader to walk the machinery. Once per cadence, or on
    // demand.
    fn optimize() {
        // GH #583 M1 holds here too: the pass is model-backed work, and
        // none is routed on an exhausted budget; it waits for the next
        // window rather than spending what the Board did not allow.
        let now = std::time::now();
        if self.budget_exhausted(now) {
            let x = self.journal.append(self.journal.revision(), "optimize.refused", self.org_id, "budget exhausted (" + self.budget.describe(now) + "); the pass waits for the next window");
            return;
        }
        self.last_signals = self.signals();
        self.optimizations = self.optimizations + 1;
        OptimizeRequested <- OptimizeRequest { org: self.org_id, signals: self.last_signals };
    }
    // The org program's loop calls this with a millisecond clock (the
    // scaffold passes `std::time::monotonic_ns() / 1000000`; `now()` is
    // seconds and would make a 60s cadence an hour's); the cadence is
    // the Board's.
    @unbounded
    fn tick(now: Int) {
        // the cadence is the Board's and may be set after birth
        if self.optimize_every_ms > 0 {
            let mut have = -1;
            let mut k = 0;
            while k < self.schedules.len() {
                let x = self.schedules.get(k) or Schedule { };
                if x.id == "optimize" { have = x.every_ms; }
                k = k + 1;
            }
            if have != self.optimize_every_ms { let why = self.schedule(Schedule { id: "optimize", every_ms: self.optimize_every_ms, action: "optimize", requires: "" }); }
        }
        let n = self.schedules.len();
        if n == 0 { return; }
        // pause/resume rows appended from a clone reach the record the
        // organism holds; read what arrived (a git journal is re-read
        // from its ref at most every 5s of wall time)
        let wall = std::time::now();
        if wall - self.last_refresh >= 5 { self.last_refresh = wall; let moved = self.journal.refresh(); }
        self.read_schedule_controls();
        let mut i = 0;
        while i < n {
            let mut s = self.schedules.get(i) or Schedule { };
            if s.paused { i = i + 1; continue; }
            let mut due = false;
            if s.every_ms > 0 {
                // armed at the first tick; then once per interval
                // an interval counts from the clock's origin (the optimize
                // pass always did), or from its last fire in the record,
                // so a restart does not fire again before its time
                if !s.armed {
                    s.armed = true;
                    if s.last_at > 0 { s.last_ms = now - (wall - s.last_at) * 1000; }
                }
                if now - s.last_ms >= s.every_ms { s.last_ms = now; due = true; }
            } else if len(s.cron) > 0 {
                let minute = wall / 60;
                if minute != s.last_minute && cron_matches(s.cron, wall) { s.last_minute = minute; due = true; }
            }
            if due {
                if s.action == "optimize" {
                    self.optimize();
                    s.fired = s.fired + 1;
                    let x = self.journal.append(self.journal.revision(), "schedule.fired", s.id, "{\"action\": \"optimize\", \"at\": " + to_string(wall) + "}");
                } else {
                    // overlap: never while the last Task it fired is open — the skip is a row
                    let st = if len(s.task) > 0 { self.task_state(s.task) } else { "done" };
                    if len(s.task) > 0 && st != "done" && st != "failed" {
                        let x = self.journal.append(self.journal.revision(), "schedule.skipped", s.id, "{\"task\": \"" + s.task + "\", \"state\": \"" + (if len(st) == 0 { "pending" } else { st }) + "\", \"at\": " + to_string(wall) + "}");
                    } else {
                        s.fired = s.fired + 1;
                        let t = self.ask(Intent { id: "s:" + s.id + "/" + to_string(s.fired), outcome: s.ask, from: "schedule:" + s.id }, Knobs { routed: len(s.requires) > 0, requires: s.requires });
                        if std::str::starts_with(t, "refused") {
                            let x = self.journal.append(self.journal.revision(), "schedule.refused", s.id, t);
                        } else {
                            s.task = t;
                            let x = self.journal.append(self.journal.revision(), "schedule.fired", s.id, "{\"task\": \"" + t + "\", \"at\": " + to_string(wall) + "}");
                        }
                    }
                }
            }
            self.schedules.set(i, s) or discard;
            i = i + 1;
        }
    }
    // GH #610: declare a schedule. A malformed cron is refused here,
    // not when it would first fire; the declaration is a row when it
    // is new or changed. "" when accepted, else why.
    @unbounded
    fn schedule(s: Schedule) -> String {
        if len(s.id) == 0 { return "a schedule needs an id"; }
        if s.every_ms <= 0 && len(s.cron) == 0 { return "schedule " + s.id + ": an interval (every_ms) or a cron expression"; }
        if s.every_ms > 0 && len(s.cron) > 0 { return "schedule " + s.id + ": an interval or a cron, not both"; }
        if s.action == "ask" && len(s.ask) == 0 { return "schedule " + s.id + ": an ask to fire"; }
        if len(s.cron) > 0 {
            let why = cron_check(s.cron);
            if len(why) > 0 {
                let x = self.journal.append(self.journal.revision(), "schedule.refused", s.id, "cron `" + s.cron + "`: " + why);
                return "schedule " + s.id + ": cron `" + s.cron + "`: " + why;
            }
        }
        // state from the record: the last Task it fired, paused or not
        let mut fresh = Schedule { id: s.id, every_ms: s.every_ms, cron: s.cron, ask: s.ask, requires: s.requires, action: s.action };
        let mut last_decl = "";
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.entity == s.id && e.kind == "schedule.declared" { last_decl = e.body; }
            if e.entity == s.id && e.kind == "schedule.fired" {
                let t = std::json::find_string_field(e.body, "task");
                if len(t) > 0 { fresh.task = t; }
                fresh.fired = fresh.fired + 1;
                fresh.last_at = std::json::find_int_field(e.body, "at");
            }
            if e.entity == s.id && e.kind == "schedule.paused" { fresh.paused = true; }
            if e.entity == s.id && e.kind == "schedule.resumed" { fresh.paused = false; }
            i = i + 1;
        }
        let decl = schedule_json(fresh);
        if decl != last_decl { let x = self.journal.append(self.journal.revision(), "schedule.declared", s.id, decl); }
        let mut k = 0;
        while k < self.schedules.len() {
            let have = self.schedules.get(k) or Schedule { };
            if have.id == s.id { self.schedules.set(k, fresh) or discard; return ""; }
            k = k + 1;
        }
        self.schedules.push(fresh);
        self.schedules_read = self.journal.revision();
        return "";
    }
    // Pause/resume rows appended since the last read (by `hale dna
    // schedule pause|resume`, from any clone) change the state here.
    @unbounded
    fn read_schedule_controls() {
        let n = self.journal.revision();
        let mut i = self.schedules_read;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "schedule.paused" || e.kind == "schedule.resumed" {
                let mut k = 0;
                while k < self.schedules.len() {
                    let mut s = self.schedules.get(k) or Schedule { };
                    if s.id == e.entity { s.paused = e.kind == "schedule.paused"; self.schedules.set(k, s) or discard; }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        self.schedules_read = n;
    }
    // The leader's answer: clean, or one small proposal — which enters
    // as an ask in the leader's name and takes the whole road (planned,
    // proposed, reviewed by the Board as an organization change).
    @unbounded
    fn on_org_reviewed(r: OrgReview) {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("outcome", if len(r.proposal) > 0 { "proposed" } else { "clean" });
        b.string_field("proposal", r.proposal);
        b.string_field("narrative", r.narrative);
        b.string_field("package", r.package);
        b.string_field("by", r.by);
        b.string_field("signals", self.last_signals);
        b.end_object();
        let x = self.journal.append(self.journal.revision(), "org.reviewed", self.org_id, b.result());
        if len(r.proposal) > 0 {
            let id = self.ask(Intent { id: "opt" + to_string(self.optimizations), outcome: r.proposal, from: r.by }, Knobs { routed: true, requires: "edit" });
        }
    }
    // A planned ask becomes a Mutation under the class and target the
    // leader named; an ask the leader calls a person's job is handed
    // rather than mutated. Bounded by the Tasks the membrane admits.
    @unbounded
    fn on_planned(p: Plan) {
        let mut i = 0;
        let mut found = -1;
        while i < self.pending_plans.len() {
            let w = self.pending_plans.get(i) or WorkRequest { };
            if w.work_id == p.work_id { found = i; }
            i = i + 1;
        }
        if found < 0 { return; }
        let req = self.pending_plans.get(found) or WorkRequest { };
        self.pending_plans.set(found, WorkRequest { }) or discard;
        self.plans = self.plans + 1;
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("kind", p.kind);
        b.string_field("change_class", p.change_class);
        b.string_field("class_applied", if p.kind == "organism" { "organization" } else { p.change_class });
        b.string_field("target", p.target);
        b.string_field("assignee", p.assignee);
        b.int_field("count", p.count);
        b.string_field("narrative", p.narrative);
        b.string_field("package", p.package);
        b.string_field("by", p.by);
        b.bool_field("parsed", p.parsed);
        b.end_object();
        let j = self.journal.append(self.journal.revision(), "task.planned", req.task_id, b.result());
        self.execute_plan(req.task_id, req.work_id, req.objective, req.target, p);
    }
    // The plan's execution, apart from receiving it: reached from
    // `on_planned` with a live Work, and from `resume_work` after a
    // restart with the plan read back from the record (GH #604 rule 2:
    // a restart never regenerates a plan).
    @unbounded
    fn execute_plan(task_id: String, work_id: String, objective: String, ask_target: String, p: Plan) {
        let req = WorkRequest { task_id: task_id, work_id: work_id, objective: objective, target: ask_target };
        if p.kind == "person" {
            // GH #596 W: a person's job. The Work is done as far as the
            // organism is concerned — it handed the Task on — and the
            // Task stays HANDED in the record until the person reports
            // it done (`hale dna task done <id> --as <who>`).
            let handed = "handed: not a software change — " + p.narrative;
            WorkDone <- WorkSettlement { work_id: req.work_id, disposition: "done", result: handed, attempts: 0, history: "a0:leader:handed " };
            // GH #604 rule 4: the row names the assignee the plan named,
            // so completion can be checked against them at admission.
            let hb = std::json::Builder { };
            hb.begin_object();
            hb.string_field("work", req.work_id);
            hb.string_field("assignee", p.assignee);
            hb.string_field("by", "leader");
            hb.string_field("narrative", handed);
            hb.end_object();
            let x = self.journal.append(self.journal.revision(), "task.handed", req.task_id, hb.result());
            self.membrane.notify("task", req.task_id + " handed to " + (if len(p.assignee) > 0 { p.assignee } else { "a person (unassigned)" }));
            return;
        }
        // The governed child comes from the KIND, and the class is
        // assessed under that child's policy (the stack review's
        // finding 1: a plan of kind `organism` with class `docs` gave
        // the editor the application's grant, changed the application,
        // and asked the leader's authority for a change to the
        // organism). An organism change is class `organization`
        // whatever its nature — the Board's — and a class of
        // `organization` for a child that is not the organism is a
        // combination the gate refuses before any editor is placed.
        let class = if p.kind == "organism" { "organization" } else { p.change_class };
        if p.kind != "organism" && class == "organization" {
            let why = "plan names an organization change for a child that is not the organism (kind " + p.kind + "); refused";
            let z = self.journal.append(self.journal.revision(), "task.refused", req.task_id, why);
            WorkDone <- WorkSettlement { work_id: req.work_id, disposition: "failed", result: why, attempts: 0, history: "a0:leader:refused " };
            if self.task_state(req.task_id) == "pending" {
                let x = self.journal.append(self.journal.revision(), "task.failed", req.task_id, req.work_id + " by leader: " + why);
            }
            return;
        }
        // The plan's target is taken only when it names a file the
        // genome has under the seed the class edits; a model's prose
        // ("main.hl (Gateway locus)") is not a path, and used as one it
        // became an empty read, an apology written into a file of that
        // name, and a candidate carrying it. Else the ask's own target,
        // and the editor locates from the objective.
        let seed = if class == "organization" { self.org_seed } else { self.genome_seed };
        let under = self.gateway.repo.root() + "/" + (if seed == "." { "" } else { seed + "/" }) + p.target;
        let planned_target = len(p.target) > 0 && !std::str::contains(p.target, " ") && std::io::fs::file_exists(under);
        let target = if planned_target { p.target } else { req.target };
        let out = self.mutate(req.task_id, class, req.objective, target, std::time::now());
        let ok = std::str::contains(out, ": review") || std::str::contains(out, ": release");
        WorkDone <- WorkSettlement {
            work_id: req.work_id,
            disposition: if ok { "done" } else { "failed" },
            result: out,
            attempts: 1,
            history: "a0:editor:" + (if ok { "done" } else { "failed" }) + " "
        };
        // F.15, as on the direct path: the Work that asked settled
        // PENDING while the plan was made; the durable Task is settled
        // here, in the Journal, by the assembly that did its Work
        if self.task_state(req.task_id) == "pending" {
            let x = self.journal.append(self.journal.revision(), "task." + (if ok { "done" } else { "failed" }), req.task_id,
                req.work_id + " by " + self.editor.identity() + ": " + out);
        }
    }
    // Bounded by the humans offering intent; each birth is a Task the
    // Metabolism owns and settles.
    @unbounded
    fn on_intent(o: IntentOffer) {
        let mut from = o.from;
        if from == "" { from = "membrane"; }
        // Intent through the membrane asks the organism to change: the
        // Task's Work is routed back to the assembly as source-editing
        // Work (GH #529 D7 steps 4-6).
        self.last_task = self.ask(Intent { id: o.intent_id, outcome: o.outcome, from: from }, Knobs { routed: true, requires: "edit" });
    }
    // Source-editing Work (GH #529 D7 steps 5-6): the editor's Attempt
    // inside a worktree, under its grant, then the whole pipeline to
    // the Review; the Work settles with the mutation's id and where it
    // stopped. Bounded by the Tasks the membrane admits.
    @unbounded
    fn on_work_requested(req: WorkRequest) {
        if !std::str::contains(req.requires, "edit") { return; }
        if self.planned {
            self.pending_plans.push(req);
            PlanRequested <- PlanRequest { org: self.org_id, task_id: req.task_id, work_id: req.work_id, objective: req.objective, target: req.target, requires: req.requires, data_class: req.data_class };
            return;
        }
        let out = self.mutate(req.task_id, "application", req.objective, req.target, std::time::now());
        let ok = std::str::contains(out, ": review") || std::str::contains(out, ": release");
        WorkDone <- WorkSettlement {
            work_id: req.work_id,
            disposition: if ok { "done" } else { "failed" },
            result: out,
            attempts: 1,
            history: "a0:editor:" + (if ok { "done" } else { "failed" }) + " "
        };
        // F.15: behind an off-thread bus the Work that asked is gone and
        // its Task settled PENDING; the durable Task is settled here, in
        // the Journal, by the assembly that did its Work.
        if self.task_state(req.task_id) == "pending" {
            let x = self.journal.append(self.journal.revision(), "task." + (if ok { "done" } else { "failed" }), req.task_id,
                req.work_id + " by " + self.editor.identity() + ": " + out);
        }
    }
    // The last `task.<state>` journaled for an id ("" when only born).
    @unbounded
    fn task_state(task_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.entity == task_id && std::str::contains(e.kind, "task.") && e.kind != "task.born" && e.kind != "task.planned" { out = e.kind[5..len(e.kind)]; }
            i = i + 1;
        }
        return out;
    }
    // A root Task settled asynchronously (its Work was routed): the
    // Journal records it once. Bounded by the Tasks born.
    @unbounded
    fn on_task_settled(t: TaskSettlement) {
        if t.parent_task != "" { return; }
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            // born, planned and pending are not settlements: a routed
            // Task is journaled pending at birth, and with the leader's
            // plan in between its settlement now lands after that row
            if e.entity == t.task_id && std::str::contains(e.kind, "task.") && e.kind != "task.born" && e.kind != "task.planned" && e.kind != "task.pending" { return; }
            i = i + 1;
        }
        let x = self.journal.append(self.journal.revision(), "task." + t.disposition, t.task_id, t.detail);
    }
    // Pressure is measured, journaled, and — when it persists — answered
    // with a PROPOSAL for an organ, never with one (GH #529 D7 extension
    // 4): growing is a Mutation like any other, asked for and reviewed.
    @unbounded
    fn on_pressure(p: Pressure) {
        let mut seen = 1;
        let n = self.journal.revision();
        let mut i = 0;
        let mut proposed = false;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "pressure.raised" && e.entity == p.source { seen = seen + 1; }
            if e.kind == "appendage.proposed" && e.entity == p.source { proposed = true; }
            i = i + 1;
        }
        let x = self.journal.append(self.journal.revision(), "pressure.raised", p.source, p.what + " x" + to_string(seen));
        if seen >= self.appendage_threshold && !proposed {
            let y = self.journal.append(self.journal.revision(), "appendage.proposed", p.source,
                "an organ for `" + p.what + "` is proposed, not created: pressure raised " + to_string(seen) + " times");
            self.membrane.notify("appendage", p.source + ": " + p.what + " persists; an organ is proposed, not grown");
            // GH #566 F3: initiative — the proposal is a candidate commit to
            // the organization's own seed, verified like any change and
            // the Board's to decide (an `organization` change always is)
            if self.initiative {
                let out = self.mutate("pressure:" + p.source, "organization",
                    "grow a position in main.hl for `" + p.what + "` (pressure from " + p.source + "): a dna::Leader beside the existing one, named for what it oversees, with `models: leader_models()` from the catalog", "", std::time::now());
                let z = self.journal.append(self.journal.revision(), "appendage.candidate", p.source, out);
            }
        }
    }
    // GH #583 K2: a concern — a child's signal about the part above it
    // — is journaled; when it persists from one source it becomes a
    // knowledge proposal by that source, bound to its parent (a concern
    // by the tower rule), for the Board to ratify. A source with no
    // parent has nothing to bind to and is refused, saying so.
    @unbounded
    fn on_concern(c: Concern) {
        let mut seen = 1;
        let n = self.journal.revision();
        let mut i = 0;
        let mut proposed = false;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "concern.raised" && e.entity == c.source { seen = seen + 1; }
            if e.kind == "concern.proposed" && e.entity == c.source { proposed = true; }
            i = i + 1;
        }
        let x = self.journal.append(self.journal.revision(), "concern.raised", c.source, c.what + " x" + to_string(seen) + " severity " + to_string(c.severity));
        if seen < self.concern_threshold || proposed { return; }
        let parent = parent_path(c.source);
        if len(parent) == 0 {
            let r = self.journal.append(self.journal.revision(), "knowledge.refused", "concern:" + c.source, "a concern binds to its source's parent, and `" + c.source + "` has none: name the source as a path under org");
            return;
        }
        let digest = self.propose_knowledge(Idea { id: "concern:" + c.source, kind: "concern", text: c.what, author: c.source }, parent);
        let y = self.journal.append(self.journal.revision(), "concern.proposed", c.source, (if len(digest) > 0 { digest } else { "refused" }) + " after " + to_string(seen) + " raise(s)");
        self.membrane.notify("concern", c.source + ": `" + c.what + "` persists; proposed as knowledge for " + parent + ", the Board's to ratify");
    }
    // Intent enters through the membrane and births a durable Task;
    // its birth and its settlement are Journal events (the causal
    // authority), the live locus is the expression.
    fn ask(i: Intent, k: Knobs) -> String {
        let gate = self.membrane.offer(i);
        if gate != "accepted" {
            let x = self.journal.append(self.journal.revision(), "intent.refused", i.id, gate);
            return gate;
        }
        // GH #583 M1: no model-backed work is routed on an exhausted budget
        let now = std::time::now();
        if self.budget_exhausted(now) {
            let why = "refused: budget exhausted (" + self.budget.describe(now) + ")";
            let x = self.journal.append(self.journal.revision(), "intent.refused", i.id, why);
            return why;
        }
        self.asked = self.asked + 1;
        let born = self.journal.append(self.journal.revision(), "intent.offered", i.id, i.outcome);
        if !born.ok { return "refused: journal " + born.error; }
        // GH #604 rule 1: the durable fact precedes the act. The id is
        // minted, the birth is journaled (naming its intent, so a reader
        // can walk intent -> task), and only then is the Task born; a
        // birth the record refuses stops here, and nothing has run.
        let id = self.metabolism.next_id();
        let r = self.journal.append(self.journal.revision(), "task.born", id, i.id + ": " + i.outcome);
        if !r.ok {
            let x = self.journal.append(self.journal.revision(), "intent.refused", i.id, "the record refused the birth: " + r.error);
            self.membrane.notify("journal", "append failed; " + i.id + " not admitted");
            return "refused: journal " + r.error;
        }
        let born_id = self.metabolism.offer_as(id, i, k);
        let s = self.metabolism.find(id);
        // settled already (in-tower performers answer synchronously);
        // routed Work settles later and `on_task_settled` journals it.
        // A Task the leader handed to a person is settled as far as the
        // metabolism goes — the organism's part is over — but stays
        // HANDED in the record until the person reports it done (GH
        // #604 rule 4): no settlement row here.
        if s.id != "" && self.task_state(id) != "handed" {
            let r2 = self.journal.append(self.journal.revision(), "task." + s.disposition, id, s.detail);
        }
        return id;
    }
    // The child's boundary reads the ceiling as it is NOW, before each
    // assessment (GH #596, layering).
    fn bind_ceiling() {
        if len(self.ceiling.child) > 0 { self.boundary.ceiling = self.ceiling.current_grant(); }
    }
    // An outcome under the organism's ceiling: a contraction binds
    // every child at once, and the record names them.
    fn ceiling_outcome(ok: Bool) {
        let before = self.ceiling.current_grant().max_magnitude;
        self.ceiling.note_outcome(ok);
        let after = self.ceiling.current_grant().max_magnitude;
        if after < before {
            let x = self.journal.append(self.journal.revision(), "grant.contracted", self.ceiling.child,
                "ceiling " + to_string(before) + " -> " + to_string(after) + " on repeated failure; binds " + self.boundary.child + " from now");
        }
    }
    // A staged mutation: assessed under the boundary, reviewed per
    // policy, and NEVER applied by this assembly's deployment.
    fn stage(change_class: String, candidate_digest: String, m: Magnitude, e: Evidence) -> String {
        self.bind_ceiling();
        let d = self.boundary.assess(change_class, m, e);
        let name = disposition_name(d);
        let r = self.journal.append(self.journal.revision(), "mutation." + name, candidate_digest, change_class);
        return match d {
            Disposition::Release -> {
                // the grant would allow it; the deployment gateway
                // decides whether expression is possible here at all
                if self.deployment.apply(candidate_digest) {
                    "applied"
                } else {
                    self.membrane.notify("mutation", "staged (no deployment): " + candidate_digest);
                    "stage"
                }
            },
            Disposition::Review -> {
                self.membrane.notify("review", self.review_policy.required_authority(change_class, m) + " needed for " + candidate_digest);
                name
            },
            Disposition::Stage -> {
                self.membrane.notify("review", self.review_policy.required_authority(change_class, m) + " needed for " + candidate_digest);
                name
            },
            Disposition::Escalate -> name,
            Disposition::Deny -> name,
        };
    }
    // ---- Phase 2: a Mutation, end to end up to its Review (GH #529 D4)
    // Open a worktree at the genome's head, let the editor propose
    // inside it, commit the candidate, verify it with receipts, and put
    // it under a blocking Review pinned to the exact candidate commit.
    // Returns "<id>: review" or "<id>: failed: <why>".
    // Which seed a change class edits: the organization's own for an
    // `organization` change, the genome's for the rest.
    fn seed_for(change_class: String) -> String {
        if change_class == "organization" { return self.org_seed; }
        return self.genome_seed;
    }
    @unbounded
    fn mutate(task_id: String, change_class: String, objective: String, target: String, now: Int) -> String {
        self.mutations_minted = self.mutations_minted + 1;
        let id = "m" + to_string(self.mutations_minted);
        self.last_mutation = id;
        let seed = self.seed_for(change_class);
        let base = self.gateway.head();
        let x0 = self.journal.append(self.journal.revision(), "mutation.proposed", id, "task " + task_id + " " + change_class + ": " + objective + " (" + target + ") at " + base);
        let lease = self.gateway.take(id, "dna", now);
        let opened = self.gateway.open(self.journal, id, base, lease.token, now);
        if !opened.ok { return self.mutation_failed(id, "worktree: " + opened.refused); }
        let wt = opened.value;
        // GH #583 K2: the owner asks the knowledge service what the
        // organization ratified for this target and folds it into the
        // objective; the editor never reaches knowledge, it receives a
        // package by way of its owner, and its evidence names the package
        let pkg = self.knowledge_client.package_for(knowledge_target(change_class, self.boundary.child, seed), objective);
        if self.knowledge_client.ready() {
            let kb = std::json::Builder { };
            kb.begin_object();
            kb.string_field("target", pkg.target);
            kb.string_field("digest", pkg.digest);
            kb.int_field("revision", pkg.revision);
            kb.int_field("included_n", pkg.included_n);
            kb.string_field("included", pkg.included);
            kb.string_field("error", pkg.error);
            kb.end_object();
            let kx = self.journal.append(self.journal.revision(), "knowledge.consulted", id, kb.result());
        }
        // what the editor gets: the ask with the practices under it. The
        // record, the commit message and the Mutation keep the ask itself.
        let handed = objective_with(objective, pkg);
        // the grant is the seed this change edits, inside THIS worktree;
        // the worktree is what a harness's export copies, the repository
        // what it must never reach (GH #583 M3)
        self.editor.place(wt, seed, self.gateway.repo.root());
        let mut file = target;
        // step 5: the Attempt inspects the listing under its grant — unless
        // its backend works in place (GH #583 M3): a harness finds its own
        // files, and the import says which it changed
        if len(file) == 0 && !self.editor.in_place("internal") {
            file = self.editor.locate(objective);
            if len(file) == 0 {
                let x = self.gateway.remove(self.journal, id, lease.token, now);
                return self.mutation_failed(id, "attempt: no file in the grant answers `" + objective + "`");
            }
            let x1 = self.journal.append(self.journal.revision(), "mutation.located", id, file + " under " + self.editor.grant());
        } else if len(file) > 0 {
            // named by the asker or by the leader's plan: the record still
            // says what the Attempt inspected, and under what grant
            let x1 = self.journal.append(self.journal.revision(), "mutation.located", id, file + " under " + self.editor.grant() + " (named)");
        }
        // GH #583 M3: the genome must not move while an attempt runs —
        // an editor's process (a harness with tools) could reach it only
        // around the boundary, and the record says so instead of the
        // candidate quietly building on a moved base
        let head_before = self.gateway.head();
        let wt_before = self.gateway.repo.head(wt);
        let r = self.editor.perform(WorkRequest {
            work_id: id, task_id: task_id, objective: handed, target: file, data_class: "internal",
            context_digest: pkg.digest, knowledge_bindings: bindings_of(pkg)
        });
        if self.gateway.head() != head_before || self.gateway.repo.head(wt) != wt_before {
            let x = self.gateway.remove(self.journal, id, lease.token, now);
            return self.mutation_failed(id, "the genome moved during the attempt (" + head_before + " -> " + self.gateway.head() + "; worktree " + wt_before + " -> " + self.gateway.repo.head(wt) + "): nothing built on it is a candidate");
        }
        if r.disposition != "done" {
            let x = self.gateway.remove(self.journal, id, lease.token, now);
            return self.mutation_failed(id, "attempt: " + r.narrative);
        }
        let committed = self.gateway.commit(self.journal, id, "a0", change_class + ": " + objective, lease.token, now);
        if !committed.ok { return self.mutation_failed(id, "commit: " + committed.refused); }
        let m = Mutation {
            id: id, task_id: task_id, base_commit: base, worktree: wt,
            candidate_commit: committed.value, candidate_digest: committed.value,
            change_class: change_class, seed: seed, rationale: objective,
            fitness_signals: std::json::find_string_field(r.result, "fitness_signals"),
            disposition: "proposed"
        };
        let report = self.verification.verify(self.journal, m, self.baseline);
        if !report.evidence.check_clean {
            let x = self.journal.append(self.journal.revision(), "mutation.deny", id, "candidate does not check (" + report.steps + ")");
            return id + ": denied: candidate does not check";
        }
        // GH #566 F5: a change to one service that breaks a claim the fleet
        // makes over all of them is denied with the witness in the evidence
        if !report.evidence.fleet_clean {
            let x = self.journal.append(self.journal.revision(), "mutation.deny", id, "candidate breaks the fleet (" + report.steps + ")");
            return id + ": denied: candidate breaks the fleet";
        }
        // a candidate that names a plan or the manifest changes the fleet's
        // shape: it is a topology mutation whatever it was asked as
        let mut reviewed = m;
        if report.evidence.topology_changed && m.change_class != "topology" {
            reviewed = Mutation {
                id: m.id, task_id: m.task_id, base_commit: m.base_commit, worktree: m.worktree,
                candidate_commit: m.candidate_commit, candidate_digest: m.candidate_digest,
                change_class: "topology", seed: m.seed, rationale: m.rationale,
                fitness_signals: m.fitness_signals, disposition: m.disposition
            };
            let y = self.journal.append(self.journal.revision(), "mutation.topology", id, "names a plan or the manifest: the fleet's shape changes, the Board decides");
        }
        let d = self.review_mutation(reviewed, report, self.editor.identity());
        return id + ": " + d;
    }
    fn mutation_failed(id: String, why: String) -> String {
        let x = self.journal.append(self.journal.revision(), "mutation.failed", id, why);
        self.membrane.notify("mutation", id + " failed: " + why);
        return id + ": failed: " + why;
    }
    // Assess under the boundary, record the disposition, and — Phase 2,
    // whatever the grant says — block on a human Review pinned to the
    // exact candidate. The request carries everything a reviewer
    // renders: the evidence steps, the magnitude, where the diffs are.
    @unbounded
    fn review_mutation(m: Mutation, r: VerificationReport, author: String) -> String {
        self.bind_ceiling();
        let d = self.boundary.assess(m.change_class, r.magnitude, r.evidence);
        let name = disposition_name(d);
        let x = self.journal.append(self.journal.revision(), "mutation." + name, m.id, m.change_class + " candidate " + m.candidate_commit);
        // Outside the grant nobody below the Board decides (escalate);
        // inside it, the policy names the authority.
        let authority = if name == "escalate" { "board" } else { self.review_policy.required_authority(m.change_class, r.magnitude) };
        // Post-review autonomy (GH #529 D7 extension 2): inside the grant,
        // no hard boundary, evidence sufficient, and a policy that does
        // not block this class — the candidate is applied NOW and the
        // Review follows; a rejection then rolls it back. Every step is
        // the same gate, the same fences, the same Journal.
        let post = name == "release" && !self.review_policy.blocking(m.change_class);
        if post {
            let applied = self.apply_candidate(m.id, m.candidate_commit, std::time::now());
            if applied != "applied" { return "failed: " + applied; }
        }
        let question = (if post { "post-review: applied " } else { "apply " }) + m.id + " (" + m.change_class + "): " + m.rationale + "?";
        Review {
            review_id: m.id, question: question, subject_digest: m.candidate_commit,
            required_authority: authority, author: author
        };
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("question", question);
        b.string_field("subject_digest", m.candidate_commit);
        b.string_field("required_authority", authority);
        b.string_field("author", author);
        b.string_field("mutation_id", m.id);
        b.string_field("task_id", m.task_id);
        b.string_field("change_class", m.change_class);
        b.string_field("seed", m.seed);
        b.string_field("disposition", name);
        b.string_field("base_commit", m.base_commit);
        b.string_field("candidate_commit", m.candidate_commit);
        b.string_field("candidate_shape", r.candidate_shape);
        b.string_field("worktree", m.worktree);
        b.string_field("fitness_signals", m.fitness_signals);
        b.string_field("evidence", r.steps);
        b.field("magnitude", magnitude_json(r.magnitude));
        b.string_field("diff_text", r.diff_text);
        b.string_field("diff_json", r.diff_json);
        b.end_object();
        let y = self.journal.append(self.journal.revision(), "review.requested", "review:" + m.id, b.result());
        self.membrane.notify("review", authority + " needed for " + m.id + " (" + name + "): " + m.candidate_commit);
        // GH #583 M1: a model-backed position decides only while there is
        // budget; on an exhausted window the Review waits for the Board
        // (`hale dna review`), which needs no model.
        if !self.budget_exhausted(std::time::now()) {
            ReviewRequested <- ReviewRequest {
                review_id: m.id, question: question, subject_digest: m.candidate_commit, required_authority: authority,
                mutation_id: m.id, change_class: m.change_class, seed: m.seed, disposition: name, base_commit: m.base_commit,
                diff_text: r.diff_text, evidence: r.steps, magnitude: magnitude_json(r.magnitude)
            };
        }
        return if post { "release" } else { "review" };
    }
    // Pending mutation Reviews, re-born from the Journal: every
    // `review.requested` that names a mutation and has no settlement.
    // The purpose Review is the Genome's own static child, never
    // rehydrated here.
    @unbounded
    fn rehydrate() {
        let n = self.journal.revision();
        let mut i = 0;
        // durable ids continue where the Journal left them
        let mut tasks = 0;
        let mut mutations = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "task.born" { tasks = tasks + 1; }
            if e.kind == "mutation.proposed" { mutations = mutations + 1; }
            // a mutation's Review, or a knowledge proposal's (GH #583 K1)
            if e.kind == "review.requested" && (std::str::contains(e.body, "\"mutation_id\"") || std::str::contains(e.body, "\"knowledge_digest\"")) {
                let id = if std::str::contains(e.body, "\"mutation_id\"") { std::json::find_string_field(e.body, "mutation_id") } else { e.entity[7..len(e.entity)] };
                let mut settled = false;
                let mut settlement = "";
                let mut k = i + 1;
                while k < n {
                    let s = self.journal.read(k);
                    if s.kind == "review.settled" && s.entity == id { settled = true; settlement = s.body; }
                    k = k + 1;
                }
                if !settled {
                    Review {
                        review_id: id,
                        question: std::json::find_string_field(e.body, "question"),
                        subject_digest: std::json::find_string_field(e.body, "subject_digest"),
                        required_authority: std::json::find_string_field(e.body, "required_authority"),
                        author: std::json::find_string_field(e.body, "author")
                    };
                    self.rehydrated = self.rehydrated + 1;
                } else if std::str::starts_with(settlement, "approve by ") && std::str::contains(e.body, "\"mutation_id\"") {
                    // Approved and never applied — the destination was
                    // dirty, and the organization stopped before it was
                    // cleared. The Review comes back settled, so that
                    // approving again after the restart is admitted by
                    // the same locus under the same rules (the fourth
                    // review round's finding 3: with no Review, the
                    // second approval met nothing at all).
                    let d = self.disposition_of(id);
                    if d != "applied" && d != "retained" && d != "rejected" && d != "rolled_back" {
                        Review {
                            review_id: id,
                            question: std::json::find_string_field(e.body, "question"),
                            subject_digest: std::json::find_string_field(e.body, "subject_digest"),
                            required_authority: std::json::find_string_field(e.body, "required_authority"),
                            author: std::json::find_string_field(e.body, "author"),
                            settled: true, outcome: "approve", decided_by: settlement[11..len(settlement)]
                        };
                        self.rehydrated = self.rehydrated + 1;
                    }
                }
            }
            i = i + 1;
        }
        self.metabolism.resume(tasks);
        if mutations > self.mutations_minted { self.mutations_minted = mutations; }
        self.budget.rehydrate(self.journal, std::time::now());
        self.reconcile_effects();
        self.fail_in_flight();
        self.note_unrecovered_intents();
        self.resume_work();
    }
    // GH #604 rule 3: an effect requested and never resulted was in
    // dispatch when the organism stopped, and the outside may have
    // changed. Each is resolved by evidence where evidence exists and
    // marked unknown where it does not; an unknown effect is never
    // re-dispatched in silence — the gate refuses it until a person
    // resolves it (`hale dna effect resolve`).
    @unbounded
    fn reconcile_effects() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "effect.requested" {
                let key = e.entity;
                let st = effect_status(self.journal, key);
                if !st.done {
                    let mut verdict = "unknown (reconciled after a restart: no evidence either way)";
                    if std::str::starts_with(key, "apply:") {
                        let cand = key[6..len(key)];
                        let head = self.gateway.head();
                        verdict = if head == cand { "ok (reconciled after a restart: the genome is at the candidate)" } else { "unknown (reconciled after a restart: the genome is at " + head + ", not the candidate)" };
                    } else if std::str::starts_with(key, "rollback:") {
                        let after = key[9..len(key)];
                        let c = std::str::index_of(after, ":");
                        let base = if c < 0 { after } else { after[(c + 1)..len(after)] };
                        let head = self.gateway.head();
                        verdict = if head == base { "ok (reconciled after a restart: the genome is at the base)" } else { "unknown (reconciled after a restart: the genome is at " + head + ", not the base)" };
                    } else if std::str::starts_with(key, "worktree.open:") {
                        let m = key[14..len(key)];
                        verdict = if std::io::fs::file_exists(self.gateway.workspaces.path_of(m)) { "ok (reconciled after a restart: the worktree is there)" } else { "failed (reconciled after a restart: no worktree was opened)" };
                    }
                    let x = self.journal.append(self.journal.revision(), "effect.result", key, verdict);
                    if std::str::starts_with(verdict, "unknown") { self.membrane.notify("effect", key + ": outcome unknown after a restart; `hale dna effect resolve " + key + " --outcome ok|failed`"); }
                }
            }
            i = i + 1;
        }
    }
    // GH #604 rule 1, the shape from before it: an `intent.offered` with
    // no `task.born` naming it was admitted and lost, or never admitted —
    // the record cannot tell which, and work may already have run. It
    // is not re-offered; the record says so, and the asker asks again.
    @unbounded
    fn note_unrecovered_intents() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "intent.offered" {
                let mut born = false;
                let mut noted = false;
                let mut k = i + 1;
                while k < n {
                    let s = self.journal.read(k);
                    if s.kind == "task.born" && std::str::starts_with(s.body, e.entity + ": ") { born = true; }
                    if s.kind == "intent.unrecovered" && s.entity == e.entity { noted = true; }
                    k = k + 1;
                }
                if !born && !noted {
                    let x = self.journal.append(self.journal.revision(), "intent.unrecovered", e.entity, "offered before a restart and no Task was born; not re-admitted — ask again");
                }
            }
            i = i + 1;
        }
    }
    // The task a mutation was proposed for ("task <id> <class>: …").
    fn task_of_mutation(mutation_id: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        let mut out = "";
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "mutation.proposed" && e.entity == mutation_id && std::str::starts_with(e.body, "task ") {
                let rest = e.body[5..len(e.body)];
                let sp = std::str::index_of(rest, " ");
                out = if sp < 0 { rest } else { rest[0..sp] };
            }
            i = i + 1;
        }
        return out;
    }
    // F.15 by the assembly, when the Work that would have settled the
    // Task is gone (a restart between the proposal and the outcome):
    // the Task settles in the record from its Mutation's outcome.
    fn settle_task_of(mutation_id: String, disposition: String, detail: String) {
        let t = self.task_of_mutation(mutation_id);
        if len(t) == 0 || !std::str::starts_with(t, "t") { return; }
        if self.task_state(t) != "pending" { return; }
        let x = self.journal.append(self.journal.revision(), "task." + disposition, t, mutation_id + " " + detail);
    }
    // GH #604 rule 2: a Task born and not settled re-enters the tower
    // after a restart from its last durable state. With a plan in the
    // record it proceeds under that plan — never replanned; without one
    // it is planned now, for the first time. A Task whose Mutation is
    // beyond proposal is left to that Mutation's outcome (its Review is
    // rehydrated; `settle_task_of` settles it), and a handed Task is a
    // person's, waiting.
    @unbounded
    fn resume_work() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "task.born" {
                let id = e.entity;
                let state = self.task_state(id);
                if state == "pending" || state == "" {
                    let mut proposed = false;
                    let mut plan = "";
                    let mut resumed = false;
                    let mut k = i + 1;
                    while k < n {
                        let s = self.journal.read(k);
                        if s.kind == "mutation.proposed" && std::str::starts_with(s.body, "task " + id + " ") { proposed = true; }
                        if s.kind == "task.planned" && s.entity == id { plan = s.body; }
                        if s.kind == "task.resumed" && s.entity == id { resumed = true; }
                        k = k + 1;
                    }
                    if !proposed && !resumed {
                        let colon = std::str::index_of(e.body, ": ");
                        let objective = if colon < 0 { e.body } else { e.body[(colon + 2)..len(e.body)] };
                        if len(plan) > 0 {
                            let x = self.journal.append(self.journal.revision(), "task.resumed", id, "after a restart, under the plan in the record; not replanned");
                            self.execute_plan(id, id + "/resumed", objective, "", Plan {
                                org: self.org_id, task_id: id, work_id: id + "/resumed",
                                kind: std::json::find_string_field(plan, "kind"),
                                change_class: std::json::find_string_field(plan, "change_class"),
                                target: std::json::find_string_field(plan, "target"),
                                count: std::json::find_int_field(plan, "count"),
                                narrative: std::json::find_string_field(plan, "narrative"),
                                package: std::json::find_string_field(plan, "package"),
                                by: std::json::find_string_field(plan, "by"),
                                assignee: std::json::find_string_field(plan, "assignee"),
                                parsed: true
                            });
                        } else {
                            let x = self.journal.append(self.journal.revision(), "task.resumed", id, "after a restart, before any plan; planned now for the first time");
                            self.on_work_requested(WorkRequest { task_id: id, work_id: id + "/resumed", objective: objective, target: "", requires: "edit" });
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
    // A Mutation whose last word in the record is `proposed`, `worktree`
    // or `located` was in flight — an editor mid-attempt — when the
    // organization stopped (GH #566 F7). Nobody resumes an attempt: it
    // failed, and the record says so instead of showing it in flight
    // forever. Bounded by the mutations the record holds.
    @unbounded
    fn fail_in_flight() {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "mutation.proposed" {
                let id = e.entity;
                let mut last = "proposed";
                let mut removed = false;
                let mut k = i + 1;
                while k < n {
                    let s = self.journal.read(k);
                    if s.entity == id && std::str::starts_with(s.kind, "mutation.") {
                        last = s.kind[9..len(s.kind)];
                        removed = s.kind == "mutation.worktree" && std::str::starts_with(s.body, "removed");
                    }
                    k = k + 1;
                }
                // `mutation.worktree … removed` is the worktree GONE, not opened
                if last == "proposed" || (last == "worktree" && !removed) || last == "located" {
                    self.settle_task_of(id, "failed", "in flight when the organization stopped");
                    let x = self.journal.append(self.journal.revision(), "mutation.failed", id, "in flight (" + last + ") when the organization stopped; nothing resumes an attempt");
                    let y = self.gateway.workspaces.remove(id);
                }
            }
            i = i + 1;
        }
    }
    fn status() -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.int_field("asked", self.asked);
        b.int_field("mutations", self.mutations_minted);
        b.string_field("last_mutation", self.last_mutation);
        b.int_field("reviews_open", self.reviews_open);
        b.int_field("rehydrated", self.rehydrated);
        b.int_field("applied", self.applied);
        b.int_field("restarts_requested", self.restarts_requested);
        b.int_field("workflow_revision", self.metabolism.workflow_revision);
        b.int_field("journal_revision", self.journal.revision());
        b.int_field("tasks_settled", self.metabolism.settled_count());
        b.int_field("work_requests", self.work.requests);
        b.int_field("attempts", self.work.attempts_made);
        b.string_field("routing", self.work.policy());
        b.string_field("review_policy", self.review_policy.name());
        b.string_field("deployment", self.deployment.kind());
        b.int_field("knowledge_revision", self.knowledge.revision);
        b.int_field("notifications", self.membrane.notifications());
        b.string_field("last_task", self.last_task);
        b.end_object();
        return b.result();
    }
}

// ---- schedules (GH #610) ---------------------------------------------

@form(vec)
locus ScheduleRows { capacity { heap rows of Schedule; } }

// The civil date of a unix second, UTC: "minute hour dom month dow"
// space-separated (dow 0 = Sunday). Days-to-civil after Hinnant.
fn civil_fields(secs: Int) -> String {
    let days = if secs >= 0 { secs / 86400 } else { (secs - 86399) / 86400 };
    let rem = secs - days * 86400;
    let hour = rem / 3600;
    let minute = (rem - hour * 3600) / 60;
    let z = days + 719468;
    let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let dom = doy - (153 * mp + 2) / 5 + 1;
    let month = if mp < 10 { mp + 3 } else { mp - 9 };
    let dow = (days + 4) - ((days + 4) / 7) * 7;
    return to_string(minute) + " " + to_string(hour) + " " + to_string(dom) + " " + to_string(month) + " " + to_string(if dow < 0 { dow + 7 } else { dow });
}

fn nth_word(s: String, n: Int) -> String {
    let mut rest = s + " ";
    let mut k = 0;
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        if sp < 0 { return ""; }
        let w = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        if len(w) == 0 { continue; }
        if k == n { return w; }
        k = k + 1;
    }
    return "";
}

fn word_count(s: String) -> Int {
    let mut n = 0;
    while len(nth_word(s, n)) > 0 { n = n + 1; }
    return n;
}

// One cron field against a value: `*`, `*/n`, `a`, `a-b`, `a-b/n`, and
// lists of those. Returns "match" / "no" / "bad: <why>".
fn cron_field(field: String, lo: Int, hi: Int, v: Int, name: String) -> String {
    let mut any = false;
    let mut rest = field + ",";
    while len(rest) > 0 {
        let c = std::str::index_of(rest, ",");
        if c < 0 { break; }
        let item = rest[0..c];
        rest = rest[(c + 1)..len(rest)];
        if len(item) == 0 { return "bad: empty item in " + name; }
        let mut range = item;
        let mut step = 1;
        let slash = std::str::index_of(item, "/");
        if slash >= 0 {
            range = item[0..slash];
            step = std::str::parse_int(item[(slash + 1)..len(item)]) or 0;
            if step <= 0 { return "bad: step `" + item[(slash + 1)..len(item)] + "` in " + name; }
        }
        let mut a = lo;
        let mut b = hi;
        if range != "*" {
            let dash = std::str::index_of(range, "-");
            if dash >= 0 {
                a = std::str::parse_int(range[0..dash]) or - 1;
                b = std::str::parse_int(range[(dash + 1)..len(range)]) or - 1;
            } else {
                a = std::str::parse_int(range) or - 1;
                b = if slash >= 0 { hi } else { a };
            }
            if a < 0 || b < 0 { return "bad: `" + range + "` is not a number or range in " + name; }
            if a < lo || b > hi || a > b { return "bad: `" + range + "` is outside " + to_string(lo) + "-" + to_string(hi) + " in " + name; }
        }
        // dow 7 is Sunday too
        let vv = if name == "day-of-week" && v == 0 && a > 0 { 7 } else { v };
        if vv >= a && vv <= b && (vv - a) - ((vv - a) / step) * step == 0 { any = true; }
    }
    return if any { "match" } else { "no" };
}

// Validate a cron expression: "" when well-formed, else why.
fn cron_check(expr: String) -> String {
    if word_count(expr) != 5 { return "a cron expression has five fields (minute hour day-of-month month day-of-week), not " + to_string(word_count(expr)); }
    let r0 = cron_field(nth_word(expr, 0), 0, 59, 0, "minute");
    if std::str::starts_with(r0, "bad") { return r0[5..len(r0)]; }
    let r1 = cron_field(nth_word(expr, 1), 0, 23, 0, "hour");
    if std::str::starts_with(r1, "bad") { return r1[5..len(r1)]; }
    let r2 = cron_field(nth_word(expr, 2), 1, 31, 1, "day-of-month");
    if std::str::starts_with(r2, "bad") { return r2[5..len(r2)]; }
    let r3 = cron_field(nth_word(expr, 3), 1, 12, 1, "month");
    if std::str::starts_with(r3, "bad") { return r3[5..len(r3)]; }
    let r4 = cron_field(nth_word(expr, 4), 0, 7, 0, "day-of-week");
    if std::str::starts_with(r4, "bad") { return r4[5..len(r4)]; }
    return "";
}

// Whether a well-formed cron expression names this unix second's
// minute (UTC). Day-of-month and day-of-week both restricted: either.
fn cron_matches(expr: String, secs: Int) -> Bool {
    let f = civil_fields(secs);
    let minute = std::str::parse_int(nth_word(f, 0)) or 0;
    let hour = std::str::parse_int(nth_word(f, 1)) or 0;
    let dom = std::str::parse_int(nth_word(f, 2)) or 1;
    let month = std::str::parse_int(nth_word(f, 3)) or 1;
    let dow = std::str::parse_int(nth_word(f, 4)) or 0;
    if cron_field(nth_word(expr, 0), 0, 59, minute, "minute") != "match" { return false; }
    if cron_field(nth_word(expr, 1), 0, 23, hour, "hour") != "match" { return false; }
    if cron_field(nth_word(expr, 3), 1, 12, month, "month") != "match" { return false; }
    let dom_f = nth_word(expr, 2);
    let dow_f = nth_word(expr, 4);
    let dom_ok = cron_field(dom_f, 1, 31, dom, "day-of-month") == "match";
    let dow_ok = cron_field(dow_f, 0, 7, dow, "day-of-week") == "match";
    if dom_f != "*" && dow_f != "*" { return dom_ok || dow_ok; }
    return dom_ok && dow_ok;
}

fn schedule_json(s: Schedule) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("action", s.action);
    b.int_field("every_ms", s.every_ms);
    b.string_field("cron", s.cron);
    b.string_field("ask", s.ask);
    b.string_field("requires", s.requires);
    b.end_object();
    return b.result();
}
