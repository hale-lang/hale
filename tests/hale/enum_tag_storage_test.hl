// A payload-free enum is its tag, stored like any scalar.
//
// `self.x = v` of an enum-typed locus field checked clean and crashed
// the build (the in-place field store took the i32 tag for a pointer).
// `bounded[Color; N]` checked clean and the build refused the element
// type; a tag is inline bytes, as a `Bool` is. An enum WITH payloads is
// a pointer to its cell, which a bounded slot does not anchor: the check
// refuses that element type (crates/hale-codegen/tests/
// corpus_check_build_agreement.rs).
type Color = enum { Red, Green, Blue };
type Shape = enum { Dot, Circle(Int) };
type Palette { picks: bounded[Color; 3]; n: Int = 0; }

locus Brush {
    params { color: Color = Color::Red; shape: Shape = Shape::Dot; }
    fn paint(c: Color) { self.color = c; }
    fn form(s: Shape) { self.shape = s; }
}

main locus App {
    params { b: Brush = Brush { }; seen: bounded[Color; 2]; }
    run() {
        self.b.paint(Color::Blue);
        let mut i = 0;
        while i < 3 {
            self.b.paint(Color::Green);
            i = i + 1;
        }
        std::test::assert(self.b.color == Color::Green, "an enum field takes the assigned tag");
        self.b.form(Shape::Circle(4));
        match self.b.shape {
            Shape::Circle(r) -> {
                std::test::assert_eq_int(r, 4, "a payload enum field is stored too");
            },
            _ -> { std::test::assert(false, "the circle"); },
        }

        push(self.seen, Color::Green) or { };
        push(self.seen, Color::Blue) or { };
        let mut refused = false;
        push(self.seen, Color::Red) or { refused = true; };
        std::test::assert(refused, "a full buffer refuses the third");
        std::test::assert(
            (at(self.seen, 1) or Color::Red) == Color::Blue,
            "a tag read back is the one pushed",
        );
        set(self.seen, 0, Color::Red) or { };
        std::test::assert(
            (at(self.seen, 0) or Color::Green) == Color::Red,
            "set overwrites a live slot",
        );
        let mut n = 0;
        for c in self.seen {
            if c != Color::Green { n = n + 1; }
        }
        std::test::assert_eq_int(n, 2, "iteration walks the live tags");

        let mut p = Palette { };
        push(p.picks, Color::Blue) or { };
        let copy = p;
        std::test::assert_eq_int(count(copy.picks), 1, "a whole-struct copy carries the tags");
        std::test::assert_eq_str(
            to_string(at(copy.picks, 0) or Color::Red),
            "Color::Blue",
            "and prints them",
        );
    }
}

fn main() { App { }; }
