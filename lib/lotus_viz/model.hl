// model.hl — locus tree types for the lotus flower.
//
// Pure shape, no flow (types only, no loci). The parser
// (LocusTreeProvider, see parse.hl) produces these from
// Hale source; the layout engine consumes them to produce
// petal positions; the renderer draws them.
//
// Design reference: DESIGN.md § "What we render".

// ---- Discriminators ----

// LocusKind tags whether this petal represents a locus, a
// type, or an interface. Different kinds get different
// default color families (see aesthetics.hl).
type LocusKind {
    // 0 = Locus (default; "this has flow")
    // 1 = Type  ("this is pure shape")
    // 2 = Interface (F.20; "this is a structural commitment")
    tag: Int = 0;
}

// ProjectionClass tags the locus's perspective-resolution
// commitment. Drives the hue family for Locus-kind petals.
type ProjectionClass {
    // 0 = None (plain locus, no projection annotation)
    // 1 = Rich
    // 2 = Chunked
    // 3 = Recognition
    tag: Int = 0;
}

// ---- The petal ----

// A Petal is one node in the locus tree as the flower sees
// it. Carries enough info for rendering (kind, projection,
// position) AND source navigation (file, line).
type Petal {
    // Identity. Stable across re-parses of the same source.
    id:   String = "";    // canonical: "<file>:<name>", e.g. "main.hl:Iris"
    name: String = "";    // display name, e.g. "Iris"

    // Classification.
    kind:       LocusKind       = LocusKind { };
    projection: ProjectionClass = ProjectionClass { };

    // Tree position. Root petals have parent_id = "". depth
    // is the number of edges from root (root petals are
    // depth 0).
    parent_id: String = "";
    depth:     Int    = 0;

    // Layout position (filled in by layout.hl).
    // x, y, z are 3D coordinates; angle/radius are the polar
    // form on the layout dome (radius along the dome's
    // horizontal axis, angle around the dome's central axis).
    x:      Float = 0.0;
    y:      Float = 0.0;
    z:      Float = 0.0;
    radius: Float = 0.0;
    angle:  Float = 0.0;  // radians

    // Petal size (rendered radius for the disk-with-gradient
    // shape; will become the major-axis-length when the
    // polish-phase ellipse silhouette lands).
    size: Float = 0.5;

    // Source navigation. Click on this petal → source.goto
    // proposal to (file, line).
    file: String = "";
    line: Int    = 0;

    // F.29 candidate-child type names — names appearing as
    // field types inside this locus's `params { ... }` block.
    // Populated by the parser; resolved into parent_id edges
    // by lotus_viz_adapter's resolve_parent_edges after all
    // petals are collected. Newline-separated string because
    // Hale doesn't admit [String] as a struct field type
    // (collection types live on @form(...)-annotated loci, not
    // as type fields).
    child_type_names: String = "";
}

// ---- The tree ----

// LocusTree holds the full parsed model. The parser populates
// it via add_petal / clear; the scene reads via the indexed
// accessors. Backed by @form(vec) for ordered iteration (the
// flower needs predictable rendering order).
@form(vec)
locus LocusTree {
    capacity {
        heap petals of Petal;
    }
    // Synthesized by @form(vec):
    //   push(p: Petal) -> ();
    //   get(i: Int) -> Petal fallible(IndexError);
    //   set(i: Int, p: Petal) -> () fallible(IndexError);
    //   pop() -> Petal fallible(IndexError);
    //   len() -> Int;
    //   is_empty() -> Bool;
}

// ---- Constructors (free fns for ergonomics) ----

// Kind constructors.
fn locus_kind() -> LocusKind { return LocusKind { tag: 0 }; }
fn type_kind()  -> LocusKind { return LocusKind { tag: 1 }; }
fn iface_kind() -> LocusKind { return LocusKind { tag: 2 }; }

// Projection constructors.
fn projection_none()        -> ProjectionClass { return ProjectionClass { tag: 0 }; }
fn projection_rich()        -> ProjectionClass { return ProjectionClass { tag: 1 }; }
fn projection_chunked()     -> ProjectionClass { return ProjectionClass { tag: 2 }; }
fn projection_recognition() -> ProjectionClass { return ProjectionClass { tag: 3 }; }

// Kind / projection name lookups (for diagnostic / state_json).
fn kind_name(k: LocusKind) -> String {
    if k.tag == 0 { return "locus"; }
    if k.tag == 1 { return "type"; }
    if k.tag == 2 { return "interface"; }
    return "unknown";
}

fn projection_name(p: ProjectionClass) -> String {
    if p.tag == 0 { return "none"; }
    if p.tag == 1 { return "rich"; }
    if p.tag == 2 { return "chunked"; }
    if p.tag == 3 { return "recognition"; }
    return "unknown";
}

// Canonical petal id from (file, name).
fn petal_id(file: String, name: String) -> String {
    let b = std::str::builder_new();
    std::str::builder_append(b, file);
    std::str::builder_append(b, ":");
    std::str::builder_append(b, name);
    return std::str::builder_finish(b);
}
