// dna/core/journal.hl — the append-only causal authority (#521 comment 1).
//
// The Journal is the causal authority; Task status, pending reviews,
// and retrieval indexes are PROJECTIONS rebuilt from it. Storage is
// assembled by semantic capability: `Journal` (ordered append with an
// expected revision, idempotency, durable identity), `Coordination`
// (leases with fencing tokens), and a rebuildable `RetrievalIndex`.
// Two implementations of each: in-memory (tests), and the record's git
// chain `refs/dna/journal` (GH #566 F1; record.hl) — one commit per
// event, git's DAG as the chain — using only stdlib and subprocesses.

type Event {
    seq: Int = 0;
    kind: String = ""; // "task.born" | "effect.requested" | ...
    entity: String = ""; // durable id the event is about
    body: String = "";
    prev: String = ""; // digest of the previous event
    digest: String = ""; // sha256(prev + kind + entity + body)
}

// F.7 (dna/FRICTION.md): interface methods cannot be `fallible(E)`,
// so the append contract carries its failure in a result struct.
type AppendResult {
    ok: Bool = false;
    revision: Int = 0; // the revision after a successful append
    error: String = ""; // "stale_revision" | "io"
    expected: Int = 0;
    actual: Int = 0;
}

interface Journal {
    fn revision() -> Int;
    fn head() -> String;
    // Re-read what another writer appended (a git journal from its
    // ref; nothing for a memory journal). True when it had moved.
    fn refresh() -> Bool;
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult;
    // Append only at `expected`: when the record has moved past it,
    // refuse as stale instead of re-appending at the new tail. A caller
    // that read something at a revision — a window's remainder (GH
    // #605) — must not land after another writer that changed it.
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult;
    fn read(i: Int) -> Event;
    fn verify_chain() -> Bool;
}

fn hex(b: Bytes) -> String {
    let digits = "0123456789abcdef";
    let mut out = "";
    let mut i = 0;
    let n = len(b);
    while i < n {
        let v = std::bytes::at(b, i) or 0;
        out = out + digits[(v / 16)..(v / 16 + 1)] + digits[(v % 16)..(v % 16 + 1)];
        i = i + 1;
    }
    return out;
}

fn event_digest(prev: String, kind: String, entity: String, body: String) -> String {
    return hex(std::crypto::sha256(std::bytes::from_string(prev + "|" + kind + "|" + entity + "|" + body)));
}

@form(vec)
locus EventRows {
    capacity { heap rows of Event; }
}

@form(vec)
locus Authors { capacity { heap rows of String; } }

// ---- in-memory journal --------------------------------------------

locus MemJournal {
    params { rows: EventRows = EventRows { }; }
    fn revision() -> Int { return self.rows.len(); }
    fn refresh() -> Bool { return false; }
    // In memory every append is already exact.
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult { return self.append(expected, kind, entity, body); }
    fn head() -> String {
        if self.rows.len() == 0 { return "genesis"; }
        let e = self.rows.get(self.rows.len() - 1) or Event { };
        return e.digest;
    }
    // Compare-and-append: two writers holding the same expected
    // revision cannot both advance the same entity from the same state.
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let rev = self.rows.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let prev = self.head();
        self.rows.push(Event { seq: rev, kind: kind, entity: entity, body: body, prev: prev, digest: event_digest(prev, kind, entity, body) });
        return AppendResult { ok: true, revision: rev + 1 };
    }
    fn read(i: Int) -> Event { return self.rows.get(i) or Event { }; }
    fn verify_chain() -> Bool { return chain_ok(self.rows); }
}

fn chain_ok(rows: EventRows) -> Bool {
    let mut prev = "genesis";
    let mut i = 0;
    while i < rows.len() {
        let e = rows.get(i) or Event { };
        if e.prev != prev { return false; }
        if e.digest != event_digest(e.prev, e.kind, e.entity, e.body) { return false; }
        prev = e.digest;
        i = i + 1;
    }
    return true;
}

// The git-backed `GitJournal`, `GitReceipts` and `GitLeases` live in
// record.hl, over the `Record` interface (GH #646 stage 0).

@unbounded
fn ref_safe(key: String) -> String {
    let mut out = "";
    let mut i = 0;
    while i < len(key) {
        let c = key[i..(i + 1)];
        if c == ":" || c == " " { out = out + "/"; } else { out = out + c; }
        i = i + 1;
    }
    return out;
}

// ---- receipts: content-addressed evidence ----------------------------

interface Receipts {
    fn store(text: String) -> String; // the sha256 hex digest the text is filed under
    fn read(digest: String) -> String; // "" when absent
    // Remove a body (GH #606 redaction); true when it is gone.
    fn erase(digest: String) -> Bool;
    fn kind() -> String;
}

// Under a directory, one file per digest.
locus FileReceipts {
    params { dir: String = ".hale/dna/evidence"; stored: Int = 0; }
    fn kind() -> String { return "file"; }
    fn store(text: String) -> String {
        let digest = hex(std::crypto::sha256(std::bytes::from_string(text)));
        std::io::fs::mkdir(self.dir) or discard;
        std::io::fs::write_file(self.dir + "/" + digest + ".txt", text) or discard;
        self.stored = self.stored + 1;
        return digest;
    }
    fn read(digest: String) -> String { return std::io::fs::read_file(self.dir + "/" + digest + ".txt") or ""; }
    fn erase(digest: String) -> Bool {
        std::io::fs::unlink(self.dir + "/" + digest + ".txt") or discard;
        return len(self.read(digest)) == 0;
    }
}

// ---- coordination: leases with fencing tokens -----------------------

type Lease {
    key: String = "";
    holder: String = "";
    token: Int = 0; // fencing token; monotonically increasing per key
    expires: Int = 0;
    present: Bool = false;
}

// F.7 again: `acquire` reports "held by someone else" as a Lease with
// `present == false` and `holder` naming the current holder.
interface Coordination {
    fn acquire(key: String, holder: String, now: Int, ttl: Int) -> Lease;
    fn complete(key: String, token: Int, now: Int) -> Bool;
    fn holder_of(key: String) -> String;
    // The lease as it stands, so a gateway can FENCE an operation on
    // its token (GH #529 D1): a holder whose lease expired and was
    // re-acquired presents a stale token and is refused.
    fn current(key: String) -> Lease;
}

@form(hashmap)
locus LeaseRows {
    capacity { pool rows of Lease indexed_by key; }
}

locus MemLeases {
    params { rows: LeaseRows = LeaseRows { }; next_token: Int = 1; }
    fn acquire(key: String, holder: String, now: Int, ttl: Int) -> Lease {
        let cur = self.rows.get(key) or Lease { };
        if cur.present && cur.expires > now && cur.holder != holder {
            return Lease { key: key, holder: cur.holder, token: 0, expires: cur.expires, present: false };
        }
        let t = self.next_token;
        self.next_token = self.next_token + 1;
        let l = Lease { key: key, holder: holder, token: t, expires: now + ttl, present: true };
        self.rows.set(l);
        return l;
    }
    // A late writer whose lease expired and was re-acquired holds a
    // stale token; its completion is refused, never applied.
    fn complete(key: String, token: Int, now: Int) -> Bool {
        let cur = self.rows.get(key) or Lease { };
        if !cur.present { return false; }
        if cur.token != token { return false; }
        self.rows.set(Lease { key: key, holder: cur.holder, token: cur.token, expires: 0, present: false });
        return true;
    }
    fn holder_of(key: String) -> String {
        let cur = self.rows.get(key) or Lease { };
        if cur.present { return cur.holder; }
        return "";
    }
    fn current(key: String) -> Lease { return self.rows.get(key) or Lease { }; }
}

// The last `effect.result` body for `key`, "" when none: what a person
// or a restart said about the effect.
@unbounded
fn effect_result_body(j: Journal, key: String) -> String {
    let mut out = "";
    let mut i = 0;
    let n = j.revision();
    while i < n {
        let e = j.read(i);
        if e.entity == key && e.kind == "effect.result" { out = e.body; }
        i = i + 1;
    }
    return out;
}

// True when `token` is the live fencing token for `key` at `now`.
fn lease_fences(c: Coordination, key: String, token: Int, now: Int) -> Bool {
    let cur = c.current(key);
    return cur.present && cur.token == token && cur.expires > now;
}

// ---- leases in the record (GH #646 card 12b) -------------------------
//
// A lease whose state is rows of the record it fences: `lease.taken`
// (the token, a per-key epoch allocated under the exact append that
// takes it; the holder; the expiry), `lease.renewed` (token, holder,
// expiry) and `lease.released` (token, holder), each a JSON body, so a
// holder reads back as it was written and the token is the row's own,
// whatever position a reader finds the row at — a routed reader that
// starts fresh reads the record's rows before the ledger's, and a
// reader that was live read them as they arrived. Read at one revision
// it is the ownership as of that revision, and an exact append at that
// revision validates ownership atomically with the write: a takeover is
// a row, it moves the revision, and a stale holder's exact append fails
// and is decided again. The cell leases above (`MemLeases`,
// `GitLeases`) stay for what they hold; a committer whose every write
// must be fenced holds its lease here.

fn lease_row(token: Int, holder: String, expires: Int) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.int_field("token", token);
    b.string_field("holder", holder);
    if expires >= 0 { b.int_field("expires", expires); }
    b.end_object();
    return b.result();
}

// What the record says about `key` as of `rev`: the take with the
// highest token is the lease, whatever its position; the renewals and
// the release that name that token apply to it, whatever theirs.
@unbounded
fn lease_at(j: Journal, key: String, rev: Int) -> Lease {
    let mut l = Lease { key: key };
    let mut i = 0;
    while i < rev {
        let e = j.read(i);
        if e.entity == key && e.kind == "lease.taken" {
            let token = std::json::find_int_field(e.body, "token");
            if token > l.token {
                l = Lease { key: key, holder: std::json::find_string_field(e.body, "holder"), token: token, expires: std::json::find_int_field(e.body, "expires"), present: true };
            }
        }
        i = i + 1;
    }
    if !l.present { return l; }
    i = 0;
    while i < rev {
        let e = j.read(i);
        if e.entity == key && std::json::find_int_field(e.body, "token") == l.token && std::json::find_string_field(e.body, "holder") == l.holder {
            if e.kind == "lease.renewed" {
                let expires = std::json::find_int_field(e.body, "expires");
                if expires > l.expires { l.expires = expires; }
            }
            if e.kind == "lease.released" { l.present = false; }
        }
        i = i + 1;
    }
    return l;
}

// Whether `holder` holds `key` under `token` as of `rev`, live at `now`.
fn lease_holds_at(j: Journal, key: String, holder: String, token: Int, rev: Int, now: Int) -> Bool {
    let l = lease_at(j, key, rev);
    return l.present && l.holder == holder && l.token == token && l.expires > now;
}

// Take the lease, exactly at the reading that found it free, expired or
// already this holder's; `present == false` names who holds it instead.
// The token is the next epoch of the key, allocated under that append.
// An empty holder names nobody and is refused.
@unbounded
fn lease_take(j: Journal, key: String, holder: String, now: Int, ttl: Int) -> Lease {
    if len(holder) == 0 || len(key) == 0 { return Lease { key: key, present: false }; }
    let mut tries = 0;
    while tries < 6 {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        let cur = lease_at(j, key, rev);
        if cur.present && cur.expires > now && cur.holder != holder {
            return Lease { key: key, holder: cur.holder, token: 0, expires: cur.expires, present: false };
        }
        let token = cur.token + 1;
        let w = j.append_exact(rev, "lease.taken", key, lease_row(token, holder, now + ttl));
        if w.ok { return Lease { key: key, holder: holder, token: token, expires: now + ttl, present: true }; }
        if w.error != "stale_revision" && w.error != "claimed" { return Lease { key: key, holder: cur.holder, present: false }; }
    }
    return Lease { key: key, present: false };
}

// Renew the lease this holder holds under `token`: the token stays, the
// expiry moves. False when the lease is no longer this holder's.
@unbounded
fn lease_renew(j: Journal, key: String, holder: String, token: Int, now: Int, ttl: Int) -> Bool {
    let mut tries = 0;
    while tries < 6 {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        if !lease_holds_at(j, key, holder, token, rev, now) { return false; }
        let w = j.append_exact(rev, "lease.renewed", key, lease_row(token, holder, now + ttl));
        if w.ok { return true; }
        if w.error != "stale_revision" && w.error != "claimed" { return false; }
    }
    return false;
}

// Release the lease this holder holds under `token`.
@unbounded
fn lease_release(j: Journal, key: String, holder: String, token: Int) -> Bool {
    let mut tries = 0;
    while tries < 6 {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        let cur = lease_at(j, key, rev);
        if !cur.present || cur.holder != holder || cur.token != token { return false; }
        let w = j.append_exact(rev, "lease.released", key, lease_row(token, holder, -1));
        if w.ok { return true; }
        if w.error != "stale_revision" && w.error != "claimed" { return false; }
    }
    return false;
}

// ---- idempotent effects over the journal --------------------------

// An effect request is committed BEFORE dispatch under a durable key;
// a retry after a crash finds the key and does not dispatch again;
// the result is appended once. Both facts are Journal events, so the
// ledger is a projection and can be rebuilt.
type EffectStatus {
    requested: Bool = false;
    done: Bool = false;
    ok: Bool = false;
    unknown: Bool = false; // resulted, but nobody knows the outcome (GH #604 rule 3)
}

fn effect_status(j: Journal, key: String) -> EffectStatus {
    let mut st = EffectStatus { };
    let mut i = 0;
    let n = j.revision();
    while i < n {
        let e = j.read(i);
        if e.entity == key {
            if e.kind == "effect.requested" { st.requested = true; }
            if e.kind == "effect.result" {
                st.done = true;
                st.ok = std::str::starts_with(e.body, "ok");
                st.unknown = std::str::starts_with(e.body, "unknown");
            }
        }
        i = i + 1;
    }
    return st;
}

// Returns true if THIS call should dispatch the effect (first time),
// false if it was already requested (a retry) — the caller then only
// waits for / records the result.
// GH #604 rule 3: the claim is exclusive. Two writers may both find the
// key unrequested and both append (the loser's append lands after a
// lost race and a reload, without re-reading); only the writer whose
// row is the FIRST request for the key dispatches — the other's row
// stays in the record as a contended claim, and it does not act.
@unbounded
fn effect_request(j: Journal, key: String, body: String) -> Bool {
    let st = effect_status(j, key);
    if st.requested { return false; }
    let r = j.append(j.revision(), "effect.requested", key, body);
    if !r.ok { return false; }
    let mut i = 0;
    let n = j.revision();
    while i < n {
        let e = j.read(i);
        if e.kind == "effect.requested" && e.entity == key { return e.seq == r.revision - 1; }
        i = i + 1;
    }
    return false;
}

fn effect_result(j: Journal, key: String, ok: Bool) -> Bool {
    let st = effect_status(j, key);
    if st.done { return false; }
    let r = j.append(j.revision(), "effect.result", key, if ok { "ok" } else { "failed" });
    return r.ok;
}

// ---- projections --------------------------------------------------

// Task status is the last task.* event for the id — reconstructed,
// never stored as the authority.
fn task_status(j: Journal, task_id: String) -> String {
    let mut st = "unknown";
    let mut i = 0;
    let n = j.revision();
    while i < n {
        let e = j.read(i);
        if e.entity == task_id && std::str::starts_with(e.kind, "task.") {
            st = e.kind[5..len(e.kind)];
        }
        i = i + 1;
    }
    return st;
}

// A derived, disposable retrieval index: term -> count. Delete it and
// rebuild it from the journal; the journal never changes.
type TermRow { term: String = ""; count: Int = 0; }

@form(hashmap)
locus TermRows {
    capacity { pool rows of TermRow indexed_by term; }
}

locus RetrievalIndex {
    params { rows: TermRows = TermRows { }; indexed: Int = 0; }
    @unbounded
    fn rebuild(j: Journal) {
        self.indexed = 0;
        let mut i = 0;
        let n = j.revision();
        while i < n {
            let e = j.read(i);
            let cur = self.rows.get(e.kind) or TermRow { term: e.kind };
            self.rows.set(TermRow { term: e.kind, count: cur.count + 1 });
            self.indexed = self.indexed + 1;
            i = i + 1;
        }
    }
    fn count(term: String) -> Int {
        let r = self.rows.get(term) or TermRow { };
        return r.count;
    }
}
