// Build: hale build dna/api/practice_review
// Run: HALE_DNA_COMMAND_POLICY=authority.json practice_review <root> <port> [webroot]
// One loopback Record/body/host deployment. The ordinary dna/api head answers
// every command `commands_unsupported`. This head composes the shared native
// Governance service explicitly; the commands are the api binding's (see
// dna/api/commands.hl), gated by the record's positions and admitted here.
import ".." as api;
import "../../core" as dna;
import "../../operations" as ops;
import "../../organization_source" as orgsource;
import "../../organization_runtime" as runtime;

// The composed head is the binding (GH #1104 piece 5): the surface is
// the entrypoint seed's own loci, so this seed declares the api entry
// and subscribes the head's command topics on a locus of its own — the
// same admission, the same gates — and the HTTP reads run beside it.
main locus PracticeReviewHead {
    params {
        root: String = ".";
        port: Int = 8792;
        socket: String = "";
        roles: dna::RecordRoles = dna::RecordRoles { };
        handler: api::Api = api::Api { };
        commands: ReviewCommands = ReviewCommands { };
    }
    // A command is git work under the provider; its own pool, so the HTTP
    // head and the binding's I/O never wait behind it.
    placement { commands: cooperative(pool = commands); }
    bindings {
        api: unix(self.socket, bound: 64, on_full: refuse, roles: self.roles);
    }
    run() {
        std::http::Server { host: "127.0.0.1", port: self.port, handler: self.handler };
    }
}

// The head's command topics, subscribed by this seed over the shared
// admission (dna/api/commands.hl names the gates: `owner` the board,
// `reviewer` position:reviewer, `position` any live seat).
locus ReviewCommands {
    params { admission: api::CommandAdmission = api::CommandAdmission { }; }
    bus {
        subscribe api::PracticePropose as propose;
        subscribe api::ReviewVerdict as verdict;
        subscribe api::OrganizationPropose as propose_organization;
        subscribe api::TaskCreate as create_task;
        subscribe api::TaskReassign as reassign_task;
        subscribe api::PersonRetire as retire_person;
        subscribe api::AttemptClaim as claim;
        subscribe api::AttemptOutcome as outcome;
        subscribe api::AttemptRenew as renew;
        subscribe api::AttemptRelease as release_attempt;
        subscribe api::FrictionFile as file_friction;
        subscribe api::CommandLookup as lookup;
    }
    @gated(role: position)
    fn propose(p: api::PracticeProposal, ctx: std::api::Context) -> api::CommandReply { return self.admission.propose(p, ctx); }
    @gated(role: reviewer)
    fn verdict(v: api::ReviewDecision, ctx: std::api::Context) -> api::CommandReply { return self.admission.verdict(v, ctx); }
    @gated(role: owner)
    fn propose_organization(o: api::OrganizationProposal, ctx: std::api::Context) -> api::CommandReply { return self.admission.propose_organization(o, ctx); }
    fn create_task(t: api::TaskCreation, ctx: std::api::Context) -> api::CommandReply { return self.admission.create_task(t, ctx); }
    @gated(role: owner)
    fn reassign_task(t: api::TaskReassignment, ctx: std::api::Context) -> api::CommandReply { return self.admission.reassign_task(t, ctx); }
    @gated(role: owner)
    fn retire_person(p: api::PersonRetirement, ctx: std::api::Context) -> api::CommandReply { return self.admission.retire_person(p, ctx); }
    @gated(role: position)
    fn claim(c: api::Claim, ctx: std::api::Context) -> api::CommandReply { return self.admission.claim(c, ctx); }
    @gated(role: position)
    fn outcome(o: api::Outcome, ctx: std::api::Context) -> api::CommandReply { return self.admission.outcome(o, ctx); }
    @gated(role: position)
    fn renew(r: api::Renewal, ctx: std::api::Context) -> api::CommandReply { return self.admission.renew(r, ctx); }
    @gated(role: position)
    fn release_attempt(r: api::Release, ctx: std::api::Context) -> api::CommandReply { return self.admission.release_attempt(r, ctx); }
    @gated(role: position)
    fn file_friction(f: api::Friction, ctx: std::api::Context) -> api::CommandReply { return self.admission.file_friction(f, ctx); }
    fn lookup(l: api::Lookup, ctx: std::api::Context) -> api::CommandReply { return self.admission.lookup(l, ctx); }
}

// The head, up: the reads over HTTP with the socket named in its
// capabilities, the commands on the socket. Trusted-local only — a
// project configured for another principal source is refused here, as
// the face refuses to attach one.
fn head_up(root: String, port: Int, web: api::WebAssets, definitions: ops::WorkflowCatalogProvider, commands: PracticeReviewCommands, authority: ops::GovernanceAuthority, runtime: api::OrganizationRuntimeProvider) {
    let record = dna::GitRecord { repo: root };
    let configured = record.git("config\n--get\ndna.principal");
    let mode = dna::trim_nl(configured.stdout);
    if len(mode) > 0 && mode != "local" {
        eprintln("hale dna practice-review api: this head is trusted-local; a project under dna.principal ", mode, " is served by the hosted head");
        std::process::exit(2);
    }
    let user = std::env::var("USER");
    let socket = api::head_socket(root);
    println("hale dna api: http://127.0.0.1:", port, api::API_PREFIX, " (trusted local; composed command provider)");
    PracticeReviewHead {
        root: root, port: port, socket: socket, roles: dna::RecordRoles { root: root },
        commands: ReviewCommands { admission: api::CommandAdmission { root: root, roles: dna::RecordRoles { root: root }, provider: commands } },
        handler: api::Api {
            root: root, web: web, organization: orgsource::OrganizationSource { root: root, allow_drafts: std::env::var("HALE_DNA_ORG_DRAFTS") == "1" },
            definitions: definitions, knowledge: api::LocalKnowledge { root: root }, knowledge_commands: api::LocalKnowledgeCommands { root: root },
            people: commands, socket: socket, organization_candidates: api::OrganizationCandidateWire { authority: authority }, organization_runtime: runtime,
            command_origin: "http://127.0.0.1:" + to_string(port), local_name: if len(user) > 0 { user } else { "local" }
        }
    };
}

fn serve(root: String, port: Int, policy_path: String, webroot: String) {
    let reader = api::SourceReader { root: root };
    let source = reader.read();
    if !source.ok {
        eprintln("hale dna practice-review api: ", source.error, "; refusing to start");
        std::process::exit(2);
    }
    let record = dna::GitRecord { repo: root };
    let configured = record.git("config\n--get\ndna.trust");
    if configured.code != 0 && configured.code != 1 {
        eprintln("hale dna practice-review api: cannot read Record trust policy; refusing to start");
        std::process::exit(2);
    }
    let declared = dna::trim_nl(configured.stdout);
    let trust = if len(declared) == 0 { "local" } else { declared };
    let size = std::io::fs::file_size(policy_path) or - 1;
    if size < 1 || size > 65536 {
        eprintln("hale dna practice-review api: expected a readable authority policy of 1..65536 bytes; refusing to start");
        std::process::exit(2);
    }
    let document = std::io::fs::read_file(policy_path) or "";
    let codec = ops::AuthorityPolicyCodec { };
    let policy = codec.decode(document, source.identity, trust);
    if !policy.valid {
        eprintln("hale dna practice-review api: invalid authority policy, application binding, or Record trust mode; refusing to start");
        std::process::exit(2);
    }
    // Optional, independent source policy. Merely configuring evidence reads
    // does not enable source proposal or source Review writes.
    let source_policy_path = std::env::var("HALE_DNA_ORGANIZATION_POLICY");
    let mut source_policy = ops::OrganizationAuthorityPolicy { };
    if source_policy_path != "" {
        let source_size = std::io::fs::file_size(source_policy_path) or - 1;
        if source_size < 1 || source_size > 65536 {
            eprintln("hale dna practice-review api: source authority policy must be 1..65536 readable bytes; refusing to start");
            std::process::exit(2);
        }
        let source_document = std::io::fs::read_file(source_policy_path) or "";
        let source_codec = ops::OrganizationAuthorityPolicyCodec { };
        source_policy = source_codec.decode(source_document, source.identity, trust);
        if !source_policy.valid {
            eprintln("hale dna practice-review api: invalid source authority policy, application binding or trust; refusing to start");
            std::process::exit(2);
        }
    }
    let task_policy_path = std::env::var("HALE_DNA_TASK_POLICY");
    let mut task_policy = ops::TaskAuthorityPolicy { };
    if task_policy_path != "" {
        let task_size = std::io::fs::file_size(task_policy_path) or - 1;
        if task_size < 1 || task_size > 32768 {
            eprintln("hale dna practice-review api: Task authority policy must be 1..32768 readable bytes; refusing to start");
            std::process::exit(2);
        }
        let task_document = std::io::fs::read_file(task_policy_path) or "";
        let task_codec = ops::TaskAuthorityPolicyCodec { };
        task_policy = task_codec.decode(task_document, source.identity, trust);
        if !task_policy.valid {
            eprintln("hale dna practice-review api: invalid Task authority policy, application binding or trust; refusing to start");
            std::process::exit(2);
        }
    }
    let web = api::WebAssets { };
    if len(webroot) > 0 && !web.load(webroot) {
        eprintln("hale dna practice-review api: ", web.error, "; refusing to start");
        std::process::exit(2);
    }
    // Each composed dependency stays bound for the HTTP server's full lifetime.
    let authority = ops::FixedAuthority { policy: policy };
    let source_authority = ops::FixedOrganizationAuthority { policy: source_policy };
    let task_authority = ops::FixedTaskAuthority { policy: task_policy };
    let native = ops::GovernanceCommands { record: record, authority: authority, sign: policy.sign,
        organization_authority: source_authority, organization_enabled: false, organization_reviews_enabled: false,
        tasks_enabled: task_policy.valid, task_authority: task_authority, retirement_enabled: task_policy.valid && task_policy.retirement_enabled, retirement_record: record };
    let commands = PracticeReviewCommands { root: root, application_id: source.identity, service: native, people: native, organization_configured: source_policy.valid };
    println("hale dna practice-review api: authority basis ", policy.basis);
    let definitions = ops::NoWorkflowCatalog { };
    // This optional reader is meaningful only in the same local deployment
    // root and PID namespace as Host. The status route checks the separate
    // recovery/read grant before invoking it; native identity proofs may still
    // return unavailable. No configured source policy keeps the old default.
    if source_policy.valid {
        let current = runtime::OrganizationRuntime { root: root };
        head_up(root, port, web, definitions, commands, source_authority, current);
    } else {
        let absent = api::NoOrganizationRuntime { };
        head_up(root, port, web, definitions, commands, source_authority, absent);
    }
}

fn main() {
    let root = std::env::arg_or(1, ".");
    let http = api::Http { };
    let port = http.integer(std::env::arg_or(2, ""), 65535);
    if std::env::args_count() < 3 || std::env::args_count() > 4 || port < 1 || std::str::contains(root, "\n") || std::str::contains(root, "\r") {
        eprintln("hale dna practice-review api: expected <project-root> <port 1..65535> [face-webroot]");
        std::process::exit(2);
    }
    let policy_path = std::env::var("HALE_DNA_COMMAND_POLICY");
    if len(policy_path) == 0 {
        eprintln("hale dna practice-review api: HALE_DNA_COMMAND_POLICY must name an explicit authority policy file; refusing to start");
        std::process::exit(2);
    }
    serve(root, port, policy_path, std::env::arg_or(3, ""));
}
