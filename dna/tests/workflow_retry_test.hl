// dna/tests/workflow_retry_test.hl — numbered retries under a restart, and
// the fence (DNA workflow card 12b).
//
// A retry is the next numbered attempt, admitted only after the record
// holds the outcome that permits it and only within the allowance the
// recipe bound; its request and performer kind are the admission's,
// durable, so a reboot resumes the attempt the record holds and never
// mints another. Attempt zero fails; attempt one is admitted; a reboot
// resumes attempt one — redelivered, the incarnation that claimed it
// being dead — and never creates attempt two. A late success for
// attempt zero cannot overwrite its successor. An admission the record
// refuses invokes no performer and spends no retry: the Work holds it
// and proposes it again when the record resumes. And the runtime runs
// under a lease that is rows of its own record: a holder whose lease
// expired and was re-acquired by another commits nothing — no
// transition, no claim, no outcome — until it holds a live token again,
// and then what was held goes through; and because a takeover is a row,
// one landing after a holder's own check and before its append makes
// that append stale, and it is decided again and fenced.

import "../core" as dna;

type Call { work_id: String = ""; attempt_id: String = ""; }
topic Calls { payload: Call; subject: "wf.retry.call"; }

// Fails its first call at once; every later call is pending, answered
// through the runtime.
locus Flaky {
    params { calls: Int = 0; }
    bus { publish Calls; }
    fn kind() -> String { return "human"; }
    fn identity() -> String { return "alice"; }
    fn perform(req: dna::WorkRequest) -> dna::WorkResult {
        self.calls = self.calls + 1;
        let id = req.work_id + "/a" + to_string(req.attempt_no);
        Calls <- Call { work_id: req.work_id, attempt_id: id };
        if self.calls == 1 { return dna::WorkResult { disposition: "failed", result: "not this time", performer: "alice", attempt_id: id }; }
        return dna::WorkResult { disposition: "pending", performer: "alice", attempt_id: id };
    }
}

// A record another holder takes over at the boundary: as this holder
// appends a row of the given kind — after it checked the lease and
// found itself live — beta's takeover lands, and only then is the
// holder's exact append delegated. Beta's clock is ahead of alpha's:
// alpha's lease has expired by beta's clock while alpha still counts
// itself live, which is what a stalled or slow holder looks like.
locus Takeover {
    params { inner: dna::MemJournal = dna::MemJournal { }; on_kind: String = ""; key: String = ""; taken: Bool = false; }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult { return self.inner.append(expected, kind, entity, body); }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if kind == self.on_kind && !self.taken {
            self.taken = true;
            let beta = dna::lease_take(self.inner, self.key, "beta", 200, 100);
        }
        return self.inner.append_exact(expected, kind, entity, body);
    }
    fn read(i: Int) -> dna::Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
}

// A record that refuses one row, once.
locus Refusing {
    params { inner: dna::MemJournal = dna::MemJournal { }; refuse_once: String = ""; refused: Bool = false; }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult { return self.inner.append(expected, kind, entity, body); }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if kind + ":" + entity == self.refuse_once && !self.refused { self.refused = true; return dna::AppendResult { error: "io", expected: expected, actual: self.inner.revision() }; }
        return self.inner.append_exact(expected, kind, entity, body);
    }
    fn read(i: Int) -> dna::Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
}

locus Boot {
    params {
        rt: dna::WorkflowRuntime = dna::WorkflowRuntime { };
        owner: dna::Executions = dna::Executions { };
    }
}

main locus App {
    params {
        cat: dna::WorkflowCatalog = dna::WorkflowCatalog { };
        limits: dna::AdmissionLimits = dna::AdmissionLimits { };
        recipe: String = "";
        boot: Boot = Boot { };
        // two memories under one routed reader, for the token's stability
        record: dna::MemJournal = dna::MemJournal { };
        ledger: dna::MemJournal = dna::MemJournal { };
        full: dna::MemJournal = dna::MemJournal { };
        lives: String = "";
        outcomes: String = "";
        calls: String = "";
        replies: String = "";
    }
    bus {
        subscribe dna::RunLives as on_life;
        subscribe dna::WorkflowSettled as on_outcome;
        subscribe dna::AttemptReplied as on_reply;
        subscribe Calls as on_call;
        publish dna::ExecutionAsked;
        publish dna::AttemptRequested;
        publish dna::WorkflowCancelRequested;
        publish dna::RecordResumed;
    }
    fn on_life(l: dna::RunLife) { self.lives = self.lives + l.key + ":" + l.what + " "; }
    fn on_outcome(o: dna::WorkflowSettlement) { self.outcomes = self.outcomes + o.task_id + ":" + o.disposition + " "; }
    fn on_reply(r: dna::AttemptReply) { self.replies = self.replies + r.attempt_id + ":" + (if r.ok { "ok" } else { "refused" }) + ":" + r.disposition + "|" + r.why + "\\n"; }
    fn on_call(c: Call) { self.calls = self.calls + c.attempt_id + " "; }
    @unbounded
    fn count(list: String, item: String) -> Int {
        let mut n = 0;
        let mut rest = list;
        while len(rest) > 0 {
            let sp = std::str::index_of(rest, " ");
            if rest[0..sp] == item { n = n + 1; }
            rest = rest[(sp + 1)..len(rest)];
        }
        return n;
    }
    @unbounded
    fn rows(j: dna::Journal, kind: String, entity: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && (len(entity) == 0 || e.entity == entity) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn cut(src: dna::Journal, dst: dna::Journal, n: Int) {
        let mut i = 0;
        while i < n {
            let e = src.read(i);
            let r = dst.append(dst.revision(), e.kind, e.entity, e.body);
            std::test::assert(r.ok, "row " + to_string(i) + " copied: " + r.error);
            i = i + 1;
        }
    }
    fn settle() {
        let mut i = 0;
        while i < 10 {
            std::time::sleep(20ms);
            i = i + 1;
        }
    }
    @unbounded
    fn until_outcome(item: String, n: Int) {
        let mut i = 0;
        while i < 1000 {
            if self.count(self.outcomes, item) >= n { return; }
            std::time::sleep(20ms);
            i = i + 1;
        }
    }
    @unbounded
    fn until_calls(item: String, n: Int) {
        let mut i = 0;
        while i < 1000 {
            if self.count(self.calls, item) >= n { return; }
            std::time::sleep(20ms);
            i = i + 1;
        }
    }
    fn admission() -> String {
        return dna::encode_admission(dna::AdmittedWorkflow {
            task_id: "t1", definition: "retry", revision: 1, request: "ask-t1", recipe: self.recipe, limits: self.limits, works: 1, tasks: 1, steps: 1, depth: 1
        });
    }
    fn ask() {
        dna::ExecutionAsked <- dna::ExecutionAsk { scope: "main", task_id: "t1", workflow_id: "t1/wf1", definition: "retry", revision: 1, recipe: self.recipe, kinds: "r=human", limits: self.limits };
    }
    fn reply(attempt_id: String, disposition: String) -> dna::Executed {
        return self.boot.rt.settle(attempt_id, dna::WorkResult { disposition: disposition, result: "later", performer: "alice", attempt_id: attempt_id });
    }
    run() {
        std::test::assert_eq_str(self.cat.define("retry", 1, 1, "try twice"), "", "retry");
        std::test::assert_eq_str(self.cat.leaf("retry", 1, 0, "r", dna::WorkRequest { objective: "ask alice" }, 2), "", "r");
        let x = self.cat.expand("t1", "retry", 1, self.limits);
        std::test::assert(x.ok, "t1 expands: " + x.why);
        self.recipe = self.cat.encode_bound();
        let wr = "t1/wf1/s0/r";

        // (the performers here are effect-free fakes: a replay is documented
        // safe, so the adapter says so — card 12c)
        // ---- boot 0: attempt zero fails; attempt one is admitted, claimed
        //      and pending when the incarnation dies
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r0 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        std::test::assert(r0.ok, "admitted: " + r0.error);
        self.ask();
        self.until_calls(wr + "/a1", 1);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a0"), 1, "attempt zero failed, durably");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", wr + "/a1"), 1, "attempt one is admitted, after that outcome");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "effect.requested", "attempt:" + wr + "/a1"), 1, "and claimed");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a1"), 0, "and pending");
        // a late success for attempt zero cannot overwrite its successor
        let late0 = self.reply(wr + "/a0", "done");
        std::test::assert(late0.ok && late0.reused && late0.disposition == "failed", "attempt zero's late success is answered from its recorded failure: " + late0.why);
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "work.settled", wr), 0, "the Work did not settle on it");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", ""), 1, "one outcome, attempt zero's failure");
        self.cut(self.boot.rt.journal, self.full, self.boot.rt.journal.revision());
        let full = self.full;
        let so_far = full.revision();

        // ---- boot 1: the reboot resumes attempt one — redelivered, its
        //      claimant dead — and never creates attempt two
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { calls: 1 } } }, owner: dna::Executions { scope: "main" } };
        self.cut(full, self.boot.rt.journal, so_far);
        self.ask();
        self.until_calls(wr + "/a1", 2);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", ""), 2, "boot 1: two attempts, the record's — no attempt two");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "effect.redelivered", "attempt:" + wr + "/a1"), 1, "attempt one was redelivered");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "effect.requested", ""), 2, "under its standing claim: no new claim");
        std::test::assert_eq_int(self.count(self.calls, wr + "/a0"), 1, "attempt zero was not asked again");
        let late0b = self.reply(wr + "/a0", "done");
        std::test::assert(late0b.ok && late0b.reused && late0b.disposition == "failed", "and its late success still changes nothing after the reboot");
        let done1 = self.reply(wr + "/a1", "done");
        std::test::assert(done1.ok && done1.disposition == "done", "attempt one's reply settles it: " + done1.why);
        self.until_outcome("t1:done", 1);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "work.settled", wr), 1, "the Work settled on attempt one");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", ""), 2, "still two attempts");

        // ---- boot 2: a retry's admission the record refuses invokes no
        //      performer and spends no retry; resumed, it lands and runs
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", journal: Refusing { refuse_once: "attempt.admitted:" + wr + "/a1" }, work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r2 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        self.ask();
        self.until_calls(wr + "/a0", 2);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a0"), 1, "boot 2: attempt zero failed");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", wr + "/a1"), 0, "the record refused attempt one's admission");
        std::test::assert_eq_int(self.count(self.calls, wr + "/a1"), 2, "no performer was asked for it");
        std::test::assert_eq_int(self.count(self.lives, wr + ":dissolved"), 2, "and the Work holds it: not settled failed, not reclaimed");
        dna::RecordResumed <- dna::RecordResume { scope: "main", why: "writable again" };
        self.until_calls(wr + "/a1", 3);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", wr + "/a1"), 1, "resumed, attempt one landed once");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", ""), 2, "and no attempt two: the refusal spent nothing");
        let done2 = self.reply(wr + "/a1", "done");
        self.until_outcome("t1:done", 2);

        // ---- boot 3: the runtime runs under a lease, rows of its record.
        //      Attempt one is out when the lease expires and another holder
        //      takes it: the stale holder commits nothing — a reply is not
        //      recorded, a cancellation is not committed, a request runs
        //      nothing — until it holds a live token again, and then what
        //      was held goes through
        let key = "lease/workflow/main";
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", lease_key: key, holder: "alpha", work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r3 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        std::test::assert(self.boot.rt.take_lease(0, 100), "alpha holds the lease at 0");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "lease.taken", key), 1, "as a row of the record");
        std::test::assert(self.boot.rt.renew_lease(50, 100), "and renews it at 50, under the same token");
        self.ask();
        self.until_calls(wr + "/a1", 4);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", wr + "/a1"), 1, "boot 3: attempt one admitted under the lease");
        // the lease expires unrenewed: nobody holds it, and an expired
        // token commits nothing either
        self.boot.rt.tick(160);
        let expired = self.reply(wr + "/a1", "done");
        std::test::assert(!expired.ok && std::str::contains(expired.why, "held by nobody"), "with the lease expired and unclaimed, alpha's reply is fenced: " + expired.why);
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a1"), 0, "and recorded nothing");
        // then beta takes it — a row of the record
        let beta = dna::lease_take(self.boot.rt.journal, key, "beta", 200, 100);
        std::test::assert(beta.present && beta.holder == "beta", "beta holds the lease at 200");
        self.boot.rt.tick(200);
        let rows_before = self.boot.rt.journal.revision();
        let stale = self.reply(wr + "/a1", "done");
        std::test::assert(!stale.ok && std::str::contains(stale.why, "fenced"), "alpha's reply for attempt one is fenced: " + stale.why);
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a1"), 0, "and recorded nothing");
        dna::WorkflowCancelRequested <- dna::WorkflowCancel { task_id: "t1", reason: "stop" };
        let replies_before = len(self.replies);
        dna::AttemptRequested <- dna::AttemptRequest { scope: "main", attempt_id: wr + "/a1", work_id: wr };
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "workflow.settled", "t1"), 0, "alpha's cancellation is fenced: not committed");
        std::test::assert(std::str::contains(self.replies[replies_before..len(self.replies)], "attached"), "a request for the running attempt under a lost lease attaches — it writes nothing — and runs nothing: " + self.replies[replies_before..len(self.replies)]);
        std::test::assert_eq_int(self.count(self.calls, wr + "/a1"), 4, "no performer was asked");
        std::test::assert_eq_int(self.boot.rt.journal.revision(), rows_before, "the stale holder wrote nothing");
        std::test::assert_eq_int(self.boot.rt.fenced_off, 3, "the fence refused each write: the two replies and the cancellation");
        std::test::assert(!self.boot.rt.renew_lease(250, 100), "and alpha cannot renew what beta holds");
        // beta's lease lapses; alpha takes it again, and the record resumes
        std::test::assert(self.boot.rt.take_lease(400, 100), "alpha holds the lease again at 400");
        dna::RecordResumed <- dna::RecordResume { scope: "main", why: "the lease is ours again" };
        self.until_outcome("t1:cancelled", 1);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "workflow.settled", "t1"), 1, "the held cancellation went through");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "work.settled", wr), 1, "and attempt one's Work settled under the fence");
        let after = self.reply(wr + "/a1", "done");
        std::test::assert(after.ok, "a late reply is recorded once the lease is live: " + after.why);
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a1"), 1, "as its outcome");

        // ---- boot 4: the takeover at the boundary — alpha, live by its own
        //      clock, checks its lease and finds it live, and beta takes the
        //      lease as alpha's transition is appended: the append is
        //      stale, decided again, and fenced; nothing of alpha's lands
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", lease_key: key, holder: "alpha", journal: Takeover { on_kind: "attempt.admitted", key: key }, work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r4 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        std::test::assert(self.boot.rt.take_lease(0, 100), "alpha holds the lease at 0");
        self.boot.rt.tick(50);
        self.ask();
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "lease.taken", key), 2, "boot 4: beta took the lease under alpha's append");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", ""), 0, "and alpha's transition, checked live and appended after the takeover, did not land");
        std::test::assert_eq_int(self.count(self.calls, wr + "/a0"), 3, "nothing ran");
        std::test::assert_eq_int(self.boot.rt.fenced_off, 1, "the fence refused it, on the reading after the takeover");
        std::test::assert_eq_int(self.count(self.lives, wr + ":dissolved"), 4, "the Work holds it");
        // alpha takes the lease back once beta's lapses; the record resumes
        std::test::assert(self.boot.rt.take_lease(400, 100), "alpha holds the lease again at 400");
        dna::RecordResumed <- dna::RecordResume { scope: "main", why: "the lease is ours again" };
        self.until_calls(wr + "/a0", 4);
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", wr + "/a0"), 1, "resumed under a live token, the transition landed");

        // ---- boot 5: the same takeover under the claim: the executor
        //      checked the lease live at its reading and the claim's
        //      exact append is stale; decided again, it is fenced, and no
        //      performer runs
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", lease_key: key, holder: "alpha", journal: Takeover { on_kind: "effect.requested", key: key }, work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r5 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        std::test::assert(self.boot.rt.take_lease(0, 100), "alpha holds the lease at 0");
        self.boot.rt.tick(50);
        self.ask();
        self.settle();
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.admitted", wr + "/a0"), 1, "boot 5: attempt zero admitted under alpha's live lease");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "effect.requested", ""), 0, "the claim, appended after the takeover, did not land");
        std::test::assert_eq_int(self.count(self.calls, wr + "/a0"), 4, "and no performer ran");
        std::test::assert_eq_int(self.boot.rt.fenced_off, 1, "the fence refused it");

        // ---- boot 6: the token, not the name — alpha restarted takes the
        //      lease again under its own name while the old alpha still
        //      counts itself live: the old token is stale, and the old
        //      alpha's write is fenced
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", lease_key: key, holder: "alpha", work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r6 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        std::test::assert(self.boot.rt.take_lease(0, 100), "alpha holds the lease at 0");
        self.ask();
        self.until_calls(wr + "/a1", 5);
        self.settle();
        let again = dna::lease_take(self.boot.rt.journal, key, "alpha", 50, 100);
        std::test::assert(again.present && again.token != self.boot.rt.token, "a restarted alpha takes the lease under a new token while the old one is live by expiry");
        self.boot.rt.tick(50);
        let old = self.reply(wr + "/a1", "done");
        std::test::assert(!old.ok && old.fenced, "the old alpha's reply is fenced on its token, though its name still holds: " + old.why);
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "attempt.outcome", wr + "/a1"), 0, "and recorded nothing");

        // ---- boot 7: two takes of a free lease at once: beta's lands as
        //      alpha's is appended; alpha's take is stale, decided again,
        //      and refused — one holder, never two
        self.boot = Boot { rt: dna::WorkflowRuntime { scope: "main", lease_key: key, holder: "alpha", journal: Takeover { on_kind: "lease.taken", key: key }, work: dna::WorkSystem { human_reconciler: dna::IdempotentReplay { }, human: Flaky { } } }, owner: dna::Executions { scope: "main" } };
        let r7 = self.boot.rt.journal.append(0, "workflow.admitted", "t1", self.admission());
        std::test::assert(!self.boot.rt.take_lease(0, 100), "boot 7: alpha's take, appended after beta's landed, is refused");
        std::test::assert_eq_int(self.rows(self.boot.rt.journal, "lease.taken", key), 1, "one take landed: beta's");
        std::test::assert_eq_str(dna::lease_at(self.boot.rt.journal, key, self.boot.rt.journal.revision()).holder, "beta", "and the record says beta holds it");
        std::test::assert(self.boot.rt.journal.verify_chain(), "the record's chain holds");

        // ---- the token is the row's own, not its position: under a routed
        //      record (record rows, then ledger rows, for a reader that
        //      starts fresh; arrival order for one that was live) a take
        //      lands in the ledger, an unrelated row in the record, and a
        //      fresh reader finds them in the other order — the lease it
        //      reads is still alpha's, token 1, renewed through 150
        let adopted = self.record.append(0, "ledger.adopted", "ledger", "{\"routing\": 1, \"checkpoint\": \"x\"}");
        std::test::assert(adopted.ok, "routing 1 adopted");
        let live = dna::RoutedJournal { record: self.record, ledger: self.ledger };
        let t1 = dna::lease_take(live, key, "alpha", 0, 100);
        std::test::assert(t1.present && t1.token == 1, "alpha takes the lease under token 1, a row of the ledger");
        let note = live.append(live.revision(), "note.kept", "n1", "a row of the record, after the take");
        std::test::assert(note.ok, "an unrelated record row lands after the take");
        std::test::assert(dna::lease_renew(live, key, "alpha", 1, 50, 100), "alpha renews through 150 under token 1");
        std::test::assert_eq_int(dna::lease_at(live, key, live.revision()).expires, 150, "the live reader sees the renewal");
        let fresh = dna::RoutedJournal { record: self.record, ledger: self.ledger };
        let seen = dna::lease_at(fresh, key, fresh.revision());
        std::test::assert(seen.present && seen.holder == "alpha" && seen.token == 1 && seen.expires == 150, "a fresh reader, with the record's rows first, reads the same lease: alpha, token 1, through 150");
        let beta_early = dna::lease_take(fresh, key, "beta", 120, 100);
        std::test::assert(!beta_early.present && beta_early.holder == "alpha", "so beta cannot take it at 120: alpha holds it through 150");
        std::test::assert(dna::lease_release(live, key, "alpha", 1), "alpha releases it");
        let beta_late = dna::lease_take(fresh, key, "beta", 120, 100);
        std::test::assert(beta_late.present && beta_late.token == 2, "released, beta takes it under the next epoch");

        // ---- a holder reads back as it was written, whatever it is; an
        //      empty holder names nobody and is refused
        let odd = dna::lease_take(self.boot.rt.journal, "lease/odd", "worker alpha \"the first\"", 0, 100);
        std::test::assert(odd.present, "a holder with spaces and quotes is granted");
        let odd_read = dna::lease_at(self.boot.rt.journal, "lease/odd", self.boot.rt.journal.revision());
        std::test::assert_eq_str(odd_read.holder, "worker alpha \"the first\"", "and reads back as written");
        std::test::assert(dna::lease_renew(self.boot.rt.journal, "lease/odd", "worker alpha \"the first\"", odd.token, 50, 100), "and can use the token it was granted");
        let nobody = dna::lease_take(self.boot.rt.journal, "lease/odd2", "", 0, 100);
        std::test::assert(!nobody.present, "an empty holder is refused");
    }
}

fn main() { App { }; }
