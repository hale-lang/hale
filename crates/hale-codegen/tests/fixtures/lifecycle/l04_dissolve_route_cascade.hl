// Decision line 4, the failure route bound at birth in every spine
// (FailureDelivery, Dissolve). Shipped at inventory row C31.
//
// Kid's dissolve closure fails in App's field cascade, lowered in fn main.
// Its bound route must reach App's handler even without a current_self.
// Before the fix, teardown resolved no route and exited instead.
//
// Expected terminal outcome: `owner-handled-once`, judged by the harness.

locus Kid {
    params { left: Int = 1; }
    closure clean { self.left ~~ 0 within 0; epoch dissolve; }
}

main locus App {
    params { k: Kid = Kid { }; }
    on_failure(c: Kid, err: ClosureViolation) { println("ev handler " + err.closure); }
}

fn main() { App { }; }
