locus Anchor {
    params {
        go: Int = publishing();
        s1: S1 = S1 { };
        s2: S2 = S2 { };
        s3: S3 = S3 { };
        s4: S4 = S4 { };
        s5: S5 = S5 { };
        s6: S6 = S6 { };
        s7: S7 = S7 { };
        s8: S8 = S8 { };
    }
}

main locus App {
    params { a: Pub = Pub { }; b: Anchor = Anchor { }; }
    placement { a: pinned; b: pinned; }
    run() {
        std::time::sleep(500ms);
        println("ev done");
    }
    dissolve() { std::io::fs::unlink(gate()) or discard; }
}

fn main() { App { }; }
