// SSE stub — types + SseStream locus + next() fn.
// Surface contract: ../../COMPILER_FFI.md § `std::sse::*`.
//
// Behavior: in-memory FIFO queue. Tests pre-stage events; next()
// dequeues. When closed + empty, next() fails with kind="closed".

type SseEvent {
    event: String = "";
    data:  String = "";
    id:    String = "";
}

// IoError shape matches the stdlib's existing IoError (kind/errno/path);
// re-declared here so the stub doesn't depend on a particular stdlib
// surface yet. When the real impl lands and uses std::http, this will
// resolve to the same canonical IoError type.
type IoError {
    kind:   String = "";
    errno:  Int    = 0;
    detail: String = "";
}

// FIFO queue of staged events. Used only by the stub.
@form(vec)
locus StubEventQueue {
    capacity { heap entries of SseEvent; }
}

locus SseStream {
    params {
        // Real impl: held http_response: std::http::Response;
        // Stub: just the in-memory queue.
        queue:    StubEventQueue = StubEventQueue { };
        cursor:   Int  = 0;
        closed:   Bool = false;
    }

    // Infallible locus methods. The fallible surface lives on the
    // free fn `next()` below per the two-channel rule (locus
    // methods can't declare fallible(E); spec/styleguide.md § 7).

    fn _enqueue(e: SseEvent) {
        self.queue.push(e);
    }

    fn _mark_closed() {
        self.closed = true;
    }

    fn _has_more() -> Bool {
        return self.cursor < self.queue.len();
    }

    fn _is_closed() -> Bool {
        return self.closed;
    }

    fn _take_next() -> SseEvent {
        // Caller must check _has_more() first. On underflow the
        // vec get fails and we substitute a sentinel SseEvent.
        let e = self.queue.get(self.cursor) or empty_event();
        self.cursor = self.cursor + 1;
        return e;
    }
}

fn next(s: SseStream) -> SseEvent fallible(IoError) {
    if s._has_more() {
        return s._take_next();
    }
    if s._is_closed() {
        fail IoError { kind: "closed", errno: 0, detail: "sse stream closed" };
    }
    // Stub: when not closed and empty, signal "no data yet" as a
    // transient io failure. Real impl would yield until bytes
    // arrive; the stub returns synchronously so tests stay simple.
    fail IoError { kind: "would_block", errno: 0, detail: "no event ready" };
}

fn empty_event() -> SseEvent {
    return SseEvent { event: "", data: "", id: "" };
}
