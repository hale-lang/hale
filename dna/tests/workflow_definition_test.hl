// dna/tests/workflow_definition_test.hl — code-authored workflow
// definitions (DNA workflow card 04).
//
// The canonical example (dna/WORKFLOW-CONTRACT.md §6), built in ordinary
// Hale and expanded into one bound execution with every Task, Step and
// Work id the contract names. Then every admission rule: steps and
// required groups are non-empty, member keys are well formed and unique
// in their step, children resolve by id and revision, a workflow cannot
// contain itself, and the admission limits hold. A refusal names what
// broke and binds nothing. The same child definition invoked twice gets
// two executions. A definition's later revision does not change an
// expansion of the earlier one. The machine form round-trips every field.

import "../core" as dna;

fn leaf_work(objective: String) -> dna::WorkRequest {
    return dna::WorkRequest { objective: objective };
}

main locus App {
    params {
        cat: dna::WorkflowCatalog = dna::WorkflowCatalog { };
        copy: dna::WorkflowCatalog = dna::WorkflowCatalog { };
        dup: dna::WorkflowCatalog = dna::WorkflowCatalog { };
    }
    // The bound ids of one kind, in order, space-separated.
    @unbounded
    fn ids(kind: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.cat.bound_count() {
            let n = self.cat.bound_at(i);
            if n.kind == kind { out = out + (if len(out) > 0 { " " } else { "" }) + n.id; }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn copy_ids() -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.copy.bound_count() {
            out = out + self.copy.bound_at(i).kind + ":" + self.copy.bound_at(i).id + " ";
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn cat_ids() -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.cat.bound_count() {
            out = out + self.cat.bound_at(i).kind + ":" + self.cat.bound_at(i).id + " ";
            i = i + 1;
        }
        return out;
    }
    fn refused(root: String, id: String, rev: Int, limits: dna::AdmissionLimits, needle: String, label: String) {
        let x = self.cat.expand(root, id, rev, limits);
        std::test::assert(!x.ok && std::str::contains(x.why, needle), label + ": refused naming it: " + x.why);
        std::test::assert_eq_int(self.cat.bound_count(), 0, label + ": and nothing is bound");
    }
    run() {
        let lim = dna::AdmissionLimits { };
        // ---- the canonical example
        std::test::assert_eq_str(self.cat.define("close-month", 1, 2, "close the month"), "", "close-month defined");
        std::test::assert_eq_str(self.cat.define("collect-receipts", 1, 2, ""), "", "collect-receipts defined");
        std::test::assert_eq_str(self.cat.define("chase-supplier", 1, 1, ""), "", "chase-supplier defined");
        let a = dna::WorkRequest {
            objective: "reconcile the bank feed",
            context_digest: "sha256:c0ffee",
            knowledge_bindings: "package:sha256:beef p1",
            output_contract: "Assessment",
            data_class: "confidential",
            requires: "judgment",
            target: "bank.csv",
            cost_ceiling: 42
        };
        std::test::assert_eq_str(self.cat.leaf("close-month", 1, 0, "a", a, 3), "", "leaf a");
        std::test::assert_eq_str(self.cat.child("close-month", 1, 0, "b", "collect-receipts", 1), "", "child b");
        std::test::assert_eq_str(self.cat.leaf("close-month", 1, 1, "d", leaf_work("post the journal entries"), 1), "", "leaf d");
        std::test::assert_eq_str(self.cat.leaf("collect-receipts", 1, 0, "b1", leaf_work("list missing receipts"), 1), "", "leaf b1");
        std::test::assert_eq_str(self.cat.child("collect-receipts", 1, 1, "c", "chase-supplier", 1), "", "child c");
        std::test::assert_eq_str(self.cat.leaf("chase-supplier", 1, 0, "c1", leaf_work("email the supplier"), 2), "", "leaf c1");

        let x = self.cat.expand("t1", "close-month", 1, lim);
        std::test::assert(x.ok, "the canonical example expands: " + x.why);
        std::test::assert(x.tasks == 3 && x.steps == 5 && x.works == 4 && x.depth == 3, "three tasks, five steps, four works, depth three");
        std::test::assert_eq_str(self.ids("task"), "t1 t1.s0.b t1.s0.b.s1.c", "the task ids");
        std::test::assert_eq_str(self.ids("step"), "t1/wf1/s0 t1/wf1/s1 t1.s0.b/wf1/s0 t1.s0.b/wf1/s1 t1.s0.b.s1.c/wf1/s0", "the step ids");
        std::test::assert_eq_str(self.ids("work"), "t1/wf1/s0/a t1/wf1/s1/d t1.s0.b/wf1/s0/b1 t1.s0.b.s1.c/wf1/s0/c1", "the work ids");
        std::test::assert_eq_str(self.cat.bound_children("work", "t1/wf1/s0"), "t1/wf1/s0/a", "root step 0 holds leaf a");
        std::test::assert_eq_str(self.cat.bound_children("task", "t1"), "t1.s0.b", "and child b");
        std::test::assert_eq_str(self.cat.bound_children("work", "t1/wf1/s1"), "t1/wf1/s1/d", "root step 1 holds leaf d");
        std::test::assert_eq_str(self.cat.bound_children("step", "t1.s0.b"), "t1.s0.b/wf1/s0 t1.s0.b/wf1/s1", "b has two ordered steps");
        let c = self.cat.bound_node("t1.s0.b.s1.c");
        std::test::assert(c.parent == "t1.s0.b" && c.spawning_step == "t1.s0.b/wf1/s1" && c.member_key == "c" && c.definition == "chase-supplier" && c.revision == 1 && c.depth == 3 && c.workflow_id == "t1.s0.b.s1.c/wf1", "c is b's second step's child, bound to its definition");
        let b = self.cat.bound_node("t1.s0.b");
        std::test::assert(b.parent == "t1" && b.spawning_step == "t1/wf1/s0" && b.step_index == 0 && b.depth == 2, "b is the root's first step's child");
        std::test::assert_eq_str(c.path, "|close-month@1|collect-receipts@1|chase-supplier@1|", "c's definition path");
        let wa = self.cat.bound_node("t1/wf1/s0/a");
        std::test::assert(wa.parent == "t1/wf1/s0" && wa.member_key == "a" && wa.step_index == 0 && wa.attempts == 3, "a's Work is bound to its step with its allowance");
        let ra = dna::bound_request(wa, "t1", "t1/wf1/s0");
        std::test::assert(ra.work_id == "t1/wf1/s0/a" && ra.task_id == "t1" && ra.step_id == "t1/wf1/s0" && ra.attempt_no == 0, "a's request carries its ids");
        std::test::assert(ra.objective == a.objective && ra.context_digest == a.context_digest && ra.knowledge_bindings == a.knowledge_bindings && ra.output_contract == a.output_contract && ra.data_class == a.data_class && ra.requires == a.requires && ra.target == a.target && ra.cost_ceiling == a.cost_ceiling, "and every field of its authored content");
        std::test::assert_eq_int(self.cat.bound_node("t1.s0.b.s1.c/wf1/s0/c1").attempts, 2, "c1 keeps its allowance");
        // a second root: its own ids
        let y = self.cat.expand("t9", "close-month", 1, lim);
        std::test::assert(y.ok && self.ids("task") == "t9 t9.s0.b t9.s0.b.s1.c", "another root's execution has its own ids: " + self.ids("task"));
        std::test::assert(y.limits.max_works == 256 && y.limits.max_depth == 8, "the limits applied are bound with the expansion");

        // ---- the same child definition invoked twice
        std::test::assert_eq_str(self.cat.define("twice", 1, 1, ""), "", "twice defined");
        std::test::assert_eq_str(self.cat.child("twice", 1, 0, "first", "collect-receipts", 1), "", "first invocation");
        std::test::assert_eq_str(self.cat.child("twice", 1, 0, "second", "collect-receipts", 1), "", "second invocation");
        let tw = self.cat.expand("t2", "twice", 1, lim);
        std::test::assert(tw.ok && tw.tasks == 5 && tw.works == 4, "two invocations, each with its own subtree: " + tw.why);
        std::test::assert_eq_str(self.ids("task"), "t2 t2.s0.first t2.s0.second t2.s0.first.s1.c t2.s0.second.s1.c", "distinct invocation ids, down to the grandchildren");
        std::test::assert(std::str::contains(self.ids("work"), "t2.s0.first/wf1/s0/b1") && std::str::contains(self.ids("work"), "t2.s0.second/wf1/s0/b1"), "and distinct Works: " + self.ids("work"));

        // ---- a later revision leaves the earlier one's expansion alone
        std::test::assert_eq_str(self.cat.define("close-month", 2, 1, "revised"), "", "close-month@2 defined");
        std::test::assert_eq_str(self.cat.leaf("close-month", 2, 0, "e", leaf_work("close in one step"), 1), "", "its leaf");
        let v1 = self.cat.expand("t3", "close-month", 1, lim);
        std::test::assert(v1.ok && v1.works == 4 && self.cat.bound_node("t3/wf1/s1/d").objective == "post the journal entries", "revision 1 still expands as authored");
        let v2 = self.cat.expand("t4", "close-month", 2, lim);
        std::test::assert(v2.ok && v2.works == 1 && self.ids("work") == "t4/wf2/s0/e", "revision 2 is its own recipe, under /wf2: " + self.ids("work"));
        std::test::assert(std::str::contains(self.cat.define("close-month", 2, 1, ""), "already defined"), "a revision is defined once");
        std::test::assert(std::str::contains(self.cat.leaf("nowhere", 1, 0, "x", leaf_work("x"), 1), "no workflow nowhere@1"), "a member needs its workflow");

        // ---- the admission rules
        std::test::assert_eq_str(self.cat.define("empty", 1, 0, ""), "", "a workflow with no steps can be written");
        self.refused("t5", "empty", 1, lim, "has no steps", "no steps");
        std::test::assert_eq_str(self.cat.define("gap", 1, 2, ""), "", "gap");
        std::test::assert_eq_str(self.cat.leaf("gap", 1, 0, "only", leaf_work("x"), 1), "", "gap's first step");
        self.refused("t5", "gap", 1, lim, "gap@1 step 1 has no required members", "an empty required group");
        std::test::assert_eq_str(self.cat.define("dupkey", 1, 2, ""), "", "dupkey");
        std::test::assert_eq_str(self.cat.leaf("dupkey", 1, 0, "x", leaf_work("one"), 1), "", "x");
        std::test::assert_eq_str(self.cat.leaf("dupkey", 1, 1, "x", leaf_work("same key, other step"), 1), "", "x in step 1 is fine");
        let dk = self.cat.expand("t5", "dupkey", 1, lim);
        std::test::assert(dk.ok, "a key may repeat across steps: " + dk.why);
        std::test::assert_eq_str(self.cat.child("dupkey", 1, 0, "x", "chase-supplier", 1), "", "x again in step 0");
        self.refused("t5", "dupkey", 1, lim, "member `x`: the key is used twice in the step", "a duplicate key");
        std::test::assert_eq_str(self.cat.define("badkey", 1, 1, ""), "", "badkey");
        std::test::assert_eq_str(self.cat.leaf("badkey", 1, 0, "Bad Key", leaf_work("x"), 1), "", "a bad key can be written");
        self.refused("t5", "badkey", 1, lim, "a member key is [a-z0-9-]+", "a malformed key");
        std::test::assert_eq_str(self.cat.define("orphan", 1, 1, ""), "", "orphan");
        std::test::assert_eq_str(self.cat.child("orphan", 1, 0, "lost", "missing", 1), "", "a child that resolves to nothing");
        self.refused("t5", "orphan", 1, lim, "no workflow missing@1 is defined", "an unresolvable child");
        std::test::assert_eq_str(self.cat.define("wrongrev", 1, 1, ""), "", "wrongrev");
        std::test::assert_eq_str(self.cat.child("wrongrev", 1, 0, "c", "chase-supplier", 7), "", "a child at a revision that does not exist");
        self.refused("t5", "wrongrev", 1, lim, "no workflow chase-supplier@7 is defined", "an unresolvable revision");
        self.refused("t5", "nothing", 1, lim, "no workflow nothing@1 is defined", "an unknown root");
        self.refused("", "close-month", 1, lim, "needs a root task id", "no root id");
        std::test::assert_eq_str(self.cat.define("selfish", 1, 1, ""), "", "selfish");
        std::test::assert_eq_str(self.cat.child("selfish", 1, 0, "me", "selfish", 1), "", "a workflow that invokes itself");
        self.refused("t5", "selfish", 1, lim, "cannot contain itself", "direct self-reference");
        std::test::assert_eq_str(self.cat.define("ping", 1, 1, ""), "", "ping");
        std::test::assert_eq_str(self.cat.define("pong", 1, 1, ""), "", "pong");
        std::test::assert_eq_str(self.cat.child("ping", 1, 0, "p", "pong", 1), "", "ping invokes pong");
        std::test::assert_eq_str(self.cat.child("pong", 1, 0, "p", "ping", 1), "", "pong invokes ping");
        self.refused("t5", "ping", 1, lim, "invokes ping@1, which is already on its own path |ping@1|pong@1|", "indirect self-reference");

        // ---- the limits
        let mut level = 1;
        while level <= 9 {
            std::test::assert_eq_str(self.cat.define("deep" + to_string(level), 1, 1, ""), "", "a chain level");
            if level < 9 {
                std::test::assert_eq_str(self.cat.child("deep" + to_string(level), 1, 0, "next", "deep" + to_string(level + 1), 1), "", "the chain descends");
            } else {
                std::test::assert_eq_str(self.cat.leaf("deep9", 1, 0, "bottom", leaf_work("the bottom"), 1), "", "the chain ends");
            }
            level = level + 1;
        }
        self.refused("t6", "deep1", 1, lim, "workflow deep1@1 nests 9 levels; max_depth is 8", "nine levels under the default depth");
        let deeper = self.cat.expand("t6", "deep1", 1, dna::AdmissionLimits { max_depth: 9 });
        std::test::assert(deeper.ok && deeper.depth == 9, "the same chain under an assembly that allows nine levels: " + deeper.why);
        self.refused("t6", "close-month", 1, dna::AdmissionLimits { max_steps: 1 }, "close-month@1 has 2 steps; max_steps is 1", "too many steps");
        self.refused("t6", "close-month", 1, dna::AdmissionLimits { max_members: 1 }, "close-month@1 step 0 has 2 members; max_members is 1", "too many members");
        self.refused("t6", "close-month", 1, dna::AdmissionLimits { max_works: 3 }, "more than max_works 3 Works", "too many works");
        self.refused("t6", "close-month", 1, dna::AdmissionLimits { max_attempts: 2 }, "an allowance of 3 attempts is outside 1..max_attempts 2", "too large an allowance");
        std::test::assert_eq_str(self.cat.define("noattempt", 1, 1, ""), "", "noattempt");
        std::test::assert_eq_str(self.cat.leaf("noattempt", 1, 0, "z", leaf_work("never tried"), 0), "", "a leaf allowed no attempts");
        self.refused("t6", "noattempt", 1, lim, "an allowance of 0 attempts is outside 1..max_attempts 8", "no attempts");
        let fine = self.cat.expand("t7", "close-month", 1, dna::AdmissionLimits { max_depth: 3, max_steps: 2, max_members: 2, max_attempts: 3, max_works: 4 });
        std::test::assert(fine.ok, "exactly at every limit is admitted: " + fine.why);

        // ---- a definition error never yields a smaller, successful recipe
        std::test::assert_eq_str(self.cat.define("stray", 1, 1, ""), "", "stray");
        std::test::assert_eq_str(self.cat.leaf("stray", 1, 0, "here", leaf_work("inside"), 1), "", "a member inside the steps");
        std::test::assert_eq_str(self.cat.leaf("stray", 1, 1, "there", leaf_work("outside"), 1), "", "and one past them");
        self.refused("t6", "stray", 1, lim, "workflow stray@1 member `there` names step 1, outside its 1 step(s)", "a member outside the declared steps");
        std::test::assert_eq_str(self.cat.define("negative", 1, 1, ""), "", "negative");
        std::test::assert_eq_str(self.cat.leaf("negative", 1, 0, "ok", leaf_work("inside"), 1), "", "one inside");
        std::test::assert_eq_str(self.cat.child("negative", 1, -1, "back", "chase-supplier", 1), "", "a child at a negative step");
        self.refused("t6", "negative", 1, lim, "member `back` names step -1", "a member at a negative step");

        // ---- the root is under the same depth bound as its children
        self.refused("t6", "chase-supplier", 1, dna::AdmissionLimits { max_depth: 0 }, "max_depth 0 admits no workflow at all", "a depth bound that admits nothing");
        self.refused("t6", "chase-supplier", 1, dna::AdmissionLimits { max_steps: 0 }, "max_steps 0 admits no workflow at all", "a step bound that admits nothing");
        self.refused("t6", "chase-supplier", 1, dna::AdmissionLimits { max_works: 0 }, "max_works 0 admits no work at all", "a work bound that admits nothing");
        let one_deep = self.cat.expand("t6", "chase-supplier", 1, dna::AdmissionLimits { max_depth: 1 });
        std::test::assert(one_deep.ok && one_deep.depth == 1, "one level is admitted at max_depth 1: " + one_deep.why);
        self.refused("t6", "collect-receipts", 1, dna::AdmissionLimits { max_depth: 1 }, "nests 2 levels; max_depth is 1", "two levels at max_depth 1");

        // ---- a catalog whose expansion would be enormous is refused from
        // its counts, not by materializing it: eight definitions, each step
        // inviting thirty-two children, one leaf at the bottom
        let mut lv = 1;
        while lv <= 8 {
            std::test::assert_eq_str(self.cat.define("wide" + to_string(lv), 1, 1, ""), "", "a wide level");
            if lv < 8 {
                let mut k = 0;
                while k < 32 {
                    std::test::assert_eq_str(self.cat.child("wide" + to_string(lv), 1, 0, "c" + to_string(k), "wide" + to_string(lv + 1), 1), "", "a wide child");
                    k = k + 1;
                }
            } else {
                std::test::assert_eq_str(self.cat.leaf("wide8", 1, 0, "bottom", leaf_work("the only leaf"), 1), "", "the one leaf");
            }
            lv = lv + 1;
        }
        std::test::assert(self.cat.member_count() >= 225, "225 members describe it");
        let wide = self.cat.expand("t6", "wide1", 1, lim);
        std::test::assert(!wide.ok && std::str::contains(wide.why, "max_works 256"), "the fan-out is refused from the counts: " + wide.why);
        std::test::assert_eq_int(self.cat.bound_count(), 0, "and nothing was built on the way");

        // ---- a definition id cannot carry the path's delimiters
        std::test::assert(std::str::contains(self.cat.define("x@1|y", 1, 1, ""), "a workflow definition id is [a-z0-9][a-z0-9-]*"), "an id with delimiters is refused at construction");
        std::test::assert(std::str::contains(self.cat.define("Wrong", 1, 1, ""), "not `Wrong`"), "and so is an id outside the grammar");

        // ---- the machine form
        let text = self.cat.encode();
        std::test::assert_eq_str(self.copy.decode(text), "", "the document reads back");
        std::test::assert_eq_str(self.copy.encode(), text, "and encodes to the same document");
        std::test::assert_eq_int(self.copy.workflow_count(), self.cat.workflow_count(), "every workflow");
        std::test::assert_eq_int(self.copy.member_count(), self.cat.member_count(), "every member");
        let ma = self.copy.member_at(0);
        std::test::assert(ma.workflow == "close-month" && ma.revision == 1 && ma.step == 0 && ma.key == "a" && ma.kind == "leaf", "a member's place survives");
        std::test::assert(ma.objective == a.objective && ma.context_digest == a.context_digest && ma.knowledge_bindings == a.knowledge_bindings && ma.output_contract == a.output_contract && ma.data_class == a.data_class && ma.requires == a.requires && ma.target == a.target && ma.cost_ceiling == 42 && ma.attempts == 3, "and every field of its content");
        let mb = self.copy.member_at(1);
        std::test::assert(mb.kind == "child" && mb.child == "collect-receipts" && mb.child_revision == 1, "a child's reference survives");
        std::test::assert_eq_str(self.copy.workflow_at(0).title, "close the month", "a title survives");
        let back = self.cat.expand("t8", "close-month", 1, lim);
        let back_copy = self.copy.expand("t8", "close-month", 1, lim);
        std::test::assert(back.ok && back_copy.ok && self.cat_ids() == self.copy_ids(), "the copy expands to the same execution: " + self.copy_ids());
        // text with quotes, backslashes and newlines
        std::test::assert_eq_str(self.dup.define("quoted", 1, 1, "a \"title\" with\\slashes"), "", "quoted");
        std::test::assert_eq_str(self.dup.leaf("quoted", 1, 0, "q", leaf_work("line one\nline \"two\"\t\\end"), 1), "", "a leaf with awkward text");
        let qtext = self.dup.encode();
        let fresh = dna::WorkflowCatalog { };
        std::test::assert_eq_str(fresh.decode(qtext), "", "awkward text reads back");
        std::test::assert(fresh.member_at(0).objective == "line one\nline \"two\"\t\\end" && fresh.workflow_at(0).title == "a \"title\" with\\slashes", "unchanged");
        std::test::assert(std::str::contains(fresh.decode(qtext), "quoted@1 is already defined") && fresh.workflow_count() == 1 && fresh.member_count() == 1, "reading the same document twice is refused and adds nothing");
        // a document that defines one revision twice is refused whole
        let twice_doc = "{\"format\": \"dna.workflow-definitions/1\", \"workflows\": [{\"id\": \"same\", \"revision\": 1, \"steps\": 1, \"title\": \"one\"}, {\"id\": \"same\", \"revision\": 1, \"steps\": 2, \"title\": \"two\"}], \"members\": []}";
        let twice_cat = dna::WorkflowCatalog { };
        std::test::assert(std::str::contains(twice_cat.decode(twice_doc), "the document defines workflow same@1 twice"), "a document cannot define one revision twice");
        std::test::assert_eq_int(twice_cat.workflow_count(), 0, "and nothing of it was added");
        let bad_id_doc = "{\"format\": \"dna.workflow-definitions/1\", \"workflows\": [{\"id\": \"x@1|y\", \"revision\": 1, \"steps\": 1, \"title\": \"\"}], \"members\": []}";
        std::test::assert(std::str::contains(twice_cat.decode(bad_id_doc), "a workflow definition id is") && twice_cat.workflow_count() == 0, "nor carry an id outside the grammar");
        std::test::assert(std::str::contains(fresh.decode("{\"format\": \"something else\"}"), "not a workflow definition document"), "another document is refused");
        // a member of a kind the builder never writes, from a document
        let odd = dna::WorkflowCatalog { };
        std::test::assert_eq_str(odd.decode("{\"format\": \"dna.workflow-definitions/1\", \"workflows\": [{\"id\": \"odd\", \"revision\": 1, \"steps\": 1, \"title\": \"\"}], \"members\": [{\"workflow\": \"odd\", \"revision\": 1, \"step\": 0, \"key\": \"k\", \"kind\": \"loop\", \"attempts\": 1}]}"), "", "a hand-written document reads");
        let ox = odd.expand("t10", "odd", 1, lim);
        std::test::assert(!ox.ok && std::str::contains(ox.why, "a member is a leaf or a child, not `loop`") && odd.bound_count() == 0, "an unknown member kind is refused: " + ox.why);
    }
}

fn main() { App { }; }
