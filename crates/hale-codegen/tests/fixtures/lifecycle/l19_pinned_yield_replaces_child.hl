// Decision line 19, a bus handler suspended at a yield on a pinned
// thread when its owner replaces it (Handler, inventory row R52, known
// open): the handler holds its subscriber until it returns.
//
// Owner, pinned, owns `c: Kid`, whose subscription routes to Owner's
// mailbox. App publishes `Gos`, then `Swap`. The pinned thread runs
// Kid's handler, which says so, sleeps and then reads the heap String
// its birth() built. The sleep is a yield on a pinned thread, which
// drains the thread's mailbox (`lotus_mailbox_drain_pending`), so
// Owner's `Swap` handler runs inside the suspended one and replaces
// `c` through `swap()`. A pinned thread's handler takes no hold on its
// subscriber (only a pool worker's does, `lotus_handler_hold_take`),
// so the old Kid is reclaimed there and then, its arena released, and
// when the sleep returns its handler reads the freed name.
//
// Expected terminal outcome: the handler reads the old Kid's name, the
// old Kid is reclaimed after its handler returns, and each Kid is torn
// down once, judged by the harness: `read-whole reclaimed-after-handler
// dissolved-once-each`. Today: `reclaimed-under-handler
// dissolved-once-each`, and under ASan a heap-use-after-free in the
// handler. The harness names the read only when the reclaim came after
// it: under the handler the read is of a released arena, and what it
// prints depends on whether the chunk pool reused the bytes, so that
// read is judged by the ASan run alone.

type Go { k: Int; }
topic Gos { payload: Go; subject: "lifecycle.l19.pinned_yield.go"; }
topic Swap { payload: Go; subject: "lifecycle.l19.pinned_yield.swap"; }

locus Kid {
    params { tag: Int = 0; name: String = ""; }
    bus { subscribe Gos as on_go; }
    birth() { self.name = "kid-" + to_string(self.tag) + "-name"; }
    fn on_go(g: Go) {
        if g.k == self.tag {
            println("ev kid-handler-enter " + to_string(self.tag));
            std::time::sleep(100ms);
            println("ev kid-handler-read " + self.name);
        }
    }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag)); }
}

locus Owner {
    params { c: Kid = Kid { tag: 1 }; }
    bus { subscribe Swap as on_swap; }
    fn swap() { self.c = Kid { tag: 2 }; }
    fn on_swap(s: Go) {
        println("ev owner-swap");
        self.swap();
    }
}

main locus App {
    params { p: Owner = Owner { }; }
    placement { p: pinned; }
    bus { publish Gos; publish Swap; }
    run() {
        Gos <- Go { k: 1 };
        Swap <- Go { k: 0 };
        std::time::sleep(500ms);
        println("ev finished");
    }
}

fn main() { App { }; }
