// A wire map crosses the protobuf codec as `map<string, T>` (spec/api.md §
// Codecs, § gRPC).
//
// Each entry is an occurrence of a message of the key (field 1) and the
// whole record (field 2, its key field carried too: the record's own
// message). The decoder gives each record the entry's key, so the map's key
// wins over a key the record carries; a key already read is
// `duplicate_key`. JSON in, protobuf through, JSON out gives back the same
// text. This program names no port: the serve site is in a method nothing
// calls, which is all the compiler needs to write the codecs.

type Check { name: String; status: String; detail: String = ""; }
type Health { checks: bounded[Check; 3] indexed_by name; ok: Bool = true; }

api PbMap {
    rpc Probe::health;
}

locus Probe {
    fn health(h: Health) -> Health { return h; }
}

locus Tokens {
    fn principal(token: String) -> std::api::Principal {
        return std::api::Principal { mode: "bearer", name: "" };
    }
    fn refused() -> String { return "no such token"; }
}

main locus Desk {
    params {
        probe: Probe = Probe { };
        bearer: Tokens = Tokens { };
        // Served only so the compiler writes the codecs; nothing calls it.
        h: api::Exposure = api::serve(PbMap, grpc::Rpc { bind: "127.0.0.1:0", codec: json, principals: self.bearer }, as: "pb", receivers: { Probe: self.probe }, bound: 4, on_full: refuse);
    }

    // JSON in, protobuf through, JSON out: the same text.
    fn round(json: String, what: String) {
        let v = __api_decode_Health(json) or {
            std::test::assert(false, what + ": the JSON decoder: " + err.kind + " " + err.field);
            return;
        };
        let back = __api_pb_decode_Health(__api_pb_encode_Health(v)) or {
            std::test::assert(false, what + ": the protobuf decoder: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_str(__api_encode_Health(back), json, what);
    }

    // One entry of field 1: its key and the record's message.
    fn entry(key: String, name: String, status: String) -> Bytes {
        let check = std::bytes::concat(__api_pb_put_str(1, name), __api_pb_put_str(2, status));
        return __api_pb_put_msg(1, std::bytes::concat(__api_pb_put_str(1, key), __api_pb_put_msg(2, check)));
    }

    run() {
        self.round("{\"checks\":{},\"ok\":true}", "an empty map");
        self.round("{\"checks\":{\"db\":{\"status\":\"up\",\"detail\":\"\"},\"cache\":{\"status\":\"down\",\"detail\":\"evicted\"}},\"ok\":false}", "two entries, in order");

        // the entry's key wins over the record's own
        let wins = __api_pb_decode_Health(self.entry("db", "other", "up")) or {
            std::test::assert(false, "an entry whose record names another key: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_str(__api_encode_Health(wins), "{\"checks\":{\"db\":{\"status\":\"up\",\"detail\":\"\"}},\"ok\":true}", "the map's key wins");

        // a key already read
        let twice = std::bytes::concat(self.entry("db", "db", "up"), self.entry("db", "db", "down"));
        let dup = __api_pb_decode_Health(twice) or {
            std::test::assert_eq_str(err.kind, "duplicate_key", "a duplicate key: the kind");
            std::test::assert_eq_str(err.field, "checks", "a duplicate key: the field");
            return;
        };
        std::test::assert(false, "a duplicate key decoded " + __api_encode_Health(dup));
    }
}

fn main() { Desk { }; }
