// dna/host — the host: what `hale dna` does beside the compiler, as a
// Hale program (GH #566 F8). `hale dna <verb>` builds it once into the
// toolchain cache and execs it with the project resolved:
//
//   host <verb> <root> <seed> <fleet> <plan> [args…]
//
// with HALE_BIN (the toolchain), HALE_DNA_MEMBRANE (the membrane
// client binary) and HALE_DNA_TOOLCHAIN (its version) in the
// environment. It prints what the verb answers and exits with its
// status. It decides nothing.

import "../core" as dna;

fn arg(i: Int) -> String { return std::env::arg_or(i, ""); }

fn rest_args(from: Int) -> String {
    let mut out = "";
    let mut i = from;
    while i < std::env::args_count() {
        out = out + std::env::arg(i) + "\n";
        i = i + 1;
    }
    return out;
}

// `--flag value` and positionals from the verb's args, newline-separated.
type Args {
    words: String = ""; // positionals, newline-separated
    flags: String = ""; // "\n--name\nvalue" pairs, newline-separated
}

fn has_flag(a: Args, name: String) -> Bool {
    return std::str::contains(a.flags, "\n" + name + "\n");
}

fn flag(a: Args, name: String) -> String {
    let i = std::str::index_of(a.flags, "\n" + name + "\n");
    if i < 0 { return ""; }
    let rest = a.flags[(i + len(name) + 2)..len(a.flags)];
    let nl = std::str::index_of(rest, "\n");
    if nl < 0 { return rest; }
    return rest[0..nl];
}

fn word(a: Args, n: Int) -> String {
    let mut rest = a.words;
    let mut k = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if k == n { return w; }
        k = k + 1;
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return "";
}

// positionals joined by spaces
fn join_words(words: String) -> String {
    let mut out = "";
    let mut rest = words;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if len(w) > 0 { out = out + (if len(out) > 0 { " " } else { "" }) + w; }
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return out;
}

fn drop_first_word(words: String) -> String {
    let nl = std::str::index_of(words, "\n");
    if nl < 0 { return ""; }
    return words[(nl + 1)..len(words)];
}

fn parse_args(raw: String, valued: String) -> Args {
    let mut a = Args { flags: "\n" };
    let mut rest = raw;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
        if std::str::starts_with(w, "--") && std::str::contains(valued, " " + w + " ") {
            let nl2 = std::str::index_of(rest, "\n");
            let v = if nl2 < 0 { rest } else { rest[0..nl2] };
            if nl2 < 0 { rest = ""; } else { rest = rest[(nl2 + 1)..len(rest)]; }
            a.flags = a.flags + w + "\n" + v + "\n";
        } else if std::str::starts_with(w, "--") {
            a.flags = a.flags + w + "\n\n";
        } else if len(w) > 0 {
            a.words = a.words + w + "\n";
        }
    }
    return a;
}

fn main() {
    let verb = arg(1);
    let root = arg(2);
    let seed = arg(3);
    let fleet = arg(4);
    let plan = arg(5);
    let toolchain = std::env::var("HALE_DNA_TOOLCHAIN");
    let a = parse_args(rest_args(6), " --to --as --authority --comment --digest --port --observe --repo --fleet --tick --severity --note --dsn --dir --body --outcome --purpose --why --policy --decided-by --via --evidence --class --name --classes --by --holder --token --expires --host-pid ");
    let mut ans = Answer { ok: false, text: "unknown verb `" + verb + "`" };
    if (verb == "board" || verb == "review") && !membrane_up(root) { let s = sync_record(root); }
    if verb == "fleet" { let s = sync_record(root); }
    if verb == "status" {
        ans = status_verb(root, seed, toolchain, has_flag(a, "--json"));
    } else if verb == "history" {
        ans = history_verb(root, word(a, 0));
    } else if verb == "review" {
        if len(record_head(root)) == 0 { ans = fail(no_record(root)); }
        else {
            let p = open_projection(root, seed, toolchain);
            let id = word(a, 0);
            if len(id) == 0 { ans = review_list(p); } else { ans = render_review(p, id, has_flag(a, "--iris")); }
        }
    } else if verb == "board" || verb == "report" || verb == "pressure" || verb == "fleet" {
        if len(record_head(root)) == 0 { ans = fail(no_record(root)); }
        else {
            let p = open_projection(root, seed, toolchain);
            if verb == "board" { ans = board_verb(p); }
            if verb == "report" { ans = report_verb(p); }
            if verb == "pressure" { ans = pressure_list(p); }
            if verb == "fleet" { ans = fleet_list(p, fleet, plan); }
        }
    }
    if verb == "body-fence" {
        fence_main(flag(a, "--holder"), std::str::parse_int(flag(a, "--token")) or 0, std::str::parse_int(flag(a, "--expires")) or 0, std::str::parse_int(flag(a, "--host-pid")) or 0);
        return;
    }
    if verb == "run" || verb == "dev" {
        host_main(verb, root, seed, fleet, plan, toolchain, a);
        return;
    }
    if verb == "node" {
        let tick = flag(a, "--tick");
        node_main(word(a, 0), root, flag(a, "--fleet"), if len(tick) > 0 { std::str::parse_int(tick) or 1000 } else { 1000 });
        return;
    }
    if verb == "ask" {
        ans = ask_verb(root, join_words(a.words), flag(a, "--to"), has_flag(a, "--no-wait"), flag(a, "--as"));
    } else if verb == "verdict" {
        ans = verdict_verb(root, seed, word(a, 0), word(a, 1), flag(a, "--as"), flag(a, "--authority"), flag(a, "--comment"), flag(a, "--digest"), has_flag(a, "--no-wait"));
    } else if verb == "raise" {
        ans = pressure_raise(root, word(a, 0), join_words(drop_first_word(a.words)));
    } else if verb == "concern-raise" {
        let sev = flag(a, "--severity");
        ans = concern_raise(root, word(a, 0), join_words(drop_first_word(a.words)), if len(sev) > 0 { std::str::parse_int(sev) or 1 } else { 1 });
    } else if verb == "task" {
        // GH #596 W: `hale dna task done <id> [--as <who>] [--note …]`
        if word(a, 0) == "done" { ans = task_done_verb(root, seed, word(a, 1), flag(a, "--as"), flag(a, "--note")); }
        else if word(a, 0) == "reassign" { ans = task_reassign_verb(root, seed, word(a, 1), flag(a, "--to"), flag(a, "--as")); }
        // GH #616: `hale dna task decide <id> --decided-by <party> --via <channel> --evidence <digest>`
        else if word(a, 0) == "decide" { ans = task_decide_verb(root, seed, word(a, 1), flag(a, "--decided-by"), flag(a, "--via"), flag(a, "--evidence"), flag(a, "--note"), flag(a, "--as")); }
        else { ans = fail("task: `hale dna task done <id> [--as <who>] [--note <what was done>]`, `hale dna task reassign <id> --to <who> [--as <by>]` or `hale dna task decide <id> --decided-by <party> --via <channel> --evidence <digest> [--as <reporter>]`"); }
    } else if verb == "effect" {
        // GH #604 rule 3: `hale dna effect resolve <key> --outcome ok|failed`
        if word(a, 0) == "resolve" { ans = effect_resolve_verb(root, seed, word(a, 1), flag(a, "--outcome"), flag(a, "--as"), flag(a, "--note")); }
        else { ans = fail("effect: `hale dna effect resolve <key> --outcome ok|failed [--as <who>] [--note …]`"); }
    } else if verb == "retire" {
        // GH #604 rule 5: `hale dna retire <who> [--to <successor>] [--as <by>]`
        ans = retire_verb(root, seed, word(a, 0), flag(a, "--to"), flag(a, "--as"));
    } else if verb == "sync" {
        ans = sync_verb(root);
    } else if verb == "body" {
        // GH #617: the body lease from the CLI; the body on a server
        let sub = word(a, 0);
        if sub == "provision" { ans = body_provision_verb(root, word(a, 1), flag(a, "--dsn"), flag(a, "--dir"), has_flag(a, "--dry-run"), flag(a, "--as")); }
        else if sub == "start" || sub == "stop" || sub == "logs" { ans = body_ctl_verb(root, sub, flag(a, "--body")); }
        else { ans = body_verb(root, sub, has_flag(a, "--force"), flag(a, "--as")); }
    } else if verb == "connect" {
        // GH #615: `hale dna connect [<record-url> --name <n> --as <position> --purpose <p> --classes <c,…>]`
        ans = connect_verb(root, seed, word(a, 0), flag(a, "--name"), flag(a, "--as"), flag(a, "--purpose"), flag(a, "--classes"), flag(a, "--by"));
    } else if verb == "disconnect" {
        ans = disconnect_verb(root, seed, word(a, 0), flag(a, "--why"), flag(a, "--by"));
    } else if verb == "handoff" {
        let sub = word(a, 0);
        if len(sub) == 0 { ans = handoff_list_verb(root, seed); }
        else if sub == "accept" { ans = handoff_accept_verb(root, seed, word(a, 1), flag(a, "--note"), flag(a, "--as")); }
        else if sub == "sync" { ans = handoff_sync_verb(root, seed); }
        else { ans = handoff_publish_verb(root, seed, sub, word(a, 1), word(a, 2), flag(a, "--note"), flag(a, "--as")); }
    } else if verb == "receipt" {
        // GH #606: protected evidence
        if word(a, 0) == "file" { ans = receipt_file_verb(root, word(a, 1), flag(a, "--class"), flag(a, "--as")); }
        else { ans = receipt_verb(root, word(a, 0), word(a, 1), flag(a, "--to"), flag(a, "--purpose"), flag(a, "--as"), flag(a, "--why"), flag(a, "--policy")); }
    } else if verb == "schedule" {
        // GH #610: the schedules, and pause/resume as rows
        ans = schedule_verb(root, word(a, 0), word(a, 1), flag(a, "--as"));
    } else if verb == "secret" {
        ans = secret_verb(root, word(a, 0), word(a, 1), flag(a, "--body"), flag(a, "--as"));
    } else if verb == "profile" {
        ans = profile_verb(root);
    } else if verb == "deploy" {
        ans = deploy_verb(root, fleet, plan, word(a, 0), false);
    } else if verb == "rollback" {
        ans = deploy_verb(root, fleet, plan, word(a, 0), true);
    } else if verb == "github" {
        ans = github_verb(root, seed, word(a, 0));
    } else if verb == "models" {
        ans = models_verb(root, std::env::var("HALE_BIN"));
    }
    if ans.ok {
        print(ans.text);
        return;
    }
    eprintln("hale dna: ", ans.text);
    std::process::exit(1);
}
