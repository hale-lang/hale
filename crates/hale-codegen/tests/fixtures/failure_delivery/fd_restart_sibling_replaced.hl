// The reclaim wins over a sibling's restart (PR #1348's review). `a` and
// `b` run on two pools. `a` fails first; the owner's handler for it
// waits until `b` has raised too (a gate file, then 250 ms for the post)
// and replaces `b` while `b`'s failure is posted to the owner and not yet
// delivered, so the old `b`'s reclaim is deferred behind that delivery.
// `b`'s handler then runs and asks for a restart of the old `b`. Its
// reclaim is owed, so the restart is not performed: the old `b` is
// reclaimed after its handler, exactly once, and its birth() and run()
// never start again. The new `b` is untouched.
// Expected outcome: `old-born-1 old-ran-1 old-dissolved-1
// read-before-dissolve new-born-1 new-ran-1 new-dissolved-1`. Before the
// rule the old `b` was born and run again beside its own dissolve.

fn gate(what: String) -> String { return "/tmp/hale-fd-restart-sibling-" + what + "-" + to_string(std::process::pid()); }

fn wait_for(what: String) {
    let until = std::time::monotonic_ns() + 5000000000;
    while !std::io::fs::file_exists(gate(what)) && std::time::monotonic_ns() < until { std::time::sleep(1ms); }
}

locus Kid {
    params { tag: Int = 0; runs: Int = 0; name: String = ""; }
    closure fuse { captures: tag; epoch inline; }
    birth() {
        self.name = "kid-" + to_string(self.tag) + "-name";
        println("ev kid-birth " + to_string(self.tag));
    }
    run() {
        self.runs = self.runs + 1;
        println("ev kid-run " + to_string(self.tag) + " " + to_string(self.runs));
        if self.tag == 0 && self.runs == 1 {
            wait_for("start");
            violate fuse;
        }
        if self.tag == 1 && self.runs == 1 {
            wait_for("handling");
            std::io::fs::write_file(gate("raising"), "go") or discard;
            violate fuse;
        }
    }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag) + " " + self.name); }
}

main locus App {
    params { a: Kid = Kid { tag: 0 }; b: Kid = Kid { tag: 1 }; heard: Int = 0; }
    placement { a: cooperative(pool = left); b: cooperative(pool = right); }
    on_failure(c: Kid, err: ClosureViolation) {
        println("ev handler " + c.name);
        if c.tag == 0 {
            std::io::fs::write_file(gate("handling"), "go") or discard;
            wait_for("raising");
            std::time::sleep(250ms);
            self.b = Kid { tag: 2 };
            println("ev replaced sibling");
        }
        if c.tag == 1 {
            restart (c);
        }
        self.heard = self.heard + 1;
    }
    run() {
        std::io::fs::write_file(gate("start"), "go") or discard;
        let until = std::time::monotonic_ns() + 5000000000;
        while self.heard < 2 && std::time::monotonic_ns() < until { std::time::sleep(1ms); }
        std::time::sleep(300ms);
        println("ev finished");
    }
    dissolve() {
        std::io::fs::unlink(gate("start")) or discard;
        std::io::fs::unlink(gate("handling")) or discard;
        std::io::fs::unlink(gate("raising")) or discard;
    }
}

fn main() { App { }; }
