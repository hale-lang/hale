// tests/hale/fixed_int_violation_test.hl — the fixed-width integers (GH
// #2132, F.64): an operator never wraps. An overflow of `+`, `-` or `*`, a
// division or a remainder by zero, the minimum divided by `-1`, the
// minimum negated, and a shift by a count outside 0 through the width less
// one are each a violation where they happen: the process prints what
// happened and exits 1, and nothing after the operator runs. (`T::checked_*`
// fail instead and `T::wrapping_*` wrap; those are
// `fixed_int_arith_test.hl`'s.) One program, built once, runs each case by
// name.

fn app_source() -> String {
    return """
        fn u8_of(x: U8) -> U8 {
            return x;
        }

        fn i8_of(x: I8) -> I8 {
            return x;
        }

        fn u32_of(x: U32) -> U32 {
            return x;
        }

        fn i16_of(x: I16) -> I16 {
            return x;
        }

        fn main() {
            let what = std::env::arg_or(1, "");
            let top = u8_of(255);
            let zero = u8_of(0);
            let low = i8_of(-128);
            let minus_one = i8_of(-1);
            println("before");
            if what == "add" {
                println(top + 1);
            } else if what == "sub" {
                println(zero - 1);
            } else if what == "mul" {
                println(u32_of(65536) * u32_of(65536));
            } else if what == "i16add" {
                println(i16_of(32767) + 1);
            } else if what == "div" {
                println(top / zero);
            } else if what == "rem" {
                println(top % zero);
            } else if what == "divmin" {
                println(low / minus_one);
            } else if what == "neg" {
                println(-low);
            } else if what == "shl" {
                println(top << (std::env::args_count() + 6));
            } else if what == "shr" {
                println(top >> (std::env::args_count() - 3));
            } else if what == "fine" {
                println(top - 1 + 1, " ", low + 1 - 1);
            }
            println("after");
        }
        """;
}

fn expect(bin: String, what: String, want: String) {
    let out = std::process::run(bin + "\n" + what)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(out.code, 1, what + " exits 1: " + out.stderr);
    std::test::assert(std::str::contains(out.stdout, "before"), what + " ran up to the operator");
    std::test::assert(
        !std::str::contains(out.stdout, "after"),
        what + " ran nothing after it: " + out.stdout,
    );
    std::test::assert(
        std::str::contains(out.stderr, want),
        what + " says `" + want + "`: " + out.stderr,
    );
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let src = std::io::fs::mktemp("/tmp/hale-2132-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source()) or discard;
    let built = std::process::run(hale + "\nbuild\n" + src)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(built.code, 0, "the program builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];

    expect(
        bin,
        "add",
        "violation: U8 `+` overflows: the result is outside U8's range, 0 through 255 (U8::checked_add fails instead, and U8::wrapping_add wraps)",
    );
    expect(bin, "sub", "violation: U8 `-` overflows");
    expect(
        bin,
        "mul",
        "violation: U32 `*` overflows: the result is outside U32's range, 0 through 4294967295",
    );
    expect(
        bin,
        "i16add",
        "violation: I16 `+` overflows: the result is outside I16's range, -32768 through 32767",
    );
    expect(bin, "div", "violation: U8 division by zero");
    expect(bin, "rem", "violation: U8 remainder by zero");
    expect(bin, "divmin", "violation: I8 `/` overflows: -128 / -1 is outside I8's range");
    expect(bin, "neg", "violation: I8 `-` overflows: -(-128) is outside I8's range");
    expect(bin, "shl", "violation: U8 shift by a count outside 0 through 7");
    expect(bin, "shr", "violation: U8 shift by a count outside 0 through 7");

    let fine = std::process::run(bin + "\nfine")
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(fine.code, 0, "an operator in range runs on: " + fine.stderr);
    std::test::assert(
        std::str::contains(fine.stdout, "255 -128"),
        "top - 1 + 1 and low + 1 - 1: " + fine.stdout,
    );
    std::test::assert(std::str::contains(fine.stdout, "after"), "and what follows runs");

    std::io::fs::unlink(src) or discard;
    std::io::fs::unlink(bin) or discard;
}
