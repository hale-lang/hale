// dna/operations/graph_show.hl — the two perspectives as text (GH #1086).
//
// `hale dna show org` and `hale dna show processes` are queries over
// memory (`KnowledgeStore.graph_perspective`); these render what the query
// answers. Neither is edited through: a change moves through the record's
// rows and shows up in both. A node is shown by the last segment of its
// name (`contract:spec/openapi.yaml` is `openapi.yaml`).
//
// The org chart — nothing at all when there are no positions — is
// `purpose`, then one line per node positions sit under, in
// the record's order. A position under the purpose is a line of its own;
// the others are `<node>  <role>, <role>(<what it reviews>)` with the
// node's name padded so the roles line up, a role being the position's
// name less its node's (`api/dev` under `api` is `dev`), and its holders,
// when it has any, in brackets after it.
//
//   purpose
//     board
//     api         dev [ada], reviewer(openapi.yaml) [grace]
//     compose     operator
//
// The process model: one line per contract, from its consumers (the
// parties outside the repository first) to its servers, over its
// transport, with its carriers after; then what each deployment runs.
//
//   callers, ui, node  --HTTP: openapi.yaml-->  api
//   api  --NATS: protocol.yaml-->  node  (carried by nats)
//   compose runs { postgres, nats, api, brain, node }

// The org chart, from `graph_perspective("org")`.
@unbounded
fn show_org(json: String) -> String {
    // the nodes positions sit under, in order, and the widest name
    let mut parents = "\n";
    let mut width = 0;
    let mut it = std::json::array_first(json);
    while !it.done {
        let under = std::json::find_string_field(it.element, "under");
        if !std::str::contains(parents, "\n" + under + "\n") {
            parents = parents + under + "\n";
            let shown = if len(under) == 0 { "(unplaced)" } else { dna::show_name(under) };
            if graph_id_kind(under) != "purpose" && std::str::cp_count(shown) > width { width = std::str::cp_count(shown); }
        }
        it = std::json::array_next(it);
    }
    // no positions, no chart: an empty graph prints nothing
    if len(parents) == 1 { return ""; }
    let mut out = "purpose\n";
    let mut rest = parents[1..len(parents)];
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let under = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let shown = if len(under) == 0 { "(unplaced)" } else { dna::show_name(under) };
        let mut roles = "";
        let mut p = std::json::array_first(json);
        while !p.done {
            if std::json::find_string_field(p.element, "under") == under {
                let name = std::json::find_string_field(p.element, "name");
                let prefix = (if len(under) > 0 { under[(std::str::index_of(under, ":") + 1)..len(under)] } else { "" }) + "/";
                let mut role = if std::str::starts_with(name, prefix) { name[len(prefix)..len(name)] } else { name };
                let reviews = dna::show_list(dna::show_strings(std::json::find_field_raw(p.element, "reviews")), true);
                if len(reviews) > 0 { role = role + "(" + reviews + ")"; }
                let holders = dna::show_list(dna::show_strings(std::json::find_field_raw(p.element, "holders")), false);
                if len(holders) > 0 { role = role + " [" + holders + "]"; }
                if graph_id_kind(under) == "purpose" { out = out + "  " + role + "\n"; }
                else { roles = roles + (if len(roles) > 0 { ", " } else { "" }) + role; }
            }
            p = std::json::array_next(p);
        }
        // padded by what a reader sees, code points, not bytes
        if graph_id_kind(under) != "purpose" { out = out + "  " + shown + std::str::repeat(" ", width - std::str::cp_count(shown)) + "  " + roles + "\n"; }
    }
    return out;
}

// The process model, from `graph_perspective("processes")`.
@unbounded
fn show_processes(json: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(std::json::find_field_raw(json, "meets"));
    while !it.done {
        let e = it.element;
        let outside = dna::show_list(dna::show_strings(std::json::find_field_raw(e, "outside")), false);
        let consumers = dna::show_list(dna::show_strings(std::json::find_field_raw(e, "consumers")), true);
        let from = if len(outside) > 0 && len(consumers) > 0 { outside + ", " + consumers } else if len(outside) > 0 { outside } else if len(consumers) > 0 { consumers } else { "(nobody)" };
        let servers = dna::show_list(dna::show_strings(std::json::find_field_raw(e, "servers")), true);
        let via = std::json::find_string_field(e, "via");
        let carriers = dna::show_list(dna::show_strings(std::json::find_field_raw(e, "carriers")), true);
        out = out + from + "  --" + (if len(via) > 0 { via + ": " } else { "" }) + dna::show_name(std::json::find_string_field(e, "contract")) + "-->  " + (if len(servers) > 0 { servers } else { "(nobody here)" }) + (if len(carriers) > 0 { "  (carried by " + carriers + ")" } else { "" }) + "\n";
        it = std::json::array_next(it);
    }
    let mut r = std::json::array_first(std::json::find_field_raw(json, "runs"));
    while !r.done {
        out = out + dna::show_name(std::json::find_string_field(r.element, "deployment")) + " runs { " + dna::show_list(dna::show_strings(std::json::find_field_raw(r.element, "processes")), true) + " }\n";
        r = std::json::array_next(r);
    }
    return out;
}
