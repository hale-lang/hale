// dna/core/memory_spine.hl — memory as the organism holds it (GH #985).
//
// There is no service in front of memory. A part that reads or writes it
// opens Postgres itself, as a role whose DSN the environment names, and
// the role is who it is: the spine's role (HALE_DNA_MEMORY_DSN_SPINE)
// writes the graph and protected evidence and appends the organism's own
// rows; a head's (HALE_DNA_MEMORY_DSN_HEAD) takes and fences a claim,
// reads, and appends to the Ledger in its people's names. Every Ledger
// row goes through memory's insert function, which is the gate (GH
// #1026). Each handle is scoped to the record it serves by the record's
// identity, the sha of its first row, read at open.

const SPINE_DSN_ENV: String = "HALE_DNA_MEMORY_DSN_SPINE";
const HEAD_DSN_ENV: String = "HALE_DNA_MEMORY_DSN_HEAD";

// The role this process was given: the spine's when the body started it
// with one, otherwise the head's. A process never holds both.
fn own_dsn_env() -> String { if dsn_set(SPINE_DSN_ENV) { return SPINE_DSN_ENV; } return HEAD_DSN_ENV; }

fn dsn_set(env_name: String) -> Bool {
    if std::str::starts_with(env_name, "postgres") { return true; }
    return len(env_name) > 0 && std::env::var_exists(env_name) && len(std::env::var(env_name)) > 0;
}

// GH #1590: the head's DSN a clone keeps for whatever in it is given no
// role's (`.hale/dna/memory.env`, written mode 600 by memory's migration):
// "" when there is none, and when the file is readable by anyone but its
// owner (`kept_dsn_refusal` says why). Only the head's line is read.
fn kept_dsn(repo: String, env_name: String) -> String {
    let path = repo + "/.hale/dna/memory.env";
    if !std::io::fs::file_exists(path) { return ""; }
    if len(kept_dsn_refusal(repo)) > 0 { return ""; }
    let text = std::io::fs::read_file(path) or "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let eq = std::str::index_of(line, "=");
        if eq <= 0 { continue; }
        let value = line[(eq + 1)..len(line)];
        if line[0..eq] == HEAD_DSN_ENV && std::str::starts_with(value, "postgres") { return value; }
    }
    return "";
}

// Why the clone's kept DSN is not used: "" when it may be, else what is
// wrong with the file and the fix.
fn kept_dsn_refusal(repo: String) -> String {
    let path = repo + "/.hale/dna/memory.env";
    let mode = file_mode(path);
    if len(mode) == 0 { return ""; }
    if !std::str::ends_with(mode, "00") { return path + " holds the head's DSN and is readable by others (mode " + mode + "): `chmod 600 " + path + "`, or remove it and run `hale dna memory migrate` again"; }
    return "";
}

// The spine's DSN this clone reaches with what it keeps (GH #1590): the
// head's DSN it keeps, with the spine's role and the vault entry the
// bootstrap drew for it; "" when it keeps no head DSN or the vault holds no
// spine password. A body run here (`hale dna run`) dials it when no spine
// DSN is named.
fn kept_spine_dsn(repo: String) -> String {
    let head = kept_dsn(repo, HEAD_DSN_ENV);
    if len(head) == 0 { return ""; }
    let id = record_scope(repo);
    let d = parse_dsn(head);
    if len(id) == 0 || !d.ok { return ""; }
    let role = spine_role(id);
    if !std::secret::Credential { vault: role_vault_name(role) }.ready() { return ""; }
    return dsn_text(role_dsn(d, role));
}

// Where a memory handle at `repo` dials: its environment variable when it
// is set, else the DSN the clone keeps (a DSN in place of the name: the
// stores dial either), else the name, which then says it is not set. No
// name is a handle given its connection: it dials nothing.
fn memory_source(repo: String, env_name: String) -> String {
    if len(env_name) == 0 || dsn_set(env_name) { return env_name; }
    let kept = kept_dsn(repo, env_name);
    return if len(kept) > 0 { kept } else { env_name };
}

// ---- the record's identity (GH #1590) ---------------------------------------
//
// A record's identity names its memory: the schema `dna_<identity>`, the
// nerves' organization token, the roles. It is pinned in the genome, as
// `[dna] record = "<identity>"` in the repository's `hale.toml`, written by
// `hale dna init` and `upgrade`, so a clone knows which record it belongs
// to before it holds a row of it. The identity is the digest of the
// record's first row, `record.genesis`, composed by init before the pin is
// written; a `hale.toml` copied from another project names a record whose
// genesis names a genome this clone's history does not hold, and is
// refused rather than read into the other record's memory.

// The identity, or why there is none to use: `id` "" with `why` "" is a
// record that has no rows yet and no pin.
type RecordIdentity {
    id: String = "";
    why: String = "";
}

// A value of `hale.toml`'s `dna` table as read: absent (`present` false),
// a string (`value`), or present and unreadable here (`why`), which a
// caller refuses rather than reads as absent: a pin it cannot read is
// never no pin (GH #1590).
type ManifestValue {
    present: Bool = false;
    value: String = "";
    why: String = "";
}

// `line` up to a `#` that is not inside a string.
fn toml_uncomment(line: String) -> String {
    let mut open_q = "";
    let mut i = 0;
    while i < len(line) {
        let c = line[i..(i + 1)];
        if len(open_q) == 0 {
            if c == "#" { return line[0..i]; }
            if c == "\"" || c == "'" { open_q = c; }
        } else if c == open_q {
            open_q = "";
        } else if c == "\\" && open_q == "\"" {
            i = i + 1;
        }
        i = i + 1;
    }
    return line;
}

// The first index of `ch` in `s` outside a string, -1 for none.
fn toml_index_outside(s: String, ch: String) -> Int {
    let mut open_q = "";
    let mut i = 0;
    while i < len(s) {
        let c = s[i..(i + 1)];
        if len(open_q) == 0 {
            if c == ch { return i; }
            if c == "\"" || c == "'" { open_q = c; }
        } else if c == open_q {
            open_q = "";
        }
        i = i + 1;
    }
    return -1;
}

// A key or a table name, its dotted parts unquoted and joined by `.`
// (`"dna" . record` is `dna.record`); a part with an escape is `?`, which
// matches nothing.
fn toml_dotted(path: String) -> String {
    let mut out = "";
    let mut rest = path;
    let mut more = true;
    while more {
        let dot = toml_index_outside(rest, ".");
        let part = std::str::trim(if dot < 0 { rest } else { rest[0..dot] });
        let mut name = part;
        let basic = std::str::starts_with(part, "\"") && std::str::ends_with(part, "\"");
        let literal = std::str::starts_with(part, "'") && std::str::ends_with(part, "'");
        if len(part) >= 2 && (basic || literal) {
            name = part[1..(len(part) - 1)];
            if basic && std::str::contains(name, "\\") { name = "?"; }
        }
        out = if len(out) == 0 { name } else { out + "." + name };
        more = dot >= 0;
        rest = if dot < 0 { "" } else { rest[(dot + 1)..len(rest)] };
    }
    return out;
}

// A one-line string value: basic (`"…"`, without escapes) or literal (`'…'`).
fn toml_string(raw: String) -> ManifestValue {
    let v = std::str::trim(raw);
    if std::str::starts_with(v, "\"\"\"") || std::str::starts_with(v, "'''") { return ManifestValue { present: true, why: "a multi-line string" }; }
    if len(v) < 2 { return ManifestValue { present: true, why: "not a string" }; }
    let q = v[0..1];
    if q != "\"" && q != "'" { return ManifestValue { present: true, why: "not a string" }; }
    let body = v[1..len(v)];
    let close = std::str::index_of(body, q);
    if close < 0 { return ManifestValue { present: true, why: "an unterminated string" }; }
    let inner = body[0..close];
    if q == "\"" && std::str::contains(inner, "\\") { return ManifestValue { present: true, why: "a string with escapes" }; }
    if len(std::str::trim(body[(close + 1)..len(body)])) > 0 { return ManifestValue { present: true, why: "more than one value" }; }
    return ManifestValue { present: true, value: inner };
}

// `key` of the `dna` table in `hale.toml` at `root`, wherever TOML lets it
// stand: under a `[dna]` header (quoted, spaced or commented), as a dotted
// key (`dna.key = …` at the root, `key = …` under `[dna]`), or in an inline
// table (`dna = { key = … }`).
fn manifest_dna_value(root: String, key: String) -> ManifestValue {
    let text = std::io::fs::read_file(root + "/hale.toml") or "";
    let want = "dna." + key;
    let mut table = "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = std::str::trim(toml_uncomment(if nl < 0 { rest } else { rest[0..nl] }));
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(line) == 0 { continue; }
        if std::str::starts_with(line, "[[") { table = "[[array]]"; continue; }
        if std::str::starts_with(line, "[") {
            let close = toml_index_outside(line, "]");
            table = if close < 0 { "?" } else { toml_dotted(line[1..close]) };
            // a header this reader cannot decode might be `dna`
            if std::str::contains(table, "?") { return ManifestValue { present: true, why: "a table header with escapes or unclosed" }; }
            continue;
        }
        let eq = toml_index_outside(line, "=");
        if eq < 0 { continue; }
        let k = toml_dotted(line[0..eq]);
        // a key this reader cannot decode, where it might be the pin
        if std::str::contains(k, "?") && (len(table) == 0 || table == "dna" || std::str::starts_with(table, "dna.")) { return ManifestValue { present: true, why: "a quoted key with escapes" }; }
        let full = if len(table) == 0 { k } else { table + "." + k };
        let value = line[(eq + 1)..len(line)];
        if full == want { return toml_string(value); }
        if full == "dna" {
            let v = std::str::trim(value);
            if !std::str::starts_with(v, "{") { return ManifestValue { present: true, why: "`dna` is not a table" }; }
            let end = toml_index_outside(v, "}");
            if end < 0 { return ManifestValue { present: true, why: "an inline `dna` table that does not end on its line" }; }
            let mut items = v[1..end];
            while len(std::str::trim(items)) > 0 {
                let comma = toml_index_outside(items, ",");
                let item = if comma < 0 { items } else { items[0..comma] };
                items = if comma < 0 { "" } else { items[(comma + 1)..len(items)] };
                let ieq = toml_index_outside(item, "=");
                let ik = if ieq < 0 { "" } else { toml_dotted(item[0..ieq]) };
                if std::str::contains(ik, "?") { return ManifestValue { present: true, why: "a quoted key with escapes" }; }
                if ieq >= 0 && ik == key { return toml_string(item[(ieq + 1)..len(item)]); }
            }
        }
    }
    return ManifestValue { };
}

// Lowercase hex digits, at least one.
fn hex_text(s: String) -> Bool {
    if len(s) == 0 { return false; }
    let mut i = 0;
    while i < len(s) {
        let c = s[i..(i + 1)];
        if !((c >= "0" && c <= "9") || (c >= "a" && c <= "f")) { return false; }
        i = i + 1;
    }
    return true;
}

// The identity of the record at `repo`: the pin, checked against the
// record this clone holds; the record's root commit when there is no pin.
fn record_identity_at(repo: String) -> RecordIdentity {
    let pin = manifest_dna_value(repo, "record");
    if len(pin.why) > 0 { return RecordIdentity { why: "hale.toml's [dna] record is present but not readable here (" + pin.why + "); write it as `record = \"<identity>\"`" }; }
    let pinned = pin.value;
    // GH #1590: the record is memory's, and the pin is the only way a clone
    // names it; a genome with no pin names no record yet
    if !pin.present { return RecordIdentity { }; }
    if hex_text(pinned) && len(pinned) == 40 { return RecordIdentity { why: "hale.toml's [dna] record is `" + pinned + "`, the root commit of a record an earlier toolchain kept on git, and records are not carried forward: re-init a fresh record (remove the `[dna] record` line and run `hale dna init`)" }; }
    if !hex_text(pinned) || len(pinned) != 64 { return RecordIdentity { why: "hale.toml's [dna] record is `" + pinned + "`, which is not a record's identity (64 lowercase hex digits)" }; }
    return RecordIdentity { id: pinned };
}

// The identity of the record at `repo`: the scope of its schema. "" when
// it has none yet, or when the pin and the record disagree
// (`record_identity_at` says why).
fn record_scope(repo: String) -> String {
    return record_identity_at(repo).id;
}

// ---- the ledger ------------------------------------------------------------

// The ledger as a process holds it: a `Journal` over its store, opened as
// the process's role on first use. A writer that holds a lease (the body,
// an owner's controller) carries it and its epoch, from the environment
// the host set, and the store refuses a write under a lease that is not
// live at that epoch (GH #665, #1026: the insert function checks it, so a
// stale writer is refused at the boundary, not by its own reading).
// Without a DSN nothing is readable and every append fails as `io`: an
// organism on routing 1 does not start without its memory (#646 decision
// 3), and the host says so.
locus MemoryLedger {
    params {
        repo: String = ".";
        dsn_env: String = SPINE_DSN_ENV;
        store: PqLedger = PqLedger { };
        leases: PqLeaseStore = PqLeaseStore { };
        opened: Bool = false;
        failure: String = "";
        lease: String = "";
        token: Int = 0;
        lease_env: String = "HALE_DNA_LEASE";
        token_env: String = "HALE_DNA_LEASE_TOKEN";
    }
    birth() {
        self.dsn_env = memory_source(self.repo, self.dsn_env);
        if len(self.lease) == 0 && len(self.lease_env) > 0 && std::env::var_exists(self.lease_env) {
            self.lease = std::env::var(self.lease_env);
            if len(self.token_env) > 0 && std::env::var_exists(self.token_env) { self.token = std::str::parse_int(std::env::var(self.token_env)) or 0; }
        }
    }
    fn ready() -> Bool { return dsn_set(memory_source(self.repo, self.dsn_env)); }
    // Opened on first use, not at birth: an organism on routing 0 holds a
    // ledger and never asks it anything.
    fn ensure_open() -> Bool {
        if self.opened { return true; }
        self.dsn_env = memory_source(self.repo, self.dsn_env);
        if !self.ready() { self.failure = self.dsn_env + " is not set: no ledger"; return false; }
        let who = record_identity_at(self.repo);
        if len(who.why) > 0 { self.failure = who.why; return false; }
        let scope = who.id;
        self.store.dsn_env = self.dsn_env;
        self.leases.dsn_env = self.dsn_env;
        self.store.scope(scope);
        self.leases.scope(scope);
        if !self.store.open() { self.failure = "the ledger is not open: " + self.store.last_error(); return false; }
        if !self.leases.open() { self.failure = "the leases are not open: " + self.leases.last_error(); return false; }
        self.opened = true;
        return true;
    }
    fn revision() -> Int { if !self.ensure_open() { return 0; } return self.store.revision(); }
    fn head() -> String { if !self.ensure_open() { return "genesis"; } return self.store.head(); }
    fn refresh() -> Bool { if !self.ensure_open() { return false; } return self.store.refresh(); }
    fn read(i: Int) -> Event { if !self.ensure_open() { return Event { }; } return self.store.read(i); }
    fn verify_chain() -> Bool { if !self.ensure_open() { return false; } return self.store.verify_chain(); }
    fn author_of(i: Int) -> String { if !self.ensure_open() { return ""; } return self.store.author_of(i); }
    // The lease this writer holds rides on every append; the store refuses
    // the row when it is not live at that token, and says why.
    fn gated(r: AppendResult) -> AppendResult {
        if r.error == "refused" || r.error == "claimed" { self.failure = self.store.last_error(); }
        return r;
    }
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        if !self.ensure_open() { return AppendResult { error: "io", expected: expected, actual: 0 }; }
        self.failure = "";
        self.store.lease = self.lease;
        self.store.lease_token = self.token;
        return self.gated(self.store.append(expected, kind, entity, body));
    }
    fn append_batch(expected: Int, rows: RowBatch) -> AppendResult { return append_rows(self, expected, rows); }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        if !self.ensure_open() { return AppendResult { error: "io", expected: expected, actual: 0 }; }
        self.failure = "";
        self.store.lease = self.lease;
        self.store.lease_token = self.token;
        return self.gated(self.store.append_exact(expected, kind, entity, body));
    }
    // An append in `author`'s name: the row lands under it in one insert, so
    // no reader ever sees an admitted row without its author (GH #985).
    fn append_as(expected: Int, kind: String, entity: String, body: String, author: String, exact: Bool) -> AppendResult {
        if !self.ensure_open() { return AppendResult { error: "io", expected: expected, actual: 0 }; }
        self.store.writer = if len(author) > 0 { author } else { "ledger" };
        let r = if exact { self.append_exact(expected, kind, entity, body) } else { self.append(expected, kind, entity, body) };
        self.store.writer = "ledger";
        return r;
    }
    // A head's write (GH #1026): in `author`'s name, straight into the
    // Ledger — exactly at `expected` when a decision was read there, at the
    // tail for -1 — keyed by `request`, so a write retried after an answer
    // that was lost lands once. Done when it lands; refused with the gate's
    // reason (`last_error`) when it does not. One result per row: the
    // host's `append_lines` writes a row per line of the text it is handed.
    @bounded_by(text)
    fn write(expected: Int, kind: String, entity: String, body: String, author: String, request: String) -> AppendResult {
        if !self.ensure_open() { return AppendResult { error: "io", expected: expected, actual: 0 }; }
        let moved = self.store.refresh();
        self.store.request = request;
        let r = self.append_as(if expected >= 0 { expected } else { self.store.revision() }, kind, entity, body, author, expected >= 0);
        self.store.request = "";
        return r;
    }
    fn last_error() -> String { return if len(self.failure) > 0 { self.failure } else { self.store.last_error() }; }
}

// ---- one process's memory ---------------------------------------------------

// Memory as one process holds it (GH #985): the ledger and the leases,
// each opened once on first use and closed when the process's handle
// dissolves. A host builds one for its lifetime and a CLI verb one for its
// run; everything that reads the ledger or a lease takes this handle and
// never builds its own, so a long-lived process holds a fixed handful of
// connections however long it runs.
locus Memory {
    params {
        repo: String = ".";
        dsn_env: String = SPINE_DSN_ENV;
        ledger: MemoryLedger = MemoryLedger { };
        leases: MemoryLeases = MemoryLeases { };
    }
    birth() { self.point(self.repo, self.dsn_env); }
    // For a holder that knows its record only after it is built (the host).
    fn point(repo: String, dsn_env: String) {
        let source = memory_source(repo, dsn_env);
        self.repo = repo;
        self.dsn_env = source;
        self.ledger.repo = repo;
        self.ledger.dsn_env = source;
        self.leases.repo = repo;
        self.leases.dsn_env = source;
    }
}

// ---- leases ----------------------------------------------------------------

// Claims in memory (the `claims` table, GH #1026), swapped by token:
// `Coordination` for the gateway, `current`/`put` for the body lease,
// `claim`/`release_claim` for a node's acts. The head takes and fences a
// claim under its own role, the spine under its.
locus MemoryLeases {
    params {
        repo: String = ".";
        dsn_env: String = SPINE_DSN_ENV;
        store: PqLeaseStore = PqLeaseStore { };
        opened: Bool = false;
        last_error: String = "";
        reachable: Bool = true; // false after the last call could not reach memory
        races: Int = 0;
    }
    fn ready() -> Bool { return dsn_set(memory_source(self.repo, self.dsn_env)); }
    fn ensure_open() -> Bool {
        if self.opened { return true; }
        self.dsn_env = memory_source(self.repo, self.dsn_env);
        if !self.ready() { self.last_error = self.dsn_env + " is not set: no leases"; return false; }
        let who = record_identity_at(self.repo);
        if len(who.why) > 0 { self.last_error = who.why; return false; }
        self.store.dsn_env = self.dsn_env;
        self.store.scope(who.id);
        if !self.store.open() { self.last_error = "the leases are not open: " + self.store.last_error(); return false; }
        self.opened = true;
        return true;
    }
    // One lease per read, returned: only a test's driver reads it in a
    // loop of its own, as many times as its script says.
    @bounded_by(script)
    fn current(key: String) -> Lease {
        if !self.ensure_open() { self.reachable = false; return Lease { key: key }; }
        let s = self.store.current(key);
        let err = self.store.last_error();
        self.reachable = s.known || len(err) == 0;
        if !s.known { return Lease { key: key }; }
        return Lease { key: key, holder: s.holder, token: s.token, expires: s.expires, present: s.present };
    }
    // Land `l` under `key` only if the store's token is `expected` (0 for
    // none). False when another holder moved it first, or memory cannot be
    // reached (`reachable` says which).
    fn put(key: String, l: Lease, expected: Int) -> Bool {
        if !self.ensure_open() { self.reachable = false; return false; }
        let ok = self.store.put(key, l.holder, l.token, l.expires, l.present, expected);
        if ok { self.reachable = true; return true; }
        self.reachable = len(self.store.last_error()) == 0;
        if self.reachable { self.races = self.races + 1; } else { self.last_error = self.store.last_error(); }
        return false;
    }
    // ---- Coordination, as MemLeases and MemoryLeases have it
    fn acquire(key: String, holder: String, now: Int, ttl: Int) -> Lease {
        let cur = self.current(key);
        if !self.reachable { return Lease { key: key, holder: cur.holder, token: 0, expires: cur.expires, present: false }; }
        if cur.present && cur.expires > now && cur.holder != holder {
            return Lease { key: key, holder: cur.holder, token: 0, expires: cur.expires, present: false };
        }
        let l = Lease { key: key, holder: holder, token: cur.token + 1, expires: now + ttl, present: true };
        if !self.put(key, l, cur.token) {
            let again = self.current(key);
            return Lease { key: key, holder: again.holder, token: 0, expires: again.expires, present: false };
        }
        return l;
    }
    fn complete(key: String, token: Int, now: Int) -> Bool {
        let cur = self.current(key);
        if !cur.present { return false; }
        if cur.token != token { return false; }
        return self.put(key, Lease { key: key, holder: cur.holder, token: cur.token, expires: 0, present: false }, cur.token);
    }
    fn holder_of(key: String) -> String {
        let cur = self.current(key);
        if cur.present { return cur.holder; }
        return "";
    }
    // ---- claims by id (GH #1026)
    //
    // Every non-idempotent act a node takes is claimed by id, with an
    // expiry, before it is taken: `holder` takes `key` for `ttl` seconds,
    // or learns whose it is. The claim, as it stands after the attempt:
    // this holder's (`present`, `holder` = holder) when it won, someone
    // else's otherwise. The store decides between two racing holders —
    // one conditional write lands, the other finds it taken — and times
    // the claim by the database's clock, so nodes whose clocks disagree
    // agree on its expiry; a holder that dies leaves its claim to expire,
    // so another finishes. Taking a claim this holder already holds
    // renews it. Without memory (no DSN) there is no one to race and the
    // claim is granted; with memory that cannot be reached, nothing is
    // claimed (`reachable` false).
    fn claim(key: String, holder: String, ttl: Int) -> Lease {
        if !self.ready() { return Lease { key: key, holder: holder, token: 0, expires: std::time::now() + ttl, present: true }; }
        if !self.ensure_open() { self.reachable = false; return Lease { key: key }; }
        let s = self.store.claim(key, holder, ttl);
        self.reachable = s.known || len(self.store.last_error()) == 0;
        if !self.reachable { self.last_error = self.store.last_error(); }
        return Lease { key: key, holder: s.holder, token: s.token, expires: s.expires, present: s.present };
    }
    // Give a claim back on completion: true when `holder` held it.
    fn release_claim(key: String, holder: String) -> Bool {
        if !self.ready() { return true; }
        if !self.ensure_open() { self.reachable = false; return false; }
        let ok = self.store.give_back(key, holder);
        self.reachable = ok || len(self.store.last_error()) == 0;
        return ok;
    }
}

// ---- knowledge -------------------------------------------------------------

fn count_ids(ids: String) -> Int {
    let mut n = 0;
    let mut rest = ids + " ";
    while len(rest) > 1 {
        let sp = std::str::index_of(rest, " ");
        if sp > 0 { n = n + 1; }
        rest = rest[(sp + 1)..len(rest)];
    }
    return n;
}

// What a position's OWNER holds to read a bounded package from memory:
// never the editor, which the law keeps away from knowledge
// (`editors_never_learn`). The owner builds the hat the attempt carries
// by digest from the package, briefs the editor with it and names the
// package on the request, so the editor's `model.called` rows carry its
// digest and bindings (GH #946). The graph is the
// spine's projection of the record (the host applies it on its tick);
// without a DSN the package is empty and says so, and nothing waits on it.
// How long a package waits for the spine's projection to reach the
// record's last knowledge row before it refuses.
const PACKAGE_WAIT_SECS: Int = 20;

// The seq of the record's last row that changes what a package holds —
// an idea ratified or retired, a binding made or undone (the tail applies
// the rest, but no package reads it); -1 when there is none.
fn last_knowledge_row(repo: String) -> Int {
    let j = RecordJournal { repo: repo };
    let mut i = j.revision() - 1;
    while i >= 0 {
        let e = j.read(i);
        if e.kind == "knowledge.ratified" || e.kind == "knowledge.retired" || e.kind == "knowledge.binding.bound" || e.kind == "knowledge.binding.unbound" { return e.seq; }
        i = i - 1;
    }
    return -1;
}

locus MemoryKnowledge {
    params {
        repo: String = ".";
        dsn_env: String = SPINE_DSN_ENV;
        store: Pq = Pq { };
        budget: Int = 8;
        asked: Int = 0;
        answered: Int = 0;
        last_error: String = "";
        // GH #1225: what this client read of the record, kept until it can
        // change — the record's identity (fixed once it has a first row),
        // and its last knowledge row at the organism's journal revision
        // it was read at — and how often it read the record at all
        scope: String = "";
        scope_repo: String = "";
        knowledge_row: Int = -1;
        knowledge_rev: Int = -1;
        record_reads: Int = 0;
    }
    fn ready() -> Bool { return dsn_set(memory_source(self.repo, self.dsn_env)); }
    // The record's identity, read once it has one: a record with no rows
    // has none yet, and is asked again until it does.
    fn record_identity() -> String {
        if len(self.scope) == 0 || self.scope_repo != self.repo {
            self.scope = record_scope(self.repo);
            self.scope_repo = self.repo;
            self.record_reads = self.record_reads + 1;
        }
        return self.scope;
    }
    // The store scoped to the record as it is now (a record that had no
    // rows when the store opened, and has some now, moves to its own
    // schema), and a connection that still answers.
    fn ensure_open() -> Bool {
        self.dsn_env = memory_source(self.repo, self.dsn_env);
        let scope = self.record_identity();
        if len(scope) == 0 {
            let who = record_identity_at(self.repo);
            if len(who.why) > 0 { self.last_error = who.why; return false; }
        }
        self.store.dsn_env = self.dsn_env;
        if scope != self.store.record() { self.store.scope(scope); }
        if self.store.healthy() { return true; }
        if !self.store.reopen() { self.last_error = "the store is not open: " + self.store.last_error(); return false; }
        return true;
    }
    // What the evidence names for a target: the package and the ids it
    // included, as `bindings_of` renders them.
    fn bindings_for(target: String, query: String) -> String {
        return bindings_of(self.package_for(target, query));
    }
    // The package for a locus path: the ids, the digest and the revision,
    // and the ideas rendered for an objective. The query — what the work
    // is about — ranks the bounded set (K3); an empty query is ratification
    // order. The digest identifies what is handed over — the target and
    // the ideas — and nothing that varies between runs (GH #583 K4).
    fn package_for(target: String, query: String) -> ContextPackage {
        if !self.ready() { return ContextPackage { target: target, error: "no memory (" + self.dsn_env + " is not set)" }; }
        self.asked = self.asked + 1;
        self.last_error = "";
        if !self.ensure_open() { return ContextPackage { target: target, error: self.last_error }; }
        let q = if len(query) > 2000 { query[0..2000] } else { query };
        // the package answers for the knowledge the record holds now: the
        // spine projects on its tick, so a row ratified a moment ago may
        // not be in memory yet — wait for it, bounded, and refuse a stale
        // package rather than hand one over (the knowledge service
        // projected on every read; GH #985 moved projection to the spine).
        // Only the rows that change a package are waited on.
        let want = last_knowledge_row(self.repo) + 1;
        let deadline = std::time::now() + PACKAGE_WAIT_SECS;
        while self.store.watermark() < want && std::time::now() < deadline { std::time::sleep(200ms); }
        let at = self.store.watermark();
        if at < want { self.last_error = "memory's projection is at row " + to_string(at) + ", before the record's knowledge row " + to_string(want - 1) + "; the spine applies it on its tick"; return ContextPackage { target: target, error: self.last_error }; }
        self.store.forget_error();
        // the bound and the watermark it was read at, in one transaction
        // (GH #946 hardening): the package names the projection it was
        // drawn from, never one the spine's tick moved in between
        let ranked = self.store.ranked_at(target, self.budget, if len(q) > 0 { embed_text(q) } else { "" });
        if !ranked.ok || len(self.store.last_error()) > 0 {
            self.last_error = "the store cannot answer: " + self.store.last_error();
            return ContextPackage { target: target, error: self.last_error };
        }
        let ids = ranked.ids;
        let out = std::str::builder_new();
        let b = std::json::Builder { };
        b.begin_array();
        let mut rest = ids + " ";
        while len(rest) > 1 {
            let sp = std::str::index_of(rest, " ");
            let id = rest[0..sp];
            rest = rest[(sp + 1)..len(rest)];
            if len(id) == 0 { continue; }
            let s = self.store.idea(id);
            std::str::builder_append(out, "- " + s.idea.kind + ": " + s.idea.text + " (" + s.idea.author + ")\n");
            b.begin_object();
            b.string_field("id", id);
            b.string_field("name", s.idea.name);
            b.string_field("text", s.idea.text);
            b.string_field("kind", s.idea.kind);
            b.string_field("author", s.idea.author);
            b.end_object();
        }
        b.end_array();
        self.answered = self.answered + 1;
        return ContextPackage {
            target: target,
            revision: ranked.watermark,
            digest: digest_of(target + ":" + ids),
            included: ids,
            included_n: count_ids(ids),
            data_class: "internal",
            text: std::str::builder_finish(out),
            practices: b.result()
        };
    }
    // A hat by its digest, kept once (GH #946): done when memory holds it,
    // now or before; false, with `last_error`, when memory is not there
    // or would not take it.
    fn keep_hat(digest: String, head: String, watermark: Int, body: String) -> Bool {
        if !self.ready() { self.last_error = "no memory (" + self.dsn_env + " is not set)"; return false; }
        if !self.ensure_open() { return false; }
        self.store.forget_error();
        if !self.store.keep_hat(digest, head, watermark, body) { self.last_error = "the hat was not kept: " + self.store.last_error(); return false; }
        return true;
    }
    // Whether memory's projection has reached the record's last knowledge
    // row, asked without waiting (GH #995): a step that needs it waits as a
    // step, never inside the handler that answers verdicts. `revision` is
    // the organism's journal revision: the record is read for its last
    // knowledge row only when that moved (GH #1225: every tick asks, and a
    // quiet organism's record has nothing new to say), and memory's
    // watermark, which moves on its own, is asked every time.
    fn caught_up(revision: Int) -> Bool {
        if !self.ready() || !self.ensure_open() { return false; }
        if revision != self.knowledge_rev {
            self.knowledge_row = last_knowledge_row(self.repo);
            self.knowledge_rev = revision;
            self.record_reads = self.record_reads + 1;
        }
        return self.store.watermark() >= self.knowledge_row + 1;
    }
    // The record row memory ratified an idea at (GH #995: the idea and its
    // binding fenced to that head), -1 while memory does not hold it
    // ratified — not there, not yet projected, or not reachable, with
    // `last_error` saying which.
    // `self.last_error` holds only the last failure, replaced whole (the old text is
    // retired); the survey cannot prove the new text independent of it.
    @bounded_by(self.last_error)
    fn ratified_at(digest: String) -> Int {
        if !self.ready() { self.last_error = "no memory (" + self.dsn_env + " is not set)"; return -1; }
        if !self.ensure_open() { return -1; }
        self.store.forget_error();
        let s = self.store.idea(digest);
        if !s.present || !s.idea.accepted { self.last_error = "memory does not hold " + digest + " ratified yet"; return -1; }
        return s.ratified_seq;
    }
    // The graph's routing perspective (GH #1089): what a Review's route is
    // computed over, "" when memory is not there or does not answer.
    fn routing() -> String {
        if !self.ready() || !self.ensure_open() { return ""; }
        self.store.forget_error();
        return self.store.graph_perspective("routing");
    }
    // The record's rows the graph does not hold yet (0 when it is current),
    // -1 when memory is not there or does not answer.
    fn projection_lag() -> Int {
        if !self.ready() || !self.ensure_open() { return -1; }
        self.store.forget_error();
        return self.store.projection_lag();
    }
    // The graph's ownership (GH #1123): JSON `[node, holder]` pairs of
    // the `holds` edges an organization is in, "" when memory is not there
    // or does not answer.
    fn ownership() -> String {
        if !self.ready() || !self.ensure_open() { return ""; }
        self.store.forget_error();
        return self.store.graph_ownership();
    }
    // The body memory keeps under a hat's digest, "" when none.
    fn hat(digest: String) -> String {
        if !self.ready() || !self.ensure_open() { return ""; }
        return self.store.hat(digest);
    }
}

// ---- protected evidence (GH #606) ------------------------------------------

// Protected bodies as the spine holds them: a customer or confidential
// body is kept in memory alone, sealed under the receipt key, and its
// digest and class are a row. A read names a reader and a purpose, is
// refused unless a `receipt.disclosed` row names both, and is a row either
// way. A redaction is a row before a byte is erased. The rows are the
// Ledger's (`receipt.*`), read with the record's as one journal (GH #1590).
locus MemoryVault {
    params {
        repo: String = ".";
        dsn_env: String = SPINE_DSN_ENV;
        store: PqProtected = PqProtected { };
        j: RoutedJournal = RoutedJournal { };
        erased: String = "\n"; // digests erased by this process, one per line
        opened: Bool = false;
        last_error: String = "";
    }
    birth() {
        self.dsn_env = memory_source(self.repo, self.dsn_env);
        self.over(self.repo);
    }
    // The vault over the record at `repo` (a host learns its root after
    // the vault is built).
    fn over(repo: String) {
        self.repo = repo;
        let dsn = self.dsn_env;
        self.j = RoutedJournal { record: RecordJournal { repo: repo, author: "vault" }, ledger: MemoryLedger { repo: repo, dsn_env: dsn } };
    }
    fn ready() -> Bool { return dsn_set(memory_source(self.repo, self.dsn_env)) && self.store.ready(); }
    fn ensure_open() -> Bool {
        let moved = self.j.refresh();
        let scope = record_scope(self.repo);
        if self.opened && scope == self.store.record() { return true; }
        self.store.use_dsn_env(self.dsn_env);
        self.store.scope(scope);
        if !self.store.open() { self.last_error = self.store.last_error(); return false; }
        self.opened = true;
        return true;
    }
    fn has_row(kind: String, entity: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == kind && e.entity == entity { return true; }
            i = i + 1;
        }
        return false;
    }
    // A `receipt.disclosed` row naming this reader and this purpose.
    fn disclosed(digest: String, reader: String, purpose: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "receipt.disclosed" && e.entity == digest && std::json::find_string_field(e.body, "recipient") == reader && std::json::find_string_field(e.body, "purpose") == purpose { return true; }
            i = i + 1;
        }
        return false;
    }
    // "who: why" of a hold that stands on `digest` ("" when none).
    fn hold_of(digest: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.entity == digest && e.kind == "receipt.held" { out = std::json::find_string_field(e.body, "by") + ": " + std::json::find_string_field(e.body, "why"); }
            if e.entity == digest && e.kind == "receipt.hold_released" { out = ""; }
            i = i + 1;
        }
        return out;
    }
    // "by <who> under <policy>: <why>" of a redaction ("" when none).
    fn redaction_of(digest: String) -> String {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.entity == digest && e.kind == "receipt.redacted" { return "by " + std::json::find_string_field(e.body, "by") + " under " + std::json::find_string_field(e.body, "policy") + ": " + std::json::find_string_field(e.body, "why"); }
            i = i + 1;
        }
        return "";
    }
    // Keep a protected body; its digest, or "" with `last_error`. A body the
    // record says was redacted is not kept again: a replay, a retry or a
    // re-run intake would put erased bytes back behind a record that says
    // they are gone (#636).
    fn keep(text: String, class: String, by: String) -> String {
        self.last_error = "";
        if !protected_class(class) { self.last_error = "class: `" + class + "` is not protected (customer | confidential); a public or internal body is an ordinary git receipt"; return ""; }
        if len(text) == 0 { self.last_error = "text: nothing to keep"; return ""; }
        if !dsn_set(self.dsn_env) { self.last_error = "no memory (" + self.dsn_env + " is not set) to keep protected evidence"; return ""; }
        if !self.store.ready() { self.last_error = self.store.why_not(); return ""; }
        if !self.ensure_open() { return ""; }
        let digest = digest_of(text);
        let redaction = self.redaction_of(digest);
        if len(redaction) > 0 { self.last_error = digest + " was redacted " + redaction + "; a redacted body is not kept again"; return ""; }
        if !self.store.put(digest, class, text, std::time::now()) { self.last_error = "the protected store refused: " + self.store.last_error(); return ""; }
        if !self.has_row("receipt.classified", digest) {
            let rb = std::json::Builder { };
            rb.begin_object();
            rb.string_field("class", class);
            rb.string_field("by", by);
            rb.string_field("store", self.store.kind());
            rb.end_object();
            let x = self.j.append(self.j.revision(), "receipt.classified", digest, rb.result());
            if !x.ok { self.last_error = "the body of " + digest + " is kept, but the record refused its classification (" + x.error + "); file it again"; return ""; }
        }
        return digest;
    }
    // Erase a protected body under a redaction; "" when done, else why. The
    // decision is in the record before a byte is erased, at the revision the
    // hold was read at: a redaction the record cannot hold erases nothing,
    // and one recorded before an interrupted erasure is completed.
    fn erase(digest: String, by: String, why: String, policy: String) -> String {
        if len(by) == 0 || len(why) == 0 || len(policy) == 0 { return "a redaction names who (`by`), why and the policy"; }
        if !self.ensure_open() { return self.last_error; }
        let hold = self.hold_of(digest);
        if len(hold) > 0 { return "held: " + hold + "; redaction waits for the hold's release"; }
        let p = self.store.get(digest);
        let already = self.has_row("receipt.redacted", digest);
        let step = protected_erase_step(p.present, if p.present { "" } else { self.store.last_error() }, already);
        if std::str::starts_with(step, "unread: ") { return "the protected store cannot say whether it keeps " + digest + " (" + step[8..len(step)] + "); nothing was recorded or erased — redact again once it answers"; }
        if step == "already" { return digest + " is already redacted"; }
        if !already {
            let rb = std::json::Builder { };
            rb.begin_object();
            rb.string_field("by", by);
            rb.string_field("why", why);
            rb.string_field("policy", policy);
            rb.string_field("class", if p.present { p.class } else { "" });
            rb.string_field("store", if p.present { self.store.kind() } else { "none (the body was not kept here)" });
            rb.end_object();
            let x = self.j.append_exact(self.j.revision(), "receipt.redacted", digest, rb.result());
            if !x.ok { return "the redaction of " + digest + " could not be recorded (" + x.error + "); nothing was erased"; }
        }
        if p.present && !self.store.erase(digest) { return "the redaction of " + digest + " is recorded, but the protected store could not erase it: " + self.store.last_error() + "; a read answers redacted already, and redacting again erases it"; }
        return "";
    }
    // Erase every body the record redacted and memory still holds (a head
    // records the redaction; the spine erases on its tick). The number
    // erased, or -1 with `last_error` when memory could not be read.
    // `erased` gains a line per redaction of the record.
    @bounded_by(self.j)
    fn complete_redactions() -> Int {
        if !self.ensure_open() { return -1; }
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            i = i + 1;
            if e.kind != "receipt.redacted" { continue; }
            if std::str::contains(self.erased, "\n" + e.entity + "\n") { continue; }
            if len(self.hold_of(e.entity)) > 0 { continue; }
            // erased through memory's function whether a body is kept or not:
            // the digest is kept, so a body redacted before it was ever filed
            // is refused if a head files it later
            let p = self.store.get(e.entity);
            if !self.store.erase(e.entity) { self.last_error = self.store.last_error(); return -1; }
            self.erased = self.erased + e.entity + "\n";
            if p.present { n = n + 1; }
        }
        return n;
    }
    // A read in a reader's name, for a purpose: refused unless disclosed,
    // and a row either way — a read the record cannot hold is not answered,
    // and no byte of the body leaves.
    fn read(digest: String, reader: String, purpose: String) -> VaultRead {
        if len(reader) == 0 || len(purpose) == 0 { return VaultRead { refused: "a read names a reader and a purpose" }; }
        if !dsn_set(self.dsn_env) { return VaultRead { refused: "no memory (" + self.dsn_env + " is not set)" }; }
        if !self.ensure_open() { return VaultRead { refused: self.last_error }; }
        let redaction = self.redaction_of(digest);
        if len(redaction) > 0 { return VaultRead { refused: digest + " was redacted: " + redaction + "; the record keeps its digest, not its body" }; }
        if !self.store.ready() { return VaultRead { refused: self.store.why_not() }; }
        let p = self.store.get(digest);
        if !p.present {
            let err = self.store.last_error();
            return VaultRead { refused: if len(err) > 0 { "the protected store cannot read " + digest + ": " + err } else { "no protected body for " + digest } };
        }
        let rb = std::json::Builder { };
        rb.begin_object();
        rb.string_field("by", reader);
        rb.string_field("purpose", purpose);
        rb.string_field("class", p.class);
        rb.end_object();
        if !self.disclosed(digest, reader, purpose) {
            let x = self.j.append(self.j.revision(), "receipt.read_refused", digest, rb.result());
            return VaultRead { refused: "not disclosed to " + reader + " for " + purpose + ": `hale dna receipt disclose " + digest + " --to " + reader + " --purpose " + purpose + "` authorizes it" };
        }
        let x = self.j.append(self.j.revision(), "receipt.read", digest, rb.result());
        if !x.ok { return VaultRead { refused: "the read of " + digest + " could not be recorded (" + x.error + "); nothing was disclosed" }; }
        return VaultRead { present: true, class: p.class, text: p.text };
    }
}

// ---- the local compose project, one per checkout (GH #1653) -------------

// A checkout's local memory, nerves and senses are compose services of a
// project of its own: two checkouts of one project (two worktrees, two
// clones) never share a container or a volume. The record identity is
// still the genome's, shared by every checkout; only where this
// checkout's local database lives is its own. The project is
// `hale-dna-<seed>-<checkout>`: the seed dna/compose.yaml names
// (`x-hale-dna-seed`), and the first eight hex digits of the sha256 of the
// checkout's real path, so the same checkout finds the same project on
// every run. Its volumes are the project's (`<project>_knowledge-db`, …).
// The host ports it publishes on are the checkout's too, chosen once and
// kept in `.hale/dna/compose.local.yaml`, which git ignores and every
// compose call layers over dna/compose.yaml.
const LOCAL_COMPOSE_FILE: String = ".hale/dna/compose.local.yaml";

// The seed dna/compose.yaml names, "" when there is no file or it names
// none.
fn local_compose_seed(root: String) -> String {
    let text = std::io::fs::read_file(root + "/dna/compose.yaml") or "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::starts_with(line, "x-hale-dna-seed: ") { return trim_nl(line[17..len(line)]); }
    }
    return "";
}

// The checkout's real path (`pwd -P`), `root` itself when it is not one.
fn checkout_path(root: String) -> String {
    let r = run_tool("sh\n-c\ncd -- \"$1\" && pwd -P\nsh\n" + root);
    let real = trim_nl(r.stdout);
    return if r.code == 0 && len(real) > 0 { real } else { root };
}

// The checkout's compose project, "" when dna/compose.yaml names no seed.
fn local_compose_project(root: String) -> String {
    let seed = local_compose_seed(root);
    if len(seed) == 0 { return ""; }
    return "hale-dna-" + seed + "-" + hex(std::crypto::sha256(std::bytes::from_string(checkout_path(root))))[0..8];
}

// A free loopback port for `service` of `project`: candidates from the
// project's own hash within `base`..`base`+999, the first that binds.
fn local_compose_port(project: String, service: String, base: Int) -> Int {
    let h = std::crypto::sha256(std::bytes::from_string(project + "/" + service));
    let start = ((std::bytes::at(h, 0) or 0) * 256 + (std::bytes::at(h, 1) or 0)) % 1000;
    let mut i = 0;
    while i < 1000 {
        let port = base + (start + i) % 1000;
        let fd = std::io::tcp::__listen_socket("127.0.0.1", port);
        if fd >= 0 { std::io::tcp::__close_fd(fd); return port; }
        i = i + 1;
    }
    return base + start;
}

// `docker compose` on the checkout's project, newline-separated, with its
// ports' file made the first time: the arguments go after it. "" when
// dna/compose.yaml names no seed.
fn local_compose(root: String) -> String {
    let project = local_compose_project(root);
    if len(project) == 0 { return ""; }
    let ports = root + "/" + LOCAL_COMPOSE_FILE;
    if !std::io::fs::file_exists(ports) {
        std::io::fs::mkdir(root + "/.hale") or discard;
        std::io::fs::mkdir(root + "/.hale/dna") or discard;
        let text = "# The host ports this checkout's compose project publishes on (GH #1653),\n"
            + "# chosen once: the checkout's own, never committed.\n"
            + "services:\n"
            + "  knowledge-db:\n    ports: [\"127.0.0.1:" + to_string(local_compose_port(project, "knowledge-db", 54000)) + ":5432\"]\n"
            + "  nerves:\n    ports: [\"127.0.0.1:" + to_string(local_compose_port(project, "nerves", 42000)) + ":4222\"]\n"
            + "  senses:\n    ports: [\"127.0.0.1:" + to_string(local_compose_port(project, "senses", 39000)) + ":9090\"]\n";
        std::io::fs::write_file(ports, text) or discard;
    }
    // by the checkout's real path, which compose records as the project's
    // working directory (`com.docker.compose.project.working_dir`)
    let real = checkout_path(root);
    return "docker\ncompose\n-p\n" + project + "\n-f\n" + real + "/dna/compose.yaml\n-f\n" + real + "/" + LOCAL_COMPOSE_FILE;
}
