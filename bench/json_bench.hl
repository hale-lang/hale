// json_bench — the generated struct codecs, under `hale bench`.
//
// One order record with a nested list, encoded with `Order::to_json`
// and decoded with `Order::from_json` (the single-pass, schema-specialized
// parser). Run with `hale bench bench/json_bench.hl`; it reports ns/op
// and allocs/op for each.

type Line {
    sku: String `json:"sku"`;
    qty: Int `json:"qty"`;
    price: Int `json:"price"`;
}

type Order {
    id: Int `json:"id"`;
    customer: String `json:"customer"`;
    note: String `json:"note"`;
    paid: Bool `json:"paid"`;
    lines: bounded[Line; 8] `json:"lines"`;
}

fn order() -> Order {
    return Order {
        id: 1042,
        customer: "ada@example.org",
        note: "leave at the door, \"side\" entrance",
        paid: true,
        lines: [
            Line { sku: "A-100", qty: 2, price: 1250 },
            Line { sku: "B-220", qty: 1, price: 4999 },
            Line { sku: "C-031", qty: 12, price: 75 },
        ],
    };
}

fn setup_encode() -> Order {
    return order();
}

fn bench_encode(o: Order) {
    let s = Order::to_json(o);
    if len(s) == 0 {
        println("empty");
    }
}

fn setup_decode() -> String {
    return Order::to_json(order());
}

fn bench_decode(s: String) {
    let o = Order::from_json(s) or raise;
    if o.id != 1042 {
        println("wrong");
    }
}
