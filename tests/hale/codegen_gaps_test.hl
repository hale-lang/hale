// GH #1942: shapes `hale check` accepted and `hale build` refused as
// features codegen had not learned, now compiled. Each runs here and its
// result is asserted:
//
// - a call through the fn value any callee expression evaluates to: a
//   call's result (`pick()(2)`), a method call's, an array element, a
//   tuple part, an `if` that picks one;
// - zero-length arrays: `[x; 0]`, a `[T; 0]` parameter, and `[]` as the
//   value of a `let` that declares its type;
// - a `StringView` returned through an interface, a perspective and a
//   fn value (any value type crosses a dispatch now, not only an
//   integer, a float or a pointer);
// - a generic fn specialized at a locus, an interface, `Bytes` or `U256`;
// - a compound assignment to an element of a locus's array field
//   (`self.xs[i] += n`).

fn dbl(n: Int) -> Int { return n * 2; }
fn tri(n: Int) -> Int { return n * 3; }

fn pick(big: Bool) -> fn(Int) -> Int {
    if big { return tri; }
    return dbl;
}

locus Picker {
    params { big: Bool = false; }
    fn get() -> fn(Int) -> Int { return pick(self.big); }
}

fn count_of(xs: [Int; 0]) -> Int { return len(xs); }

interface Source { fn text() -> StringView; }

perspective Viewer { fn text() -> StringView; }

locus Holder : serves Viewer {
    params { b: std::bytes::BytesBuilder = std::bytes::BytesBuilder { }; }
    fn put(s: String) { self.b.append_str(s); }
    fn text() -> StringView { return self.b.text_view(); }
}

fn through_interface(s: Source) -> String { return std::str::clone(s.text()); }

fn view_of(b: std::bytes::BytesBuilder) -> StringView { return b.text_view(); }

locus Watcher {
    params { v: perspective(Viewer) = Holder { }; }
    fn size() -> Int { return len(self.v.text()); }
}

fn id<T>(x: T) -> T { return x; }

locus Counter { params { n: Int = 7; } }

interface Named { fn name() -> String; }
locus Dog { fn name() -> String { return "rex"; } }

fn name_of(n: Named) -> String {
    let same = id(n);
    return same.name();
}

locus Ladder {
    params { xs: [Int; 3] = [1, 2, 3]; fs: [Float; 2] = [1.5, 2.0]; ss: [String; 2] = ["a", "b"]; }
    fn bump() {
        self.xs[1] += 5;
        self.xs[2] *= 3;
        self.xs[0] -= 1;
        self.fs[0] *= 2.0;
        self.ss[1] += "c";
    }
}

fn main() {
    // calls through a computed fn value
    std::test::assert_eq_int(pick(false)(2), 4, "a call's result is called");
    std::test::assert_eq_int(pick(true)(2), 6, "a call's result is called (the other fn)");
    let p = Picker { big: true };
    std::test::assert_eq_int(p.get()(5), 15, "a method call's result is called");
    let fs = [dbl, tri];
    std::test::assert_eq_int(fs[1](4), 12, "an array element is called");
    let pair = (tri, 1);
    std::test::assert_eq_int(pair.0(4), 12, "a tuple part is called");
    let c = false;
    std::test::assert_eq_int((if c { dbl } else { tri })(5), 15, "an `if` that picks a fn is called");
    pick(true)(1);

    // zero-length arrays
    let none = [7; 0];
    std::test::assert_eq_int(len(none), 0, "[x; 0] has no element");
    std::test::assert_eq_int(count_of([9; 0]), 0, "a [T; 0] parameter");
    let empty: [String; 0] = [];
    std::test::assert_eq_int(len(empty), 0, "[] under a declared type");
    let mut seen = 0;
    for x in none { seen = seen + x; }
    std::test::assert_eq_int(seen, 0, "a loop over [x; 0] runs no iteration");
    std::test::assert_eq_str(to_string(none), "[]", "[x; 0] renders as []");

    // a view returned through a dispatch
    let h = Holder { };
    h.put("abc");
    std::test::assert_eq_str(through_interface(h), "abc", "a StringView through an interface");
    let b = std::bytes::BytesBuilder { };
    b.append_str("xyz");
    let f: fn(std::bytes::BytesBuilder) -> StringView = view_of;
    std::test::assert_eq_int(len(f(b)), 3, "a StringView through a fn value");
    let w = Watcher { };
    std::test::assert_eq_int(w.size(), 0, "a StringView through a perspective");

    // a generic fn at a locus, an interface and the wider primitives
    let k = id(Counter { n: 3 });
    std::test::assert_eq_int(k.n, 3, "a generic fn at a locus");
    std::test::assert_eq_str(name_of(Dog { }), "rex", "a generic fn at an interface");
    let bytes = id(std::bytes::from_string("four"));
    std::test::assert_eq_int(len(bytes), 4, "a generic fn at Bytes");
    let big = id(U256::from_int(42));
    std::test::assert_eq_str(to_string(big), "42", "a generic fn at U256");

    // a compound assignment to an element of a locus's array field
    let l = Ladder { };
    l.bump();
    std::test::assert_eq_int(l.xs[0], 0, "self.xs[0] -= 1");
    std::test::assert_eq_int(l.xs[1], 7, "self.xs[1] += 5");
    std::test::assert_eq_int(l.xs[2], 9, "self.xs[2] *= 3");
    std::test::assert(l.fs[0] == 3.0, "self.fs[0] *= 2.0");
    std::test::assert_eq_str(l.ss[1], "bc", "self.ss[1] += \"c\"");
}
