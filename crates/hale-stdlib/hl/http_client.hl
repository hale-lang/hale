// Hale stdlib — std::http client surface (promoted from
// pond/http/client, 2026-07-17).
//
// Outbound HTTP/1.1 for both schemes:
//   - `std::http::get(url)` / `post(url, body, content_type)` /
//     `request(req)` — one-shot free fns, `Connection: close`,
//     read-to-close, the whole call bounded at 30 s (the `Client`'s
//     default `timeout_ms`). `fallible(std::http::HttpError)`.
//   - `std::http::Client` — pooled locus: per-host keep-alive
//     (opt-in), retry-with-backoff, configurable user-agent /
//     body cap.
//   - `std::http::parse_url(s)` — URL decomposition.
//   - `std::http::BodyReader` / `std::http::SseReader` — a response
//     body read as it arrives, as chunks or as Server-Sent Events (the
//     mirror of the Server's `BodyWriter` / `SseWriter`; the last
//     section below).
//
// Client-side types are deliberately DISTINCT from the server
// side: a `ClientRequest` targets a `Url` (the server's `Request`
// carries a parsed request line), and a `ClientResponse` body is
// **Bytes** for binary safety (images, protobuf — embedded NULs
// survive), where the server's `Response` body is String. One
// name-space, two honest shapes.
//
// Placement: on a `where async_io` pool every wait of a call —
// the dial, the TLS handshake, each write and read — parks the
// coroutine, http and https alike; a non-numeric host's name
// lookup still runs on the worker (spec/stdlib.md § std::io::tcp).
//
// `Transfer-Encoding: chunked` bodies are de-chunked on every
// path (one-shot and keep-alive) — `body` is always the payload,
// never the hex-size framing. Trailer headers are skipped.
//
// Not implemented at v1: redirects (3xx returns as-is),
// URL-decoding, proxies, compression.

// A parsed URL. `parse_url` produces one; callers may also build
// one by hand and feed it to `request`. `port` 0 at parse time
// takes the scheme default (80 / 443).
/// A decomposed URL: scheme/host/port/path (query rides in
/// `path`; no userinfo or fragments).
type __StdHttpUrl {
    scheme: String = "http";
    host: String = "";
    port: Int = 80;
    path: String = "/";
}

// One outbound request. Headers are a CRLF-joined block (no
// trailing CRLF) so the wire assembly is a single append; body
// is Bytes for binary safety.
/// Client-side request: method / url / packed headers / Bytes
/// body. Distinct from the server-side Request on purpose.
type __StdHttpClientRequest {
    method: String = "GET";
    url: std::http::Url;
    headers: String = "";
    body: Bytes;
}

// One received response. `headers` is the same packed block
// shape; `body` is exactly the framed payload (or what arrived
// before the peer closed).
/// Client-side response: status / packed headers / Bytes body
/// (binary-safe — embedded NULs survive).
type __StdHttpClientResponse {
    status: Int = 0;
    headers: String = "";
    body: Bytes;
}

// The single error payload for every fallible surface here.
// kinds: bad_url, unsupported_scheme, connect_failed,
// send_failed, recv_failed, bad_response, too_large,
// retries_exhausted. On retries_exhausted, `status`, `headers`
// and `body` are the last 5xx response the retries received (a
// 5xx surfacing through the err arm, its body kept: it used to be
// dropped, and the pooled path dropped the status too); 0 and
// empty when no attempt got a response. `detail` names the last
// attempt's failure.
/// The client's fallible payload. `kind` is one of: bad_url,
/// unsupported_scheme, connect_failed, send_failed, recv_failed,
/// bad_response, too_large, retries_exhausted. A
/// retries_exhausted carries the last 5xx response's `status`,
/// `headers` and `body` (0 / empty when none arrived).
type __StdHttpError {
    kind: String = "";
    status: Int = 0;
    detail: String = "";
    headers: String = "";
    body: Bytes = b"";
}

// The error a retry loop fails with once its attempts are spent:
// the last 5xx response it saw (`resp.status` 0 when none) and the
// last attempt's failure.
fn __http_retries_exhausted(
    resp: std::http::ClientResponse,
    detail: String
) -> std::http::HttpError {
    return std::http::HttpError {
        kind: "retries_exhausted",
        status: resp.status,
        detail: detail,
        headers: resp.headers,
        body: resp.body
    };
}

// ---- URL parsing -----------------------------------------------------

fn __http_default_port(scheme: String) -> Int {
    if scheme == "http" { return 80; }
    if scheme == "https" { return 443; }
    return 0;
}

// `std::http::parse_url(s)` — scheme + host + optional :port +
// optional path (query string rides in `path`; that's all a
// request line needs). `//host/path` is tolerated as http.
// Rejects bare paths, missing host, malformed port. An IPv6
// literal host is bracketed (`http://[::1]:9107/x`); `host` is
// the address without its brackets (`::1`), which is what
// `std::io::tcp::connect` takes, and the request's `Host` header
// brackets it again.
/// Decompose a URL string; fails with HttpError{bad_url} on
/// malformed input.
fn __http_parse_url(s: String) -> std::http::Url fallible(std::http::HttpError) {
    let total = len(s);
    if total <= 0 {
        fail std::http::HttpError { kind: "bad_url", status: 0, detail: "empty url" };
    }
    let scheme_sep = std::str::index_of(s, "://");
    let mut scheme = "http";
    let mut after_scheme_idx = 0;
    if scheme_sep >= 0 {
        scheme = s[0..scheme_sep];
        after_scheme_idx = scheme_sep + 3;
    } else {
        let lead = std::str::index_of(s, "//");
        if lead == 0 {
            after_scheme_idx = 2;
        } else {
            fail std::http::HttpError { kind: "bad_url", status: 0, detail: "missing scheme://" };
        }
    }
    if after_scheme_idx >= total {
        fail std::http::HttpError { kind: "bad_url", status: 0, detail: "missing host" };
    }
    let tail = s[after_scheme_idx..total];
    let tail_len = len(tail);
    let path_sep = std::str::index_of(tail, "/");
    let mut authority = "";
    let mut path = "/";
    if path_sep < 0 {
        authority = tail;
    } else {
        authority = tail[0..path_sep];
        path = tail[path_sep..tail_len];
    }
    if len(authority) <= 0 {
        fail std::http::HttpError { kind: "bad_url", status: 0, detail: "empty authority" };
    }
    let auth_len = len(authority);
    let mut host = authority;
    let mut port = __http_default_port(scheme);
    // the port's text after the host: "" for none, else ":<port>"
    let mut rest = "";
    if authority[0..1] == "[" {
        // an IPv6 literal is bracketed (`[::1]`, `[fe80::1%eth0]`); the
        // host is what the brackets hold, and only a port may follow them
        let close = std::str::index_of(authority, "]");
        if close < 0 {
            fail std::http::HttpError {
                kind: "bad_url",
                status: 0,
                detail: "an IPv6 host's [ is never closed",
            };
        }
        host = authority[1..close];
        rest = authority[(close + 1)..auth_len];
        if len(rest) > 0 && rest[0..1] != ":" {
            fail std::http::HttpError {
                kind: "bad_url",
                status: 0,
                detail: "only a :port may follow an IPv6 host's ]",
            };
        }
        if std::str::index_of(host, ":") < 0 {
            fail std::http::HttpError {
                kind: "bad_url",
                status: 0,
                detail: "brackets hold an IPv6 address",
            };
        }
    } else {
        let port_sep = std::str::index_of(authority, ":");
        if port_sep >= 0 {
            host = authority[0..port_sep];
            rest = authority[port_sep..auth_len];
        }
    }
    if len(rest) > 0 {
        let port_str = rest[1..len(rest)];
        port = std::str::parse_int(port_str) or 0;
        if port <= 0 || port > 65535 {
            fail std::http::HttpError { kind: "bad_url", status: 0, detail: "bad port" };
        }
    }
    if len(host) <= 0 {
        fail std::http::HttpError { kind: "bad_url", status: 0, detail: "empty host" };
    }
    return std::http::Url { scheme: scheme, host: host, port: port, path: path };
}

// ---- raw-handle transport (TCP fd vs TLS handle) --------------------
//
// Both substrates address connections by Int; `is_tls` routes.
// These operate on the RAW handle with no auto-close — the
// keep-alive pool owns fd lifecycles across round-trips.

fn __http_send_raw(handle: Int, is_tls: Bool, b: Bytes) -> Int {
    if is_tls { return std::io::tls::send_bytes(handle, b); }
    return std::io::tcp::__send_bytes(handle, b);
}

fn __http_recv_raw(handle: Int, is_tls: Bool, max_bytes: Int) -> Bytes {
    if is_tls { return std::io::tls::recv_bytes(handle, max_bytes); }
    return std::io::tcp::__recv_bytes(handle, max_bytes);
}

fn __http_close_handle(handle: Int, is_tls: Bool) {
    if handle < 0 { return; }
    if is_tls { std::io::tls::close(handle); } else { std::io::tcp::__close_fd(handle); }
}

// ---- the call's deadline ---------------------------------------------
//
// `timeout_ms` bounds a call whole: the dial, the writes and the reads
// of the headers and the body, every attempt and the backoff between
// them. It is one monotonic instant (ns), 0 for none. Each write and
// each read is armed with what is left of it (SO_SNDTIMEO / SO_RCVTIMEO,
// which an async_io pool's park mirrors), so a server that accepts and
// then holds the response ends the call at the deadline: it used to
// bound only the dial, and a request against a server holding each
// response 30 s took 120 s through the default three retries.

fn __http_deadline(timeout_ms: Int) -> Int {
    if timeout_ms <= 0 { return 0; }
    return std::time::monotonic_ns() + timeout_ms * 1000000;
}

// Whether `deadline` has passed (never, for none).
fn __http_expired(deadline: Int) -> Bool {
    return deadline != 0 && std::time::monotonic_ns() >= deadline;
}

// What is left before `deadline` in ms, for a dial: at least 1 while
// it has not passed; 0 for none.
fn __http_left_ms(deadline: Int) -> Int {
    if deadline == 0 { return 0; }
    let left = (deadline - std::time::monotonic_ns()) / 1000000;
    return if left < 1 { 1 } else { left };
}

// Arm `handle`'s write and read waits with what is left before
// `deadline`; false once it has passed. No deadline arms nothing.
fn __http_arm(handle: Int, is_tls: Bool, deadline: Int) -> Bool {
    if deadline == 0 { return true; }
    let left = deadline - std::time::monotonic_ns();
    if left <= 0 { return false; }
    if is_tls {
        std::io::tls::set_recv_timeout(handle, left * 1ns) or discard;
        std::io::tls::set_send_timeout(handle, left * 1ns) or discard;
    } else {
        std::io::tcp::set_recv_timeout(handle, left * 1ns) or discard;
        std::io::tcp::set_send_timeout(handle, left * 1ns) or discard;
    }
    return true;
}

// Clear what `__http_arm` set, for a connection going back to the pool.
fn __http_disarm(handle: Int, is_tls: Bool, deadline: Int) {
    if deadline == 0 { return; }
    if is_tls {
        std::io::tls::set_recv_timeout(handle, 0ns) or discard;
        std::io::tls::set_send_timeout(handle, 0ns) or discard;
    } else {
        std::io::tcp::set_recv_timeout(handle, 0ns) or discard;
        std::io::tcp::set_send_timeout(handle, 0ns) or discard;
    }
}

// A read within `deadline`: empty once it has passed, as at EOF; the
// caller tells the two apart with `__http_expired`. A plain read is one
// recv, which the armed SO_RCVTIMEO bounds; a TLS read may take several
// to assemble a record, each of which a blocking socket would re-arm, so
// it gets the deadline itself.
fn __http_recv_within(handle: Int, is_tls: Bool, max_bytes: Int, deadline: Int) -> Bytes {
    if !__http_arm(handle, is_tls, deadline) { return b""; }
    if is_tls { return std::io::tls::__recv_bytes_until(handle, max_bytes, deadline); }
    return __http_recv_raw(handle, is_tls, max_bytes);
}

// A write within `deadline`: -1 once it has passed. The send gets the
// deadline itself: SO_SNDTIMEO is a stall window that restarts on every
// partial write, so a peer accepting a little at a time held a large
// body past any window armed before it.
fn __http_send_within(handle: Int, is_tls: Bool, b: Bytes, deadline: Int) -> Int {
    if !__http_arm(handle, is_tls, deadline) { return -1; }
    if is_tls { return std::io::tls::__send_bytes_until(handle, b, deadline); }
    return std::io::tcp::__send_bytes_until(handle, b, deadline);
}

// What a call its deadline ended says.
fn __http_timeout_detail(host: String, port: Int, timeout_ms: Int) -> String {
    return host + ":" + to_string(port) + " timeout: no complete response within "
        + to_string(timeout_ms) + " ms";
}

// Connect + TCP_NODELAY (Nagle costs up to ~40ms on small
// writes). `timeout_ms` bounds the dial — the TCP connect and, for
// https, the TLS handshake — and `0` leaves it unbounded.
fn __http_dial_nd(host: String, port: Int, is_tls: Bool, timeout_ms: Int) -> Int fallible(IoError) {
    if is_tls {
        let h = std::io::tls::connect_within(host, port, timeout_ms * 1ms) or raise;
        std::io::tls::set_nodelay(h, true) or discard;
        return h;
    }
    let fd = std::io::tcp::connect_within(host, port, timeout_ms * 1ms) or raise;
    std::io::tcp::set_nodelay(fd, true) or discard;
    return fd;
}

// What a failed dial says: the IoError's kind, and for a dial the
// deadline ended, the deadline.
fn __http_connect_detail(e: IoError, timeout_ms: Int) -> String {
    if e.kind == "timeout" {
        return "timeout: no connection within " + to_string(timeout_ms) + " ms";
    }
    return e.kind;
}

// Auto-closing one-shot wrapper: dissolve closes the handle at
// fn-exit — right for the free-fn surface, wrong for pooled fds
// (which use the raw-handle fns above).
locus __StdHttpConn {
    params {
        handle: Int = -1;
        is_tls: Bool = false;
    }
    fn send_bytes(b: Bytes) -> Int {
        return __http_send_raw(self.handle, self.is_tls, b);
    }
    fn recv_bytes(max_bytes: Int) -> Bytes {
        return __http_recv_raw(self.handle, self.is_tls, max_bytes);
    }
    dissolve() {
        __http_close_handle(self.handle, self.is_tls);
    }
}

// ---- wire format -----------------------------------------------------

// A host as an authority writes it: an IPv6 address (it holds a `:`)
// bracketed, anything else as it is.
fn __http_host_text(host: String) -> String {
    if std::str::index_of(host, ":") >= 0 && !std::str::starts_with(host, "[") {
        return "[" + host + "]";
    }
    return host;
}

// Assemble the request header block. Body ships as a separate
// trailing send. ASCII throughout, so String concat is safe.
fn __http_build_request_headers(
    req: std::http::ClientRequest,
    user_agent: String,
    keep_alive: Bool
) -> String {
    let host_header = "Host: " + __http_host_text(req.url.host) + ":" + to_string(req.url.port)
        + "\r\n";
    let ua_header = "User-Agent: " + user_agent + "\r\n";
    let cl_header = "Content-Length: " + to_string(len(req.body)) + "\r\n";
    let conn_header = if keep_alive {
        "Connection: keep-alive\r\n"
    } else {
        "Connection: close\r\n"
    };
    let request_line = req.method + " " + req.url.path + " HTTP/1.1\r\n";
    let mut user_headers = "";
    if len(req.headers) > 0 {
        user_headers = req.headers + "\r\n";
    }
    return request_line + host_header + ua_header + cl_header + conn_header + user_headers + "\r\n";
}

// Header lookup with whitespace-trimmed value. Reuses http.hl's
// case-insensitive block walker (the same shape serves Request /
// Response / client headers); the trim guards `parse_int` on
// values like Content-Length.
fn __http_client_header(headers: String, name: String) -> String {
    return std::str::trim(__http_find_header_in_block(headers, name));
}

// Parse "HTTP/1.1 NNN PHRASE" → code, or -1 malformed.
fn __http_parse_status(line: String) -> Int {
    let line_len = len(line);
    if line_len < 12 { return -1; }
    let sp1 = std::str::index_of(line, " ");
    if sp1 < 0 { return -1; }
    let after = line[(sp1 + 1)..line_len];
    let sp2 = std::str::index_of(after, " ");
    let mut code_str = after;
    if sp2 >= 0 { code_str = after[0..sp2]; }
    return std::str::parse_int(code_str) or - 1;
}

fn __http_empty_client_response() -> std::http::ClientResponse {
    return std::http::ClientResponse { status: 0, headers: "", body: b"" };
}

// Split a received blob into status + headers + body. Headers
// parse through the String view (ASCII-safe); the body is carved
// from the Bytes by offset so binary content survives. A
// `Transfer-Encoding: chunked` body is de-chunked here — the
// caller always sees the payload, never the hex-size framing —
// and incomplete/malformed chunk framing parses as status=0
// (callers treat as bad_response) rather than partial data.
fn __http_parse_client_response(raw: Bytes) -> std::http::ClientResponse {
    let raw_len = len(raw);
    if raw_len <= 0 { return __http_empty_client_response(); }
    let raw_str = std::str::from_bytes(raw);
    let header_end = std::str::index_of(raw_str, "\r\n\r\n");
    if header_end < 0 { return __http_empty_client_response(); }
    let line_end = std::str::index_of(raw_str, "\r\n");
    if line_end < 0 || line_end > header_end { return __http_empty_client_response(); }
    let status = __http_parse_status(raw_str[0..line_end]);
    if status < 0 { return __http_empty_client_response(); }
    let mut headers = "";
    let headers_start = line_end + 2;
    if headers_start < header_end {
        headers = raw_str[headers_start..header_end];
    }
    let body_start = header_end + 4;
    let mut body = b"";
    let te = std::str::lower(__http_client_header(headers, "transfer-encoding"));
    if std::str::index_of(te, "chunked") >= 0 {
        let sc = __http_scan_chunks(raw, body_start, raw_len);
        if !sc.complete { return __http_empty_client_response(); }
        body = sc.body;
    } else if body_start < raw_len {
        body = std::bytes::slice(raw, body_start, raw_len);
    }
    return std::http::ClientResponse { status: status, headers: headers, body: body };
}

// Drain a one-shot connection to close (or max_total).
fn __http_recv_to_close(s: __StdHttpConn, max_total: Int, deadline: Int) -> Bytes {
    let chunk_size = 8192;
    let mut total = 0;
    let buf = std::bytes::BytesBuilder { initial_cap: 4096 };
    while total < max_total {
        let want = max_total - total;
        let mut take = chunk_size;
        if want < take { take = want; }
        let piece = __http_recv_within(s.handle, s.is_tls, take, deadline);
        let n = len(piece);
        if n <= 0 { return buf.snapshot() or raise; }
        buf.append(piece);
        total = total + n;
    }
    return buf.snapshot() or raise;
}

// One one-shot round-trip on an auto-closing conn.
fn __http_exchange_oneshot(
    s: __StdHttpConn,
    req: std::http::ClientRequest,
    user_agent: String,
    max_body: Int,
    deadline: Int
) -> std::http::ClientResponse {
    let header_block = __http_build_request_headers(req, user_agent, false);
    __http_send_within(s.handle, s.is_tls, std::bytes::from_string(header_block), deadline);
    if len(req.body) > 0 {
        __http_send_within(s.handle, s.is_tls, req.body, deadline);
    }
    let raw = __http_recv_to_close(s, max_body, deadline);
    return __http_parse_client_response(raw);
}

// ---- keep-alive framing ---------------------------------------------

// Index of "\r\n\r\n" in a Bytes blob; -1 absent.
fn __http_find_hdr_end(raw: Bytes) -> Int {
    let n = len(raw);
    let mut i = 0;
    while i + 3 < n {
        let a = std::bytes::at(raw, i) or - 1;
        if a == 13 {
            let b = std::bytes::at(raw, i + 1) or - 1;
            let c = std::bytes::at(raw, i + 2) or - 1;
            let d = std::bytes::at(raw, i + 3) or - 1;
            if b == 10 && c == 13 && d == 10 { return i; }
        }
        i = i + 1;
    }
    return -1;
}

// Next CRLF at/after `from`, bounded by `end`; -1 none.
fn __http_crlf_at(raw: Bytes, from: Int, end: Int) -> Int {
    let mut i = from;
    while i + 1 < end {
        let a = std::bytes::at(raw, i) or - 1;
        let b = std::bytes::at(raw, i + 1) or - 1;
        if a == 13 && b == 10 { return i; }
        i = i + 1;
    }
    return -1;
}

// Hex chunk-size in [lo, hi), stopping at ';' (chunk-ext) or
// space; -1 if no hex digits.
fn __http_hex_size(raw: Bytes, lo: Int, hi: Int) -> Int {
    let mut v = 0;
    let mut i = lo;
    let mut any = false;
    while i < hi {
        let ch = std::bytes::at(raw, i) or - 1;
        if ch == 59 || ch == 32 { break; }
        let mut dgt = -1;
        if ch >= 48 && ch <= 57 { dgt = ch - 48; }
        else if ch >= 97 && ch <= 102 { dgt = ch - 87; }
        else if ch >= 65 && ch <= 70 { dgt = ch - 55; }
        if dgt < 0 { break; }
        v = v * 16 + dgt;
        any = true;
        i = i + 1;
    }
    if !any { return -1; }
    return v;
}

type __StdHttpChunkScan { body: Bytes; complete: Bool; bad: Bool; }

// De-chunk [start, end). complete once the 0-size terminator AND
// its trailer section (optional trailer headers + final CRLF) are
// seen; bad=true means the framing is malformed (not "need more
// wire bytes") — callers must error, never return partial data.
fn __http_scan_chunks(raw: Bytes, start: Int, end: Int) -> __StdHttpChunkScan {
    let out = std::bytes::BytesBuilder { initial_cap: 4096 };
    let mut pos = start;
    while pos < end {
        let nl = __http_crlf_at(raw, pos, end);
        if nl < 0 { return __StdHttpChunkScan { body: b"", complete: false, bad: false }; }
        let size = __http_hex_size(raw, pos, nl);
        if size < 0 { return __StdHttpChunkScan { body: b"", complete: false, bad: true }; }
        if size == 0 {
            // Terminator chunk: skip trailer headers (ignored),
            // then the blank line that ends the message.
            let mut tpos = nl + 2;
            while tpos < end {
                let tnl = __http_crlf_at(raw, tpos, end);
                if tnl < 0 { return __StdHttpChunkScan { body: b"", complete: false, bad: false }; }
                if tnl == tpos {
                    return __StdHttpChunkScan {
                        body: out.snapshot() or raise,
                        complete: true,
                        bad: false,
                    };
                }
                tpos = tnl + 2;
            }
            return __StdHttpChunkScan { body: b"", complete: false, bad: false };
        }
        let data_start = nl + 2;
        let data_end = data_start + size;
        if data_end + 2 > end {
            return __StdHttpChunkScan { body: b"", complete: false, bad: false };
        }
        let ca = std::bytes::at(raw, data_end) or - 1;
        let cb = std::bytes::at(raw, data_end + 1) or - 1;
        if ca != 13 || cb != 10 {
            return __StdHttpChunkScan { body: b"", complete: false, bad: true };
        }
        out.append(std::bytes::slice(raw, data_start, data_end));
        pos = data_end + 2;
    }
    return __StdHttpChunkScan { body: b"", complete: false, bad: false };
}

type __StdHttpFramedRead { bytes: Bytes; framed: Bool; }

// Read exactly ONE response off a keep-alive connection, framed
// by Content-Length or chunked. framed=true ⇒ stopped cleanly at
// the boundary (connection reusable); framed=false ⇒ EOF/close
// or unframable (fall back to read-to-close semantics).
fn __http_recv_framed(
    handle: Int,
    is_tls: Bool,
    max_body: Int,
    deadline: Int
) -> __StdHttpFramedRead {
    let chunk = 8192;
    let buf = std::bytes::BytesBuilder { initial_cap: 4096 };
    let mut total = 0;
    let mut full = b"";
    let mut hdr_end = -1;

    while total < max_body {
        let take = if (max_body - total) < chunk { max_body - total } else { chunk };
        let piece = __http_recv_within(handle, is_tls, take, deadline);
        let n = len(piece);
        if n <= 0 { return __StdHttpFramedRead { bytes: buf.snapshot() or raise, framed: false }; }
        buf.append(piece);
        total = total + n;
        full = buf.snapshot() or raise;
        hdr_end = __http_find_hdr_end(full);
        if hdr_end >= 0 { break; }
    }
    if hdr_end < 0 { return __StdHttpFramedRead { bytes: full, framed: false }; }

    let headers_str = std::str::from_bytes(std::bytes::slice(full, 0, hdr_end));
    let body_start = hdr_end + 4;

    let te = std::str::lower(__http_client_header(headers_str, "transfer-encoding"));
    if std::str::index_of(te, "chunked") >= 0 {
        while total < max_body {
            let sc = __http_scan_chunks(full, body_start, total);
            // Raw bytes go back whole — __http_parse_client_response
            // de-chunks. framed=true ⇒ terminator + trailers seen.
            if sc.complete {
                return __StdHttpFramedRead { bytes: full, framed: true };
            }
            if sc.bad {
                return __StdHttpFramedRead { bytes: full, framed: false };
            }
            let take = if (max_body - total) < chunk { max_body - total } else { chunk };
            let piece = __http_recv_within(handle, is_tls, take, deadline);
            let n = len(piece);
            if n <= 0 { return __StdHttpFramedRead { bytes: full, framed: false }; }
            buf.append(piece);
            total = total + n;
            full = buf.snapshot() or raise;
        }
        return __StdHttpFramedRead { bytes: full, framed: false };
    }

    let cl = __http_client_header(headers_str, "content-length");
    if len(cl) > 0 {
        let clen = std::str::parse_int(cl) or 0;
        let need = body_start + clen;
        while total < need && total < max_body {
            let want = need - total;
            let take = if want < chunk { want } else { chunk };
            let piece = __http_recv_within(handle, is_tls, take, deadline);
            let n = len(piece);
            if n <= 0 {
                return __StdHttpFramedRead { bytes: buf.snapshot() or raise, framed: false };
            }
            buf.append(piece);
            total = total + n;
        }
        full = buf.snapshot() or raise;
        let end = if need < total { need } else { total };
        return __StdHttpFramedRead {
            bytes: std::bytes::slice(full, 0, end),
            framed: total >= need,
        };
    }

    while total < max_body {
        let take = if (max_body - total) < chunk { max_body - total } else { chunk };
        let piece = __http_recv_within(handle, is_tls, take, deadline);
        let n = len(piece);
        if n <= 0 { break; }
        buf.append(piece);
        total = total + n;
    }
    return __StdHttpFramedRead { bytes: buf.snapshot() or raise, framed: false };
}

type __StdHttpExchangeResult { resp: std::http::ClientResponse; ok: Bool; reusable: Bool; }

// One keep-alive round-trip on a raw handle (no auto-close).
// reusable ⇒ cleanly framed AND the peer didn't say
// `Connection: close`.
fn __http_exchange_on_handle(
    handle: Int,
    is_tls: Bool,
    req: std::http::ClientRequest,
    ua: String,
    max_body: Int,
    deadline: Int
) -> __StdHttpExchangeResult {
    let header_block = __http_build_request_headers(req, ua, true);
    let sent = __http_send_within(handle, is_tls, std::bytes::from_string(header_block), deadline);
    if sent < 0 {
        return __StdHttpExchangeResult {
            resp: __http_empty_client_response(),
            ok: false,
            reusable: false,
        };
    }
    if len(req.body) > 0 {
        let bs = __http_send_within(handle, is_tls, req.body, deadline);
        if bs < 0 {
            return __StdHttpExchangeResult {
                resp: __http_empty_client_response(),
                ok: false,
                reusable: false,
            };
        }
    }
    let fr = __http_recv_framed(handle, is_tls, max_body, deadline);
    // a read the deadline cut short is no response, however much of
    // one it holds
    if !fr.framed && __http_expired(deadline) {
        return __StdHttpExchangeResult {
            resp: __http_empty_client_response(),
            ok: false,
            reusable: false,
        };
    }
    let resp = __http_parse_client_response(fr.bytes);
    if resp.status <= 0 {
        return __StdHttpExchangeResult { resp: resp, ok: false, reusable: false };
    }
    let conn = std::str::lower(__http_client_header(resp.headers, "connection"));
    let reusable = fr.framed && conn != "close";
    return __StdHttpExchangeResult { resp: resp, ok: true, reusable: reusable };
}

// ---- dial + one-shot round trip -------------------------------------

fn __http_raise_connect(
    e: IoError,
    host: String,
    port: Int,
    timeout_ms: Int
) -> Int fallible(std::http::HttpError) {
    fail std::http::HttpError {
        kind: "connect_failed",
        status: 0,
        detail: host + ":" + to_string(port) + " " + __http_connect_detail(e, timeout_ms)
    };
}

fn __http_check_scheme(scheme: String) -> Int fallible(std::http::HttpError) {
    if scheme == "http" { return 0; }
    if scheme == "https" { return 0; }
    fail std::http::HttpError {
        kind: "unsupported_scheme",
        status: 0,
        detail: scheme + " — only http / https supported"
    };
}

// One-shot exchange: connect, send, recv-to-close, parse. The
// __StdHttpConn's fn-exit dissolve closes the handle. The whole
// exchange ends by `deadline` (0: unbounded); `timeout_ms` is what set
// it, for the message.
fn __http_round_trip_oneshot(
    req: std::http::ClientRequest,
    user_agent: String,
    max_body: Int,
    timeout_ms: Int,
    deadline: Int
) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let host = req.url.host;
    let port = req.url.port;
    let is_tls = req.url.scheme == "https";
    let handle = __http_dial_nd(
        host,
        port,
        is_tls,
        __http_left_ms(deadline),
    ) or __http_raise_connect(err, host, port, timeout_ms);
    let s = __StdHttpConn { handle: handle, is_tls: is_tls };
    let resp = __http_exchange_oneshot(s, req, user_agent, max_body, deadline);
    if __http_expired(deadline) {
        fail std::http::HttpError {
            kind: "recv_failed",
            status: 0,
            detail: __http_timeout_detail(host, port, timeout_ms),
        };
    }
    if resp.status <= 0 {
        fail std::http::HttpError {
            kind: "bad_response",
            status: 0,
            detail: "unparseable response",
        };
    }
    return resp;
}

// Retry wrapper: retries connect/send/recv failures + 5xx with
// backoff; 4xx returns directly (the caller's business). Once the
// attempts are spent it fails with the last 5xx response's status,
// headers and body, and the last attempt's failure in `detail`.
fn __http_round_trip_with_retry(
    req: std::http::ClientRequest,
    user_agent: String,
    max_body: Int,
    max_retries: Int,
    timeout_ms: Int
) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let deadline = __http_deadline(timeout_ms);
    let mut attempt = 0;
    let mut last_5xx = __http_empty_client_response();
    let mut detail = "";
    let max_attempts = max_retries + 1;
    while attempt < max_attempts {
        let mut failure = "";
        let resp = __http_round_trip_oneshot(req, user_agent, max_body, timeout_ms, deadline) or {
            failure = err.kind + " " + err.detail;
            __http_empty_client_response()
        };
        if resp.status > 0 && resp.status < 500 {
            return resp;
        }
        if resp.status >= 500 {
            last_5xx = resp;
            detail = "status " + to_string(resp.status);
        } else {
            detail = failure;
        }
        attempt = attempt + 1;
        // the retries share the call's deadline: none starts once it
        // has passed, nor sleeps past it
        if __http_expired(deadline) { break; }
        if attempt < max_attempts {
            std::time::sleep(50ms);
        }
    }
    fail __http_retries_exhausted(
        last_5xx,
        detail + " after " + to_string(attempt) + " attempt(s)"
    );
}

// ---- free-fn surface (one-shot) -------------------------------------

// The one-shot fns' deadline, 30000 ms, over the whole call: the TCP
// connect and, for https, the TLS handshake, the request's writes and
// the response's reads. 30 s, the pooled Client's default `timeout_ms`,
// so a host that never answers fails `connect_failed` with "timeout: no
// connection within 30000 ms" instead of holding the caller for the
// kernel's ~2 min of SYN retransmits, and one that accepts and never
// answers fails `recv_failed` with "timeout: no complete response
// within 30000 ms". A different deadline is `std::http::Client {
// timeout_ms: …, max_retries: 0 }`, whose default (keep_alive false)
// is the same one-shot exchange. The three fns below pass it as the
// literal 30000.

// `std::http::get(url)`.
/// One-shot GET: connect, send, read to close. `Connection:
/// close`; the dial is bounded at 30 s; https rides std::io::tls,
/// which parks on an async_io pool like plain tcp.
fn __http_client_get(url_str: String) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let u = __http_parse_url(url_str) or raise;
    let _ = __http_check_scheme(u.scheme) or raise;
    let req = std::http::ClientRequest { method: "GET", url: u, headers: "", body: b"" };
    return __http_round_trip_oneshot(
        req,
        "hale-std-http/0.11",
        16777216,
        30000,
        __http_deadline(30000),
    ) or raise;
}

// `std::http::post(url, body, content_type)`.
/// One-shot POST with a body and content type. Same contract as
/// `get`.
fn __http_client_post(
    url_str: String,
    body: Bytes,
    content_type: String
) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let u = __http_parse_url(url_str) or raise;
    let _ = __http_check_scheme(u.scheme) or raise;
    let req = std::http::ClientRequest {
        method: "POST", url: u, headers: "Content-Type: " + content_type, body: body
    };
    return __http_round_trip_oneshot(
        req,
        "hale-std-http/0.11",
        16777216,
        30000,
        __http_deadline(30000),
    ) or raise;
}

// `std::http::request(req)` — full control over method / headers
// / body / a hand-built Url.
/// One-shot arbitrary request (build a ClientRequest yourself).
fn __http_client_request(
    req: std::http::ClientRequest
) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let _ = __http_check_scheme(req.url.scheme) or raise;
    return __http_round_trip_oneshot(
        req,
        "hale-std-http/0.11",
        16777216,
        30000,
        __http_deadline(30000),
    ) or raise;
}

// ---- the pooled Client ----------------------------------------------
//
// The connection pool is a fixed-cap (4-slot) hand-rolled MRU
// over scalar params — deliberately NOT `@form(lru_cache)`: an
// fd-owning cache needs (a) an eviction hook (the evicted fd
// must be CLOSED, not silently dropped — a form eviction would
// leak it) and (b) take-semantics (ownership transfers OUT on
// hit; LRU get keeps the entry). Until the form grows those,
// the hand-rolled pool is the correct shape, and 4 host:port
// slots cover the typical client workload (an API + a couple
// of webhooks).

/// The pooled client: `user_agent`/`timeout_ms`/`max_retries`/
/// `max_body` params; `keep_alive: true` switches to framed
/// reads (Content-Length or chunked) over a 4-slot per-host:port
/// connection pool with retry-and-backoff. `timeout_ms` bounds each
/// call whole: every attempt's dial (the TCP connect and, for https,
/// the handshake), its writes and its reads of the headers and the
/// body, and the retries, which start only while it has not passed;
/// `0` leaves it unbounded. Same fallible get/post/request surface
/// as the free fns.
locus __StdHttpClient {
    params {
        user_agent: String = "hale-std-http/0.11";
        timeout_ms: Int = 30000;
        max_retries: Int = 3;
        max_body: Int = 16777216;

        // Opt-in keep-alive: reuse pooled connections (framed
        // reads + `Connection: keep-alive`). Default false keeps
        // the one-shot `Connection: close` behavior.
        keep_alive: Bool = false;

        // Pool slots. -1 fd = empty; `tls` routes the close.
        pool_fd0: Int = -1; pool_host0: String = ""; pool_port0: Int = 0; pool_tls0: Bool = false;
        pool_fd1: Int = -1; pool_host1: String = ""; pool_port1: Int = 0; pool_tls1: Bool = false;
        pool_fd2: Int = -1; pool_host2: String = ""; pool_port2: Int = 0; pool_tls2: Bool = false;
        pool_fd3: Int = -1; pool_host3: String = ""; pool_port3: Int = 0; pool_tls3: Bool = false;
    }

    fn get(url_str: String) -> std::http::ClientResponse fallible(std::http::HttpError) {
        let u = __http_parse_url(url_str) or raise;
        return self.request(std::http::ClientRequest {
            method: "GET", url: u, headers: "", body: b""
        }) or raise;
    }

    fn post(
        url_str: String,
        body: Bytes,
        content_type: String
    ) -> std::http::ClientResponse fallible(std::http::HttpError) {
        let u = __http_parse_url(url_str) or raise;
        return self.request(std::http::ClientRequest {
            method: "POST", url: u, headers: "Content-Type: " + content_type, body: body
        }) or raise;
    }

    fn request(
        req: std::http::ClientRequest
    ) -> std::http::ClientResponse fallible(std::http::HttpError) {
        let _ = __http_check_scheme(req.url.scheme) or raise;
        if self.keep_alive { return self.__pooled(req) or raise; }
        return __http_round_trip_with_retry(
            req, self.user_agent, self.max_body, self.max_retries, self.timeout_ms
        ) or raise;
    }

    // Keep-alive round-trip: reuse a pooled connection if
    // present (one stale-retry), else dial fresh with backoff.
    // On success the fd returns to the pool when the peer left
    // it open (framed + not `Connection: close`), else closes.
    fn __pooled(
        req: std::http::ClientRequest
    ) -> std::http::ClientResponse fallible(std::http::HttpError) {
        let host = req.url.host;
        let port = req.url.port;
        let is_tls = req.url.scheme == "https";

        let deadline = __http_deadline(self.timeout_ms);
        let pfd = self.__pool_take(host, port, is_tls);
        if pfd >= 0 {
            let ex = __http_exchange_on_handle(
                pfd,
                is_tls,
                req,
                self.user_agent,
                self.max_body,
                deadline,
            );
            if ex.ok {
                if ex.reusable {
                    __http_disarm(pfd, is_tls, deadline);
                    self.__pool_put(host, port, pfd, is_tls);
                }
                else { __http_close_handle(pfd, is_tls); }
                return ex.resp;
            }
            __http_close_handle(pfd, is_tls);
        }

        let mut attempt = 0;
        let max_attempts = self.max_retries + 1;
        let mut last_5xx = __http_empty_client_response();
        let mut detail = "";
        while attempt < max_attempts && !__http_expired(deadline) {
            let fd = __http_dial_nd(host, port, is_tls, __http_left_ms(deadline)) or {
                detail = "connect_failed " + __http_connect_detail(err, self.timeout_ms);
                    -1
            };
            if fd >= 0 {
                let ex = __http_exchange_on_handle(
                    fd,
                    is_tls,
                    req,
                    self.user_agent,
                    self.max_body,
                    deadline,
                );
                if ex.ok && ex.resp.status < 500 {
                    if ex.reusable {
                        __http_disarm(fd, is_tls, deadline);
                        self.__pool_put(host, port, fd, is_tls);
                    }
                    else { __http_close_handle(fd, is_tls); }
                    return ex.resp;
                }
                if ex.ok {
                    last_5xx = ex.resp;
                    detail = "status " + to_string(ex.resp.status);
                } else if __http_expired(deadline) {
                    detail = "timeout: no complete response within " + to_string(self.timeout_ms)
                        + " ms";
                } else {
                    detail = "no response";
                }
                __http_close_handle(fd, is_tls);
            }
            attempt = attempt + 1;
            if attempt < max_attempts && !__http_expired(deadline) { std::time::sleep(50ms); }
        }
        fail __http_retries_exhausted(
            last_5xx,
            host + ":" + to_string(port) + " " + detail + " after " + to_string(attempt)
                + " attempt(s)"
        );
    }

    fn __pool_take(host: String, port: Int, is_tls: Bool) -> Int {
        if self.pool_fd0 >= 0
            && self.pool_host0 == host
            && self.pool_port0 == port
            && self.pool_tls0 == is_tls
        {
            let fd = self.pool_fd0;
            self.pool_fd0 = -1;
            self.pool_host0 = "";
            self.pool_port0 = 0;
            self.pool_tls0 = false;
            return fd;
        }
        if self.pool_fd1 >= 0
            && self.pool_host1 == host
            && self.pool_port1 == port
            && self.pool_tls1 == is_tls
        {
            let fd = self.pool_fd1;
            self.pool_fd1 = -1;
            self.pool_host1 = "";
            self.pool_port1 = 0;
            self.pool_tls1 = false;
            return fd;
        }
        if self.pool_fd2 >= 0
            && self.pool_host2 == host
            && self.pool_port2 == port
            && self.pool_tls2 == is_tls
        {
            let fd = self.pool_fd2;
            self.pool_fd2 = -1;
            self.pool_host2 = "";
            self.pool_port2 = 0;
            self.pool_tls2 = false;
            return fd;
        }
        if self.pool_fd3 >= 0
            && self.pool_host3 == host
            && self.pool_port3 == port
            && self.pool_tls3 == is_tls
        {
            let fd = self.pool_fd3;
            self.pool_fd3 = -1;
            self.pool_host3 = "";
            self.pool_port3 = 0;
            self.pool_tls3 = false;
            return fd;
        }
        return -1;
    }

    fn __pool_put(host: String, port: Int, fd: Int, is_tls: Bool) {
        if self.pool_fd0 < 0 {
            self.pool_fd0 = fd;
            self.pool_host0 = host;
            self.pool_port0 = port;
            self.pool_tls0 = is_tls;
            return;
        }
        if self.pool_fd1 < 0 {
            self.pool_fd1 = fd;
            self.pool_host1 = host;
            self.pool_port1 = port;
            self.pool_tls1 = is_tls;
            return;
        }
        if self.pool_fd2 < 0 {
            self.pool_fd2 = fd;
            self.pool_host2 = host;
            self.pool_port2 = port;
            self.pool_tls2 = is_tls;
            return;
        }
        if self.pool_fd3 < 0 {
            self.pool_fd3 = fd;
            self.pool_host3 = host;
            self.pool_port3 = port;
            self.pool_tls3 = is_tls;
            return;
        }
        __http_close_handle(self.pool_fd3, self.pool_tls3);
        self.pool_fd3 = fd; self.pool_host3 = host; self.pool_port3 = port; self.pool_tls3 = is_tls;
    }

    dissolve() {
        __http_close_handle(self.pool_fd0, self.pool_tls0);
        __http_close_handle(self.pool_fd1, self.pool_tls1);
        __http_close_handle(self.pool_fd2, self.pool_tls2);
        __http_close_handle(self.pool_fd3, self.pool_tls3);
    }
}

// ---- a streamed response body ---------------------------------------
//
// 2026-10-21 — the client's mirror of the Server's streamed body
// (http.hl § BodyWriter / SseWriter): a response whose body the program
// reads as it arrives, as chunks or as Server-Sent Events, over http and
// https alike. A `BodyReader`'s birth makes the exchange up to the end of
// the response's head (the dial, the request, the status line and the
// headers), so `status` and `headers` are there once it is built; each
// `chunk()` then hands back the next piece of the body as it arrives and
// `SseReader.event()` the next event. One `Connection: close` exchange,
// never retried (a stream cannot be replayed once a piece of it was
// handed on), the connection closed at dissolve.
//
// Every read ends in one stated outcome, never a hang: a piece of the
// body; the end (`HttpError { kind: "end" }`: the last chunk, the
// Content-Length reached, or the close of a body framed by neither); or a
// failure, the whole-body read's kinds: `connect_failed`, `send_failed`,
// `recv_failed` (the deadline, the connection closed before the body
// ended, a read error), `bad_response` (an unparseable head, malformed
// chunk framing), `too_large`, `unsupported_scheme`. Once a read has
// ended or failed, every later one fails the same way.
//
// `timeout_ms` bounds the exchange whole, as the Client's does: the dial,
// the request, the head and every read of the body, each armed with what
// is left of one deadline; `0` leaves it unbounded, which a stream longer
// than 30 s needs. Reads go into one `BytesBuilder` (no allocation per
// read; https through `tls::__recv_into_until`, which takes the deadline
// itself, as the whole-body read's `__recv_bytes_until` does).

// One read into `rx` within `deadline`: the bytes read (> 0), 0 when the
// peer closed, -2 when the deadline passed, -1 for a read error.
fn __http_stream_fill(
    handle: Int,
    is_tls: Bool,
    rx: std::bytes::BytesBuilder,
    deadline: Int
) -> Int {
    if !__http_arm(handle, is_tls, deadline) {
        return -2;
    }
    if is_tls {
        return std::io::tls::__recv_into_until(handle, rx, 8192, deadline);
    }
    return std::io::tcp::recv_into(handle, rx, 8192);
}

// A copy of what `rx` holds, for the framing scans.
fn __http_stream_held(rx: std::bytes::BytesBuilder) -> Bytes {
    return rx.snapshot() or raise;
}

// The next chunk at the front of `raw`: `state` 0 needs more bytes, 1 a
// chunk (its payload at [lo, hi), `used` bytes of framing and payload), 2
// the last chunk, 3 malformed framing.
type __StdHttpChunkPeel { state: Int; lo: Int; hi: Int; used: Int; }

fn __http_chunk_peel(raw: Bytes) -> __StdHttpChunkPeel {
    let end = len(raw);
    let nl = __http_crlf_at(raw, 0, end);
    if nl < 0 {
        return __StdHttpChunkPeel { state: 0, lo: 0, hi: 0, used: 0 };
    }
    let size = __http_hex_size(raw, 0, nl);
    if size < 0 {
        return __StdHttpChunkPeel { state: 3, lo: 0, hi: 0, used: 0 };
    }
    if size == 0 {
        // the trailer section after it is not read: the body has ended
        return __StdHttpChunkPeel { state: 2, lo: 0, hi: 0, used: nl + 2 };
    }
    let lo = nl + 2;
    let hi = lo + size;
    if hi + 2 > end {
        return __StdHttpChunkPeel { state: 0, lo: 0, hi: 0, used: 0 };
    }
    let ca = std::bytes::at(raw, hi) or - 1;
    let cb = std::bytes::at(raw, hi + 1) or - 1;
    if ca != 13 || cb != 10 {
        return __StdHttpChunkPeel { state: 3, lo: 0, hi: 0, used: 0 };
    }
    return __StdHttpChunkPeel { state: 1, lo: lo, hi: hi, used: hi + 2 };
}

/// A response body read as it arrives: the client's mirror of
/// `BodyWriter`. Birth sends `req` (`Connection: close`) and reads the
/// response's head into `status` and `headers`; `chunk()` returns the
/// next piece of the body: one chunk of a chunked body, else what one
/// read brought. The body's end fails `chunk()` with kind `end`; a failure
/// is the whole-body read's (`recv_failed` for the deadline or a body cut
/// off). `timeout_ms` bounds the whole exchange (`0`: none); `max_chunk`
/// the head and any one chunk. Never retried; dissolve closes the
/// connection.
locus __StdHttpBodyReader {
    params {
        req: std::http::ClientRequest;
        timeout_ms: Int = 30000;
        user_agent: String = "hale-std-http/0.11";
        max_chunk: Int = 16777216;
        // the response's head, read at birth: 0 and "" when there is none
        status: Int = 0;
        headers: String = "";
        // the connection, and what is left of the one deadline
        handle: Int = -1;
        is_tls: Bool = false;
        deadline: Int = 0;
        // what frames the body: 0 the close, 1 Content-Length, 2 chunks
        framing: Int = 0;
        // a Content-Length body's bytes not yet read
        left: Int = 0;
        // "" while the body is open; once ended or failed, the HttpError
        // kind every read fails with ("end" for the body's end)
        outcome: String = "";
        detail: String = "";
        // what has arrived and not been handed on
        rx: std::bytes::BytesBuilder = std::bytes::BytesBuilder { initial_cap: 8192 };
    }
    birth() {
        self.__open();
    }
    dissolve() {
        __http_close_handle(self.handle, self.is_tls);
    }

    /// The next piece of the body, as it arrives (never empty). Fails
    /// with kind `end` once the body has ended, else with what ended it.
    fn chunk() -> Bytes fallible(std::http::HttpError) {
        while self.outcome == "" {
            if self.framing == 2 {
                let raw = __http_stream_held(self.rx);
                let p = __http_chunk_peel(raw);
                if p.state == 1 {
                    self.rx.shift_front(p.used);
                    return std::bytes::slice(raw, p.lo, p.hi);
                }
                if p.state == 2 {
                    self.rx.shift_front(p.used);
                    self.__stop("end", "");
                } else if p.state == 3 {
                    self.__stop("bad_response", "malformed chunk framing");
                } else if len(raw) > self.max_chunk {
                    self.__stop(
                        "too_large",
                        "a chunk over " + to_string(self.max_chunk) + " bytes",
                    );
                } else {
                    self.__more();
                }
            } else {
                let held = self.rx.len();
                if held > 0 {
                    let raw = __http_stream_held(self.rx);
                    let mut take = held;
                    if self.framing == 1 && self.left < take {
                        take = self.left;
                    }
                    self.rx.clear();
                    self.left = self.left - take;
                    return std::bytes::slice(raw, 0, take);
                }
                if self.framing == 1 && self.left <= 0 {
                    self.__stop("end", "");
                } else {
                    self.__more();
                }
            }
        }
        fail std::http::HttpError { kind: self.outcome, status: self.status, detail: self.detail };
    }

    // One more read into `rx`; a read that brings nothing ends the body:
    // its end, for a body framed by the close, else a failure.
    fn __more() {
        let n = __http_stream_fill(self.handle, self.is_tls, self.rx, self.deadline);
        if n > 0 {
            return;
        }
        if n == 0 - 2 || __http_expired(self.deadline) {
            self.__timed_out();
            return;
        }
        if n < 0 {
            self.__stop("recv_failed", self.__at() + " read failed");
            return;
        }
        if self.framing == 0 && self.status > 0 {
            self.__stop("end", "");
            return;
        }
        self.__stop(
            "recv_failed",
            self.__at() + " cut off: the connection closed before the body ended",
        );
    }

    // The deadline has passed: the whole-body read's outcome.
    fn __timed_out() {
        self.__stop(
            "recv_failed",
            __http_timeout_detail(self.req.url.host, self.req.url.port, self.timeout_ms),
        );
    }

    // `host:port`, for a detail.
    fn __at() -> String {
        return self.req.url.host + ":" + to_string(self.req.url.port);
    }

    // End the stream with `kind` (`end`, or a failure): every later read
    // fails with it, and the connection closes now.
    fn __stop(kind: String, detail: String) {
        self.outcome = kind;
        self.detail = detail;
        __http_close_handle(self.handle, self.is_tls);
        self.handle = -1;
    }

    // Dial, send the request, read the head.
    fn __open() {
        let scheme = self.req.url.scheme;
        if scheme != "http" && scheme != "https" {
            self.__stop("unsupported_scheme", scheme + " — only http / https supported");
            return;
        }
        self.is_tls = scheme == "https";
        self.deadline = __http_deadline(self.timeout_ms);
        let mut failure = "";
        let h = __http_dial_nd(
            self.req.url.host,
            self.req.url.port,
            self.is_tls,
            __http_left_ms(self.deadline),
        ) or {
            failure = __http_connect_detail(err, self.timeout_ms);
                -1
        };
        if h < 0 {
            self.__stop("connect_failed", self.__at() + " " + failure);
            return;
        }
        self.handle = h;
        let head = __http_build_request_headers(self.req, self.user_agent, false);
        let mut sent = __http_send_within(
            h,
            self.is_tls,
            std::bytes::from_string(head),
            self.deadline,
        );
        if sent >= 0 && len(self.req.body) > 0 {
            sent = __http_send_within(h, self.is_tls, self.req.body, self.deadline);
        }
        if sent < 0 {
            if __http_expired(self.deadline) {
                self.__timed_out();
            } else {
                self.__stop("send_failed", self.__at() + " the request could not be sent");
            }
            return;
        }
        let mut hdr_end = -1;
        let mut raw = b"";
        while hdr_end < 0 {
            let n = __http_stream_fill(self.handle, self.is_tls, self.rx, self.deadline);
            if n <= 0 {
                if n == 0 - 2 || __http_expired(self.deadline) {
                    self.__timed_out();
                } else {
                    self.__stop("bad_response", "unparseable response");
                }
                return;
            }
            raw = __http_stream_held(self.rx);
            hdr_end = __http_find_hdr_end(raw);
            if hdr_end < 0 && len(raw) > self.max_chunk {
                self.__stop(
                    "too_large",
                    "a response head over " + to_string(self.max_chunk) + " bytes",
                );
                return;
            }
        }
        let text = std::str::from_bytes(std::bytes::slice(raw, 0, hdr_end));
        let line_end = std::str::index_of(text, "\r\n");
        let status_line = if line_end < 0 { text } else { text[0..line_end] };
        let status = __http_parse_status(status_line);
        if status < 0 {
            self.__stop("bad_response", "unparseable response");
            return;
        }
        self.status = status;
        if line_end >= 0 {
            self.headers = text[(line_end + 2)..len(text)];
        }
        self.rx.shift_front(hdr_end + 4);
        let te = std::str::lower(__http_client_header(self.headers, "transfer-encoding"));
        let cl = __http_client_header(self.headers, "content-length");
        if std::str::index_of(te, "chunked") >= 0 {
            self.framing = 2;
        } else if status == 204 || status == 304 || self.req.method == "HEAD" {
            self.framing = 1;
            self.left = 0;
        } else if len(cl) > 0 {
            self.framing = 1;
            self.left = std::str::parse_int(cl) or 0;
        } else {
            self.framing = 0;
        }
    }
}

// ---- Server-Sent Events, read ----------------------------------------

// `req` asking for an event stream: `Accept: text/event-stream` before
// its own headers.
fn __http_sse_request(req: std::http::ClientRequest) -> std::http::ClientRequest {
    let headers = if len(req.headers) > 0 {
        "Accept: text/event-stream\r\n" + req.headers
    } else {
        "Accept: text/event-stream"
    };
    return std::http::ClientRequest {
        method: req.method,
        url: req.url,
        headers: headers,
        body: req.body,
    };
}

// The next event at the front of `raw`: `found` once a blank line ends
// one (its fields and the blank line are `used` bytes); `dispatch` when it
// carried data, since an event without a `data` line is not dispatched
// (WHATWG HTML § 9.2.6). Lines end at CRLF, LF or CR; a line opening with
// `:` is a comment; one space after a field's colon is dropped; an
// unknown field is ignored.
type __StdHttpSseTake { found: Bool; dispatch: Bool; used: Int; event: std::http::SseEvent; }

fn __http_sse_take(raw: Bytes) -> __StdHttpSseTake {
    let n = len(raw);
    let mut pos = 0;
    let mut data = "";
    let mut has_data = false;
    let mut name = "";
    let mut id = "";
    let mut retry_ms = 0;
    while pos < n {
        let mut e = pos;
        let mut ch = -1;
        while e < n {
            ch = std::bytes::at(raw, e) or - 1;
            if ch == 10 || ch == 13 {
                break;
            }
            e = e + 1;
        }
        if e >= n {
            break;
        }
        let mut next = e + 1;
        if ch == 13 {
            if e + 1 >= n {
                // a CR last: wait for the byte that says whether an LF follows
                break;
            }
            let after = std::bytes::at(raw, e + 1) or - 1;
            if after == 10 {
                next = e + 2;
            }
        }
        let line = std::str::from_bytes(std::bytes::slice(raw, pos, e));
        pos = next;
        if len(line) == 0 {
            return __StdHttpSseTake {
                found: true,
                dispatch: has_data,
                used: pos,
                event: std::http::SseEvent {
                    data: data,
                    event: name,
                    id: id,
                    retry: retry_ms * 1ms,
                },
            };
        }
        let colon = std::str::index_of(line, ":");
        if colon != 0 {
            let mut field = line;
            let mut value = "";
            if colon > 0 {
                field = line[0..colon];
                value = line[(colon + 1)..len(line)];
                if std::str::starts_with(value, " ") {
                    value = value[1..len(value)];
                }
            }
            if field == "data" {
                data = if has_data { data + "\n" + value } else { value };
                has_data = true;
            } else if field == "event" {
                name = value;
            } else if field == "id" {
                id = value;
            } else if field == "retry" {
                let ms = std::str::parse_int(value) or - 1;
                if ms >= 0
                    && std::str::index_of(value, "-") < 0
                    && std::str::index_of(value, "+") < 0
                {
                    retry_ms = ms;
                }
            }
        }
    }
    return __StdHttpSseTake {
        found: false,
        dispatch: false,
        used: 0,
        event: std::http::SseEvent { data: "" },
    };
}

/// A Server-Sent Events stream read as it arrives: the client's mirror
/// of `SseWriter`, over a `BodyReader` whose request asks for
/// `text/event-stream`. Built, `body.status` and `body.headers` hold the
/// response's head; `event()` returns the next event (`data` its `data`
/// lines joined by LF; `event`, `id` and `retry` its fields, empty or
/// `0ns` when absent), fails with kind `end` once the body has ended
/// (an unfinished last event is dropped), else as `chunk()` fails.
locus __StdHttpSseReader {
    params {
        req: std::http::ClientRequest;
        timeout_ms: Int = 30000;
        body: std::http::BodyReader = std::http::BodyReader {
            req: __http_sse_request(self.req),
            timeout_ms: self.timeout_ms
        };
        // the stream's text not yet parsed into an event
        rx: std::bytes::BytesBuilder = std::bytes::BytesBuilder { initial_cap: 8192 };
    }
    /// The next event, as it arrives. Fails with kind `end` once the
    /// body has ended, else with what ended it.
    fn event() -> std::http::SseEvent fallible(std::http::HttpError) {
        while true {
            let raw = __http_stream_held(self.rx);
            let t = __http_sse_take(raw);
            if t.found {
                self.rx.shift_front(t.used);
                if t.dispatch {
                    return t.event;
                }
            } else {
                if len(raw) > self.body.max_chunk {
                    fail std::http::HttpError {
                        kind: "too_large",
                        status: self.body.status,
                        detail: "an event over " + to_string(self.body.max_chunk) + " bytes",
                    };
                }
                let piece = self.body.chunk() or raise;
                self.rx.append(piece);
            }
        }
        fail std::http::HttpError { kind: "end", status: self.body.status, detail: "" };
    }
}
