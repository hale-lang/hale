// dna/core/workflow_execution.hl — exactly one admitted attempt (DNA
// workflow card 08; dna/WORKFLOW-CONTRACT.md §6, §7, §8).
//
// The durable Work owner admits an attempt (`attempt.admitted`, card 05)
// and then asks for it to run. This is the path it asks through, and it
// runs one admitted attempt once:
//
//   - nothing runs before its admission is in the record, as admitted;
//   - an attempt whose outcome is recorded is not run again — the
//     recorded outcome is the answer;
//   - the execution is claimed in the record before the performer is
//     called (the effect claim of GH #604 rule 3, keyed by the attempt,
//     appended exactly at the revision the decision was read at), so a
//     request that arrives while the attempt is running attaches to its
//     pending outcome instead of starting a second performer, and an
//     outcome durable before the claim is the answer, not a second run;
//   - the performer named by the admission runs once, and its reply has
//     to be about this attempt, from that performer;
//   - a reply that is not terminal (`pending`, a performer that answers
//     later) records nothing and leaves the attempt outstanding;
//   - an accepted outcome is persisted with an exact append before
//     anything is answered, and a reply for an attempt whose outcome is
//     already recorded changes nothing;
//   - an append the record refuses — the claim, the outcome — stops here:
//     no performer runs on a claim that did not land, and an outcome the
//     record would not take is reported as unrecorded, never as done.
//
// It retries nothing (§7: one retry owner, the Work's lifecycle) and it
// advances nothing (the Work settles on this outcome in a later card).
// It makes no claim about external effects being once-only: a performer
// that acted and died before its outcome was saved is cards 12a–12c.
// The legacy `WorkSystem.on_request` loop, which retries internally,
// stays for legacy callers.

// What one call to the executor did.
type Executed {
    ok: Bool = false; // the call did what it says; false: refused, or the record would not take the outcome
    ran: Bool = false; // this call invoked the performer
    attached: Bool = false; // the attempt was already running: attached to its pending outcome
    reused: Bool = false; // the attempt was already settled: its recorded outcome is the answer
    redelivered: Bool = false; // the attempt was claimed by an incarnation that died: its dispatch was issued again, same id, no new claim
    fenced: Bool = false; // the write was refused by the fence: this holder's lease is not live as of the reading
    reconciled: Bool = false; // the outcome was established without running: the adapter said it acted, or a person resolved the claim
    unresolved: Bool = false; // nothing could establish whether the attempt acted: it waits, visibly, for a person
    disposition: String = ""; // the recorded outcome's, "" while the attempt is outstanding
    outcome: AttemptOutcome = AttemptOutcome { };
    why: String = "";
}

// The lease a write is fenced on (card 12b): the record's own lease
// rows, read at the revision the write is exact at. No key: unfenced.
type Fence {
    key: String = "";
    holder: String = "";
    token: Int = 0;
    now: Int = 0;
}

fn fence_holds(j: Journal, f: Fence, rev: Int) -> Bool {
    if len(f.key) == 0 { return true; }
    return lease_holds_at(j, f.key, f.holder, f.token, rev, f.now);
}

fn fenced(j: Journal, f: Fence, what: String) -> Executed {
    let cur = lease_at(j, f.key, j.revision());
    let who = if cur.present && cur.expires > f.now { cur.holder } else { "nobody" };
    return Executed { fenced: true, why: "fenced: " + what + " is not committed by " + f.holder + ", whose lease on " + f.key + " is not live as of this reading (held by " + who + ")" };
}

fn execution_key(attempt_id: String) -> String {
    return "attempt:" + attempt_id;
}

// ---- the path itself, as functions over the journal the caller holds ----
//
// A locus cannot hand an interface-typed journal to a child (F.3), so a
// runtime locus that is both the committer and the executor over one
// journal (card 09) reaches this path through these functions with its
// own journal. `AttemptExecutor` below is the same path bound to a
// journal of its own.

// The recorded outcome of an attempt as the record reads below `rev`,
// ok false when there is none.
@unbounded
fn recorded_attempt_outcome(j: Journal, attempt_id: String, rev: Int) -> DecodedAttemptOutcome {
    let mut i = 0;
    while i < rev {
        let e = j.read(i);
        if e.kind == "attempt.outcome" && e.entity == attempt_id { return decode_attempt_outcome(e.body); }
        i = i + 1;
    }
    return DecodedAttemptOutcome { };
}

// The admission of an attempt as the record reads below `rev`, ok false
// when there is none.
@unbounded
fn recorded_attempt_admission(j: Journal, attempt_id: String, rev: Int) -> DecodedAttempt {
    let mut i = 0;
    while i < rev {
        let e = j.read(i);
        if e.kind == "attempt.admitted" && e.entity == attempt_id { return decode_attempt(e.body); }
        i = i + 1;
    }
    return DecodedAttempt { };
}

// Whether the execution of an attempt is claimed below `rev`.
@unbounded
fn attempt_claimed(j: Journal, attempt_id: String, rev: Int) -> Bool {
    let key = execution_key(attempt_id);
    let mut i = 0;
    while i < rev {
        let e = j.read(i);
        if e.kind == "effect.requested" && e.entity == key { return true; }
        i = i + 1;
    }
    return false;
}

// Why the recorded admission of an attempt is not this request, "" when
// it is: the same Work, step, task and performer kind, and the same
// request in every field.
fn attempt_admission_gap(v: AdmittedAttempt, a: AdmittedAttempt) -> String {
    if v.work_id != a.work_id || v.step_id != a.step_id || v.task_id != a.task_id || v.performer_kind != a.performer_kind {
        return "attempt " + a.attempt_id + " was admitted as " + v.performer_kind + " work on " + v.work_id + " of step " + v.step_id + ", not as this request says";
    }
    let departs = request_difference_of(v.request, a.request);
    if len(departs) > 0 { return "attempt " + a.attempt_id + " was admitted with another " + departs + " than this request carries"; }
    return "";
}

// Why a reply is not this attempt's at all, "" when it is: it names this
// attempt if it names one, and comes from the performer the admitted
// kind selects if it names one. Judged before anything else is made of
// the reply — a reply that is not this attempt's is not this attempt's
// pending answer either.
fn reply_identity_gap(work: Performing, v: AdmittedAttempt, r: WorkResult) -> String {
    if len(r.attempt_id) > 0 && r.attempt_id != v.attempt_id {
        return "the reply is for attempt " + r.attempt_id + ", not " + v.attempt_id + "; not this attempt's";
    }
    let expected = work.identity_of(v.performer_kind);
    if len(r.performer) > 0 && len(expected) > 0 && r.performer != expected {
        return "the reply names performer " + r.performer + ", not the " + v.performer_kind + " performer " + expected + " that was selected; not this attempt's";
    }
    return "";
}

// Why a terminal reply cannot be recorded, "" when it can: it says
// something the outcome contract carries.
fn reply_disposition_gap(r: WorkResult) -> String {
    if r.disposition != "done" && r.disposition != "failed" && r.disposition != "declined" && r.disposition != "timeout" {
        return "an attempt is done, failed, declined or timeout, not `" + r.disposition + "`; not recorded";
    }
    return "";
}

fn reply_outstanding(r: WorkResult) -> Bool {
    return r.disposition == "pending" || len(r.disposition) == 0;
}

// The attempt is running under another invocation's claim: its outcome,
// if recorded by now, else pending.
fn attach_attempt(j: Journal, attempt_id: String, why: String, f: Fence) -> Executed {
    let settled = recorded_attempt_outcome(j, attempt_id, j.revision());
    if settled.ok {
        if !claim_closed(j, attempt_id, settled.value.disposition, f) { return close_refused(attempt_id); }
        return Executed { ok: true, attached: true, reused: true, disposition: settled.value.disposition, outcome: settled.value };
    }
    return Executed { ok: true, attached: true, why: why };
}

// Run one admitted attempt, once. The decision to run is one reading of
// the record: refreshed, read at a captured revision — the admission,
// whether the attempt is settled, whether its execution is claimed — and
// the claim appended exactly at that revision. When the record has
// moved, the decision is taken again: an outcome recorded meanwhile is
// the answer, a claim taken meanwhile is attached to, and only a claim
// that lands is followed by a performer call.
// The durable fence over a task at one reading of the record: the task
// or an ancestor of it settled cancelled before `rev`. "" when none did.
// Walked through the admissions (a child's names its parent), bounded
// by the rows read: an ancestry that does not resolve is reported, and
// admits nothing.
@unbounded
fn recorded_fence(j: Journal, task_id: String, rev: Int) -> String {
    let mut task = task_id;
    let mut hops = 0;
    while len(task) > 0 {
        hops = hops + 1;
        if hops > rev + 1 { return "task " + task_id + " sits under an ancestry that does not resolve (it loops above " + task + ")"; }
        let mut parent = "";
        let mut admitted = false;
        let mut i = 0;
        while i < rev {
            let e = j.read(i);
            if e.kind == "workflow.settled" && e.entity == task {
                let o = decode_workflow_outcome(e.body);
                if o.ok && o.value.disposition == "cancelled" { return "task " + task + " was cancelled"; }
            }
            if e.kind == "workflow.admitted" && e.entity == task {
                let ad = decode_admission(e.body);
                if ad.ok { admitted = true; parent = ad.value.parent_task; }
            }
            i = i + 1;
        }
        if !admitted { return ""; }
        task = parent;
    }
    return "";
}

@unbounded
fn execute_attempt(j: Journal, work: Performing, scope: String, a: AdmittedAttempt, f: Fence) -> Executed {
    let id = a.attempt_id;
    if id != attempt_id_of(a.work_id, a.attempt_no) {
        return Executed { why: "attempt " + id + " is not attempt " + to_string(a.attempt_no) + " of " + a.work_id };
    }
    let key = execution_key(id);
    let mut v = AdmittedAttempt { };
    let mut tries = 0;
    let mut ours = false;
    while tries < 6 && !ours {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        let admitted = recorded_attempt_admission(j, id, rev);
        if !admitted.ok {
            return Executed { why: "attempt " + id + " was never admitted; nothing runs before its admission is in the record" };
        }
        v = admitted.value;
        let gap = attempt_admission_gap(v, a);
        if len(gap) > 0 { return Executed { why: gap }; }
        let settled = recorded_attempt_outcome(j, id, rev);
        if settled.ok {
            // an outcome recorded meanwhile — by another hand — is the
            // answer, once the claim under it is closed
            if !claim_closed(j, id, settled.value.disposition, f) { return close_refused(id); }
            return Executed { ok: true, reused: true, disposition: settled.value.disposition, outcome: settled.value };
        }
        if attempt_claimed(j, id, rev) {
            return attach_attempt(j, id, "attempt " + id + " is already running; attached to its outcome", f);
        }
        // the fence, at the same reading the claim is exact at (§5): an
        // attempt not yet claimed under a cancelled execution starts no
        // new work; one claimed before the cancellation still records
        // its outcome
        let fence = recorded_fence(j, v.task_id, rev);
        if len(fence) > 0 {
            return Executed { why: fence + " before attempt " + id + " was claimed; it does not run" };
        }
        // the fence, as of the same reading the claim is exact at
        if !fence_holds(j, f, rev) { return fenced(j, f, "the claim on attempt " + id); }
        let w = j.append_exact(rev, "effect.requested", key, "attempt " + id + " by " + v.performer_kind);
        if w.ok { ours = true; }
        else if w.error != "stale_revision" && w.error != "claimed" {
            return Executed { why: "the record would not take the claim on attempt " + id + " (" + w.error + "); nothing ran" };
        }
        // the record moved under the decision: it is taken again
    }
    if !ours {
        return Executed { why: "the record moved under the claim on attempt " + id + " " + to_string(tries) + " times; nothing ran" };
    }
    // ---- the admitted performer runs, once
    return perform_attempt(j, work, scope, v, false, f);
}

// The admitted performer runs, and its reply is judged and recorded as
// card 08 has it. `redelivered` marks a dispatch issued again for a claim
// an earlier incarnation took and never answered (card 12a).
fn perform_attempt(j: Journal, work: Performing, scope: String, v: AdmittedAttempt, redelivered: Bool, f: Fence) -> Executed {
    let id = v.attempt_id;
    let req = attempt_request(v);
    let r = work.perform_as(v.performer_kind, req);
    let whose = reply_identity_gap(work, v, r);
    if len(whose) > 0 { return Executed { ran: true, redelivered: redelivered, why: whose }; }
    if reply_outstanding(r) {
        return Executed { ok: true, ran: true, redelivered: redelivered, why: "attempt " + id + " is outstanding: the performer will answer later" };
    }
    let bad = reply_disposition_gap(r);
    if len(bad) > 0 { return Executed { ran: true, redelivered: redelivered, why: bad }; }
    let mut x = record_attempt(j, scope, v, r, true, f);
    x.redelivered = redelivered;
    return x;
}

// The claim on an attempt is closed under its recorded outcome, durably,
// before anything is answered from that outcome (card 12a): true when
// it was closed already or its close just landed; false when the record
// refused it — and then the outcome is not the answer yet, and the Work
// keeps its responsibility until a later request or reply closes it.
@unbounded
fn claim_closed(j: Journal, attempt_id: String, disposition: String, f: Fence) -> Bool {
    let key = execution_key(attempt_id);
    let mut tries = 0;
    while tries < 6 {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        let st = effect_status(j, key);
        // closed already, by whichever hand: closed
        if !st.requested || st.done { return true; }
        if !fence_holds(j, f, rev) { return false; }
        let w = j.append_exact(rev, "effect.result", key, if disposition == "done" { "ok" } else { "failed" });
        if w.ok { return true; }
        if w.error != "stale_revision" && w.error != "claimed" { return false; }
        // the record moved: a close another hand landed is found above
    }
    return false;
}

fn close_refused(attempt_id: String) -> Executed {
    return Executed { why: "the outcome of attempt " + attempt_id + " is recorded, and the record would not close its claim; the Work keeps its responsibility" };
}

// Every request for an admitted attempt comes here (card 12a): the
// record is the authority as always, and what the runtime knows of its
// own incarnation — whether it made the claim, whether it already
// redelivered — is the only other input. An attempt whose outcome is
// recorded is answered from it and never runs again, and a claim the
// incarnation that died left open under it is closed with it, durably,
// before anything is answered; one never claimed runs through the
// ordinary path, which claims first; one claimed by this incarnation, or
// redelivered by it, is running: the request attaches. One claimed and
// never answered by a claimant this incarnation is not was claimed by
// an incarnation nobody will hear from again — unless its effect
// resulted unknown (a restart before this engine reconciled it): that
// stays visibly unresolved, and nothing runs on it until card 12c's
// reconciliation says what happened. Else its dispatch is issued again
// with the same attempt id and no new claim — a transport redelivery,
// not a new attempt — decided exactly at the reading that saw no
// outcome, no fence and the claim: the redelivery is a row appended at
// that revision, and an outcome or a cancellation landing meanwhile
// makes it stale and the decision is taken again.
@unbounded
fn dispatch_attempt(j: Journal, work: Performing, scope: String, a: AdmittedAttempt, claimed_here: Bool, redelivered_here: Bool, f: Fence) -> Executed {
    let id = a.attempt_id;
    if id != attempt_id_of(a.work_id, a.attempt_no) {
        return Executed { why: "attempt " + id + " is not attempt " + to_string(a.attempt_no) + " of " + a.work_id };
    }
    let key = execution_key(id);
    let mut tries = 0;
    while tries < 6 {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        let admitted = recorded_attempt_admission(j, id, rev);
        if !admitted.ok {
            return Executed { why: "attempt " + id + " was never admitted; nothing runs before its admission is in the record" };
        }
        let v = admitted.value;
        let gap = attempt_admission_gap(v, a);
        if len(gap) > 0 { return Executed { why: gap }; }
        let settled = recorded_attempt_outcome(j, id, rev);
        if settled.ok {
            if !claim_closed(j, id, settled.value.disposition, f) { return close_refused(id); }
            return Executed { ok: true, reused: true, disposition: settled.value.disposition, outcome: settled.value };
        }
        if !attempt_claimed(j, id, rev) { return execute_attempt(j, work, scope, a, f); }
        let st = effect_status(j, key);
        if st.done && st.unknown {
            return Executed { unresolved: true, why: "attempt " + id + " resulted unknown: what its invocation did before its incarnation died is unresolved, and nothing runs on it until a person resolves it" };
        }
        if st.done {
            // a person resolved the claim (`hale dna effect resolve`): the
            // attempt's outcome is that resolution, recorded as an
            // outcome so the Work settles on it; nothing runs
            let said = effect_result_body(j, key);
            let r = WorkResult {
                disposition: if st.ok { "done" } else { "failed" }, result: "resolved: " + said,
                performer: work.identity_of(v.performer_kind), attempt_id: id
            };
            let mut x = record_attempt(j, scope, v, r, false, f);
            x.reconciled = true;
            return x;
        }
        if claimed_here || redelivered_here {
            return attach_attempt(j, id, "attempt " + id + " is already running; attached to its outcome", f);
        }
        let fence = recorded_fence(j, v.task_id, rev);
        if len(fence) > 0 { return Executed { why: fence + "; attempt " + id + " is not redelivered" }; }
        if !fence_holds(j, f, rev) { return fenced(j, f, "the redelivery of attempt " + id); }
        // GH #946 hardening: an attempt a leg holds is left to its claim.
        // The owner asks nothing of it while the lease is live — the leg
        // is at work, and its outcome comes back under that lease — and
        // asks again once the lease has expired with no outcome: the relay
        // answers pending as before, and a leg claims it anew. Never
        // `effect.result unknown`: a leg's claim says exactly what stands.
        let leg = recorded_leg_claim(j, id, rev);
        if leg.present && leg.expires > std::time::now() {
            return Executed { ok: true, attached: true, why: "attempt " + id + " is " + leg.holder + "'s under a lease until " + to_string(leg.expires) + "; it waits for the leg's outcome, and is asked again when the lease expires" };
        }
        // asked again once per lease: a lease that expired and was already
        // redelivered awaits a leg, and an owner restart asks nothing more
        if leg.present && redelivered_since_claim(j, id, rev) {
            return Executed { ok: true, attached: true, why: "attempt " + id + " was asked of a leg again after " + leg.holder + "'s lease expired; it awaits a leg" };
        }
        // the claim was an incarnation's that died, and the invocation may
        // have acted before the outcome was saved: recovery reconciles
        // before it decides on a redelivery (card 12c). The adapter says
        // it acted: its record is the outcome, and nothing runs again. It
        // says it did not, or that acting again is documented safe: the
        // dispatch is issued again. It cannot say: the claim resulted
        // unknown, durably and visibly, and the attempt waits for a person
        let mut rc = work.reconcile_as(v.performer_kind, attempt_request(v));
        // evidence is the admitted performer's or it is no evidence: an
        // adapter speaking for another kind or identity can attest
        // nothing about this attempt, and its documented idempotence is
        // not this performer's
        if rc.kind != v.performer_kind || rc.identity != work.identity_of(v.performer_kind) {
            rc = Reconciliation { why: "the evidence offered is " + rc.kind + " " + rc.identity + "'s, not the " + v.performer_kind + " performer " + work.identity_of(v.performer_kind) + "'s that attempt " + id + " was admitted to" };
        }
        if rc.established && rc.performed {
            // the adapter's record, as it recorded it: judged for whose it
            // is exactly as a reply is — the performer it names, the
            // attempt it names if it names one — and never relabelled
            let r = rc.result;
            let whose = reply_identity_gap(work, v, r);
            if len(whose) > 0 { return Executed { why: "the adapter's record of attempt " + id + " is not this attempt's: " + whose }; }
            let bad = reply_disposition_gap(r);
            if len(bad) > 0 { return Executed { why: "the adapter's record of attempt " + id + " carries no outcome: " + bad }; }
            let mut x = record_attempt(j, scope, v, r, false, f);
            x.reconciled = true;
            return x;
        }
        if !rc.established && !rc.idempotent {
            let u = j.append_exact(rev, "effect.result", key, "unknown (reconciled after a restart: " + rc.why + ")");
            if u.ok {
                return Executed { unresolved: true, why: "attempt " + id + " may have acted before its incarnation died and nothing can say whether it did (" + rc.why + "); it waits, unresolved, for a person: `hale dna effect resolve " + key + " --outcome ok|failed`" };
            }
            if u.error != "stale_revision" && u.error != "claimed" {
                return Executed { why: "the record would not take the unknown result of attempt " + id + " (" + u.error + "); nothing ran" };
            }
            // the record moved under the decision: it is taken again — an
            // outcome, a resolution or a takeover landed, or something
            // unrelated did and the unknown row is appended at the new
            // reading
            continue;
        }
        let w = j.append_exact(rev, "effect.redelivered", key, "attempt " + id + " redelivered" + (if rc.idempotent { " (documented idempotent)" } else { " (the adapter says it never acted)" }));
        if w.ok { return perform_attempt(j, work, scope, v, true, f); }
        if w.error != "stale_revision" && w.error != "claimed" {
            return Executed { why: "the record would not take the redelivery of attempt " + id + " (" + w.error + "); nothing ran" };
        }
        // the record moved under the decision: it is taken again
    }
    return Executed { why: "the record moved under the redelivery of attempt " + id + " " + to_string(tries) + " times; nothing ran" };
}

// A leg's claim on an attempt as the record holds it (GH #946): the
// latest `attempt.claimed` row before `rev` — the lease (holder, token,
// until) and the principal that took it, which is who may hand the
// outcome back under it. Not present when none was taken.
type LegClaim {
    present: Bool = false;
    holder: String = "";
    token: Int = 0;
    expires: Int = 0;
    principal_mode: String = "";
    principal_name: String = "";
}

@unbounded
fn recorded_leg_claim(j: Journal, attempt_id: String, rev: Int) -> LegClaim {
    let mut out = LegClaim { };
    let mut i = 0;
    while i < rev {
        let e = j.read(i);
        if e.kind == "attempt.claimed" && e.entity == attempt_id {
            out = LegClaim {
                present: true, holder: std::json::find_string_field(e.body, "holder"), token: std::json::find_int_field(e.body, "token"), expires: std::json::find_int_field(e.body, "until"),
                principal_mode: std::json::find_string_field(e.body, "principal_mode"), principal_name: std::json::find_string_field(e.body, "principal_name")
            };
        }
        i = i + 1;
    }
    return out;
}

// Whether the attempt was redelivered (`effect.redelivered`) after its
// latest leg claim was taken: once per lease, whatever restarts since.
@unbounded
fn redelivered_since_claim(j: Journal, attempt_id: String, rev: Int) -> Bool {
    let key = execution_key(attempt_id);
    let mut claimed_at = -1;
    let mut redelivered_at = -1;
    let mut i = 0;
    while i < rev {
        let e = j.read(i);
        if e.kind == "attempt.claimed" && e.entity == attempt_id { claimed_at = i; }
        if e.kind == "effect.redelivered" && e.entity == key { redelivered_at = i; }
        i = i + 1;
    }
    return claimed_at >= 0 && redelivered_at > claimed_at;
}

// A reply that arrives later, for an attempt that ran and was left
// outstanding: checked by the same rules and persisted the same way. A
// reply for an attempt whose outcome is recorded changes nothing.
@unbounded
fn settle_attempt(j: Journal, work: Performing, scope: String, attempt_id: String, r: WorkResult, f: Fence) -> Executed {
    let moved = j.refresh();
    let rev = j.revision();
    let admitted = recorded_attempt_admission(j, attempt_id, rev);
    if !admitted.ok { return Executed { why: "attempt " + attempt_id + " was never admitted; its reply is nobody's" }; }
    if !attempt_claimed(j, attempt_id, rev) {
        return Executed { why: "attempt " + attempt_id + " never ran; a reply for it is nobody's" };
    }
    let whose = reply_identity_gap(work, admitted.value, r);
    if len(whose) > 0 { return Executed { why: whose }; }
    if reply_outstanding(r) {
        return Executed { ok: true, why: "attempt " + attempt_id + " is still outstanding" };
    }
    let settled = recorded_attempt_outcome(j, attempt_id, rev);
    if settled.ok {
        if !claim_closed(j, attempt_id, settled.value.disposition, f) { return close_refused(attempt_id); }
        return Executed { ok: true, reused: true, disposition: settled.value.disposition, outcome: settled.value, why: "attempt " + attempt_id + " was already settled; this reply changes nothing" };
    }
    let bad = reply_disposition_gap(r);
    if len(bad) > 0 { return Executed { why: bad }; }
    return record_attempt(j, scope, admitted.value, r, false, f);
}

// Persist the outcome with an exact append at the revision read now.
// When the record moved, read again: an outcome recorded meanwhile — the
// same reply delivered twice, or another invocation's — is the accepted
// one, and this reply changes nothing.
@unbounded
fn record_attempt(j: Journal, scope: String, v: AdmittedAttempt, r: WorkResult, ran: Bool, f: Fence) -> Executed {
    let outcome = AttemptOutcome {
        attempt_id: v.attempt_id, work_id: v.work_id, disposition: r.disposition,
        performer: r.performer, result: r.result, result_ref: r.result_ref, evidence_ref: r.evidence,
        narrative: r.narrative,
        request: r.request, hat_digest: r.hat_digest, hat_head: r.hat_head, hat_watermark: r.hat_watermark, prompt_digest: r.prompt_digest, renderer: r.renderer,
        transition: TransitionRef { scope: scope, key: v.attempt_id, proposal_id: transition_id(v.attempt_id, "outcome") }
    };
    let body = encode_attempt_outcome(outcome);
    // what is written has to read back as an outcome, or it is not one
    let readable = decode_attempt_outcome(body);
    if !readable.ok { return Executed { ran: ran, why: "the reply is not an outcome the record can carry: " + readable.why + "; not recorded" }; }
    let mut tries = 0;
    while tries < 6 {
        tries = tries + 1;
        let moved = j.refresh();
        let rev = j.revision();
        let already = recorded_attempt_outcome(j, v.attempt_id, rev);
        if already.ok {
            if !claim_closed(j, v.attempt_id, already.value.disposition, f) { return close_refused(v.attempt_id); }
            return Executed { ok: true, ran: ran, reused: true, disposition: already.value.disposition, outcome: already.value, why: "attempt " + v.attempt_id + " was already settled; this reply changes nothing" };
        }
        if !fence_holds(j, f, rev) { let x = fenced(j, f, "the outcome of attempt " + v.attempt_id); return Executed { ran: ran, fenced: true, why: x.why }; }
        let w = j.append_exact(rev, "attempt.outcome", v.attempt_id, body);
        if w.ok {
            if !claim_closed(j, v.attempt_id, r.disposition, f) {
                let held = close_refused(v.attempt_id);
                return Executed { ran: ran, why: held.why };
            }
            return Executed { ok: true, ran: ran, disposition: r.disposition, outcome: outcome };
        }
        if w.error != "stale_revision" && w.error != "claimed" {
            return Executed { ran: ran, why: "the record would not take the outcome of attempt " + v.attempt_id + " (" + w.error + "); it is unrecorded, and nothing advances" };
        }
    }
    return Executed { ran: ran, why: "the record moved under the outcome of attempt " + v.attempt_id + " " + to_string(tries) + " times; it is unrecorded, and nothing advances" };
}

// The same path, bound to a journal of its own.
locus AttemptExecutor {
    params {
        journal: Journal = MemJournal { };
        work: Performing = NoPerformers { };
        scope: String = "org";
    }
    fn execute(a: AdmittedAttempt) -> Executed { return execute_attempt(self.journal, self.work, self.scope, a, Fence { }); }
    fn settle(attempt_id: String, r: WorkResult) -> Executed { return settle_attempt(self.journal, self.work, self.scope, attempt_id, r, Fence { }); }
}

// The first field in which two requests for one Work differ in content,
// "" when none does (ids and the attempt number are compared by the
// caller).
fn request_difference_of(a: WorkRequest, b: WorkRequest) -> String {
    if a.objective != b.objective { return "objective"; }
    if a.context_digest != b.context_digest { return "context digest"; }
    if a.knowledge_bindings != b.knowledge_bindings { return "knowledge bindings"; }
    if a.output_contract != b.output_contract { return "output contract"; }
    if a.data_class != b.data_class { return "data class"; }
    if a.requires != b.requires { return "requires"; }
    if a.target != b.target { return "target"; }
    if a.cost_ceiling != b.cost_ceiling { return "cost ceiling"; }
    return "";
}
