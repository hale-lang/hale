// Decision line 3, a field template two levels down under parents on
// two domains (Birth, Run).
//
// As `l03_field_parents_two_domains.hl`, with the template one level
// further down: `Twig` is `Leaf`'s field default, and `Leaf` is
// `Parent`'s, built by `App`'s run() on main and `Worker`'s run() on
// pool `side`. Twig's contributions are Leaf's, each with Twig's own
// placement, so its birth and run claim the same set, and each
// occurrence runs on its own grandparent's domain; on `side` its run()
// is canceled behind the Parent statement's teardown, as Leaf's is in
// the other fixture.
//
// Expected terminal outcome: one Twig born on each grandparent's
// domain, judged by the harness from the trace:
// `born-on-each-parents-domain`.

locus Twig { run() { println("ev twig-run"); } }
locus Leaf { params { twig: Twig = Twig { }; } }
locus Parent { params { leaf: Leaf = Leaf { }; } }
locus Worker { run() { Parent { }; } }
main locus App {
    params { worker: Worker = Worker { }; }
    placement { worker: cooperative(pool = side); }
    run() { Parent { }; }
}
fn main() { App { }; }
