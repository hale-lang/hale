// A call through a fn value with fewer arguments than its type takes.
// (The fn value is named as the parity gate's mutator names it: the
// refusal names it, outside quotes, so the name is part of the signature.)
// == main/main.hl ==
fn add(a: Int, b: Int) -> Int {
    return a + b;
}

fn main() {
    let __pg_fv: fn(Int, Int) -> Int = add;
    println(__pg_fv(1));
}
