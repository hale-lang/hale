// Element chains over a `bounded[T; N]` or array field (GH #1984).
//
// A chain over a collection field walks the field because of its type,
// whatever the field is named and however it is reached: a record local,
// a record param, a locus param, a path of fields. Two names were broken:
// chains desugar before typecheck and read `.items` / `.entries` as a
// `@form` locus's iteration pseudo-field, so `b.items` of a record was
// stripped to `b` and failed with "no field `get` on `Bag`". The receiver's
// type decides now: a form keeps its pseudo-field, anything else walks its
// field. And the element cursor is the collection's own `at` for the
// effect and allocation analyses, so each chain below holds under
// `@no_syscall` and `@budget(alloc_per_call = 0)`, as the chain docs say.

type Line { sku: String = ""; qty: Int = 0; }
type Bag { items: bounded[Int; 8]; }
type Ledger { entries: bounded[Line; 4]; }
type Fixed { items: [Int; 3]; }
type Inner { tags: bounded[Int; 8]; items: bounded[Int; 4]; }
type Outer { inner: Inner; scores: [Int; 3]; }

@form(vec)
locus Nums { capacity { heap xs of Int; } }

locus Cart {
    params { items: bounded[Line; 4]; n: Nums = Nums { }; }

    fn big() -> Int {
        return self.items.filter(it.qty > 1).count();
    }

    fn total() -> Int {
        return self.items.map(it.qty).sum();
    }
}

@no_syscall @budget(alloc_per_call = 0)
fn tagged(o: Outer) -> Int {
    return o.inner.tags.map(it * 2).filter(it > 2).count();
}

@no_syscall @budget(alloc_per_call = 0)
fn nested_items(o: Outer) -> Int {
    return o.inner.items.filter(it > 0).count();
}

@no_syscall @budget(alloc_per_call = 0)
fn scored(o: Outer) -> Int {
    return o.scores.filter(it > 4).sum();
}

@no_syscall @budget(alloc_per_call = 0)
fn first_big(b: Bag) -> Int {
    return b.items.find(it > 2) or 0;
}

fn main() {
    let mut b = Bag { };
    push(b.items, 3) or discard;
    push(b.items, 1) or discard;
    push(b.items, 5) or discard;
    std::test::assert_eq_int(
        b.items.filter(it > 1).count(),
        2,
        "record field items: filter + count",
    );
    std::test::assert_eq_int(b.items.map(it * 2).sum(), 18, "record field items: map + sum");
    std::test::assert_eq_int(b.items.find(it > 3) or 0, 5, "record field items: find");
    std::test::assert_eq_int(b.items.filter(it > 0).max() or 0, 5, "record field items: max");
    std::test::assert_eq_int(
        b.items.enumerate().map(idx).sum(),
        3,
        "record field items: enumerate",
    );

    let mut l = Ledger { };
    push(l.entries, Line { sku: std::str::upper("ab"), qty: 2 }) or discard;
    push(l.entries, Line { sku: std::str::upper("cd"), qty: 7 }) or discard;
    std::test::assert_eq_int(
        l.entries.filter(it.qty > 1).count(),
        2,
        "record field entries: filter + count",
    );
    let top = l.entries.max(it.qty) or Line { };
    std::test::assert_eq_str(top.sku, "CD", "record field entries: max by key");
    std::test::assert(l.entries.any(it.sku == "AB"), "record field entries: any");

    let f = Fixed { items: [4, 5, 6] };
    std::test::assert_eq_int(f.items.filter(it > 4).count(), 2, "array field items");

    let c = Cart { };
    push(c.items, Line { sku: "x", qty: 3 }) or discard;
    push(c.items, Line { sku: "y", qty: 1 }) or discard;
    std::test::assert_eq_int(c.big(), 1, "locus param items: filter + count");
    std::test::assert_eq_int(c.total(), 4, "locus param items: map + sum");

    // Any name, any path: by the field's type.
    let mut o = Outer { inner: Inner { }, scores: [3, 5, 9] };
    push(o.inner.tags, 1) or discard;
    push(o.inner.tags, 4) or discard;
    push(o.inner.items, 6) or discard;
    std::test::assert_eq_int(tagged(o), 1, "a record param's nested `tags`: map + filter + count");
    std::test::assert_eq_int(
        o.inner.tags.filter(it > 0).count(),
        2,
        "a record local's nested `tags`",
    );
    std::test::assert_eq_int(nested_items(o), 1, "a nested field named `items`");
    std::test::assert_eq_int(scored(o), 14, "an array field: filter + sum");
    std::test::assert_eq_int(first_big(b), 3, "a record param's `items`: find");

    // A `@form(vec)` keeps the pseudo-field reading.
    c.n.push(2);
    c.n.push(9);
    std::test::assert_eq_int(c.n.items.filter(it > 4).count(), 1, "form vec items pseudo-field");
}
