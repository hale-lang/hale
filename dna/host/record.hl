// dna/host/record.hl — the record as the host reads and writes it
// (GH #566 F8). The record's API is the core's `dna::Record` (GH #646
// stage 0, #649): the Journal is its `journal` chain, receipts are its
// bodies, the body lease is a cell, mailboxes are chains, and the remote
// is what it shares with and receives from. The host appends in a
// person's or a node's name, syncs the record with its remote, and reads
// receipts by digest. Nothing here decides, and nothing here spells the
// tool: the one implementation over git is `dna::GitRecord`.

import "../core" as dna;
import "../organization_runtime" as org_runtime;

const RECORD_REF: String = "refs/dna/journal";
const JOURNAL: String = "journal";
const REMOTE_JOURNAL: String = "remote/journal";
const VERDICT_SOCK: String = "hale-dna.review.verdict.sock";
const INTENT_SOCK: String = "hale-dna.intent.offered.sock";
const OBSERVED_SOCK: String = "hale-dna.expression.observed.sock";
const PRESSURE_SOCK: String = "hale-dna.pressure.raised.sock";
const CONCERN_SOCK: String = "hale-dna.concern.raised.sock";
const PRACTICE_SOCK: String = "hale-dna.practice.requested.sock";
const KNOWLEDGE_NODE_SOCK: String = "hale-dna.knowledge.node.requested.sock";
const KNOWLEDGE_BINDING_SOCK: String = "hale-dna.knowledge.binding.requested.sock";
const KNOWLEDGE_EDGE_SOCK: String = "hale-dna.knowledge.edge.requested.sock";
const IDENTITY_REF: String = "refs/dna/identity";
const IDENTITY: String = "identity";

// The record at `root`, as the core implements it over git.
fn rec(root: String) -> dna::GitRecord {
    return dna::GitRecord { repo: root };
}

// write_file as a Bool, so a caller can act on failure.
fn write_text(path: String, text: String) -> Bool fallible(IoError) {
    std::io::fs::write_file(path, text) or raise;
    return true;
}

fn record_head(root: String) -> dna::Head { let authority = org_runtime::HostAuthority { root: root }; return authority.record_head(); }

// The remote the record syncs with ("" when the repository has none).
fn record_remote(repo: String) -> String {
    return rec(repo).remote();
}

// GH #604 rule 6: the admission boundary for record-originated rows.
// `dna.trust` is `local` (default: every writer to the record is
// trusted, the operator's profile) or `signed` (a relayed row is admitted
// only when its commit carries a signature the record's trust verifies —
// git's own keyring or allowed-signers file is the list of who may act).
fn trust_mode(root: String) -> String { let authority = org_runtime::HostAuthority { root: root }; return authority.trust(); }

// GH #664: the owner this clone's body is (`git config dna.owner`), "" when unnamed.
fn owner_here(root: String) -> String { let authority = org_runtime::HostAuthority { root: root }; return authority.owner(); }
// GH #669: this owner's key to the shared record's service (`git config dna.owner.key`).
fn owner_key_here(root: String) -> String {
    return rec(root).setting("owner.key");
}
const OWNERS_FILE: String = "dna/org/owners";
// Whether the genome's owners map names any position (the record is shared).
fn shared_here(root: String) -> Bool { let authority = org_runtime::HostAuthority { root: root }; return authority.shared(); }
fn owners_here(root: String) -> String {
    let o = dna::Ownership { path: root + "/" + OWNERS_FILE, me: owner_here(root), me_env: "" };
    return o.owners();
}
// Whether a body here admits an intent for `to` — always with one owner,
// only for this owner's positions over a shared record.
fn admits_here(root: String, to: String) -> Bool {
    let o = dna::Ownership { path: root + "/" + OWNERS_FILE, me: owner_here(root), me_env: "" };
    return o.admits(to);
}
fn owner_of_person_here(root: String, who: String) -> String {
    let o = dna::Ownership { path: root + "/" + OWNERS_FILE, me: owner_here(root), me_env: "" };
    return o.owner_of_person(who);
}
fn ownership_note(root: String, to: String) -> String {
    let o = dna::Ownership { path: root + "/" + OWNERS_FILE, me: owner_here(root), me_env: "" };
    return o.why_not(to);
}

fn row_verified(root: String, sha: String) -> Bool { let authority = org_runtime::HostAuthority { root: root }; return authority.row_verified(sha); }

fn membrane_up(root: String) -> Bool {
    let d = root + "/.hale/dna/";
    return std::io::fs::file_exists(d + VERDICT_SOCK) && std::io::fs::file_exists(d + INTENT_SOCK);
}

fn short(s: String) -> String {
    if len(s) > 12 { return s[0..12]; }
    return s;
}

fn shape_of(path: String) -> String {
    let t = std::io::fs::read_file(path) or "";
    return std::json::find_string_field(t, "shape_hash");
}

// The receipt filed under a digest, or absent.
type Receipt {
    present: Bool = false;
    text: String = "";
}

fn receipt_read(repo: String, digest: String) -> Receipt {
    let k = rec(repo).body(digest);
    if !k.present { return Receipt { }; }
    return Receipt { present: true, text: k.text };
}

// The last non-empty line of a text.
fn last_line(text: String) -> String { return dna::last_line(text); }

fn count_lines(text: String) -> Int { return dna::count_lines(text); }

// The rows at a row id ("" for none), newline-terminated.
fn journal_text_at(repo: String, commit: String) -> String {
    return rec(repo).text_at(commit);
}

// GH #646 stage 1: the routing version this record is on, from its own
// rows (`ledger.adopted` / `ledger.abandoned`), and the checkpoint.
// (a locus handed to an interface parameter is bound to a local first:
// passed inline as a temporary it reaches the callee unborn)
fn routing_here(root: String) -> Int { let authority = org_runtime::HostAuthority { root: root }; return authority.routing(); }

fn checkpoint_here(root: String) -> String {
    let j = dna::GitJournal { repo: root, author: "host" };
    return dna::checkpoint_of(j);
}

// The `memory:` line of status: which memories the organism has.
fn routing_line(root: String) -> String {
    let r = routing_here(root);
    if r == 0 { return "the record alone (routing 0); `hale dna ledger adopt` moves the day's work to the ledger"; }
    let sl = store_leases(root);
    let probe = sl.current(store_lease_key(root));
    let reach = if sl.reachable { "" } else { "; THE LEDGER IS UNREACHABLE (" + sl.last_error + "): what is read here is the last projection, and nothing is admitted until it answers" };
    return "record + ledger (routing " + to_string(r) + ", adopted at " + short(checkpoint_here(root)) + "; operations and leases live in the store behind the service" + reach + ")";
}

// An operational row of an adopted organism goes to the Ledger through
// the service, never into the record: forwarded when a service is known
// here, refused with the checkpoint named otherwise (the compatibility
// path #646 decision 3 asked for — never silently accepted into git).
fn ledger_append(root: String, kind: String, entity: String, body: String) -> Bool {
    return ledger_submit(root, kind, entity, body, "");
}

const QUEUE_DIR: String = ".hale/dna/queue";

// A request's durable identity, minted when it is captured.
fn request_id(root: String) -> String {
    let d = dna::digest_of(root + "\n" + to_string(std::time::now()) + "\n" + to_string(std::process::pid()) + "\n" + to_string(millis()));
    return if std::str::starts_with(d, "sha256:") { d[7..31] } else { d[0..24] };
}

// A row in a person's name, through the service (GH #646 stage 3,
// #652). Written when the service admits it; QUEUED under
// `.hale/dna/queue/` when the service cannot be reached at all, to be
// submitted on the next contact (every submission drains the queue
// first, in capture order) and revalidated then; refused, with why,
// when the service refuses it. A head with no service known writes
// nothing and says so.
@unbounded
fn ledger_submit(root: String, kind: String, entity: String, body: String, author: String) -> Bool {
    let url = knowledge_url(root);
    if len(url) == 0 {
        eprintln("hale dna: `", kind, "` is a row of the ledger: this organism's operations have lived there since ", short(checkpoint_here(root)), " (ledger.adopted), and no service is known here to write it through (HALE_DNA_KNOWLEDGE_URL, or `hale dna dev`); nothing was written");
        return false;
    }
    let drained = submit_queue(root);
    if len(drained) > 0 && !std::str::starts_with(drained, "queue: nothing") && std::str::contains(drained, "unreachable") {
        // the service is down: this request joins the queue behind the others
        return enqueue(root, kind, entity, body, author);
    }
    let l = dna::ServiceLedger { url: url, head_owner: owner_here(root), head_key: owner_key_here(root) };
    let id = request_id(root);
    let r = l.submit(l.revision(), false, kind, entity, body, author, id);
    if r.ok { return true; }
    if l.unreachable { return enqueue_as(root, id, kind, entity, body, author); }
    eprintln("hale dna: the ledger at ", url, " refused `", kind, " ", entity, "`: ", l.last_error);
    return false;
}

// The ledger's revision as the service holds it now, or -1 when no
// service is known here: the point a decision over ledger rows is read at.
fn ledger_revision(root: String) -> Int {
    let url = knowledge_url(root);
    if len(url) == 0 { return -1; }
    let l = dna::ServiceLedger { url: url };
    return l.revision();
}

// A row of the ledger only if the ledger is still at `expected` (the
// revision a decision was read at): "" when it landed, `stale_revision`
// when the ledger moved (nothing written; read again and decide again),
// else why it was not written. Never queued: a decision read at one
// revision cannot wait for the service and land at another.
fn ledger_submit_at(root: String, expected: Int, kind: String, entity: String, body: String, author: String) -> String {
    let url = knowledge_url(root);
    if len(url) == 0 { return "no service is known here to write `" + kind + "` through (HALE_DNA_KNOWLEDGE_URL, or `hale dna dev`)"; }
    if expected < 0 { return "the ledger's revision was not read"; }
    let l = dna::ServiceLedger { url: url, head_owner: owner_here(root), head_key: owner_key_here(root) };
    let r = l.submit(expected, true, kind, entity, body, author, request_id(root));
    if r.ok { return ""; }
    if r.error == "stale_revision" { return "stale_revision"; }
    if l.unreachable { return "the ledger at " + url + " is unreachable; nothing was written"; }
    return "the ledger at " + url + " refused `" + kind + "`: " + l.last_error;
}

fn enqueue(root: String, kind: String, entity: String, body: String, author: String) -> Bool {
    return enqueue_as(root, request_id(root), kind, entity, body, author);
}

fn enqueue_as(root: String, id: String, kind: String, entity: String, body: String, author: String) -> Bool {
    std::io::fs::mkdir(root + "/.hale") or discard;
    std::io::fs::mkdir(root + "/.hale/dna") or discard;
    std::io::fs::mkdir(root + "/" + QUEUE_DIR) or discard;
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("request_id", id);
    b.string_field("kind", kind);
    b.string_field("entity", entity);
    b.string_field("body", body);
    b.string_field("as", author);
    b.int_field("captured_at", std::time::now());
    b.end_object();
    let path = root + "/" + QUEUE_DIR + "/" + to_string(std::time::now()) + "-" + to_string(millis() % 1000) + "-" + id + ".json";
    let w = write_text(path, b.result()) or false;
    if !w { eprintln("hale dna: the service cannot be reached and the request could not be queued at ", path); return false; }
    eprintln("hale dna: the service cannot be reached; `", kind, " ", entity, "` is queued locally as ", id, " (", QUEUE_DIR, "; `hale dna queue` lists it, `hale dna queue submit` sends it — admitted only once the service checks it)");
    return true;
}

// The queued requests, oldest first, one path per line.
@unbounded
fn queued(root: String) -> String {
    let dir = root + "/" + QUEUE_DIR;
    let n = std::io::fs::list_dir_count(dir) or 0;
    let mut names = "";
    let mut i = 0;
    while i < n {
        let name = std::io::fs::list_dir_at(dir, i) or "";
        if std::str::ends_with(name, ".json") { names = names + name + "\n"; }
        i = i + 1;
    }
    return sorted_lines(names);
}

// Submit every queued request in capture order; stop at the first the
// service cannot be reached for. A refused request is kept beside the
// queue as `<name>.refused` with the reason, for the person; an
// admitted one is removed. The report, one line per request.
@unbounded
fn submit_queue(root: String) -> String {
    let names = queued(root);
    if len(names) == 0 { return "queue: nothing queued\n"; }
    let url = knowledge_url(root);
    if len(url) == 0 { return "queue: " + to_string(count_lines(names)) + " request(s) queued and no service known here (HALE_DNA_KNOWLEDGE_URL)\n"; }
    let l = dna::ServiceLedger { url: url };
    let mut out = "";
    let mut rest = names;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let name = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(name) == 0 { continue; }
        let path = root + "/" + QUEUE_DIR + "/" + name;
        let q = std::io::fs::read_file(path) or "";
        let id = std::json::find_string_field(q, "request_id");
        let kind = std::json::find_string_field(q, "kind");
        let entity = std::json::find_string_field(q, "entity");
        let r = l.submit(l.revision(), false, kind, entity, std::json::find_string_field(q, "body"), std::json::find_string_field(q, "as"), id);
        if r.ok {
            std::io::fs::unlink(path) or discard;
            out = out + "queue: " + id + " " + kind + " " + entity + ": admitted (row " + to_string(r.revision - 1) + ")\n";
            continue;
        }
        if l.unreachable { return out + "queue: " + id + " " + kind + " " + entity + ": the service is unreachable (" + l.last_error + "); it and " + to_string(count_lines(rest)) + " behind it stay queued\n"; }
        std::io::fs::unlink(path) or discard;
        let w = write_text(path + ".refused", q + "\n" + l.last_error + "\n") or false;
        out = out + "queue: " + id + " " + kind + " " + entity + ": REFUSED — " + l.last_error + " (kept as " + name + ".refused)\n";
    }
    return out;
}

// Lines sorted, ascending (insertion sort: a queue is short).
@unbounded
fn sorted_lines(text: String) -> String {
    let mut lines = "";
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(line) == 0 { continue; }
        // insert before the first line greater than it
        let mut before = "";
        let mut after = lines;
        let mut placed = false;
        while len(after) > 0 && !placed {
            let anl = std::str::index_of(after, "\n");
            let cur = if anl < 0 { after } else { after[0..anl] };
            if cur > line { placed = true; break; }
            before = before + cur + "\n";
            after = if anl < 0 { "" } else { after[(anl + 1)..len(after)] };
        }
        lines = before + line + "\n" + after;
    }
    return lines;
}

// Whether rows this clone writes are signed (GH #604 rule 6: under
// `dna.trust = signed` a row this clone writes is a signed commit, so a
// relay elsewhere can admit it as its author's).
fn signing(root: String) -> Bool { return trust_mode(root) == "signed"; }

// Append one event to the record in `author`'s name ("" = the record's
// identity for whoever runs this): one row on the chain, compare-and-
// swapped, re-appended at the new tail when the chain moved. A lost
// race is not a failure: the tail moved, so the append goes round with
// the new tail — as many times as it takes within a bound that only a
// wedged repository reaches. Three tries used to be the bound, and a
// host reconciling beside a busy organism lost them all and dropped the
// row (GH #603).
@unbounded
fn append_as(repo: String, kind: String, entity: String, body: String, author: String) -> Bool {
    if dna::route(routing_here(repo), kind) == "ledger" { return ledger_submit(repo, kind, entity, body, author); }
    let r = rec(repo);
    let sign = signing(repo);
    let mut tries = 0;
    while tries < 200 {
        tries = tries + 1;
        let head = r.head(JOURNAL);
        // a tail that could not be read is not an empty chain to append at
        if !head.ok { return false; }
        let a = r.append(JOURNAL, head.id, dna::Row { kind: kind, entity: entity, body: body, author: author }, sign, "");
        if a.ok { return true; }
        if a.error != "stale" { return false; }
        // the chain moved under us: re-read and re-append at the new tail
    }
    return false;
}

// Append one event only if the memory it belongs to is still where a
// decision was read: at `expected` (the record head) for a row of the
// record, at `ledger_expected` (the ledger's revision) for a row of the
// ledger. "" when it landed, `stale_revision` when that memory moved
// (nothing appended; read again and decide again), else why it was
// refused (#636: a redaction that read "no hold" must not land after a
// hold did — on either memory).
fn append_as_at(repo: String, expected: String, ledger_expected: Int, kind: String, entity: String, body: String, author: String) -> String {
    if dna::route(routing_here(repo), kind) == "ledger" { return ledger_submit_at(repo, ledger_expected, kind, entity, body, author); }
    let r = rec(repo);
    let now = r.head(JOURNAL);
    if !now.ok { return "the record's head could not be read: " + now.why; }
    if now.id != expected { return "stale_revision"; }
    let a = r.append(JOURNAL, expected, dna::Row { kind: kind, entity: entity, body: body, author: author }, signing(repo), "");
    if a.ok { return ""; }
    if a.error == "stale" { return "stale_revision"; }
    return "the row could not be written";
}

type SyncResult {
    ok: Bool = true;
    summary: String = "";
}

fn sync_failed(why: String) -> SyncResult {
    return SyncResult { ok: false, summary: why };
}

// Receive, reconcile, share (GH #566 F1). Local ahead: share. Remote
// ahead: fast-forward. Diverged: the local-only events are re-appended
// on top of the remote's head, bodies and authors unchanged, then
// shared. Redactions and dropped candidates are applied both here and
// at the remote; the record's identity is published.
@unbounded
fn sync_record(repo: String) -> SyncResult {
    let s = sync_record_rows(repo);
    if s.ok {
        let r = apply_redactions(repo);
        let d = apply_drops(repo);
        // a remote that had no record had no identity either, whatever this
        // clone published to the remote it had before
        if std::str::contains(s.summary, "(the remote had none)") { let u = rec(repo).unset_setting("identitypublished"); }
        if !publish_identity(repo) && len(record_remote(repo)) > 0 && len(record_identity(repo)) > 0 {
            return SyncResult { ok: true, summary: s.summary + "; the record's identity (" + IDENTITY_REF + ") could not be published to " + record_remote(repo) + " — no other record can connect to this one until a sync publishes it" };
        }
    }
    return s;
}

// GH #615: a record's identity is the root commit of its journal. It is
// published as a cell under refs/dna/identity, so another record can name
// this one (and write into its mailbox for it) without reading its journal.
fn record_identity(repo: String) -> String {
    return rec(repo).identity();
}

// The cell in this clone is not publication (the second review of #631: a
// record synced before it had a remote, or whose first push of its
// identity failed, kept a local ref and never published it). Until a push
// to the remote as it is now has succeeded — `dna.identitypublished`
// names that remote and version — every sync asks the remote and pushes.
// Never forced: a remote holding another record's identity is refused.
fn publish_identity(repo: String) -> Bool {
    let r = rec(repo);
    let genesis = record_identity(repo);
    if len(genesis) == 0 { return false; }
    if dna::trim_nl(r.cell(IDENTITY).text) != genesis {
        if !r.swap(IDENTITY, genesis, "*") { return false; }
    }
    let remote = record_remote(repo);
    if len(remote) == 0 { return true; }
    let version = r.cell(IDENTITY).version;
    let url = r.remote_url(remote);
    let mark = (if len(url) > 0 { url } else { remote }) + " " + version;
    if r.setting("identitypublished") == mark { return true; }
    if r.remote_has(remote, IDENTITY) != version {
        if !r.share(remote, IDENTITY, "").ok { return false; }
    }
    return r.set_setting("identitypublished", mark);
}

// GH #606: a redacted receipt's body goes from this clone and from the
// remote on every sync, so a clone that fetched it drops it at its next
// sync. The blob lingers in each object store until git collects it.
// (GH #646 stage 4: a redaction is a row of the ledger once the record is
// adopted, and a body filed before adoption is still a blob here — so
// the rows are read from both memories as one)
@unbounded
fn apply_redactions(repo: String) -> Int {
    let r = rec(repo);
    let remote = record_remote(repo);
    let mut n = 0;
    // the record and the ledger read as one (nothing of the ledger is read
    // on routing 0); each locus built in place, never handed back by a factory
    let record = dna::GitJournal { repo: repo, author: "host" };
    let ledger = dna::ServiceLedger { url: knowledge_url(repo) };
    let j = dna::RoutedJournal { record: record, ledger: ledger };
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        i = i + 1;
        if e.kind != "receipt.redacted" { continue; }
        let digest = e.entity;
        let hexd = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
        if r.body(hexd).present {
            let gone = r.forget(hexd);
            n = n + 1;
        }
        if len(remote) > 0 && len(r.remote_has(remote, "receipts/" + hexd)) > 0 {
            let w = r.withdraw(remote, "receipts/" + hexd);
            n = n + 1;
        }
    }
    return n;
}

// A candidate the record says was dropped (`candidate.dropped
// <mutation>`) is unpointed here and withdrawn from the remote, as a
// redacted receipt is; its commits stay in the object store until git
// collects them.
@unbounded
fn apply_drops(repo: String) -> Int {
    let r = rec(repo);
    let remote = record_remote(repo);
    let mut n = 0;
    let record = dna::GitJournal { repo: repo, author: "host" };
    let ledger = dna::ServiceLedger { url: knowledge_url(repo) };
    let j = dna::RoutedJournal { record: record, ledger: ledger };
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        i = i + 1;
        if e.kind != "candidate.dropped" { continue; }
        let name = "candidates/" + e.entity;
        if len(r.pointer(name)) > 0 {
            let gone = r.unpoint(name);
            n = n + 1;
        }
        if len(remote) > 0 && len(r.remote_has(remote, name)) > 0 {
            let w = r.withdraw(remote, name);
            n = n + 1;
        }
    }
    return n;
}

// The families a sync carries besides the journal: receipts by digest,
// candidates by mutation, and (received only) every mailbox.
const SYNC_SHARES: String = "journal,receipts,candidates";
const SYNC_RECEIVES: String = "journal,receipts,exchange,candidates";

// #639, narrowed option 3: under `signed` trust a reconcile rebuilds only
// rows this clone signed (re-signed, with the original named) or never
// signed (rebuilt unsigned, so a reconcile upgrades nobody's provenance).
// A row signed elsewhere refuses the whole reconcile before any chain
// moves: the row and its key are named, every local row and commit stays
// where it is, and the way that keeps the work is said. "" when every
// local-only row may be rebuilt.
@unbounded
fn provenance_refusal(r: dna::GitRecord, ids: String) -> String {
    let own = r.own_key();
    let mut rest = ids;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let c = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(c) == 0 { continue; }
        let s = r.signer(c);
        if !s.signed { continue; }
        if len(own) > 0 && s.key == own { continue; }
        let row = r.row_of(c);
        let by = if len(s.key) > 0 { "key " + s.key + (if s.verified { "" } else { " (which this record does not verify)" }) } else { "a key this record cannot read" };
        return "the record diverged, and local event " + c + " (" + row.kind + " " + row.entity + ", by " + row.author + ") was signed with " + by + ", not this clone's" + (if len(own) == 0 { " (this clone signs nothing)" } else { "" }) + "; a reconcile would re-sign it as this clone's, so the record was not changed and every local row is kept at " + RECORD_REF + ". Have that row's writer sync first — a writer rebuilds its own rows — then sync again to fast-forward; or fetch and fast-forward once the remote holds it";
    }
    return "";
}

@unbounded
fn sync_record_rows(repo: String) -> SyncResult {
    let r = rec(repo);
    let remote = record_remote(repo);
    if len(remote) == 0 { return SyncResult { ok: true, summary: "no remote: the record is local" }; }
    let f = r.receive(remote, SYNC_RECEIVES);
    // a remote with no record yet is not an error
    if !f.ok && !f.absent { return sync_failed("fetch " + remote + ": " + f.why); }
    let mut summary = "";
    let mut round = 0;
    while round < 3 {
        round = round + 1;
        let local = r.head(JOURNAL).id;
        let remote_head = r.head(REMOTE_JOURNAL).id;
        if len(local) == 0 {
            if len(remote_head) > 0 {
                if !r.move_chain(JOURNAL, remote_head, "*") { return sync_failed("update-ref failed"); }
                summary = "pulled the record";
            }
            return SyncResult { ok: true, summary: summary };
        }
        if len(remote_head) == 0 {
            // The remote has no record yet: a governed repository whose
            // first events were appended here, or a clone that pushed
            // `main` alone. This said "up to date" and pushed nothing,
            // so the record stayed on one machine and a second clone saw
            // an organization with no history (the shakeout's finding 7).
            summary = "pushed " + to_string(r.count(JOURNAL)) + " event(s) (the remote had none)";
        } else if local == remote_head {
            if len(summary) == 0 { summary = "up to date"; }
            return SyncResult { ok: true, summary: summary };
        } else if r.precedes(remote_head, local) {
            // local ahead: share below
            summary = "pushed " + to_string(count_lines(r.between(remote_head, local))) + " event(s)";
        } else if r.precedes(local, remote_head) {
            if !r.move_chain(JOURNAL, remote_head, local) { return sync_failed("update-ref failed"); }
            summary = "pulled " + to_string(count_lines(r.between(local, remote_head))) + " event(s)";
            return SyncResult { ok: true, summary: summary };
        } else {
            // diverged: the local-only events are re-appended on top of
            // the remote's head — on a chain built BESIDE the live ref,
            // swapped in with one compare-and-swap once it is whole. The
            // ref used to be rewound to the remote's head first and the
            // events re-appended behind it one by one: for that whole
            // window the record had lost rows it held a moment before —
            // a reader saw a Review vanish from the board, an organism
            // whose append lost the ref race reloaded without its own
            // rows, and a re-append that lost three races left them
            // lost for good (GH #603). Nothing here changes the ref
            // until the whole chain exists; a local-only commit with no
            // row is a refusal, never a silent skip.
            let mine = r.between(remote_head, local);
            let signed_trust = signing(repo);
            if signed_trust {
                let refusal = provenance_refusal(r, mine);
                if len(refusal) > 0 { return sync_failed(refusal); }
            }
            let mut chain = remote_head;
            let mut n = 0;
            let mut rest = mine;
            let mut broken = "";
            while len(rest) > 0 && len(broken) == 0 {
                let nl = std::str::index_of(rest, "\n");
                let c = if nl < 0 { rest } else { rest[0..nl] };
                if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
                if len(c) == 0 { continue; }
                let row = r.row_of(c);
                if len(row.kind) == 0 { broken = "local event " + c + " has no row"; continue; }
                // a row this clone signed is re-signed; one never signed is not
                let sign = signed_trust && r.signer(c).signed;
                let commit = r.build(chain, dna::Row { kind: row.kind, entity: row.entity, body: row.body, author: row.author }, sign, "Rebuilt-From: " + c);
                if len(commit) == 0 { broken = "re-append of " + c + " failed"; continue; }
                chain = commit;
                n = n + 1;
            }
            if len(broken) > 0 { return sync_failed(broken + "; the record was not changed"); }
            if !r.move_chain(JOURNAL, chain, local) {
                // this clone appended while the chain was built: the
                // record was not changed; go round with the new tail
                summary = "the record moved while reconciling";
                continue;
            }
            summary = "re-appended " + to_string(n) + " local event(s) onto the remote's " + to_string(count_lines(r.between(local, remote_head)));
        }
        if r.share(remote, SYNC_SHARES, "").ok {
            let h = r.head(JOURNAL).id;
            let t = r.move_chain(REMOTE_JOURNAL, h, "*");
            return SyncResult { ok: true, summary: summary };
        }
        // the remote moved again: receive and go round
        if !r.receive(remote, "journal").ok { return sync_failed("fetch failed"); }
    }
    if summary == "the record moved while reconciling" { return sync_failed(summary + " three times; nothing was changed — sync again"); }
    return SyncResult { ok: true, summary: summary };
}

// The membrane client, exec'd with routes to this project's sockets:
// one typed fact published, the organization decides.
//
// The routes are RELATIVE and the client runs in the project's root.
// A Unix address is at most 108 bytes, path included, and the
// organization binds these names relative to the same root — so an
// absolute route was the only long side: an ordinary project path
// (a home directory, a checkout, a worktree) pushed the client past
// the limit and it could not connect to sockets that were there and
// listening (the shakeout's finding 6).
fn publish_on_membrane(root: String, kind: String, body: String) -> String {
    let bin = std::env::var("HALE_DNA_MEMBRANE");
    if len(bin) == 0 { return "no membrane client (HALE_DNA_MEMBRANE unset)"; }
    let d = ".hale/dna/";
    let conf = "/tmp/hale-dna-membrane-" + to_string(std::process::pid()) + ".conf";
    let text = "dna.review.verdict = unix://" + d + VERDICT_SOCK + " : connect\n"
        + "dna.intent.offered = unix://" + d + INTENT_SOCK + " : connect\n"
        + "dna.expression.observed = unix://" + d + OBSERVED_SOCK + " : connect\n"
        + "dna.pressure.raised = unix://" + d + PRESSURE_SOCK + " : connect\n"
        + "dna.concern.raised = unix://" + d + CONCERN_SOCK + " : connect\n"
    // an organization scaffolded before practices has no such socket:
    // the route is named only for the fact that needs it
        + (if kind == "practice" { "dna.practice.requested = unix://" + d + PRACTICE_SOCK + " : connect\n" } else { "" })
        + (if kind == "knowledge-node" { "dna.knowledge.node.requested = unix://" + d + KNOWLEDGE_NODE_SOCK + " : connect\n" } else { "" })
        + (if kind == "knowledge-binding" { "dna.knowledge.binding.requested = unix://" + d + KNOWLEDGE_BINDING_SOCK + " : connect\n" } else { "" })
        + (if kind == "knowledge-edge" { "dna.knowledge.edge.requested = unix://" + d + KNOWLEDGE_EDGE_SOCK + " : connect\n" } else { "" });
    let wrote = write_text(conf, text) or false;
    if !wrote { return "cannot write " + conf; }
    let r = dna::run_tool("sh\n-c\ncd \"$1\" && LOTUS_BUS_CONFIG=\"$2\" exec \"$3\" \"$4\" \"$5\"\nsh\n" + root + "\n" + conf + "\n" + bin + "\n" + kind + "\n" + body);
    std::io::fs::unlink(conf) or discard;
    if r.code != 0 { return "membrane client failed: " + r.stderr; }
    return "";
}

// ---- the body lease (GH #617) ---------------------------------------
// A record admits one body at a time: the host that runs its organism
// holds the cell `lease/body` — at the remote when the record has one,
// so two hosts on two clones fence each other through the remote itself
// (the cell shared under compare-and-swap at the remote), and in the
// clone otherwise. The cell is the lease as `GitLeases` writes it:
// "holder\ntoken\nexpires\npresent". The holder is `user@host:<clone>`,
// so the same clone restarting is the same holder and takes its lease
// back at once, and a second clone — a second body — is refused until
// the lease expires or someone forces it. The host renews on tick and
// asserts the lease before every consequential act; a body whose lease
// is no longer its own stops (a partitioned server executes nothing
// past its TTL).
const BODY_LEASE: String = org_runtime::BODY_LEASE;
const BODY_LEASE_TRACK: String = org_runtime::BODY_LEASE_TRACK;
const BODY_TTL: Int = 30;
// The body fence stops the organism this many seconds before the lease
// it could last prove expires; another body can take the lease only once
// it has expired.
const FENCE_MARGIN: Int = org_runtime::FENCE_MARGIN;

type BodyLease {
    ok: Bool = true; // false: the remote could not be read (a partition)
    present: Bool = false;
    holder: String = "";
    token: Int = 0;
    expires: Int = 0;
    sha: String = ""; // the cell's version ("" = no lease)
}

fn body_holder(root: String) -> String {
    let user = std::env::var("USER");
    let h = dna::run_tool("hostname");
    let host = if h.code == 0 { dna::trim_nl(h.stdout) } else { "localhost" };
    let abs = dna::run_tool("sh\n-c\ncd \"$1\" && pwd -P\nsh\n" + root);
    let place = if abs.code == 0 { dna::trim_nl(abs.stdout) } else { root };
    return (if len(user) > 0 { user } else { "body" }) + "@" + host + ":" + place;
}

fn parse_body_lease(sha: String, text: String) -> BodyLease { let authority = org_runtime::HostAuthority { }; let l = authority.parse_lease(sha, text); return BodyLease { ok: l.ok, present: l.present, holder: l.holder, token: l.token, expires: l.expires, sha: l.sha }; }

fn lease_text(l: BodyLease) -> String {
    return l.holder + "\n" + to_string(l.token) + "\n" + to_string(l.expires) + "\n" + (if l.present { "1" } else { "0" });
}

// GH #646 stage 2: on routing 1 the body lease is a row of the store,
// swapped by its token through the service; `sha` carries the token.
fn body_in_store(repo: String) -> Bool { return routing_here(repo) > 0; }

fn store_leases(repo: String) -> dna::ServiceLeases {
    return dna::ServiceLeases { url: knowledge_url(repo) };
}

// GH #665: the store's key for this body's lease — one per owner over a
// shared record (`owner/<owner>`), `body` when the organization is the
// one owner. Its token is the epoch every write the body makes carries.
fn store_lease_key(root: String) -> String { let authority = org_runtime::HostAuthority { root: root }; return authority.lease_key(); }

fn body_lease_from_store(repo: String) -> BodyLease { let authority = org_runtime::HostAuthority { root: repo }; let l = authority.store_lease(); return BodyLease { ok: l.ok, present: l.present, holder: l.holder, token: l.token, expires: l.expires, sha: l.sha }; }

// The lease as the record's authority has it: the store's row on
// routing 1; the remote's cell when there is a remote (received now),
// the clone's otherwise. `ok` false when the authority could not be
// reached.
fn body_lease_read(repo: String) -> BodyLease { let authority = org_runtime::HostAuthority { root: repo }; let l = authority.body_lease(); return BodyLease { ok: l.ok, present: l.present, holder: l.holder, token: l.token, expires: l.expires, sha: l.sha }; }

// Write a lease where `expected` is the version the cell has now
// ("" = no lease): compare-and-swap at the remote (the cell shared with
// the version the remote must still hold) or in the clone. The clone's
// own cell mirrors what was written. False when someone else moved it
// first.
fn body_lease_write(repo: String, l: BodyLease, expected: String) -> Bool {
    if body_in_store(repo) {
        let sl = store_leases(repo);
        let expected_token = if len(expected) == 0 { 0 } else { std::str::parse_int(expected) or 0 };
        let key = store_lease_key(repo);
        return sl.put(key, dna::Lease { key: key, holder: l.holder, token: l.token, expires: l.expires, present: l.present }, expected_token);
    }
    let r = rec(repo);
    let remote = record_remote(repo);
    if len(remote) > 0 {
        if !r.swap(BODY_LEASE, lease_text(l), "*") { return false; }
        if !r.share(remote, BODY_LEASE, if len(expected) == 0 { "new" } else { expected }).ok { return false; }
        let t = r.move_chain(BODY_LEASE_TRACK, r.cell(BODY_LEASE).version, "*");
        return true;
    }
    return r.swap(BODY_LEASE, lease_text(l), expected);
}

fn body_live(l: BodyLease, now: Int) -> Bool { return l.present && l.expires > now; }

// Take the body lease for `holder`, or learn who holds it: a live
// lease of another holder is refused (present false, holder theirs),
// unless `force`. A refused acquire because of a partition is `ok`
// false.
fn body_acquire(repo: String, holder: String, now: Int, force: Bool) -> BodyLease {
    let cur = body_lease_read(repo);
    if !cur.ok { return cur; }
    if body_live(cur, now) && cur.holder != holder && !force {
        // theirs, not ours: `present` is false for the caller, `holder` says whose
        return BodyLease { present: false, holder: cur.holder, token: cur.token, expires: cur.expires, sha: cur.sha };
    }
    let l = BodyLease { present: true, holder: holder, token: cur.token + 1, expires: now + BODY_TTL };
    if !body_lease_write(repo, l, cur.sha) {
        let again = body_lease_read(repo);
        if !again.ok { return again; }
        if again.holder == holder && body_live(again, now) { return again; }
        return BodyLease { present: false, holder: again.holder, token: again.token, expires: again.expires, sha: again.sha };
    }
    let mine = body_lease_read(repo);
    return if mine.ok && mine.holder == holder && mine.token == l.token { mine } else { BodyLease { present: true, holder: holder, token: l.token, expires: l.expires, sha: rec(repo).cell(BODY_LEASE).version } };
}

// Renew a lease that is still ours; the renewed lease, or the lease as
// someone else now has it (present false for us), or `ok` false when
// the remote could not be reached — the caller keeps the lease it had
// until that one expires.
fn body_renew(repo: String, mine: BodyLease, now: Int) -> BodyLease {
    let cur = body_lease_read(repo);
    if !cur.ok { return cur; }
    if !(cur.present && cur.holder == mine.holder && cur.token == mine.token) {
        return BodyLease { present: false, holder: cur.holder, token: cur.token, expires: cur.expires, sha: cur.sha };
    }
    let l = BodyLease { present: true, holder: mine.holder, token: mine.token, expires: now + BODY_TTL };
    if !body_lease_write(repo, l, cur.sha) {
        let again = body_lease_read(repo);
        if !again.ok { return again; }
        // the write failed and the lease is still ours as it was: not lost,
        // only unrenewed — kept until it expires, like a partition
        if again.present && again.holder == mine.holder && again.token == mine.token { return BodyLease { ok: false }; }
        return BodyLease { present: false, holder: again.holder, token: again.token, expires: again.expires, sha: again.sha };
    }
    return BodyLease { present: true, holder: mine.holder, token: mine.token, expires: l.expires, sha: rec(repo).cell(BODY_LEASE).version };
}

// Give the lease up (present false, token kept so a late renewal of it
// is refused). True when it was ours to give up.
fn body_release(repo: String, mine: BodyLease) -> Bool {
    let cur = body_lease_read(repo);
    if !cur.ok || !cur.present || cur.holder != mine.holder || cur.token != mine.token { return false; }
    return body_lease_write(repo, BodyLease { present: false, holder: cur.holder, token: cur.token, expires: 0 }, cur.sha);
}

fn ago(secs: Int) -> String {
    if secs < 0 { return "just now"; }
    if secs < 90 { return to_string(secs) + "s ago"; }
    if secs < 5400 { return to_string(secs / 60) + "m ago"; }
    if secs < 172800 { return to_string(secs / 3600) + "h ago"; }
    return to_string(secs / 86400) + "d ago";
}

// The body line of `status` and `profile`: who runs this record's
// organism, from the lease alone.
fn body_line(repo: String, now: Int) -> String {
    let l = body_lease_read(repo);
    if !l.ok { return "unknown (the remote cannot be reached)"; }
    if len(l.holder) == 0 { return "none (no body has run this record; `hale dna run` takes the lease)"; }
    let ticked = ago(now - (l.expires - BODY_TTL));
    if body_live(l, now) { return "live on " + l.holder + ", ticked " + ticked + ", lease expires in " + to_string(l.expires - now) + "s"; }
    if l.present { return "stale: " + l.holder + " last ticked " + ticked + " and its lease has expired; `hale dna run` takes it, `hale dna body claim` says so"; }
    return "released by " + l.holder + "; `hale dna run` takes the lease";
}
