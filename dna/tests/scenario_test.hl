// dna/tests/scenario_test.hl — the operations of a changing organization,
// as scenarios that compose.
//
// A scenario is a list of steps over one fresh organism: a person's act
// (`open` a position with its mandate, `fill` it) or the Board's (`ratify`
// the last proposal), and what must then be true (`expect`). After every
// step the same invariants hold, whatever the scenario: every hold sits on
// a position the graph states; every position the graph states has a
// ratified mandate; reading the organization twice from the record gives
// the same organization. Every operation of one organism has a scenario
// here. An operation not built yet gets one too, listed in KNOWN_OPEN and
// asserted to fail at its verb (`known_open`): when it lands, its scenario
// passes and its entry goes. The table is empty; the habitat's operations
// (graft, extract, absorb, re-parent) span several records and come with
// saplings.
//
// Opening a position is one Board Review: its node and its mandate are two
// members of one family, ratified together.

import "../core" as dna;

// The scenarios, one step a line: `open <name> [under <node>] | <mandate>`
// and `fill <name> <holder>` (a batch's steps, read by the core's parser,
// dna/core/batch.hl), `ratify by <reviewer>`, `expect position|mandate
// <name>`, `expect holds <name> <holder>`, `refused <step>`; `#` is a
// comment. `apply {` … `}` proposes the steps between as ONE batch, one
// Board Review (`refused apply {` when the batch must be refused before it
// is proposed); `ratify batch by <reviewer>` decides the last batch, and
// `expect stale` that it was refused whole because its ground moved. Steps
// are proposed by `grace`, who may not ratify them.
const DEV_TEAM: String = "# a small dev team for a CRUD application
open api/dev | Decides: how the api is built, within its contract. May not: sign its own changes. Cites: the contract and the practices in force. Escalates: contract changes to the Board.
ratify by riley
expect position api/dev
expect mandate api/dev
open api/reviewer | Decides: whether a change to the api is ready. May not: write the change it reviews. Cites: the change, its evidence and the practices in force. Escalates: disagreements to the Board.
ratify by riley
fill api/dev ada
ratify by riley
expect holds api/dev ada
fill api/reviewer bo
ratify by riley
expect holds api/reviewer bo
";

const OPENED_ONCE: String = "# a position is opened once
open ops/operator | Decides: when the deployment runs. May not: change code. Cites: the readings. Escalates: incidents to the Board.
ratify by riley
expect position ops/operator
refused open ops/operator | Decides: it again.
refused open no-mandate |
";

const UNRATIFIED: String = "# nothing is in force until the Board says so
open web/dev | Decides: how the web client is built. May not: sign its own changes. Cites: the practices in force. Escalates: to the Board.
expect no-position web/dev
ratify by riley
expect position web/dev
";

const DEV_TEAM_BATCH: String = "# the same team, proposed as one batch and ratified once
apply {
open api/dev | Decides: how the api is built, within its contract. May not: sign its own changes. Cites: the contract and the practices in force. Escalates: contract changes to the Board.
open api/reviewer under position:api/dev | Decides: whether a change to the api is ready. May not: write the change it reviews. Cites: the change, its evidence and the practices in force. Escalates: disagreements to the Board.
fill api/dev ada
fill api/reviewer bo
}
expect no-position api/dev
ratify batch by riley
expect position api/dev
expect mandate api/reviewer
expect holds api/dev ada
expect holds api/reviewer bo
";

const BATCH_REFUSED: String = "# a batch is refused whole before anything is proposed
open ops/operator | Decides: when the deployment runs. May not: change code. Cites: the readings. Escalates: incidents to the Board.
ratify by riley
refused apply {
open ops/operator | Decides: it again.
}
refused apply {
fill ops/nobody ada
}
refused apply {
open web/dev | Decides: the web client.
open web/dev | Decides: it twice.
}
refused apply {
open web/dev under seed:nowhere | Decides: the web client.
}
refused apply {
fill ops/operator ada
fill ops/operator ada
}
expect no-position web/dev
";

const BATCH_STALE: String = "# a batch whose ground moved before the Board decided is refused whole
apply {
open ops/dev | Decides: how operations are automated. May not: run them. Cites: the runbooks. Escalates: to the Board.
fill ops/dev ada
}
open ops/dev | Decides: the same, opened alone. May not: run them. Cites: the runbooks. Escalates: to the Board.
ratify by riley
ratify batch by riley
expect stale
expect position ops/dev
";

const VACATED: String = "# a holder leaves: the position stays, the hold goes, once the Board says so
open api/dev | Decides: how the api is built. May not: sign its own changes. Cites: the contract. Escalates: to the Board.
ratify by riley
fill api/dev ada
ratify by riley
vacate api/dev ada
expect holds api/dev ada
ratify batch by riley
expect no-holds api/dev ada
expect position api/dev
refused vacate api/dev zed
refused apply {
fill api/dev bo
vacate api/dev bo
}
";

const TEAM_MERGES: String = "# two positions become one: holders and what it reviews carry over
state contract:spec/todo.md
apply {
open api/dev | Decides: how the api is built. May not: approve its own changes. Cites: the contract. Escalates: to the Board.
open api/reviewer | Decides: whether a change is ready. May not: write it. Cites: the change. Escalates: to the Board.
fill api/reviewer bo
assign api/reviewer reviews contract:spec/todo.md
}
ratify batch by riley
merge api/reviewer into api/dev
ratify batch by riley
expect no-position api/reviewer
expect holds api/dev bo
expect reviews position:api/dev contract:spec/todo.md
expect no reviews position:api/reviewer contract:spec/todo.md
refused merge api/dev into api/dev
refused close board
";

const TEAM_SPLITS: String = "# one position becomes two, each starting from its mandate, its holders and what it reviews
state seed:api
apply {
open api/dev | Decides: how the api is built. May not: approve its own changes. Cites: the contract. Escalates: to the Board.
fill api/dev ada
assign api/dev reviews seed:api
}
ratify batch by riley
split api/dev into api/frontend api/backend
ratify batch by riley
expect no-position api/dev
expect mandate api/frontend
expect mandate api/backend
expect holds api/frontend ada
expect holds api/backend ada
expect reviews position:api/backend seed:api
";

const ASSIGNED: String = "# a position reviews a contract, and stops
state contract:spec/todo.md
open api/reviewer | Decides: whether a change is ready. May not: write it. Cites: the change. Escalates: to the Board.
ratify by riley
assign api/reviewer reviews contract:spec/todo.md
ratify batch by riley
expect reviews position:api/reviewer contract:spec/todo.md
refused assign api/reviewer reviews contract:spec/nowhere.md
unassign api/reviewer reviews contract:spec/todo.md
ratify batch by riley
expect no reviews position:api/reviewer contract:spec/todo.md
";

const PACK: String = "# a pack: positions and the practices they work by, in force as one unit
apply {
open api/dev | Decides: how the api is built. May not: approve its own changes. Cites: the contract. Escalates: to the Board.
practice api/reviewed-before-merge | Every change to the api is approved by its reviewer before it merges.
practice ship-small | Work ships in the smallest change that is useful on its own.
}
ratify batch by riley
expect practice ship-small
expect practice api/reviewed-before-merge
expect mandate api/dev
refused apply {
practice ship-small | Proposed again while in force.
}
";

const NURSERY_TRUSTED: String = "# a nursery the Board trusts: its packs may be adopted
apply {
nursery https://github.com/hale-lang/nursery
}
ratify batch by riley
expect nursery https://github.com/hale-lang/nursery
refused apply {
nursery https://github.com/hale-lang/nursery
}
";

const REASSIGNED: String = "# an assignment taken back and given again in one batch stands
state seed:api
open api/reviewer | Decides: whether a change is ready. May not: write it. Cites: the change. Escalates: to the Board.
ratify by riley
assign api/reviewer reviews seed:api
ratify batch by riley
apply {
unassign api/reviewer reviews seed:api
assign api/reviewer reviews seed:api
}
ratify batch by riley
expect reviews position:api/reviewer seed:api
";

const EFFECTS_MOVED: String = "# a batch whose effects changed under it is refused whole: a consumer added meanwhile is kept
state seed:api
state seed:web
state seed:mobile
expose seed:api as contract:spec/api.md
ratify batch by riley
depend seed:web on contract:spec/api.md
depend seed:mobile on contract:spec/api.md
ratify batch by riley
ratify earlier batch by riley
expect stale
expect consumes seed:mobile contract:spec/api.md
expect no consumes seed:web contract:spec/api.md
";

const PACK_RETIRED: String = "# a pack retired: what it opened closes, its practices retire, and the rest stays
open ops/lead | Decides: what operations does next. May not: change code. Cites: the readings. Escalates: to the Board.
ratify by riley
apply {
open api/dev | Decides: how the api is built. May not: approve its own changes. Cites: the contract. Escalates: to the Board.
fill api/dev ada
fill ops/lead ada
practice api/reviewed-before-merge | Every change to the api is approved by its reviewer before it merges.
}
ratify batch by riley
expect practice api/reviewed-before-merge
retire-pack
ratify batch by riley
expect no-position api/dev
expect no practice api/reviewed-before-merge
expect no-holds ops/lead ada
expect position ops/lead
";

const EXPOSED: String = "# an internal capability gets a named contract, and a part relies on it
state seed:api
state seed:web
apply {
expose seed:api as contract:spec/api.md
depend seed:web on contract:spec/api.md
}
ratify batch by riley
expect serves seed:api contract:spec/api.md
expect consumes seed:web contract:spec/api.md
refused expose seed:web as contract:spec/api.md
refused depend seed:web on contract:spec/api.md
";

const EXTERNALIZED: String = "# a part leaves the organism, its positions with it; the organism depends on its contract; and comes back
state seed:billing
state seed:web
apply {
expose seed:billing as contract:spec/billing.md
depend seed:web on contract:spec/billing.md
open billing/dev under seed:billing | Decides: how billing is built. May not: approve its own changes. Cites: the contract. Escalates: to the Board.
fill billing/dev ada
}
ratify batch by riley
expect holds billing/dev ada
externalize seed:billing
ratify batch by riley
expect no-position billing/dev
expect no part seed:billing
expect outside contract:spec/billing.md billing
expect consumes seed:web contract:spec/billing.md
refused externalize seed:web
internalize contract:spec/billing.md as seed:billing
ratify batch by riley
expect part seed:billing
expect serves seed:billing contract:spec/billing.md
expect no outside contract:spec/billing.md billing
";

const KNOWN_OPEN: String = "";

main locus App {
    params {
        body: dna::Dna = dna::Dna { };
        repo: String = "";
        asks: Int = 0;
        last: String = ""; // the last proposal's digest
        last_batch: String = ""; // the last batch's family digest
        last_steps: String = ""; // and its steps
        prev_batch: String = ""; // the batch proposed before it
    }
    bus { publish dna::ReviewVerdict; }

    fn row_body(kind: String, entity: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.body.journal.revision() {
            let e = self.body.journal.read(i);
            if e.kind == kind && e.entity == entity { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    // The digests a ratification lands for a proposal: a family's members,
    // else the proposal itself.
    fn members(digest: String) -> String {
        let req = self.row_body("review.requested", "review:" + dna::knowledge_review_id(digest));
        let ideas = dna::native_json_string(req, "ideas");
        if len(ideas) == 0 { return digest + "\n"; }
        let mut out = "";
        let mut rest = ideas;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = if nl < 0 { rest } else { rest[0..nl] };
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            let sp = std::str::index_of(line, " ");
            if sp > 0 { out = out + line[(sp + 1)..len(line)] + "\n"; }
        }
        return out;
    }
    fn ratified_all(digests: String) -> Bool {
        let mut rest = digests;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let d = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if len(self.row_body("knowledge.ratified", d)) == 0 { return false; }
        }
        return true;
    }

    // ---- the organization, read from the record (the core's reader, the
    // one a batch is planned against): `position <id>`, `mandate <id>` and
    // `holds <id> <holder>` lines
    fn org() -> String { return dna::org_chart(self.body.journal, dna::GitReceipts { repo: self.repo }); }
    fn settled_all(digests: String) -> Bool {
        let mut rest = digests;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let d = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if len(self.row_body("knowledge.ratified", d)) == 0 && len(self.row_body("knowledge.refused", d)) == 0 { return false; }
        }
        return true;
    }
    // A batch proposed as the host proposes one (`hale dna apply`): planned,
    // its receipts kept, its rows appended, and its Review opened as a
    // running organization opens it when `graph.requested` is relayed.
    fn apply(text: String) -> String {
        let receipts = dna::GitReceipts { repo: self.repo };
        let plan = dna::batch_plan(self.body.journal, receipts, text);
        if !plan.ok { return "refused: " + plan.why; }
        self.asks = self.asks + 1;
        let id = "b" + to_string(self.asks);
        let filing = dna::batch_filing(plan, "grace", id, std::time::now(), "");
        if !filing.ok { return "not filed: " + filing.why; }
        let mut docs = filing.docs;
        while len(docs) > 0 {
            let nl = std::str::index_of(docs, "\n");
            let raw = receipts.store(docs[0..nl]);
            if len(raw) != 64 { return "a receipt was not kept"; }
            docs = docs[(nl + 1)..len(docs)];
        }
        let mut rows = filing.rows;
        while len(rows) > 0 {
            let nl = std::str::index_of(rows, "\n");
            let row = rows[0..nl];
            rows = rows[(nl + 1)..len(rows)];
            let r = self.body.journal.append(self.body.journal.revision(), std::json::find_string_field(row, "kind"), std::json::find_string_field(row, "entity"), std::json::find_string_field(row, "body"));
            if !r.ok { return "the record refused a row of the batch"; }
        }
        self.body.on_graph_requested(dna::GraphReviewRequest { request_id: id, review_id: filing.review_id, by: "grace" });
        if len(self.row_body("graph.proposed", id)) == 0 { return "the organization opened no Review for the batch"; }
        self.last = filing.digest;
        self.prev_batch = self.last_batch;
        self.last_batch = filing.digest;
        self.last_steps = plan.steps;
        return "";
    }

    // The invariants every step keeps; "" when they hold, else what broke.
    fn broken(org: String) -> String {
        if org != self.org() { return "reading the organization twice gave two organizations"; }
        let mut rest = org;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if std::str::starts_with(line, "holds ") {
                let tail = line[6..len(line)];
                let pos = tail[0..std::str::index_of(tail, " ")];
                if !std::str::contains(org, "position " + pos + "\n") { return "a hold on `" + pos + "`, which the graph does not state"; }
            }
            if std::str::starts_with(line, "position ") && !std::str::contains(org, "mandate " + line[9..len(line)] + "\n") { return "`" + line[9..len(line)] + "` has no ratified mandate"; }
        }
        return "";
    }

    // ---- the steps
    // What the step did: "" when it did what it says, else why not.
    fn step(line: String) -> String {
        if std::str::starts_with(line, "open ") || std::str::starts_with(line, "fill ") {
            let parsed = dna::batch_steps(line);
            if !parsed.ok { return "not a step: " + parsed.why; }
            let st = parsed.steps;
            let position = dna::batch_field(st, 1);
            self.asks = self.asks + 1;
            if dna::batch_field(st, 0) == "open" {
                let id = "p" + to_string(self.asks);
                self.body.on_position_requested(dna::PositionOpenRequest { request_id: id, position: position, text: "The position " + position[9..len(position)] + ".", mandate: dna::trim_nl(dna::batch_field(st, 3)), under: dna::batch_field(st, 2), by: "grace" });
                let proposed = self.row_body("position.proposed", id);
                if len(proposed) == 0 { return "not proposed: " + self.row_body("position.refused", id); }
                self.last = std::json::find_string_field(proposed, "digest");
                return "";
            }
            let id = "h" + to_string(self.asks);
            self.body.on_hold_requested(dna::HoldRequest { request_id: id, position: position, holder: dna::trim_nl(dna::batch_field(st, 2)), by: "grace" });
            let proposed = self.row_body("hold.proposed", id);
            if len(proposed) == 0 { return "not proposed: " + self.row_body("hold.refused", id); }
            self.last = std::json::find_string_field(proposed, "digest");
            return "";
        }
        if std::str::starts_with(line, "state ") {
            // a fixture's node, appended as the repository's graph states one
            let id = std::str::trim(line[6..len(line)]);
            let colon = std::str::index_of(id, ":");
            let r = self.body.journal.append(self.body.journal.revision(), "graph.node", id, "{\"kind\": \"" + id[0..colon] + "\", \"name\": \"" + id[(colon + 1)..len(id)] + "\"}");
            return if r.ok { "" } else { "the record refused the node" };
        }
        let first = if std::str::index_of(line, " ") > 0 { line[0..std::str::index_of(line, " ")] } else { line };
        if dna::dna_batch_verb(first) { return self.apply(line + "\n"); }
        if line == "retire-pack" {
            // the last batch adopted, undone as one batch, as `hale dna pack
            // retire` undoes a pack
            let inverse = dna::batch_inverse(self.body.journal, dna::GitReceipts { repo: self.repo }, self.last_steps);
            if len(inverse) == 0 { return "nothing to retire"; }
            return self.apply(inverse);
        }
        if std::str::starts_with(line, "vacate ") {
            // an operation of the batch alone: a one-step batch, as `hale dna
            // vacate` proposes it
            let why = self.apply(line + "\n");
            return why;
        }
        if std::str::starts_with(line, "ratify earlier batch by ") {
            // the batch proposed before the last: decided now, it is the one
            // `expect stale` reads
            if len(self.prev_batch) == 0 { return "no earlier batch"; }
            self.last_batch = self.prev_batch;
            return self.step("ratify batch by " + std::str::trim(line[24..len(line)]));
        }
        if std::str::starts_with(line, "ratify batch by ") {
            if len(self.last_batch) == 0 { return "no batch to ratify"; }
            let reviewer = std::str::trim(line[16..len(line)]);
            dna::ReviewVerdict <- dna::Verdict { review_id: dna::knowledge_review_id(self.last_batch), subject_digest: self.last_batch, verdict: "approve", reviewer: reviewer, authority: "board" };
            let wanted = self.members(self.last_batch);
            let mut tries = 0;
            while tries < 400 * dna::wait_scale() && !self.settled_all(wanted) {
                std::time::sleep(25ms);
                let moved = self.body.journal.refresh();
                tries = tries + 1;
            }
            return if self.settled_all(wanted) { "" } else { "not settled within the deadline" };
        }
        if line == "expect stale" {
            if len(self.last_batch) == 0 { return "no batch"; }
            let mut rest = self.members(self.last_batch);
            while len(rest) > 0 {
                let nl = std::str::index_of(rest, "\n");
                let d = rest[0..nl];
                rest = rest[(nl + 1)..len(rest)];
                if len(self.row_body("knowledge.ratified", d)) > 0 { return "a member of the stale batch was ratified: " + d; }
                if !std::str::contains(self.row_body("knowledge.refused", d), "the batch is stale") { return "a member was not refused as stale: " + d + " " + self.row_body("knowledge.refused", d); }
            }
            return "";
        }
        if std::str::starts_with(line, "ratify by ") {
            if len(self.last) == 0 { return "nothing to ratify"; }
            let reviewer = std::str::trim(line[10..len(line)]);
            dna::ReviewVerdict <- dna::Verdict { review_id: dna::knowledge_review_id(self.last), subject_digest: self.last, verdict: "approve", reviewer: reviewer, authority: "board" };
            let wanted = self.members(self.last);
            let mut tries = 0;
            while tries < 400 * dna::wait_scale() && !self.ratified_all(wanted) {
                std::time::sleep(25ms);
                let moved = self.body.journal.refresh();
                tries = tries + 1;
            }
            return if self.ratified_all(wanted) { "" } else { "not ratified within the deadline" };
        }
        if std::str::starts_with(line, "expect ") {
            let what = std::str::trim(line[7..len(line)]);
            let org = self.org();
            if std::str::starts_with(what, "no ") && !std::str::starts_with(what, "no-") { return if std::str::contains(org, what[3..len(what)] + "\n") { "still stated: " + what[3..len(what)] + "\nin\n" + org } else { "" }; }
            if std::str::starts_with(what, "nursery ") || std::str::starts_with(what, "reviews ") || std::str::starts_with(what, "serves ") || std::str::starts_with(what, "consumes ") || std::str::starts_with(what, "outside ") || std::str::starts_with(what, "part ") { return if std::str::contains(org, what + "\n") { "" } else { "not stated: " + what + "\nin\n" + org }; }
            if std::str::starts_with(what, "practice ") { return if std::str::contains(org, what + "\n") { "" } else { "not in force: " + what + "\nin\n" + org }; }
            if std::str::starts_with(what, "no-holds ") {
                let tail = what[9..len(what)];
                let sp = std::str::index_of(tail, " ");
                let held = "holds position:" + tail[0..sp] + " " + tail[(sp + 1)..len(tail)] + "\n";
                return if std::str::contains(org, held) { "still held: " + held } else { "" };
            }
            if std::str::starts_with(what, "no-position ") { return if std::str::contains(org, "position position:" + what[12..len(what)] + "\n") { "`" + what[12..len(what)] + "` is stated" } else { "" }; }
            if std::str::starts_with(what, "holds ") {
                let tail = what[6..len(what)];
                let sp = std::str::index_of(tail, " ");
                let want = "holds position:" + tail[0..sp] + " " + tail[(sp + 1)..len(tail)] + "\n";
                return if std::str::contains(org, want) { "" } else { "not held: " + want + "in\n" + org };
            }
            let sp = std::str::index_of(what, " ");
            let want = what[0..sp] + " position:" + what[(sp + 1)..len(what)] + "\n";
            return if std::str::contains(org, want) { "" } else { "missing: " + want + "in\n" + org };
        }
        if std::str::starts_with(line, "refused ") {
            let why = self.step(line[8..len(line)]);
            return if len(why) > 0 { "" } else { "was not refused" };
        }
        let sp = std::str::index_of(line, " ");
        return "not built: `" + (if sp < 0 { line } else { line[0..sp] }) + "`";
    }
    // A scenario on a fresh organism: "" when every step did what it says
    // and every invariant held after it, else the step and why.
    fn scenario(name: String, text: String) -> String {
        self.repo = dna::scratch_root("scenario-" + name);
        std::io::fs::mkdir(self.repo + "/.hale") or discard;
        std::io::fs::mkdir(self.repo + "/.hale/dna") or discard;
        let init = dna::run_tool("git\n-C\n" + self.repo + "\ninit\n-q\n-b\nmain");
        self.body = dna::Dna {
            journal: dna::GitJournal { repo: self.repo },
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: self.repo }, repo: self.repo },
            board: dna::Board { who: "board" }
        };
        self.last = "";
        let mut rest = text;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = std::str::trim(if nl < 0 { rest } else { rest[0..nl] });
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            if len(line) == 0 || std::str::starts_with(line, "#") { continue; }
            if line == "apply {" || line == "refused apply {" {
                let close = std::str::index_of(rest, "\n}");
                if close < 0 && !std::str::starts_with(rest, "}") { return line + ": no closing `}`"; }
                let block = if std::str::starts_with(rest, "}") { "" } else { rest[0..(close + 1)] };
                rest = if std::str::starts_with(rest, "}") { rest[1..len(rest)] } else { rest[(close + 2)..len(rest)] };
                if std::str::starts_with(rest, "\n") { rest = rest[1..len(rest)]; }
                let applied = self.apply(block);
                if line == "apply {" && len(applied) > 0 { return line + " " + block + ": " + applied; }
                if line == "refused apply {" && !std::str::starts_with(applied, "refused: ") { return "the batch was not refused before it was proposed:\n" + block + "(" + applied + ")"; }
                let broken_b = self.broken(self.org());
                if len(broken_b) > 0 { return "after the batch:\n" + block + broken_b; }
                continue;
            }
            let why = self.step(line);
            if len(why) > 0 { return line + ": " + why; }
            let broken = self.broken(self.org());
            if len(broken) > 0 { return "after `" + line + "`: " + broken; }
        }
        dna::scratch_done(self.repo);
        return "";
    }
    // A scenario the known-open table names: it fails, at its operation.
    fn known_open(name: String, text: String, verb: String) {
        let got = self.scenario(name, text);
        std::test::assert(std::str::contains(got, "not built: `" + verb + "`") && std::str::contains(KNOWN_OPEN, name + " " + verb + "\n"), "known open: `" + verb + "` is not built: " + got);
    }
    run() {
        std::test::assert_eq_str(self.scenario("dev-team", DEV_TEAM), "", "a small dev team is opened, filled and ratified, the invariants holding at every step");
        std::test::assert_eq_str(self.scenario("opened-once", OPENED_ONCE), "", "a stated position is not opened twice, and none opens without a mandate");
        std::test::assert_eq_str(self.scenario("unratified", UNRATIFIED), "", "nothing is in force until the Board ratifies it");
        std::test::assert_eq_str(self.scenario("dev-team-batch", DEV_TEAM_BATCH), "", "the dev team proposed as one batch is ratified once, whole");
        std::test::assert_eq_str(self.scenario("batch-refused", BATCH_REFUSED), "", "a batch that is wrong anywhere is refused before anything is proposed");
        std::test::assert_eq_str(self.scenario("batch-stale", BATCH_STALE), "", "a batch whose ground moved is refused whole when the Board decides it");
        std::test::assert_eq_str(self.scenario("vacated", VACATED), "", "a holder leaves through one Review; the position stays");
        std::test::assert_eq_str(self.scenario("pack", PACK), "", "a pack's positions and practices come into force as one unit");
        std::test::assert_eq_str(self.scenario("team-merges", TEAM_MERGES), "", "two positions become one, its holders and reviews carried over");
        std::test::assert_eq_str(self.scenario("team-splits", TEAM_SPLITS), "", "one position becomes two");
        std::test::assert_eq_str(self.scenario("assigned", ASSIGNED), "", "a position reviews a contract, and stops");
        std::test::assert_eq_str(self.scenario("exposed", EXPOSED), "", "a capability exposed as a contract, and a part depending on it");
        std::test::assert_eq_str(self.scenario("externalized", EXTERNALIZED), "", "a part externalized and internalized again");
        // the known-open table: each fails at the operation it names
        std::test::assert_eq_str(self.scenario("reassigned", REASSIGNED), "", "unassign then assign in one batch leaves the assignment");
        std::test::assert_eq_str(self.scenario("effects-moved", EFFECTS_MOVED), "", "a batch whose effects moved is refused whole, the newer consumer kept");
        std::test::assert_eq_str(self.scenario("nursery-trusted", NURSERY_TRUSTED), "", "a nursery is trusted by the Board, once");
        std::test::assert_eq_str(self.scenario("pack-retired", PACK_RETIRED), "", "a pack retired: what it brought leaves, what was there before stays");
    }
}
fn main() { App { }; }
