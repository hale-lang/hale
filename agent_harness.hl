// AgentHarness — the bridge between the active AgentBackend and
// the rest of iris.
//
// Phase 2a.1: holds an `EchoBackend` directly as a field (no
// plugin registry yet). Subscribes to UserPromptIn from the bus;
// dispatches to the active backend's `submit_user_input`. The
// backend's responses stream back via the AgentChunk / Agent*
// topics, which AgentPane will subscribe to in Phase 2a.2.
//
// When the plugin registry / manifest lands, the held backend
// field becomes plugin-resolved (interface-typed) instead of a
// concrete EchoBackend.

locus AgentHarness {
    params {
        backend: EchoBackend = EchoBackend { };
    }

    bus {
        subscribe UserPromptIn as on_user_input;
    }

    fn on_user_input(p: UserPrompt) {
        self.backend.submit_user_input(p.text);
    }

    fn submit_user_input(prompt: String) {
        // Direct call path — used by tests and by any caller that
        // bypasses the bus. Functionally identical to publishing
        // UserPromptIn.
        self.backend.submit_user_input(prompt);
    }

    fn backend_name() -> String { return self.backend.name(); }
}
