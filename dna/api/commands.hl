        b.string_field("position_id", "org"); b.string_field("recovery", "record_lifetime");
        b.string_field("command_origin", if usable_origin { origin } else { "" });
        if review { b.string_field("max_comment_bytes", "2048"); }
        else { b.string_field("module_path", "dna/org/main.hl"); b.string_field("max_source_bytes", "16384"); b.string_field("max_rationale_bytes", "2048"); b.string_field("max_request_bytes", "32768"); }
        b.string_field("reason", if !usable_origin { "Command submission has no configured origin." } else if self.bounded(capability.reason, 512, false, true) { capability.reason } else { "Source command capability is unavailable." });
        b.end_object(); return b.result();
    }
    fn inactive_organization(r: CommandReceipt) -> Bool {
