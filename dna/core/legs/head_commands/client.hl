    return "{\"state\":" + api_str(v.state) + ",\"attempt_id\":" + api_str(v.attempt_id) + ",\"work_id\":" + api_str(v.work_id) + ",\"task_id\":" + api_str(v.task_id) + ",\"performer_kind\":" + api_str(v.performer_kind) + ",\"holder\":" + api_str(v.holder) + ",\"token\":" + to_string(v.token) + ",\"until\":" + to_string(v.until) + ",\"disposition\":" + api_str(v.disposition) + ",\"reason\":" + api_str(v.reason) + ",\"event_id\":" + api_str(v.event_id) + ",\"allowance_micros\":" + to_string(v.allowance_micros) + "}";
}

fn api_dec_AttemptCommandOutcome(json: String) -> AttemptCommandOutcome {
    return AttemptCommandOutcome {
        state: std::json::find_string_field(json, "state"),
        attempt_id: std::json::find_string_field(json, "attempt_id"),
        work_id: std::json::find_string_field(json, "work_id"),
        task_id: std::json::find_string_field(json, "task_id"),
        performer_kind: std::json::find_string_field(json, "performer_kind"),
        holder: std::json::find_string_field(json, "holder"),
        token: std::json::find_int_field(json, "token"),
        until: std::json::find_int_field(json, "until"),
        disposition: std::json::find_string_field(json, "disposition"),
        reason: std::json::find_string_field(json, "reason"),
        event_id: std::json::find_string_field(json, "event_id"),
        allowance_micros: std::json::find_int_field(json, "allowance_micros"),
    };
}

type Claim {
