// Decision line 8 with decision L0-1, a failing child replaced from a
// sibling's handler (FailureDelivery, Reclaim). Shipped.
//
// The failing child is kept for its owner's supervision even when the
// owner replaces it first. `a` and `b` fail on two pools, one after the
// other; App's handler for `a` replaces `b` while `b`'s failure is posted
// to App and not delivered. That delivery can only run on App's thread,
// inside `a`'s handler, and handlers do not nest: the old `b`'s reclaim
// follows its own delivery instead of waiting for it. The field holds
// the new child at once; the old `b`'s handler runs after `a`'s returns,
// reads the old `b` whole (its dissolve has not run), and the old `b` is
// reclaimed right after that handler. The producer does not state it: it
// has no field replacement (inventory C29), so the plan is hand-written.
//
// Expected terminal outcome: `outcome: delivered-then-reclaimed`.

type Go { k: Int; }
topic Gos { payload: Go; subject: "lifecycle.l08.sibling"; }

fn gate(what: String) -> String {
    return "/tmp/hale-l08-sibling-" + what + "-" + to_string(std::process::pid());
}

locus Kid {
    params { tag: Int = 0; name: String = ""; }
    closure fuse { captures: tag; epoch inline; }
    bus { subscribe Gos as on_go; }
    birth() { self.name = "kid-" + to_string(self.tag); }
    fn on_go(g: Go) {
        if g.k == self.tag {
            if self.tag == 1 { std::io::fs::write_file(gate("posting"), "go") or discard; }
            violate fuse;
        }
    }
    dissolve() {
        if self.tag == 1 { std::io::fs::write_file(gate("dissolved"), "go") or discard; }
    }
}

main locus App {
    params { a: Kid = Kid { tag: 0 }; b: Kid = Kid { tag: 1 }; heard: Int = 0; seen: String = ""; }
    placement { a: cooperative(pool = left); b: cooperative(pool = right); }
    bus { publish Gos; }
    fn trigger() { Gos <- Go { k: 1 }; }
    on_failure(c: Kid, err: ClosureViolation) {
        if c.tag == 0 {
            self.trigger();
            while !std::io::fs::file_exists(gate("posting")) { std::time::sleep(1ms); }
            std::time::sleep(250ms);
            self.b = Kid { tag: 2 };
        } else if !std::io::fs::file_exists(gate("dissolved")) {
            self.seen = c.name + "/" + self.b.name;
        }
        self.heard = self.heard + 1;
    }
    run() {
        Gos <- Go { k: 0 };
        while self.heard < 2 { std::time::sleep(1ms); }
        if self.seen == "kid-1/kid-2" && std::io::fs::file_exists(gate("dissolved")) {
            println("outcome: delivered-then-reclaimed");
        } else {
            println("outcome: seen=" + self.seen);
        }
    }
    dissolve() {
        std::io::fs::unlink(gate("posting")) or discard;
        std::io::fs::unlink(gate("dissolved")) or discard;
    }
}

fn main() { App { }; }
