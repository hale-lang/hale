// dna/tests/legs_test.hl — the person leg, end to end (GH #946 slice 4).
//
// A judgment leaf's attempt is admitted by the engine and asked of a leg
// relay. The leg is `hale dna work`: the project's own program (its
// performers in dna/org/work.hl over the toolchain's legs seed), run as
// API clients against a real head — the practice_review API, spawned
// over the project's record. `next` claims for a position (the graph's
// `position:<name>` id, a worker as `#<n>`; asked again it is the same
// lease; a second position racing it is refused, exit 1); `brief` reads
// the hat, or renders it, recording the hat digest, the prompt digest
// and the renderer's version; `renew` extends the lease; `friction`
// files what got in the way; `submit` hands the outcome back with the
// hat it wore, twice is one act; the host's own relay carries it to the
// owner, and `settle` reads the settlement. `release` gives a lease back
// and the attempt is claimed anew under a new token; a leg that dies
// with a claim leaves it to expire, and the owner asks again. `run` is
// one cycle through the project's performers. Usage errors exit 2 before
// the head is asked; `hale mcp` exposes the verbs; the hands are tried on
// the project's own repository. With memory (HALE_DNA_MEMORY_DSN_OWNER)
// a pass runs again on an organism that adopted the ledger. No model, no
// nerves: the relay is in this process.

import "../core" as dna;
import "../core/legs" as legs;
import "../host" as host;
import "../operations" as ops;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// The head's binary: the one the suite names, else built from the source
// tree here, every run — a head left by an earlier build is an older head.
fn head_binary() -> String {
    if std::env::var_exists("HALE_NATIVE_HEAD_API") && std::io::fs::file_exists(std::env::var("HALE_NATIVE_HEAD_API")) { return std::env::var("HALE_NATIVE_HEAD_API"); }
    let source = if std::env::var_exists("HALE_DNA_SOURCE") { std::env::var("HALE_DNA_SOURCE") } else { "." };
    let seed = source + "/dna/api/practice_review";
    let built = dna::run_tool(toolchain() + "\nbuild\n" + seed);
    std::test::assert_eq_int(built.code, 0, "the head builds (HALE_DNA_SOURCE names the repository): " + built.stderr);
    return seed + "/practice_review";
}

fn relay_once(app: String) -> Int {
    let relay = host::NodeRelay { root: app, verb: "test", live: true, relayed: "\n" };
    let n = relay.relay(dna::Memory { repo: app, dsn_env: dna::own_dsn_env() });
    std::test::assert_eq_str(relay.error, "", "the relay published: " + relay.error);
    return n;
}

const FIXED_WORK: String = "// a deterministic performer for the fixture\nimport \"vendor/dna/legs\" as legs;\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { effect: \"idempotent\" }, deterministic: legs::FixedAnswer { kinds: \"agent\", effect: \"effect_free\", result: \"assessment: fixed\", narrative: \"a program answered\" }, model: legs::NoModel { } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";

const MODEL_WORK: String = "// the model leg over fakes, for the fixture\nimport \"vendor/dna\" as dna;\nimport \"vendor/dna/legs\" as legs;\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { effect: \"idempotent\" }, deterministic: legs::NoDeterministic { }, model: legs::ModelPerformer { effect: \"effect_free\", router: dna::ModelRouter { quick: dna::FakeModel { name: \"quick\", model: \"quick-1\", answer: \"assessment: the fake says ship it\" }, deep: dna::FakeModel { name: \"deep\", model: \"deep-1\", answer: \"assessment: the fake says ship it\" } } } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";
const THROTTLED_WORK: String = "// a rate-limited backend, for the fixture\nimport \"vendor/dna\" as dna;\nimport \"vendor/dna/legs\" as legs;\nlocus Throttled {\n    params { calls: Int = 0; }\n    bus { publish dna::ModelCalled; }\n    fn identity() -> String { return \"throttled\"; }\n    fn model_name() -> String { return \"throttled-1\"; }\n    fn allows(data_class: String) -> Bool { return true; }\n    fn capacity_bytes() -> Int { return 100000; }\n    fn works_in_place() -> Bool { return false; }\n    fn complete(req: dna::ModelRequest) -> dna::ModelResult {\n        self.calls = self.calls + 1;\n        let mut ev = dna::ModelEvidence { attempt_id: req.attempt_id, adapter: \"fake\", backend: \"throttled\", requested_model: \"throttled-1\", reported_model: \"throttled-1\", prompt_digest: req.prompt_digest, context_digest: dna::digest_of(req.context), data_class: req.data_class, retry_of: req.retry_of };\n        if self.calls == 1 { ev.refused = \"http 429 too many requests\"; dna::ModelCalled <- ev; return dna::ModelResult { ok: false, backend: \"throttled\", model: \"throttled-1\", refused: ev.refused }; }\n        ev.input_tokens = 7; ev.output_tokens = 3; ev.cost_micros = 1;\n        dna::ModelCalled <- ev;\n        return dna::ModelResult { ok: true, backend: \"throttled\", model: \"throttled-1\", output: \"assessment: ship it, after a breath\", tokens: 10, input_tokens: 7, output_tokens: 3, cost_micros: 1 };\n    }\n}\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { effect: \"idempotent\" }, deterministic: legs::NoDeterministic { }, model: legs::ModelPerformer { effect: \"effect_free\", backoff_ms: 100, router: dna::ModelRouter { quick: Throttled { }, deep: Throttled { } } } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";

// A deterministic performer that takes six seconds, for a worker ended
// mid-task; drained early it still holds the lease past the loop's grace.
const SLOW_WORK: String = "// a slow performer for the fixture\nimport \"vendor/dna/legs\" as legs;\nlocus Slow {\n    fn kind() -> String { return \"deterministic\"; }\n    fn effect_class() -> String { return \"idempotent\"; }\n    fn takes(performer_kind: String) -> Bool { return performer_kind == \"agent\"; }\n    @unbounded\n    fn perform(brief: legs::Brief, hands: legs::Hands) -> legs::Performance {\n        let until = std::time::monotonic_ns() + 6000000000;\n        while std::time::monotonic_ns() < until { std::time::sleep(100ms); }\n        return legs::Performance { disposition: \"done\", result: \"assessment: slowly\", renderer: legs::RENDERER_VERSION };\n    }\n}\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { effect: \"idempotent\" }, deterministic: Slow { }, model: legs::NoModel { } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";

// The lines of a text: one per newline-terminated line, plus a last one.
@unbounded
fn lines_in(text: String) -> Int {
    let mut n = 0; let mut i = 0;
    while i < len(text) { if text[i..(i + 1)] == "\n" { n = n + 1; } i = i + 1; }
    return if len(text) > 0 { n + 1 } else { 0 };
}

// A backend whose reply is lost — the connection went after the call
// was made — behind a performer of each effect class: the uncertain one
// leaves the attempt unresolved, the effect-free one hands back failed.
const LOST_WORK_UNCERTAIN: String = "// a backend that loses its reply, for the fixture\nimport \"vendor/dna\" as dna;\nimport \"vendor/dna/legs\" as legs;\nlocus Lost {\n    fn identity() -> String { return \"lost\"; }\n    fn model_name() -> String { return \"lost-1\"; }\n    fn allows(data_class: String) -> Bool { return true; }\n    fn capacity_bytes() -> Int { return 100000; }\n    fn works_in_place() -> Bool { return true; }\n    fn complete(req: dna::ModelRequest) -> dna::ModelResult { return dna::ModelResult { ok: false, backend: \"lost\", model: \"lost-1\", refused: \"connection reset by peer after the request was sent\" }; }\n}\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { effect: \"idempotent\" }, deterministic: legs::NoDeterministic { }, model: legs::ModelPerformer { effect: \"uncertain\", router: dna::ModelRouter { quick: Lost { }, deep: Lost { } } } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";
const LOST_WORK_FREE: String = "// a backend that loses its reply behind an effect-free performer\nimport \"vendor/dna\" as dna;\nimport \"vendor/dna/legs\" as legs;\nlocus Lost {\n    fn identity() -> String { return \"lost\"; }\n    fn model_name() -> String { return \"lost-1\"; }\n    fn allows(data_class: String) -> Bool { return true; }\n    fn capacity_bytes() -> Int { return 100000; }\n    fn works_in_place() -> Bool { return false; }\n    fn complete(req: dna::ModelRequest) -> dna::ModelResult { return dna::ModelResult { ok: false, backend: \"lost\", model: \"lost-1\", refused: \"connection reset by peer after the request was sent\" }; }\n}\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { effect: \"idempotent\" }, deterministic: legs::NoDeterministic { }, model: legs::ModelPerformer { effect: \"effect_free\", router: dna::ModelRouter { quick: Lost { }, deep: Lost { } } } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";
// A catalog with a performer that declares no class: refused at seed.
const UNSEATED_WORK: String = "// a person with no effect class, for the fixture\nimport \"vendor/dna/legs\" as legs;\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { }, deterministic: legs::NoDeterministic { }, model: legs::NoModel { } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";

locus App {
    params {
        app: String = "";
        api: String = "";
        with_memory: Bool = false;
        head: std::process::Child = std::process::Child { };
        core: dna::Dna = dna::Dna { verification: dna::HaleVerification { receipts: dna::FileReceipts { dir: "/tmp/dna-legs-placeholder" } } };
        journal: dna::RoutedJournal = dna::RoutedJournal { };
        asks: Int = 0;
    }
    // ---- the head over the record, watched: it dies with this process
    fn start_head() {
        let record = dna::GitRecord { repo: self.app };
        let policy = "{\"format\":\"dna.practice-review-authority/1\",\"application_id\":\"" + record.identity() + "\",\"grants\":[{\"mode\":\"local\",\"name\":\"riley\",\"authority\":\"board\",\"practice_propose\":false,\"review_verdict\":false,\"recover\":true}]}";
        std::io::fs::write_file(self.app + "/.hale/dna/authority.json", policy) or discard;
        let port = dna::free_port(46);
        self.api = "http://127.0.0.1:" + to_string(port);
        let argv = "sh\n-c\ncd \"$1\" && export USER=riley HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_COMMAND_POLICY=\"$1/.hale/dna/authority.json\" && unset HALE_DNA_MEMORY_DSN_OWNER HALE_DNA_MEMORY_DSN_SPINE && exec \"$2\" \"$1\" \"$3\" >\"$1/.hale/head.log\" 2>&1\nsh\n" + self.app + "\n" + head_binary() + "\n" + to_string(port);
        let child = std::process::spawn(argv) or std::process::Child { };
        self.head = std::process::Child { argv: argv, pid: child.pid, stdin_fd: child.stdin_fd, stdout_fd: child.stdout_fd, stderr_fd: child.stderr_fd };
        child.pid = -1; child.stdin_fd = -1; child.stdout_fd = -1; child.stderr_fd = -1;
        std::test::assert(self.head.pid > 0, "the head spawned");
        // a watcher outlives this process and kills the head once it is gone, however it went
        let watched = dna::run_tool("sh\n-c\n(while kill -0 \"$1\" 2>/dev/null; do sleep 1; done; kill \"$2\" 2>/dev/null) </dev/null >/dev/null 2>&1 &\nsh\n" + to_string(std::process::pid()) + "\n" + to_string(self.head.pid));
        let deadline = std::time::now() + dna::wait_secs(30);
        while std::time::now() < deadline {
            let up = dna::run_tool("curl\n-sf\n" + self.api + "/api/hale/v1/applications");
            if up.code == 0 { return; }
            let state = std::process::try_wait(self.head) or - 1;
            std::test::assert_eq_int(state, -2, "the head exited before listening: " + (std::io::fs::read_file(self.app + "/.hale/head.log") or ""));
            std::time::sleep(200ms);
        }
        std::test::assert(false, "the head did not come up: " + (std::io::fs::read_file(self.app + "/.hale/head.log") or ""));
    }
    fn stop_head() {
        if self.head.pid > 0 { std::process::kill(self.head) or discard; }
        self.head.pid = -1;
    }
    dissolve() { self.stop_head(); }
    // ---- the owner, in this process, asking a leg relay
    fn start_owner() {
        self.journal = dna::RoutedJournal { record: dna::GitJournal { repo: self.app }, ledger: dna::MemoryLedger { repo: self.app, dsn_env: dna::SPINE_DSN_ENV } };
        self.core = dna::Dna {
            journal: self.journal,
            work: dna::WorkSystem {
                agent: dna::LegRelay { name: "legs" }, agent_reconciler: dna::RelayReplay { },
                software: dna::LegRelay { name: "legs-software", performer_kind: "software" }, software_reconciler: dna::RelayReplay { }
            },
            verification: dna::HaleVerification { hale_bin: toolchain(), receipts: dna::GitReceipts { repo: self.app }, scratch: self.app + "/.hale/dna/scratch", repo: self.app },
            claims: dna::MemoryLeases { repo: self.app }, knowledge_client: dna::MemoryKnowledge { repo: self.app },
            org_id: "legs"
        };
        std::test::assert_eq_str(self.core.catalog.define("judge", 1, 1, "one judgment"), "", "judge");
        std::test::assert_eq_str(self.core.catalog.leaf("judge", 1, 0, "j", dna::WorkRequest { objective: "assess the storage migration", requires: "judgment", output_contract: "Assessment" }, 2), "", "j");
        // a chore requiring nothing in particular: the Work that admits every
        // effect class, an uncertain performer among them
        std::test::assert_eq_str(self.core.catalog.define("chore", 1, 1, "one chore"), "", "chore");
        std::test::assert_eq_str(self.core.catalog.leaf("chore", 1, 0, "c", dna::WorkRequest { objective: "run the storage migration", output_contract: "Report" }, 2), "", "c");
    }
    @unbounded
    fn count_rows(kind: String, entity: String) -> Int {
        let moved = self.journal.refresh();
        let mut n = 0; let mut i = 0;
        while i < self.journal.revision() { let e = self.journal.read(i); if e.kind == kind && e.entity == entity { n = n + 1; } i = i + 1; }
        return n;
    }
    fn has_row(kind: String, entity: String) -> Bool { return self.count_rows(kind, entity) > 0; }
    @unbounded
    fn row_body(kind: String, entity: String) -> String {
        let moved = self.journal.refresh();
        let mut out = ""; let mut i = 0;
        while i < self.journal.revision() { let e = self.journal.read(i); if e.kind == kind && e.entity == entity { out = e.body; } i = i + 1; }
        return out;
    }
    // The last row of a kind, whatever its entity.
    @unbounded
    fn last_of_kind(kind: String) -> String {
        let moved = self.journal.refresh();
        let mut out = ""; let mut i = 0;
        while i < self.journal.revision() { let e = self.journal.read(i); if e.kind == kind { out = e.body; } i = i + 1; }
        return out;
    }
    @unbounded
    fn wait_row(kind: String, entity: String, what: String) {
        let mut tries = 0;
        while tries < 400 * dna::wait_scale() && !self.has_row(kind, entity) { std::time::sleep(25ms); tries = tries + 1; }
        std::test::assert(self.has_row(kind, entity), what + ": no `" + kind + " " + entity + "` row within the deadline");
    }
    fn ask() -> String {
        self.asks = self.asks + 1;
        let t = self.core.run_workflow(dna::WorkflowAsk { id: "i" + to_string(self.asks), definition: "judge", revision: 1, from: "test" });
        let attempt = dna::attempt_id_of(t + "/wf1/s0/j", 0);
        self.wait_row("attempt.admitted", attempt, "the engine admits the attempt");
        self.wait_row("effect.requested", "attempt:" + attempt, "and asks the leg relay for it");
        return attempt;
    }
    // A chore asked of the organization: its Work admits every effect class.
    fn ask_chore() -> String {
        self.asks = self.asks + 1;
        let t = self.core.run_workflow(dna::WorkflowAsk { id: "i" + to_string(self.asks), definition: "chore", revision: 1, from: "test" });
        let attempt = dna::attempt_id_of(t + "/wf1/s0/c", 0);
        self.wait_row("attempt.admitted", attempt, "the engine admits the chore's attempt");
        self.wait_row("effect.requested", "attempt:" + attempt, "and asks the leg relay for it");
        return attempt;
    }
    // ---- the leg: `hale dna work …` in the project, against the head; its exit code checked
    fn work_rc(args: String, rc: Int) -> String {
        let r = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_API=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + self.app + "\n" + self.api + "\n" + toolchain() + "\ndna\nwork\n" + args);
        std::test::assert_eq_int(r.code, rc, "hale dna work " + std::str::replace(args, "\n", " ") + ": " + r.stdout + r.stderr);
        return dna::trim_nl(r.stdout);
    }
    fn work(args: String) -> String { return self.work_rc(args, 0); }
    // A loop is never left to run unbounded by the fixture: `timeout` ends it.
    fn work_timeout(secs: Int, args: String) -> String {
        let r = dna::run_tool_timeout(secs, "sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_API=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + self.app + "\n" + self.api + "\n" + toolchain() + "\ndna\nwork\n" + args);
        std::test::assert_eq_int(r.code, 0, "hale dna work " + std::str::replace(args, "\n", " ") + " (within " + to_string(secs) + "s): " + r.stdout + r.stderr);
        return dna::trim_nl(r.stdout);
    }
    fn loop_argv(args: String) -> String {
        return "sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_API=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + self.app + "\n" + self.api + "\n" + toolchain() + "\ndna\nwork\n" + args;
    }
    // The loop's exit within `secs`; -2 when it is still running.
    @unbounded
    fn loop_exit(c: std::process::Child, secs: Int) -> Int {
        let mut waited = 0;
        let mut code = std::process::try_wait(c) or - 1;
        while code == -2 && waited < secs * 10 { std::time::sleep(100ms); waited = waited + 1; code = std::process::try_wait(c) or - 1; }
        return code;
    }
    fn legs_running() -> String {
        let r = dna::run_tool("sh\n-c\npgrep -f \"$1/.hale/dna/legs/\" || true\nsh\n" + self.app);
        return dna::trim_nl(r.stdout);
    }
    fn attempt_of(answer: String) -> String { return std::json::find_field_raw(answer, "attempt"); }
    fn state_of(answer: String) -> String { return std::json::find_string_field(self.attempt_of(answer), "state"); }
    fn token_of(answer: String) -> String { return std::json::find_string_field(self.attempt_of(answer), "token"); }
    // ---- one pass of the verbs, as a worker of the position
    @unbounded
    fn pass(label: String, n: String) {
        let l = label + ": ";
        let me = "position:agent#" + n;
        let other = "position:editor#" + n;
        let a1 = self.ask();
        // next: the claim, for a position; asked again by the same worker it is the same lease
        let claimed = self.work("next\n--as\nposition:agent\n--holder\n" + me);
        std::test::assert_eq_str(self.state_of(claimed), "claimed", l + "next claims: " + claimed);
        std::test::assert_eq_str(std::json::find_string_field(self.attempt_of(claimed), "attempt_id"), a1, l + "the attempt that awaited a leg");
        std::test::assert_eq_str(std::json::find_string_field(self.attempt_of(claimed), "holder"), me, l + "held by the worker");
        let token = self.token_of(claimed);
        let again = self.work("next\n--as\nposition:agent\n--holder\n" + me);
        std::test::assert(self.state_of(again) == "claimed" && self.token_of(again) == token && std::json::find_string_field(self.attempt_of(again), "attempt_id") == a1, l + "next again is the same lease: " + again);
        // a second position racing it: refused with the receipt, exit 1
        let racing = self.work_rc("next\n--as\nposition:editor\n--holder\n" + other + "\n--kind\nagent", 1);
        std::test::assert(self.state_of(racing) == "refused" && std::str::contains(std::json::find_string_field(racing, "reason"), "held by another leg"), l + "a racing leg is refused: " + racing);
        // brief: the hat in the verb's envelope, and the hat rendered
        let briefed = self.work("brief\n--attempt\n" + a1);
        let hat = std::json::find_field_raw(briefed, "hat");
        std::test::assert(std::json::find_string_field(briefed, "verb") == "brief" && std::json::find_string_field(briefed, "state") == "ok", l + "the brief's envelope: " + briefed);
        std::test::assert_eq_str(std::json::find_string_field(hat, "work_id"), a1[0..(len(a1) - 3)], l + "the hat is the Work's");
        std::test::assert_eq_str(std::json::find_string_field(std::json::find_field_raw(hat, "position"), "id"), "position:agent", l + "for the position");
        let hat_digest = std::json::find_string_field(hat, "digest");
        let rendered = self.work("brief\n--attempt\n" + a1 + "\n--render\ntext");
        std::test::assert_eq_str(std::json::find_string_field(rendered, "hat_digest"), hat_digest, l + "the render records the hat's digest");
        std::test::assert_eq_str(std::json::find_string_field(rendered, "renderer"), "legs-render/1", l + "and the renderer's version");
        let prompt_digest = std::json::find_string_field(rendered, "prompt_digest");
        let watermark = std::json::find_string_field(rendered, "hat_watermark");
        std::test::assert(std::str::starts_with(prompt_digest, "sha256:"), l + "and the digest of what it rendered");
        std::test::assert(std::str::starts_with(std::json::find_string_field(rendered, "text"), "BRIEF " + a1[0..(len(a1) - 3)]), l + "a person's brief");
        let plain = self.work("brief\n--attempt\n" + a1 + "\n--render\nprompt\n--plain");
        std::test::assert(std::str::starts_with(plain, "You are position:agent"), l + "a prompt, plain: " + plain);
        std::test::assert_eq_str(dna::digest_of(plain + "\n"), std::json::find_string_field(self.work("brief\n--attempt\n" + a1 + "\n--render\nprompt"), "prompt_digest"), l + "rendering is a pure function of the hat and the mode");
        // renew (counted), friction
        let renewed = self.work("renew\n--as\nposition:agent\n--holder\n" + me + "\n--attempt\n" + a1 + "\n--token\n" + token + "\n--ttl\n900\n--renewal\n2");
        std::test::assert(self.state_of(renewed) == "renewed" && self.token_of(renewed) == token, l + "renew extends the lease and keeps the token: " + renewed);
        let filed = self.work("friction\n--as\nposition:agent\n--attempt\n" + a1 + "\n--text\nthe hat named no tool grant for a judgment");
        std::test::assert_eq_str(self.state_of(filed), "filed", l + "friction is filed: " + filed);
        std::test::assert(self.has_row("friction.filed", a1), l + "as a row on the attempt");
        // submit, twice one act; not released while it awaits the owner; relayed, settled
        std::io::fs::write_file(self.app + "/.hale/calls.json", "[{\"adapter\": \"person\", \"backend\": \"desk\", \"input_tokens\": 0, \"output_tokens\": 0, \"cost_micros\": 0}]") or discard;
        let outcome_args = "submit\n--as\nposition:agent\n--holder\n" + me + "\n--attempt\n" + a1 + "\n--token\n" + token + "\n--result\nassessment: ship it\n--narrative\nread it twice\n--evidence-file\n" + self.app + "/.hale/calls.json\n--hat-digest\n" + hat_digest + "\n--hat-head\n" + std::json::find_string_field(hat, "head") + "\n--hat-watermark\n" + watermark + "\n--prompt-digest\n" + prompt_digest;
        let submitted = self.work(outcome_args);
        std::test::assert_eq_str(self.state_of(submitted), "requested", l + "submit hands the outcome back: " + submitted);
        let twice = self.work(outcome_args);
        std::test::assert(self.state_of(twice) == "requested" && std::json::find_string_field(twice, "request_id") == std::json::find_string_field(submitted, "request_id"), l + "submit twice is one act: " + twice);
        let held = self.work_rc("release\n--as\nposition:agent\n--holder\n" + me + "\n--attempt\n" + a1 + "\n--token\n" + token + "\n--why\ntoo soon", 1);
        std::test::assert(std::str::contains(std::json::find_string_field(held, "reason"), "awaits the owner"), l + "the lease is not given back while the outcome awaits the owner: " + held);
        let requested = self.work("settle\n--attempt\n" + a1 + "\n--token\n" + token);
        std::test::assert_eq_str(self.state_of(requested), "requested", l + "not settled before the owner heard it");
        std::test::assert_eq_int(relay_once(self.app), 1, l + "the relay carries it");
        self.wait_row("attempt.outcome", a1, l + "the owner settles the attempt");
        let settled = self.work("settle\n--attempt\n" + a1 + "\n--token\n" + token + "\n--wait\n5");
        std::test::assert(self.state_of(settled) == "settled" && std::json::find_string_field(self.attempt_of(settled), "disposition") == "done", l + "settle reads the settlement: " + settled);
        let outcome = self.row_body("attempt.outcome", a1);
        std::test::assert(std::json::find_string_field(outcome, "hat_digest") == hat_digest && std::json::find_string_field(outcome, "prompt_digest") == prompt_digest && std::json::find_string_field(outcome, "renderer") == "legs-render/1", l + "the outcome records the hat, the prompt and the renderer: " + outcome);
        std::test::assert_eq_str(to_string(std::json::find_int_field(outcome, "hat_watermark")), watermark, l + "and the watermark the brief reported");
        // release: the lease given back, the attempt claimed anew under a new token
        let a2 = self.ask();
        let c2 = self.work("next\n--as\nposition:agent\n--holder\n" + me);
        std::test::assert(self.state_of(c2) == "claimed" && std::json::find_string_field(self.attempt_of(c2), "attempt_id") == a2, l + "the next attempt: " + c2);
        let released = self.work("release\n--as\nposition:agent\n--holder\n" + me + "\n--attempt\n" + a2 + "\n--token\n" + self.token_of(c2) + "\n--why\nout of time");
        std::test::assert_eq_str(self.state_of(released), "released", l + "release gives it back: " + released);
        std::test::assert(self.has_row("attempt.released", a2), l + "as a row");
        let c2b = self.work("next\n--as\nposition:editor\n--holder\n" + other + "\n--kind\nagent");
        std::test::assert(self.state_of(c2b) == "claimed" && std::json::find_string_field(self.attempt_of(c2b), "attempt_id") == a2, l + "another position claims it anew: " + c2b);
        std::test::assert(self.token_of(c2b) != self.token_of(c2), l + "under a new token: " + self.token_of(c2b) + " after " + self.token_of(c2));
    }
    // ---- what a single pass on the record adds: exit codes, a dead leg, run, mcp
    @unbounded
    fn extras() {
        // usage before the head: judged with the head unreachable, exit 2
        let free = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work next --as leg:free --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert_eq_int(free.code, 2, "a free string is no position, judged before the head: " + free.stdout + free.stderr);
        let words = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work renew --as position:agent --attempt x --token abc --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert_eq_int(words.code, 2, "a token that is not a number is a usage error: " + words.stdout + words.stderr);
        let down = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work next --as position:agent --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert(down.code == 1 && std::str::contains(down.stdout, "cannot be reached"), "a head that cannot be reached is exit 1 with the error: " + down.stdout);
        // nothing awaits: a refusal, exit 1, the receipt printed
        let none = self.work_rc("next\n--as\nposition:human", 1);
        std::test::assert(self.state_of(none) == "refused" && std::str::contains(std::json::find_string_field(none, "reason"), "none of that kind"), "a refusal prints the receipt and exits 1: " + none);
        // a leg that dies with its claim: the lease expires, the owner asks again, another leg claims
        let a3 = self.ask();
        let dying = self.work("next\n--as\nposition:leader\n--kind\nagent\n--ttl\n2");
        std::test::assert(self.state_of(dying) == "claimed" && std::json::find_string_field(self.attempt_of(dying), "attempt_id") == a3, "a short lease: " + dying);
        std::time::sleep(2500ms);
        let mut tries = 0;
        while tries < 40 * dna::wait_scale() && !self.has_row("effect.redelivered", "attempt:" + a3) { let n = self.core.redrive(); std::time::sleep(250ms); tries = tries + 1; }
        std::test::assert(self.has_row("effect.redelivered", "attempt:" + a3), "the lease expired with no outcome: the owner asks again");
        let anew = self.work("next\n--as\nposition:editor\n--kind\nagent");
        std::test::assert(self.state_of(anew) == "claimed" && std::json::find_string_field(self.attempt_of(anew), "attempt_id") == a3, "and another leg claims it: " + anew);
        // run: a person's cycle leaves the outcome to them (the model takes the
        // kind by default, so the person is asked for); a deterministic performer wins for its kind
        let a4 = self.ask();
        let person = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--performer\nperson");
        std::test::assert(std::json::find_string_field(person, "state") == "pending" && std::json::find_string_field(person, "performer") == "person" && std::json::find_string_field(person, "attempt_id") == a4, "a person's run is pending: " + person);
        std::test::assert(std::str::contains(std::json::find_string_field(person, "narrative"), "hale dna work submit"), "and says how to hand it back");
        std::io::fs::write_file(self.app + "/dna/org/work.hl", FIXED_WORK) or discard;
        let fixed = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--wait\n0");
        std::test::assert(std::json::find_string_field(fixed, "performer") == "deterministic" && std::json::find_string_field(fixed, "state") == "requested", "a deterministic performer wins for its kind and hands the outcome back: " + fixed);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a4, "and the owner settles it");
        let s4 = self.work("settle\n--request-id\n" + std::json::find_string_field(fixed, "request_id") + "\n--wait\n5");
        std::test::assert_eq_str(self.state_of(s4), "settled", "settled: " + s4);
        // the leg was built once per performers file: one build directory per key
        let builds = dna::run_tool("sh\n-c\nls -d \"$1\"/.hale/dna/legs/*/ | wc -l\nsh\n" + self.app);
        std::test::assert_eq_int(std::str::parse_int(dna::trim_nl(builds.stdout)) or 0, 2, "one leg per performers file, built once each: " + builds.stdout);
        // mcp: the verbs through this binary
        let listed = dna::run_tool("sh\n-c\nprintf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | \"$1\" mcp\nsh\n" + toolchain());
        std::test::assert(std::str::contains(listed.stdout, "hale_dna_work"), "hale mcp lists the leg's verbs: " + listed.stdout + listed.stderr);
    }
    // ---- the model leg and worker mode: the router behind the performer,
    // a rate-limited call backed off inside the attempt, --parallel children
    @unbounded
    fn worker() {
        // the model leg: the catalog's router behind the performer, out of process
        let a5 = self.ask();
        std::io::fs::write_file(self.app + "/dna/org/work.hl", MODEL_WORK) or discard;
        let modelled = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--wait\n0");
        std::test::assert(std::json::find_string_field(modelled, "performer") == "model" && std::json::find_string_field(modelled, "state") == "requested" && std::json::find_string_field(modelled, "attempt_id") == a5, "the model leg performs and hands the outcome back: " + modelled);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a5, "and the owner settles it");
        std::test::assert(self.has_row("model.called", a5), "the router's answer is the attempt's evidence, journaled by the owner");
        let s5 = self.work("settle\n--request-id\n" + std::json::find_string_field(modelled, "request_id"));
        std::test::assert(self.state_of(s5) == "settled" && std::json::find_string_field(self.attempt_of(s5), "disposition") == "done", "settled done: " + s5);
        // a performer forced on the leg: the person, though the model takes the kind
        let a6 = self.ask();
        let forced = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--performer\nperson");
        std::test::assert(std::json::find_string_field(forced, "performer") == "person" && std::json::find_string_field(forced, "state") == "pending" && std::json::find_string_field(forced, "attempt_id") == a6, "--performer person: the run is the person's: " + forced);
        let back = self.work("release\n--as\nposition:agent\n--holder\nposition:agent#9\n--attempt\n" + a6 + "\n--token\n" + std::json::find_string_field(forced, "token") + "\n--why\nthe fixture takes it back");
        std::test::assert_eq_str(self.state_of(back), "released", "and given back: " + back);
        // a rate-limited call: backed off inside the attempt, the wait recorded as
        // evidence; the attempt is the one given back, claimed anew under a new token
        let a7 = a6;
        std::io::fs::write_file(self.app + "/dna/org/work.hl", THROTTLED_WORK) or discard;
        let throttled = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--wait\n0");
        std::test::assert(std::json::find_string_field(throttled, "performer") == "model" && std::json::find_string_field(throttled, "state") == "requested" && std::json::find_string_field(throttled, "attempt_id") == a7 && std::json::find_string_field(throttled, "token") == "2", "the throttled leg takes the released attempt anew and still hands an outcome back: " + throttled);
        let requested7 = self.row_body("attempt.outcome_requested", a7);
        let calls7 = std::json::find_string_field(requested7, "calls");
        std::test::assert(std::str::contains(calls7, "backed off 100ms") && std::str::contains(calls7, "http 429") && std::str::contains(calls7, "lease renewed"), "the wait is evidence, naming the refusal and the lease kept meanwhile: " + calls7);
        std::test::assert(std::str::contains(calls7, "\"reported_model\": \"throttled-1\"") && std::str::contains(calls7, "\"input_tokens\": 7") && std::str::contains(calls7, "\"output_tokens\": 3"), "and the answer that followed is too, with the split the backend reported: " + calls7);
        std::test::assert(std::str::contains(calls7, "\"context_digest\": \"" + std::json::find_string_field(throttled, "hat_digest") + "\""), "the hat's digest is the context digest of every row: " + calls7);
        std::test::assert(self.has_row("attempt.claimed", a7) && self.count_rows("attempt.claimed", a7) >= 3, "the renewal landed as a claim row under the lease");
        std::test::assert(std::str::contains(std::json::find_string_field(requested7, "narrative"), "1 backed-off retries, 100ms waited"), "the narrative says what it cost in time: " + std::json::find_string_field(requested7, "narrative"));
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a7, "and settles");
        std::test::assert_eq_int(self.count_rows("model.called", a7), 3, "three rows of evidence journaled: the refusal, the wait, the answer");
        // worker mode: --parallel children, each its own holder, one task each
        std::io::fs::write_file(self.app + "/dna/org/work.hl", MODEL_WORK) or discard;
        let a8 = self.ask();
        let a9 = self.ask();
        let looped = self.work_timeout(120, "loop\n--as\nposition:agent\n--parallel\n2\n--once\n--wait\n0");
        std::test::assert(lines_in(looped) == 3 && std::str::starts_with(looped, "{\"verb\": \"loop\", \"worker\":"), "one JSON line per child, then the loop's own: " + looped);
        std::test::assert(std::str::contains(looped, "\"holder\": \"position:agent#1\"") && std::str::contains(looped, "\"holder\": \"position:agent#2\""), "two workers, each its own holder: " + looped);
        std::test::assert(std::str::contains(looped, "\"attempt_id\": \"" + a8 + "\"") && std::str::contains(looped, "\"attempt_id\": \"" + a9 + "\""), "each took one attempt: " + looped);
        std::test::assert(std::str::contains(looped, "\"state\": \"ended\", \"workers\": 2, \"ran\": 2"), "and the loop ended after one task each: " + looped);
        std::test::assert_eq_int(relay_once(self.app), 2, "both outcomes relayed");
        self.wait_row("attempt.outcome", a8, "the first settles");
        self.wait_row("attempt.outcome", a9, "and the second");
        // a loop with nothing to claim ends its --once children on the refusal
        let idle = self.work_timeout(60, "loop\n--as\nposition:agent\n--parallel\n1\n--once\n--only\nagent");
        std::test::assert(std::str::contains(idle, "\"state\": \"refused\"") && std::str::contains(idle, "\"ran\": 1"), "an idle worker's refusal is reported and the loop ends: " + idle);
        // a worker ended mid-task: SIGTERM to the loop drains it and ends its
        // child; the lease the child held expires and the owner asks again
        std::io::fs::write_file(self.app + "/dna/org/work.hl", SLOW_WORK) or discard;
        let built = self.work_rc("next\n--as\nposition:human", 1); // builds the slow leg (a refusal), so the loop below starts at once
        let a10 = self.ask();
        let running = std::process::spawn(self.loop_argv("loop\n--as\nposition:agent\n--parallel\n1\n--ttl\n3\n--wait\n0")) or std::process::Child { };
        std::test::assert(running.pid > 0, "the loop starts in the background");
        self.wait_row("attempt.claimed", a10, "its worker claims the attempt");
        std::process::signal(running, 15) or discard;
        let code10 = self.loop_exit(running, 15);
        let said10 = dna::trim_nl(std::process::read_stdout(running) or "");
        std::test::assert(code10 == 0 && std::str::contains(said10, "\"state\": \"ended\"") && std::str::contains(said10, "\"drained\": true"), "the loop drains on the signal and ends, its child ended: " + to_string(code10) + " " + said10);
        std::test::assert_eq_str(self.legs_running(), "", "no leg of this project is left running");
        std::test::assert(!self.has_row("attempt.outcome_requested", a10), "the child ended mid-task: no outcome");
        let mut t10 = 0;
        while t10 < 60 * dna::wait_scale() && !self.has_row("effect.redelivered", "attempt:" + a10) { let n = self.core.redrive(); std::time::sleep(250ms); t10 = t10 + 1; }
        std::test::assert(self.has_row("effect.redelivered", "attempt:" + a10), "the lease expired with no outcome: the owner asks again");
        // (the leader: the editor still holds a lease from the single pass, and a
        // claim by the same position would be that lease)
        let again = self.work("next\n--as\nposition:leader\n--kind\nagent");
        std::test::assert(self.state_of(again) == "claimed" && std::json::find_string_field(self.attempt_of(again), "attempt_id") == a10, "and another leg claims it: " + again);
        let closed10 = self.work("submit\n--as\nposition:leader\n--attempt\n" + a10 + "\n--token\n" + self.token_of(again) + "\n--result\nassessment: closed by the fixture");
        std::test::assert_eq_str(self.state_of(closed10), "requested", "and hands it back: " + closed10);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a10, "settled");
        // a running loop drained: the marker ends it once its children have
        std::io::fs::write_file(self.app + "/dna/org/work.hl", MODEL_WORK) or discard;
        let built2 = self.work_rc("next\n--as\nposition:human", 1);
        let idle_loop = std::process::spawn(self.loop_argv("loop\n--as\nposition:agent\n--parallel\n1\n--only\nagent\n--idle-ms\n500")) or std::process::Child { };
        std::test::assert(idle_loop.pid > 0, "an idle loop starts in the background");
        std::time::sleep(1500ms);
        let draining = self.work("loop\n--drain");
        std::test::assert(std::str::contains(draining, "\"state\": \"draining\"") && std::io::fs::file_exists(self.app + "/.hale/dna/legs/drain"), "--drain leaves the marker: " + draining);
        let code11 = self.loop_exit(idle_loop, 20);
        let said11 = dna::trim_nl(std::process::read_stdout(idle_loop) or "");
        std::test::assert(code11 == 0 && std::str::contains(said11, "\"drained\": true") && std::str::contains(said11, "\"state\": \"refused\""), "the running loop read the marker and ended after its idle child: " + to_string(code11) + " " + said11);
        std::test::assert_eq_str(self.legs_running(), "", "and nothing of it is left running");
        // usage judged before the head
        let many = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work loop --as position:agent --parallel 99 --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert_eq_int(many.code, 2, "--parallel out of range is a usage error before the head: " + many.stdout + many.stderr);
        let which = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work loop --as position:agent --performer oracle --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert_eq_int(which.code, 2, "--performer names one of the three: " + which.stdout + which.stderr);
        let which_run = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work run --as position:agent --performer oracle --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert_eq_int(which_run.code, 2, "for run too: " + which_run.stdout + which_run.stderr);
        // a forced performer that does not take the kind refuses, and the lease is given back
        std::io::fs::write_file(self.app + "/dna/org/work.hl", FIXED_WORK) or discard;
        let a12 = self.ask();
        let not_taken = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--performer\nmodel");
        std::test::assert(std::json::find_string_field(not_taken, "state") == "released" && std::str::contains(std::json::find_string_field(not_taken, "reason"), "does not take"), "a forced model that takes nothing of the kind refuses and releases: " + not_taken);
        let back12 = self.work("next\n--as\nposition:leader\n--kind\nagent");
        std::test::assert(self.state_of(back12) == "claimed" && std::json::find_string_field(self.attempt_of(back12), "attempt_id") == a12, "the attempt is claimable again: " + back12);
        let closed12 = self.work("submit\n--as\nposition:leader\n--attempt\n" + a12 + "\n--token\n" + self.token_of(back12) + "\n--result\nassessment: closed by the fixture");
        std::test::assert_eq_str(self.state_of(closed12), "requested", "and hands it back: " + closed12);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a12, "settled");
    }
    // ---- the effect classes: the filter, the seed, and what a lost reply becomes
    @unbounded
    fn effects() {
        // the judgment leaf admits effect_free and idempotent: an uncertain claim is refused, naming it
        let a13 = self.ask();
        let un = self.work_rc("next\n--as\nposition:leader\n--kind\nagent\n--effect\nuncertain", 1);
        std::test::assert(self.state_of(un) == "refused" && std::str::contains(std::json::find_string_field(un, "reason"), "not admitting a performer of effect class `uncertain`"), "a judgment admits no uncertain performer: " + un);
        let bad = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off && \"$2\" dna work next --as position:agent --effect maybe --api http://127.0.0.1:1\nsh\n" + self.app + "\n" + toolchain());
        std::test::assert_eq_int(bad.code, 2, "--effect names one of the three: " + bad.stdout + bad.stderr);
        // the hat says what the Work admits
        let hat = self.work("brief\n--attempt\n" + a13);
        std::test::assert_eq_str(std::json::find_string_field(std::json::find_field_raw(hat, "hat"), "effects"), "effect_free idempotent", "the hat carries the classes the Work admits: " + hat);
        // a performer that declares no class is refused when the leg is seeded
        std::io::fs::write_file(self.app + "/dna/org/work.hl", UNSEATED_WORK) or discard;
        let unseated = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_API=\"$3\" && \"$2\" dna work run --as position:agent --holder position:agent#9\nsh\n" + self.app + "\n" + toolchain() + "\n" + self.api);
        std::test::assert(unseated.code == 2 && std::str::contains(unseated.stderr, "declares no effect class"), "no default class, refused at seed: " + unseated.stdout + unseated.stderr);
        // a lost reply behind an uncertain performer, on a chore (a Work that
        // admits one; the routing policy hands it to a software leg): unresolved,
        // friction filed, the lease kept. The worker is the loop's own slot 1,
        // so the loop below meets the same lease.
        let a15 = self.ask_chore();
        std::io::fs::write_file(self.app + "/dna/org/work.hl", LOST_WORK_UNCERTAIN) or discard;
        let chore_hat = self.work("brief\n--attempt\n" + a15);
        std::test::assert_eq_str(std::json::find_string_field(std::json::find_field_raw(chore_hat, "hat"), "effects"), "effect_free idempotent uncertain", "a chore admits every class: " + chore_hat);
        let held = self.work_rc("run\n--as\nposition:software\n--holder\nposition:software#1\n--wait\n0", 1);
        std::test::assert(std::json::find_string_field(held, "state") == "unresolved" && std::json::find_string_field(held, "attempt_id") == a15 && std::json::find_string_field(held, "effect_class") == "uncertain", "an uncertain performer's lost reply is unresolved: " + held);
        std::test::assert(std::str::contains(std::json::find_string_field(held, "reason"), "connection reset") && std::json::find_string_field(held, "friction") == "filed", "friction is filed naming the loss: " + held);
        std::test::assert(!self.has_row("attempt.outcome_requested", a15), "nothing was handed back");
        let friction_body = self.last_of_kind("friction.filed");
        std::test::assert(std::str::contains(friction_body, "request work-submit:" + a15 + ":") && std::str::contains(friction_body, "unresolved"), "the friction names the request id: " + friction_body);
        let taken = self.work_rc("next\n--as\nposition:leader\n--kind\nsoftware", 1);
        std::test::assert(self.state_of(taken) == "refused", "the lease is kept, nobody else claims it: " + taken);
        // a loop over the same catalog stops its slot on the unresolved attempt
        let looped = self.work_timeout(60, "loop\n--as\nposition:software\n--parallel\n1\n--wait\n0");
        std::test::assert(std::str::contains(looped, "\"state\": \"unresolved\"") && std::str::contains(looped, "\"ran\": 1"), "the loop does not run an unresolved attempt again: " + looped);
        // the same loss behind an effect-free performer, on the judgment still
        // outstanding: a failed outcome, handed back
        let a14 = a13;
        std::io::fs::write_file(self.app + "/dna/org/work.hl", LOST_WORK_FREE) or discard;
        let failed = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--wait\n0");
        std::test::assert(std::json::find_string_field(failed, "state") == "requested" && std::json::find_string_field(failed, "attempt_id") == a14 && std::json::find_string_field(failed, "effect_class") == "effect_free", "an effect-free performer's lost reply is a failed outcome: " + failed);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a14, "and settled");
        std::test::assert(std::str::contains(self.row_body("attempt.outcome_requested", a14), "\"effect_class\": \"effect_free\""), "the class rides on the outcome");
        // the failed outcome spent one of the judgment's two attempts, so the
        // engine asks again; the retry is closed here, by a program that
        // answers, so a later pass finds only its own attempts outstanding
        let retry = a14[0..(len(a14) - 2)] + "a1";
        self.wait_row("attempt.admitted", retry, "the engine tries the judgment again");
        self.wait_row("effect.requested", "attempt:" + retry, "and asks a leg for it");
        std::io::fs::write_file(self.app + "/dna/org/work.hl", FIXED_WORK) or discard;
        let closed = self.work("run\n--as\nposition:agent\n--holder\nposition:agent#9\n--wait\n0");
        std::test::assert_eq_str(std::json::find_string_field(closed, "attempt_id"), retry, "the retry is the one claimed: " + closed);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", retry, "and settled");
    }
    // ---- the hands, on the project's own repository
    fn hands() {
        let git = legs::ScratchGit { };
        let wt = git.worktree(self.app, "HEAD");
        std::test::assert(wt.ok && !std::str::starts_with(wt.output, self.app), "a worktree in scratch, never the checkout: " + wt.error + wt.output);
        let applied = git.apply(wt.output, "--- /dev/null\n+++ b/legs-note.txt\n@@ -0,0 +1 @@\n+a leg was here\n");
        std::test::assert(applied.ok, "a patch applied: " + applied.error);
        let committed = git.commit(wt.output, "legs: a note");
        std::test::assert(committed.ok && len(committed.output) == 40, "committed, the sha answered: " + committed.error + committed.output);
        let dir = wt.output;
        git.clean();
        std::test::assert(!std::io::fs::file_exists(dir), "and cleaned away");
        let tools = legs::Toolchain { hale: toolchain() };
        std::test::assert(tools.check(self.app + "/dna/org").ok, "the toolchain checks the organization");
        let deploy = legs::NoDeploy { };
        let express = deploy.express("abc");
        std::test::assert(!express.ok && std::str::contains(express.error, "#987"), "deploy refuses, naming #987");
        let heart = legs::NoHeart { };
        let asked = heart.ask("/x", "");
        std::test::assert(!asked.ok && std::str::contains(asked.error, "#987"), "the heart refuses, naming #987");
    }
    @unbounded
    fn adopt() {
        let moved = self.journal.refresh();
        let b = std::json::Builder { };
        b.begin_object(); b.int_field("routing", dna::ROUTING_VERSION); b.string_field("by", "test"); b.end_object();
        let asked = self.journal.append(self.journal.revision(), "ledger.adopting", "ledger", b.result());
        std::test::assert(asked.ok, "adoption asked: " + asked.error);
        let adoption = dna::LedgerAdoption { root: self.app, ledger: dna::MemoryLedger { repo: self.app, dsn_env: dna::SPINE_DSN_ENV }, holder: "test" };
        let leases = dna::MemoryLeases { repo: self.app, dsn_env: dna::SPINE_DSN_ENV };
        std::test::assert_eq_int(adoption.tick(leases), 1, "the ledger adopted: " + adoption.last_error);
        self.start_owner();
    }
    run() {
        self.app = std::env::var("HALE_DNA_LEGS_APP");
        self.with_memory = std::env::var_exists("HALE_DNA_MEMORY_DSN_SPINE");
        std::test::assert(std::io::fs::file_exists(self.app + "/dna/org/work.hl"), "init generated the performers");
        std::test::assert(std::io::fs::file_exists(self.app + "/vendor/dna/legs/verbs.hl"), "and vendored the legs seed");
        self.start_owner();
        self.start_head();
        self.pass("record", "1");
        self.extras();
        self.worker();
        self.effects();
        self.hands();
        if self.with_memory {
            self.adopt();
            self.pass("adopted", "2");
            self.worker();
            let ledger = dna::MemoryLedger { repo: self.app, dsn_env: dna::HEAD_DSN_ENV };
            let mut i = 0; let mut claimed = 0;
            while i < ledger.revision() { if ledger.read(i).kind == "attempt.claimed" { claimed = claimed + 1; } i = i + 1; }
            std::test::assert(claimed >= 3, "the leg's rows are in the ledger once adopted: " + to_string(claimed) + " claimed");
        } else {
            eprintln("legs_test: no HALE_DNA_MEMORY_DSN_OWNER; the adopted ledger was not exercised");
        }
        self.stop_head();
    }
}

// Phase 1: the scratch project, memory migrated for its record when the
// suite hands one over, and phase 2 run with the roles named (the head
// takes the head's role from the environment it is spawned with).
fn main() {
    if std::env::var("HALE_DNA_LEGS_PHASE") == "2" { App { }; return; }
    let scratch = dna::scratch_root("legs");
    let made = in_dir(scratch, toolchain() + "\ndna\nnew\napp");
    std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
    let app = scratch + "/app";
    let u1 = in_dir(app, "git\nconfig\nuser.name\nriley");
    let u2 = in_dir(app, "git\nconfig\nuser.email\nriley@local");
    let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
    let identity = dna::GitRecord { repo: app }.identity();
    let mut env = "HALE_DNA_LEGS_PHASE=2\nHALE_DNA_LEGS_APP=" + app + "\nGIT_CONFIG_NOSYSTEM=1\nGIT_CONFIG_GLOBAL=/dev/null\nHALE_DNA_DISCOVER=off\n";
    if len(owner) > 0 {
        let spine = dna::migrated(owner, identity);
        std::test::assert(spine.ok, "memory migrated for the record: " + spine.why);
        let head = dna::migrated_head(owner, identity);
        std::test::assert(head.ok, "the head's role: " + head.why);
        env = env + "HALE_DNA_MEMORY_DSN_SPINE=" + dna::dsn_text(spine) + "\nHALE_DNA_MEMORY_DSN_HEAD=" + dna::dsn_text(head) + "\n";
    }
    let ran = dna::run_tool("env\n" + env + std::env::arg_or(0, ""));
    print(ran.stdout);
    if len(ran.stderr) > 0 { eprintln(ran.stderr); }
    if len(owner) > 0 { std::test::assert_eq_str(dna::unmigrate(owner, identity), "", "this run's schema and roles dropped"); }
    dna::scratch_done(scratch);
    std::process::exit(if ran.code < 0 { 1 } else { ran.code });
}
