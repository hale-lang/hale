// dna/api/habitat_placement.hl — the habitat's allocations placed on its
// hosts and applied there, as the head's Board commands (phase 4).
//
// Placement is the record's. `Commands::place_allocation` ("change a
// host") binds an allocation to a host: a `habitat.allocated` row naming
// the host and its provider (the host's), and nothing applies.
// `Commands::apply_allocations` applies them, every allocation or those of
// one host:
//   - the allocation rows are exported as the `--placement` file `hale
//     deploy render` takes (`<habitat>/placement.json`, `{instance, host,
//     provider, role}`), the seam the habitat's own fleet seed will render
//     through;
//   - each allocation whose placement moved is withdrawn where it was
//     applied, by that host's provider, and brought up where it is placed
//     (`Provider.apply`: compose here, ssh elsewhere), its new address kept
//     beside its files for everything that derives one (dna/core/placement.hl);
//   - what each provider observes after it is the pulse;
//   - and each apply is a `habitat.applied <key>/<role>` row.
// A moved memory or nerves allocation starts empty on its new host (there is
// no migration): a move of a memory that was applied, so holds its
// organism's record, is refused unless `fresh` says to start it empty. The
// habitat's head and face run with its body on this machine.
import "../core" as dna;

type AllocationPlace {
    allocation: String = "";
    host: String = "";
}

type ApplyAsk {
    host: String = "";
    fresh: Bool = false;
}

type PlaceReply {
    ok: Bool = false;
    code: String = "";
    why: String = "";
    allocation: String = "{}";
}

type ApplyReply {
    ok: Bool = false;
    code: String = "";
    why: String = "";
    // whether the habitat's own memory or nerves moved: its head and face
    // read their addresses at their start
    restart: Bool = false;
    // per allocation: allocation, host, provider, ok, why, state, detail
    applied: String = "[]";
}

// The roles a placement moves: the servers an organism's allocations run,
// and its own services. A heart's database and broker are tenants of its
// memory and nerves, and move with them; the habitat's head and face run
// with its body.
const PLACEABLE_ROLES: String = "memory nerves senses services";

// The allocation row `<key>/<role>` with its host, provider and project as
// `h` places it.
fn placed_body(body: String, h: dna::Host, key: String) -> String {
    let role = std::json::find_string_field(body, "role");
    let b = std::json::Builder { };
    b.begin_object();
    let mut it = std::json::object_first(body);
    while !it.done {
        let k = std::json::obj_key_string(it, body);
        if k != "host" && k != "provider" && k != "project" {
            b.field(k, std::json::obj_value_raw(it, body));
        }
        it = std::json::object_next(it, body);
    }
    b.string_field("host", h.name);
    b.string_field("provider", h.provider);
    // an organism's own services are a project of its own on the host
    b.string_field(
        "project",
        dna::placed_project(h.name) + (if role == "services" { "-" + key } else { "" }),
    );
    b.end_object();
    return b.result();
}

fn place_refused(code: String, why: String) -> PlaceReply {
    return PlaceReply { code: code, why: why };
}

fn habitat_place(root: String, a: AllocationPlace) -> PlaceReply {
    let j = habitat_journal(root);
    let latest = habitat_latest(j, "habitat.allocated");
    let held = latest.get(a.allocation) or LatestRow { };
    if held.at < 0 { return place_refused("not_found", "no allocation `" + a.allocation + "`"); }
    let body = j.read(held.at).body;
    let role = std::json::find_string_field(body, "role");
    if !dna::has_word(PLACEABLE_ROLES, role) {
        return place_refused(
            "not_placeable",
            "`" + role + "` is placed with what holds it: "
                + (if role == "database" || role == "broker" {
                    "its server's allocation"
                } else {
                    "the habitat's body, on this machine"
                }),
        );
    }
    if std::json::find_string_field(body, "provider") == "operator" {
        return place_refused(
            "not_placeable",
            "an allocation on the operator's server is adopted, never placed",
        );
    }
    let h = if a.host == "local" {
        dna::Host { name: "local", provider: "compose", state: "ready" }
    } else {
        dna::recorded_host(root, a.host)
    };
    if len(h.provider) == 0 || h.state == "removed" {
        return place_refused("not_found", "no host `" + a.host + "` was added");
    }
    if h.state != "ready" {
        return place_refused("host_not_ready", "host `" + a.host + "` is " + h.state);
    }
    if a.host != "local" && !dna::has_word(h.offers, "compose") {
        return place_refused("host_lacks", "host `" + a.host + "` does not offer compose");
    }
    let placed = placed_body(body, h, a.allocation[0..std::str::index_of(a.allocation, "/")]);
    let r = j.append(j.revision(), "habitat.allocated", a.allocation, placed);
    if !r.ok {
        return place_refused(
            "record_refused",
            "the habitat's record refused the row (" + r.error + ")",
        );
    }
    return PlaceReply { ok: true, allocation: placed };
}

// The `--placement` export: every allocation row as `{instance, host,
// provider, role}`, the shape `hale deploy render` takes.
@bounded_by(j)
fn placement_export(j: dna::Journal, latest: LatestRows) -> String {
    let out = std::json::Builder { };
    out.begin_array();
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        i = i + 1;
        if e.kind != "habitat.allocated" || !habitat_holds(latest, e.entity, i - 1) { continue; }
        let host = std::json::find_string_field(e.body, "host");
        if len(host) == 0 { continue; }
        out.begin_object();
        out.string_field("instance", e.entity);
        out.string_field("host", host);
        out.string_field("provider", std::json::find_string_field(e.body, "provider"));
        out.string_field("role", std::json::find_string_field(e.body, "role"));
        out.end_object();
    }
    out.end_array();
    return out.result();
}

// The render of an organism's own services (`role` `services`): its compose
// file, in the project its placement names.
fn services_render(body: String) -> dna::Render {
    return dna::Render {
        project: std::json::find_string_field(body, "project"),
        dir: std::json::find_string_field(body, "render_dir"),
        files: std::json::find_string_field(body, "render_files"),
    };
}

// One allocation brought to where its row places it: withdrawn where it was
// applied when that is elsewhere (a memory that was applied only with
// `fresh`), its data forgotten there first when `fresh`, applied, kept,
// observed, and recorded. The reply's entry, and whether the habitat's own
// memory or nerves moved.
fn apply_one(
    root: String,
    j: dna::RecordJournal,
    entity: String,
    body: String,
    fresh: Bool,
    out: std::json::Builder
) -> Bool {
    let slash = std::str::index_of(entity, "/");
    let key = entity[0..slash];
    let role = std::json::find_string_field(body, "role");
    let host = std::json::find_string_field(body, "host");
    let provider = std::json::find_string_field(body, "provider");
    let was = dna::placed_on(key, role);
    let target = dna::AppliedOn {
        host: if len(host) == 0 { "local" } else { host },
        provider: provider,
        address: if host == "local" || len(host) == 0 {
            ""
        } else {
            dna::recorded_host(root, host).address
        },
        project: if (host == "local" || len(host) == 0) && role != "services" {
            dna::local_habitat_project()
        } else {
            std::json::find_string_field(body, "project")
        },
    };
    // an organism's own services never applied are applied nowhere yet
    let moved = was.host != target.host
        && (role != "services" || std::io::fs::file_exists(dna::placed_path(key, role)));
    let mut ok = true;
    let mut why = "";
    if moved && role == "memory" && key == dna::allocation_key(root) {
        ok = false;
        why = "habitat_record: the habitat's own memory holds its record, the one that places everything: it is not moved (a moved memory starts empty, and there is no migration)";
    } else if moved && role == "memory" && !fresh {
        ok = false;
        why = "memory_holds_rows: the memory on " + was.host
            + " holds the organism's record, and a moved memory starts empty on its new host (there is no migration): apply with --fresh to start it empty there";
    }
    if ok && moved {
        let gone = if role == "services" {
            let mut r = services_render(body);
            r.project = was.project;
            if was.host == "local" {
                dna::ComposeProvider { }.withdraw("local", r)
            } else {
                dna::SshProvider { root: root }.withdraw(was.host, r)
            }
        } else {
            dna::placed_withdraw(key, role, was)
        };
        // nothing ran there yet is nothing to take down
        if !gone.ok && !std::str::contains(gone.why, "no such service") {
            why = "withdrawn from " + was.host + ": " + gone.why + "; ";
        }
        if fresh && role != "services" {
            let forgot = dna::placed_forget(key, role, target);
        }
    }
    let applied = if !ok {
        dna::RenderApplied { why: why }
    } else if role == "services" {
        let kept = dna::place_cache(key, role, target);
        if target.host == "local" {
            dna::ComposeProvider { }.apply("local", services_render(body))
        } else {
            dna::SshProvider { root: root }.apply(target.host, services_render(body))
        }
    } else {
        let kept = dna::place_cache(key, role, target);
        dna::placed_apply(key, role)
    };
    if ok && !applied.ok {
        // the placement it was applied at stays the one in force
        let back = dna::place_cache(key, role, was);
    }
    let a = dna::Allocation {
        role: role,
        instance: key,
        provider: provider,
        host: target.host,
        project: target.project,
        service: if role == "services" {
            ""
        } else {
            dna::compose_service(dna::placed_role(role), key)
        },
        placed: true,
    };
    let seen = if !applied.ok {
        dna::AllocationState { detail: applied.why }
    } else if target.host == "local" {
        if role == "services" {
            dna::AllocationState { state: "up", detail: "applied" }
        } else {
            dna::ComposeProvider { }.observe(a)
        }
    } else if role == "services" {
        dna::AllocationState { state: "up", detail: "applied" }
    } else {
        dna::SshProvider { root: root }.observe(a)
    };
    let row = std::json::Builder { };
    row.begin_object();
    row.string_field("host", target.host);
    row.string_field("provider", provider);
    row.bool_field("ok", applied.ok);
    row.string_field("why", why + applied.why);
    row.string_field("state", seen.state);
    row.bool_field("fresh", fresh && moved);
    row.end_object();
    let recorded = j.append(j.revision(), "habitat.applied", entity, row.result());
    out.begin_object();
    out.string_field("allocation", entity);
    out.string_field("host", target.host);
    out.string_field("provider", provider);
    out.bool_field("ok", applied.ok);
    out.string_field("why", why + applied.why);
    out.string_field("state", seen.state);
    out.string_field("detail", seen.detail);
    out.end_object();
    return applied.ok;
}

fn habitat_apply(root: String, a: ApplyAsk) -> ApplyReply {
    let j = habitat_journal(root);
    let latest = habitat_latest(j, "habitat.allocated");
    // the seam: the rows as the `--placement` file a render takes
    let habitat_dir = dna::local_habitat_dir();
    std::io::fs::write_file(
        habitat_dir + "/placement.json",
        placement_export(j, latest),
    ) or discard;
    let own = dna::allocation_key(root);
    let out = std::json::Builder { };
    out.begin_array();
    let mut all_ok = true;
    let mut restart = false;
    let mut moved_any = false;
    let n = j.revision();
    let mut i = 0;
    while i < n {
        let e = j.read(i);
        i = i + 1;
        if e.kind != "habitat.allocated" || !habitat_holds(latest, e.entity, i - 1) { continue; }
        let role = std::json::find_string_field(e.body, "role");
        if !dna::has_word(PLACEABLE_ROLES, role) { continue; }
        if std::json::find_string_field(e.body, "provider") == "operator" { continue; }
        let host = std::json::find_string_field(e.body, "host");
        let slash = std::str::index_of(e.entity, "/");
        let key = e.entity[0..slash];
        let was = dna::placed_on(key, role).host;
        // one host's: what is placed there, and what leaves it
        if len(a.host) > 0 && host != a.host && was != a.host { continue; }
        let moved = was != (if len(host) == 0 { "local" } else { host });
        if !apply_one(root, j, e.entity, e.body, a.fresh, out) { all_ok = false; }
        if moved && key == own && (role == "memory" || role == "nerves") { restart = true; }
        if moved && key != own && (role == "memory" || role == "nerves") { moved_any = true; }
    }
    out.end_array();
    return ApplyReply {
        ok: all_ok,
        code: if all_ok { "" } else { "not_applied" },
        why: if moved_any {
            "an organism whose memory or nerves moved derives the new address at `hale habitat migrate <organism>`; a memory started empty holds no record, and the organism is grafted again"
        } else {
            ""
        },
        restart: restart,
        applied: out.result(),
    };
}

// ---- a graft, as the Board's command ---------------------------------------
//
// `Commands::graft` grafts a sapling the habitat pins, by name, on the host
// it names (`local` or "" for this machine): the act `hale habitat graft
// <sapling> --host <name>` is, run by the head with the toolchain that
// launched it (`--no-head`: the act itself, never a call back to the head).
// A graft takes minutes, so the command starts it and answers at once with
// where it writes what it says (`log`) and, when it ends, its exit status
// (`<log>.exit`); its end is the `habitat.grafted` row it records.

type GraftAsk {
    sapling: String = "";
    host: String = "";
    library: Bool = true;
}

type GraftReply {
    ok: Bool = false;
    code: String = "";
    why: String = "";
    log: String = "";
}

fn habitat_graft(root: String, a: GraftAsk) -> GraftReply {
    let name = a.sapling;
    if len(name) == 0 || len(name) > 128 || std::str::contains(name, "/")
        || std::str::starts_with(name, "-") || std::str::contains(name, " ")
        || std::str::contains(name, "\n")
    {
        return GraftReply { code: "invalid_sapling", why: "a sapling is named by one word" };
    }
    if std::str::starts_with(a.host, "-") || std::str::contains(a.host, " ")
        || std::str::contains(a.host, "\n")
    {
        return GraftReply { code: "invalid_host", why: "a host is named by one word" };
    }
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let dir = dna::local_habitat_dir() + "/grafts";
    if dna::run_tool("mkdir\n-p\n-m\n700\n" + dir).code != 0 {
        return GraftReply { code: "not_started", why: "cannot make " + dir };
    }
    let log = dir + "/" + name + ".log";
    std::io::fs::unlink(log + ".exit") or discard;
    let mut args = name + "\n--no-head";
    if len(a.host) > 0 && a.host != "local" { args = args + "\n--host\n" + a.host; }
    if !a.library { args = args + "\n--no-library"; }
    // the act runs as the operator's own command would, detached: none of
    // the head's own memory, nerves or socket reaches it (the child derives
    // its own), and its exit status lands beside its log
    let started = dna::run_tool(
        "sh\n-c\nlog=\"$1\"; shift; for v in $(env | sed -n 's/^\\(HALE_DNA_MEMORY_DSN_[A-Z_]*\\)=.*/\\1/p; s/^\\(HALE_DNA_NATS_[A-Z_]*\\)=.*/\\1/p; s/^\\(HALE_DNA_RPC_SOCKET\\)=.*/\\1/p'); do unset \"$v\"; done; ( \"$@\" >\"$log\" 2>&1 </dev/null; echo $? >\"$log.exit\" ) >/dev/null 2>&1 &\nsh\n"
            + log + "\n" + hale + "\nhabitat\ngraft\n" + args,
    );
    if started.code != 0 {
        return GraftReply { code: "not_started", why: dna::trim_nl(started.stderr) };
    }
    return GraftReply { ok: true, code: "started", log: log };
}
