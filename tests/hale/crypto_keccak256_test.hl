// tests/hale/crypto_keccak256_test.hl — `std::crypto::keccak256`, the
// original Keccak-256 (padding byte 0x01, the hash Ethereum uses), not
// FIPS 202's SHA3-256 (padding 0x06), which answers differently for the
// same input. Vectors: the empty input, "abc", a one-block sentence, the
// block-boundary lengths (135 bytes, where one byte carries both ends of
// the padding, and 136, a whole 136-byte block followed by a block of
// padding alone), a two-block input, a million bytes, and the EIP-155
// example transaction's signing hash.

fn hex(s: String) -> Bytes {
    return std::hex::decode(s) or b"";
}

fn k(b: Bytes) -> String {
    return std::hex::encode(std::crypto::keccak256(b));
}

fn a_times(n: Int) -> Bytes {
    return std::bytes::from_string(std::str::repeat("a", n));
}

fn main() {
    std::test::assert_eq_str(
        k(b""),
        "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470",
        "the empty input",
    );
    std::test::assert(
        k(b"") != "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a",
        "is not SHA3-256's",
    );
    std::test::assert_eq_str(
        k(b"abc"),
        "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45",
        "abc",
    );
    std::test::assert_eq_str(
        k(b"The quick brown fox jumps over the lazy dog"),
        "4d741b6f1eb29cb2a9b9911c82f56fa8d73b04959d3d9d222895df6c0b28aa15",
        "one block",
    );
    std::test::assert_eq_str(
        k(a_times(135)),
        "34367dc248bbd832f4e3e69dfaac2f92638bd0bbd18f2912ba4ef454919cf446",
        "135 bytes: the padding in one byte",
    );
    std::test::assert_eq_str(
        k(a_times(136)),
        "a6c4d403279fe3e0af03729caada8374b5ca54d8065329a3ebcaeb4b60aa386e",
        "136 bytes: a whole block, then a block of padding",
    );
    std::test::assert_eq_str(
        k(a_times(200)),
        "96ea54061def936c4be90b518992fdc6f12f535068a256229aca54267b4d084d",
        "200 bytes: two blocks",
    );
    std::test::assert_eq_str(
        k(a_times(1000000)),
        "fadae6b49f129bbb812be8407b7b2894f34aecf6dbd1f9b0f0c7e9853098fc96",
        "a million bytes",
    );
    // EIP-155's example: the RLP of (nonce 9, gas price 20 gwei, gas
    // 21000, to 0x3535..35, value 1 ether, no data, chain id 1, 0, 0).
    std::test::assert_eq_str(
        k(
            hex(
                "ec098504a817c800825208943535353535353535353535353535353535353535880de0b6b3a764000080018080",
            ),
        ),
        "daf5a779ae972f972197303d7b574746c7ef83eadac0f2791ad23db92e4c8e53",
        "the EIP-155 example's signing hash",
    );
}
