// The change log: every applied admin write, who made it (nobody yet:
// admin authentication is off), when, and the resource before and after.

/// `Change`. `before` and `after` are the resource's JSON: the codec carries
/// no free-form object, so the text crosses as a string.
type Change {
    id: String = "";
    at: Time = `1970-01-01T00:00:00Z`;
    // who made it: nobody yet, admin authentication is off
    has_principal: Bool = false;
    principal: String = "";
    action: ChangeAction;
    target: String = "";
    has_before: Bool = false;
    before: String = "";
    has_after: Bool = false;
    after: String = "";
}

/// A page of changes; `next_cursor` is `null` on the last.
type ChangeList { data: bounded[Change; 1000]; has_next_cursor: Bool = false; next_cursor: String = ""; }

locus Changes {
    params { store: st::Store; }

    /// `listChanges`: newest first.
    fn list(q: st::ChangeQuery) -> ChangeList fallible(ApiError) {
        let rows = self.store.changes(q) or fail store_failed(err);
        if !rows.cursor_known { fail invalid("`cursor` names no change; pass a page's `next_cursor`", "cursor"); }
        let mut out = ChangeList { };
        let mut last = "";
        for c in rows.rows {
            push(out.data, Change { id: c.id, at: c.at, action: action_of(c.action), target: c.target, has_before: len(c.before) > 0, before: c.before, has_after: len(c.after) > 0, after: c.after }) or discard;
            last = c.id;
        }
        if rows.more {
            out.has_next_cursor = true;
            out.next_cursor = last;
        }
        return out;
    }
}

/// A change made now. `before` and `after` are JSON, "" for `null`.
fn change(action: String, target: String, before: String, after: String) -> st::ChangeRow {
    return st::ChangeRow { at: now_seconds(), action: action, target: target, before: before, after: after };
}

// ---- the wire ----------------------------------------------------------

/// `GET /admin/v1/changes`'s query.
fn read_change_query(p: std::http::RouteParams) -> st::ChangeQuery fallible(ApiError) {
    let mut q = st::ChangeQuery { target: std::http::query_param(p, "target"), cursor: std::http::query_param(p, "cursor") };
    let from = std::http::query_param(p, "from");
    if len(from) > 0 {
        q.has_from = true;
        q.from = rfc3339(from) or fail invalid("`from` is an RFC 3339 time, such as 2026-10-01T00:00:00Z", "from");
    }
    let to = std::http::query_param(p, "to");
    if len(to) > 0 {
        q.has_to = true;
        q.to = rfc3339(to) or fail invalid("`to` is an RFC 3339 time, such as 2026-10-01T00:00:00Z", "to");
    }
    let limit = std::http::query_param(p, "limit");
    if len(limit) > 0 {
        let n = std::str::parse_int(limit) or 0;
        if !is_integer(limit) || n < 1 || n > 1000 { fail invalid("`limit` is 1 to 1000", "limit"); }
        q.limit = n;
    }
    return q;
}

fn change_json(c: Change) -> String {
    return "{\"id\": " + jq(c.id) + ", \"at\": " + jtime(c.at) + ", \"principal\": " + jstring_or_null(c.has_principal, c.principal) + ", \"action\": " + jq(action_name(c.action))
        + ", \"target\": " + jq(c.target) + ", \"before\": " + jraw_if(c.has_before, c.before) + ", \"after\": " + jraw_if(c.has_after, c.after) + "}";
}

fn change_list_json(l: ChangeList) -> String {
    let entries_list = st::JsonList { };
    for c in l.data {
        entries_list.add(change_json(c));
    }
    let entries = entries_list.text();
    return "{\"data\": [" + entries + "], \"next_cursor\": " + jstring_or_null(l.has_next_cursor, l.next_cursor) + "}";
}
