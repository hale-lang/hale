// The role table grants roles to bearer callers.
//
// Retargeted in R4 (GH #1417): the role is a row's `requires`, and the
// table is the source a transport's `roles:` names (spec/api.md § Identity
// sources). The stdlib's
// `std::api::StaticRoles` matches `*` against any authenticated caller on
// either transport — a socket peer the kernel vouches for, a bearer
// principal the program's `BearerSource` named — and `bearer:<name>`
// against a bearer principal named exactly that, never a socket peer;
// `uid:`/`gid:`/`user:`/`group:` never match a bearer principal, even one
// whose name or uid reads the same. A token the source names nobody is
// refused before any gate. The table arrives as `LOTUS_API_ROLES`, and
// its birth refuses a misspelled prefix as it refuses any other member
// outside the spellings. A caller that lacks the role is refused
// `unauthorized` (403), naming what the row requires; the structural
// binding answered it as an unknown command.

// A desk with one gated command, on the socket and over HTTP. `t-me` is a
// token whose subject is spelled as this host's account and carries its
// uid: still a bearer, never that account.
fn app_source(sock: String, port: Int, me_name: String, me: String) -> String {
    return "role support;\n"
        + "type Refund { amount: Int; }\n"
        + "type Done { by: String; role: String; }\n"
        + "locus Tokens {\n"
        + "    fn principal(token: String) -> std::api::Principal {\n"
        + "        if token == \"t-alice\" { return std::api::Principal { mode: \"bearer\", name: \"alice\" }; }\n"
        + "        if token == \"t-bob\" { return std::api::Principal { mode: \"bearer\", name: \"bob\" }; }\n"
        + "        if token == \"t-oidc\" { return std::api::Principal { mode: \"bearer\", name: \"oidc:auth0|123\" }; }\n"
        + "        if token == \"t-me\" { return std::api::Principal { mode: \"bearer\", name: \"" + me_name + "\", uid: " + me + " }; }\n"
        + "        return std::api::Principal { mode: \"bearer\", name: \"\" };\n"
        + "    }\n"
        + "    fn refused() -> String { return \"no such token\"; }\n"
        + "}\n"
        + "locus Desk {\n"
        + "    fn on_refund(r: Refund, ctx: std::api::Context) -> Done {\n"
        + "        return Done { by: ctx.caller.name, role: ctx.role };\n"
        + "    }\n"
        + "}\n"
        + "api Public { rpc Desk::on_refund requires: [support]; }\n"
        + "main locus App {\n"
        + "    params {\n"
        + "        desk: Desk = Desk { };\n"
        + "        tokens: Tokens = Tokens { };\n"
        + "        roles: std::api::StaticRoles = std::api::StaticRoles { known: \"support\" };\n"
        + "    }\n"
        + "    placement { desk: cooperative(pool = work) where async_io; }\n"
        + "    run() {\n"
        + "        let sock = api::serve(Public, unix::Rpc { path: \"" + sock + "\", roles: self.roles }, as: \"sock\", receivers: { Desk: self.desk }, bound: 8, on_full: refuse);\n"
        + "        let web = api::serve(Public, http::Rpc { bind: \"127.0.0.1:" + to_string(port) + "\", codec: json, principals: self.tokens, roles: self.roles }, as: \"web\", receivers: { Desk: self.desk }, bound: 8, on_full: refuse);\n"
        + "        while !self.draining { std::time::sleep(100ms); }\n"
        + "        sock.stop();\n"
        + "        web.stop();\n"
        + "    }\n"
        + "}\n"
        + "fn main() { App { }; }\n";
}

locus Proc {
    params {
        child: std::process::Child = std::process::Child { };
        out: String = "";
    }

    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }

    // The child's exit code, waited for (bounded); -1 when it did not exit.
    fn exit_code() -> Int {
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return code;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        return -1;
    }

    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
    }

    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 {
            return false;
        }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }

    fn ask(line: String) -> String {
        self.stream.send(line + "\n") or discard;
        let mut i = 0;
        while i < 25 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let got = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return got;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                i = i + 1;
            } else {
                self.buf = self.buf + chunk;
            }
        }
        return "";
    }
}

fn run_tool(argv: String) -> std::process::ProcessOutput {
    return std::process::run(argv)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
}

fn has(s: String, needle: String) -> Bool {
    return std::str::contains(s, needle);
}

// One POST of a refund under a bearer token: the body, then the status.
fn post_refund(base: String, token: String) -> String {
    return std::str::trim(run_tool("curl\n-s\n-w\n\\n%{http_code}\n-X\nPOST\n-H\nAuthorization: Bearer " + token + "\n--data\n{\"amount\":5}\n" + base + "/call/Desk::on_refund").stdout);
}

// The same refund as one line of the socket's wire.
fn refund_line() -> String {
    return "{\"call\":\"Desk::on_refund\",\"payload\":{\"amount\":5},\"id\":\"c-1\"}";
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let me = std::str::trim(run_tool("id\n-u").stdout);
    let me_name = std::str::trim(run_tool("id\n-un").stdout);
    let tag = to_string(std::process::pid());
    let sock = "/tmp/hale-bearer-roles-" + tag + ".sock";
    // a port for the HTTP transport: bound and closed here, so it is free
    let mut port = 30000 + (std::process::pid() * 11 + 3) % 17000;
    let mut probe = std::io::tcp::__listen_socket("127.0.0.1", port);
    while probe < 0 { port = port + 1; probe = std::io::tcp::__listen_socket("127.0.0.1", port); }
    std::io::tcp::__close_fd(probe);
    let base = "http://127.0.0.1:" + to_string(port);
    let src = std::io::fs::mktemp("/tmp/hale-bearer-roles-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source(sock, port, me_name, me)) or discard;
    let built = run_tool(hale + "\nbuild\n" + src);
    std::test::assert_eq_int(built.code, 0, "the app builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];

    // `*`: a bearer the source names and a socket peer both hold the
    // role; a token the source names nobody is refused before the gate.
    let a = Proc { };
    std::test::assert(a.start("env\nLOTUS_API_ROLES=support=*\n" + bin), "the app started under support=*");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);
    let a1 = post_refund(base, "t-alice");
    std::test::assert(std::str::ends_with(a1, "200") && has(a1, "\"by\":\"alice\",\"role\":\"support\""), "`*` grants a bearer its source named, and the handler sees the role: " + a1);
    let a2 = api.ask(refund_line());
    std::test::assert(has(a2, "\"ok\":true") && has(a2, "\"role\":\"support\"") && has(a2, "\"caller\":{\"mode\":\"unix\""), "`*` grants a socket peer: " + a2);
    let a3 = post_refund(base, "t-mallory");
    std::test::assert(std::str::ends_with(a3, "401") && has(a3, "\"kind\":\"unauthenticated\"") && !has(a3, "\"by\""), "`*` grants no token the source names nobody: " + a3);
    a.stop();
    std::io::fs::unlink(sock) or discard;

    // `bearer:<name>`: alice over HTTP holds it; bob does not; and a
    // socket peer whose account carries a named bearer's spelling does
    // not either — the table names this host's account as a bearer.
    let b = Proc { };
    std::test::assert(b.start("env\nLOTUS_API_ROLES=support=bearer:alice,bearer:" + me_name + "\n" + bin), "the app started under bearer members");
    let api2 = Api { };
    std::test::assert(api2.connect(sock), "connected under bearer members");
    let b1 = post_refund(base, "t-alice");
    std::test::assert(std::str::ends_with(b1, "200") && has(b1, "\"by\":\"alice\",\"role\":\"support\""), "bearer:alice grants alice over HTTP: " + b1);
    let b2 = post_refund(base, "t-bob");
    std::test::assert(std::str::ends_with(b2, "403") && has(b2, "\"kind\":\"unauthorized\"") && has(b2, "\"requires\":[\"support\"]") && !has(b2, "\"by\""), "bearer:alice refuses bob: " + b2);
    let b3 = api2.ask(refund_line());
    std::test::assert(has(b3, "\"kind\":\"unauthorized\"") && !has(b3, "\"by\""), "bearer:" + me_name + " refuses the socket peer whose account is " + me_name + ": " + b3);
    let b4 = post_refund(base, "t-me");
    std::test::assert(std::str::ends_with(b4, "200") && has(b4, "\"role\":\"support\""), "the bearer the source names " + me_name + " holds it: " + b4);
    b.stop();
    std::io::fs::unlink(sock) or discard;

    // An OIDC subject as its source names it, `:` and `|` included, is a
    // `bearer:` member as written.
    let o = Proc { };
    std::test::assert(o.start("env\nLOTUS_API_ROLES=support=bearer:oidc:auth0|123\n" + bin), "the app started under an OIDC-shaped bearer member");
    let apio = Api { };
    std::test::assert(apio.connect(sock), "connected under the OIDC-shaped member: " + o.out);
    let o1 = post_refund(base, "t-oidc");
    std::test::assert(std::str::ends_with(o1, "200") && has(o1, "\"by\":\"oidc:auth0|123\",\"role\":\"support\""), "bearer:oidc:auth0|123 grants that subject: " + o1);
    let o2 = post_refund(base, "t-alice");
    std::test::assert(std::str::ends_with(o2, "403") && !has(o2, "\"by\""), "and no one else: " + o2);
    o.stop();
    std::io::fs::unlink(sock) or discard;

    // `user:` and `uid:` name this host's account: the socket peer holds
    // the role, the bearer spelled the same (and carrying the uid) does not.
    let c = Proc { };
    std::test::assert(c.start("env\nLOTUS_API_ROLES=support=user:" + me_name + ",uid:" + me + "\n" + bin), "the app started under account members");
    let api3 = Api { };
    std::test::assert(api3.connect(sock), "connected under account members");
    let c1 = post_refund(base, "t-me");
    std::test::assert(std::str::ends_with(c1, "403") && has(c1, "\"kind\":\"unauthorized\""), "user:" + me_name + " and uid:" + me + " refuse a bearer named " + me_name + ": " + c1);
    let c2 = api3.ask(refund_line());
    std::test::assert(has(c2, "\"ok\":true") && has(c2, "\"role\":\"support\""), "the socket peer holds it by its account: " + c2);
    c.stop();
    std::io::fs::unlink(sock) or discard;

    // A misspelled prefix is still no member: the source refuses to
    // start, and the reason lists the spellings, bearer's included.
    let d = Proc { };
    std::test::assert(d.start("env\nLOTUS_API_ROLES=support=barer:alice\n" + bin), "started under a misspelled prefix");
    std::test::assert_eq_int(d.exit_code(), 2, "a misspelled prefix refuses to start: " + d.out);
    std::test::assert(has(d.out, "`barer:alice` is not a role member") && has(d.out, "bearer:<name>"), "and says which, naming the spellings: " + d.out);
    let e = Proc { };
    std::test::assert(e.start("env\nLOTUS_API_ROLES=support=bearer:a b\n" + bin), "started under a bearer name with a blank");
    std::test::assert_eq_int(e.exit_code(), 2, "a bearer name never carries a blank: " + e.out);
    std::io::fs::unlink(sock) or discard;
    std::io::fs::unlink(bin) or discard;
    std::io::fs::unlink(src) or discard;
}
