// dna/host — the host: what `hale dna` does beside the compiler, as a
// Hale program (GH #566 F8). `hale dna <verb>` builds it once into the
// toolchain cache and execs it with the project resolved:
//
//   host <verb> <root> <seed> <fleet> <plan> [args…]
//
// with HALE_BIN (the toolchain) and HALE_DNA_TOOLCHAIN (its version) in
// the environment. It prints what the verb answers and exits with its
// status. It decides nothing. A one-shot verb never publishes: it
// writes its row, and a node — `run` or `dev`, the program's `main
// locus` (`Host`) — relays it onto the nerves (GH #986).

import "../core" as dna;

fn arg(i: Int) -> String { return std::env::arg_or(i, ""); }

// An argument's own backslashes and newlines are escaped in the
// newline-separated argument list, and unescaped when a value is read back
// (`flag`, `word`), so a multi-line value — a practice's text — arrives
// whole, byte for byte (the review of #633).
fn escape_arg(s: String) -> String {
    return std::str::replace(std::str::replace(s, "\\", "\\\\"), "\n", "\\n");
}

@unbounded
fn unescape_arg(s: String) -> String {
    if !std::str::contains(s, "\\") { return s; }
    let mut out = "";
    let mut i = 0;
    while i < len(s) {
        let c = s[i..(i + 1)];
        if c == "\\" && i + 1 < len(s) {
            let d = s[(i + 1)..(i + 2)];
            out = out + (if d == "n" { "\n" } else { d });
            i = i + 2;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

fn rest_args(from: Int) -> String {
    let mut out = "";
    let mut i = from;
    while i < std::env::args_count() {
        out = out + escape_arg(std::env::arg(i)) + "\n";
        i = i + 1;
    }
    return out;
}

// `--flag value` and positionals from the verb's args, newline-separated.
type Args {
    words: String = ""; // positionals, newline-separated
    flags: String = ""; // "\n--name\nvalue" pairs, newline-separated
}

fn has_flag(a: Args, name: String) -> Bool {
    return std::str::contains(a.flags, "\n" + name + "\n");
}

fn flag(a: Args, name: String) -> String {
    let i = std::str::index_of(a.flags, "\n" + name + "\n");
    if i < 0 { return ""; }
    let rest = a.flags[(i + len(name) + 2)..len(a.flags)];
    let nl = std::str::index_of(rest, "\n");
    if nl < 0 { return unescape_arg(rest); }
    return unescape_arg(rest[0..nl]);
}

fn word(a: Args, n: Int) -> String {
    let mut rest = a.words;
    let mut k = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if k == n { return unescape_arg(w); }
        k = k + 1;
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return "";
}

// positionals joined by spaces
fn join_words(words: String) -> String {
    let mut out = "";
    let mut rest = words;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if len(w) > 0 { out = out + (if len(out) > 0 { " " } else { "" }) + unescape_arg(w); }
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return out;
}

fn drop_first_word(words: String) -> String {
    let nl = std::str::index_of(words, "\n");
    if nl < 0 { return ""; }
    return words[(nl + 1)..len(words)];
}

fn parse_args(raw: String, valued: String) -> Args {
    let mut a = Args { flags: "\n" };
    let mut rest = raw;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let w = if nl < 0 { rest } else { rest[0..nl] };
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
        if std::str::starts_with(w, "--") && std::str::contains(valued, " " + w + " ") {
            let nl2 = std::str::index_of(rest, "\n");
            let v = if nl2 < 0 { rest } else { rest[0..nl2] };
            if nl2 < 0 { rest = ""; } else { rest = rest[(nl2 + 1)..len(rest)]; }
            a.flags = a.flags + w + "\n" + v + "\n";
        } else if std::str::starts_with(w, "--") {
            a.flags = a.flags + w + "\n\n";
        } else if len(w) > 0 {
            a.words = a.words + w + "\n";
        }
    }
    return a;
}

fn main() {
    let verb = arg(1);
    let root = arg(2);
    // this process's one handle on memory (GH #985), closed when it exits
    let memory = dna::Memory { repo: root, dsn_env: dna::own_dsn_env() };
    let seed = arg(3);
    let fleet = arg(4);
    let plan = arg(5);
    let toolchain = std::env::var("HALE_DNA_TOOLCHAIN");
    let a = parse_args(rest_args(6), " --to --as --authority --comment --digest --port --observe --repo --fleet --tick --severity --note --dsn --dir --body --outcome --purpose --why --policy --decided-by --via --evidence --class --name --classes --by --exception --authorized-by --text --because --supersedes --holder --token --expires --host-pid --request-id --diff ");
    if (verb == "practice" || verb == "verdict") && has_flag(a, "--request-id") && len(flag(a, "--request-id")) == 0 {
        eprintln("hale dna: --request-id requires a nonempty value");
        std::process::exit(1);
    }
    let mut ans = Answer { ok: false, text: "unknown verb `" + verb + "`" };
    if (verb == "board" || verb == "review") && !organism_here(root, memory) { let s = sync_record(root, memory); }
    if verb == "fleet" { let s = sync_record(root, memory); }
    if verb == "status" {
        ans = status_verb(root, seed, toolchain, has_flag(a, "--json"), memory);
    } else if verb == "history" {
        ans = history_verb(root, word(a, 0), memory);
    } else if verb == "review" {
        let no_head = record_refusal(root);
        if len(no_head) > 0 { ans = fail(no_head); }
        else {
            let p = open_projection(root, seed, toolchain, memory);
            let id = word(a, 0);
            if len(id) == 0 { ans = review_list(p); } else { ans = render_review(p, id, has_flag(a, "--iris")); }
        }
    } else if verb == "board" || verb == "report" || verb == "pressure" || verb == "fleet" {
        let no_head = record_refusal(root);
        if len(no_head) > 0 { ans = fail(no_head); }
        else {
            let p = open_projection(root, seed, toolchain, memory);
            if verb == "board" { ans = board_verb(p); }
            if verb == "report" { ans = report_verb(p, memory); }
            if verb == "pressure" { ans = pressure_list(p); }
            if verb == "fleet" { ans = fleet_list(p, fleet, plan); }
        }
    }
    if verb == "body-fence" {
        fence_main(flag(a, "--holder"), std::str::parse_int(flag(a, "--token")) or 0, std::str::parse_int(flag(a, "--expires")) or 0, std::str::parse_int(flag(a, "--host-pid")) or 0, memory);
        return;
    }
    if verb == "run" || verb == "dev" {
        host_main(verb, root, seed, fleet, plan, toolchain, a);
        return;
    }
    if verb == "node" {
        let tick = flag(a, "--tick");
        node_main(word(a, 0), root, flag(a, "--fleet"), if len(tick) > 0 { std::str::parse_int(tick) or 1000 } else { 1000 });
        return;
    }
    if verb == "verdict" {
        ans = verdict_command_verb(root, seed, word(a, 0), word(a, 1), flag(a, "--as"), flag(a, "--authority"), flag(a, "--comment"), flag(a, "--digest"), flag(a, "--evidence"), has_flag(a, "--no-wait"), flag(a, "--request-id"), memory);
    } else if verb == "raise" {
        ans = pressure_raise(root, word(a, 0), join_words(drop_first_word(a.words)), memory);
    } else if verb == "concern-raise" {
        let sev = flag(a, "--severity");
        ans = concern_raise(root, word(a, 0), join_words(drop_first_word(a.words)), if len(sev) > 0 { std::str::parse_int(sev) or 1 } else { 1 }, memory);
    } else if verb == "task" {
        // `hale dna task create [--to <locus>] [--as <who>] [--no-wait] <outcome…>`:
        // the outcome is every word after the subverb (asking is one kind of task)
        if word(a, 0) == "create" { ans = task_create_verb(root, join_words(drop_first_word(a.words)), flag(a, "--to"), has_flag(a, "--no-wait"), flag(a, "--as"), memory); }
        // GH #596 W: `hale dna task done <id> [--as <who>] [--note …]`
        else if word(a, 0) == "done" { ans = task_done_verb(root, seed, word(a, 1), flag(a, "--as"), flag(a, "--note"), flag(a, "--evidence"), flag(a, "--exception"), flag(a, "--authorized-by"), memory); }
        else if word(a, 0) == "reassign" { ans = task_reassign_verb(root, seed, word(a, 1), flag(a, "--to"), flag(a, "--as"), memory); }
        // GH #667: `hale dna task accept <id> [--as <who>] [--note …]`
        else if word(a, 0) == "accept" { ans = task_accept_verb(root, seed, word(a, 1), flag(a, "--as"), flag(a, "--note"), memory); }
        // GH #616: `hale dna task decide <id> --decided-by <party> --via <channel> --evidence <digest>`
        else if word(a, 0) == "authorize" { ans = task_authorize_verb(root, seed, word(a, 1), flag(a, "--exception"), flag(a, "--as"), memory); }
        else if word(a, 0) == "decide" { ans = task_decide_verb(root, seed, word(a, 1), flag(a, "--decided-by"), flag(a, "--via"), flag(a, "--evidence"), flag(a, "--note"), flag(a, "--as"), memory); }
        else { ans = fail("task: `hale dna task create [--to <locus>] [--as <who>] [--no-wait] <outcome…>`, `hale dna task done <id> [--as <who>] [--note <what was done>]`, `hale dna task reassign <id> --to <who> [--as <by>]`, `hale dna task accept <id> [--as <who>]` or `hale dna task decide <id> --decided-by <party> --via <channel> --evidence <digest> [--as <reporter>]`"); }
    } else if verb == "effect" {
        // GH #604 rule 3: `hale dna effect resolve <key> --outcome ok|failed`
        if word(a, 0) == "resolve" { ans = effect_resolve_verb(root, seed, word(a, 1), flag(a, "--outcome"), flag(a, "--as"), flag(a, "--note"), memory); }
        else { ans = fail("effect: `hale dna effect resolve <key> --outcome ok|failed [--as <who>] [--note …]`"); }
    } else if verb == "retire" {
        // GH #604 rule 5: `hale dna retire <who> [--to <successor>] [--as <by>]`
        ans = retire_verb(root, seed, word(a, 0), flag(a, "--to"), flag(a, "--as"), memory);
    } else if verb == "sync" {
        ans = sync_verb(root, memory);
    } else if verb == "candidates" {
        // #649: the candidates the record keeps, whatever the review decided
        ans = candidates_verb(root, seed, word(a, 0), word(a, 1), flag(a, "--why"), flag(a, "--as"), memory);
    } else if verb == "ledger" {
        // GH #646 stage 1: the operational memory, adopted by an explicit step
        ans = ledger_verb(root, seed, word(a, 0), flag(a, "--why"), flag(a, "--as"), memory);
    } else if verb == "memory-migrate" {
        // GH #985: memory's schema, applied with the owner's DSN
        ans = memory_migrate_verb(root);
    } else if verb == "nerves-migrate" {
        // GH #986: the nerves' stream, created with the owner's URL
        ans = nerves_migrate_verb(root);
    } else if verb == "nerves-drop" {
        ans = nerves_drop_verb(root);
    } else if verb == "record-head" {
        ans = record_head_verb(root);
    } else if verb == "record-seed" {
        // `hale dna init` seeds the record through the host: its rows, one
        // JSON object per line in a file, and the declared purpose (GH #995)
        ans = record_seed_verb(root, word(a, 0), word(a, 1), memory);
    } else if verb == "show" {
        // GH #1086: `hale dna show org | processes [--json]`, queries over memory
        ans = show_verb(root, word(a, 0), has_flag(a, "--json"));
    } else if verb == "fill" {
        // GH #1091: `hale dna fill <position> <holder>`, a holder proposed through the organization
        ans = fill_verb(root, seed, word(a, 0), word(a, 1), flag(a, "--as"), memory);
    } else if verb == "route" {
        // GH #1087: `hale dna route [--json] (<path>… | --diff <range>)`
        ans = route_verb(root, a);
    } else if verb == "graph-ingest" {
        // `hale dna init` on a repository: what it holds, as the graph (GH #1090)
        ans = graph_ingest_verb(root, word(a, 0), memory);
    } else if verb == "design-upgrade" {
        // `hale dna init` / `upgrade`: the toolchain's design as proposals
        ans = design_upgrade_verb(root, word(a, 0), toolchain, memory);
    } else if verb == "body" {
        // GH #617: the body lease from the CLI; the body on a server
        let sub = word(a, 0);
        if sub == "provision" { ans = body_provision_verb(root, word(a, 1), flag(a, "--dsn"), flag(a, "--dir"), has_flag(a, "--dry-run"), flag(a, "--as"), memory); }
        else if sub == "start" || sub == "stop" || sub == "logs" { ans = body_ctl_verb(root, sub, flag(a, "--body")); }
        else { ans = body_verb(root, sub, has_flag(a, "--force"), flag(a, "--as"), memory); }
    } else if verb == "practice" {
        // GH #602: `hale dna practice [propose <name> --text <t> [--because …] [--supersedes <digest>]]`
        ans = practice_command_verb(root, seed, word(a, 0), word(a, 1), flag(a, "--text"), flag(a, "--because"), flag(a, "--supersedes"), flag(a, "--as"), flag(a, "--request-id"), has_flag(a, "--no-wait"), memory);
    } else if verb == "connect" {
        // GH #615: `hale dna connect [<record-url> --name <n> --as <position> --purpose <p> --classes <c,…>]`
        ans = connect_verb(root, seed, word(a, 0), flag(a, "--name"), flag(a, "--as"), flag(a, "--purpose"), flag(a, "--classes"), flag(a, "--by"), memory);
    } else if verb == "disconnect" {
        ans = disconnect_verb(root, seed, word(a, 0), flag(a, "--why"), flag(a, "--by"), memory);
    } else if verb == "handoff" {
        let sub = word(a, 0);
        if len(sub) == 0 { ans = handoff_list_verb(root, seed, memory); }
        else if sub == "accept" { ans = handoff_accept_verb(root, seed, word(a, 1), flag(a, "--note"), flag(a, "--as"), memory); }
        else if sub == "sync" { ans = handoff_sync_verb(root, seed, memory); }
        else { ans = handoff_publish_verb(root, seed, sub, word(a, 1), word(a, 2), flag(a, "--note"), flag(a, "--as"), memory); }
    } else if verb == "receipt" {
        // GH #606: protected evidence
        if word(a, 0) == "file" { ans = receipt_file_verb(root, word(a, 1), flag(a, "--class"), flag(a, "--as"), memory); }
        else { ans = receipt_verb(root, word(a, 0), word(a, 1), flag(a, "--to"), flag(a, "--purpose"), flag(a, "--as"), flag(a, "--why"), flag(a, "--policy"), memory); }
    } else if verb == "schedule" {
        // GH #610: the schedules, and pause/resume as rows
        ans = schedule_verb(root, word(a, 0), word(a, 1), flag(a, "--as"), memory);
    } else if verb == "secret" {
        ans = secret_verb(root, word(a, 0), word(a, 1), flag(a, "--body"), flag(a, "--as"), memory);
    } else if verb == "profile" {
        ans = profile_verb(root, memory);
    } else if verb == "deploy" {
        ans = deploy_verb(root, fleet, plan, word(a, 0), false, memory);
    } else if verb == "rollback" {
        ans = deploy_verb(root, fleet, plan, word(a, 0), true, memory);
    } else if verb == "github" {
        ans = github_verb(root, seed, word(a, 0), memory);
    } else if verb == "models" {
        ans = models_verb(root, std::env::var("HALE_BIN"));
    } else if verb == "work" {
        ans = work_verb(root, std::env::var("HALE_BIN"));
    } else if verb == "definitions" {
        // GH #995: the workflow catalog, with revisions and each step's store
        ans = definitions_verb(root, std::env::var("HALE_BIN"), has_flag(a, "--json"));
    }
    if ans.ok {
        print(ans.text);
        return;
    }
    eprintln("hale dna: ", ans.text);
    std::process::exit(1);
}
