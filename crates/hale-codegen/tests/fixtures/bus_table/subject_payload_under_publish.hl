// The subject-to-payload table grows while another thread reads it
// (F.40 phase 3, L1 5 of 5; the twin of inventory R50). `a`, a pinned
// anchor, publishes to a computed subject for 300 ms from its own
// thread, and every such publish reads the whole table, checking that
// no subscription the subject reaches expects another payload. Once `a`
// has started, `b`, a second pinned anchor, initializes its subtree on
// its own thread: eight loci of sixteen subscriptions apiece, each to a
// subject of its own, so the table records 128 subjects and grows four
// times while `a` reads it.
// Expected outcome: `ev published`, then `ev done`, exit 0, and nothing
// an AddressSanitizer build reports.

fn gate() -> String {
    return "/tmp/hale-subj-pay-" + to_string(std::process::pid());
}

fn publishing() -> Int {
    let deadline = std::time::monotonic_ns() + 5000000000;
    while !std::io::fs::file_exists(gate()) && std::time::monotonic_ns() < deadline {
        std::time::sleep(1ms);
    }
    return 1;
}

type P { n: Int; }

locus Pub {
    params { target: String = "x.none"; sent: Int = 0; }
    bus { publish "x.**" of type P; }
    run() {
        std::io::fs::write_file(gate(), "go") or discard;
        let until = std::time::monotonic_ns() + 300000000;
        while std::time::monotonic_ns() < until {
            self.target <- P { n: 1 };
            self.sent = self.sent + 1;
        }
        println("ev published");
    }
}

locus S1 {
    bus {
        subscribe "y.1.a" as h of type P;
        subscribe "y.1.b" as h of type P;
        subscribe "y.1.c" as h of type P;
        subscribe "y.1.d" as h of type P;
        subscribe "y.1.e" as h of type P;
        subscribe "y.1.f" as h of type P;
        subscribe "y.1.g" as h of type P;
        subscribe "y.1.h" as h of type P;
        subscribe "y.1.i" as h of type P;
        subscribe "y.1.j" as h of type P;
        subscribe "y.1.k" as h of type P;
        subscribe "y.1.l" as h of type P;
        subscribe "y.1.m" as h of type P;
        subscribe "y.1.n" as h of type P;
        subscribe "y.1.o" as h of type P;
        subscribe "y.1.p" as h of type P;
    }
    fn h(p: P) { }
}

