fn observe() -> Int { println("field default observed"); return 1; }
type Settings { n: Int = observe(); }
locus Worker { fn measure() { let settings = Settings { }; } }
group workers = { Worker };
group observers = { observe };
main locus App {
    claims { quiet: forbid reaches(workers, effects(stdio)) avoiding observers; }
}
fn main() { App { }; }
