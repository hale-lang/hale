// PTY stub — types, Pty locus, free fns.
// Surface contract: ../../COMPILER_FFI.md § `std::pty::*`.
//
// Behavior: in-memory buffers backing read_nonblocking / write.
// No fork, no exec, no real fd. Tests use stub_helpers.hl to
// inject bytes into stub_output and drain captured stub_input.

type PtyOptions {
    cols: Int    = 80;
    rows: Int    = 24;
    cwd:  String = "";
}

type PtyError {
    kind:   String = "";
    errno:  Int    = 0;
    detail: String = "";
}

locus Pty {
    params {
        cmd:        String;                       // required
        args:       String = "";
        opts:       PtyOptions = PtyOptions { };
        master_fd:  Int = -1;
        pid:        Int = -1;
        last_error: PtyError = PtyError { };

        // Stub state. In the real impl these vanish.
        stub_output: std::bytes::BytesBuilder
                   = std::bytes::BytesBuilder { initial_cap: 4096 };
        stub_input:  std::bytes::BytesBuilder
                   = std::bytes::BytesBuilder { initial_cap: 4096 };
        stub_alive:  Bool = true;
    }

    closure fatal_io { captures: last_error, pid; epoch inline; }

    birth() {
        // Stub: pretend forkpty + exec succeeded.
        self.master_fd = 1000;   // sentinel "stub fd"
        self.pid       = 99999;  // sentinel "stub pid"
    }

    dissolve() {
        // No-op — BytesBuilder fields dissolve via F.29 cascade.
        // Real impl: close(master_fd), reap pid.
    }

    // ---- internal mutation surface used by free fns + stub helpers.

    fn _read_into(buf: std::bytes::BytesBuilder, max: Int) -> Int {
        let avail = len(self.stub_output.view());
        let n = if avail < max { avail } else { max };
        if n == 0 { return 0; }
        let chunk = std::bytes::slice(self.stub_output.view(), 0, n);
        buf.append(chunk);
        self.stub_output.shift_front(n);
        return n;
    }

    fn _write_from(input: Bytes) -> Int {
        self.stub_input.append(input);
        return len(input);
    }

    fn _inject_output(b: Bytes) {
        self.stub_output.append(b);
    }

    fn _drain_input() -> Bytes {
        let view = self.stub_input.view();
        let copy = std::bytes::clone(view);
        self.stub_input.clear();
        return copy;
    }

    fn _set_alive(alive: Bool) {
        self.stub_alive = alive;
    }
}

// ---- Public free fns. Pattern: locus methods do the work
// (infallible), free fns layer the fallible channel on top.

fn read_nonblocking(p: Pty, buf: std::bytes::BytesBuilder, max: Int)
        -> Int fallible(PtyError) {
    if !p.stub_alive {
        fail PtyError { kind: "closed", errno: 0, detail: "stub pty closed" };
    }
    return p._read_into(buf, max);
}

fn write(p: Pty, input: Bytes) -> Int fallible(PtyError) {
    if !p.stub_alive {
        fail PtyError { kind: "closed", errno: 0, detail: "stub pty closed" };
    }
    return p._write_from(input);
}

fn resize(p: Pty, cols: Int, rows: Int) -> () fallible(PtyError) {
    let _ = p;
    let _ = cols;
    let _ = rows;
    // Stub: no-op.
}

fn is_alive(p: Pty) -> Bool {
    return p.stub_alive;
}
