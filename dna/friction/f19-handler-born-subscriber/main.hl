// F.19 — a subscriber born in a bus handler had to be the handler's own
// child. `hale check` used to refuse this program: Part does not accept
// Run, and the old rule looked only at the handler's own locus, so the
// bubble to Manager (which does accept Run) went unseen:
//
//   type error: locus `Run` declares `bus subscribe` but is instantiated
//   unowned inside `Part`'s bus handler `on_poke`.
//
// The rule reads the ownership graph now (spec/semantics.md, type-check
// rule 20): the nearest accepting ancestor owns a handler-born subscriber
// as it owns any other birth, so the program checks and builds, and the
// Run is passed up to Manager. The pin is
// `the_nearest_accepting_ancestor_owns_it` in
// crates/hale-cli/tests/check_unowned_subscriber.rs. Asking the owner over
// the bus (dna/tests/workflow_lifetime_test.hl, case 4b) still works too.

type Poke { key: String = ""; }
topic Pokes { payload: Poke; subject: "f19.poke"; keyed_by key; }
type Offer { key: String = ""; }
topic Offers { payload: Offer; subject: "f19.offer"; }

locus Part {
    params { key: String = ""; }
    bus { subscribe Pokes as on_poke where key == self.key; }
    run() { }
    fn on_poke(p: Poke) {
        Run { key: self.key + ".child" };
        terminate;
    }
}
locus Run {
    params { key: String = ""; }
    bus { subscribe Pokes as on_poke where key == self.key; }
    accept(p: Part) { }
    run() { Part { key: self.key + ".p" }; }
    fn on_poke(p: Poke) { terminate; }
}
locus Manager {
    bus { subscribe Offers as on_offer; }
    accept(r: Run) { }
    fn on_offer(o: Offer) { Run { key: o.key }; }
}
main locus App {
    params { m: Manager = Manager { }; }
    bus { publish Offers; publish Pokes; }
    run() {
        Offers <- Offer { key: "r" };
        std::time::sleep(50ms);
        Pokes <- Poke { key: "r.p" };
        std::time::sleep(50ms);
    }
}
fn main() { App { }; }
