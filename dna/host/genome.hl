// dna/host/genome.hl — the genome's git as the host touches it (GH #646
// stage 0, #649). The record has its own API (`dna::Record`); what is
// left here is the Structure: a revision of the governed repository
// resolved, shown, checked out, reset, pushed as a branch, diffed. This
// is the one file in the host that spells `git` for the genome, as
// `workspace.hl`, `verification.hl` and `org.hl` are in the core.

import "../core" as dna;

fn genome(root: String, args: String) -> dna::RunResult {
    return dna::run_tool("git\n-C\n" + root + "\n" + args);
}

// The paths a range of the genome's history touches, one per line: a
// rename is its old path and its new (`--no-renames`), so a file moved
// away still names what it was (GH #1087, `hale dna route --diff`).
fn genome_changed(root: String, range: String) -> dna::RunResult {
    return genome(root, "-c\ncore.quotePath=false\ndiff\n--name-only\n--no-renames\n" + range);
}

// The commit `rev` names in the genome ("" when it names none).
fn genome_commit(root: String, rev: String) -> String {
    let r = genome(root, "rev-parse\n--verify\n" + rev + "^{commit}");
    if r.code != 0 { return ""; }
    return dna::trim_nl(r.stdout);
}

// A file of the genome at a revision ("" when absent).
fn genome_show(root: String, rev: String, path: String) -> String {
    let r = genome(root, "show\n" + rev + ":" + path);
    if r.code != 0 { return ""; }
    return dna::trim_nl(r.stdout);
}

// The branch the genome is on ("" when detached).
fn genome_branch(root: String) -> String {
    let r = genome(root, "symbolic-ref\n--short\nHEAD");
    if r.code != 0 { return ""; }
    return dna::trim_nl(r.stdout);
}

// Push `src` to the remote's branch `branch`; the error text, "" when it landed.
fn genome_push_branch(root: String, remote: String, src: String, branch: String, force: Bool) -> String {
    let r = genome(root, "push\n-q\n" + (if force { "-f\n" } else { "" }) + remote + "\n" + src + ":refs/heads/" + branch);
    if r.code == 0 { return ""; }
    let e = dna::trim_nl(r.stderr);
    return if len(e) == 0 { "push failed" } else { e };
}

// Check the genome out at a revision, detached; the error text, "" when done.
fn genome_checkout(root: String, rev: String) -> String {
    let r = genome(root, "checkout\n-q\n--detach\n" + rev);
    if r.code == 0 { return ""; }
    let e = dna::trim_nl(r.stderr);
    return if len(e) == 0 { "checkout failed" } else { e };
}

// Reset the genome to `base`, keeping local changes that do not conflict.
fn genome_reset(root: String, base: String) -> Bool {
    return genome(root, "reset\n-q\n--keep\n" + base).code == 0;
}

// The diff between two revisions, with a stat, as git prints it.
fn genome_diff(root: String, base: String, candidate: String) -> dna::RunResult {
    return genome(root, "diff\n--stat\n-p\n" + base + "\n" + candidate);
}

// ---- the genome pull (GH #1026) ---------------------------------------
//
// Nodes converge on the genome by pulling: on an interval each fetches the
// forge's default branch, and a node whose genome moved restarts to take
// it. These are the pull's git.

// The forge's default branch at `remote`, as its HEAD names it ("" when
// the remote could not be read).
fn genome_default_branch(root: String, remote: String) -> String {
    let r = genome(root, "ls-remote\n--symref\n" + remote + "\nHEAD");
    if r.code != 0 { return ""; }
    let at = std::str::index_of(r.stdout, "ref: refs/heads/");
    if at < 0 { return ""; }
    let rest = r.stdout[(at + 16)..len(r.stdout)];
    let tab = std::str::index_of(rest, "\t");
    return if tab < 0 { dna::trim_nl(rest) } else { rest[0..tab] };
}

// Where the pull fetches the forge's default branch: a ref of its own,
// never FETCH_HEAD, which every fetch in the clone rewrites — the record's
// fetches of its own refs among them, so a read of FETCH_HEAD after this
// fetch could name a row of the journal (GH #1072).
const GENOME_REMOTE_REF: String = "refs/dna/remote/genome";

// Fetch the forge's default branch; the commit it is at, "" when it could
// not be fetched. A fetch that lost the ref's lock to another is tried
// again, as the record's own are.
fn genome_fetch_default(root: String, remote: String) -> String {
    let branch = genome_default_branch(root, remote);
    if len(branch) == 0 { return ""; }
    let args = "fetch\n-q\n" + remote + "\n+refs/heads/" + branch + ":" + GENOME_REMOTE_REF;
    let mut f = genome(root, args);
    let mut tries = 1;
    while f.code != 0 && tries < dna::FETCH_TRIES && dna::lost_ref_lock(f.stderr) {
        dna::fetch_backoff(tries);
        f = genome(root, args);
        tries = tries + 1;
    }
    if f.code != 0 { return ""; }
    return genome_commit(root, GENOME_REMOTE_REF);
}

// Move the genome here forward to `target` when it descends from what is
// checked out: "" when it is there, else why it was not moved (the genome
// here has commits the forge does not, or the tree would not allow it).
fn genome_fast_forward(root: String, target: String) -> String {
    let head = genome_commit(root, "HEAD");
    if head == target { return ""; }
    if genome(root, "merge-base\n--is-ancestor\nHEAD\n" + target).code != 0 { return "the genome here (" + head + ") is not an ancestor of the forge's " + target + "; it is not pulled"; }
    let m = genome(root, "merge\n--ff-only\n-q\n" + target);
    if m.code == 0 { return ""; }
    let e = dna::trim_nl(m.stderr);
    return if len(e) == 0 { "the fast-forward failed" } else { e };
}
