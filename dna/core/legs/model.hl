// dna/core/legs/model.hl — the model leg (GH #946 slice 4, second PR).
//
// A model performs a Work through the project's catalog: the router
// (`dna::ModelRouter`), its adapters (OpenAI-shaped, Anthropic, a local
// model, a harness under confinement, the fakes) and the tape
// (`dna::RecordedModel`, wrapping any of them) are the core's, since
// the owner's editor and leader still call them in process until their
// stages land; the leg wires them behind the performer interface and
// runs them out of process, per task, with nothing held between tasks.
// Every call is collected here as evidence — what the router answered
// (the backend, the model, the tokens, the cost, the wall time) under the
// prompt and context digests of the request — and handed back with the
// outcome, so the owner journals it as `model.called` rows on the
// attempt (tokens per task hold out of process). The adapters' own
// `ModelCalled` publishes stay theirs: a leg is one run of a program, with
// no bus pump between its call and its answer. A rate-limited call is
// backed off inside the attempt — a bounded, doubling wait — and every
// wait is recorded as evidence of its own (a refused call was never
// made, whatever the performer's effect class), so the attempt's cost in
// time is in the record beside its cost in tokens, and the lease is renewed
// through the lease hand before each wait, so the Work is not lost to
// another leg mid-wait. The model is sent the render alone: the hat is
// structure, the leg renders it, and the hat's digest is the context
// digest on every row of evidence (the tape's key).
//
// GH #1131: the spend is the spine's to admit, as the editor's and the
// leader's are. Before its first call the leg asks the spine under its
// lease (`hands.lease.allowance`); refused, it makes no call and the
// attempt is declined with the reason. Granted, it makes no call — a
// retry included — whose cost is known before it is sent (the backend's
// `price_micros`: a price per call, a recorded answer) and past what is
// left of the allowance, nor any once its calls have spent it; the
// attempt is declined. A cost learned only from the answer (a price per
// token) can cross the allowance: that call is made whole, and the owner
// settles such an outcome failed, naming the overrun. The evidence speaks
// the owner's vocabulary: a call's `adapter` is the adapter that
// answered (the router's `last_adapter`), and a wait row's is `legs`,
// with `waited_ms`.
import ".." as dna;

// How long a leg waits for the spine to answer the ask for its spend.
const ALLOWANCE_WAIT: Int = 60;

// The evidence of one call, as the owner's `journal_calls` reads it.
fn evidence_json(ev: dna::ModelEvidence) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("adapter", ev.adapter);
    b.string_field("backend", ev.backend);
    b.string_field("endpoint", ev.endpoint);
    b.string_field("credential", ev.credential);
    b.string_field("requested_model", ev.requested_model);
    b.string_field("reported_model", ev.reported_model);
    b.string_field("params", ev.params);
    b.string_field("prompt_digest", ev.prompt_digest);
    b.string_field("context_digest", ev.context_digest);
    b.string_field("knowledge_bindings", ev.knowledge_bindings);
    b.string_field("tool_grant", ev.tool_grant);
    b.string_field("response_digest", ev.response_digest);
    b.int_field("input_tokens", if ev.input_tokens < 0 { 0 } else { ev.input_tokens });
    b.int_field("output_tokens", if ev.output_tokens < 0 { 0 } else { ev.output_tokens });
    b.string_field("elapsed", ev.elapsed);
    b.int_field("cost_micros", if ev.cost_micros < 0 { 0 } else { ev.cost_micros });
    b.string_field("retry_of", ev.retry_of);
    b.string_field("data_class", ev.data_class);
    b.string_field("refused", ev.refused);
    b.int_field("waited_ms", if ev.waited_ms < 0 { 0 } else { ev.waited_ms });
    b.end_object();
    return b.result();
}

// `ms` milliseconds of waiting, in 50ms steps (the runtime's sleep takes a literal).
@unbounded
fn sleep_for_ms(ms: Int) {
    let mut left = ms;
    while left > 0 { std::time::sleep(50ms); left = left - 50; }
}

// Whether a refusal is the endpoint asking for time: HTTP 429, or the
// words the adapters and gateways use for it.
fn rate_limited(refused: String) -> Bool {
    return std::str::contains(refused, "http 429") || std::str::contains(refused, "rate limit") || std::str::contains(refused, "rate-limit") || std::str::contains(refused, "too many requests");
}

// The role a request carries, by the work kind: what the selection
// policy weighs.
// What a call is attributed by at the gateway: the attempt, the position and
// the holder. Attribution only; the gateway decides nothing by it.
fn call_metadata(brief: Brief) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("attempt", brief.attempt_id);
    b.string_field("position", brief.position);
    b.string_field("holder", brief.holder);
    b.end_object();
    return b.result();
}

// The loop's messages, in the chat API's shape, comma-joined.
fn joined(list: String, item: String) -> String { return if len(list) > 0 { list + ", " + item } else { item }; }

@unbounded
fn assistant_calls_message(text: String, calls: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("role", "assistant");
    if len(text) > 0 { b.string_field("content", text); } else { b.field("content", "null"); }
    b.begin_array_field("tool_calls");
    let mut it = std::json::array_first(calls);
    while !it.done {
        b.begin_object();
        b.string_field("id", std::json::find_string_field(it.element, "id"));
        b.string_field("type", "function");
        b.begin_object_field("function");
        b.string_field("name", std::json::find_string_field(it.element, "name"));
        b.string_field("arguments", std::json::find_string_field(it.element, "arguments"));
        b.end_object();
        b.end_object();
        it = std::json::array_next(it);
    }
    b.end_array();
    b.end_object();
    return b.result();
}

fn tool_message(id: String, text: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("role", "tool");
    b.string_field("tool_call_id", id);
    b.string_field("content", text);
    b.end_object();
    return b.result();
}

fn text_message(role: String, text: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("role", role);
    b.string_field("content", text);
    b.end_object();
    return b.result();
}

// A tool call as evidence: the turn, the hand, digests of what it was
// given and what it answered, and why it failed when it did.
fn tool_row(turn: Int, name: String, args: String, done: HandResult) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.int_field("turn", turn);
    b.string_field("name", name);
    b.string_field("arguments_digest", dna::digest_of(args));
    b.string_field("ok", if done.ok { "true" } else { "false" });
    b.string_field("output_digest", dna::digest_of(done.output));
    b.int_field("output_bytes", len(done.output));
    b.string_field("error", if len(done.error) > 300 { done.error[0..300] } else { done.error });
    b.end_object();
    return b.result();
}

// The tool calls as one receipt (`[{class, body}]`), none when there were none.
fn tool_receipt(rows: String) -> String {
    if len(rows) == 0 { return "[]"; }
    return "[" + tool_receipt_object(rows) + "]";
}

fn tool_receipt_object(rows: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("class", "internal");
    b.string_field("body", "{\"tool_calls\": [" + rows + "]}");
    b.end_object();
    return b.result();
}

// A Patch's receipts: the commit's patch first (what the owner applies),
// then the tool calls.
fn patch_and_tools(patch: String, rows: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("class", "internal");
    b.string_field("body", patch);
    b.end_object();
    return "[" + b.result() + (if len(rows) > 0 { ", " + tool_receipt_object(rows) } else { "" }) + "]";
}

fn first_line(text: String) -> String {
    let nl = std::str::index_of(text, "\n");
    let line = std::str::trim(if nl < 0 { text } else { text[0..nl] });
    return if len(line) > 0 { line } else { "the change" };
}

fn role_of(performer_kind: String) -> String {
    if performer_kind == "edit" { return "edit"; }
    if performer_kind == "service" { return "classify"; }
    return "review";
}

locus ModelPerformer {
    params {
        name: String = "model";
        kinds: String = "agent service software"; // the work kinds the model leg takes
        effect: String = ""; // the effect class declared for this leg: effect_free for a backend that answers, uncertain for one that works in place
        router: dna::ModelRouter = dna::ModelRouter { };
        // a rate-limited call: up to `retries` more tries, the first after
        // `backoff_ms`, each wait double the last, each recorded
        backoff_ms: Int = 1000;
        retries: Int = 3;
        // a tool loop's bound: the model's turns, tool calls and the
        // validators' refusals all count (dna/core/legs/tool_loop.hl)
        max_turns: Int = 16;
        // the repository a `do` Work changes; "" = the one the leg runs in
        repo: String = "";
        calls: String = ""; // the calls of the attempt in hand, JSON objects comma-joined
        performed: Int = 0;
        waited_ms: Int = 0; // what the attempt in hand waited on rate limits
        retried: Int = 0; // the backed-off retries of the attempt in hand's loop
        spent_micros: Int = 0; // what the attempt in hand's calls cost
    }
    fn on_called(ev: dna::ModelEvidence) {
        self.calls = self.calls + (if len(self.calls) > 0 { ", " } else { "" }) + evidence_json(ev);
    }
    fn kind() -> String { return "model"; }
    fn takes(performer_kind: String) -> Bool { return dna::word_in(performer_kind, self.kinds); }
    fn effect_class() -> String { return self.effect; }
    // The wait as evidence: a call that was not made, saying why, for how
    // long, and whether the lease was kept meanwhile.
    fn waited(brief: Brief, refused: String, ms: Int, renewed: String) {
        self.on_called(dna::ModelEvidence {
            attempt_id: brief.attempt_id, adapter: "legs", backend: self.router.last_backend,
            prompt_digest: prompt_digest(brief.rendered), context_digest: brief.hat_digest,
            elapsed: to_string(ms) + "ms", retry_of: brief.attempt_id, data_class: std::json::find_string_field(brief.hat, "data_class"),
            refused: "rate limited, backed off " + to_string(ms) + "ms: " + refused + renewed, waited_ms: ms
        });
    }
    // Why the call `req` would make is not made, "" when it may be: its cost
    // is known before it is sent and is past what is left of the allowance
    // (-1: nothing bounds it).
    fn priced_out(req: dna::ModelRequest, allowance: Int) -> String {
        if allowance < 0 { return ""; }
        let price = self.router.price_micros(req);
        if price < 0 || self.spent_micros + price <= allowance { return ""; }
        return "the call would cost " + to_string(price) + " micro-dollars, past what is left of the attempt's allowance (" + to_string(allowance - self.spent_micros) + " of " + to_string(allowance) + "): no call was made";
    }
    // One call through the router, its answer as evidence: the split of
    // tokens as the backend reported it (what its own `ModelCalled` says).
    fn asked(brief: Brief, req: dna::ModelRequest) -> dna::ModelResult {
        let t0 = std::time::monotonic();
        let r = self.router.ask(req);
        self.spent_micros = self.spent_micros + (if r.cost_micros > 0 { r.cost_micros } else { 0 });
        self.on_called(dna::ModelEvidence {
            attempt_id: brief.attempt_id, adapter: self.router.last_adapter, backend: r.backend, requested_model: r.model, reported_model: r.model,
            prompt_digest: req.prompt_digest, context_digest: brief.hat_digest, knowledge_bindings: req.knowledge_bindings, tool_grant: req.tool_grant,
            response_digest: if r.ok { dna::digest_of(r.output + r.tool_calls) } else { "" }, input_tokens: r.input_tokens, output_tokens: r.output_tokens, cost_micros: r.cost_micros,
            elapsed: to_string(std::time::monotonic() - t0), retry_of: req.retry_of, data_class: req.data_class, refused: r.refused
        });
        return r;
    }
    // The harness's loop (dna/core/legs/tool_loop.hl): the model is
    // offered the hat's hands as tools, the leg runs each call it asks
    // for and sends the result back, until it answers. A `do` Work works
    // in a scratch worktree of the leg's repository at its HEAD; its answer
    // stands only once the hat's validators pass on every seed it touched,
    // and a `Patch` is handed back as one commit on that base with its
    // patch. Bounded by `max_turns` and the attempt's allowance.
    @unbounded
    fn perform_loop(brief: Brief, hands: Hands, first: dna::ModelRequest, allowance: Int, mode: String) -> Performance {
        let hat = brief.hat;
        let owed = std::json::find_string_field(hat, "output_contract");
        let validators = std::json::find_string_field(hat, "validators");
        let mut worktree = "";
        let mut base = "";
        if mode == "do" {
            let top = if len(self.repo) > 0 { dna::RunResult { code: 0, stdout: self.repo } } else { dna::run_tool("git\nrev-parse\n--show-toplevel") };
            if top.code != 0 { return Performance { disposition: "declined", narrative: "a `do` Work needs its repository, and the leg runs outside one: " + dna::trim_nl(top.stderr), calls: "[]", prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
            let wt = hands.git.worktree(dna::trim_nl(top.stdout), "HEAD");
            if !wt.ok { return Performance { disposition: "declined", narrative: "the Work's worktree could not be made: " + wt.error, calls: "[]", prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
            worktree = wt.output;
            base = dna::trim_nl(dna::run_tool("git\n-C\n" + worktree + "\nrev-parse\nHEAD").stdout);
        }
        let bench = ToolBench { worktree: worktree, base: base, grant: std::json::find_string_field(hat, "tool_grant"), api: hands.lease.api };
        let mut req = first;
        req.tools = tools_for_model(std::json::find_field_raw(hat, "hands"));
        let mut messages = "";
        let mut rows = "";
        let mut turn = 0;
        let mut answer = "";
        let mut refusals = 0;
        while turn < self.max_turns && len(answer) == 0 {
            turn = turn + 1;
            req.messages = "[" + messages + "]";
            req.idempotency_key = brief.attempt_id + ":call:" + to_string(turn);
            let priced = if allowance >= 0 && self.spent_micros >= allowance { "the attempt's allowance of " + to_string(allowance) + " micro-dollars is spent (" + to_string(self.spent_micros) + ")" } else { self.priced_out(req, allowance) };
            if len(priced) > 0 { return Performance { disposition: "declined", narrative: priced + " on turn " + to_string(turn), calls: "[" + self.calls + "]", receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
            let r = self.asked_with_backoff(brief, hands, req, allowance);
            if !r.ok {
                if self.effect == "uncertain" && r.made { return Performance { unresolved: "the call on turn " + to_string(turn) + " may have acted and no answer came back: " + r.refused, calls: "[" + self.calls + "]", prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
                return Performance { disposition: "failed", narrative: "the model did not answer on turn " + to_string(turn) + ": " + r.refused, calls: "[" + self.calls + "]", receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION };
            }
            if len(std::str::trim(r.tool_calls)) > 2 {
                messages = joined(messages, assistant_calls_message(r.output, r.tool_calls));
                let mut it = std::json::array_first(r.tool_calls);
                while !it.done {
                    let name = std::json::find_string_field(it.element, "name");
                    let args = std::json::find_string_field(it.element, "arguments");
                    let done = bench.call(hands, name, args);
                    let text = if done.ok { done.output } else { "error: " + done.error };
                    messages = joined(messages, tool_message(std::json::find_string_field(it.element, "id"), clipped(text)));
                    rows = joined(rows, tool_row(turn, name, args, done));
                    it = std::json::array_next(it);
                }
            } else if mode == "do" {
                // the answer stands once the validators pass on every seed touched
                let refused = bench.validate(hands, validators);
                if len(refused) == 0 {
                    answer = if len(r.output) > 0 { r.output } else { "done" };
                } else {
                    refusals = refusals + 1;
                    messages = joined(messages, text_message("assistant", r.output));
                    messages = joined(messages, text_message("user", "The validators refused the change:\n" + clipped(refused) + "\nFix it, then answer again."));
                }
            } else {
                answer = if len(r.output) > 0 { r.output } else { "(no text)" };
            }
        }
        let calls = "[" + self.calls + "]";
        if len(answer) == 0 { return Performance { disposition: "failed", narrative: "no answer within " + to_string(self.max_turns) + " turns" + (if refusals > 0 { " (the validators refused " + to_string(refusals) + " time(s))" } else { "" }), calls: calls, receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
        if mode == "do" && owed == "Patch" {
            // one commit on the base: everything the loop changed, squashed
            let soft = dna::run_tool("git\n-C\n" + bench.worktree + "\nreset\n-q\n--soft\n" + bench.base);
            let changed = dna::run_tool("git\n-C\n" + bench.worktree + "\nstatus\n--porcelain");
            if soft.code != 0 || len(std::str::trim(changed.stdout)) == 0 { return Performance { disposition: "failed", narrative: "the answer changed no file", calls: calls, receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
            let sha = hands.git.commit(bench.worktree, first_line(answer));
            if !sha.ok { return Performance { disposition: "failed", narrative: "the change could not be committed: " + sha.error, calls: calls, receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
            let patch = hands.git.patch(bench.worktree);
            if !patch.ok { return Performance { disposition: "failed", narrative: "the commit's patch could not be read: " + patch.error, calls: calls, receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION }; }
            return Performance {
                disposition: "done", result: answer, result_ref: "commit:" + sha.output,
                narrative: "the model drove the hands for " + to_string(turn) + " turn(s) and the validators passed" + self.waits_said(),
                calls: calls, receipts: patch_and_tools(patch.output, rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION
            };
        }
        return Performance { disposition: "done", result: answer, narrative: "the model drove the hands for " + to_string(turn) + " turn(s)" + self.waits_said(), calls: calls, receipts: tool_receipt(rows), prompt_digest: first.prompt_digest, renderer: RENDERER_VERSION };
    }
    // What the loop's rate limits cost in time, for its narrative.
    fn waits_said() -> String {
        return if self.retried > 0 { ", after " + to_string(self.retried) + " backed-off retries, " + to_string(self.waited_ms) + "ms waited" } else { "" };
    }
    // One turn's call, asked again after a backed-off wait while the
    // backend rate-limits a call it never made, as the single call is: the
    // lease renewed before each wait, each wait a row of evidence, none
    // once the allowance is spent. The retry is the same call (its key).
    fn asked_with_backoff(brief: Brief, hands: Hands, first: dna::ModelRequest, allowance: Int) -> dna::ModelResult {
        let mut req = first;
        let mut r = self.asked(brief, req);
        let mut tries = 0;
        let mut wait = self.backoff_ms;
        while !r.ok && rate_limited(r.refused) && !r.made && tries < self.retries {
            let kept = hands.lease.renew(wait / 1000 + 60);
            self.waited(brief, r.refused, wait, if kept.ok { "; lease renewed" } else { "; lease not renewed: " + kept.error });
            sleep_for_ms(wait);
            self.waited_ms = self.waited_ms + wait;
            wait = wait * 2;
            tries = tries + 1;
            self.retried = self.retried + 1;
            req.retry_of = brief.attempt_id;
            if allowance >= 0 && (self.spent_micros >= allowance || len(self.priced_out(req, allowance)) > 0) { return r; }
            r = self.asked(brief, req);
        }
        return r;
    }
    @unbounded
    fn perform(brief: Brief, hands: Hands) -> Performance {
        self.performed = self.performed + 1;
        self.calls = "";
        self.waited_ms = 0;
        self.retried = 0;
        self.spent_micros = 0;
        // a model the mapping named and then refused (a `tools` or `do` Work
        // on a model that returns no tool calls) is never called
        let choice = std::json::find_field_raw(brief.hat, "model");
        let named = std::json::find_string_field(choice, "model");
        if len(named) > 0 && std::str::trim(std::json::find_field_raw(choice, "ok")) == "false" {
            return Performance { disposition: "declined", narrative: "the model mapping refused `" + named + "` for this Work: " + std::json::find_string_field(choice, "why"), calls: "[]", prompt_digest: prompt_digest(brief.rendered), renderer: RENDERER_VERSION };
        }
        // the spine admits the spend before any call is made (GH #1131)
        let gate = hands.lease.allowance(ALLOWANCE_WAIT);
        if !gate.ok { return Performance { disposition: "declined", narrative: "the budget gate admitted no spend for this attempt: " + gate.error, calls: "[]", prompt_digest: prompt_digest(brief.rendered), renderer: RENDERER_VERSION }; }
        let allowance = std::str::parse_int(gate.output) or - 1;
        let class = std::json::find_string_field(brief.hat, "data_class");
        // the render alone reaches the model; the hat stays structure
        let mut req = dna::ModelRequest {
            attempt_id: brief.attempt_id, role: role_of(brief.performer_kind),
            prompt: brief.rendered, prompt_digest: prompt_digest(brief.rendered),
            context: "", context_bytes: len(brief.rendered),
            knowledge_bindings: std::json::find_string_field(brief.hat, "knowledge_bindings"),
            tool_grant: std::json::find_string_field(brief.hat, "tool_grant"),
            data_class: if len(class) > 0 { class } else { "internal" },
            cost_ceiling_micros: std::str::parse_int(std::json::find_string_field(brief.hat, "cost_ceiling")) or 0,
            // the model the Work's mapping resolved (the hat's `model`); none
            // resolved, the catalog's backend chooses as before
            model: std::json::find_string_field(std::json::find_field_raw(brief.hat, "model"), "model"),
            metadata: call_metadata(brief),
            // one call of the attempt: a retry of it is the same call
            idempotency_key: brief.attempt_id + ":call:1"
        };
        let before = self.priced_out(req, allowance);
        if len(before) > 0 { return Performance { disposition: "declined", narrative: before, calls: "[]", prompt_digest: req.prompt_digest, renderer: RENDERER_VERSION }; }
        // a Work with hands, mapped to `tools` or `do`: the model drives
        // them and the leg runs every call (the harness's loop)
        let mode = std::json::find_string_field(std::json::find_field_raw(brief.hat, "model"), "mode");
        if len(std::str::trim(std::json::find_field_raw(brief.hat, "hands"))) > 2 && (mode == "tools" || mode == "do") { return self.perform_loop(brief, hands, req, allowance, mode); }
        let mut r = self.asked(brief, req);
        let mut tries = 0;
        let mut wait = self.backoff_ms;
        // a rate-limited call that was never made is asked again after a
        // wait; one the backend may have acted on (a harness session cut
        // short by a limit) is not a call to repeat
        while !r.ok && rate_limited(r.refused) && !r.made && tries < self.retries {
            // the lease outlives the wait: renewed for the wait and a margin
            let kept = hands.lease.renew(wait / 1000 + 60);
            self.waited(brief, r.refused, wait, if kept.ok { "; lease renewed" } else { "; lease not renewed: " + kept.error });
            sleep_for_ms(wait);
            self.waited_ms = self.waited_ms + wait;
            wait = wait * 2;
            tries = tries + 1;
            req.retry_of = brief.attempt_id;
            // a retry is a call too: none once the allowance is spent
            if allowance >= 0 && self.spent_micros >= allowance { break; }
            if len(self.priced_out(req, allowance)) > 0 { break; }
            r = self.asked(brief, req);
        }
        if !r.ok && rate_limited(r.refused) && allowance >= 0 && (self.spent_micros >= allowance || len(self.priced_out(req, allowance)) > 0) {
            let why = if self.spent_micros >= allowance { "the attempt's allowance of " + to_string(allowance) + " micro-dollars is spent (" + to_string(self.spent_micros) + "); the budget gate admits no further call" } else { self.priced_out(req, allowance) };
            return Performance { disposition: "declined", narrative: why, calls: "[" + self.calls + "]", prompt_digest: req.prompt_digest, renderer: RENDERER_VERSION };
        }
        let calls = "[" + self.calls + "]";
        if !r.ok && self.effect == "uncertain" && r.made {
            // the backend says the call may have acted (`ModelResult.made`:
            // anything past the pre-flight refusals): no retry, no failover,
            // nothing handed back — the attempt is marked unresolved and waits
            // for evidence or a person
            return Performance { unresolved: "the call may have acted and no answer came back; the performer is uncertain: " + r.refused, calls: calls, prompt_digest: req.prompt_digest, renderer: RENDERER_VERSION };
        }
        if !r.ok {
            return Performance { disposition: "failed", narrative: "the model did not answer: " + r.refused + (if tries > 0 { " (after " + to_string(tries) + " backed-off retries, " + to_string(self.waited_ms) + "ms)" } else { "" }), calls: calls, prompt_digest: req.prompt_digest, renderer: RENDERER_VERSION };
        }
        // the prompt as sent is the attempt's receipt, when its class may be a git receipt
        let b = std::json::Builder { };
        b.begin_array();
        if req.data_class == "public" || req.data_class == "internal" {
            b.begin_object();
            b.string_field("class", req.data_class);
            b.string_field("body", brief.rendered);
            b.end_object();
        }
        b.end_array();
        return Performance {
            disposition: "done", result: r.output, narrative: "the " + r.backend + " backend (" + r.model + ") answered" + (if tries > 0 { " after " + to_string(tries) + " backed-off retries, " + to_string(self.waited_ms) + "ms waited" } else { "" }),
            calls: calls, receipts: b.result(), prompt_digest: req.prompt_digest, renderer: RENDERER_VERSION
        };
    }
}
