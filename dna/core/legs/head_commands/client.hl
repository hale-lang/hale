type CommandReceipt {
    command_id: String;
    request_id: String;
    application_id: String;
    operation: String;
    operation_version: String;
    principal_mode: String;
    principal_name: String;
    principal_positions: String;
    position_id: String;
    target_kind: String;
    target_id: String;
    subject_digest: String;
    fingerprint: String;
    state: String;
    reason: String;
    proposal_state: String;
    verdict_value: String;
    verdict_state: String;
    candidate_digest: String;
    review_id: String;
    review_state: String;
    review_outcome: String;
    review_subject_digest: String;
    activation_state: String;
    activation_reason: String;
    organization: OrganizationCommandOutcome;
    task: TaskCommandOutcome;
    person: PersonRetirementOutcome;
    task_create: TaskCreateOutcome;
    attempt: AttemptCommandOutcome;
}

fn api_enc_CommandReceipt(v: CommandReceipt) -> String {
    return "{\"command_id\":" + api_str(v.command_id) + ",\"request_id\":" + api_str(v.request_id) + ",\"application_id\":" + api_str(v.application_id) + ",\"operation\":" + api_str(v.operation) + ",\"operation_version\":" + api_str(v.operation_version) + ",\"principal_mode\":" + api_str(v.principal_mode) + ",\"principal_name\":" + api_str(v.principal_name) + ",\"principal_positions\":" + api_str(v.principal_positions) + ",\"position_id\":" + api_str(v.position_id) + ",\"target_kind\":" + api_str(v.target_kind) + ",\"target_id\":" + api_str(v.target_id) + ",\"subject_digest\":" + api_str(v.subject_digest) + ",\"fingerprint\":" + api_str(v.fingerprint) + ",\"state\":" + api_str(v.state) + ",\"reason\":" + api_str(v.reason) + ",\"proposal_state\":" + api_str(v.proposal_state) + ",\"verdict_value\":" + api_str(v.verdict_value) + ",\"verdict_state\":" + api_str(v.verdict_state) + ",\"candidate_digest\":" + api_str(v.candidate_digest) + ",\"review_id\":" + api_str(v.review_id) + ",\"review_state\":" + api_str(v.review_state) + ",\"review_outcome\":" + api_str(v.review_outcome) + ",\"review_subject_digest\":" + api_str(v.review_subject_digest) + ",\"activation_state\":" + api_str(v.activation_state) + ",\"activation_reason\":" + api_str(v.activation_reason) + ",\"organization\":" + api_enc_OrganizationCommandOutcome(v.organization) + ",\"task\":" + api_enc_TaskCommandOutcome(v.task) + ",\"person\":" + api_enc_PersonRetirementOutcome(v.person) + ",\"task_create\":" + api_enc_TaskCreateOutcome(v.task_create) + ",\"attempt\":" + api_enc_AttemptCommandOutcome(v.attempt) + "}";
}

fn api_dec_CommandReceipt(json: String) -> CommandReceipt {
    return CommandReceipt {
        command_id: std::json::find_string_field(json, "command_id"),
        request_id: std::json::find_string_field(json, "request_id"),
        application_id: std::json::find_string_field(json, "application_id"),
        operation: std::json::find_string_field(json, "operation"),
        operation_version: std::json::find_string_field(json, "operation_version"),
        principal_mode: std::json::find_string_field(json, "principal_mode"),
        principal_name: std::json::find_string_field(json, "principal_name"),
        principal_positions: std::json::find_string_field(json, "principal_positions"),
        position_id: std::json::find_string_field(json, "position_id"),
        target_kind: std::json::find_string_field(json, "target_kind"),
        target_id: std::json::find_string_field(json, "target_id"),
        subject_digest: std::json::find_string_field(json, "subject_digest"),
        fingerprint: std::json::find_string_field(json, "fingerprint"),
        state: std::json::find_string_field(json, "state"),
        reason: std::json::find_string_field(json, "reason"),
        proposal_state: std::json::find_string_field(json, "proposal_state"),
        verdict_value: std::json::find_string_field(json, "verdict_value"),
        verdict_state: std::json::find_string_field(json, "verdict_state"),
