// dna/host/record.hl — the record as the host reads and writes it
// (GH #566 F8). The Journal is `refs/dna/journal` in the governed
// repository; the core's `GitJournal` reads it, and the host appends
// in a person's or a node's name, syncs it with the remote, and reads
// receipts by digest. Nothing here decides.

import "../core" as dna;

const RECORD_REF: String = "refs/dna/journal";
const REMOTE_TRACK: String = "refs/dna/remote/journal";
const VERDICT_SOCK: String = "hale-dna.review.verdict.sock";
const INTENT_SOCK: String = "hale-dna.intent.offered.sock";
const OBSERVED_SOCK: String = "hale-dna.expression.observed.sock";
const PRESSURE_SOCK: String = "hale-dna.pressure.raised.sock";
const CONCERN_SOCK: String = "hale-dna.concern.raised.sock";
const IDENTITY_REF: String = "refs/dna/identity";

// `git -C <repo> <args…>`; argv newline-separated.
fn git(repo: String, args: String) -> dna::RunResult {
    return dna::run_tool("git\n-C\n" + repo + "\n" + args);
}

fn git_ok(repo: String, args: String) -> Bool {
    return git(repo, args).code == 0;
}

// stdout without the trailing newline, "" when the command failed.
fn git_out(repo: String, args: String) -> String {
    let r = git(repo, args);
    if r.code != 0 { return ""; }
    return dna::trim_nl(r.stdout);
}

fn git_err(repo: String, args: String) -> String {
    let r = git(repo, args);
    if r.code == 0 { return ""; }
    let e = dna::trim_nl(r.stderr);
    if len(e) == 0 { return "git " + args + " failed"; }
    return e;
}

// write_file as a Bool, so a caller can act on failure.
fn write_text(path: String, text: String) -> Bool fallible(IoError) {
    std::io::fs::write_file(path, text) or raise;
    return true;
}

fn record_head(repo: String) -> String {
    return git_out(repo, "rev-parse\n-q\n--verify\n" + RECORD_REF);
}

// The remote the record syncs with ("" when the repository has none).
fn record_remote(repo: String) -> String {
    let named = git_out(repo, "config\ndna.remote");
    let name = if len(named) == 0 { "origin" } else { named };
    if !git_ok(repo, "remote\nget-url\n" + name) { return ""; }
    return name;
}

// GH #604 rule 6: the admission boundary for record-originated rows.
// `dna.trust` is `local` (default: every writer to the record is
// trusted, the operator's profile) or `signed` (a relayed row is admitted
// only when its commit carries a signature git verifies — git's own
// keyring or allowed-signers file is the list of who may act).
fn trust_mode(root: String) -> String {
    let t = dna::trim_nl(git_out(root, "config\ndna.trust"));
    return if len(t) == 0 { "local" } else { t };
}

fn row_verified(root: String, sha: String) -> Bool {
    return git_ok(root, "verify-commit\n" + sha);
}

fn membrane_up(root: String) -> Bool {
    let d = root + "/.hale/dna/";
    return std::io::fs::file_exists(d + VERDICT_SOCK) && std::io::fs::file_exists(d + INTENT_SOCK);
}

fn short(s: String) -> String {
    if len(s) > 12 { return s[0..12]; }
    return s;
}

fn shape_of(path: String) -> String {
    let t = std::io::fs::read_file(path) or "";
    return std::json::find_string_field(t, "shape_hash");
}

// The receipt filed under a digest, or absent.
type Receipt {
    present: Bool = false;
    text: String = "";
}

fn receipt_read(repo: String, digest: String) -> Receipt {
    let r = git(repo, "cat-file\n-p\nrefs/dna/receipts/" + digest);
    if r.code != 0 { return Receipt { }; }
    return Receipt { present: true, text: r.stdout };
}

// The last non-empty line of a text.
fn last_line(text: String) -> String {
    let mut rest = text;
    let mut last = "";
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        if len(dna::trim_nl(line)) > 0 { last = line; }
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return last;
}

fn count_lines(text: String) -> Int {
    let mut rest = text;
    let mut n = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        if len(dna::trim_nl(line)) > 0 { n = n + 1; }
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
    }
    return n;
}

// One commit for `journal.jsonl` plus one row on top of `head`, whose
// journal text is `text`; the row is numbered `seq` and carries `who`
// as its author. Returns the commit, "" when a plumbing step failed.
// Touches no ref: `append_as` swaps one in under compare-and-swap, and
// a reconcile builds a whole chain of these beside the live ref and
// swaps once (GH #603).
fn commit_row(repo: String, head: String, text: String, seq: Int, kind: String, entity: String, body: String, who: String) -> String {
    let dna_dir = repo + "/.hale/dna";
    std::io::fs::mkdir(repo + "/.hale") or discard;
    std::io::fs::mkdir(dna_dir) or discard;
    let pid = to_string(std::process::pid());
    let tmp = dna_dir + "/journal.host." + pid + ".tmp";
    let idx = dna_dir + "/index.host." + pid + ".tmp";
    let user = git_out(repo, "config\nuser.name");
    let identity = if len(user) == 0 { "-c\nuser.name=host\n-c\nuser.email=host@dna\n" } else { "" };
    let b = std::json::Builder { };
    b.begin_object();
    b.int_field("seq", seq);
    b.string_field("kind", kind);
    b.string_field("entity", entity);
    b.string_field("body", body);
    b.string_field("author", who);
    b.end_object();
    let wrote = write_text(tmp, text + b.result() + "\n") or false;
    if !wrote { return ""; }
    let blob = git_out(repo, "hash-object\n-w\n" + tmp);
    if len(blob) == 0 { return ""; }
    std::io::fs::unlink(idx) or discard;
    let withidx = "env\nGIT_INDEX_FILE=" + idx + "\ngit\n-C\n" + repo + "\n";
    let rt = dna::run_tool(withidx + (if len(head) > 0 { "read-tree\n" + head } else { "read-tree\n--empty" }));
    if rt.code != 0 { return ""; }
    let ui = dna::run_tool(withidx + "update-index\n--add\n--cacheinfo\n100644," + blob + ",journal.jsonl");
    if ui.code != 0 { return ""; }
    let wt = dna::run_tool(withidx + "write-tree");
    if wt.code != 0 { return ""; }
    let tree = dna::trim_nl(wt.stdout);
    let parent = if len(head) > 0 { "-p\n" + head + "\n" } else { "" };
    // GH #604 rule 6: under `dna.trust = signed` a row this clone writes
    // is a signed commit (git's signing config decides with what), so a
    // relay elsewhere can admit it as its author's
    let sign = if dna::trim_nl(git_out(repo, "config\ndna.trust")) == "signed" { "-S\n" } else { "" };
    let commit = git_out(repo, identity + "commit-tree\n" + tree + "\n" + parent + sign + "-m\n" + kind + " " + entity);
    std::io::fs::unlink(tmp) or discard;
    std::io::fs::unlink(idx) or discard;
    return commit;
}

// The journal text at a commit ("" for none), newline-terminated.
@unbounded
fn journal_text_at(repo: String, commit: String) -> String {
    if len(commit) == 0 { return ""; }
    let t = dna::trim_nl(git_out(repo, "show\n" + commit + ":journal.jsonl"));
    return if len(t) == 0 { "" } else { t + "\n" };
}

// Append one event to the record in `author`'s name ("" = git's
// identity for whoever runs this): one commit on the ref,
// compare-and-swapped, re-appended at the new tail when the ref moved.
// A lost race is not a failure: the tail moved, so the append goes
// round with the new tail — as many times as it takes within a bound
// that only a wedged repository reaches. Three tries used to be the
// bound, and a host reconciling beside a busy organism lost them all
// and dropped the row (GH #603).
@unbounded
fn append_as(repo: String, kind: String, entity: String, body: String, author: String) -> Bool {
    let user = git_out(repo, "config\nuser.name");
    let who = if len(author) > 0 { author } else { if len(user) > 0 { user } else { "host" } };
    let mut tries = 0;
    while tries < 200 {
        tries = tries + 1;
        let head = record_head(repo);
        let text = journal_text_at(repo, head);
        let commit = commit_row(repo, head, text, count_lines(text), kind, entity, body, who);
        if len(commit) == 0 { return false; }
        if git_ok(repo, "update-ref\n" + RECORD_REF + "\n" + commit + "\n" + head) { return true; }
        // the ref moved under us: re-read and re-append at the new tail
    }
    return false;
}

type SyncResult {
    ok: Bool = true;
    summary: String = "";
}

fn sync_failed(why: String) -> SyncResult {
    return SyncResult { ok: false, summary: why };
}

// Fetch, reconcile, push (GH #566 F1). Local ahead: push. Remote ahead:
// fast-forward. Diverged: the local-only events are re-appended on top
// of the remote's head, bodies and authors unchanged, then pushed.
@unbounded
fn sync_record(repo: String) -> SyncResult {
    let s = sync_record_rows(repo);
    if s.ok {
        let r = apply_redactions(repo);
        let i = publish_identity(repo);
    }
    return s;
}

// GH #615: a record's identity is the root commit of its journal. It is
// published as a blob under refs/dna/identity, so another record can name
// this one (and write into its mailbox for it) without reading its journal.
fn record_identity(repo: String) -> String {
    return git_out(repo, "rev-list\n--max-parents=0\n" + RECORD_REF);
}

fn publish_identity(repo: String) -> Bool {
    let genesis = record_identity(repo);
    if len(genesis) == 0 { return false; }
    if git_out(repo, "cat-file\n-p\n" + IDENTITY_REF) == genesis { return true; }
    std::io::fs::mkdir(repo + "/.hale") or discard;
    std::io::fs::mkdir(repo + "/.hale/dna") or discard;
    let tmp = repo + "/.hale/dna/identity." + to_string(std::process::pid()) + ".tmp";
    let w = write_text(tmp, genesis) or false;
    let blob = git_out(repo, "hash-object\n-w\n" + tmp);
    std::io::fs::unlink(tmp) or discard;
    if len(blob) == 0 || !git_ok(repo, "update-ref\n" + IDENTITY_REF + "\n" + blob) { return false; }
    let remote = record_remote(repo);
    if len(remote) > 0 { let p = git(repo, "push\n-q\n" + remote + "\n" + IDENTITY_REF + ":" + IDENTITY_REF); }
    return true;
}

// GH #606: a redacted git receipt's ref goes from this clone and from
// the remote on every sync, so a clone that fetched it drops it at its
// next sync. The blob lingers in each object store until git collects it.
@unbounded
fn apply_redactions(repo: String) -> Int {
    let text = git_out(repo, "show\n" + RECORD_REF + ":journal.jsonl") + "\n";
    let remote = record_remote(repo);
    let mut n = 0;
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::json::find_string_field(line, "kind") != "receipt.redacted" { continue; }
        let digest = std::json::find_string_field(line, "entity");
        let hexd = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
        let ref = "refs/dna/receipts/" + hexd;
        if git_out(repo, "rev-parse\n-q\n--verify\n" + ref) != "" {
            let d = git(repo, "update-ref\n-d\n" + ref);
            n = n + 1;
        }
        if len(remote) > 0 && len(git_out(repo, "ls-remote\n" + remote + "\n" + ref)) > 0 {
            let p = git(repo, "push\n-q\n" + remote + "\n--delete\n" + ref);
            n = n + 1;
        }
    }
    return n;
}

@unbounded
fn sync_record_rows(repo: String) -> SyncResult {
    let remote = record_remote(repo);
    if len(remote) == 0 { return SyncResult { ok: true, summary: "no remote: the record is local" }; }
    let f = git(repo, "fetch\n-q\n" + remote + "\n+" + RECORD_REF + ":" + REMOTE_TRACK + "\n+refs/dna/receipts/*:refs/dna/receipts/*\n+refs/dna/exchange/*:refs/dna/exchange/*");
    if f.code != 0 {
        // a remote with no record yet is not an error
        if !std::str::contains(f.stderr, "ouldn't find remote ref") { return sync_failed("fetch " + remote + ": " + dna::trim_nl(f.stderr)); }
    }
    let mut summary = "";
    let mut round = 0;
    while round < 3 {
        round = round + 1;
        let local = record_head(repo);
        let remote_head = git_out(repo, "rev-parse\n-q\n--verify\n" + REMOTE_TRACK);
        if len(local) == 0 {
            if len(remote_head) > 0 {
                if !git_ok(repo, "update-ref\n" + RECORD_REF + "\n" + remote_head) { return sync_failed("update-ref failed"); }
                summary = "pulled the record";
            }
            return SyncResult { ok: true, summary: summary };
        }
        if len(remote_head) == 0 {
            // The remote has no record yet: a governed repository whose
            // first events were appended here, or a clone that pushed
            // `main` alone. This said "up to date" and pushed nothing,
            // so the record stayed on one machine and a second clone saw
            // an organization with no history (the shakeout's finding 7).
            summary = "pushed " + git_out(repo, "rev-list\n--count\n" + local) + " event(s) (the remote had none)";
        } else if local == remote_head {
            if len(summary) == 0 { summary = "up to date"; }
            return SyncResult { ok: true, summary: summary };
        } else if git_ok(repo, "merge-base\n--is-ancestor\n" + remote_head + "\n" + local) {
            // local ahead: push below
            summary = "pushed " + git_out(repo, "rev-list\n--count\n" + remote_head + ".." + local) + " event(s)";
        } else if git_ok(repo, "merge-base\n--is-ancestor\n" + local + "\n" + remote_head) {
            if !git_ok(repo, "update-ref\n" + RECORD_REF + "\n" + remote_head + "\n" + local) { return sync_failed("update-ref failed"); }
            summary = "pulled " + git_out(repo, "rev-list\n--count\n" + local + ".." + remote_head) + " event(s)";
            return SyncResult { ok: true, summary: summary };
        } else {
            // diverged: the local-only events are re-appended on top of
            // the remote's head — on a chain built BESIDE the live ref,
            // swapped in with one compare-and-swap once it is whole. The
            // ref used to be rewound to the remote's head first and the
            // events re-appended behind it one by one: for that whole
            // window the record had lost rows it held a moment before —
            // a reader saw a Review vanish from the board, an organism
            // whose append lost the ref race reloaded without its own
            // rows, and a re-append that lost three races left them
            // lost for good (GH #603). Nothing here changes the ref
            // until the whole chain exists; a local-only commit with no
            // row is a refusal, never a silent skip.
            let mine = git_out(repo, "rev-list\n--reverse\n" + remote_head + ".." + local) + "\n";
            let mut chain = remote_head;
            let mut n = 0;
            let mut rest = mine;
            let mut broken = "";
            while len(rest) > 0 && len(broken) == 0 {
                let nl = std::str::index_of(rest, "\n");
                let c = if nl < 0 { rest } else { rest[0..nl] };
                if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
                if len(c) == 0 { continue; }
                let line = last_line(git_out(repo, "show\n" + c + ":journal.jsonl"));
                if len(line) == 0 { broken = "local event " + c + " has no row"; continue; }
                let text = journal_text_at(repo, chain);
                let commit = commit_row(repo, chain, text, count_lines(text),
                    std::json::find_string_field(line, "kind"), std::json::find_string_field(line, "entity"),
                    std::json::find_string_field(line, "body"), std::json::find_string_field(line, "author"));
                if len(commit) == 0 { broken = "re-append of " + c + " failed"; continue; }
                chain = commit;
                n = n + 1;
            }
            if len(broken) > 0 { return sync_failed(broken + "; the record was not changed"); }
            if !git_ok(repo, "update-ref\n" + RECORD_REF + "\n" + chain + "\n" + local) {
                // this clone appended while the chain was built: the
                // record was not changed; go round with the new tail
                summary = "the record moved while reconciling";
                continue;
            }
            summary = "re-appended " + to_string(n) + " local event(s) onto the remote's " + git_out(repo, "rev-list\n--count\n" + local + ".." + remote_head);
        }
        if git_ok(repo, "push\n-q\n" + remote + "\n" + RECORD_REF + ":" + RECORD_REF + "\nrefs/dna/receipts/*:refs/dna/receipts/*") {
            let h = record_head(repo);
            git_ok(repo, "update-ref\n" + REMOTE_TRACK + "\n" + h);
            return SyncResult { ok: true, summary: summary };
        }
        // the remote moved again: fetch and go round
        if !git_ok(repo, "fetch\n-q\n" + remote + "\n+" + RECORD_REF + ":" + REMOTE_TRACK) { return sync_failed("fetch failed"); }
    }
    if summary == "the record moved while reconciling" { return sync_failed(summary + " three times; nothing was changed — sync again"); }
    return SyncResult { ok: true, summary: summary };
}

// The membrane client, exec'd with routes to this project's sockets:
// one typed fact published, the organization decides.
//
// The routes are RELATIVE and the client runs in the project's root.
// A Unix address is at most 108 bytes, path included, and the
// organization binds these names relative to the same root — so an
// absolute route was the only long side: an ordinary project path
// (a home directory, a checkout, a worktree) pushed the client past
// the limit and it could not connect to sockets that were there and
// listening (the shakeout's finding 6).
fn publish_on_membrane(root: String, kind: String, body: String) -> String {
    let bin = std::env::var("HALE_DNA_MEMBRANE");
    if len(bin) == 0 { return "no membrane client (HALE_DNA_MEMBRANE unset)"; }
    let d = ".hale/dna/";
    let conf = "/tmp/hale-dna-membrane-" + to_string(std::process::pid()) + ".conf";
    let text = "dna.review.verdict = unix://" + d + VERDICT_SOCK + " : connect\n"
        + "dna.intent.offered = unix://" + d + INTENT_SOCK + " : connect\n"
        + "dna.expression.observed = unix://" + d + OBSERVED_SOCK + " : connect\n"
        + "dna.pressure.raised = unix://" + d + PRESSURE_SOCK + " : connect\n"
        + "dna.concern.raised = unix://" + d + CONCERN_SOCK + " : connect\n";
    let wrote = write_text(conf, text) or false;
    if !wrote { return "cannot write " + conf; }
    let r = dna::run_tool("sh\n-c\ncd \"$1\" && LOTUS_BUS_CONFIG=\"$2\" exec \"$3\" \"$4\" \"$5\"\nsh\n" + root + "\n" + conf + "\n" + bin + "\n" + kind + "\n" + body);
    std::io::fs::unlink(conf) or discard;
    if r.code != 0 { return "membrane client failed: " + r.stderr; }
    return "";
}

// ---- the body lease (GH #617) ---------------------------------------
// A record admits one body at a time: the host that runs its organism
// holds `refs/dna/lease/body` — at the remote when the record has
// one, so two hosts on two clones fence each other through the remote
// itself (a blob pushed with `--force-with-lease`, git's own
// compare-and-swap), and in the clone otherwise. The blob is the
// lease as `GitLeases` writes it: "holder\ntoken\nexpires\npresent".
// The holder is `user@host:<clone>`, so the same clone restarting is
// the same holder and takes its lease back at once, and a second
// clone — a second body — is refused until the lease expires or
// someone forces it. The host renews on tick and asserts the lease
// before every consequential act; a body whose lease is no longer its
// own stops (a partitioned server executes nothing past its TTL).
const BODY_LEASE_REF: String = "refs/dna/lease/body";
const BODY_LEASE_TRACK: String = "refs/dna/remote/lease/body";
const BODY_TTL: Int = 30;

type BodyLease {
    ok: Bool = true; // false: the remote could not be read (a partition)
    present: Bool = false;
    holder: String = "";
    token: Int = 0;
    expires: Int = 0;
    sha: String = ""; // the blob the ref points at ("" = no lease)
}

fn body_holder(root: String) -> String {
    let user = std::env::var("USER");
    let h = dna::run_tool("hostname");
    let host = if h.code == 0 { dna::trim_nl(h.stdout) } else { "localhost" };
    let abs = dna::run_tool("sh\n-c\ncd \"$1\" && pwd -P\nsh\n" + root);
    let place = if abs.code == 0 { dna::trim_nl(abs.stdout) } else { root };
    return (if len(user) > 0 { user } else { "body" }) + "@" + host + ":" + place;
}

fn parse_body_lease(sha: String, text: String) -> BodyLease {
    if len(text) == 0 { return BodyLease { }; }
    let a = std::str::index_of(text, "\n");
    if a < 0 { return BodyLease { }; }
    let holder = text[0..a];
    let rest = text[(a + 1)..len(text)];
    let b = std::str::index_of(rest, "\n");
    if b < 0 { return BodyLease { }; }
    let token = std::str::parse_int(rest[0..b]) or 0;
    let rest2 = rest[(b + 1)..len(rest)];
    let c = std::str::index_of(rest2, "\n");
    if c < 0 { return BodyLease { }; }
    let expires = std::str::parse_int(rest2[0..c]) or 0;
    let present = dna::trim_nl(rest2[(c + 1)..len(rest2)]) == "1";
    return BodyLease { present: present, holder: holder, token: token, expires: expires, sha: sha };
}

// The lease as the record's authority has it: the remote's ref when
// there is a remote (fetched now), the clone's otherwise. `ok` false
// when the remote could not be reached.
fn body_lease_read(repo: String) -> BodyLease {
    let remote = record_remote(repo);
    let mut ref = BODY_LEASE_REF;
    if len(remote) > 0 {
        let f = git(repo, "fetch\n-q\n" + remote + "\n+" + BODY_LEASE_REF + ":" + BODY_LEASE_TRACK);
        if f.code != 0 {
            if !std::str::contains(f.stderr, "ouldn't find remote ref") { return BodyLease { ok: false }; }
            let gone = git(repo, "update-ref\n-d\n" + BODY_LEASE_TRACK);
            return BodyLease { };
        }
        ref = BODY_LEASE_TRACK;
    }
    let sha = git_out(repo, "rev-parse\n-q\n--verify\n" + ref);
    if len(sha) == 0 { return BodyLease { }; }
    let r = git(repo, "cat-file\n-p\n" + sha);
    if r.code != 0 { return BodyLease { }; }
    return parse_body_lease(sha, r.stdout);
}

// Write a lease where `expected` is the blob the ref points at now
// ("" = no lease): compare-and-swap at the remote (push with
// --force-with-lease) or in the clone (update-ref with the old value).
// The clone's own ref mirrors what was written. False when someone
// else moved it first.
fn body_lease_write(repo: String, l: BodyLease, expected: String) -> Bool {
    std::io::fs::mkdir(repo + "/.hale") or discard;
    std::io::fs::mkdir(repo + "/.hale/dna") or discard;
    let tmp = repo + "/.hale/dna/body-lease." + to_string(std::process::pid()) + ".tmp";
    let w = write_text(tmp, l.holder + "\n" + to_string(l.token) + "\n" + to_string(l.expires) + "\n" + (if l.present { "1" } else { "0" })) or false;
    if !w { return false; }
    let blob = git_out(repo, "hash-object\n-w\n" + tmp);
    std::io::fs::unlink(tmp) or discard;
    if len(blob) == 0 { return false; }
    let remote = record_remote(repo);
    if len(remote) > 0 {
        let p = git(repo, "push\n-q\n" + remote + "\n" + blob + ":" + BODY_LEASE_REF + "\n--force-with-lease=" + BODY_LEASE_REF + ":" + expected);
        if p.code != 0 { return false; }
        let t = git(repo, "update-ref\n" + BODY_LEASE_TRACK + "\n" + blob);
        let m = git(repo, "update-ref\n" + BODY_LEASE_REF + "\n" + blob);
        return true;
    }
    let cas = if len(expected) > 0 { git(repo, "update-ref\n" + BODY_LEASE_REF + "\n" + blob + "\n" + expected) } else { git(repo, "update-ref\n" + BODY_LEASE_REF + "\n" + blob + "\n" + "0000000000000000000000000000000000000000") };
    return cas.code == 0;
}

fn body_live(l: BodyLease, now: Int) -> Bool { return l.present && l.expires > now; }

// Take the body lease for `holder`, or learn who holds it: a live
// lease of another holder is refused (present false, holder theirs),
// unless `force`. A refused acquire because of a partition is `ok`
// false.
fn body_acquire(repo: String, holder: String, now: Int, force: Bool) -> BodyLease {
    let cur = body_lease_read(repo);
    if !cur.ok { return cur; }
    if body_live(cur, now) && cur.holder != holder && !force {
        // theirs, not ours: `present` is false for the caller, `holder` says whose
        return BodyLease { present: false, holder: cur.holder, token: cur.token, expires: cur.expires, sha: cur.sha };
    }
    let l = BodyLease { present: true, holder: holder, token: cur.token + 1, expires: now + BODY_TTL };
    if !body_lease_write(repo, l, cur.sha) {
        let again = body_lease_read(repo);
        if !again.ok { return again; }
        if again.holder == holder && body_live(again, now) { return again; }
        return BodyLease { present: false, holder: again.holder, token: again.token, expires: again.expires, sha: again.sha };
    }
    let mine = body_lease_read(repo);
    return if mine.ok && mine.holder == holder && mine.token == l.token { mine } else { BodyLease { present: true, holder: holder, token: l.token, expires: l.expires, sha: git_out(repo, "rev-parse\n-q\n--verify\n" + BODY_LEASE_REF) } };
}

// Renew a lease that is still ours; the renewed lease, or the lease as
// someone else now has it (present false for us), or `ok` false when
// the remote could not be reached — the caller keeps the lease it had
// until that one expires.
fn body_renew(repo: String, mine: BodyLease, now: Int) -> BodyLease {
    let cur = body_lease_read(repo);
    if !cur.ok { return cur; }
    if !(cur.present && cur.holder == mine.holder && cur.token == mine.token) {
        return BodyLease { present: false, holder: cur.holder, token: cur.token, expires: cur.expires, sha: cur.sha };
    }
    let l = BodyLease { present: true, holder: mine.holder, token: mine.token, expires: now + BODY_TTL };
    if !body_lease_write(repo, l, cur.sha) {
        let again = body_lease_read(repo);
        if !again.ok { return again; }
        return BodyLease { present: false, holder: again.holder, token: again.token, expires: again.expires, sha: again.sha };
    }
    return BodyLease { present: true, holder: mine.holder, token: mine.token, expires: l.expires, sha: git_out(repo, "rev-parse\n-q\n--verify\n" + BODY_LEASE_REF) };
}

// Give the lease up (present false, token kept so a late renewal of it
// is refused). True when it was ours to give up.
fn body_release(repo: String, mine: BodyLease) -> Bool {
    let cur = body_lease_read(repo);
    if !cur.ok || !cur.present || cur.holder != mine.holder || cur.token != mine.token { return false; }
    return body_lease_write(repo, BodyLease { present: false, holder: cur.holder, token: cur.token, expires: 0 }, cur.sha);
}

fn ago(secs: Int) -> String {
    if secs < 0 { return "just now"; }
    if secs < 90 { return to_string(secs) + "s ago"; }
    if secs < 5400 { return to_string(secs / 60) + "m ago"; }
    if secs < 172800 { return to_string(secs / 3600) + "h ago"; }
    return to_string(secs / 86400) + "d ago";
}

// The body line of `status` and `profile`: who runs this record's
// organism, from the lease alone.
fn body_line(repo: String, now: Int) -> String {
    let l = body_lease_read(repo);
    if !l.ok { return "unknown (the remote cannot be reached)"; }
    if len(l.holder) == 0 { return "none (no body has run this record; `hale dna run` takes the lease)"; }
    let ticked = ago(now - (l.expires - BODY_TTL));
    if body_live(l, now) { return "live on " + l.holder + ", ticked " + ticked + ", lease expires in " + to_string(l.expires - now) + "s"; }
    if l.present { return "stale: " + l.holder + " last ticked " + ticked + " and its lease has expired; `hale dna run` takes it, `hale dna body claim` says so"; }
    return "released by " + l.holder + "; `hale dna run` takes the lease";
}
