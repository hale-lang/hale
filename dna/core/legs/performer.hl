// dna/core/legs/performer.hl — who performs a Work in a leg (GH #946
// slice 4).
//
// A performer takes a brief — the hat as the head rendered it, and the
// lease the Work is held under — and the hands it may use, and answers
// with a performance: a disposition and a result to hand back, the
// calls it made as evidence, the receipts to file, and the digest of
// what it rendered the hat into. Three kinds: a person (the brief is
// rendered for them and the outcome is theirs to submit), a
// deterministic performer (a program: it wins for the work kinds it
// takes), and a model (`ModelPerformer` in model.hl, the catalog's
// router as a leg; `NoModel` takes nothing, so the work is a person's).
// The project's catalog (`dna/org/work.hl`, generated at init) names
// one of each; the head's contract stays a result struct until #732
// gives the performers a contract of their own.
//
// Every performer declares an effect class (GH #946, the voice split's
// review): what a settle that failed may have left behind. `effect_free`
// answered and touched nothing, `idempotent` may be run again to the
// same end, `uncertain` — an agent's seat with tools — may have acted
// once already. A settle that fails on the first two may be retried by
// the loop; an uncertain one is never retried by a program: the leg
// files friction naming the request and leaves the lease held, until
// evidence or a person decides. The class rides on the claim, where it
// is the filter (a Work admits the classes its requirement allows), and
// on the outcome, where it is evidence. There is no default class: a
// performer that declares none is refused when the leg is seeded.
import ".." as dna;

// What a performer is handed: the Work as the hat says it, the lease it
// is held under, and the hat rendered for the performer's kind.
type Brief {
    work_id: String = "";
    attempt_id: String = "";
    task_id: String = "";
    performer_kind: String = ""; // agent | edit | human | service | software
    position: String = ""; // the graph's `position:<name>`
    hat: String = ""; // the hat's JSON, as the head rendered it
    hat_digest: String = "";
    hat_head: String = "";
    hat_watermark: Int = -1;
    holder: String = "";
    token: Int = 0;
    until: Int = 0;
    rendered: String = ""; // the hat rendered for this performer (`render`)
    render_mode: String = ""; // text | prompt | agent
}

// What a performer answers with.
type Performance {
    disposition: String = ""; // done | failed | declined | timeout; "" when nothing was performed
    result: String = "";
    result_ref: String = "";
    narrative: String = "";
    calls: String = "[]"; // the model calls made, a JSON array of evidence objects
    receipts: String = "[]"; // {class, body} to file with the outcome
    prompt_digest: String = ""; // the digest of what the performer was shown
    renderer: String = "";
    pending: Bool = false; // a person's: the outcome is theirs to submit later
    refused: String = ""; // why the performer would not perform, "" when it did
    unresolved: String = ""; // an uncertain performer's reply was lost: why; nothing is handed back, the lease is kept
}

// A performer, structurally: its kind, the work kinds it takes, and one
// performance of one brief with the hands it is given.
interface Performer {
    fn kind() -> String;
    fn takes(performer_kind: String) -> Bool;
    fn effect_class() -> String;
    fn perform(brief: Brief, hands: Hands) -> Performance;
}

// A person: the brief is rendered as text for them; the outcome comes
// back through `hale dna work submit`, under the lease the brief names.
locus Person {
    params { name: String = "person"; effect: String = ""; briefed: Int = 0; }
    fn kind() -> String { return "person"; }
    fn takes(performer_kind: String) -> Bool { return true; }
    fn effect_class() -> String { return self.effect; }
    fn perform(brief: Brief, hands: Hands) -> Performance {
        self.briefed = self.briefed + 1;
        return Performance {
            pending: true, prompt_digest: prompt_digest(brief.rendered), renderer: RENDERER_VERSION,
            narrative: "a person performs " + brief.attempt_id + ": `hale dna work submit --attempt " + brief.attempt_id + " --holder " + brief.holder + " --token " + to_string(brief.token) + " --result <text>` hands the outcome back under the lease (until " + to_string(brief.until) + ")"
        };
    }
}

// No deterministic performer: nothing is taken.
locus NoDeterministic {
    fn kind() -> String { return "deterministic"; }
    fn takes(performer_kind: String) -> Bool { return false; }
    fn effect_class() -> String { return "effect_free"; }
    fn perform(brief: Brief, hands: Hands) -> Performance {
        return Performance { refused: "no deterministic performer takes " + brief.performer_kind + " work in this project (dna/org/work.hl names none)" };
    }
}

// No model: a project with no backend configured (or one that keeps
// its models for the editor and leader) hands the work to a person.
locus NoModel {
    fn kind() -> String { return "model"; }
    fn takes(performer_kind: String) -> Bool { return false; }
    fn effect_class() -> String { return "effect_free"; }
    fn perform(brief: Brief, hands: Hands) -> Performance {
        return Performance { refused: "no model performs " + brief.performer_kind + " work in this project; a person does (`hale dna work brief --render text`), or a deterministic performer in dna/org/work.hl (`legs::ModelPerformer { router: agent_models() }` puts the catalog behind it)" };
    }
}

// A deterministic performer that answers every brief of its kinds with
// one fixed result: the shape a project's own program takes, and the
// one a fixture wires.
locus FixedAnswer {
    params { name: String = "fixed"; kinds: String = "agent"; effect: String = ""; result: String = ""; narrative: String = "a fixed answer"; performed: Int = 0; }
    fn kind() -> String { return "deterministic"; }
    fn takes(performer_kind: String) -> Bool { return dna::word_in(performer_kind, self.kinds); }
    fn effect_class() -> String { return self.effect; }
    fn perform(brief: Brief, hands: Hands) -> Performance {
        self.performed = self.performed + 1;
        return Performance { disposition: "done", result: self.result, narrative: self.narrative, prompt_digest: prompt_digest(brief.rendered), renderer: RENDERER_VERSION };
    }
}

// The project's performers, one of each kind: the deterministic one
// wins for the work kinds it takes; a person's work is a person's; the
// rest is the model's when the model takes the kind, a person's else.
// Why a performer is unseated: it declares no class, or one that is not
// an effect class.
fn unseated_text(who: String, class: String) -> String {
    if class == "" { return "the " + who + " performer declares no effect class"; }
    return "the " + who + " performer declares `" + class + "`, which is not an effect class";
}

locus PerformerCatalog {
    params {
        person: Performer = Person { };
        deterministic: Performer = NoDeterministic { };
        model: Performer = NoModel { };
    }
    // The performer that declares no effect class, or one that is not
    // `effect_free`, `idempotent` or `uncertain`: "" when all three do.
    fn unseated() -> String {
        if !dna::effect_class_ok(self.person.effect_class()) { return unseated_text("person", self.person.effect_class()); }
        if !dna::effect_class_ok(self.deterministic.effect_class()) { return unseated_text("deterministic", self.deterministic.effect_class()); }
        if !dna::effect_class_ok(self.model.effect_class()) { return unseated_text("model", self.model.effect_class()); }
        return "";
    }
    // The effect class of the performer named.
    fn effect_of(who: String) -> String {
        if who == "deterministic" { return self.deterministic.effect_class(); }
        if who == "model" { return self.model.effect_class(); }
        return self.person.effect_class();
    }
    fn chosen(performer_kind: String) -> String {
        if self.deterministic.takes(performer_kind) { return "deterministic"; }
        if performer_kind == "human" || !self.model.takes(performer_kind) { return "person"; }
        return "model";
    }
    // The choice, or the one a worker was told to be (`--performer`): a
    // forced performer that takes nothing of the kind still refuses
    // (`perform_as` asks `takes` first).
    fn chosen_or(performer_kind: String, forced: String) -> String {
        if forced == "person" || forced == "deterministic" || forced == "model" { return forced; }
        return self.chosen(performer_kind);
    }
    // The render mode a performer is briefed in.
    fn mode_for(who: String) -> String { return if who == "person" { "text" } else if who == "model" { "prompt" } else { "agent" }; }
    fn perform(brief: Brief, hands: Hands) -> Performance {
        return self.perform_as(self.chosen(brief.performer_kind), brief, hands);
    }
    // The performance by the one chosen, or the one a worker was told to
    // be: a performer never answers a kind it does not take, forced or not.
    fn perform_as(who: String, brief: Brief, hands: Hands) -> Performance {
        if who == "deterministic" {
            if !self.deterministic.takes(brief.performer_kind) { return Performance { refused: "the deterministic performer does not take " + brief.performer_kind + " work" }; }
            return self.deterministic.perform(brief, hands);
        }
        if who == "model" {
            if !self.model.takes(brief.performer_kind) { return Performance { refused: "the model performer does not take " + brief.performer_kind + " work" }; }
            return self.model.perform(brief, hands);
        }
        return self.person.perform(brief, hands);
    }
}
