// dna/tests/legs_test.hl — the person leg, end to end (GH #946 slice 4).
//
// A judgment leaf's attempt is admitted by the engine and asked of a leg
// relay. The leg is `hale dna work`: the project's own program (its
// performers in dna/org/work.hl over the toolchain's legs seed), run as
// API clients against a real head — the practice_review API, spawned
// over the project's record. `next` claims for a position (the graph's
// `position:<name>` id) and is idempotent by request id; `brief` reads
// the hat, or renders it, recording the hat digest, the prompt digest
// and the renderer's version; `renew` extends the lease; `friction`
// files what got in the way; `submit` hands the outcome back with the
// hat it wore; the host's own relay carries it to the owner, and
// `settle` reads the settlement. `release` gives a lease back and the
// attempt is claimed anew. `run` is one cycle through the project's
// performers: a person's leg leaves the outcome to them, a deterministic
// performer for the kind wins and settles. `hale mcp` exposes the verbs.
// No memory, no model, no nerves: the relay is in this process.

import "../core" as dna;
import "../host" as host;
import "../operations" as ops;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// The head's binary: the one the suite names, else built from the source tree.
fn head_binary() -> String {
    if std::env::var_exists("HALE_NATIVE_HEAD_API") && std::io::fs::file_exists(std::env::var("HALE_NATIVE_HEAD_API")) { return std::env::var("HALE_NATIVE_HEAD_API"); }
    let source = if std::env::var_exists("HALE_DNA_SOURCE") { std::env::var("HALE_DNA_SOURCE") } else { "." };
    // built here, every run: a head left by an earlier build is an older
    // head, and the verbs it refuses would look like the leg's fault
    let seed = source + "/dna/api/practice_review";
    let built = dna::run_tool(toolchain() + "\nbuild\n" + seed);
    std::test::assert_eq_int(built.code, 0, "the head builds (HALE_DNA_SOURCE names the repository): " + built.stderr);
    return seed + "/practice_review";
}

fn relay_once(app: String) -> Int {
    let relay = host::NodeRelay { root: app, verb: "test", live: true, relayed: "\n" };
    let n = relay.relay(dna::Memory { repo: app, dsn_env: dna::own_dsn_env() });
    std::test::assert_eq_str(relay.error, "", "the relay published: " + relay.error);
    return n;
}

const FIXED_WORK: String = "// a deterministic performer for the fixture\nimport \"vendor/dna/legs\" as legs;\nfn performers() -> legs::PerformerCatalog {\n    return legs::PerformerCatalog { person: legs::Person { }, deterministic: legs::FixedAnswer { kinds: \"agent\", result: \"assessment: fixed\", narrative: \"a program answered\" }, model: legs::NoModel { } };\n}\nfn hands() -> legs::Hands { return legs::Hands { }; }\n";

locus App {
    params {
        app: String = "";
        api: String = "";
        head: std::process::Child = std::process::Child { };
        core: dna::Dna = dna::Dna { verification: dna::HaleVerification { receipts: dna::FileReceipts { dir: "/tmp/dna-legs-placeholder" } } };
        asks: Int = 0;
    }
    // ---- the head over the record
    fn start_head() {
        let record = dna::GitRecord { repo: self.app };
        let policy = "{\"format\":\"dna.practice-review-authority/1\",\"application_id\":\"" + record.identity() + "\",\"grants\":[{\"mode\":\"local\",\"name\":\"riley\",\"authority\":\"board\",\"practice_propose\":false,\"review_verdict\":false,\"recover\":true}]}";
        std::io::fs::write_file(self.app + "/.hale/dna/authority.json", policy) or discard;
        let port = dna::free_port(46);
        self.api = "http://127.0.0.1:" + to_string(port);
        let argv = "sh\n-c\ncd \"$1\" && export USER=riley HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_COMMAND_POLICY=\"$1/.hale/dna/authority.json\" && unset HALE_DNA_MEMORY_DSN_OWNER HALE_DNA_MEMORY_DSN_SPINE HALE_DNA_MEMORY_DSN_HEAD && exec \"$2\" \"$1\" \"$3\" >\"$1/.hale/head.log\" 2>&1\nsh\n" + self.app + "\n" + head_binary() + "\n" + to_string(port);
        let child = std::process::spawn(argv) or std::process::Child { };
        self.head = std::process::Child { argv: argv, pid: child.pid, stdin_fd: child.stdin_fd, stdout_fd: child.stdout_fd, stderr_fd: child.stderr_fd };
        child.pid = -1; child.stdin_fd = -1; child.stdout_fd = -1; child.stderr_fd = -1;
        std::test::assert(self.head.pid > 0, "the head spawned");
        let deadline = std::time::now() + dna::wait_secs(30);
        while std::time::now() < deadline {
            let up = dna::run_tool("curl\n-sf\n" + self.api + "/api/hale/v1/applications");
            if up.code == 0 { return; }
            let state = std::process::try_wait(self.head) or - 1;
            std::test::assert_eq_int(state, -2, "the head exited before listening: " + (std::io::fs::read_file(self.app + "/.hale/head.log") or ""));
            std::time::sleep(200ms);
        }
        std::test::assert(false, "the head did not come up: " + (std::io::fs::read_file(self.app + "/.hale/head.log") or ""));
    }
    fn stop_head() {
        if self.head.pid > 0 { std::process::kill(self.head) or discard; }
        self.head.pid = -1;
    }
    // an assertion that ends the run leaves no head behind
    dissolve() { self.stop_head(); }
    // ---- the owner, in this process, asking a leg relay
    fn start_owner() {
        self.core = dna::Dna {
            journal: dna::GitJournal { repo: self.app },
            work: dna::WorkSystem { agent: dna::LegRelay { name: "legs" }, agent_reconciler: dna::RelayReplay { } },
            verification: dna::HaleVerification { hale_bin: toolchain(), receipts: dna::GitReceipts { repo: self.app }, scratch: self.app + "/.hale/dna/scratch", repo: self.app },
            claims: dna::MemoryLeases { repo: self.app }, knowledge_client: dna::MemoryKnowledge { repo: self.app },
            org_id: "legs"
        };
        std::test::assert_eq_str(self.core.catalog.define("judge", 1, 1, "one judgment"), "", "judge");
        std::test::assert_eq_str(self.core.catalog.leaf("judge", 1, 0, "j", dna::WorkRequest { objective: "assess the storage migration", requires: "judgment", output_contract: "Assessment" }, 2), "", "j");
    }
    @unbounded
    fn has_row(kind: String, entity: String) -> Bool {
        let moved = self.core.journal.refresh();
        let mut i = 0;
        while i < self.core.journal.revision() { let e = self.core.journal.read(i); if e.kind == kind && e.entity == entity { return true; } i = i + 1; }
        return false;
    }
    @unbounded
    fn wait_row(kind: String, entity: String, what: String) {
        let mut tries = 0;
        while tries < 400 * dna::wait_scale() && !self.has_row(kind, entity) { std::time::sleep(25ms); tries = tries + 1; }
        std::test::assert(self.has_row(kind, entity), what + ": no `" + kind + " " + entity + "` row within the deadline");
    }
    fn ask() -> String {
        self.asks = self.asks + 1;
        let t = self.core.run_workflow(dna::WorkflowAsk { id: "i" + to_string(self.asks), definition: "judge", revision: 1, from: "test" });
        let attempt = dna::attempt_id_of(t + "/wf1/s0/j", 0);
        self.wait_row("attempt.admitted", attempt, "the engine admits the attempt");
        self.wait_row("effect.requested", "attempt:" + attempt, "and asks the leg relay for it");
        return attempt;
    }
    // ---- the leg: `hale dna work …` in the project, against the head
    fn work(args: String) -> String {
        let r = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_API=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + self.app + "\n" + self.api + "\n" + toolchain() + "\ndna\nwork\n" + args);
        std::test::assert_eq_int(r.code, 0, "hale dna work " + std::str::replace(args, "\n", " ") + ": " + r.stdout + r.stderr);
        return dna::trim_nl(r.stdout);
    }
    fn attempt_of(answer: String) -> String { return std::json::find_field_raw(answer, "attempt"); }
    fn state_of(answer: String) -> String { return std::json::find_string_field(self.attempt_of(answer), "state"); }
    fn token_of(answer: String) -> String { return std::json::find_string_field(self.attempt_of(answer), "token"); }
    run() {
        let scratch = dna::scratch_root("legs");
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\napp");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        self.app = scratch + "/app";
        let u1 = in_dir(self.app, "git\nconfig\nuser.name\nriley");
        let u2 = in_dir(self.app, "git\nconfig\nuser.email\nriley@local");
        std::test::assert(std::io::fs::file_exists(self.app + "/dna/org/work.hl"), "init generated the performers");
        std::test::assert(std::io::fs::file_exists(self.app + "/vendor/dna/legs/verbs.hl"), "and vendored the legs seed");
        self.start_owner();
        let a1 = self.ask();
        self.start_head();
        // ---- next: the claim, for a position, idempotent by request id
        let claimed = self.work("next\n--as\nposition:agent");
        std::test::assert_eq_str(self.state_of(claimed), "claimed", "next claims: " + claimed);
        std::test::assert_eq_str(std::json::find_string_field(self.attempt_of(claimed), "attempt_id"), a1, "the attempt that awaited a leg");
        std::test::assert_eq_str(std::json::find_string_field(self.attempt_of(claimed), "holder"), "position:agent", "held by the position");
        let token = self.token_of(claimed);
        // asked again by the same position: the same lease (a claim by its
        // holder renews, the token stays), never a second attempt
        let again = self.work("next\n--as\nposition:agent");
        std::test::assert(self.state_of(again) == "claimed" && self.token_of(again) == token && std::json::find_string_field(self.attempt_of(again), "attempt_id") == a1, "next again is the same lease: " + again);
        let free = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_API=\"$2\" && \"$3\" dna work next --as leg:free\nsh\n" + self.app + "\n" + self.api + "\n" + toolchain());
        std::test::assert_eq_int(free.code, 2, "a free string is no position: " + free.stdout + free.stderr);
        // ---- brief: the hat, and the hat rendered
        let hat = self.work("brief\n--attempt\n" + a1);
        std::test::assert_eq_str(std::json::find_string_field(hat, "work_id"), a1[0..(len(a1) - 3)], "the hat is the Work's: " + hat);
        std::test::assert_eq_str(std::json::find_string_field(std::json::find_field_raw(hat, "position"), "id"), "position:agent", "for the position");
        let hat_digest = std::json::find_string_field(hat, "digest");
        let rendered = self.work("brief\n--attempt\n" + a1 + "\n--render\ntext");
        std::test::assert_eq_str(std::json::find_string_field(rendered, "hat_digest"), hat_digest, "the render records the hat's digest");
        std::test::assert_eq_str(std::json::find_string_field(rendered, "renderer"), "legs-render/1", "and the renderer's version");
        let prompt_digest = std::json::find_string_field(rendered, "prompt_digest");
        std::test::assert(std::str::starts_with(prompt_digest, "sha256:"), "and the digest of what it rendered");
        std::test::assert(std::str::starts_with(std::json::find_string_field(rendered, "text"), "BRIEF " + a1[0..(len(a1) - 3)]), "a person's brief: " + std::json::find_string_field(rendered, "text"));
        let plain = self.work("brief\n--attempt\n" + a1 + "\n--render\nprompt\n--plain");
        std::test::assert(std::str::starts_with(plain, "You are position:agent"), "a prompt, plain: " + plain);
        std::test::assert_eq_str(dna::digest_of(plain + "\n"), std::json::find_string_field(self.work("brief\n--attempt\n" + a1 + "\n--render\nprompt"), "prompt_digest"), "rendering is a pure function of the hat and the mode");
        // ---- renew, friction
        let renewed = self.work("renew\n--as\nposition:agent\n--attempt\n" + a1 + "\n--token\n" + token + "\n--ttl\n900");
        std::test::assert_eq_str(self.state_of(renewed), "renewed", "renew extends the lease: " + renewed);
        std::test::assert_eq_str(self.token_of(renewed), token, "and keeps the token");
        let filed = self.work("friction\n--as\nposition:agent\n--attempt\n" + a1 + "\n--text\nthe hat named no tool grant for a judgment");
        std::test::assert_eq_str(self.state_of(filed), "filed", "friction is filed: " + filed);
        std::test::assert(self.has_row("friction.filed", a1), "as a row on the attempt");
        // ---- submit, relayed, settled
        std::io::fs::write_file(self.app + "/.hale/calls.json", "[{\"adapter\": \"person\", \"backend\": \"desk\", \"input_tokens\": 0, \"output_tokens\": 0, \"cost_micros\": 0}]") or discard;
        let submitted = self.work("submit\n--as\nposition:agent\n--attempt\n" + a1 + "\n--token\n" + token + "\n--result\nassessment: ship it\n--narrative\nread it twice\n--evidence-file\n" + self.app + "/.hale/calls.json\n--hat-digest\n" + hat_digest + "\n--hat-head\n" + std::json::find_string_field(hat, "head") + "\n--hat-watermark\n-1\n--prompt-digest\n" + prompt_digest);
        std::test::assert_eq_str(self.state_of(submitted), "requested", "submit hands the outcome back: " + submitted);
        // run twice, one act: the same request under the same lease reads the first's receipt
        let twice = self.work("submit\n--as\nposition:agent\n--attempt\n" + a1 + "\n--token\n" + token + "\n--result\nassessment: ship it\n--narrative\nread it twice\n--evidence-file\n" + self.app + "/.hale/calls.json\n--hat-digest\n" + hat_digest + "\n--hat-head\n" + std::json::find_string_field(hat, "head") + "\n--hat-watermark\n-1\n--prompt-digest\n" + prompt_digest);
        std::test::assert(self.state_of(twice) == "requested" && std::json::find_string_field(twice, "request_id") == std::json::find_string_field(submitted, "request_id"), "submit twice is one act: " + twice);
        let requested = self.work("settle\n--attempt\n" + a1 + "\n--token\n" + token);
        std::test::assert_eq_str(self.state_of(requested), "requested", "not settled before the owner heard it");
        std::test::assert_eq_int(relay_once(self.app), 1, "the relay carries it");
        self.wait_row("attempt.outcome", a1, "the owner settles the attempt");
        let settled = self.work("settle\n--attempt\n" + a1 + "\n--token\n" + token + "\n--wait\n5");
        std::test::assert(self.state_of(settled) == "settled" && std::json::find_string_field(self.attempt_of(settled), "disposition") == "done", "settle reads the settlement: " + settled);
        let moved = self.core.journal.refresh();
        let mut outcome = ""; let mut i = 0;
        while i < self.core.journal.revision() { let e = self.core.journal.read(i); if e.kind == "attempt.outcome" && e.entity == a1 { outcome = e.body; } i = i + 1; }
        std::test::assert(std::json::find_string_field(outcome, "hat_digest") == hat_digest && std::json::find_string_field(outcome, "prompt_digest") == prompt_digest && std::json::find_string_field(outcome, "renderer") == "legs-render/1", "the outcome records the hat, the prompt and the renderer: " + outcome);
        // ---- release: the lease given back, the attempt claimed anew
        let a2 = self.ask();
        let c2 = self.work("next\n--as\nposition:agent");
        std::test::assert(self.state_of(c2) == "claimed" && std::json::find_string_field(self.attempt_of(c2), "attempt_id") == a2, "the next attempt: " + c2);
        let released = self.work("release\n--as\nposition:agent\n--attempt\n" + a2 + "\n--token\n" + self.token_of(c2) + "\n--why\nout of time");
        std::test::assert_eq_str(self.state_of(released), "released", "release gives it back: " + released);
        std::test::assert(self.has_row("attempt.released", a2), "as a row");
        let c2b = self.work("next\n--as\nposition:reviewer\n--kind\nagent");
        std::test::assert(self.state_of(c2b) == "claimed" && std::json::find_string_field(self.attempt_of(c2b), "attempt_id") == a2, "another position claims it anew: " + c2b);
        // ---- run: a person's cycle leaves the outcome to them; a deterministic performer settles
        let a3 = self.ask();
        let person = self.work("run\n--as\nposition:agent");
        std::test::assert(std::json::find_string_field(person, "state") == "pending" && std::json::find_string_field(person, "performer") == "person" && std::json::find_string_field(person, "attempt_id") == a3, "a person's run is pending: " + person);
        std::test::assert(std::str::contains(std::json::find_string_field(person, "narrative"), "hale dna work submit"), "and says how to hand it back");
        std::io::fs::write_file(self.app + "/dna/org/work.hl", FIXED_WORK) or discard;
        let fixed = self.work("run\n--as\nposition:agent\n--wait\n0");
        std::test::assert(std::json::find_string_field(fixed, "performer") == "deterministic" && std::json::find_string_field(fixed, "state") == "requested", "a deterministic performer wins for its kind and hands the outcome back: " + fixed);
        std::test::assert_eq_int(relay_once(self.app), 1, "relayed");
        self.wait_row("attempt.outcome", a3, "and the owner settles it");
        let s3 = self.work("settle\n--request-id\n" + std::json::find_string_field(fixed, "request_id") + "\n--wait\n5");
        std::test::assert_eq_str(self.state_of(s3), "settled", "settled: " + s3);
        // ---- mcp: the verbs through this binary
        let listed = dna::run_tool("sh\n-c\nprintf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | \"$1\" mcp\nsh\n" + toolchain());
        std::test::assert(std::str::contains(listed.stdout, "hale_dna_work"), "hale mcp lists the leg's verbs: " + listed.stdout + listed.stderr);
        self.stop_head();
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
