// dna/tests/hands_test.hl — the hat comes with its hands.
//
// Every hat is composed in one place (`dna::hat_compose`), and the Work's
// output contract decides the hands it carries: a `Patch` gives the
// workspace tools, three of which validate the outcome; an `Assessment`
// gives the read-only infrastructure tools and no way to change a file; a
// contract the toolchain does not describe yet gives nothing. The hands
// are part of the hat's body, so they move its digest, and the agent's
// rendering names each one and says which to run before handing back.
// At the habitat's Forgejo the hands push and open reviews as the persona
// of the Work's position (`persona`).

import "../core" as dna;
import "../core/legs" as legs;

fn worn(j: dna::Journal, kind: String, owed: String, requires: String) -> dna::Hat {
    return dna::hat_compose(j, dna::HatInputs {
        work_id: "t1/wf1/s0/w0",
        task_id: "t1",
        step_id: "t1/wf1/s0",
        attempt_id: "t1/wf1/s0/w0/a0",
        performer_kind: kind,
        objective: "slow the sweep to every two seconds",
        target: "org/api",
        targets: "org/api position:" + kind,
        output_contract: owed, requires: requires, cost_ceiling: 50000, head: "abc123"
    }, dna::ContextPackage { }, false);
}

fn names(hands: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(hands);
    while !it.done {
        out = out + (if len(out) > 0 { " " } else { "" })
            + std::json::find_string_field(it.element, "name");
        it = std::json::array_next(it);
    }
    return out;
}

fn role_of(hands: String, name: String) -> String {
    let mut it = std::json::array_first(hands);
    while !it.done {
        if std::json::find_string_field(it.element, "name") == name {
            return std::json::find_string_field(it.element, "role");
        }
        it = std::json::array_next(it);
    }
    return "";
}

fn check() {
    let j = dna::MemJournal { };

    let patch = worn(j, "edit", "Patch", "edit");
    std::test::assert(patch.ok, "a Patch hat composes");
    std::test::assert_eq_str(patch.position_id, "position:editor", "an edit is the editor's");
    std::test::assert_eq_str(
        patch.effects,
        "idempotent uncertain",
        "an edit admits no effect_free performer",
    );
    std::test::assert_eq_str(
        names(patch.hands),
        "read edit check test fmt patch",
        "a Patch gives the workspace hands, in order",
    );
    std::test::assert_eq_str(
        patch.tool_grant,
        "read edit check test fmt patch",
        "the grant is the hands' names",
    );
    std::test::assert_eq_str(
        patch.validators,
        "check test fmt",
        "check, test and fmt validate a Patch",
    );
    std::test::assert_eq_str(role_of(patch.hands, "check"), "validate", "a validator says so");
    std::test::assert_eq_str(
        role_of(patch.hands, "edit"),
        "act",
        "a hand that changes the worktree acts",
    );
    std::test::assert(
        std::str::contains(dna::hat_json(patch), "\"input_schema\": {\"type\": \"object\""),
        "each hand carries its arguments' schema on the wire: " + dna::hat_json(patch),
    );

    let judged = worn(j, "agent", "Assessment", "judgment");
    std::test::assert_eq_str(
        names(judged.hands),
        "record_status record_history org_chart",
        "an Assessment gives the read-only infrastructure",
    );
    std::test::assert(
        !dna::word_in("edit", judged.tool_grant) && !dna::word_in("patch", judged.tool_grant),
        "an Assessment cannot change a file",
    );
    std::test::assert_eq_str(judged.validators, "", "an Assessment has no tool validators yet");

    let other = worn(j, "agent", "MonthlyReport", "judgment");
    std::test::assert_eq_str(other.hands, "[]", "an undescribed contract gives no hands");
    std::test::assert_eq_str(other.tool_grant, "", "and grants nothing");

    let same_but_judged = worn(j, "edit", "Assessment", "edit");
    std::test::assert(
        patch.digest != same_but_judged.digest,
        "the hands are in the body: another contract is another hat",
    );
    std::test::assert_eq_str(
        worn(j, "edit", "Patch", "edit").digest,
        patch.digest,
        "composed twice at one head, one digest",
    );

    let agent = legs::render(dna::hat_json(patch), "agent");
    std::test::assert(
        std::str::contains(agent, "- edit: ")
            && std::str::contains(agent, "- check: ")
            && std::str::contains(agent, "(validates the outcome)"),
        "the agent's brief names each hand and the validators: " + agent,
    );
    std::test::assert(
        std::str::contains(agent, "Run check test fmt before you hand the outcome back"),
        "and says to run them before handing back",
    );
    let thinking = legs::render(dna::hat_json(other), "agent");
    std::test::assert(
        std::str::contains(thinking, "Hands you may use: none"),
        "no hands: the brief says to answer from it alone: " + thinking,
    );
}

// The persona a leg's push, review and own commits go as at the habitat's
// Forgejo: the ledger's line for the Work's position when its token is in
// the vault, else the organism's own user and a note saying so; GitHub, no
// forge or no position leave the organism's own, silently.
fn persona() {
    let key = "k1";
    let fj = dna::ForgeAllocation {
        provider: "forgejo",
        repo: "todo-k1/todo",
        key_vault: "forgejo-k1",
        address: "http://127.0.0.1:16000",
    };
    let ledger = "position\tposition:board\ttodo-k1-board\tforgejo-k1-board\n"
        + "position\tposition:api/dev\ttodo-k1-api_dev\tforgejo-k1-api--dev\n"
        + "person\tgrace\tgrace\tforgejo-person-grace\n";

    let dev = dna::forgejo_ledger_persona(ledger, "position:api/dev");
    std::test::assert(
        dev.user == "todo-k1-api_dev" && dev.slot == "forgejo-k1-api--dev",
        "the ledger names a position's persona: " + dev.user + " " + dev.slot,
    );
    std::test::assert_eq_str(
        dna::forgejo_ledger_persona(ledger, "position:api").user,
        "",
        "a position's id is matched whole, never by prefix",
    );
    std::test::assert_eq_str(
        dna::forgejo_ledger_persona(ledger, "grace").user,
        "",
        "a person's line is not a position's",
    );
    std::test::assert_eq_str(
        dna::forgejo_ledger_persona("", "position:board").user,
        "",
        "no ledger, no persona",
    );

    let as_dev = legs::forge_actor(fj, key, "position:api/dev", dev, true);
    std::test::assert(
        as_dev.persona
            && as_dev.user == "todo-k1-api_dev"
            && as_dev.slot == "forgejo-k1-api--dev"
            && as_dev.email == "todo-k1-api_dev@k1.persona.habitat.invalid"
            && as_dev.note == "",
        "a persona with its token: its user pushes, its slot's token opens the review, its email authors the leg's commits",
    );

    let tokenless = legs::forge_actor(fj, key, "position:api/dev", dev, false);
    std::test::assert(
        !tokenless.persona
            && tokenless.user == "todo-k1"
            && tokenless.slot == "forgejo-k1"
            && tokenless.email == ""
            && std::str::contains(tokenless.note, "forgejo-k1-api--dev")
            && std::str::contains(tokenless.note, "todo-k1 acts for it"),
        "a persona whose slot is missing: the organism's slot, as before, with a note: "
            + tokenless.note,
    );

    let unledgered = legs::forge_actor(
        fj,
        key,
        "position:ops",
        dna::forgejo_ledger_persona(ledger, "position:ops"),
        false,
    );
    std::test::assert(
        !unledgered.persona
            && unledgered.slot == "forgejo-k1"
            && std::str::contains(unledgered.note, "no persona of position:ops"),
        "a position the ledger does not name yet: the organism's own, with a note: "
            + unledgered.note,
    );

    let nobody = legs::forge_actor(fj, key, "", dev, true);
    std::test::assert(
        !nobody.persona && nobody.slot == "forgejo-k1" && nobody.note == "",
        "no position: the organism's own, and nothing said",
    );
    let gh = legs::forge_actor(
        dna::ForgeAllocation { provider: "github", repo: "o/r", key_vault: "forge-token" },
        key,
        "position:api/dev",
        dev,
        true,
    );
    std::test::assert(
        !gh.persona && gh.slot == "forge-token" && gh.note == "",
        "GitHub: unchanged, and nothing said",
    );
    let unforged = legs::forge_actor(
        dna::ForgeAllocation { },
        key,
        "position:api/dev",
        dev,
        true,
    );
    std::test::assert(!unforged.persona && unforged.note == "", "no forge: unchanged");

    std::test::assert_eq_str(
        legs::work_position("{\"position\": {\"id\": \"position:api/dev\"}}", "position:agent"),
        "position:api/dev",
        "the Work's hat names the position its work is for",
    );
    std::test::assert_eq_str(
        legs::work_position("{}", "position:agent"),
        "position:agent",
        "else the position the leg works as",
    );
}
main locus App { run() { check(); persona(); } }
fn main() { App { }; }
