// GH #605 — grants delegate resources. Each predicate refuses a spend
// by name; two children under one ceiling share the ceiling's window
// and cannot each spend the same remainder (the reservation is appended
// only at the revision its remainder was read at); a settlement replaces
// a reservation with what was actually spent; a contraction or a
// revocation advances the authority epoch and fences an admission made
// before it; and a grant written before resources existed spends nothing.

import "../core" as dna;

fn sh(argv: String) -> dna::RunResult { return dna::run_tool(argv); }

// A journal on which another settler lands first: the first time a
// `spend.settled` is written, a competing settlement of the same
// operation is appended before it.
locus RacingJournal {
    params {
        inner: dna::MemJournal = dna::MemJournal { };
        raced: Bool = false;
    }
    fn race(kind: String, entity: String, body: String) {
        if kind != "spend.settled" || self.raced { return; }
        self.raced = true;
        let x = self.inner.append(self.inner.revision(), "spend.settled", entity, "{\"child\": \"" + std::json::find_string_field(body, "child") + "\", \"attempt\": 1, \"spent\": \"999\"}");
    }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        self.race(kind, entity, body);
        return self.inner.append(self.inner.revision(), kind, entity, body);
    }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        self.race(kind, entity, body);
        return self.inner.append_exact(expected, kind, entity, body);
    }
    fn read(i: Int) -> dna::Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
}

// A journal that refuses the first `refusals` appends of one kind, as a
// record that cannot be written refuses them.
locus RefusingJournal {
    params {
        inner: dna::MemJournal = dna::MemJournal { };
        kind: String = "";
        refusals: Int = 0;
    }
    fn refused(kind: String) -> Bool {
        if kind != self.kind || self.refusals <= 0 { return false; }
        self.refusals = self.refusals - 1;
        return true;
    }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if self.refused(kind) { return dna::AppendResult { error: "io" }; }
        return self.inner.append(self.inner.revision(), kind, entity, body);
    }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if self.refused(kind) { return dna::AppendResult { error: "io" }; }
        return self.inner.append_exact(expected, kind, entity, body);
    }
    fn read(i: Int) -> dna::Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
}

fn spend(id: String, amount: String, currency: String) -> dna::Spend {
    return dna::Spend { id: id, amount: amount, currency: currency, counterparty: "acme", route: "bank" };
}

main locus App {
    params {
        app: dna::Dna = dna::Dna { };
        billing: dna::Dna = dna::Dna { };
        restarted: dna::Dna = dna::Dna { };
        billing_restarted: dna::Dna = dna::Dna { };
        billing_equal: dna::Dna = dna::Dna { };
        billing_lower: dna::Dna = dna::Dna { };
        refusing: dna::Dna = dna::Dna { };
        brief: dna::Dna = dna::Dna { };
        racy: dna::Dna = dna::Dna { };
        funded: dna::Dna = dna::Dna { org_id: "funded-placeholder" };
        misfunded: dna::Dna = dna::Dna { org_id: "misfunded-placeholder" };
    }
    // What the record holds now, read fresh (each organism's journal is
    // its own view of the ref).
    @unbounded
    fn rows(repo: String, kind: String, entity: String) -> Int {
        let j = dna::GitJournal { repo: repo };
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && (len(entity) == 0 || e.entity == entity) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn last(repo: String, kind: String) -> String {
        let j = dna::GitJournal { repo: repo };
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn last_of(repo: String, kind: String, entity: String) -> String {
        let j = dna::GitJournal { repo: repo };
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && e.entity == entity { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    run() {
        // ---- each predicate refuses by name
        let now = std::time::now();
        let g = dna::Grant { child: "app", classes: "docs", max_magnitude: 4, review: "pre", amounts: "USD 500.00", window_amounts: "USD 800", window: "day", counterparties: "acme globex", routes: "bank" };
        std::test::assert_eq_str(dna::permits(g, spend("p1", "120.50", "USD"), now), "", "a spend inside every predicate");
        std::test::assert(std::str::starts_with(dna::permits(g, spend("p2", "10", "EUR"), now), "currency: EUR is not granted"), "a currency the grant does not name");
        std::test::assert(std::str::starts_with(dna::permits(g, spend("p3", "600", "USD"), now), "amount: 600 USD exceeds the per-operation ceiling of 500.00"), dna::permits(g, spend("p3", "600", "USD"), now));
        std::test::assert(std::str::starts_with(dna::permits(g, spend("p4", "-3", "USD"), now), "amount: `-3` is not a positive decimal"), "a negative amount");
        std::test::assert(std::str::starts_with(dna::permits(g, spend("p5", "lots", "USD"), now), "amount: `lots` is not a positive decimal"), "an amount that is not a number");
        std::test::assert(std::str::starts_with(dna::permits(g, dna::Spend { id: "p6", amount: "1", currency: "USD", counterparty: "initech", route: "bank" }, now), "counterparty: `initech` is not granted"), "a counterparty the grant does not name");
        std::test::assert(std::str::starts_with(dna::permits(g, dna::Spend { id: "p7", amount: "1", currency: "USD", counterparty: "acme", route: "card" }, now), "route: `card` is not granted"), "a route the grant does not name");
        let lapsed = dna::Grant { child: "app", amounts: "USD 500", counterparties: "acme", routes: "bank", expires: now - 10 };
        std::test::assert(std::str::starts_with(dna::permits(lapsed, spend("p8", "1", "USD"), now), "expires: the grant expired at "), dna::permits(lapsed, spend("p8", "1", "USD"), now));
        std::test::assert(std::str::starts_with(dna::permits(g, dna::Spend { amount: "1", currency: "USD", counterparty: "acme", route: "bank" }, now), "operation: a spend needs a durable id"), "a spend with no id");
        std::test::assert(std::str::starts_with(dna::permits(dna::Grant { child: "app", classes: "docs", max_magnitude: 4 }, spend("p9", "1", "USD"), now), "currency: USD is not granted"), "a grant from before resources spends nothing");
        // 2026-09-14T03:00:00Z is in the day that starts at 2026-09-14T00:00:00Z
        std::test::assert_eq_int(dna::window_start_of("day", 1789354800), 1789344000, "a day window starts at midnight UTC");
        std::test::assert_eq_int(dna::window_start_of("none", 1789351200), 0, "no window is one window");

        // ---- two children under one ceiling, over one record
        let repo = "/tmp/dna-grants-" + to_string(std::process::pid());
        std::io::fs::mkdir(repo) or discard;
        let init = sh("git\n-C\n" + repo + "\ninit\n-q\n-b\nmain");
        let c0 = sh("git\n-C\n" + repo + "\n-c\nuser.name=t\n-c\nuser.email=t@local\ncommit\n-q\n--allow-empty\n-m\nbase");
        std::test::assert_eq_int(c0.code, 0, "base commit: " + c0.stderr);
        // one window for the record's lifetime, so no test straddles midnight
        self.app = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "app"
        };
        self.billing = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "billing", grant: dna::Grant { child: "billing", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "billing"
        };
        std::test::assert_eq_int(self.rows(repo, "grant.refused", ""), 0, "both children are born within the ceiling");

        let a1 = self.app.reserve(spend("a1", "400", "USD"));
        std::test::assert(a1.ok, "app reserves 400 of the shared 1000: " + a1.refused);
        let b1 = self.billing.reserve(spend("b1", "400", "USD"));
        std::test::assert(b1.ok, "billing reserves 400, having read app's reservation: " + b1.refused);
        let a2 = self.app.reserve(spend("a2", "300", "USD"));
        std::test::assert(!a2.ok && std::str::contains(a2.refused, "would bring the ceiling `org`'s none to 1100 of 1000 (shared by its children)"), "the remainder is shared, not each child's: " + a2.refused);
        std::test::assert(std::str::contains(self.last(repo, "grant.reservation_refused"), "spend `a2` (300 USD to acme via bank): window:"), "the refusal is a money row naming the field: " + self.last(repo, "grant.reservation_refused"));
        std::test::assert_eq_int(self.rows(repo, "grant.refused", ""), 0, "a refused spend is not an authority refusal");
        std::test::assert_eq_int(self.rows(repo, "spend.reserved", ""), 2, "two reservations in the record");
        let reserved = self.last(repo, "spend.reserved");
        std::test::assert(std::str::contains(reserved, "\"op\": \"b1\"") && std::str::contains(reserved, "\"child\": \"billing\"") && std::str::contains(reserved, "\"ceiling\": \"org\"") && std::str::contains(reserved, "\"epoch\": 0"), "a reservation names its op, child, ceiling and authority_epoch: " + reserved);
        std::test::assert_eq_str(self.last(repo, "spend.reserved"), self.last_of(repo, "spend.reserved", "b1"), "GH #668: the allocation is the row's entity, reserved once by the store's claim");
        std::test::assert(std::str::contains(reserved, "\"funder\": \"\"") && std::str::contains(reserved, "\"account\": \"\""), "an organization funding itself names no funder: " + reserved);

        // the atomic step: an exact append at a revision the record has
        // moved past is refused, never re-appended at the new tail
        let moved_before = self.billing.journal.refresh();
        let rev = self.billing.journal.revision();
        let noise = self.app.journal.append(self.app.journal.revision(), "task.born", "t9", "someone else moved the record");
        std::test::assert(noise.ok, "app moved the record");
        let stale = self.billing.journal.append_exact(rev, "grant.reserved", "billing", "{\"op\": \"stale\"}");
        std::test::assert(!stale.ok && stale.error == "stale_revision", "a stale exact append is refused: " + stale.error);
        std::test::assert(!std::str::contains(self.last(repo, "spend.reserved"), "\"op\": \"stale\"") && !std::str::contains(self.last(repo, "grant.reserved"), "\"op\": \"stale\""), "and nothing was appended at the tail");
        let plain = self.billing.journal.append(self.billing.journal.revision(), "task.born", "t10", "an ordinary append still lands");
        std::test::assert(plain.ok, "an ordinary append after the refresh lands: " + plain.error);

        // settlement: what was actually spent replaces the reservation
        std::test::assert_eq_str(self.app.settle_spend("a1", "150.00"), "", "app settles a1 at what it spent");
        // GH #668: every attempt is retained — a second settlement is attempt 2, and the window counts both
        std::test::assert_eq_str(self.app.settle_spend("a1", "1"), "", "a second attempt is retained, not refused");
        std::test::assert(std::str::contains(self.last(repo, "spend.settled"), "\"attempt\": 2") && std::str::contains(self.last(repo, "spend.settled"), "\"spent\": \"1\""), "attempt 2, at what it spent: " + self.last(repo, "spend.settled"));
        std::test::assert(dna::dec(self.app.spent_of("app", "a1", self.app.journal.revision())) == 151.0d, "a1 consumed both attempts: " + self.app.spent_of("app", "a1", self.app.journal.revision()));
        std::test::assert(std::str::contains(self.app.settle_spend("zz", "1"), "no reservation `zz`"), "a settlement needs its reservation");
        // money that came back is a compensation someone authorized, never an implied rollback
        std::test::assert(std::str::contains(self.app.compensate_spend("a1", "50", ""), "names who authorized"), "a compensation is authorized by name");
        std::test::assert_eq_str(self.app.compensate_spend("a1", "50", "alice"), "", "alice authorizes 50 back on a1");
        std::test::assert(std::str::contains(self.last(repo, "spend.compensated"), "\"by\": \"alice\"") && std::str::contains(self.last(repo, "spend.compensated"), "\"amount\": \"50\""), "in the record: " + self.last(repo, "spend.compensated"));
        std::test::assert(dna::dec(self.app.spent_of("app", "a1", self.app.journal.revision())) == 101.0d, "and the window counts it from then on: " + self.app.spent_of("app", "a1", self.app.journal.revision()));
        std::test::assert(std::str::contains(self.app.compensate_spend("b9", "1", "alice"), "no reservation"), "nothing is compensated that was never reserved");
        let a3 = self.app.reserve(spend("a3", "300", "USD"));
        std::test::assert(a3.ok, "101 consumed + 400 held + 300 = 801 fits the shared 1000: " + a3.refused);
        // a purchase two children fund is two reservations, each its own;
        // one settles, the other does not: the partial success is visible
        let half_a = self.app.reserve(spend("po-7-app", "40", "USD"));
        let half_b = self.billing.reserve(spend("po-7-billing", "40", "USD"));
        std::test::assert(half_a.ok && half_b.ok, "each side reserves its half: " + half_a.refused + half_b.refused);
        std::test::assert_eq_str(self.app.settle_spend("po-7-app", "40"), "", "app's half settles");
        std::test::assert(len(self.app.spent_of("app", "po-7-app", self.app.journal.revision())) > 0 && len(self.billing.spent_of("billing", "po-7-billing", self.billing.journal.revision())) == 0, "one half consumed, the other still only reserved: nothing pretends the purchase is whole");
        let dup = self.app.reserve(spend("a3", "1", "USD"));
        std::test::assert(!dup.ok && std::str::contains(dup.refused, "operation: `a3` is already reserved"), "an operation is reserved once: " + dup.refused);

        // GH #668: who pays is on the grant, and a child pays from its ceiling's funder or none other
        self.funded = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "funded", grant: dna::Grant { child: "funded", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 500", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", counterparties: "acme", routes: "bank", funder: "acme/ops" } },
            org_id: "funded"
        };
        let paid = self.funded.reserve(spend("f1", "10", "USD"));
        std::test::assert(paid.ok, "reserved under the ceiling's funder: " + paid.refused);
        let frow = self.last_of(repo, "spend.reserved", "f1");
        std::test::assert(std::str::contains(frow, "\"funder\": \"acme\"") && std::str::contains(frow, "\"account\": \"ops\""), "the reservation names who pays, inherited from the ceiling: " + frow);
        self.misfunded = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "misfunded", grant: dna::Grant { child: "misfunded", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 500", counterparties: "acme", routes: "bank", funder: "north/x" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", counterparties: "acme", routes: "bank", funder: "acme/ops" } },
            org_id: "misfunded"
        };
        let unpaid = self.misfunded.reserve(spend("m1", "10", "USD"));
        std::test::assert(std::str::contains(self.last_of(repo, "grant.refused", "misfunded"), "funder north/x not granted above"), "a child paying from another funder than its ceiling's is born wider: " + self.last_of(repo, "grant.refused", "misfunded"));
        // fencing: a contraction advances the epoch
        std::test::assert_eq_str(self.billing.admits(b1), "", "an admission is carried out under the grant it was made under");
        self.billing.ceiling_outcome(false);
        self.billing.ceiling_outcome(false);
        let fenced = self.billing.admits(b1);
        std::test::assert(std::str::starts_with(fenced, "fenced: the grant changed after `b1` was admitted (epoch 0 -> 1)"), "a contraction fences it: " + fenced);
        std::test::assert_eq_int(self.rows(repo, "grant.fenced", "billing"), 1, "in the record");
        std::test::assert(std::str::contains(self.last(repo, "grant.contracted"), "\"to\": 5") && std::str::contains(self.last(repo, "grant.contracted"), "\"epoch\": 1"), "the contraction row carries what it leaves: " + self.last(repo, "grant.contracted"));
        // a contraction survives a restart: born over the same record with
        // the same authored grants, the ceiling is still contracted and the
        // admission made before it is still fenced
        self.billing_restarted = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "billing", grant: dna::Grant { child: "billing", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "billing-restarted"
        };
        std::test::assert(std::str::starts_with(self.billing_restarted.admits(b1), "fenced: the grant changed after `b1` was admitted (epoch 0 -> 1)"), "an admission fenced by a contraction stays fenced after a restart: " + self.billing_restarted.admits(b1));
        std::test::assert_eq_int(self.billing_restarted.ceiling.current_grant().max_magnitude, 5, "and the ceiling's magnitude stays halved");
        // …and when the authored ceiling is changed to the contracted limit,
        // or below it: the recorded epoch and review hold, the stricter
        // magnitude binds
        self.billing_equal = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "billing", grant: dna::Grant { child: "billing", classes: "docs", max_magnitude: 4, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 5, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "billing-equal"
        };
        std::test::assert(std::str::starts_with(self.billing_equal.admits(b1), "fenced: the grant changed after `b1` was admitted (epoch 0 -> 1)") && self.billing_equal.ceiling.current_grant().review == "pre", "an authored ceiling at the contracted limit keeps the recorded epoch and review: " + self.billing_equal.admits(b1) + " " + self.billing_equal.ceiling.current_grant().review);
        self.billing_lower = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "billing", grant: dna::Grant { child: "billing", classes: "docs", max_magnitude: 4, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 4, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "billing-lower"
        };
        std::test::assert(std::str::starts_with(self.billing_lower.admits(b1), "fenced: the grant changed after `b1` was admitted (epoch 0 -> 1)") && self.billing_lower.ceiling.current_grant().max_magnitude == 4 && self.billing_lower.ceiling.current_grant().review == "pre", "a stricter authored ceiling keeps them too, at its own magnitude: " + self.billing_lower.admits(b1));

        // a contraction the record refuses admits nothing until it is recorded
        self.refusing = dna::Dna {
            journal: RefusingJournal { kind: "grant.contracted", refusals: 3 },
            boundary: dna::AutonomyBoundary { child: "desk", grant: dna::Grant { child: "desk", classes: "docs", max_magnitude: 4, review: "post", amounts: "USD 500", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "refusing"
        };
        let held = self.refusing.reserve(spend("r1", "10", "USD"));
        std::test::assert(held.ok, "reserved before the contraction: " + held.refused);
        self.refusing.ceiling_outcome(false);
        self.refusing.ceiling_outcome(false);
        let while_unrecorded = self.refusing.reserve(spend("r2", "10", "USD"));
        std::test::assert(!while_unrecorded.ok && std::str::contains(while_unrecorded.refused, "the grant's contraction could not be recorded (io)"), "nothing is reserved while the contraction is not in the record: " + while_unrecorded.refused);
        std::test::assert(std::str::contains(self.refusing.admits(held), "nothing is admitted until the record holds it"), "nor carried out: " + self.refusing.admits(held));
        std::test::assert(std::str::starts_with(self.refusing.admits(held), "fenced: the grant changed after `r1` was admitted (epoch 0 -> 1)"), "once the record takes the contraction, the earlier admission is fenced: " + self.refusing.admits(held));
        let mut contracted_rows = 0;
        let mut k = 0;
        while k < self.refusing.journal.revision() {
            if self.refusing.journal.read(k).kind == "grant.contracted" { contracted_rows = contracted_rows + 1; }
            k = k + 1;
        }
        std::test::assert_eq_int(contracted_rows, 1, "and the record holds it once");

        // revocation is the parent's; afterwards nothing is granted
        std::test::assert(!self.app.revoke_grant("app"), "a child cannot revoke its own grant");
        std::test::assert(self.app.revoke_grant("org"), "the parent revokes it");
        std::test::assert_eq_int(self.rows(repo, "grant.revoked", "app"), 1, "the revocation is a row");
        std::test::assert(std::str::starts_with(self.app.admits(a3), "fenced: the grant changed after `a3` was admitted (epoch 0 -> 1)"), "an earlier admission is fenced: " + self.app.admits(a3));
        let after = self.app.reserve(spend("a5", "1", "USD"));
        std::test::assert(!after.ok && std::str::contains(after.refused, "currency: USD is not granted"), "nothing is granted after revocation: " + after.refused);

        // a revocation survives a restart: an organism born over the same
        // record, with the same authored grant, is still revoked
        self.restarted = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500", window_amounts: "USD 1000", window: "none", counterparties: "acme", routes: "bank" } },
            org_id: "app-restarted"
        };
        // (epoch 2: app's revocation, and the ceiling `org`'s contraction,
        // which binds every child born under it)
        std::test::assert(std::str::starts_with(self.restarted.admits(a3), "fenced: the grant changed after `a3` was admitted (epoch 0 -> 2)"), "an admission fenced before the restart stays fenced: " + self.restarted.admits(a3));
        let reborn = self.restarted.reserve(spend("a6", "1", "USD"));
        std::test::assert(!reborn.ok && std::str::contains(reborn.refused, "currency: USD is not granted"), "and nothing is granted after it: " + reborn.refused);
        std::test::assert(std::str::contains(self.last(repo, "grant.revoked"), "\"epoch\": 1"), "the revocation row carries its epoch: " + self.last(repo, "grant.revoked"));

        // an admission is not carried out once its grant has expired
        self.brief = dna::Dna { boundary: dna::AutonomyBoundary { child: "brief", grant: dna::Grant { child: "brief", amounts: "USD 50", counterparties: "acme", routes: "bank", expires: std::time::now() + 2 } }, org_id: "brief" };
        let short = self.brief.reserve(spend("s1", "5", "USD"));
        std::test::assert(short.ok, "reserved while the grant is in force: " + short.refused);
        std::test::assert_eq_str(self.brief.admits(short), "", "and admitted while it is");
        std::time::sleep(2500ms);
        std::test::assert(std::str::starts_with(self.brief.admits(short), "expired: the grant `s1` was admitted under expired at "), "not after it expired: " + self.brief.admits(short));

        // a settlement is once under contention: another settler lands first
        self.racy = dna::Dna { journal: RacingJournal { }, boundary: dna::AutonomyBoundary { child: "racy", grant: dna::Grant { child: "racy", amounts: "USD 50", counterparties: "acme", routes: "bank" } }, org_id: "racy" };
        let r1 = self.racy.reserve(spend("r1", "10", "USD"));
        std::test::assert(r1.ok, "reserved: " + r1.refused);
        let contended = self.racy.settle_spend("r1", "10");
        std::test::assert(std::str::contains(contended, "already settled"), "the loser reads the winner's settlement, and does not double it: " + contended);
        let mut released = 0;
        let mut k = 0;
        while k < self.racy.journal.revision() {
            let e = self.racy.journal.read(k);
            if e.kind == "spend.settled" { released = released + 1; }
            k = k + 1;
        }
        std::test::assert_eq_int(released, 1, "one settlement in the record");

        let rm = sh("rm\n-rf\n" + repo);
    }
}

fn main() { App { }; }
