// VizScene — the pluggable surface that drives the viz pane.
// Each scene defines what to render, what data feeds it, and
// what proposal channels the agent can use to drive it.
// Different domains own their own viz (PLAN §3.5).
//
// VizPane holds exactly one active scene at a time. Switching
// scenes is config or proposal-driven (ide.cmd.viz.set_scene).
// Agent discovery via MCP `viz.scene_info()`.

import "lib/raylib" as ray;

interface VizScene {
    // Identity.
    fn name() -> String;        // e.g. "hale.locus_tower", "brain3.topology"
    fn domain() -> String;      // e.g. "hale", "brain3", "<demo-app>"

    // Lifecycle hooks fire when this scene becomes / stops
    // being the active scene on a VizPane.
    fn install();
    fn uninstall();

    // Rendering — called per frame after VizPane draws its
    // own border / frame. Scene draws its 3D content here.
    fn render(s: RenderSurface);

    // Camera — substrate concern that every scene exposes.
    // VizPane's camera primitives (WASD fly + mouse orbit +
    // ide.cmd.viz.camera proposals) route through this pair.
    fn camera() -> ray::Camera3D;
    fn set_camera(c: ray::Camera3D);

    // Agent API discovery. Returns a JSON-encoded array of
    // SceneChannelSpec objects ([{channel, payload_schema,
    // description}, ...]). Empty array if the scene doesn't
    // accept scene-specific proposals.
    fn channels_json() -> String;

    // Scene-defined proposal dispatch. Called by
    // ProposalDispatcher when a proposal on
    // ide.cmd.viz.scene.<method> targets this scene.
    fn dispatch(channel: String, payload_json: String);

    // Source-pane content changed. Scene can re-extract its
    // structure from the new content. Receives path + raw
    // content (empty until fsnotify lands and SourcePane
    // actually reads files).
    fn on_source_changed(file: String, content: String);

    // User clicked at pane-relative screen coords. Scene
    // unprojects against its own camera, hit-tests against
    // its own node positions, and acts. iris core doesn't
    // dictate click semantics — they're per-scene.
    fn on_click(screen_x: Int, screen_y: Int);

    // Scene-specific state snapshot for MCP viz.scene_info.
    // Returns JSON object string describing whatever the scene
    // wants to surface ({"current_file": "...", "node_count":
    // 42, ...}).
    fn state_json() -> String;
}

type SceneChannelSpec {
    channel:        String = "";
    payload_schema: String = "";
    description:    String = "";
}
