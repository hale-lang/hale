// GH #731 (dna/FRICTION.md F.4): a `perspective(P)` field with no
// initializer HOLDS the program's slot without designating it. A
// dynamic child built with `Attempt { }` dispatches through the impl
// the assembly designated; its birth neither builds an impl nor
// re-points the slot, so a later `reperspective` by the designating
// holder reaches every holder, old and new. The same holds for a
// perspective a library declares and a holder the library declares.
import "./perspective_hold_lib" as lib;

perspective Performing {
    fn perform(x: Int) -> Int;
    fn name() -> String;
}

locus Doubler : serves Performing {
    fn perform(x: Int) -> Int { return x * 2; }
    fn name() -> String { return "doubler"; }
}

locus Tripler : serves Performing {
    fn perform(x: Int) -> Int { return x * 3; }
    fn name() -> String { return "tripler"; }
}

// The holder: no initializer, so constructing it needs no impl.
locus Attempt {
    params { performer: perspective(Performing); out: Int = 0; }
    contract { expose out: Int; }
    run() { self.out = self.performer.perform(21); }
}

locus Work {
    params { total: Int = 0; }
    accept(a: Attempt) { }
    release(a: Attempt) { self.total = self.total + a.out; }
    fn round() -> Int {
        self.total = 0;
        Attempt { };
        Attempt { };
        return self.total;
    }
}

locus Steps {
    params { total: Int = 0; }
    accept(s: lib::Step) { }
    release(s: lib::Step) { self.total = self.total + s.out; }
    fn round() -> Int {
        self.total = 0;
        lib::Step { };
        return self.total;
    }
}

main locus App {
    params {
        // the assembly designates each program-wide performer
        performer: perspective(Performing) = Tripler { };
        scaling: perspective(lib::Scaling) = lib::Thrice { };
        w: Work = Work { };
        s: Steps = Steps { };
    }
    run() {
        std::test::assert_eq_int(self.w.round(), 126, "two dynamic children dispatch to the assembly's Tripler");
        std::test::assert_eq_str(self.performer.name(), "tripler", "their births re-designated nothing");
        reperspective self.performer as Doubler;
        std::test::assert_eq_int(self.w.round(), 84, "children born after the swap dispatch to the swapped impl");
        std::test::assert_eq_str(self.performer.name(), "doubler", "and the designating holder sees it too");
        std::test::assert_eq_int(self.s.round(), 21, "an imported holder holds an imported perspective's slot");
        reperspective self.scaling as lib::Twice;
        std::test::assert_eq_int(self.s.round(), 14, "and follows its swap");
    }
}

fn main() { App { }; }
