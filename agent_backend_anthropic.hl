// AnthropicBackend — the real LLM backend. Implements
// AgentBackend (F.20) over an HTTPS POST to Anthropic's
// Messages API.
//
// Phase 4.a: synchronous request-response (no SSE streaming).
// The Messages API can be called with `stream=true` for token
// streaming, but the vendored pond/http/client doesn't expose
// a streaming-recv surface today — when the body completes we
// publish the entire assistant message as one AgentChunk +
// AgentTurnDone. Real chunked streaming is a Phase 4.b add
// that needs an SSE parser over a streaming-recv http client.
//
// Auth: reads ANTHROPIC_API_KEY from env at birth. If unset,
// is_ready() returns false and submit_user_input fails fast
// with AgentError.

import "lib/http" as http;

locus AnthropicBackend {
    params {
        api_key:    String = "";
        model:      String = "claude-opus-4-7";
        endpoint:   String = "https://api.anthropic.com/v1/messages";
        max_tokens: Int    = 4096;
        last_error: String = "";
    }

    bus {
        publish AgentChunk;
        publish AgentTurnDone;
        publish AgentError;
    }

    birth() {
        if len(self.api_key) == 0 {
            if std::env::var_exists("ANTHROPIC_API_KEY") {
                self.api_key = std::env::var("ANTHROPIC_API_KEY");
            }
        }
    }

    fn name() -> String   { return "anthropic"; }
    fn model() -> String  { return self.model; }
    fn is_ready() -> Bool { return len(self.api_key) > 0; }

    fn load_history() {
        // Phase 4: no persistence. Conversation history kept
        // ephemeral in iris's runtime; brain3-backed history
        // will be a later phase's concern.
    }

    fn submit_user_input(prompt: String) {
        if !self.is_ready() {
            AgentError <- AgentErrorPayload {
                kind:   "not_ready",
                detail: "ANTHROPIC_API_KEY not set",
            };
            AgentTurnDone <- TurnComplete { };
            return;
        }

        let body_str = self.build_request_body(prompt);
        let url      = http::parse_url(self.endpoint) or self.url_fail(err);
        if len(url.host) == 0 { return; }

        let req = http::Request {
            method:  "POST",
            url:     url,
            headers: self.build_headers(),
            body:    std::bytes::from_string(body_str),
        };

        let resp = http::request(req) or self.http_fail(err);
        if resp.status == 0 { return; }

        if resp.status != 200 {
            AgentError <- AgentErrorPayload {
                kind:   "non_200_status",
                detail: to_string(resp.status),
            };
            AgentTurnDone <- TurnComplete { };
            return;
        }

        let body_text = std::str::from_bytes(resp.body);
        let assistant = extract_response_text(body_text);
        AgentChunk    <- Chunk { text: assistant };
        AgentTurnDone <- TurnComplete { };
    }

    fn submit_tool_result(tool_call_id: String, result_json: String) {
        // Anthropic supports tool_use blocks, but iris's design
        // routes writes through structured-output proposals
        // (PLAN §3.4, AGENT_PROTOCOL.md §2). The agent's
        // tool-use surface stays off in this backend.
        let _ = tool_call_id;
        let _ = result_json;
    }

    fn cancel() {
        // Synchronous request — once in flight, no cancel path.
        // Real cancellation requires streaming + an abort
        // handle, which lands with Phase 4.b.
    }

    // ---- Internals.

    fn build_headers() -> String {
        let b = std::str::builder_new();
        std::str::builder_append(b, "x-api-key: ");
        std::str::builder_append(b, self.api_key);
        std::str::builder_append(b, "\r\nanthropic-version: 2023-06-01\r\ncontent-type: application/json");
        return std::str::builder_finish(b);
    }

    fn build_request_body(prompt: String) -> String {
        let b = std::str::builder_new();
        std::str::builder_append(b, "{\"model\":\"");
        std::str::builder_append(b, self.model);
        std::str::builder_append(b, "\",\"max_tokens\":");
        std::str::builder_append(b, to_string(self.max_tokens));
        std::str::builder_append(b, ",\"messages\":[{\"role\":\"user\",\"content\":\"");
        std::str::builder_append(b, std::json::escape_string(prompt));
        std::str::builder_append(b, "\"}]}");
        return std::str::builder_finish(b);
    }

    // ---- Error-check fns (sentinel-on-failure pattern).

    fn url_fail(e: http::HttpError) -> http::Url {
        self.last_error = e.detail;
        AgentError <- AgentErrorPayload { kind: "bad_url", detail: e.detail };
        AgentTurnDone <- TurnComplete { };
        return http::Url { };          // host stays "" — caller bails
    }

    fn http_fail(e: http::HttpError) -> http::Response {
        self.last_error = e.detail;
        AgentError <- AgentErrorPayload { kind: e.kind, detail: e.detail };
        AgentTurnDone <- TurnComplete { };
        return http::Response {
            status: 0,
            body:   std::bytes::from_string(""),
        };
    }
}

// ---- Free fn: parse assistant text out of the response JSON.

fn extract_response_text(body: String) -> String {
    let content = std::json::find_field_raw(body, "content");
    if len(content) == 0 { return ""; }
    let iter = std::json::array_first(content);
    if iter.done { return ""; }
    let block_type = std::json::find_string_field(iter.element, "type");
    if block_type != "text" {
        // Phase 4 handles text blocks only. Tool-use / image /
        // multi-block responses come later if a workload
        // forces it.
        return "";
    }
    return std::json::find_string_field(iter.element, "text");
}
