        b.bool_field("available", available); b.bool_field("authorized", available && capability.authorized);
        b.string_field("position_id", "org"); b.string_field("recovery", "record_lifetime");
        b.string_field("max_ttl_seconds", "86400"); b.string_field("max_result_bytes", "16384"); b.string_field("max_evidence_bytes", "32768"); b.string_field("max_receipts_bytes", "65536");
        b.string_field("max_identity_bytes", "256"); b.string_field("max_request_bytes", "32768");
        b.string_field("reason", if !self.origin_valid(origin) { "Command submission has no configured origin." } else if self.bounded(capability.reason, 512, false, true) { capability.reason } else { "Attempt command capability is unavailable." });
