    fn unbind_knowledge(u: KnowledgeUnbind, ctx: std::api::Context) -> KnowledgeReply {
        return self.knowledge.unbind(u, ctx);
    }
    fn lookup_knowledge(l: KnowledgeRecovery, ctx: std::api::Context) -> KnowledgeReply {
        return self.knowledge.lookup(l, ctx);
    }
}

// The head's surface (GH #1417): every command, served over `unix::Rpc` on
// the head's socket, `http::Rpc` on its commands port and `mcp::Rpc` for an
// agent pairing with a person, under the record's roles
// (`dna::RecordRoles`, named at the serve site). A call is
// `{"call": "Commands::file_friction", "payload": {…}, "id": …}` on the
// socket, `POST /call/Commands::file_friction` over HTTP, and the tool
// `Commands__file_friction` over MCP.
api HeadCommands {
    rpc Commands::propose requires: [position];
    rpc Commands::verdict requires: [reviewer];
    rpc Commands::propose_organization requires: [owner];
    rpc Commands::create_task;
    rpc Commands::reassign_task requires: [owner];
    // The solo path (solo_tasks.hl): a person of the record takes a handed
    // Task no one holds, and reports one theirs done as text.
    rpc Commands::take_task;
    rpc Commands::complete_task;
    rpc Commands::retire_person requires: [owner];
    rpc Commands::claim requires: [position];
    rpc Commands::outcome requires: [position];
    rpc Commands::renew requires: [position];
    rpc Commands::release_attempt requires: [position];
    rpc Commands::ask_allowance requires: [position];
    rpc Commands::file_friction requires: [position];
    rpc Commands::lookup;
    // The record as the standard face's index reads it: a read.
    rpc Commands::index;
    // The structure: every mutation is a head command whose handler writes
    // the rows its CLI verb writes, and the UI is a client of this surface.
    // `vacate` is a one-step batch (`vacate <position> <holder>`).
    rpc Commands::open_position requires: [position];
    rpc Commands::fill requires: [position];
    rpc Commands::apply_batch requires: [position];
    rpc Commands::preview_batch;
    // Knowledge (knowledge_commands.hl): a person of the record may ask;
    // the Knowledge policy decides what that person may change.
    rpc Commands::link_knowledge requires: [position];
    rpc Commands::unlink_knowledge requires: [position];
    rpc Commands::propose_knowledge requires: [position];
    rpc Commands::revise_knowledge requires: [position];
    rpc Commands::retire_knowledge requires: [position];
    rpc Commands::bind_knowledge requires: [position];
    rpc Commands::unbind_knowledge requires: [position];
    rpc Commands::lookup_knowledge;
    // The habitat's placement (habitat_rows.hl): its hosts, its allocations
    // with what their providers observe, and its policy. Reads.
    rpc Commands::hosts;
    rpc Commands::allocations;
    rpc Commands::policy;
    // What its reflexes say now: its senses' store's alerts. A read.
    rpc Commands::alerts;
    // The web UIs across its organisms, for the operator face's home
    // screen: each organism's face and the UIs its manifest declares
    // ([dna.ui.<name>]). A read.
    rpc Commands::uis;
    // The habitat's placement (habitat_placement.hl): an allocation placed
    // on a host ("change a host"), and the allocations applied where they
    // are placed, with the pulse after. The Board's.
    rpc Commands::place_allocation requires: [owner];
    rpc Commands::apply_allocations requires: [owner];
    // A sapling grafted by name, on a host (habitat_placement.hl). The Board's.
    rpc Commands::graft requires: [owner];
    rpc Commands::graft_log requires: [owner];
    // A tenant's model map pointed at an endpoint, and a call on it
    // (habitat_placement.hl). The Board's.
    rpc Commands::set_model_map requires: [owner];
    rpc Commands::probe_model requires: [owner];
    // The habitat's nurseries and saplings (habitat_rows.hl): two reads, and
    // the Board's: a nursery trusted, a sapling's newer revision ratified.
    rpc Commands::nurseries;
    rpc Commands::saplings;
    rpc Commands::add_nursery requires: [owner];
    rpc Commands::ratify_sapling requires: [owner];
    // The habitat's hosts (habitat_hosts.hl): a machine added over SSH,
    // probed again, removed. The Board's. A removal is planned first
    // (`plan_remove_host`, a read of the Board's: nothing is touched) and,
    // when it stops or deletes anything on the host, executed only with the
    // host's name typed back as `confirm`.
    rpc Commands::add_host requires: [owner];
    rpc Commands::probe_host requires: [owner];
    rpc Commands::plan_remove_host requires: [owner];
    rpc Commands::remove_host requires: [owner];
    // The services placed on its hosts (habitat_placed.hl): a placement
    // `hale habitat organism place` ran, and one `unplace` took off,
    // recorded by the CLI (the Board's), and the placements that hold, a
    // read.
    rpc Commands::record_placed requires: [owner];
    rpc Commands::record_unplaced requires: [owner];
    rpc Commands::placements;
    // The habitat's organisms (habitat_organisms.hl): one removed, planned
    // first (`plan_remove_organism`, a read of the Board's) and executed
    // only with the organism's name typed back as `confirm`.
    rpc Commands::plan_remove_organism requires: [owner];
    rpc Commands::remove_organism requires: [owner];
    // The habitat's brief (habitat_brief.hl): the Board's hat as a prompt,
    // with the live state, for an agent pairing with a person. A read.
    rpc Commands::brief;

    // An organism's forge allocated (habitat_rows.hl). The Board's.
    rpc Commands::allocate_forge requires: [owner];
}

// A seat as a structure command names it: `position:<name>` from a name
// written either way, or `organization:<name>` as given where an
// organization may be named.
fn seat_named(name: String, organizations: Bool) -> String {
    if len(name) == 0
        || std::str::starts_with(name, "position:")
        || (organizations && std::str::starts_with(name, "organization:"))
    {
        return name;
    }
    return "position:" + name;
}

// A leased command's subject: the lease it settles under.
fn lease_of(holder: String, token: Int) -> String {
    return "lease:" + holder + "@" + to_string(token);
}
