// A generic fn instantiated at a perspective type.
// == main/main.hl ==
type Order { id: Int; }
perspective OrderRouter {
    fn health() -> Int;
}
locus RouterV1 : serves OrderRouter {
    fn health() -> Int { return 1; }
    fn on_order(o: Order) {
    }
}
main locus App {
    params {
        router: perspective(OrderRouter) = RouterV1 { };
    }
    run() {
        println(__pg_id(self.router).health());
    }
}
fn main() {
}
fn __pg_id<T>(x: T) -> T {
    return x;
}
