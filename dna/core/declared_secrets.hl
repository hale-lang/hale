// The secrets a seed declares in its manifest (`[dna.secrets.<name>]`):
// each the vault entry `secret-<org>-<name>`, drawn by the habitat
// (`drawn`) or filled by a person (`slot`), and handed to the programs and
// host commands it names among its readers.
//
// The toolchain is the one reader of the declaration (`hale dna
// declared-secrets <dir>`): this side never parses the manifest's tables.
// A program that reads one is handed, in its compose project's environment,
// `HALE_VAULT_DIR` (a vault directory of the organism's own where its
// services run: mode 700, each entry 600, holding only the secrets its
// programs read) and, per secret, `HALE_SECRET_<NAME>` naming its entry
// there. A family (`family = true`) is several entries, each a member
// filled under a label (`secret-<org>-<name>--<label>`): a slot's by a
// person, a drawn one's (a provider's key, `[dna.provides.<capability>]`)
// by the habitat, one per tenant organism. Its variable holds them all,
// one a line, in their labels' order, and `HALE_SECRET_<NAME>_FAMILY`
// their common prefix, so a reader lists the members drawn while it runs
// (the reader vault is restaged in place when one is drawn or removed).
// The application's compose file passes them to the services that
// read them and mounts the directory, read-only, at the same path;
// `std::secret::Credential { vault: <that name> }` then reads it.

// The declaration as the toolchain read it.
type DeclaredSecrets {
    ok: Bool = false;
    why: String = "";
    // a secret a line: `<name>\t<drawn|slot>\t<read|write|none>\t<programs>\t<host commands>\t<family or "">`,
    // each list space-separated
    lines: String = "";
}

// The secrets `<dir>/hale.toml` declares; none when it has no manifest.
fn declared_secrets(dir: String) -> DeclaredSecrets {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let r = run_tool(hale + "\ndna\ndeclared-secrets\n" + dir);
    if r.code != 0 {
        let said = trim_nl(r.stderr);
        return DeclaredSecrets {
            why: if len(said) > 0 { last_line(said) } else { "hale dna declared-secrets failed" },
        };
    }
    return DeclaredSecrets { ok: true, lines: r.stdout };
}

// The vault entry that holds the organism's secret `name` (`org` its
// record's schema, `schema_for`, as the nerves' entries are named).
fn declared_secret_vault(org: String, name: String) -> String {
    return "secret-" + identifier_part(org, 60) + "-" + name;
}

// The vault entry of the family `name`'s member `label`.
fn family_member_vault(org: String, name: String, label: String) -> String {
    return declared_secret_vault(org, name) + "--" + label;
}

// A family member's label: 1 to 63 characters, a lowercase letter or a
// digit, then lowercase letters, digits and `-` (^[a-z0-9][a-z0-9-]{0,62}$).
fn family_label_ok(label: String) -> Bool {
    if len(label) == 0 || len(label) > 63 { return false; }
    let mut i = 0;
    while i < len(label) {
        let c = label[i..(i + 1)];
        let ok = (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || (c == "-" && i > 0);
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}
const FAMILY_LABEL_RULE: String = "a label is 1 to 63 characters: a lowercase letter or a digit, then lowercase letters, digits and `-` (^[a-z0-9][a-z0-9-]{0,62}$)";

// The labels of the family `name`'s members the local vault holds, one a
// line, in order ("" for none, and with a vault served over HTTP, whose
// entries are not listed here).
fn family_labels(org: String, name: String) -> String {
    if std::env::var_exists("HALE_VAULT_ADDR") { return ""; }
    let prefix = declared_secret_vault(org, name) + "--";
    let r = run_tool(
        "sh\n-c\nfor f in \"$1\"/\"$2\"*; do [ -s \"$f\" ] && printf '%s\\n' \"${f##*/}\"; done | LC_ALL=C sort\nsh\n"
            + std::secret::vault_local_dir() + "\n" + prefix,
    );
    let mut out = "";
    let mut rest = r.stdout;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let f = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if !std::str::starts_with(f, prefix) { continue; }
        let label = f[len(prefix)..len(f)];
        if family_label_ok(label) { out = out + label + "\n"; }
    }
    return out;
}

// The variable its readers are handed the entry's name in.
fn declared_secret_var(name: String) -> String {
    return "HALE_SECRET_" + std::str::upper(std::str::replace(name, "-", "_"));
}

// Field `n` (from 0) of a declaration's line.
fn declared_field(line: String, n: Int) -> String {
    let mut rest = line;
    let mut i = 0;
    while i < n {
        let t = std::str::index_of(rest, "\t");
        if t < 0 { return ""; }
        rest = rest[(t + 1)..len(rest)];
        i = i + 1;
    }
    let t = std::str::index_of(rest, "\t");
    return if t < 0 { rest } else { rest[0..t] };
}

// Whether a declaration's line declares a family, and an optional secret.
fn declared_family(line: String) -> Bool { return declared_field(line, 5) == "family"; }
fn declared_optional(line: String) -> Bool { return declared_field(line, 6) == "optional"; }

// The secrets some program reads, a line each: `<variable>\t<its entries>`,
// the entries space-separated (a family's members the local vault holds,
// in their labels' order; none when it has none), and for a family a
// third field, its members' common prefix (`secret-<org>-<name>--`).
fn program_secrets(lines: String, org: String) -> String {
    let mut out = "";
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let name = declared_field(line, 0);
        if len(name) == 0 || len(std::str::trim(declared_field(line, 3))) == 0 { continue; }
        let mut entries = "";
        if declared_family(line) {
            let mut labels = family_labels(org, name);
            while len(labels) > 0 {
                let l = std::str::index_of(labels, "\n");
                let label = labels[0..l];
                labels = labels[(l + 1)..len(labels)];
                entries = entries + (if len(entries) > 0 { " " } else { "" })
                    + family_member_vault(org, name, label);
            }
        } else {
            entries = declared_secret_vault(org, name);
            // an optional slot no person filled is not handed: its readers
            // see no variable for it (a family with no member is handed
            // empty, its variable set)
            if declared_optional(line) && !std::secret::Credential { vault: entries }.ready() {
                continue;
            }
        }
        out = out + declared_secret_var(name) + "\t" + entries
            + (
                if declared_family(line) {
                    "\t" + declared_secret_vault(org, name) + "--"
                } else {
                    ""
                }
            )
            + "\n";
    }
    return out;
}

// A line of `program_secrets`: its entries (the second field) and a
// family's prefix (the third, "" for a single secret).
fn program_entries(line: String) -> String { return declared_field(line, 1); }
fn program_family(line: String) -> String { return declared_field(line, 2); }

// The vault entries of `secrets` (`program_secrets`), each after `sep`.
fn reader_entries(secrets: String, sep: String) -> String {
    let mut out = "";
    let mut rest = secrets;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::index_of(line, "\t") < 0 { continue; }
        let mut es = program_entries(line) + " ";
        while len(std::str::trim(es)) > 0 {
            let sp = std::str::index_of(es, " ");
            let e = es[0..sp];
            es = es[(sp + 1)..len(es)];
            if len(e) > 0 { out = out + sep + e; }
        }
    }
    return out;
}

// What a shell hands compose for `secrets`, as assignment words ("" when
// none): `HALE_VAULT_DIR=<dir>` (`dir` a shell word already) and each
// `HALE_SECRET_<NAME>`, its entries one a line (printf's lines: no
// argument carries a newline of its own), and for a family
// `HALE_SECRET_<NAME>_FAMILY`, its members' prefix, each word with a space
// after it.
fn reader_words(secrets: String, dir: String) -> String {
    if len(secrets) == 0 { return ""; }
    let mut out = "HALE_VAULT_DIR=" + dir + " ";
    let mut rest = secrets;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let t = std::str::index_of(line, "\t");
        if t <= 0 { continue; }
        let entries = std::str::trim(program_entries(line));
        let family = program_family(line);
        out = out + line[0..t] + "="
            + (
                if std::str::contains(entries, " ") {
                    "\"$(printf '%s\\n' '" + std::str::replace(entries, " ", "' '") + "')\""
                } else {
                    "'" + entries + "'"
                }
            )
            + " " + (if len(family) > 0 { line[0..t] + "_FAMILY='" + family + "' " } else { "" });
    }
    return out;
}

// `secrets` handed to a command run by `run_tool`: an argv prefix (lines)
// that exports them and execs the command after it ("" when none).
fn reader_wrap(secrets: String, dir: String) -> String {
    return services_wrap("", "", secrets, dir);
}

// The variable an organism's services are handed the habitat's name in,
// when the organism is the habitat's: a provider names what it keeps for
// the habitat it serves by it (spec/habitat.md, Placing and applying).
const HABITAT_NAME_ENV: String = "HALE_DNA_HABITAT_NAME";

// The habitat's name `habitat` as the word a shell hands compose
// (`HALE_DNA_HABITAT_NAME='<name>'`, a space after it), "" for none.
fn habitat_name_word(habitat: String) -> String {
    if len(habitat) == 0 { return ""; }
    return HABITAT_NAME_ENV + "='" + std::str::replace(habitat, "'", "'\\''") + "' ";
}

// The variable an organism's services are handed the commit they are
// applied at in: its compose file names its images by it to have them
// pulled, not built (spec/habitat.md, Placing and applying).
const REVISION_ENV: String = "HALE_DNA_REVISION";

// The revision `revision` as the word a shell hands compose
// (`HALE_DNA_REVISION='<commit>'`, a space after it), "" for none.
fn revision_word(revision: String) -> String {
    if len(revision) == 0 { return ""; }
    return REVISION_ENV + "='" + std::str::replace(revision, "'", "'\\''") + "' ";
}

// What a render's services are handed, to a command run by `run_tool`: an
// argv prefix (lines) that exports the habitat's name (`habitat`, "" for
// none), the revision they are applied at (`revision`, "" for none) and
// `secrets` (`reader_words`, the reader vault `dir`) and execs the command
// after it ("" when there is nothing to hand).
fn services_wrap(habitat: String, revision: String, secrets: String, dir: String) -> String {
    let words = habitat_name_word(habitat) + revision_word(revision)
        + reader_words(secrets, "'" + std::str::replace(dir, "'", "'\\''") + "'");
    if len(words) == 0 { return ""; }
    return "sh\n-c\nexport " + words + "&& exec \"$@\"\nsh\n";
}

// The habitat's name when the organism keyed `key` is the habitat's: one
// it grafted, whose graft kept its parts' choices beside its allocations
// (`parts.json`). "" for any other (a repository body outside a habitat).
fn grafted_habitat_name(key: String) -> String {
    if len(key) == 0 { return ""; }
    if !std::io::fs::file_exists(local_habitat_dir() + "/allocations/" + key + "/parts.json") {
        return "";
    }
    return habitat_name_here();
}

// The local reader vault of the organism keyed `key`: beside its
// allocations in the local habitat, never in a checkout.
fn reader_vault_dir(key: String) -> String {
    return local_habitat_dir() + "/allocations/" + key + "/vault";
}

// The script that brings a reader vault to hold `secrets`' entries and no
// other (none: every entry staged before removed, and no directory made
// when there is none): made (700) when it is not, each entry rewritten in place (600) from
// the vault directory `$1` (a running service mounts the directory, so it is
// never replaced), an entry the vault lacks or no secret names removed.
// Arguments: the vault, the reader vault, then the entries.
const READER_VAULT_SCRIPT: String = "src=$1 d=$2; shift 2; [ $# -gt 0 ] || [ -d \"$d\" ] || exit 0; umask 077; mkdir -p \"$d\" && chmod 700 \"$d\" || exit 1; for f in \"$d\"/* \"$d\"/.[!.]*; do [ -e \"$f\" ] || continue; n=${f##*/}; keep=0; for e in \"$@\"; do [ \"$e\" = \"$n\" ] && keep=1; done; [ $keep = 1 ] || rm -f \"$f\"; done; for e in \"$@\"; do if [ -s \"$src/$e\" ]; then cat \"$src/$e\" > \"$d/$e\" && chmod 600 \"$d/$e\" || exit 1; else rm -f \"$d/$e\"; fi; done";

// The local reader vault `dir` brought to hold `secrets`' entries, copied
// file to file from the local vault, never read into this program: "" once
// it does, else why not. An empty `secrets` is reconciled too: what a
// program no longer reads leaves the directory.
fn stage_reader_vault(dir: String, secrets: String) -> String {
    if len(dir) == 0 { return ""; }
    if len(reader_entries(secrets, "\n")) > 0 && std::env::var_exists("HALE_VAULT_ADDR") {
        return "the vault is served over HTTP (HALE_VAULT_ADDR): a declared secret reaches its programs from a local vault alone";
    }
    // a secret handed with no entry (a family with no member yet) has its
    // directory all the same: compose mounts it before a member is drawn
    if len(secrets) > 0 && len(reader_entries(secrets, "\n")) == 0 {
        let made = run_tool("mkdir\n-p\n-m\n700\n" + dir);
        if made.code != 0 { return "the reader vault " + dir + ": " + trim_nl(made.stderr); }
    }
    let r = run_tool(
        "sh\n-c\n" + READER_VAULT_SCRIPT + "\nsh\n" + std::secret::vault_local_dir() + "\n" + dir
            + reader_entries(secrets, "\n"),
    );
    return if r.code == 0 { "" } else { "the reader vault " + dir + ": " + trim_nl(r.stderr) };
}

// The reader vault of the organism keyed `key` restaged in place, from the
// local vault, where its services were last applied (the habitat's record
// at `groot` holds their allocation): on this machine or over the
// habitat's SSH on their host, as their apply stages it, and none of its
// services re-applied, since a running one mounts the directory. Its
// programs read a family's members by their prefix, so one drawn or
// removed since reaches them now. "" once done (or nothing to do: no
// services, never applied), else why not.
fn restage_services_vault(groot: String, key: String) -> String {
    let mut rest = teardown_latest(groot, "habitat.allocated");
    let mut body = "";
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::starts_with(line, key + "/services\t") {
            body = line[(len(key) + 10)..len(line)];
        }
    }
    if len(body) == 0 { return ""; }
    // never applied: its first apply stages it
    if !std::io::fs::file_exists(placed_path(key, "services")) { return ""; }
    let dir = std::json::find_string_field(body, "render_dir");
    let organism = std::json::find_string_field(body, "organism");
    let declared = declared_secrets(dir);
    if !declared.ok { return "its declared secrets were not read: " + declared.why; }
    let render = Render {
        project: std::json::find_string_field(body, "project"),
        dir: dir,
        files: std::json::find_string_field(body, "render_files"),
        mounted: std::json::find_string_field(body, "render_mounted"),
        secrets: if len(organism) >= 12 {
            program_secrets(declared.lines, schema_for(organism))
        } else {
            ""
        },
        vault: reader_vault_dir(key),
    };
    let applied = placed_on(key, "services");
    if applied.host == "local" || len(applied.host) == 0 {
        return stage_reader_vault(render.vault, render.secrets);
    }
    let h = recorded_host(groot, applied.host);
    if len(h.provider) == 0 { return "its host " + applied.host + " is no host of the habitat's"; }
    return ssh_stage_reader_vault(groot, h, render);
}

// The habitat's models provider: the organism it grafted whose manifest
// provides `models` (`[dna.provides.models]`, read by `hale dna
// declared-provides`), its key, name, record and directory, and the drawn
// family its tenants' keys are members of. Empty (no key) when it grafted
// none.
type ModelsProvider {
    key: String = "";
    name: String = "";
    child: String = "";
    dir: String = "";
    family: String = "";
}

@bounded_by(groot)
fn models_provider(groot: String) -> ModelsProvider {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let mut rest = teardown_latest(groot, "habitat.grafted");
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let tab = std::str::index_of(line, "\t");
        if tab < 0 { continue; }
        let key = line[0..tab];
        let body = line[(tab + 1)..len(line)];
        let cache = std::io::fs::read_file(
            local_habitat_dir() + "/allocations/" + key + "/allocation.json",
        )
        or "";
        let dir = std::json::find_string_field(cache, "root");
        if len(dir) == 0 { continue; }
        let r = run_tool(hale + "\ndna\ndeclared-provides\n" + dir);
        if r.code != 0 || !std::str::starts_with(r.stdout, "models\t") { continue; }
        let first = trim_nl(r.stdout);
        let end = std::str::index_of(first, "\n");
        return ModelsProvider {
            key: key,
            name: std::json::find_string_field(body, "name"),
            child: std::json::find_string_field(body, "child"),
            dir: dir,
            family: declared_field(if end < 0 { first } else { first[0..end] }, 4),
        };
    }
    return ModelsProvider { };
}

// The vault entry of the tenant `label`'s key at the provider `p`.
fn provider_member_vault(p: ModelsProvider, label: String) -> String {
    return family_member_vault(schema_for(p.child), p.family, label);
}

// The vault slot the habitat copies a tenant's key into, named for the
// tenant (`model-HABITAT_<key>`, the key upper-cased): a model key's slot
// (`hale dna secret rotate HABITAT_<key>`), one per organism, since the
// habitat's organisms share one vault.
fn habitat_model_slot(key: String) -> String {
    return "model-HABITAT_" + std::str::upper(key);
}
