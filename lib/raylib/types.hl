// raylib stub — value types.
// Surface contract: ../../COMPILER_FFI.md § `std::raylib::*`.

type Vec3 {
    x: Float = 0.0;
    y: Float = 0.0;
    z: Float = 0.0;
}

type Vec2 {
    x: Float = 0.0;
    y: Float = 0.0;
}

type Color {
    r: Int = 0;
    g: Int = 0;
    b: Int = 0;
    a: Int = 255;
}

type Rect {
    x:      Float = 0.0;
    y:      Float = 0.0;
    width:  Float = 0.0;
    height: Float = 0.0;
}

type Camera3D {
    position:   Vec3   = Vec3 { x: 0.0, y: 5.0, z: 10.0 };
    target:     Vec3   = Vec3 { };
    up:         Vec3   = Vec3 { x: 0.0, y: 1.0, z: 0.0 };
    fovy:       Float  = 60.0;
    projection: Int    = 0;   // 0 = perspective, 1 = orthographic
}
