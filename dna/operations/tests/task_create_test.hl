// The codec for raising work (dna.task.create@1): the row is the
// `intent.requested` row `hale dna ask` writes, with the command fields beside
// it. The command against a record kept in memory, where the row is the
// Ledger's, is task_ledger_test's (GH #1590).
import ".." as ops;
import "../../core" as dna;

const HEAD: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
const OUTCOME: String = "Raise é 🧭\r\n<literal & markup>";

locus CreateCases {
    params { }
    fn context(app: String) -> ops::GovernanceContext {
        return ops::GovernanceContext {
            application_id: app,
            principal_mode: "local",
            principal_name: "riley",
        };
    }
    fn command(
        context: ops::GovernanceContext,
        key: String,
        head: String,
        outcome: String,
        to: String
    ) -> ops::GovernanceCommand {
        return ops::GovernanceCommand {
            request_id: key,
            operation: "dna.task.create",
            application_id: context.application_id,
            target_kind: "dna.record",
            target_id: context.application_id,
            subject_digest: head, record_head: head, outcome: outcome, to: to };
    }
    // the bytes `hale dna ask` writes for the same outcome/from/to (dna/host/writers.hl)
    fn cli_row(outcome: String, from: String, to: String) -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("outcome", outcome);
        b.string_field("from", from);
        b.string_field("to", to);
        b.end_object();
        return b.result();
    }
    fn row(repo: String, kind: String, entity: String) -> dna::Event {
        std::test::assert_eq_str(
            dna::memory_fixture(repo),
            "",
            "the record is born in memory (GH #1590)",
        );
        let j = dna::RoutedJournal {
            record: dna::RecordJournal { repo: repo },
            ledger: dna::MemoryLedger { repo: repo },
        };
        let mut found = dna::Event { };
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && e.entity == entity { found = e; } i = i + 1;
        }
        return found;
    }
    fn author_of(record: dna::MemoryRecord, seq: Int) -> String {
        return std::json::find_string_field(
            dna::line_at(record.text_at(record.head("journal").id), seq),
            "author",
        );
    }
    fn count(repo: String, kind: String) -> Int {
        std::test::assert_eq_str(
            dna::memory_fixture(repo),
            "",
            "the record is born in memory (GH #1590)",
        );
        let j = dna::RoutedJournal {
            record: dna::RecordJournal { repo: repo },
            ledger: dna::MemoryLedger { repo: repo },
        };
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() { if j.read(i).kind == kind { n = n + 1; } i = i + 1; }
        return n;
    }
    fn sample(context: ops::GovernanceContext) -> ops::GovernanceCommand {
        return self.command(context, "key", HEAD, OUTCOME, "org/support");
    }
    fn event(kind: String, entity: String, body: String, prev: String) -> dna::Event {
        return dna::Event {
            seq: 3,
            kind: kind,
            entity: entity,
            body: body,
            prev: prev,
            digest: "d",
        };
    }
    // `let bad = c` aliases the struct, so every negative below is built fresh.
    fn codecs() {
        let context = self.context("app");
        let codec = ops::TaskCreateCommandCodec { };
        let common = ops::GovernanceCommandCodec { };
        let c = self.sample(context); let canonical = codec.canonical(context, c);
        std::test::assert(
            codec.valid(context, c)
                && std::str::starts_with(canonical, "{\"format\":\"dna.task-create-command/1\"")
                && codec.canonical(context, codec.decode(context, canonical)) == canonical,
            "closed exact create variant roundtrip",
        );
        let decoded = codec.decode(context, canonical);
        std::test::assert(
            decoded.outcome == OUTCOME
                && decoded.to == "org/support"
                && decoded.record_head == HEAD
                && decoded.subject_digest == HEAD,
            "decoded fields exact",
        );
        let mut bad = self.sample(context);
        bad.outcome = "";
        std::test::assert(!codec.valid(context, bad), "an outcome is required");
        bad = self.sample(context);
        bad.to = "";
        std::test::assert(!codec.valid(context, bad), "a position is required");
        bad = self.sample(context);
        bad.to = "a\nb";
        std::test::assert(!codec.valid(context, bad), "a position has no control bytes");
        bad = self.sample(context);
        bad.record_head = "";
        bad.subject_digest = "";
        std::test::assert(!codec.valid(context, bad), "the head precondition is required");
        bad = self.sample(context);
        bad.subject_digest = "other";
        std::test::assert(!codec.valid(context, bad), "the subject is the head");
        bad = self.sample(context);
        bad.target_kind = "dna.task";
        std::test::assert(!codec.valid(context, bad), "the target is the Record");
        bad = self.sample(context);
        bad.target_id = "other";
        std::test::assert(!codec.valid(context, bad), "the target is this application");
        bad = self.sample(context);
        bad.text = "stray";
        std::test::assert(!codec.valid(context, bad), "no practice fields");
        let big = std::bytes::BytesBuilder { };
        let mut i = 0;
        while i < 8193 { big.append_u8(97); i = i + 1; }
        bad = self.sample(context);
        bad.outcome = std::str::from_bytes(big.snapshot() or raise);
        std::test::assert(!codec.valid(context, bad), "outcome bound");
        let old = ops::GovernanceCommand {
            request_id: "key",
            operation: "dna.practice.propose",
            application_id: "app",
            target_kind: "dna.practice",
            target_id: "subject",
            subject_digest: "subject",
            text: "text",
            rationale: "because",
            outcome: "stray",
        };
        std::test::assert(!common.valid(context, old), "old variant rejects stray create fields");
        let task = ops::TaskCommandCodec { };
        let reassign = ops::GovernanceCommand {
            request_id: "key",
            operation: "dna.task.reassign",
            application_id: "app",
            target_kind: "dna.task",
            target_id: "task",
            subject_digest: dna::digest_of("basis"),
            expected_assignee: "alice",
            new_assignee: "bob",
            to: "org",
        };
        std::test::assert(
            !task.valid(context, reassign),
            "Task variant rejects stray create fields",
        );
        // GH #1144: the kind rides on raising work alone
        let mut old_kind = old; old_kind.outcome = ""; old_kind.ask_kind = "judgment";
        std::test::assert(!common.valid(context, old_kind), "old variant rejects a stray kind");
        let mut reassign_kind = reassign;
        reassign_kind.outcome = "";
        reassign_kind.to = "";
        reassign_kind.ask_kind = "judgment";
        std::test::assert(!task.valid(context, reassign_kind), "Task variant rejects a stray kind");
        // a judgment: named in its canonical and its row; a change's bytes are as they were
        std::test::assert(
            !std::str::contains(canonical, ",\"kind\":"),
            "a change's canonical names no kind: " + canonical,
        );
        let mut judged = self.sample(context); judged.ask_kind = "judgment";
        let judged_canonical = codec.canonical(context, judged);
        std::test::assert(
            codec.valid(context, judged)
                && std::str::ends_with(judged_canonical, ",\"kind\":\"judgment\"}")
                && codec.decode(context, judged_canonical).ask_kind == "judgment"
                && codec.canonical(
                    context,
                    codec.decode(context, judged_canonical),
                ) == judged_canonical,
            "a judgment's canonical roundtrips: " + judged_canonical,
        );
        std::test::assert(
            codec.fingerprint(context, judged) != codec.fingerprint(context, c),
            "a judgment and a change are different commands",
        );
        bad = self.sample(context);
        bad.ask_kind = "change";
        std::test::assert(!codec.valid(context, bad), "a kind is a judgment or nothing");
        let empty_kind = std::str::replace(
            canonical,
            "\"to\":\"org/support\"}",
            "\"to\":\"org/support\",\"kind\":\"\"}",
        );
        std::test::assert(
            empty_kind != canonical && codec.decode(context, empty_kind).request_id == "",
            "an empty kind written out is no canonical",
        );
        let g = codec.grant(context);
        let judged_fact = codec.fact(context, judged, g, HEAD);
        let change_fact = codec.fact(context, c, g, HEAD);
        std::test::assert_eq_str(
            std::json::find_string_field(judged_fact, "kind"),
            "judgment",
            "the relay reads a judgment's kind off the row",
        );
        std::test::assert_eq_str(
            std::json::find_string_field(change_fact, "kind"),
            "",
            "and none off a change's",
        );
        let mut quoting = self.sample(context);
        quoting.outcome = "say \"kind\": \"judgment\" in prose";
        std::test::assert_eq_str(
            std::json::find_string_field(codec.fact(context, quoting, g, HEAD), "kind"),
            "",
            "a change whose outcome quotes a kind is still a change",
        );
        let as_row = dna::Event {
            kind: "intent.requested",
            entity: "i1f4",
            body: judged_fact,
            prev: HEAD,
        };
        let read = codec.decode_fact(as_row);
        std::test::assert(
            read.valid && read.command.ask_kind == "judgment",
            "a judgment's row decodes as one",
        );
        let dropped = dna::Event {
            kind: "intent.requested",
            entity: "i1f4",
            body: std::str::replace(judged_fact, ", \"kind\": \"judgment\"", ""),
            prev: HEAD,
        };
        std::test::assert(
            dropped.body != judged_fact && !codec.decode_fact(dropped).valid,
            "a row that drops its kind is not its command's row",
        );
        let added = dna::Event {
            kind: "intent.requested",
            entity: "i1f4",
            body: std::str::replace(
                change_fact,
                "\"to\": \"org/support\",",
                "\"to\": \"org/support\", \"kind\": \"judgment\",",
            ),
            prev: HEAD,
        };
        std::test::assert(
            added.body != change_fact && !codec.decode_fact(added).valid,
            "a change's row given a kind is not its command's row",
        );
        std::test::assert_eq_str(codec.hex(255), "ff", "lower-case hex");
        std::test::assert_eq_str(codec.hex(0), "0", "zero");
        std::test::assert(
            codec.intent_id_valid("i1f4")
                && codec.intent_id_valid("i0")
                && !codec.intent_id_valid("i")
                && !codec.intent_id_valid("x1f")
                && !codec.intent_id_valid("i1F")
                && !codec.intent_id_valid("command-1"),
            "intent id shape",
        );
        let q = dna::MemJournal { };
        std::test::assert(
            q.append(0, "intent.requested", "i1f4", "{}").ok
                && q.append(1, "intent.requested", "i1f5", "{}").ok,
            "held ids",
        );
        std::test::assert_eq_str(
            codec.intent_id(q, 500),
            "i1f6",
            "an id this Record holds steps to the next millisecond",
        );
        std::test::assert_eq_str(codec.intent_id(q, 501), "i1f6", "and the next");
        std::test::assert_eq_str(
            codec.intent_id(q, 600),
            "i258",
            "a free millisecond is used as is",
        );
        let grant = codec.grant(context);
        std::test::assert(
            grant.allowed
                && grant.authority == "riley"
                && std::str::starts_with(
                    grant.basis,
                    "dna.task.create/1:authenticated-principal:local",
                ),
            "the principal is the authority",
        );
        std::test::assert(!codec.grant(ops::GovernanceContext { }).allowed, "no context, no grant");
        let sound = self.sample(context); let fact = codec.fact(context, sound, grant, HEAD);
        let cli = self.cli_row(OUTCOME, "riley", "org/support");
        std::test::assert(
            std::str::starts_with(fact, cli[0..(len(cli) - 1)] + ", \"command_format\""),
            "fact begins with the CLI bytes",
        );
        let e = self.event("intent.requested", "i1f4", fact, HEAD);
        std::test::assert(
            codec.decode_fact(e).valid
                && codec.decode_fact(e).intent_id == "i1f4"
                && codec.decode_fact(e).command.outcome == OUTCOME,
            "fact roundtrip",
        );
        std::test::assert(
            !codec.decode_fact(self.event("intent.requested", "task", fact, HEAD)).valid,
            "the entity is an intent id",
        );
        std::test::assert(
            !codec.decode_fact(self.event("task.born", "i1f4", fact, HEAD)).valid,
            "the kind is the ask",
        );
        std::test::assert(
            !codec.decode_fact(self.event("intent.requested", "i1f4", fact, "other")).valid,
            "the head is the predecessor",
        );
        std::test::assert(
            !codec.decode_fact(
                self.event(
                    "intent.requested",
                    "i1f4",
                    std::str::replace(fact, "org/support", "org/finance"),
                    HEAD,
                ),
            ).valid,
            "changed bytes are not this command",
        );
        std::test::assert(
            !codec.decode_fact(
                self.event(
                    "intent.requested",
                    "i1f4",
                    self.cli_row(OUTCOME, "riley", "org/support"),
                    HEAD,
                ),
            ).valid,
            "a CLI ask is not a command fact",
        );
        std::test::assert(
            codec.fact(context, self.sample(context), ops::GovernanceGrant { }, HEAD) == ""
                && codec.fact(context, bad, grant, HEAD) == "",
            "no fact without a grant or a valid command",
        );
    }
}
fn main() {
    let cases = CreateCases { }; cases.codecs();
    eprintln("task create codec cases passed");
}
