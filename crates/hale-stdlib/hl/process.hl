// Hale stdlib — std::process.
//
// Two surfaces:
//
// 1. `std::process::run(argv) -> ProcessOutput fallible(IoError)` —
//    synchronous fork+exec+wait. Captures stdout/stderr/exit-code
//    in one call. Covers ~80% of shell-out use cases (`git`,
//    `which`, `openssl rand`, etc.). Lowered directly by codegen
//    (no .hl wrapper) — see `lower_std_process_run_fallible`.
//
// 2. `std::process::spawn(argv) -> Child fallible(IoError)` plus
//    free fns `wait` / `kill` / `write_stdin` / `read_stdout` /
//    `read_stderr` / `adopt` — async lifecycle for long-running
//    children (a build job, a TUI process, etc.). Each of these is
//    the user-facing path-call surface; codegen routes it to the
//    bare `__std_process_*` fn declared below (same pattern as
//    `std::http::parse_request` → `__parse_http_request`).
//
//    `adopt(dest, src)` (GH #716) moves a spawned handle into a
//    Child the caller already owns — a locus's own `params` field —
//    so a service can retain its subprocess past the method that
//    started it. It is the ownership transfer; `self.child =
//    std::process::spawn(…)` is refused because a locus-typed field
//    takes only a locus LITERAL (GH #383).
//
// The `Child` locus's dissolve() reaps any unwaited child
// (TERM → wait 100ms → KILL → waitpid) so an owner that is
// reclaimed doesn't leave zombies behind. See "fd cleanup and who
// runs it" below for which handles have such an owner.
//
// **Argv shape.** Newline-separated String. argv[0] is the
// executable, argv[1..] are args. Hale's array surface is
// statically-sized, so the newline blob is the v1 ergonomic
// compromise. Trailing newline allowed but optional.
//
//   std::process::run("git\nstatus\n") or raise
//   std::process::run("echo\nhello world")     // also fine
//
// **Process group + signals.** Each spawned child gets its own
// process group (`setpgid(0, 0)` in the child) so a hard parent
// crash doesn't strand orphans on shared session resources, and
// so `kill` can target the whole group if we grow that surface
// later. `setpgid` is portable POSIX; we deliberately did NOT pick
// `prctl(PR_SET_PDEATHSIG)` (Linux-only and overzealous — a
// controlled `dissolve()` already covers the orderly-shutdown
// path).
//
// **SIGPIPE.** Globally ignored at lotus_io_init startup. Writes
// to a closed pipe surface EPIPE via the IoError channel instead
// of killing the parent.
//
// **fd cleanup and who runs it.** Child.dissolve() closes all three
// pipe fds and reaps the process (TERM → wait 100ms → KILL →
// waitpid), and it runs for whatever owns the handle. A `let` owns
// what it names, so the plainest spelling cleans itself up:
//
//   let c = std::process::spawn("sleep\n30") or raise;
//   // …scope exits: c's dissolve closes the three pipe fds, kills
//   // and reaps the child, and gives back the handle's arena.
//
// (Until GH #793 it did not: a factory-returned locus went to a
// program-lifetime arena, so the child was still running with PPID 1
// after the program exited. The `or` a fallible factory is reached
// through hid the call from the ownership rule.)
//
// To keep a child PAST the scope that spawned it, the handle has to
// belong to something that outlives it — a locus's own `params`
// field:
//
//   locus Job {
//       params { child: std::process::Child = std::process::Child { }; }
//       fn start(argv: String) {
//           let s = std::process::spawn(argv) or std::process::Child { };
//           std::process::adopt(self.child, s);
//       }
//   }
//
// `adopt` moves the pid and the three fds into the field and disarms
// the source, so `s`'s own dissolve at the end of `start` releases
// nothing and the OWNER's dissolve closes the pipes and reaps the
// child — as does `adopt` itself for a handle it displaces.

// User-facing capture-output struct. Returned by `std::process::run`.
/// A finished child's exit code + captured stdout/stderr
/// (from `std::process::run`).
type __StdProcessOutput {
    // Exit code (0..255) for a process that exited normally.
    // -1 if the process was killed by a signal — check `signal`
    // for the SIGTERM/SIGKILL/etc. number.
    code: Int;
    // Signal number that killed the process (0 if exited normally).
    signal: Int;
    // Captured stdout as a String. Read to EOF.
    stdout: String;
    // Captured stderr as a String. Read to EOF.
    stderr: String;
}

// Internal struct: opaque handle returned by the spawn path-call.
// User code never sees this directly — `__std_process_spawn`
// unpacks it into a Child locus literal.
type __StdProcessSpawnHandle {
    pid: Int;
    stdin_fd: Int;
    stdout_fd: Int;
    stderr_fd: Int;
}

// Internal: outcome of a blocking wait.
type __StdProcessWaitOutcome {
    code: Int;
    signal: Int;
}

// Lifecycle-bound subprocess handle. Construct via
// `std::process::spawn(argv)`; the binding that names it owns it and
// its dissolve closes the pipes and reaps the child at scope exit.
// To keep the child past that scope, move it into a Child an owner
// reclaims — see "fd cleanup and who runs it" above.
//
// Methods are absent on purpose — the two-channel rule blocks
// locus methods from declaring `fallible(E)`, and every
// useful subprocess operation can fail (write to a broken pipe,
// wait on a vanished child, etc.). The free-fn surface
// (`std::process::wait` / `kill` / `write_stdin` /
// `read_stdout` / `read_stderr`) carries the value channel.
//
// dissolve() is the only "method" the locus ships: it kills (TERM
// → 100ms grace → KILL) and reaps any unwaited child so the owner
// that reclaims this handle doesn't leak zombies.
//
// **One owner.** Exactly one Child instance owns a given pid + fd
// triple, and it is the one whose dissolve closes them. To keep a
// spawned child alive past the method that spawned it, move the
// handle into a Child you own with `std::process::adopt` (GH #716) —
// which disarms the source, so the ownership stays single. Copying
// the fields out by hand leaves two armed handles and double-closes.
/// A spawned child process handle: pid + I/O fds. `pid <= 0`
/// is the not-running sentinel (manual construction is legal;
/// the wait/kill family no-ops on it).
locus __StdProcessChild {
    params {
        // Original argv-blob passed to spawn. Held for diagnostics
        // — e.g., to surface in error messages when wait() fails.
        argv: String = "";
        // OS pid. -1 sentinel for a partially-constructed handle
        // so dissolve() can detect "never spawned" and skip the
        // kill+reap dance.
        pid: Int = -1;
        // Parent-side pipe fds. -1 sentinel means "not spawned"
        // (or "already closed" — dissolve() closes idempotently).
        stdin_fd: Int = -1;
        stdout_fd: Int = -1;
        stderr_fd: Int = -1;
    }
    dissolve() {
        // One teardown spine (GH #716): dissolve and `adopt`'s
        // release of an outgoing handle must close and reap
        // identically, or "exactly one owner" is only true on one
        // of the two paths.
        __std_process_release(self);
    }
}

// Release everything one Child handle owns — the three pipe fds and
// the process — and leave the handle EMPTY. The single teardown
// spine behind both `Child.dissolve()` and `std::process::adopt`
// (GH #716).
//
// Close pipe fds first so any blocked child read/write unsticks.
// close(-1) is fine — lotus_tcp_close_fd guards. The fds are then
// reset to -1 *before* anything else can spawn, so a second release
// of the same handle cannot close a descriptor number the kernel
// has since handed to another child: the close happens exactly once
// per descriptor, at the moment this handle stops owning it.
//
// Kill + reap any unwaited child. lotus_process_kill_escalate is
// idempotent — if the child was already reaped (by an explicit
// wait()), it returns 0 cleanly because the underlying ESRCH/ECHILD
// codes are mapped to success. For -1 (never spawned), we skip the
// call entirely so we don't synthesize a phantom IoError on a benign
// path. `or discard` because a teardown path can't propagate via the
// value channel (two-channel rule) and this is already best-effort
// cleanup — surfacing the error to the bus or panicking would mask
// the original teardown intent.
//
// Internal: no `std::process::` path, so it is reachable only from
// inside this module.
fn __std_process_release(c: std::process::Child) {
    std::io::tcp::__close_fd(c.stdin_fd);
    std::io::tcp::__close_fd(c.stdout_fd);
    std::io::tcp::__close_fd(c.stderr_fd);
    c.stdin_fd = -1;
    c.stdout_fd = -1;
    c.stderr_fd = -1;
    if c.pid > 0 {
        std::process::__kill_escalate(c.pid) or discard;
    }
    c.pid = -1;
    c.argv = "";
}

// Move a spawned handle into a Child the caller already owns —
// typically a locus's own `params` field, so the subprocess outlives
// the method that started it (GH #716). Surfaced as
// `std::process::adopt`.
//
//   locus Job {
//       params { child: std::process::Child = std::process::Child { }; }
//       fn start(argv: String) {
//           let s = std::process::spawn(argv) or std::process::Child { };
//           std::process::adopt(self.child, s);
//       }
//   }
//
// Why this exists rather than `self.child = std::process::spawn(…)`:
// a locus-typed field may only be assigned a locus LITERAL, because
// a store would leave the field pointing at an instance the
// producing frame also claims (GH #383, spec/semantics.md §
// "Reassigning a locus-typed field"). `adopt` is not a locus store —
// it transfers the handle's *state* into the instance the field
// already owns, so there is never a second owner to decide between.
//
// Exactly one owner, at every instant:
//
//   1. `dest`'s outgoing handle is released first (fds closed,
//      process TERM→KILL→reaped) while its descriptors are still
//      open and therefore still uniquely its own — the kernel cannot
//      have reissued those numbers to `src`, because they were not
//      free when `src` spawned. So a re-spawn into the same field
//      never closes the new child's pipes.
//   2. `src`'s pid + fds move into `dest`.
//   3. `src` is DISARMED: whenever its teardown runs — its owner's
//      dissolve, or never at all if it is a factory result (see "fd
//      cleanup and who runs it" above) — it sees the not-spawned
//      sentinels and releases nothing. This is the step the
//      hand-rolled workaround had to get right by hand, and the one
//      whose absence double-closes: without it, handing a handle
//      from one owner to another kills the process the second owner
//      just took on, as soon as the first is reclaimed.
//
// `adopt` terminates the handle `dest` was holding. A supervisor
// that wants the outgoing child's exit code calls
// `wait`/`try_wait` before adopting the replacement.
//
// Adopting an *empty* handle (`std::process::Child { }` — what the
// `or` disposition on a failed `spawn` hands back) is the documented
// way to leave the field empty: `dest` is released and left at the
// not-spawned sentinels, so a spawn failure never leaves a
// half-constructed handle behind.
//
// Infallible on purpose: the release is best-effort teardown (same
// reasoning as dissolve), so `adopt` needs no disposition and is
// callable straight from a locus method.
/// Move `src`'s pid + pipe fds into `dest` (a field you own),
/// releasing whatever `dest` held and disarming `src` — the
/// one-owner handoff for a long-lived subprocess.
fn __std_process_adopt(dest: std::process::Child, src: std::process::Child) {
    // Same handle already in place (including `adopt(x, x)`):
    // releasing would close live descriptors and then disarm the
    // only owner, stranding the process. Nothing to transfer.
    if dest.pid == src.pid {
        if dest.stdin_fd == src.stdin_fd {
            return;
        }
    }
    __std_process_release(dest);
    // argv is CLONED, not aliased: the field's copy must be owned by
    // the field (the single-owner rule for cells), not a pointer into
    // the arena `src` was built in. This is now load-bearing rather
    // than defensive — since GH #793 a factory-returned locus IS
    // reclaimed, so `src`'s arena goes at the end of the scope that
    // spawned it, and an aliased argv would be a read of freed
    // memory rather than a stale string.
    dest.argv = std::str::clone(src.argv);
    dest.pid = src.pid;
    dest.stdin_fd = src.stdin_fd;
    dest.stdout_fd = src.stdout_fd;
    dest.stderr_fd = src.stderr_fd;
    src.argv = "";
    src.pid = -1;
    src.stdin_fd = -1;
    src.stdout_fd = -1;
    src.stderr_fd = -1;
}

// Spawn a subprocess. Returns a fully-populated Child. Cleanup is
// the owner's: move the handle into a Child something reclaims with
// `std::process::adopt` — a factory result has no owner and its
// dissolve never runs. Surfaced as `std::process::spawn` via
// path-call dispatch in codegen.
//
// Errors:
//   - kind="not_found" if argv[0] isn't on $PATH (or fails ENOENT
//     for any other reason during exec).
//   - kind="permission_denied" if argv[0] exists but isn't
//     executable.
//   - kind="invalid" for malformed argv (empty, oversized).
/// Spawn argv with piped stdin/stdout/stderr; returns the
/// Child without waiting.
fn __std_process_spawn(argv: String) -> std::process::Child fallible(IoError) {
    let h = std::process::__spawn(argv) or raise;
    return std::process::Child {
        argv: argv,
        pid: h.pid,
        stdin_fd: h.stdin_fd,
        stdout_fd: h.stdout_fd,
        stderr_fd: h.stderr_fd,
    };
}

// Block until the child exits. Returns the exit code (0..255 for
// a normal exit, -1 if killed by a signal). Surfaced as
// `std::process::wait`.
//
// Errors:
//   - kind="not_found" if the pid is already gone (ECHILD) — e.g.,
//     `wait` was called twice, or the dissolve() race reaped first.
//
// `wait` against an unspawned Child (pid == -1) is treated as
// "already exited with code 0" rather than raising — users who
// construct a Child literal manually for testing get the
// expected shape without a panic-via-or-raise.
/// Block until the child exits; returns the exit code (-1 =
/// killed by signal). Reaps the pid.
fn __std_process_wait(c: std::process::Child) -> Int fallible(IoError) {
    if c.pid <= 0 {
        return 0;
    }
    let o = std::process::__wait_pid(c.pid) or raise;
    return o.code;
}

// SIGTERM → 100ms grace → SIGKILL → reap. Surfaced as
// `std::process::kill`. After this returns, the child is
// definitively gone and waitpid has been called.
// Errors:
//   - kind="not_found" if the pid is already gone (ESRCH/ECHILD).
//     This is usually benign — the goal of kill() is "this child
//     is no longer running", which is true if it was already
//     reaped. Callers wrap with `or discard` if they don't care.
/// TERM, grace, then KILL — the escalating stop. Returns the
/// exit code.
fn __std_process_kill(c: std::process::Child) -> () fallible(IoError) {
    if c.pid > 0 {
        std::process::__kill_escalate(c.pid) or raise;
    }
}

// Write a String to the child's stdin. Surfaced as
// `std::process::write_stdin`. Returns bytes written.
// The pipe is blocking (an SO_RCVBUF-sized backlog will pause
// the write); SIGPIPE is ignored process-wide so a write after
// the child closed its read end returns EPIPE via the IoError
// channel instead of killing the parent.
/// Write bytes to the child's stdin (close it by writing ""
/// after — EOF signals many tools to proceed).
fn __std_process_write_stdin(c: std::process::Child, s: String) -> Int fallible(IoError) {
    return std::process::__pipe_write(c.stdin_fd, s) or raise;
}

// Read available bytes from the child's stdout (non-blocking).
// Surfaced as `std::process::read_stdout`. Returns "" when no
// bytes are available OR the child has closed its stdout (EOF).
// Use `wait` to distinguish "process still running, no output
// yet" from "process exited".
/// Drain available stdout bytes (empty when the pipe is dry).
fn __std_process_read_stdout(c: std::process::Child) -> String fallible(IoError) {
    return std::process::__pipe_read(c.stdout_fd) or raise;
}

// Read available bytes from the child's stderr (non-blocking).
// Surfaced as `std::process::read_stderr`. Same shape as
// `read_stdout`.
/// Drain available stderr bytes.
fn __std_process_read_stderr(c: std::process::Child) -> String fallible(IoError) {
    return std::process::__pipe_read(c.stderr_fd) or raise;
}

// Non-blocking reap (2026-07-17 — closes the "daemons can't
// non-blocking-reap children" gap). Returns:
//   -2         → still running (nothing reaped; poll again later —
//                the same retryable sentinel shape as recv_into)
//   0..255     → exited normally with that code (reaped)
//   -1         → killed by a signal (reaped)
// Surfaced as `std::process::try_wait`. A supervisor's periodic
// tick polls this per child without ever parking its pool:
//
//   fn tick() {
//       let code = std::process::try_wait(self.child) or -2;
//       if code != -2 { self.on_exit(code); }
//   }
//
// Errors: kind="not_found" (ECHILD) when the child was already
// reaped — e.g. wait()/try_wait() already returned it, or the
// dissolve() race reaped first. Same manual-Child convention as
// `wait`: pid <= 0 answers "already exited, code 0".
/// Non-blocking reap (waitpid WNOHANG): -2 = still running
/// (poll again — the supervisor-tick idiom), 0..255 = exited,
/// -1 = killed by signal. ECHILD surfaces kind="not_found".
fn __std_process_try_wait(c: std::process::Child) -> Int fallible(IoError) {
    if c.pid <= 0 {
        return 0;
    }
    let o = std::process::__try_wait_pid(c.pid) or raise;
    return o.code;
}

// Send an arbitrary signal to the child (2026-07-17, promoted
// from pond/subprocess's Process.signal). Targets the pid, not
// the process group; the TERM→KILL escalation stays `kill`'s
// job. Signal numbers are the POSIX ones (15 = TERM, 9 = KILL,
// 1 = HUP, 10/12 = USR1/USR2...). Surfaced as
// `std::process::signal`.
//
// Errors: kind="not_found" (ESRCH) when the pid is gone —
// usually benign post-exit; wrap with `or discard` if you don't
// care. No-op on an unspawned Child (pid <= 0).
/// Send an arbitrary POSIX signal (15=TERM, 9=KILL, 1=HUP…).
/// ESRCH (already gone) surfaces kind="not_found" — usually
/// benign, `or discard`.
fn __std_process_signal(c: std::process::Child, sig: Int) -> () fallible(IoError) {
    if c.pid > 0 {
        std::process::__signal_pid(c.pid, sig) or raise;
    }
}
