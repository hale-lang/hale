// The `usage` object on executions, their attempts and handed Tasks reads
// the one projection over `model.called` rows (GH #946, slice 1). Native
// handler test over an owned Record: the facts are appended with their
// codecs, no body or model runs, and every response is checked against
// the contract.
import ".." as api;
import "../../core" as dna;
import "./fixture" as fixture;

const ROOT: String = "usage-close";
const STEP: String = "usage-close/wf7/s0";
const BANK: String = "usage-close/wf7/s0/bank";
const HUMAN: String = "usage-human";

locus UsageCases {
    params { f: fixture::Fixture; json: fixture::Json = fixture::Json { }; }
    fn called(attempt: String, backend: String, model: String, input: Int, output: Int, cost: Int) {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("adapter", "fake"); b.string_field("backend", backend); b.string_field("requested_model", model);
        b.int_field("input_tokens", input); b.int_field("output_tokens", output); b.int_field("cost_micros", cost);
        b.bool_field("ok", true); b.int_field("at", 1);
        b.end_object();
        self.f.append("model.called", attempt, b.result());
    }
    fn attempt(no: Int, request: dna::WorkRequest) {
        self.f.append("attempt.admitted", dna::attempt_id_of(BANK, no), dna::encode_attempt(dna::AdmittedAttempt { attempt_id: dna::attempt_id_of(BANK, no), work_id: BANK, step_id: STEP, task_id: ROOT, attempt_no: no, performer_kind: "agent", request: request }));
    }
    fn outcome(no: Int, disposition: String, text: String) {
        self.f.append("attempt.outcome", dna::attempt_id_of(BANK, no), dna::encode_attempt_outcome(dna::AttemptOutcome { attempt_id: dna::attempt_id_of(BANK, no), work_id: BANK, disposition: disposition, performer: "sample-agent", result: text, evidence_ref: "sha256:usage-evidence", narrative: "recorded" }));
    }
    fn response(service: api::Api, path: String, schema: String) -> String {
        let response = service.handle(std::http::Request { method: "GET", path: self.f.prefix + path });
        std::test::assert_eq_int(response.status, 200, response.body);
        let checked = self.f.validator.validate(schema, response.body);
        std::test::assert(checked.ok, checked.error + "\n" + response.body);
        return response.body;
    }
    fn counts(usage: String, calls: String, input: String, output: String, cost: String, what: String) {
        std::test::assert_eq_str(self.json.string(usage, "calls"), calls, what + ": calls in " + usage);
        std::test::assert_eq_str(self.json.string(usage, "input_tokens"), input, what + ": input tokens in " + usage);
        std::test::assert_eq_str(self.json.string(usage, "output_tokens"), output, what + ": output tokens in " + usage);
        std::test::assert_eq_str(self.json.string(usage, "cost_micros"), cost, what + ": cost in " + usage);
    }
    // The element of `items` whose `id` is `id`; "" when none is.
    fn item(items: String, id: String) -> String {
        let mut it = std::json::array_first(items);
        while !it.done {
            if self.json.string(it.element, "id") == id { return it.element; }
            it = std::json::array_next(it);
        }
        return "";
    }
    fn run_cases() {
        // an execution: one Work tried twice, the second attempt accepted;
        // the Leader's plan of the ask it was born of
        let cat = dna::WorkflowCatalog { };
        std::test::assert_eq_str(cat.define("monthly-close", 7, "record", "Close the month"), "", "definition");
        let bank = dna::WorkRequest { objective: "Reconcile bank feed", target: "org/finance", output_contract: "reconciliation" };
        std::test::assert_eq_str(cat.leaf("monthly-close", 7, 0, "bank", bank, 2), "", "bank member");
        let limits = dna::AdmissionLimits { };
        let bound = cat.expand(ROOT, "monthly-close", 7, limits);
        std::test::assert(bound.ok, "bound recipe: " + bound.why);
        self.f.append("task.born", ROOT, "usage-ask: monthly-close (workflow)");
        self.called("usage-ask/plan", "deep", "deep-1", 1000, 300, 50);
        self.f.append("workflow.admitted", ROOT, dna::encode_admission(dna::AdmittedWorkflow { task_id: ROOT, definition: "monthly-close", revision: 7, recipe: cat.encode_bound(), limits: limits, works: 1, tasks: 1, steps: 1, depth: 1 }));
        self.f.append("step.registered", STEP, dna::encode_members(dna::RegisteredMembers { step_id: STEP, task_id: ROOT, workflow_id: ROOT + "/wf7", step_index: 0, members: "bank:leaf:" + BANK }));
        self.f.append("step.activated", STEP, dna::encode_activation(dna::ActivatedStep { step_id: STEP, task_id: ROOT, workflow_id: ROOT + "/wf7", step_index: 0, dispatched: "bank" }));
        self.attempt(0, bank);
        self.called(dna::attempt_id_of(BANK, 0), "quick", "quick-1", 200, 40, 5);
        self.outcome(0, "failed", "An earlier incomplete reconciliation");
        self.attempt(1, bank);
        self.called(dna::attempt_id_of(BANK, 1), "quick", "quick-1", 220, 44, 5);
        self.called(dna::attempt_id_of(BANK, 1), "deep", "deep-1", 500, 60, 25);
        self.outcome(1, "done", "Reconciled");
        self.f.append("work.settled", BANK, dna::encode_work_outcome(dna::WorkOutcome { work_id: BANK, step_id: STEP, attempt_id: dna::attempt_id_of(BANK, 1), disposition: "done" }));
        // a handed Task, planned by the Leader
        self.f.append("task.born", HUMAN, "usage-ask-2: confirm the supplier's invoice");
        self.called("usage-ask-2/plan", "deep", "deep-1", 800, 100, 40);
        self.f.append("task.handed", HUMAN, "{\"assignee\": \"alex\", \"obligation\": \"review\", \"by\": \"planner\"}");

        let service = api::Api { root: self.f.root, local_name: "riley" };
        // the execution: the plan of its ask and every attempt of its Work
        let detail = self.response(service, "/dna/workflows?id=" + ROOT, "WorkflowsResponse");
        let execution = self.json.first(detail);
        let usage = self.json.raw(execution, "usage");
        self.counts(usage, "4", "1920", "444", "85", "the execution");
        let positions = self.json.raw(usage, "by_position");
        std::test::assert(std::str::contains(positions, "{\"position\": \"position:leader\", \"calls\": \"1\", \"input_tokens\": \"1000\", \"output_tokens\": \"300\", \"cost_micros\": \"50\"}"), "the Leader's plan, by position: " + positions);
        std::test::assert(std::str::contains(positions, "{\"position\": \"position:agent\", \"calls\": \"3\", \"input_tokens\": \"920\", \"output_tokens\": \"144\", \"cost_micros\": \"35\"}"), "the performer's attempts, by position: " + positions);
        let backends = self.json.raw(usage, "by_backend");
        std::test::assert(std::str::contains(backends, "{\"backend\": \"deep/deep-1\", \"calls\": \"2\", \"input_tokens\": \"1500\", \"output_tokens\": \"360\", \"cost_micros\": \"75\"}"), "by backend: " + backends);
        std::test::assert(std::str::contains(backends, "{\"backend\": \"quick/quick-1\", \"calls\": \"2\", \"input_tokens\": \"420\", \"output_tokens\": \"84\", \"cost_micros\": \"10\"}"), "by backend: " + backends);
        // each attempt: its own calls
        let attempts = self.json.raw(execution, "attempts");
        let first = self.item(attempts, dna::attempt_id_of(BANK, 0));
        std::test::assert(len(first) > 0, "the first attempt is listed: " + attempts);
        self.counts(self.json.raw(first, "usage"), "1", "200", "40", "5", "the first attempt");
        let second = self.item(attempts, dna::attempt_id_of(BANK, 1));
        std::test::assert(len(second) > 0, "the second attempt is listed: " + attempts);
        self.counts(self.json.raw(second, "usage"), "2", "720", "104", "30", "the second attempt");
        // the list carries the same object on its summaries
        let listing = self.response(service, "/dna/workflows", "WorkflowsResponse");
        let summary = self.item(self.json.items(listing), ROOT);
        std::test::assert(len(summary) > 0, "the execution is listed: " + listing);
        self.counts(self.json.raw(summary, "usage"), "4", "1920", "444", "85", "the summary");
        // the handed Task: the plan of the ask it was born of
        let tasks = self.response(service, "/dna/tasks?id=" + HUMAN, "TasksResponse");
        let task = self.json.first(tasks);
        self.json.eq(task, "assignee", "alex");
        let handed = self.json.raw(task, "usage");
        self.counts(handed, "1", "800", "100", "40", "the handed Task");
        std::test::assert(std::str::contains(self.json.raw(handed, "by_position"), "{\"position\": \"position:leader\""), "the Leader planned it: " + handed);
        eprintln("PASS usage on executions, attempts and handed Tasks");
    }
}

fn main() {
    let f = fixture::Fixture { root: "/tmp/hale-api-usage." + to_string(std::process::pid()) };
    let cases = UsageCases { f: f };
    cases.run_cases();
}
