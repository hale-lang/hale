// dna/api/project_service/tests/head_index_oidc_test.hl — the standard
// face's index under a sign-in.
//
// The head serves under OIDC (the stub issuer runs as its own process). The
// face's read of the record's index carries the visitor's own session: a
// visitor who is not signed in is refused as the head refuses every read
// (401), a forged session likewise, and the person signed in through the
// face reads the index, the record's purpose and codebase rendered.

import "./fixture" as fixture;
import "../../../core" as dna;
import "../../../operations" as ops;
import "../../../oidc" as oidc;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn source() -> String {
    let given = if std::env::var_exists("HALE_DNA_SOURCE") { std::env::var("HALE_DNA_SOURCE") } else { "." };
    return dna::trim_nl(dna::run_tool("sh\n-c\ncd \"$1\" && pwd\nsh\n" + given).stdout);
}

// The stub provider's program, built from a copy of its sources in the
// fixture's root: the checkout's own directory is never written.
fn stub_binary(root: String) -> String {
    let dir = root + "/oidc";
    let copied = dna::run_tool("sh\n-c\nmkdir -p \"$2/serve\" && cp \"$1/dna/oidc/stub.hl\" \"$2/\" && cp \"$1/dna/oidc/serve/main.hl\" \"$2/serve/\"\nsh\n" + source() + "\n" + dir);
    std::test::assert_eq_int(copied.code, 0, "the stub's sources copied: " + copied.stderr);
    let built = dna::run_tool(toolchain() + "\nbuild\n" + dir + "/serve");
    std::test::assert_eq_int(built.code, 0, "the stub provider builds: " + built.stdout + built.stderr);
    return dir + "/serve/serve";
}

fn main() {
    let root = dna::scratch_root("head-index-oidc");
    let secret = dna::hex(std::os::getrandom(16) or b"");
    std::io::fs::mkdir(root + "/vault") or discard;
    let client_secret = dna::hex(std::os::getrandom(16) or b"");
    std::io::fs::write_file(root + "/vault/oidc-client-dna-local", client_secret) or discard;
    std::io::fs::write_file(root + "/stub.pem", oidc::STUB_KEY) or discard;
    let chmod = dna::run_tool("chmod\n0600\n" + root + "/stub.pem");
    let port = dna::free_port(9);
    let issuer = "http://127.0.0.1:" + to_string(port);
    let stub_argv = "env\n-u\nHALE_VAULT_ADDR\nHALE_VAULT_DIR=" + root + "/vault\nHALE_DNA_OIDC_KEY_FILE=" + root + "/stub.pem\nHALE_DNA_OIDC_KEY_X=" + oidc::STUB_X + "\nHALE_DNA_OIDC_KEY_Y=" + oidc::STUB_Y + "\n" + stub_binary(root) + "\n" + to_string(port) + "\ndna-local";
    let stub = std::process::spawn(stub_argv) or std::process::Child { };
    std::test::assert(stub.pid > 0, "the stub provider spawned");
    let watched = dna::run_tool("sh\n-c\n(while kill -0 \"$1\" 2>/dev/null; do sleep 1; done; kill \"$2\" 2>/dev/null) </dev/null >/dev/null 2>&1 &\nsh\n" + to_string(std::process::pid()) + "\n" + to_string(stub.pid));
    let mut waited = 0;
    while waited < 100 && dna::run_tool("curl\n-s\n-f\n-o\n/dev/null\n" + issuer + "/.well-known/openid-configuration").code != 0 { std::time::sleep(100ms); waited = waited + 1; }

    std::io::fs::mkdir(root + "/head") or discard;
    let f = fixture::HeadFixture { root: root + "/head", face_port: dna::free_port(11), oidc_env: "HALE_DNA_OIDC_ISSUER=" + issuer + "\nHALE_DNA_OIDC_CLIENT=dna-local\nHALE_DNA_OIDC_MEMBER=local-sub=tester\nHALE_DNA_OIDC_KEY=" + oidc::STUB_SPKI };
    std::io::fs::mkdir(f.home + "/vault") or discard;
    std::io::fs::write_file(f.home + "/vault/oidc-client-dna-local", client_secret) or discard;
    // the record: a purpose and a codebase, and tester (whom local-sub signs in as) holding a position
    let j = f.journal;
    let purpose = j.append(j.revision(), "graph.node", "purpose:shop", ops::graph_node_body("purpose", "shop", "Keep the shop honest.", ""));
    let c = dna::Codebase { present: true, name: "billing", repo: "/srv/git/billing.git", build: "go build ./...", test: "go test ./...", branch: "trunk", by: "tester", toolchain: "go" };
    let attached = j.append(j.revision(), "codebase.attached", "codebase:billing", dna::codebase_body(c));
    let node = j.append(j.revision(), "graph.node", "position:agent", ops::graph_node_body("position", "agent", "acts for the shop", ""));
    let seat = j.append(j.revision(), "graph.edge", "holds:position:agent|tester", "{\"kind\":\"holds\",\"members\":[{\"role\":\"position\",\"node\":\"position:agent\"},{\"role\":\"holder\",\"node\":\"tester\"}]}");
    std::test::assert(purpose.ok && attached.ok && node.ok && seat.ok, "the record's rows landed");
    f.start_with_project(f.project, 0);
    f.start_face();
    let face = f.face_url();

    // not signed in: the head's refusal, and nothing of the record
    let bare = fixture::curl("GET", face + "/index", "", "");
    std::test::assert(bare.status == 401 && !std::str::contains(bare.body, "Keep the shop honest."), "not signed in, the head's refusal: " + bare.body);
    let forged = fixture::curl("GET", face + "/index", "Cookie: dna_session=forged", "");
    std::test::assert(forged.status == 401 && !std::str::contains(forged.body, "Keep the shop honest."), "a forged session is refused: " + forged.body);

    // signed in through the face: the person's own session reads the index
    let jar = root + "/jar";
    let signin = dna::run_tool("curl\n-s\n-L\n-c\n" + jar + "\n-b\n" + jar + "\n-o\n/dev/null\n-w\n%{http_code}\n" + face + "/?token=" + f.token());
    let cookies = std::io::fs::read_file(jar) or "";
    std::test::assert(std::str::contains(cookies, "dna_session"), "the person signs in through the face: " + signin.stdout + " " + cookies);
    let mut page = "";
    let deadline = std::time::now() + dna::wait_secs(60);
    while std::time::now() <= deadline && !std::str::contains(page, "Parts and positions") {
        page = dna::run_tool("curl\n-s\n-b\n" + jar + "\n" + face + "/index").stdout;
        if !std::str::contains(page, "Parts and positions") { std::time::sleep(250ms); }
    }
    std::test::assert(std::str::contains(page, "Parts and positions"), "signed in, the index renders: " + page + (std::io::fs::read_file(root + "/head/face.log") or "") + f.log());
    std::test::assert(std::str::contains(page, "Keep the shop honest.") && std::str::contains(page, "<code>billing</code>") && std::str::contains(page, "<code>agent</code>") && std::str::contains(page, "<td>tester</td>"), "with the record's purpose, codebase and position: " + page);

    f.stop();
    std::process::kill(stub) or discard;
    dna::scratch_done(root);
}
