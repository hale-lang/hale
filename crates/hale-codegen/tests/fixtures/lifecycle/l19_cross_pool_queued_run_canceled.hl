// Decision line 19, a run queued on one pool for a child torn down on
// another (RunAdmission, Run, Cancellation).
//
// Holder and Kid finish their worker initialization before Kid's birth(),
// on pool side's worker (line 3), asks Holder to occupy that worker: the
// handler's cell is queued ahead of Kid's run, which the instantiating
// thread posts once the birth returns. Holder's handler waits for a gate
// file. App replaces Kid on main, canceling the old run before reclaiming
// its arena, then opens the gate. The worker drops the canceled cell
// without touching the reclaimed struct. (While birth() ran on main, it
// waited for the handler to start; on the worker it cannot, and needs
// not: the queue orders the two.)
//
// Expected terminal outcome: tag 0's run never starts and is named not
// started with an acknowledgement on main, tag 1's runs, and both
// children dissolve once: `named:not-started`.

fn gate() -> String {
    return "/tmp/hale-l19-cross-pool-" + to_string(std::process::pid());
}

type HoldMsg { n: Int; }
topic Hold { payload: HoldMsg; subject: "lifecycle.l19.cross-pool.hold"; }

locus Holder {
    bus { subscribe Hold as hold; }
    fn hold(msg: HoldMsg) {
        std::io::fs::write_file(gate() + ".ready", "ready") or discard;
        while !std::io::fs::file_exists(gate()) {
            std::time::sleep(1ms);
        }
    }
}

locus Kid {
    params { tag: Int = 0; }
    bus { publish Hold; }
    birth() {
        if self.tag == 0 {
            Hold <- HoldMsg { n: 0 };
        }
    }
    run() { println("ev kid-run " + to_string(self.tag)); }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag)); }
}

main locus App {
    params {
        holder: Holder = Holder { };
        k: Kid = Kid { tag: 0 };
    }
    placement { holder: cooperative(pool = side); k: cooperative(pool = side); }
    run() {
        self.k = Kid { tag: 1 };
        std::io::fs::write_file(gate(), "go") or discard;
    }
    dissolve() {
        std::io::fs::unlink(gate()) or discard;
        std::io::fs::unlink(gate() + ".ready") or discard;
    }
}

fn main() { App { }; }
