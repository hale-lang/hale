// Native integration fixtures. The Record and receipts use their real writers;
// only the event sequence is synthetic. No body, database or model is started.
import "../../../core" as dna;
import "../../contract/v1/validator" as wire_contract;

const APPLICATIONS: String = "/api/hale/v1/applications";
const SHELL_KNOWLEDGE_DRAFT_JS: String = "window.fixtureKnowledgeDraft = true;";
const SHELL_TASK_ADMINISTRATION_JS: String = "window.fixtureTaskAdministration = true;";
const SHELL_PROJECTS_JS: String = "window.IrisProjects = Object.freeze({ fixture: true });";
const SHELL_TASK_CREATE_JS: String = "window.fixtureTaskCreate = true;";
const SHELL_ORGANIZATION_DRAFT_JS: String = "window.fixtureOrganizationDraft = true;";
const SHELL_HTML: String = "<!doctype html><html><head><link rel=\"stylesheet\" href=\"/styles.css\"></head><body><main>Static Iris fixture</main><script src=\"/application.js\" defer></script><script src=\"/definition-draft.js\" defer></script><script src=\"/app.js\" defer></script></body></html>";
const SHELL_JS: String = "document.querySelector('main').dataset.ready = 'yes';";
const SHELL_APPLICATION_JS: String = "window.IrisApplication = Object.freeze({ fixture: true });";
const SHELL_DEFINITION_DRAFT_JS: String = "window.IrisDefinitionDraft = Object.freeze({ fixture: true });";
const SHELL_CSS: String = "main { color: navy; }";

type HttpResponse { status: Int = 0; headers: String = ""; body: String = ""; }
type Practice { digest: String = ""; review_id: String = ""; name: String = ""; text: String = ""; target: String = ""; question: String = ""; }

locus Json {
    params { }
    fn raw(value: String, field: String) -> String { return std::json::find_field_raw(value, field); }
    fn string(value: String, field: String) -> String { return std::json::find_string_field(value, field); }
    fn integer(value: String, field: String) -> Int { return std::json::find_int_field(value, field); }
    fn boolean(value: String, field: String) -> Bool { return self.raw(value, field) == "true"; }
    fn data(value: String) -> String { return self.raw(value, "data"); }
    fn page(value: String) -> String { return self.raw(self.data(value), "page"); }
    fn items(value: String) -> String { return self.raw(self.data(value), "items"); }
    fn first(value: String) -> String {
        let it = std::json::array_first(self.items(value));
        std::test::assert(!it.done, "a collection item: " + value);
        return it.element;
    }
    fn count(value: String) -> Int {
        let mut it = std::json::array_first(self.items(value));
        let mut n = 0;
        while !it.done { n = n + 1; it = std::json::array_next(it); }
        return n;
    }
    fn eq(value: String, field: String, expected: String) {
        std::test::assert_eq_str(self.string(value, field), expected, field + ": " + value);
    }
    fn is_int(value: String, field: String, expected: Int) {
        std::test::assert_eq_int(self.integer(value, field), expected, field + ": " + value);
    }
    fn is_bool(value: String, field: String, expected: Bool) {
        std::test::assert(self.boolean(value, field) == expected, field + ": " + value);
    }
}

// Bind-probe alternate PID-derived candidates and release the selected port.
// The service must then prove its own successful startup before tests use it.
fn free_port(salt: Int) -> Int {
    let mut i = 0;
    while i < 256 {
        let port = 30000 + (std::process::pid() + salt + i) % 25000;
        let fd = std::io::tcp::__listen_socket("127.0.0.1", port);
        if fd >= 0 { std::io::tcp::__close_fd(fd); return port; }
        i = i + 1;
    }
    std::test::assert(false, "could not reserve a local fixture port");
    return 0;
}

fn curl(method: String, url: String, cookie: String, body: String) -> HttpResponse {
    let mut argv = "curl\n-q\n--noproxy\n*\n--silent\n--show-error\n--max-time\n5\n--include\n--path-as-is\n--request\n" + method;
    if len(cookie) > 0 { argv = argv + "\n--header\nCookie: " + cookie; }
    if len(body) > 0 { argv = argv + "\n--header\nContent-Type: application/json\n--data\n" + body; }
    let result = dna::run_tool(argv + "\n" + url);
    let split = std::str::index_of(result.stdout, "\r\n\r\n");
    if split < 0 { return HttpResponse { body: result.stderr }; }
    let headers = result.stdout[0..split];
    let space = std::str::index_of(headers, " ");
    let status = if space < 0 || len(headers) < space + 4 { 0 } else { std::str::parse_int(headers[(space + 1)..(space + 4)]) or 0 };
    return HttpResponse { status: status, headers: headers, body: result.stdout[(split + 4)..len(result.stdout)] };
}

fn cookie(response: HttpResponse) -> String {
    let raw = dna::response_header(response.headers, "Set-Cookie");
    let semi = std::str::index_of(raw, ";");
    return if semi < 0 { raw } else { raw[0..semi] };
}

locus Fixture {
    params {
        root: String = "";
        port: Int = 0;
        identity: String = "";
        prefix: String = "";
        oidc: Bool = false;
        web_requested: Bool = false;
        webroot: String = "";
        api: std::process::Child = std::process::Child { };
        journal: dna::GitJournal = dna::GitJournal { repo: "/nonexistent/hale-api-fixture" };
        receipts: dna::GitReceipts = dna::GitReceipts { repo: "/nonexistent/hale-api-fixture" };
        json: Json = Json { };
        validator: wire_contract::Validator = wire_contract::Validator { root: std::env::var("HALE_API_CONTRACT_ROOT") };
    }
    birth() {
        std::test::assert(len(self.root) > 10 && std::str::starts_with(self.root, "/tmp/"), "owned fixture root required");
        std::io::fs::mkdir(self.root) or discard;
        self.git("init\n-q\n-b\nmain");
        self.git("config\nuser.name\napi-fixture");
        self.git("config\nuser.email\napi-fixture@example.invalid");
        self.git("config\ncommit.gpgsign\nfalse");
        self.git("config\ngc.auto\n0");
        self.journal = dna::GitJournal { repo: self.root };
        self.receipts = dna::GitReceipts { repo: self.root };
        self.append("org.born", "org", "read-only API fixture " + self.root);
        let record = dna::GitRecord { repo: self.root };
        self.identity = record.identity();
        self.prefix = APPLICATIONS + "/" + self.identity;
        if self.port == 0 { self.port = free_port(37); }
    }
    dissolve() {
        self.stop();
        if len(self.root) > 10 && std::str::starts_with(self.root, "/tmp/") { let removed = dna::run_tool("rm\n-rf\n" + self.root); }
    }
    fn git(argv: String) -> String {
        let result = dna::run_tool("env\nGIT_CONFIG_NOSYSTEM=1\nGIT_CONFIG_GLOBAL=/dev/null\nGIT_TERMINAL_PROMPT=0\ngit\n-C\n" + self.root + "\n" + argv);
        std::test::assert_eq_int(result.code, 0, "git " + argv + ": " + result.stderr);
        return dna::trim_nl(result.stdout);
    }
    fn append(kind: String, entity: String, body: String) {
        let refreshed = self.journal.refresh();
        let result = self.journal.append(self.journal.revision(), kind, entity, body);
        std::test::assert(result.ok, "fixture append " + kind + ": " + result.error);
    }
    fn refs() -> String { return self.git("show-ref"); }
    fn url() -> String { return "http://127.0.0.1:" + to_string(self.port); }
    fn log() -> String { return std::io::fs::read_file(self.root + "/api.log") or ""; }
    fn prepare_web() {
        self.web_requested = true;
        self.webroot = self.root + "/web";
        std::io::fs::mkdir(self.webroot) or discard;
        std::io::fs::write_file(self.webroot + "/index.html", SHELL_HTML) or discard;
        std::io::fs::write_file(self.webroot + "/app.js", SHELL_JS) or discard;
        std::io::fs::write_file(self.webroot + "/application.js", SHELL_APPLICATION_JS) or discard;
        std::io::fs::write_file(self.webroot + "/definition-draft.js", SHELL_DEFINITION_DRAFT_JS) or discard;
        std::io::fs::write_file(self.webroot + "/organization-draft.js", SHELL_ORGANIZATION_DRAFT_JS) or discard;
        std::io::fs::write_file(self.webroot + "/knowledge-draft.js", SHELL_KNOWLEDGE_DRAFT_JS) or discard;
        std::io::fs::write_file(self.webroot + "/task-administration.js", SHELL_TASK_ADMINISTRATION_JS) or discard;
        std::io::fs::write_file(self.webroot + "/projects.js", SHELL_PROJECTS_JS) or discard;
        std::io::fs::write_file(self.webroot + "/task-create.js", SHELL_TASK_CREATE_JS) or discard;
        std::io::fs::write_file(self.webroot + "/styles.css", SHELL_CSS) or discard;
    }
    fn spawn() {
        let binary = std::env::var("HALE_API_BIN");
        std::test::assert(len(binary) > 0 && std::io::fs::file_exists(binary), "build dna/api and set absolute HALE_API_BIN");
        let argv = "sh\n-c\ncd \"$1\" && unset HALE_DNA_KNOWLEDGE_DSN HALE_DNA_KNOWLEDGE_URL HALE_DNA_EVIDENCE_KEY && export HALE_DNA_DISCOVER=off GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 HALE_DNA_OIDC_SECRET=fake-secret && if [ \"$4\" = web ]; then exec \"$2\" \"$1\" \"$3\" \"${5#webroot=}\" >\"$1/api.log\" 2>&1; else exec \"$2\" \"$1\" \"$3\" >\"$1/api.log\" 2>&1; fi\nsh\n" + self.root + "\n" + binary + "\n" + to_string(self.port) + "\n" + (if self.web_requested { "web" } else { "api" }) + "\nwebroot=" + self.webroot;
        let child = std::process::spawn(argv) or std::process::Child { };
        // Child is structural: transfer its OS handles into a newly constructed
        // field, then disarm the short-lived wrapper before its dissolve.
        self.api = std::process::Child { argv: argv, pid: child.pid, stdin_fd: child.stdin_fd, stdout_fd: child.stdout_fd, stderr_fd: child.stderr_fd };
        child.pid = -1; child.stdin_fd = -1; child.stdout_fd = -1; child.stderr_fd = -1;
        std::test::assert(self.api.pid > 0, "API process spawned");
    }
    fn startup_refused(message: String) {
        self.spawn();
        let deadline = std::time::now() + 10;
        let mut code = -2;
        while code == -2 && std::time::now() < deadline {
            code = std::process::try_wait(self.api) or - 1;
            if code == -2 { std::time::sleep(25ms); }
        }
        std::test::assert(code != -2 && code != 0, "invalid configuration fails startup: " + self.log());
        self.api.pid = -1;
        std::test::assert(std::str::contains(self.log(), message), "startup diagnostic: " + self.log());
    }
    fn start() {
        self.spawn();
        let deadline = std::time::now() + 20;
        while std::time::now() < deadline {
            let state = std::process::try_wait(self.api) or - 1;
            std::test::assert_eq_int(state, -2, "API exited before listening: " + self.log());
            let response = self.http("GET", APPLICATIONS, "", "");
            if response.status > 0 {
                let still_running = std::process::try_wait(self.api) or - 1;
                std::test::assert_eq_int(still_running, -2, "the owned API is still running");
                if self.oidc { self.validate(response, "ErrorResponse", 401); }
                else {
                    let payload = self.validate(response, "ApplicationsResponse", 200);
                    self.json.eq(self.json.raw(payload, "source"), "record_id", self.identity);
                }
                return;
            }
            std::time::sleep(25ms);
        }
        std::test::assert(false, "API did not become reachable: " + self.log());
    }
    fn stop() {
        std::process::kill(self.api) or discard;
        self.api.pid = -1;
        std::io::tcp::__close_fd(self.api.stdin_fd); self.api.stdin_fd = -1;
        std::io::tcp::__close_fd(self.api.stdout_fd); self.api.stdout_fd = -1;
        std::io::tcp::__close_fd(self.api.stderr_fd); self.api.stderr_fd = -1;
    }
    fn http(method: String, path: String, cookie_value: String, body: String) -> HttpResponse {
        return curl(method, self.url() + path, cookie_value, body);
    }
    fn validate(response: HttpResponse, schema: String, status: Int) -> String {
        std::test::assert_eq_int(response.status, status, response.body);
        std::test::assert(std::str::contains(dna::response_header(response.headers, "Content-Type"), "application/json"), "JSON response content type");
        let result = self.validator.validate(schema, response.body);
        std::test::assert(result.ok, schema + ": " + result.error + "\n" + response.body);
        return response.body;
    }
    fn source(payload: String) {
        let s = self.json.raw(payload, "source");
        self.json.eq(s, "record_id", self.identity);
        self.json.eq(s, "record_head", self.journal.head());
        self.json.eq(s, "record_revision", to_string(self.journal.revision()));
    }
    fn read(resource: String, query: String, cookie_value: String) -> String {
        let path = self.prefix + "/dna/" + resource + (if len(query) > 0 { "?" + query } else { "" });
        return self.validate(self.http("GET", path, cookie_value, ""), if resource == "practices" { "PracticesResponse" } else { "ReviewsResponse" }, 200);
    }
    fn item(resource: String, id: String) -> String {
        let payload = self.read(resource, "id=" + dna::url_encode(id), "");
        self.json.is_int(self.json.page(payload), "total", 1);
        std::test::assert_eq_int(self.json.count(payload), 1, "one item");
        return self.json.first(payload);
    }
    fn error(method: String, path: String, status: Int, cookie_value: String, body: String) {
        let payload = self.validate(self.http(method, path, cookie_value, body), "ErrorResponse", status);
        std::test::assert(len(self.json.string(self.json.raw(payload, "error"), "code")) > 0, "typed error code");
    }
    fn receipt(text: String) -> String { return "sha256:" + self.receipts.store(text); }
    // Canonical receipts and Record rows exercise the real knowledge tail.
    // Relationship state is composed separately into the native graph store.
    fn knowledge(name: String, text: String, target: String, supersedes: String, ratified: Bool) -> String {
        let idea = dna::Idea { kind: "goal", name: name, text: text, author: "org", provenance: "proposed", supersedes: supersedes };
        let digest = self.receipt(dna::knowledge_document(idea, target));
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("digest", digest);
        b.string_field("author", idea.author);
        b.string_field("target", target);
        b.string_field("class", dna::classify_binding(idea.author, target));
        b.end_object();
        self.append(if ratified { "knowledge.ratified" } else { "knowledge.proposed" }, digest, b.result());
        return digest;
    }
    fn blob(digest: String) -> String { return self.git("cat-file\n-p\nrefs/dna/receipts/" + digest[7..len(digest)]); }
    fn practice(name: String, text: String, target: String, review: String, design: Bool) -> Practice {
        let b = std::json::Builder { };
        let idea = dna::Idea { kind: "practice", name: name, text: text, author: "org", provenance: "proposed" };
        let document = if design { "{\"author\":\"org\",\"kind\":\"practice\",\"name\":" + b.quote(name) + ",\"provenance\":\"design\",\"target\":" + b.quote(target) + ",\"text\":" + b.quote(text) + ",\"toolchain\":\"0.20.0\"}" } else { dna::knowledge_document(idea, target) };
        let digest = self.receipt(document);
        let review_id = if len(review) > 0 { review } else { dna::knowledge_review_id(digest) };
        self.append("knowledge.proposed", digest, "{\"digest\":" + b.quote(digest) + ",\"review_id\":" + b.quote(review_id) + ",\"kind\":\"practice\",\"author\":\"org\",\"target\":" + b.quote(target) + ",\"class\":\"goal\",\"name\":" + b.quote(name) + "}");
        let question = "Ratify " + name + ": " + text + "\nFor " + target + " — exact candidate";
        self.review(review_id, question, digest, digest);
        self.append("practice.proposed", "request/α/1", "{\"name\":" + b.quote(name) + ",\"digest\":" + b.quote(digest) + ",\"review_id\":" + b.quote(review_id) + ",\"by\":\"alice\",\"because\":\"Two lines\\nexplain why / pourquoi\"}");
        return Practice { digest: digest, review_id: review_id, name: name, text: text, target: target, question: question };
    }
    fn standard() -> Practice { return self.practice("acceptance/résumé", "Première ligne — ✓\n第二行 / preserve", "org/support/équipe", "", false); }
    fn review(id: String, question: String, subject: String, knowledge: String) {
        let b = std::json::Builder { };
        self.append("review.requested", "review:" + id, "{\"question\":" + b.quote(question) + ",\"subject_digest\":" + b.quote(subject) + ",\"required_authority\":\"board\",\"author\":\"org\"" + (if len(knowledge) > 0 { ",\"knowledge_digest\":" + b.quote(knowledge) } else { "" }) + "}");
    }
    fn hidden(p: Practice, status: String) {
        let item = self.item("practices", p.digest);
        self.json.is_bool(item, "text_available", false);
        self.json.eq(item, "text_status", status);
        self.json.eq(item, "text", "");
        self.json.eq(item, "rationale", "");
        let review = self.item("reviews", p.review_id);
        self.json.is_bool(review, "text_available", false);
        self.json.eq(review, "question", "");
        std::test::assert(!std::str::contains(self.read("practices", "", ""), p.text), "practice canary absent");
        std::test::assert(!std::str::contains(self.read("reviews", "", ""), p.text), "review canary absent");
    }
    fn uncertain_item(resource: String, id: String, canary: String, invalid: Bool) -> String {
        let response = self.http("GET", self.prefix + "/dna/" + resource + "?id=" + dna::url_encode(id), "", "");
        std::test::assert(!std::str::contains(response.body, canary) && !std::str::contains(response.body, "VISIBILITY-DECIDER-CANARY"), "uncertain text suppressed: " + response.body);
        if response.status == 503 { self.validate(response, "ErrorResponse", 503); return ""; }
        let payload = self.validate(response, if resource == "practices" { "PracticesResponse" } else { "ReviewsResponse" }, 200);
        self.json.is_int(self.json.page(payload), "total", 1);
        std::test::assert_eq_int(self.json.count(payload), 1, "one uncertain item");
        let item = self.json.first(payload);
        self.json.is_bool(item, "text_available", false);
        let status = self.json.string(item, "text_status");
        std::test::assert(status == "source_unavailable" || status == "protected" || (invalid && (status == "invalid_document" || status == "redacted")), "uncertain text status: " + item);
        return item;
    }
    fn uncertain(p: Practice) {
        let item = self.uncertain_item("practices", p.digest, p.text, false);
        if len(item) > 0 {
            self.json.eq(item, "text", ""); self.json.eq(item, "rationale", "");
            self.json.eq(item, "review_settled", ""); self.json.eq(item, "review_outcome", "approve");
        }
        let review = self.uncertain_item("reviews", p.review_id, p.text, false);
        if len(review) > 0 { self.json.eq(review, "question", ""); self.json.eq(review, "settled", ""); self.json.eq(review, "outcome", "approve"); }
    }
    fn configure_oidc(issuer: String) {
        self.oidc = true;
        self.git("config\ndna.principal\noidc"); self.git("config\ndna.oidc.issuer\n" + issuer);
        self.git("config\ndna.oidc.client\ndna-api-tests");
        self.git("config\ndna.oidc.redirect\n" + self.url() + "/auth/callback");
        self.git("config\ndna.oidc.member\nalice-sub=alice"); self.git("config\ndna.oidc.board\nalice");
        self.start();
    }
    fn sign_in(hint: String) -> HttpResponse {
        let login = self.http("GET", "/auth/login", "", "");
        std::test::assert_eq_int(login.status, 302, login.body);
        let authorize = dna::response_header(login.headers, "Location") + (if len(hint) > 0 { "&login_hint=" + dna::url_encode(hint) } else { "" });
        let allowed = curl("GET", authorize, "", "");
        std::test::assert_eq_int(allowed.status, 302, allowed.body);
        return curl("GET", dna::response_header(allowed.headers, "Location"), cookie(login), "");
    }
}

// The assertion primitive exits the process, bypassing normal locus dissolve.
// This bounded-scope watcher is therefore the failure-path backstop: its own
// argv names only root, while children name root + "/<case>".
fn reap_and_remove_on_exit(root: String) {
    std::test::assert(std::str::starts_with(root, "/tmp/hale-dna-api-native."), "owned suite root for exit cleanup");
    let started = dna::run_tool("sh\n-c\n(while kill -0 \"$1\" 2>/dev/null; do sleep 1; done; ps -eo pid=,args= | awk -v d=\"$2/\" 'index($0, d) {print $1}' | xargs -r kill -KILL 2>/dev/null; rm -rf -- \"$2\") </dev/null >/dev/null 2>&1 &\nsh\n" + to_string(std::process::pid()) + "\n" + root);
    std::test::assert_eq_int(started.code, 0, "fixture exit cleanup watcher");
}
