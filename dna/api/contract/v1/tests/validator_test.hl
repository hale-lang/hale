import "../validator" as wire_contract;

locus Cases {
    params { root: String; schema: String; fixtures: String; }
    fn expect(name: String, json: String, valid: Bool, note: String) {
        let validator = wire_contract::Validator { root: self.root };
        let result = validator.validate_schema(self.schema, name, json);
        std::test::assert(result.ok == valid, note + ": " + result.error);
        if !valid { std::test::assert(len(result.error) > 0, note + ": rejection must explain failure"); }
    }
    fn custom(spec: String, json: String, valid: Bool, note: String) {
        let validator = wire_contract::Validator { root: self.root };
        let result = validator.validate_schema("{\"$defs\":{\"Case\":" + spec + "}}", "Case", json);
        std::test::assert(result.ok == valid, note + ": " + result.error);
    }
    fn unsupported(schema: String, note: String) {
        let validator = wire_contract::Validator { root: self.root };
        let result = validator.schema_profile(schema);
        std::test::assert(!result.ok && len(result.error) > 0, note);
    }
    fn example(name: String) -> String {
        let mut items = std::json::array_first(self.fixtures);
        while !items.done {
            if std::json::find_string_field(items.element, "name") == name { return std::json::find_field_raw(items.element, "value"); }
            items = std::json::array_next(items);
        }
        std::test::assert(false, "missing fixture " + name);
        return "";
    }
    fn field(json: String, name: String, raw: String) -> String {
        // Empty raw omits the property; otherwise replace/add exactly one key.
        let builder = std::json::Builder { };
        builder.begin_object();
        let mut fields = std::json::object_first(json);
        while !fields.done {
            let key = std::json::obj_key_string(fields, json);
            if key != name { builder.field(key, std::json::obj_value_raw(fields, json)); }
            fields = std::json::object_next(fields, json);
        }
        if len(raw) > 0 { builder.field(name, raw); }
        builder.end_object();
        return builder.result();
    }
    fn first(json: String) -> String {
        let data = std::json::find_field_raw(json, "data");
        let items = std::json::array_first(std::json::find_field_raw(data, "items"));
        std::test::assert(!items.done, "fixture contains an item");
        return items.element;
    }
    fn wire_cases() {
        let application = self.example("application-discovery");
        let source = std::json::find_field_raw(application, "source");
        self.expect("Source", source, true, "source baseline");
        self.expect("Source", self.field(source, "record_id", ""), false, "missing required identity");
        self.expect("Source", self.field(source, "record_id", "\"\""), false, "empty identity");
        self.expect("Source", self.field(source, "record_revision", "\"00\""), false, "leading zero revision");
        self.expect("Source", self.field(source, "record_revision", "\"+1\""), false, "signed revision");
        self.expect("Source", self.field(source, "record_revision", "\"1e3\""), false, "exponent revision");
        self.expect("Source", self.field(source, "record_revision", "\"999999999999999999999999999999\""), true, "decimal revision has no machine integer truncation");
        self.expect("Source", self.field(source, "record_revision", "123"), false, "revision must remain a string");
        let page = std::json::find_field_raw(std::json::find_field_raw(application, "data"), "page");
        self.expect("Page", self.field(page, "limit", "0"), false, "positive limit");
        self.expect("Page", self.field(page, "limit", "101"), false, "bounded limit");
        self.expect("Page", self.field(page, "offset", "1000001"), false, "bounded offset");
        self.expect("Page", self.field(page, "next_offset", "-2"), false, "next offset lower bound");
        self.expect("Page", self.field(page, "total", "true"), false, "bool is not integer");
        self.expect("Page", self.field(page, "limit", "1.0"), false, "wire integers use integer tokens");
        self.expect("Page", self.field(page, "limit", "1e0"), false, "wire integers disallow exponent tokens");
        self.expect("Page", self.field(page, "limit", "999999999999999999999999999999"), false, "bounds do not overflow");
        self.expect("Page", self.field(page, "total", "-999999999999999999999999999999"), false, "negative bound does not overflow");
        self.expect("Page", self.field(page, "total", "999999999999999999999999999999"), true, "unbounded integer comparison is exact");
        self.expect("Page", self.field(page, "actor", "\"spoof\""), false, "nested unknown field");
        let practice = self.first(self.example("approved-is-not-ratified"));
        self.expect("Practice", self.field(practice, "state", "\"active\""), false, "unknown practice state");
        self.expect("Practice", self.field(practice, "ratified", "1"), false, "integer is not bool");
        self.expect("Practice", self.field(practice, "text_status", "\"available\\u0000\""), false, "NUL cannot truncate enum");
        self.expect("Practice", self.field(practice, "text_available", "false"), false, "hidden practice body is forbidden");
        let mut hidden = self.field(practice, "text_available", "false");
        hidden = self.field(hidden, "text", "\"\"");
        hidden = self.field(hidden, "rationale", "\"\"");
        hidden = self.field(hidden, "review_settled", "\"\"");
        hidden = self.field(hidden, "text_status", "\"source_unavailable\"");
        self.expect("Practice", hidden, true, "hidden practice retains state and typed outcome");
        self.expect("Practice", self.field(hidden, "text", "\"leak\""), false, "hidden body leak");
        self.expect("Practice", self.field(hidden, "rationale", "\"leak\""), false, "hidden rationale leak");
        self.expect("Practice", self.field(hidden, "review_settled", "\"approve leak\""), false, "hidden settlement leak");
        let review = self.first(self.example("review-settlement"));
        let mut protected = self.field(review, "text_status", "\"protected\"");
        protected = self.field(protected, "text_available", "false");
        protected = self.field(protected, "question", "\"\"");
        protected = self.field(protected, "settled", "\"\"");
        self.expect("Review", protected, true, "protected review");
        self.expect("Review", self.field(protected, "question", "\"leak\""), false, "hidden review question leak");
        self.expect("Review", self.field(protected, "settled", "\"approve leak\""), false, "hidden review settlement leak");
        self.expect("Review", self.field(protected, "text_available", "true"), false, "hidden review availability");
        self.expect("Review", self.field(protected, "outcome", "\"activate\""), false, "unknown outcome");
        let ordinary = self.field(self.field(review, "text_status", "\"not_applicable\""), "text_available", "false");
        self.expect("Review", ordinary, true, "ordinary review question has no canonical practice receipt");
        let error = self.example("source-unavailable");
        self.expect("ErrorResponse", self.field(error, "api_version", "\"hale.v1\\u0000\""), false, "NUL cannot truncate constant");
        self.expect("ErrorResponse", self.field(error, "api_version", "\"hale.v1\\n\""), false, "escaped suffix is unequal");
        self.expect("ErrorResponse", self.field(error, "api_version", "\"hale.v\\u0031\""), true, "escaped constant decoded exactly");
        self.expect("NoSuchResponse", error, false, "unknown named schema");
        self.expect("ErrorResponse", error + " true", false, "trailing JSON token");
        self.expect("ErrorResponse", "{\"api_version\":\"hale.v1\",\"api_version\":\"hale.v1\"}", false, "duplicate keys");
        self.expect("ErrorResponse", "{\"api_\\u0076ersion\":\"hale.v1\"}", false, "escaped keys fail closed");
    }
    fn profile_cases() {
        let nullable = "{\"anyOf\":[{\"type\":\"integer\",\"minimum\":0},{\"type\":\"null\"}]}";
        self.custom(nullable, "null", true, "absent native capacity stays null");
        self.custom(nullable, "0", true, "zero native capacity is distinct from null");
        self.custom(nullable, "999999999999999999999", true, "nullable integer has no machine truncation");
        self.custom(nullable, "-1", false, "bounds apply inside anyOf");
        self.custom(nullable, "\"unknown\"", false, "nullable capacity refuses another type");
        self.custom(nullable, "true", false, "boolean is not an integer alternative");
        self.custom("{\"anyOf\":[{}, {\"type\":\"null\"}]}", "null", true, "anyOf permits overlapping matches");
        self.unsupported("{\"$defs\":{\"X\":{\"anyOf\":[]}}}", "empty alternative list refused");
        self.unsupported("{\"$defs\":{\"X\":{\"anyOf\":[{}, {\"format\":\"email\"}]}}}", "unsupported alternate cannot hide behind a matching branch");
        self.unsupported("{\"$defs\":{\"X\":{\"anyOf\":[{}, {\"$ref\":\"#/$defs/X\"}]}}}", "reference cycles cannot hide behind a matching alternate");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":\"string\",\"format\":\"email\"}}}", "unsupported keyword cannot silently pass");
        self.unsupported("{\"$defs\":{\"X\":{\"pattern\":\".*\"}}}", "unsupported regex cannot silently pass");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"#/$defs/Missing\"}}}", "unresolved reference");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"https://example.invalid/schema\"}}}", "external reference never fetched");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"#/$defs/X\"}}}", "direct reference cycle");
        self.unsupported("{\"$defs\":{\"X\":{\"if\":{\"$ref\":\"#/$defs/X\"},\"then\":{\"const\":false}}}}", "conditional reference cycle");
        self.unsupported("{\"$defs\":{\"X\":{\"$ref\":\"#/$defs/Y\"},\"Y\":{\"$ref\":\"#/$defs/X\"}}}", "indirect reference cycle");
        self.unsupported("{\"$defs\":{\"X\":{\"minimum\":1}}}", "numeric bounds cannot silently skip noninteger values");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":\"number\"}}}", "unsupported number type");
        self.unsupported("{\"$defs\":{\"X\":{\"type\":[\"string\",\"boolean\"]}}}", "unsupported union type");
        self.unsupported("{\"$defs\":{\"X\":{\"additionalProperties\":true}}}", "unsupported open additional properties keyword");
        self.unsupported("{\"$defs\":{\"X\":{\"required\":[\"missing\"]}}}", "required names need declared properties");
        self.unsupported("{\"$defs\":{\"X\":{\"if\":{}}}}", "unpaired condition");
        self.unsupported("{\"$defs\":{\"X\":{\"allOf\":[]}}}", "empty conjunction");
        self.unsupported("{\"$defs\":{\"X\":{\"enum\":[\"a\",\"\\u0061\"]}}}", "decoded duplicate enum values");
        self.custom("{\"type\":\"string\",\"minLength\":2}", "\"é\"", false, "minLength counts codepoints not bytes");
        self.custom("{\"type\":\"string\",\"minLength\":2}", "\"\\u00e9\"", false, "escaped BMP counts one codepoint");
        self.custom("{\"type\":\"string\",\"minLength\":2}", "\"\\ud83d\\ude00\"", false, "surrogate pair counts one codepoint");
        self.custom("{\"type\":\"string\",\"minLength\":1}", "\"\\ud83d\\ude00\"", true, "surrogate pair accepted");
        self.custom("{\"const\":\"😀\"}", "\"\\ud83d\\ude00\"", true, "escaped astral constant matches literal Unicode");
        self.custom("{\"type\":\"string\"}", "\"\\ud83d\"", false, "unpaired high surrogate");
        self.custom("{\"type\":\"string\"}", "\"\\ude00\"", false, "unpaired low surrogate");
        self.custom("{\"type\":\"string\"}", "\"\\u0000\"", false, "NUL fails closed");
        self.custom("{\"type\":\"integer\"}", "01", false, "leading zero token");
        self.custom("{\"type\":\"array\"}", "[1,]", false, "dangling array comma");
        self.custom("{\"type\":\"object\"}", "{\"x\":true,}", false, "dangling object comma");
        self.custom("{\"type\":\"integer\",\"minimum\":-2,\"maximum\":-1}", "-2", true, "negative bounds inclusive");
        self.custom("{\"type\":\"integer\",\"minimum\":-2,\"maximum\":-1}", "-3", false, "negative comparison reverses magnitude");
        self.custom("{\"type\":\"integer\",\"minimum\":0}", "-0", true, "negative zero equals zero");
        let validator = wire_contract::Validator { root: self.root };
        let escaped_reference = "{\"$defs\":{\"Case\":{\"$ref\":\"#/$defs/\\u0058\"},\"X\":{\"const\":false}}}";
        std::test::assert(!validator.validate_schema(escaped_reference, "Case", "true").ok, "escaped reference resolves the same definition during profile and evaluation");
        self.custom("{\"if\":{\"properties\":{\"hidden\":{\"const\":true}}},\"then\":{\"properties\":{\"text\":{\"const\":\"\"}}}}", "{\"text\":\"leak\"}", false, "conditional properties only tests present properties");
        self.custom("{\"if\":{\"properties\":{\"hidden\":{\"const\":true}}},\"then\":{\"properties\":{\"text\":{\"const\":\"\"}}}}", "{\"hidden\":false,\"text\":\"visible\"}", true, "false condition skips consequent");
        let bytes = std::bytes::BytesBuilder { };
        bytes.append_u8(34); bytes.append_u8(255); bytes.append_u8(34);
        self.custom("{\"type\":\"string\"}", std::str::from_bytes(bytes.snapshot()), false, "invalid UTF-8");
    }
    fn file_cases() {
        let files = wire_contract::ContractFiles { root: self.root };
        let result = files.check();
        std::test::assert(result.ok, result.error);
        let spec = std::io::fs::read_file(self.root + "/openapi.json") or raise;
        let paths = std::json::find_field_raw(spec, "paths");
        let route = std::json::find_field_raw(paths, "/api/hale/v1/applications");
        let mutated = self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications", self.field(route, "post", "{}")));
        std::test::assert(!files.openapi(mutated, self.schema).ok, "OpenAPI mutation route rejected");
        let operation = std::json::find_field_raw(route, "get");
        let responses = std::json::find_field_raw(operation, "responses");
        let bad_responses = self.field(responses, "200", "{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"./schema.json#/$defs/Missing\"}}}}");
        let bad_route = self.field(route, "get", self.field(operation, "responses", bad_responses));
        let broken = self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications", bad_route));
        std::test::assert(!files.openapi(broken, self.schema).ok, "OpenAPI broken response link rejected");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, "/api/hale/v1/applications", "")), self.schema).ok, "missing route rejected");
        std::test::assert(!files.fixtures("[]", self.schema).ok, "empty fixture coverage rejected");
        let missing = wire_contract::Validator { root: self.root + "/does-not-exist" };
        std::test::assert(!missing.validate("ErrorResponse", "{}").ok, "missing schema is a hard failure");
    }
}

fn main() {
    let root = if std::env::var_exists("HALE_API_CONTRACT_ROOT") { std::env::var("HALE_API_CONTRACT_ROOT") } else { "dna/api/contract/v1" };
    let suite = Cases { root: root, schema: std::io::fs::read_file(root + "/schema.json") or raise, fixtures: std::io::fs::read_file(root + "/fixtures.json") or raise };
    suite.file_cases();
    suite.wire_cases();
    suite.profile_cases();
}
