// The secrets a seed declares in its manifest (`[dna.secrets.<name>]`):
// each the vault entry `secret-<org>-<name>`, drawn by the habitat
// (`drawn`) or filled by a person (`slot`), and handed to the programs and
// host commands it names among its readers.
//
// The toolchain is the one reader of the declaration (`hale dna
// declared-secrets <dir>`): this side never parses the manifest's tables.
// A program that reads one is handed, in its compose project's environment,
// `HALE_VAULT_DIR` (a vault directory of the organism's own where its
// services run: mode 700, each entry 600, holding only the secrets its
// programs read) and, per secret, `HALE_SECRET_<NAME>` naming its entry
// there. A family (`family = true`, a slot) is several entries, each a
// member a person filled under a label (`secret-<org>-<name>--<label>`),
// and its variable holds them all, one a line, in their labels' order. The application's compose file passes them to the services that
// read them and mounts the directory, read-only, at the same path;
// `std::secret::Credential { vault: <that name> }` then reads it.

// The declaration as the toolchain read it.
type DeclaredSecrets {
    ok: Bool = false;
    why: String = "";
    // a secret a line: `<name>\t<drawn|slot>\t<read|write|none>\t<programs>\t<host commands>\t<family or "">`,
    // each list space-separated
    lines: String = "";
}

// The secrets `<dir>/hale.toml` declares; none when it has no manifest.
fn declared_secrets(dir: String) -> DeclaredSecrets {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let r = run_tool(hale + "\ndna\ndeclared-secrets\n" + dir);
    if r.code != 0 {
        let said = trim_nl(r.stderr);
        return DeclaredSecrets {
            why: if len(said) > 0 { last_line(said) } else { "hale dna declared-secrets failed" },
        };
    }
    return DeclaredSecrets { ok: true, lines: r.stdout };
}

// The vault entry that holds the organism's secret `name` (`org` its
// record's schema, `schema_for`, as the nerves' entries are named).
fn declared_secret_vault(org: String, name: String) -> String {
    return "secret-" + identifier_part(org, 60) + "-" + name;
}

// The vault entry of the family `name`'s member `label`.
fn family_member_vault(org: String, name: String, label: String) -> String {
    return declared_secret_vault(org, name) + "--" + label;
}

// A family member's label: 1 to 63 characters, a lowercase letter or a
// digit, then lowercase letters, digits and `-` (^[a-z0-9][a-z0-9-]{0,62}$).
fn family_label_ok(label: String) -> Bool {
    if len(label) == 0 || len(label) > 63 { return false; }
    let mut i = 0;
    while i < len(label) {
        let c = label[i..(i + 1)];
        let ok = (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || (c == "-" && i > 0);
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}
const FAMILY_LABEL_RULE: String = "a label is 1 to 63 characters: a lowercase letter or a digit, then lowercase letters, digits and `-` (^[a-z0-9][a-z0-9-]{0,62}$)";

// The labels of the family `name`'s members the local vault holds, one a
// line, in order ("" for none, and with a vault served over HTTP, whose
// entries are not listed here).
fn family_labels(org: String, name: String) -> String {
    if std::env::var_exists("HALE_VAULT_ADDR") { return ""; }
    let prefix = declared_secret_vault(org, name) + "--";
    let r = run_tool(
        "sh\n-c\nfor f in \"$1\"/\"$2\"*; do [ -s \"$f\" ] && printf '%s\\n' \"${f##*/}\"; done | LC_ALL=C sort\nsh\n"
            + std::secret::vault_local_dir() + "\n" + prefix,
    );
    let mut out = "";
    let mut rest = r.stdout;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let f = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if !std::str::starts_with(f, prefix) { continue; }
        let label = f[len(prefix)..len(f)];
        if family_label_ok(label) { out = out + label + "\n"; }
    }
    return out;
}

// The variable its readers are handed the entry's name in.
fn declared_secret_var(name: String) -> String {
    return "HALE_SECRET_" + std::str::upper(std::str::replace(name, "-", "_"));
}

// Field `n` (from 0) of a declaration's line.
fn declared_field(line: String, n: Int) -> String {
    let mut rest = line;
    let mut i = 0;
    while i < n {
        let t = std::str::index_of(rest, "\t");
        if t < 0 { return ""; }
        rest = rest[(t + 1)..len(rest)];
        i = i + 1;
    }
    let t = std::str::index_of(rest, "\t");
    return if t < 0 { rest } else { rest[0..t] };
}

// Whether a declaration's line declares a family.
fn declared_family(line: String) -> Bool { return declared_field(line, 5) == "family"; }

// The secrets some program reads, a line each: `<variable>\t<its entries>`,
// the entries space-separated (a family's members the local vault holds,
// in their labels' order; none when it has none).
fn program_secrets(lines: String, org: String) -> String {
    let mut out = "";
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let name = declared_field(line, 0);
        if len(name) == 0 || len(std::str::trim(declared_field(line, 3))) == 0 { continue; }
        let mut entries = "";
        if declared_family(line) {
            let mut labels = family_labels(org, name);
            while len(labels) > 0 {
                let l = std::str::index_of(labels, "\n");
                let label = labels[0..l];
                labels = labels[(l + 1)..len(labels)];
                entries = entries + (if len(entries) > 0 { " " } else { "" })
                    + family_member_vault(org, name, label);
            }
        } else {
            entries = declared_secret_vault(org, name);
        }
        out = out + declared_secret_var(name) + "\t" + entries + "\n";
    }
    return out;
}

// The vault entries of `secrets` (`program_secrets`), each after `sep`.
fn reader_entries(secrets: String, sep: String) -> String {
    let mut out = "";
    let mut rest = secrets;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let t = std::str::index_of(line, "\t");
        if t < 0 { continue; }
        let mut es = line[(t + 1)..len(line)] + " ";
        while len(std::str::trim(es)) > 0 {
            let sp = std::str::index_of(es, " ");
            let e = es[0..sp];
            es = es[(sp + 1)..len(es)];
            if len(e) > 0 { out = out + sep + e; }
        }
    }
    return out;
}

// What a shell hands compose for `secrets`, as assignment words ("" when
// none): `HALE_VAULT_DIR=<dir>` (`dir` a shell word already) and each
// `HALE_SECRET_<NAME>`, its entries one a line (printf's lines: no
// argument carries a newline of its own), each word with a space after it.
fn reader_words(secrets: String, dir: String) -> String {
    if len(secrets) == 0 { return ""; }
    let mut out = "HALE_VAULT_DIR=" + dir + " ";
    let mut rest = secrets;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let t = std::str::index_of(line, "\t");
        if t <= 0 { continue; }
        let entries = std::str::trim(line[(t + 1)..len(line)]);
        out = out + line[0..t] + "="
            + (
                if std::str::contains(entries, " ") {
                    "\"$(printf '%s\\n' '" + std::str::replace(entries, " ", "' '") + "')\""
                } else {
                    "'" + entries + "'"
                }
            )
            + " ";
    }
    return out;
}

// `secrets` handed to a command run by `run_tool`: an argv prefix (lines)
// that exports them and execs the command after it ("" when none).
fn reader_wrap(secrets: String, dir: String) -> String {
    if len(secrets) == 0 { return ""; }
    return "sh\n-c\nexport "
        + reader_words(secrets, "'" + std::str::replace(dir, "'", "'\\''") + "'")
        + "&& exec \"$@\"\nsh\n";
}

// The local reader vault of the organism keyed `key`: beside its
// allocations in the local habitat, never in a checkout.
fn reader_vault_dir(key: String) -> String {
    return local_habitat_dir() + "/allocations/" + key + "/vault";
}

// The script that brings a reader vault to hold `secrets`' entries and no
// other: made (700) when it is not, each entry rewritten in place (600) from
// the vault directory `$1` (a running service mounts the directory, so it is
// never replaced), an entry the vault lacks or no secret names removed.
// Arguments: the vault, the reader vault, then the entries.
const READER_VAULT_SCRIPT: String = "src=$1 d=$2; shift 2; umask 077; mkdir -p \"$d\" && chmod 700 \"$d\" || exit 1; for f in \"$d\"/* \"$d\"/.[!.]*; do [ -e \"$f\" ] || continue; n=${f##*/}; keep=0; for e in \"$@\"; do [ \"$e\" = \"$n\" ] && keep=1; done; [ $keep = 1 ] || rm -f \"$f\"; done; for e in \"$@\"; do if [ -s \"$src/$e\" ]; then cat \"$src/$e\" > \"$d/$e\" && chmod 600 \"$d/$e\" || exit 1; else rm -f \"$d/$e\"; fi; done";

// The local reader vault `dir` brought to hold `secrets`' entries, copied
// file to file from the local vault, never read into this program: "" once
// it does, else why not.
fn stage_reader_vault(dir: String, secrets: String) -> String {
    if len(secrets) == 0 { return ""; }
    if std::env::var_exists("HALE_VAULT_ADDR") {
        return "the vault is served over HTTP (HALE_VAULT_ADDR): a declared secret reaches its programs from a local vault alone";
    }
    let r = run_tool(
        "sh\n-c\n" + READER_VAULT_SCRIPT + "\nsh\n" + std::secret::vault_local_dir() + "\n" + dir
            + reader_entries(secrets, "\n"),
    );
    return if r.code == 0 { "" } else { "the reader vault " + dir + ": " + trim_nl(r.stderr) };
}
