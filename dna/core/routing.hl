// dna/core/routing.hl — three memories, one table of where each kind
// lives (GH #646 stage 1, #650, #1590). Every row kind belongs to exactly
// one memory: what changes the organism stays in the record, what the
// organism did today goes to the Ledger. Every record has its Ledger from
// its first row (GH #1590), so this placement is fixed: it is part of the
// schema, not data in the record, and not versioned.
// There is no dual-write: a kind has one home, and a writer that cannot
// reach it fails.
//
// `RoutedJournal` is the `Journal` an assembly and the host stand on: two
// journals underneath — the record's and the Ledger's — read as one
// merged sequence, appended to by kind. `MemoryLedger` (memory_spine.hl)
// is the Ledger as the organism and the host reach it, under the record's
// spine role; a head writes it directly under its own role, and memory's
// insert function is the gate (GH #985, #1026).

// The table, as data: the families that are the Ledger's whole, and the
// kinds of other families that are. `memory_of` reads it, and so do
// memory's insert functions (`ledger_kind`, GH #1026, #1590), which refuse
// a kind asked of the wrong memory — one table, read in two languages.
//
// The whole family is operational: cases, intents, tasks, decisions,
// completions, exceptions, schedules, receipts, handoffs, pressure,
// instances, effects, reports, leases, claims, an application's
// readings (GH #987) and what a reflex made the body do (GH #988).
const LEDGER_FAMILIES: String = "case intent task decision completion exception schedule receipt handoff pressure instance effect report lease claim reading reflex";
// Families split by kind — concerns, money, a body's liveness, model
// calls — and, GH #646 card 05, a workflow execution's own facts: the
// `workflow`, `step` and `attempt` families and `work.settled` are the
// day's work, named here rather than left to the default.
const LEDGER_KINDS: String = "concern.requested concern.raised concern.refused grant.reserved grant.released grant.fenced grant.reservation_refused spend.reserved spend.settled spend.compensated body.claimed body.released body.credential_missing body.credential_present model.called knowledge.consulted optimize.refused budget.exhausted workflow.admitted workflow.refused workflow.ask_refused workflow.settled step.registered step.activated step.completed step.failed work.settled attempt.admitted attempt.outcome attempt.claimed attempt.outcome_requested attempt.outcome_refused attempt.allowance_requested attempt.allowance_granted attempt.allowance_refused attempt.unresolved attempt.released";

// Where a kind lives. Everything the table does not name — mutations,
// reviews, knowledge, practices, grants as authority, connections,
// provisioning, secrets, expression, the fleet's deploys, people and the
// structure observed at init — is the record's.
fn memory_of(kind: String) -> String {
    let dot = std::str::index_of(kind, ".");
    let family = if dot < 0 { kind } else { kind[0..dot] };
    if word_in(family, LEDGER_FAMILIES) || word_in(kind, LEDGER_KINDS) { return "ledger"; }
    return "record";
}

// ---- the routed journal ------------------------------------------------

// One entry of the merged order: which memory, and the row's index there.
type Placed {
    ledger: Bool = false;
    index: Int = 0;
}

@form(vec)
locus PlacedRows {
    capacity { heap rows of Placed; }
}

// Two journals read as one. The merged order is arrival: at birth every
// record row then every Ledger row, then each row as it is appended or
// seen at a refresh. A row's `seq` as read here is its merged position,
// so a writer that appends and looks for its row by `revision - 1`
// finds it whichever memory holds it. Rows name each other by id, never
// by seq (GH #603), so no reader depends on the interleaving.
locus RoutedJournal {
    params {
        record: Journal = MemJournal { };
        ledger: Journal = MemoryLedger { };
        order: PlacedRows = PlacedRows { };
        seen_record: Int = 0;
        seen_ledger: Int = 0;
        last_error: String = "";
    }
    birth() { self.take_new(); }
    // Append every row a memory has that the order does not. A record row
    // of a Ledger kind is not read: the Ledger is the authority for those
    // kinds (#646 decision 3), and memory's insert function refuses one in
    // a record it keeps (GH #1590).
    // The order grows by the rows of the record and the ledger, one placement each.
    @bounded_by(self.record)
    fn take_new() {
        while self.seen_record < self.record.revision() {
            let e = self.record.read(self.seen_record);
            if memory_of(e.kind) != "ledger" { self.order.push(Placed { ledger: false, index: self.seen_record }); }
            self.seen_record = self.seen_record + 1;
        }
        while self.seen_ledger < self.ledger.revision() {
            self.order.push(Placed { ledger: true, index: self.seen_ledger });
            self.seen_ledger = self.seen_ledger + 1;
        }
    }
    fn revision() -> Int { return self.order.len(); }
    fn head() -> String {
        if self.order.len() == 0 { return "genesis"; }
        return self.read(self.order.len() - 1).digest;
    }
    fn refresh() -> Bool {
        let a = self.record.refresh();
        let b = self.ledger.refresh();
        let before = self.order.len();
        let seen = self.seen_record;
        self.take_new();
        return self.order.len() != before || a || b || self.seen_record != seen;
    }
    fn read(i: Int) -> Event {
        let p = self.order.get(i) or Placed { };
        let e = if p.ledger { self.ledger.read(p.index) } else { self.record.read(p.index) };
        return Event { seq: i, kind: e.kind, entity: e.entity, body: e.body, prev: e.prev, digest: e.digest };
    }
    // Which memory a merged row came from, and its index there (GH #946):
    // a reader that checks a row's author against the record's text needs
    // the record's index, and a ledger row's author is the ledger's.
    fn from_ledger(i: Int) -> Bool { let p = self.order.get(i) or Placed { }; return p.ledger; }
    fn index_of(i: Int) -> Int { let p = self.order.get(i) or Placed { index: -1 }; return p.index; }
    fn verify_chain() -> Bool { return self.record.verify_chain() && self.ledger.verify_chain(); }
    fn to_ledger(kind: String) -> Bool { return memory_of(kind) == "ledger"; }
    // Compare-and-append against the merged revision, then the memory's
    // own tail: the memory retries a lost race at its tail as it always
    // did, and the row's merged position is where it lands here. (Each
    // memory is called on its own typed field: the law's claim walk
    // follows a typed receiver, never one a method handed back.)
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let rev = self.order.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let r = if self.to_ledger(kind) { self.ledger.append(self.ledger.revision(), kind, entity, body) } else { self.record.append(self.record.revision(), kind, entity, body) };
        if !r.ok { self.last_error = r.error; return AppendResult { error: r.error, expected: expected, actual: self.order.len() }; }
        self.take_new();
        return AppendResult { ok: true, revision: self.order.len() };
    }
    // Many rows at the tail in one write when they all belong to the
    // record (the record's `append_batch`: every row or none); a batch with
    // a Ledger row in it goes row by row, each to its own memory.
    fn append_batch(expected: Int, rows: RowBatch) -> AppendResult {
        let rev = self.order.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let mut i = 0;
        while i < rows.len() {
            if self.to_ledger((rows.get(i) or Row { }).kind) { return append_rows(self, expected, rows); }
            i = i + 1;
        }
        let r = self.record.append_batch(self.record.revision(), rows);
        self.take_new();
        if !r.ok { self.last_error = r.error; return AppendResult { error: r.error, expected: expected, actual: self.order.len() }; }
        return AppendResult { ok: true, revision: self.order.len() };
    }
    // Exact: neither memory may have moved since the caller read the
    // merged revision, and the memory's own swap is one attempt.
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult {
        let moved = self.refresh();
        let rev = self.order.len();
        if expected != rev { return AppendResult { error: "stale_revision", expected: expected, actual: rev }; }
        let r = if self.to_ledger(kind) { self.ledger.append_exact(self.ledger.revision(), kind, entity, body) } else { self.record.append_exact(self.record.revision(), kind, entity, body) };
        if !r.ok {
            self.take_new();
            return AppendResult { error: r.error, expected: expected, actual: self.order.len() };
        }
        self.take_new();
        return AppendResult { ok: true, revision: self.order.len() };
    }
}
