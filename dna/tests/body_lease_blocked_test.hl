// GH #617 (the second and third reviews of #622) — a body executes nothing
// past its lease, even while the lease cannot be renewed, and even in a tool
// its organization started. A host is up, its organization running a
// worker tool through `std::process::run` (as `run_tool` does: the tool
// gets a process group of its own). Then memory holds the lease's row
// locked (GH #1590: the lease is a row of memory), so every renewal waits
// on it until its call's bound; and the organism crashes, leaving its
// worker reparented, out of reach of a walk from the organism's pid. The
// body fence must stop that worker before the lease it last proved
// expires — and the host ends, never cleanly.
//
// The host binary runs directly (as `hale dna run` would exec it), on the
// spine's DSN for this fixture's record.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`: discovery off, a cache of this
// fixture's own so the host binary is found in one place.
fn in_dir(dir: String, cache: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off XDG_CACHE_HOME=\"$1\" && shift && exec \"$@\"\nsh\n" + dir + "\n" + cache + "\n" + argv);
}

fn log_has(path: String, needle: String) -> Bool {
    return std::str::contains(std::io::fs::read_file(path) or "", needle);
}

fn alive(pid: String) -> Bool {
    return len(pid) > 0 && dna::run_tool("kill\n-0\n" + pid).code == 0;
}

// The last line of a file, as a number (0 when there is none).
fn last_number(path: String) -> Int {
    if !std::io::fs::file_exists(path) { return 0; }
    return std::str::parse_int(dna::trim_nl(dna::run_tool("tail\n-n\n1\n" + path).stdout)) or 0;
}

// The organization: a worker tool that says it is alive every 200ms.
const WORKER_ORG: String = "fn main() {\n    let r = std::process::run(\"sh\\n-c\\necho $$ > worker.pid; while :; do date +%s >> worker.tick; sleep 0.2; done\") or std::process::ProcessOutput { code: -1, signal: 0, stdout: \"\", stderr: \"\" };\n}\n";

main locus App {
    run() {
        let scratch = dna::scratch_root("leaseblocked");
        // whatever this fixture starts under its scratch stops when it does (#637)
        dna::reap_on_exit(scratch);
        let cache = scratch + "/cache";
        std::io::fs::mkdir(cache) or discard;
        let bare = scratch + "/origin.git";
        let b0 = in_dir(scratch, cache, "git\ninit\n-q\n--bare\n-b\nmain\n" + bare);
        let made = in_dir(scratch, cache, toolchain() + "\ndna\nnew\nbodied\n--profile\nremote-body\n--remote\n" + bare + "\n--body\nriley@srv");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let a = scratch + "/bodied";
        std::io::fs::write_file(a + "/dna/org/main.hl", WORKER_ORG) or discard;
        let g1 = in_dir(a, cache, "git\nconfig\nuser.name\norganism-host");
        let g2 = in_dir(a, cache, "git\nconfig\nuser.email\nhost@dna");
        let g3 = in_dir(a, cache, "git\nadd\n-A");
        let g4 = in_dir(a, cache, "git\ncommit\n-q\n-m\nthe app");
        let g5 = in_dir(a, cache, "git\npush\n-q\norigin\nmain");
        std::test::assert_eq_int(g5.code, 0, "pushed: " + g5.stderr);

        // the host binary, built into this fixture's cache
        let built = in_dir(a, cache, toolchain() + "\ndna\nprofile\n.");
        let host = dna::trim_nl(in_dir(scratch, cache, "sh\n-c\nfind \"$1\" -path '*/dna/host/host' -type f | head -1\nsh\n" + cache).stdout);
        std::test::assert(len(host) > 0, "the host is built: " + built.stdout + built.stderr);
        // the first line alone is the version: `hale --version` has a
        // second one since GH #726 (the embedded DNA digest)
        let version = dna::trim_nl(in_dir(scratch, cache, "sh\n-c\n\"$1\" --version | head -1\nsh\n" + toolchain()).stdout);

        // host A comes up and runs its organization, whose worker ticks
        let started = in_dir(a, cache, "sh\n-c\nHALE_BIN=\"$2\" HALE_DNA_TOOLCHAIN=\"$3\" HALE_DNA_GENOME=\"$4\" HALE_DNA_MEMORY_DSN_SPINE=\"$6\" nohup sh -c 'timeout 300 \"$0\" run \"$1\" . \"\" \"\" --no-iris; echo $? > a.exit' \"$5\" \"$4\" >a.log 2>&1 </dev/null & echo $!\nsh\n-\n" + toolchain() + "\n" + version + "\n" + a + "\n" + host + "\n" + dna::fixture_spine(a));
        let mut up = false;
        let mut tries = 0;
        while !up && tries < 720 {
            // the host names the genome it runs just before its first tick
            // (no nerves are handed to it: its organization reads none)
            if log_has(a + "/a.log", "hale dna run: genome ") && last_number(a + "/worker.tick") > 0 { up = true; } else { std::time::sleep(250ms); }
            tries = tries + 1;
        }
        std::test::assert(up, "host A came up with its worker: " + (std::io::fs::read_file(a + "/a.log") or ""));
        let org = dna::trim_nl(std::io::fs::read_file(a + "/.hale/dna/org.pid") or "");
        let worker = dna::trim_nl(std::io::fs::read_file(a + "/worker.pid") or "");
        std::test::assert(alive(org) && alive(worker), "the organization and its worker run: " + org + " " + worker);

        // memory holds the lease's row: every renewal waits on it to its bound
        let sch = dna::schema_for(dna::record_scope(a));
        let owner = std::env::var("HALE_DNA_MEMORY_DSN_OWNER");
        let locker = dna::run_tool("sh\n-c\nnohup psql \"$1\" -q -v ON_ERROR_STOP=1 -c 'BEGIN' -c \"SELECT 1 FROM $2.claims WHERE key = 'body' FOR UPDATE\" -c 'SELECT pg_sleep(600)' >/dev/null 2>&1 </dev/null & echo $!\nsh\n" + owner + "\n" + sch);
        let lock_pid = dna::trim_nl(locker.stdout);
        std::test::assert(alive(lock_pid), "memory holds the lease's row: " + locker.stderr);
        let blocked_at = std::time::now();
        std::time::sleep(3s);
        let crashed = dna::run_tool("kill\n-KILL\n" + org);
        std::test::assert_eq_int(crashed.code, 0, "the organism crashed: " + crashed.stderr);
        let mut proven = 0;
        let mut died_at = -1;
        tries = 0;
        while died_at < 0 && tries < 300 {
            let status = dna::trim_nl(std::io::fs::read_file(a + "/.hale/dna/body.fence.status") or "");
            let at = std::str::index_of(status, " ok ");
            if at > 0 { proven = std::str::parse_int(status[(at + 4)..len(status)]) or proven; }
            if !alive(worker) { died_at = std::time::now(); } else { std::time::sleep(250ms); }
            tries = tries + 1;
        }
        let log = std::io::fs::read_file(a + "/a.log") or "";
        std::test::assert(died_at > 0 && proven > 0, "the orphaned worker was stopped while its host was blocked: " + log);
        std::test::assert(died_at <= proven, "the worker stopped before the lease it last proved expired: died " + to_string(died_at) + ", expires " + to_string(proven) + " (blocked at " + to_string(blocked_at) + ")");
        std::time::sleep(1500ms);
        let tick = last_number(a + "/worker.tick");
        std::test::assert(!alive(worker) && tick <= proven, "its last tick came before the lease expired: last tick " + to_string(tick) + ", expires " + to_string(proven) + ", worker alive " + (if alive(worker) { "yes" } else { "no" }));

        // the host finds the lease unproved and exits 3; then memory lets go
        let let_go = dna::run_tool("kill\n" + lock_pid);
        let mut ended = false;
        tries = 0;
        while !ended && tries < 240 {
            if std::io::fs::file_exists(a + "/a.exit") { ended = true; } else { std::time::sleep(500ms); }
            tries = tries + 1;
        }
        let final_log = std::io::fs::read_file(a + "/a.log") or "";
        std::test::assert(ended, "host A ended: " + final_log);
        // the host is not held up by memory (only its lease's row is), so it
        // ends on whichever it sees first: the lease it cannot prove (exit 3)
        // or its organization's crash (its code), never cleanly
        let code = dna::trim_nl(std::io::fs::read_file(a + "/a.exit") or "");
        std::test::assert(code != "0" && len(code) > 0, "host A did not end cleanly: " + code + " " + final_log);
        std::test::assert(std::str::contains(final_log, "a body that cannot prove its lease executes nothing") || std::str::contains(final_log, "organization exited ("), "and said why: " + final_log);

        if alive(worker) { let k = dna::run_tool("kill\n-KILL\n" + worker); }
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
