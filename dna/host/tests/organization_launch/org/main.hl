// Disposable actual Organization for the prepared host acceptance fixture.
import "../../vendor/core" as dna;
import "../../vendor/core/pond/realtime/nats" as nats;
main locus Org {
    params {
        title: String = "Original";
        // GH #986: the facts arrive over the nerves, through the
        // organization's durable consumer (`hale dna dev` hands the host,
        // and the host this program, the spine's URL and the token)
        nerves: nats::NatsConn = nats::NatsConn { url: dna::nerves_spine_url(), name: "organization", subject_prefix: dna::nerves_prefix(dna::nerves_org()), stream: dna::nerves_stream(dna::nerves_org()), consumer: dna::nerves_consumer(dna::nerves_org()) };
        core: dna::Dna = dna::Dna {
            journal: dna::GitJournal { repo: "." },
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: "." }, repo: "." },
            membrane: dna::Board { },
            gateway: dna::MutationGateway {
                leases: dna::GitLeases { repo: "." },
                workspaces: dna::IsolatedWorktrees { repo: ".", root: ".hale/dna/worktrees" },
                repo: dna::LocalGit { repo: "." }
            }
        };
    }
    placement { nerves: pinned; }
    bindings {
        dna::PracticeRequested: nats::NatsAdapter { };
        dna::KnowledgeNodeRequested: nats::NatsAdapter { };
        dna::KnowledgeBindingRequested: nats::NatsAdapter { };
        dna::KnowledgeEdgeRequested: nats::NatsAdapter { };
        dna::ReviewVerdict: nats::NatsAdapter { };
        dna::IntentOffered: nats::NatsAdapter { };
        dna::ExpressionObserved: nats::NatsAdapter { };
        dna::PressureRaised: nats::NatsAdapter { };
        dna::ConcernRaised: nats::NatsAdapter { };
    }
    run() {
        if self.title == "Prepared" && std::io::fs::file_exists(".hale/dna/fixture-crash") { std::process::exit(17); }
        while true { std::time::sleep(100ms); }
    }
}
fn main() { Org { }; }
