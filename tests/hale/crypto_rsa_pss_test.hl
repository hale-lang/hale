// A throwaway P-256 key: a PEM private key that is not RSA.
const EC_KEY: String = """
    -----BEGIN PRIVATE KEY-----
    MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg2T6x6w/wI1R8JlAR
    dD8OCY4EZpYopTSGyGFoBQhVpU+hRANCAASdd8YvC5mjzkT8PmVTlUwP2gHL92fG
    ygLQreWuBxZ9vgmfTUil1NfIcOoM3Err+x/7SQJFVDGWxRl9DnbVFpxC
    -----END PRIVATE KEY-----
    """;

const MESSAGE: String = "hale rsa-pss fixture message";

// OpenSSL's PSS signature of MESSAGE by the test key, salt length 32 ...
const OPENSSL_SIGNATURE: String = "";

// ... with salt length 20, which verification with a 32-byte salt refuses ...
const OPENSSL_SIGNATURE_SALT_20: String = "";

// ... and PKCS#1 v1.5 (`openssl dgst -sha256 -sign`), not PSS at all.
const OPENSSL_SIGNATURE_V15: String = "";

fn hex(s: String) -> Bytes {
    return std::hex::decode(s) or b"";
}

fn pem(s: String) -> Bytes {
    return std::bytes::from_string(s);
}

/// Signing with `key` refuses, with the CryptoError's kind and a detail
/// that spells nothing of the key.
fn refuses(name: String, key: String) {
    let mut kind = "";
    let mut detail = "";
    let sig = std::crypto::rsa_pss_sha256_sign(pem(key), pem(MESSAGE)) or {
        kind = err.kind;
        detail = err.detail;
        b""
    };
    std::test::assert_eq_str(kind, "rsa_pss_sha256_sign", name + ": refused");
    std::test::assert(!std::str::contains(detail, "BEGIN"), name + ": the detail names no key");
    std::test::assert_eq_int(len(sig), 0, name + ": nothing signed");
}

fn main() {
    let public = pem(TEST_PUBLIC);
    let message = pem(MESSAGE);

    // OpenSSL's signature verifies; another salt length, PKCS#1 v1.5, a
    // changed message and another key do not.
    let theirs = hex(OPENSSL_SIGNATURE);
    std::test::assert_eq_int(len(theirs), 256, "the fixture is a 2048-bit signature");
    std::test::assert(
        std::crypto::rsa_pss_sha256_verify(public, message, theirs),
        "OpenSSL's PSS signature verifies",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(public, message, hex(OPENSSL_SIGNATURE_SALT_20)),
        "a 20-byte salt does not",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(public, message, hex(OPENSSL_SIGNATURE_V15)),
        "a PKCS#1 v1.5 signature does not",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(public, std::bytes::concat(message, b"."), theirs),
        "a changed message does not",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(pem(OTHER_PUBLIC), message, theirs),
        "another key does not",
    );

    // Signing round-trips, from the PKCS#8 and the PKCS#1 form of the key;
    // the salt is fresh each time, so two signatures differ.
    let a = std::crypto::rsa_pss_sha256_sign(pem(TEST_KEY_PKCS8), message) or b"";
    let b = std::crypto::rsa_pss_sha256_sign(pem(TEST_KEY_PKCS1), message) or b"";
    std::test::assert_eq_int(len(a), 256, "PKCS#8: a signature as long as the modulus");
    std::test::assert_eq_int(len(b), 256, "PKCS#1: a signature as long as the modulus");
    std::test::assert(
        std::crypto::rsa_pss_sha256_verify(public, message, a),
        "PKCS#8: it verifies",
    );
    std::test::assert(
        std::crypto::rsa_pss_sha256_verify(public, message, b),
        "PKCS#1: it verifies",
    );
    std::test::assert(
        std::hex::encode(a) != std::hex::encode(b),
        "two signatures differ (the salt)",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(public, b"another message", a),
        "and verify nothing else",
    );
    let empty = std::crypto::rsa_pss_sha256_sign(pem(TEST_KEY_PKCS8), b"") or b"";
    std::test::assert(std::crypto::rsa_pss_sha256_verify(public, b"", empty), "the empty message");

    // Verification takes no truncated signature, and no public key it
    // cannot read.
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(public, message, std::bytes::slice(theirs, 0, 255)),
        "a truncated signature does not verify",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(b"not a key", message, theirs),
        "nor a non-key",
    );
    std::test::assert(
        !std::crypto::rsa_pss_sha256_verify(pem(TEST_KEY_PKCS8), message, theirs),
        "nor a private key",
    );

    // The refusals: not a PEM key, an encrypted one (refused, never a
    // passphrase prompt), and a key that is not RSA.
    refuses("not a key", "-----BEGIN PRIVATE KEY-----\nnot a key\n-----END PRIVATE KEY-----\n");
    refuses("the empty key", "");
    refuses("an encrypted key", OTHER_KEY_ENCRYPTED);
    refuses("an EC key", EC_KEY);
}
