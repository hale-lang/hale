// StatusBar — bottom-of-window strip surfacing iris's current
// state in one glance. Renders inside the rect Layout reserves
// at the bottom (24px tall by default).
//
// Format (Phase 5.c v0; emoji glyphs from USAGE.md design land
// once raylib's default font supports them or we ship a real
// font file):
//
//   iris (.) | echo > hale.locus_tower | focus=agent | mode=bulk | locks=---- | idle
//
// Each segment is " | " separated. Locks codes are 4 chars
// matching [shell, source, viz, agent]:
//   "-" — pane is writable (default)
//   "L" — pane has write lock (agent can't propose writes here)
//
// StatusBar is a "namespace lotus" — no state, just a render
// method that reads iris's fields. Called from Iris.tick after
// pane rendering completes.

import "lib/raylib" as ray;

const STATUS_BG:   ray::Color = ray::Color { r: 22,  g: 22,  b: 22,  a: 255 };
const STATUS_TEXT: ray::Color = ray::Color { r: 200, g: 200, b: 200, a: 255 };
const STATUS_DIM:  ray::Color = ray::Color { r: 120, g: 120, b: 120, a: 255 };

locus StatusBar {
    params { }

    fn render(iris: Iris) {
        let rect = iris.layout.status_rect();

        // Fill the strip.
        ray::draw_rect(rect, STATUS_BG);

        // Build the segments.
        let line = build_status_line(iris);

        // Vertical center: y = rect.y + (rect.height - text_height) / 2
        // text_height ≈ 14 for size=14 raylib default font.
        let text_x = Int(rect.x) + 8;
        let text_y = Int(rect.y + (rect.height - 14.0) / 2.0);

        ray::draw_text(line, text_x, text_y, 14, STATUS_TEXT);
    }
}

fn build_status_line(iris: Iris) -> String {
    let b = std::str::builder_new();
    std::str::builder_append(b, "iris (");
    std::str::builder_append(b, iris.workspace_root);
    std::str::builder_append(b, ") | ");
    std::str::builder_append(b, iris.harness.backend_name());
    std::str::builder_append(b, " > ");
    std::str::builder_append(b, iris.viz.scene_name());
    std::str::builder_append(b, " | focus=");
    std::str::builder_append(b, iris.focused);
    std::str::builder_append(b, " | mode=");
    std::str::builder_append(b, iris.viz.current_mode());
    std::str::builder_append(b, " | locks=");
    std::str::builder_append(b, lock_summary(iris));
    return std::str::builder_finish(b);
}

fn lock_summary(iris: Iris) -> String {
    let b = std::str::builder_new();
    std::str::builder_append(b, lock_glyph(iris.gate.allows("shell",  "write")));
    std::str::builder_append(b, lock_glyph(iris.gate.allows("source", "write")));
    std::str::builder_append(b, lock_glyph(iris.gate.allows("viz",    "write")));
    std::str::builder_append(b, lock_glyph(iris.gate.allows("agent",  "write")));
    return std::str::builder_finish(b);
}

fn lock_glyph(writable: Bool) -> String {
    if writable { return "-"; }
    return "L";
}
