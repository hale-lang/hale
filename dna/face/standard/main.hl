// dna/face/standard/main.hl — the standard face (Phase 3 DNA item 6).
//
// A face is an application that fills a role of the organism: the
// browser's door to it. This one ships with the toolchain and is what an
// organism that names no face gets. It serves the static shell (the
// genome's `dna/face/web` assets) and, under `/app/`, the attached
// project's own `ui/` pages; every other request is the head's surface,
// and the face passes it to the head on the loopback as the browser sent
// it, answer and event stream included. The head serves surfaces only: it
// owns no static file and no page.
//
// What the face asks the head, it asks as the browser's session: the
// request's own headers (cookie, host, origin) ride to the head, so the
// head's gate is the one gate. `GET /` is the shell's gate: the head
// answers 204 when the person may open it, and the face then serves the
// shell; any other answer (the sign-in redirect, the launch-token cookie,
// a refusal) is the head's, passed on as it came. `/app/…` asks the head's
// read (`GET /api/hale/v1/head`) which project is attached, and serves
// that project's `ui/`.
//
// `GET /index` is the record's index: a static page generated on request
// (index.hl) from what the face reads of the head through a client of its
// surface, behind the head's read as the person's session.
//
//   face <port 1..65535> <webroot> <head-port 1..65535>
//
// Build: hale build dna/face/standard -o <path>
import "../../api/web" as assets;
import "../../core" as dna;
import "../../operations" as ops;

const USAGE: String = "hale dna face: expected <port 1..65535> <webroot> <head-port 1..65535>";
const HEAD_READ: String = "/api/hale/v1/head";
// The head's rows, called by a page. The head reads the call's bearer as the
// visitor's cookies; a page cannot write that header, so the face does, from
// the cookies the page's own request carries. The head's gate and each row's
// authority (a Board act is the Board's) decide, as for any caller.
const HEAD_CALLS: String = "/api/hale/v1/head/surface/call/Commands::";
// A request to the head is answered within this; an event stream's
// heartbeat (the head writes one every 15 s) keeps its read alive.
const RELAY_RECV_NS: Int = 60000000000;
// A buffered answer (the gate, the head read) is small; larger is cut.
const BUFFER_LIMIT: Int = 4194304;

type Answer {
    ok: Bool = false;
    status: Int = 0;
    head: String = "";
    body: String = "";
    raw: Bytes = b"";
}

fn integer(text: String, ceiling: Int) -> Int {
    let n = std::str::parse_int(text) or - 1;
    if n < 1 || n > ceiling { return 0 - 1; }
    return n;
}

fn lower_name(line: String) -> String {
    let colon = std::str::index_of(line, ":");
    if colon < 0 { return ""; }
    return std::str::lower(line[0..colon]);
}

// Whether `req` is a page's call of one of the head's rows: its cookies are
// the call's bearer (HEAD_CALLS).
fn presents_cookies(req: std::http::Request) -> Bool {
    return req.method == "POST" && std::str::starts_with(req.path, HEAD_CALLS)
        && len(std::http::header(req, "Cookie")) > 0;
}

// The request as the head must see it: the browser's lines but for the
// connection's own framing, then the body's real length and a close.
fn head_request(req: std::http::Request, head_port: Int) -> String {
    let mut lines = "";
    let mut rest = req.headers;
    while len(rest) > 0 {
        let cut = std::str::index_of(rest, "\r\n");
        let line = if cut < 0 { rest } else { rest[0..cut] };
        rest = if cut < 0 { "" } else { rest[(cut + 2)..len(rest)] };
        let name = lower_name(line);
        if len(name) > 0
            && !(name == "authorization" && presents_cookies(req))
            && name != "connection"
            && name != "content-length"
            && name != "transfer-encoding"
            && name != "keep-alive"
            && name != "expect"
        {
            lines = lines + line + "\r\n";
        }
    }
    if req.method == "POST" || len(req.body) > 0 {
        lines = lines + "Content-Length: " + to_string(len(req.body)) + "\r\n";
    }
    if presents_cookies(req) {
        lines = lines + "Authorization: Bearer " + std::http::header(req, "Cookie") + "\r\n";
    }
    return req.method + " " + req.path + " HTTP/1.1\r\n" + lines + "Connection: close\r\n\r\n"
        + req.body;
}

// The habitat's Grafana (`hale habitat up` runs it in the face's network,
// on the loopback port HALE_DNA_GRAFANA_PORT): served under this path,
// behind the head's gate at `/` as the shell is. Grafana trusts the person's
// name on the header HALE_DNA_GRAFANA_HEADER names, a name drawn for the
// habitat that only the face and Grafana know; the browser's own `X-Hale-*`
// and `Authorization` lines never reach it. Grafana's build (its scripts,
// styles and fonts, under `public/`) is the same for everyone and passes
// ungated.
const GRAFANA_PREFIX: String = "/grafana";

fn env_or_empty(name: String) -> String {
    return if std::env::var_exists(name) { std::str::trim(std::env::var(name)) } else { "" };
}

// The value of the header `name` (lower case) in an answer's head lines, ""
// when it has none.
fn answer_header(head: String, name: String) -> String {
    let mut rest = head;
    while len(rest) > 0 {
        let cut = std::str::index_of(rest, "\r\n");
        let line = if cut < 0 { rest } else { rest[0..cut] };
        rest = if cut < 0 { "" } else { rest[(cut + 2)..len(rest)] };
        if lower_name(line) == name {
            let colon = std::str::index_of(line, ":");
            return std::str::trim(line[(colon + 1)..len(line)]);
        }
    }
    return "";
}

// The request as Grafana must see it: the browser's lines but the
// connection's framing, its credentials and any `X-Hale-*`, then the
// person's name on Grafana's header ("" for none), the body's length and a
// close.
fn grafana_request(req: std::http::Request, header: String, person: String) -> String {
    let mut lines = "";
    let mut rest = req.headers;
    while len(rest) > 0 {
        let cut = std::str::index_of(rest, "\r\n");
        let line = if cut < 0 { rest } else { rest[0..cut] };
        rest = if cut < 0 { "" } else { rest[(cut + 2)..len(rest)] };
        let name = lower_name(line);
        if len(name) > 0
            && !std::str::starts_with(name, "x-hale-")
            && name != "authorization"
            && name != "connection"
            && name != "content-length"
            && name != "transfer-encoding"
            && name != "keep-alive"
            && name != "expect"
            && name != "upgrade"
        {
            lines = lines + line + "\r\n";
        }
    }
    if len(person) > 0 { lines = lines + header + ": " + person + "\r\n"; }
    if req.method != "GET" && req.method != "HEAD" || len(req.body) > 0 {
        lines = lines + "Content-Length: " + to_string(len(req.body)) + "\r\n";
    }
    return req.method + " " + req.path + " HTTP/1.1\r\n" + lines + "Connection: close\r\n\r\n"
        + req.body;
}

// The organization shell's address when `/` lands elsewhere (a habitat's
// face lands on its operator face, `dna::face_home`).
const ORGANIZATION_PATH: String = "/organization";

// A redirect to a path of this face.
fn moved(to: String) -> std::http::Response {
    return std::http::Response {
        status: 302,
        content_type: "text/plain; charset=utf-8",
        headers: "Location: " + to + "\r\nCache-Control: no-store",
        body: "",
    };
}

fn refusal(status: Int, code: String, message: String) -> std::http::Response {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("api_version", "hale.v1");
    b.begin_object_field("error");
    b.string_field("code", code);
    b.string_field("message", message);
    b.end_object();
    b.end_object();
    return std::http::Response {
        status: status,
        content_type: "application/json",
        headers: "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff",
        body: b.result(),
    };
}

// One whole exchange with the head: `text` sent, the answer read to the
// close and parsed to its status, head lines and body.
fn buffered(head_port: Int, text: String) -> Answer {
    let fd = std::io::tcp::connect(dna::listen_dial_host(), head_port) or - 1;
    if fd < 0 { return Answer { }; }
    let armed = std::io::tcp::__set_recv_timeout_ns(fd, RELAY_RECV_NS);
    let up = std::io::tcp::Stream { conn_fd: fd };
    up.send(text) or discard;
    let got = std::bytes::BytesBuilder { };
    let mut total = 0;
    let mut reading = true;
    while reading {
        let n = std::io::tcp::recv_into(fd, got, 65536);
        if n <= 0 { reading = false; } else {
            total = total + n;
            if total > BUFFER_LIMIT { reading = false; }
        }
    }
    let raw = got.finish() or b"";
    let all = std::str::from_bytes(raw);
    let split = std::str::index_of(all, "\r\n\r\n");
    if split < 0 || total > BUFFER_LIMIT || len(all) < 12 { return Answer { }; }
    let status = std::str::parse_int(all[9..12]) or 0;
    return Answer {
        ok: status >= 100,
        status: status,
        head: all[0..split],
        body: all[(split + 4)..len(all)],
        raw: raw,
    };
}

// One read from the head, written to the browser: the bytes moved, 0 at
// the head's close, a deadline or a browser that went away. A fn of its
// own, so a long stream's scratch is released with every chunk.
fn pump(from: Int, to: Int, buf: std::bytes::BytesBuilder) -> Int {
    buf.clear();
    let n = std::io::tcp::recv_into(from, buf, 65536);
    if n <= 0 { return 0; }
    let chunk = buf.snapshot() or b"";
    let mut ok = true;
    std::io::tcp::send_fd(to, chunk) or { ok = false; };
    if !ok { return 0; }
    return n;
}

locus Face {
    params {
        web: assets::WebAssets;
        head_port: Int = 0;
    }

    // `raw` written to the browser's connection as it is, and the
    // connection closed.
    fn hand_over(req: std::http::Request, raw: Bytes) -> std::http::Response {
        if req.conn_fd < 0 {
            return refusal(
                500,
                "internal",
                "an answer is written to its connection, and this request has none",
            );
        }
        std::io::tcp::send_fd(req.conn_fd, raw) or discard;
        std::io::tcp::close_fd(req.conn_fd);
        return std::http::Response { status: 200, body: "", takeover_raw: true };
    }

    // The head's answer to `req`, relayed chunk by chunk until the head or
    // the browser closes: an event stream is held open this way.
    fn relay(req: std::http::Request) -> std::http::Response {
        return self.relay_to(
            req,
            dna::listen_dial_host(),
            self.head_port,
            head_request(req, self.head_port),
            "the head",
        );
    }

    // `text` sent to `host:port` for `req`, and its answer relayed to the
    // browser chunk by chunk until either closes. `who` names the server
    // in a refusal.
    fn relay_to(
        req: std::http::Request,
        host: String,
        port: Int,
        text: String,
        who: String
    ) -> std::http::Response {
        if req.conn_fd < 0 {
            return refusal(
                500,
                "internal",
                "an answer is written to its connection, and this request has none",
            );
        }
        let fd = std::io::tcp::connect(host, port) or - 1;
        if fd < 0 {
            return refusal(502, "head_unreachable", who + " does not answer on the loopback");
        }
        let armed = std::io::tcp::__set_recv_timeout_ns(fd, RELAY_RECV_NS);
        std::io::tcp::set_send_timeout(req.conn_fd, 10s) or discard;
        let up = std::io::tcp::Stream { conn_fd: fd };
        let mut sent = true;
        up.send(text) or { sent = false; };
        if !sent { return refusal(502, "head_unreachable", who + " did not take the request"); }
        let buf = std::bytes::BytesBuilder { };
        let mut wrote = false;
        let mut live = true;
        while live {
            let moved = pump(fd, req.conn_fd, buf);
            if moved > 0 { wrote = true; } else { live = false; }
        }
        if !wrote { return refusal(502, "head_unreachable", who + " closed without an answer"); }
        std::io::tcp::close_fd(req.conn_fd);
        return std::http::Response { status: 200, body: "", takeover_raw: true };
    }

    // The attached project's `ui/` page: the head says which project is
    // attached, to the person whose session this is.
    fn head_read(req: std::http::Request) -> Answer {
        return buffered(
            self.head_port,
            std::str::replace(
                head_request(req, self.head_port),
                req.method + " " + req.path + " ",
                "GET " + HEAD_READ + " ",
            ),
        );
    }

    fn app_asset(req: std::http::Request, path: String) -> std::http::Response {
        let read = self.head_read(req);
        if !read.ok {
            return refusal(502, "head_unreachable", "the head does not answer on the loopback");
        }
        if read.status != 200 { return self.hand_over(req, read.raw); }
        let active = std::json::find_field_raw(
            std::json::find_field_raw(read.body, "data"),
            "active",
        );
        let root = std::json::find_string_field(active, "root");
        if len(root) == 0 {
            return refusal(503, "head_detached", "the head has no attached project");
        }
        let a = ops::application_asset(root, path);
        if a.status != 200 { return refusal(404, "not_found", a.why); }
        let head = "HTTP/1.1 200 OK\r\nContent-Type: " + a.content_type + "\r\nContent-Length: "
            + to_string(len(a.bytes))
            + "\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nConnection: close\r\n\r\n";
        return self.hand_over(req, std::bytes::concat(std::bytes::from_string(head), a.bytes));
    }

    // The record's index: the head's read first, as for `/app/` (the person's
    // session is the gate, and the head's refusal is passed on), then the page
    // generated from the head's surface, read through a client that presents
    // the visitor's own cookies.
    fn index_page(req: std::http::Request) -> std::http::Response {
        let read = self.head_read(req);
        if !read.ok {
            return refusal(502, "head_unreachable", "the head does not answer on the loopback");
        }
        if read.status != 200 { return self.hand_over(req, read.raw); }
        let reader = IndexReader {
            head_port: self.head_port,
            cookie: std::http::header(req, "Cookie"),
        };
        let page = index_page(reader.read(), std::http::header(req, "Host"));
        return std::http::Response {
            status: 200,
            content_type: "text/html; charset=utf-8",
            headers: "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nContent-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
            body: page,
        };
    }

    // The habitat's Grafana, for the person the head's gate names.
    fn grafana(req: std::http::Request, path: String, cut: Int) -> std::http::Response {
        let port = integer(env_or_empty("HALE_DNA_GRAFANA_PORT"), 65535);
        let header = env_or_empty("HALE_DNA_GRAFANA_HEADER");
        if port < 1 || len(header) == 0 {
            return refusal(404, "not_found", "this face serves no Grafana");
        }
        if req.method == "GET" && path == GRAFANA_PREFIX {
            return moved(
                GRAFANA_PREFIX + "/" + (if cut < 0 { "" } else { req.path[cut..len(req.path)] }),
            );
        }
        let mut person = "";
        if !std::str::starts_with(path, GRAFANA_PREFIX + "/public/") {
            let mut at_root = req;
            at_root.method = "GET";
            at_root.path = "/";
            at_root.body = "";
            let gate = buffered(self.head_port, head_request(at_root, self.head_port));
            if !gate.ok {
                return refusal(502, "head_unreachable", "the head does not answer on the loopback");
            }
            if gate.status != 204 { return self.hand_over(req, gate.raw); }
            person = answer_header(gate.head, "x-hale-person");
            if len(person) == 0 {
                return refusal(403, "forbidden", "the head named no person for this session");
            }
        }
        return self.relay_to(
            req,
            "127.0.0.1",
            port,
            grafana_request(req, header, person),
            "Grafana",
        );
    }

    fn handle(req: std::http::Request) -> std::http::Response {
        let cut = std::str::index_of(req.path, "?");
        let path = if cut < 0 { req.path } else { req.path[0..cut] };
        if path == GRAFANA_PREFIX || std::str::starts_with(path, GRAFANA_PREFIX + "/") {
            return self.grafana(req, path, cut);
        }
        // the app's directory: its pages' relative paths resolve under `/app/`
        if req.method == "GET" && path == ops::APP_ASSETS_PREFIX {
            return moved(
                ops::APP_ASSETS_PREFIX + "/"
                    + (if cut < 0 { "" } else { req.path[cut..len(req.path)] }),
            );
        }
        if req.method == "GET"
            && (
                path == ops::APP_ASSETS_PREFIX
                    || std::str::starts_with(path, ops::APP_ASSETS_PREFIX + "/")
            )
        {
            return self.app_asset(req, path);
        }
        if req.method == "GET" && path == "/index" { return self.index_page(req); }
        if req.method == "GET" && (path == "/" || path == ORGANIZATION_PATH) {
            // the head's gate at `/`: 204 lets the shell out, anything else is the head's to say
            let mut at_root = req;
            at_root.path = if path == "/" { req.path } else { "/" };
            let gate = buffered(self.head_port, head_request(at_root, self.head_port));
            if !gate.ok {
                return refusal(502, "head_unreachable", "the head does not answer on the loopback");
            }
            if gate.status != 204 { return self.hand_over(req, gate.raw); }
            let home = dna::face_home();
            if path == "/" && len(home) > 0 { return moved(home); }
            return self.web.response("/");
        }
        if req.method == "GET" && self.web.serves(path) && cut < 0 {
            return self.web.response(path);
        }
        return self.relay(req);
    }
}

// The F.3 rule: the loaded assets reach the server literal through a
// parameter, never from a `let` in the same scope.
fn serve_face(port: Int, web: assets::WebAssets, head_port: Int) {
    FaceMain {
        srv: std::http::Server {
            host: dna::listen_host(),
            port: port,
            ready_signal: "hale dna face: http://127.0.0.1:" + to_string(port) + "/",
            handler: Face { web: web, head_port: head_port },
        },
    };
}

// It must be the program's own `main locus`: the server off the main pool,
// and a SIGTERM drains it.
main locus FaceMain {
    params {
        srv: std::http::Server;
    }
    placement { srv: cooperative(pool = io); }
    run() {
        while !self.draining {
            std::time::sleep(100ms);
        }
    }
}

fn main() {
    let port = integer(std::env::arg_or(1, ""), 65535);
    let webroot = std::env::arg_or(2, "");
    let head_port = integer(std::env::arg_or(3, ""), 65535);
    if port < 1
        || head_port < 1
        || port == head_port
        || len(webroot) == 0
        || std::str::contains(webroot, "\n")
        || std::str::contains(webroot, "\r")
    {
        eprintln(USAGE);
        std::process::exit(2);
    }
    let web = assets::WebAssets { };
    if !web.load(webroot) {
        eprintln("hale dna face: " + web.error + "; refusing to start");
        std::process::exit(2);
    }
    serve_face(port, web, head_port);
}
