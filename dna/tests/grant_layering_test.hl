// dna/tests/grant_layering_test.hl — GH #596, layering: a child's grant
// is contained in its parent's CURRENT grant, not the grant at birth.
//
// Grants contract on their own (two failures in a row halve the
// ceiling), so a child ceiling of 80 under a parent ceiling of 100
// stops fitting when the parent contracts to 50. The child's boundary
// reads its grant through the parent's at every assessment; a child
// born wider than the ceiling is refused in the record and bound by
// it; a contraction of the ceiling is journaled naming the children it
// now binds.

import "../core" as dna;

main locus App {
    params {
        wide: dna::AutonomyBoundary = dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs refactor feature", max_magnitude: 8, review: "post" } };
        dna: dna::Dna = dna::Dna {
            journal: dna::MemJournal { },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs refactor", max_magnitude: 8, review: "pre" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs refactor feature", max_magnitude: 10, review: "post" } }
        };
        // GH #605: born wider in money, parties and routes than its ceiling
        born_rich: dna::Dna = dna::Dna {
            journal: dna::MemJournal { },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs", max_magnitude: 5, review: "pre", amounts: "GBP 50", counterparties: "acme", routes: "bank" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs", max_magnitude: 5, review: "pre", amounts: "USD 500" } }
        };
        born_wide: dna::Dna = dna::Dna {
            journal: dna::MemJournal { },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs feature organization", max_magnitude: 8, review: "post" } },
            ceiling: dna::AutonomyBoundary { child: "org", grant: dna::Grant { child: "org", classes: "docs refactor", max_magnitude: 5, review: "pre" } }
        };
    }
    @unbounded
    fn last(j: dna::Journal, kind: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    run() {
        // ---- the intersection: classes both allow, the smaller ceiling, the stricter review
        let child = dna::Grant { child: "app", classes: "docs refactor feature", max_magnitude: 8, review: "post" };
        let parent = dna::Grant { child: "org", classes: "docs feature", max_magnitude: 10, review: "sampled" };
        let i = dna::intersect_grants(child, parent);
        std::test::assert_eq_str(i.classes, "docs feature", "the classes both allow");
        std::test::assert_eq_int(i.max_magnitude, 8, "the smaller ceiling");
        std::test::assert_eq_str(i.review, "sampled", "the stricter review");
        std::test::assert(!i.may_expand_self, "never self-expanding");
        let none = dna::intersect_grants(child, dna::Grant { });
        std::test::assert_eq_int(none.max_magnitude, 8, "no ceiling is no ceiling");
        std::test::assert(dna::grant_within(dna::Grant { child: "a", classes: "docs", max_magnitude: 10, review: "pre" }, parent), "contained");
        std::test::assert(!dna::grant_within(child, parent), "wider in classes and review: not contained");

        // ---- a boundary assesses through its ceiling, as the ceiling is now
        self.wide.ceiling = dna::Grant { child: "org", classes: "docs refactor feature", max_magnitude: 10, review: "post" };
        let fits = dna::Magnitude { loci: 6 };
        let strong = dna::Evidence { check_clean: true, verify_clean: true, tests_pass: true, replay_ok: true, independent_reviews: 3, rollback_rehearsed: true };
        std::test::assert_eq_str(dna::disposition_name(self.wide.assess("docs", fits, strong)), "release", "6 fits a child of 8 under a parent of 10");
        self.wide.ceiling = dna::Grant { child: "org", classes: "docs refactor feature", max_magnitude: 5, review: "post" };
        std::test::assert_eq_str(dna::disposition_name(self.wide.assess("docs", fits, strong)), "escalate", "the same 6 no longer fits once the parent contracted to 5");
        std::test::assert_eq_int(self.wide.effective().max_magnitude, 5, "the effective grant is the parent's ceiling");

        // ---- through the substrate: the ceiling contracts on repeated failure,
        //      the record names the children it binds, and the child's next
        //      assessment is at the new ceiling
        std::test::assert_eq_int(self.dna.boundary.effective().max_magnitude, 8, "born within: the child's own ceiling");
        self.dna.ceiling_outcome(false);
        std::test::assert_eq_str(self.last(self.dna.journal, "grant.contracted"), "", "one failure contracts nothing");
        self.dna.ceiling_outcome(false);
        std::test::assert(std::str::contains(self.last(self.dna.journal, "grant.contracted"), "ceiling 10 -> 5") && std::str::contains(self.last(self.dna.journal, "grant.contracted"), "binds app"), "the contraction is in the record, naming the child: " + self.last(self.dna.journal, "grant.contracted"));
        let staged = self.dna.stage("docs", "sha256:cand", fits, strong);
        std::test::assert_eq_int(self.dna.boundary.effective().max_magnitude, 5, "assessed at the parent's new ceiling: " + staged);
        std::test::assert(std::str::contains(self.last(self.dna.journal, "mutation.escalate"), "docs"), "and 6 escalates now: " + staged);

        // ---- born wider than the ceiling: refused in the record, bound by it
        let refused = self.last(self.born_wide.journal, "grant.refused");
        std::test::assert(std::str::contains(refused, "wider than the ceiling `org` at birth") && std::str::contains(refused, "magnitude 8 under 5") && std::str::contains(refused, "review post under pre"), "the early error names what is wider: " + refused);
        self.born_wide.bind_ceiling();
        let bound = self.born_wide.boundary.effective();
        std::test::assert_eq_int(bound.max_magnitude, 5, "bound to the ceiling's magnitude");
        std::test::assert_eq_str(bound.classes, "docs", "and to the classes both allow");
        std::test::assert_eq_str(bound.review, "pre", "and to the stricter review");
        std::test::assert_eq_str(self.last(self.dna.journal, "grant.refused"), "", "a child born within is not refused");

        // ---- GH #605: resources contain the same way, field by field
        let pc = dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500.00 EUR 200", window_amounts: "USD 1000", window: "day", counterparties: "acme globex", routes: "bank card", expires: 2000000000 };
        let kid = dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 800 GBP 50", window_amounts: "USD 900", window: "day", counterparties: "acme initech", routes: "bank", authority_epoch: 2 };
        let ik = dna::intersect_grants(kid, pc);
        std::test::assert_eq_str(ik.amounts, "USD 500.00", "per operation: the currencies both grant, at the smaller ceiling");
        std::test::assert_eq_str(ik.window_amounts, "USD 900", "per window: the smaller limit");
        std::test::assert_eq_str(ik.counterparties, "acme", "the counterparties both name");
        std::test::assert_eq_str(ik.routes, "bank", "the routes both name");
        std::test::assert_eq_int(ik.expires, 2000000000, "the earlier expiry, and never is later than any");
        std::test::assert_eq_int(ik.authority_epoch, 2, "the epochs add, so either side advancing moves it");
        let gap = dna::resource_gap(kid, pc);
        std::test::assert(std::str::contains(gap, "USD 800 per operation under 500.00"), "a larger per-operation ceiling: " + gap);
        std::test::assert(std::str::contains(gap, "currency GBP not granted above"), "a currency the ceiling does not grant: " + gap);
        std::test::assert(std::str::contains(gap, "counterparties `initech` not granted above"), "a party the ceiling does not name: " + gap);
        std::test::assert(std::str::contains(gap, "expires never after 2000000000"), "a later expiry: " + gap);
        std::test::assert(!dna::grant_within(kid, pc), "wider in money, parties and time: not contained");
        let fits = dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 400", window_amounts: "USD 900", window: "day", counterparties: "acme", routes: "bank card", expires: 1900000000 };
        std::test::assert(dna::grant_within(fits, pc), "contained field by field: " + dna::resource_gap(fits, pc));
        let unlimited = dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 400", window: "day", counterparties: "acme", routes: "bank", expires: 1900000000 };
        std::test::assert(std::str::contains(dna::resource_gap(unlimited, pc), "USD unlimited per day under 1000 per day"), "no window limit under a ceiling that has one: " + dna::resource_gap(unlimited, pc));
        let weekly = dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post", amounts: "USD 400", window_amounts: "USD 900", window: "week", counterparties: "acme", routes: "bank", expires: 1900000000 };
        std::test::assert(std::str::contains(dna::resource_gap(weekly, pc), "window week under day"), "a window the ceiling does not share: " + dna::resource_gap(weekly, pc));
        let before = dna::Grant { child: "app", classes: "docs", max_magnitude: 8, review: "post" };
        let open_ceiling = dna::Grant { child: "org", classes: "docs", max_magnitude: 10, review: "post", amounts: "USD 500" };
        std::test::assert(dna::grant_within(before, open_ceiling), "a grant that names no resources is contained in a ceiling that does not expire: " + dna::resource_gap(before, open_ceiling));
        let only_time = dna::resource_gap(before, pc);
        std::test::assert(std::str::contains(only_time, "expires never after 2000000000") && !std::str::contains(only_time, "currency"), "under a ceiling that expires it is wider in time only, since never is later than any: " + only_time);
        std::test::assert_eq_str(dna::intersect_grants(before, pc).amounts, "", "and still spends nothing");
        std::test::assert_eq_int(dna::intersect_grants(before, pc).expires, 2000000000, "and is bound by the ceiling's expiry");
        let money_refusal = self.last(self.born_rich.journal, "grant.refused");
        std::test::assert(std::str::contains(money_refusal, "currency GBP not granted above") && std::str::contains(money_refusal, "counterparties `acme` not granted above") && std::str::contains(money_refusal, "routes `bank` not granted above"), "born wider in resources: refused at birth, naming each: " + money_refusal);
    }
}
fn main() { App { }; }
