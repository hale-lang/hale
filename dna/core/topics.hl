// dna/core/topics.hl — facts that cross a real boundary.
//
// Most transitions stay inside the owning locus and are read by the
// owner through `release(c)`. Topics exist only where a fact must
// cross an ownership tower, a placement, persistence, observation, or
// the external membrane (#521 "domain facts and topic families").

// Human/external intent entering the organism's membrane.
type IntentOffer { intent_id: String = ""; outcome: String = ""; from: String = ""; to: String = ""; kind: String = ""; }
topic IntentOffered { payload: IntentOffer; subject: "dna.intent.offered"; }

// GH #646 card 05: one transition of a workflow execution, proposed by the
// resident that owns it to the one committer (the journal's owner), and the
// committer's answer. `proposal_id` names the transition, not the message:
// the same transition proposed again carries the same id, is answered from
// what was committed, and the same id with anything else is a conflict
// (dna/WORKFLOW-CONTRACT.md §9).
type TransitionProposal {
    scope: String = ""; // which committer answers
    key: String = ""; // the proposer, and the answer's routing key
    proposal_id: String = "";
    kind: String = ""; // the fact this transition appends
    entity: String = "";
    body: String = ""; // the encoded fact (workflow_events.hl)
}
topic TransitionProposed { payload: TransitionProposal; subject: "dna.transition.proposed"; keyed_by scope; }

type TransitionAnswer {
    scope: String = "";
    key: String = "";
    proposal_id: String = "";
    ok: Bool = false;
    revision: Int = 0;
    why: String = "";
    // on a refusal, who refused: "state" (the transition has no basis in
    // the projection), "record" (the append was refused, or the record
    // moved too often — the transition may be proposed again), "conflict"
    // (the proposal disagrees with what its id committed, or with itself),
    // "fenced" (the committer no longer holds the lease its scope runs
    // under — card 12b — the transition may be proposed again once it does)
    basis: String = "";
}
topic TransitionAnswered { payload: TransitionAnswer; subject: "dna.transition.answered"; keyed_by key; }

// GH #646 workflow card 09: what the residents and the runtime say to
// each other. A Work asks the runtime to run an admitted attempt, by id
// (the runtime reads the admission from the record); the runtime answers
// every reply — the one that came back from the call and the one that
// came later — keyed by the Work; a Work that settled tells its Step,
// keyed by the Step; a Step that settled tells its owner.
type AttemptRequest { scope: String = ""; attempt_id: String = ""; work_id: String = ""; }
topic AttemptRequested { payload: AttemptRequest; subject: "dna.attempt.requested"; keyed_by scope; }
type AttemptReply {
    work_id: String = "";
    attempt_id: String = "";
    ok: Bool = false;
    ran: Bool = false;
    attached: Bool = false;
    reused: Bool = false;
    disposition: String = ""; // "" while the attempt is outstanding
    result: String = "";
    why: String = "";
}
topic AttemptReplied { payload: AttemptReply; subject: "dna.attempt.replied"; keyed_by work_id; }
type MemberSettlement { step_id: String = ""; key: String = ""; work_id: String = ""; disposition: String = ""; }
topic MemberSettled { payload: MemberSettlement; subject: "dna.member.settled"; keyed_by step_id; }
// A leaf that was never admitted and can no longer be — its first
// admission refused by the state under a Step that has durably settled
// — retires: no attempt, no claim, no effect to await. Not a
// settlement (a member has answered only once its settlement is in the
// record); its Step stops waiting for it.
type MemberRetirement { step_id: String = ""; key: String = ""; work_id: String = ""; why: String = ""; }
topic MemberRetired { payload: MemberRetirement; subject: "dna.member.retired"; keyed_by step_id; }
type StepSettlement { step_id: String = ""; task_id: String = ""; disposition: String = ""; failed_member: String = ""; why: String = ""; }
topic StepSettled { payload: StepSettlement; subject: "dna.step.settled"; keyed_by step_id; }
// GH #646 workflow card 10: a step that ended tells its workflow, by
// task, once it has drained — every admitted member settled or retired
// — so the workflow advances only behind a committed completion; a
// cancellation is asked of a workflow by task; a workflow that settled
// says so, by task, so its active step fences what it dispatched.
type StepDrain { task_id: String = ""; step_id: String = ""; step_index: Int = 0; disposition: String = ""; }
topic StepDrained { payload: StepDrain; subject: "dna.step.drained"; keyed_by task_id; }
type WorkflowCancel { task_id: String = ""; reason: String = ""; }
topic WorkflowCancelRequested { payload: WorkflowCancel; subject: "dna.workflow.cancel"; keyed_by task_id; }
// A step fenced by its workflow's cancellation tells the Works it
// dispatched — whatever the step's own outcome was: a step that had
// failed and was draining keeps its failure — so an attempt still out
// settles cancelled and one never admitted retires.
type StepFence { step_id: String = ""; task_id: String = ""; reason: String = ""; }
topic StepFenced { payload: StepFence; subject: "dna.step.fenced"; keyed_by step_id; }
type WorkflowSettlement { task_id: String = ""; disposition: String = ""; reason: String = ""; }
topic WorkflowSettled { payload: WorkflowSettlement; subject: "dna.workflow.settled"; keyed_by task_id; }
// GH #646 workflow card 11: child workflows. A step asks its Task for
// a child member's execution, by the parent task; the Task, which holds
// the bound recipe, cuts the subtree and asks the executions owner to
// admit and run it, by scope; a child that settled tells the step that
// spawned it, by that step; a workflow that left tells its Task.
type ChildRequest { parent_task: String = ""; step_id: String = ""; step_index: Int = 0; key: String = ""; child_task: String = ""; definition: String = ""; revision: Int = 0; }
topic ChildRequested { payload: ChildRequest; subject: "dna.child.requested"; keyed_by parent_task; }
type ChildAdmission {
    scope: String = "";
    task_id: String = "";
    workflow_id: String = "";
    parent_task: String = "";
    spawning_step: String = "";
    member_key: String = "";
    definition: String = "";
    revision: Int = 0;
    recipe: String = ""; // the bound subtree, the parent's recipe cut at the child
    kinds: String = ""; // "<key>=<performer kind>" per leaf key
    limits: AdmissionLimits = AdmissionLimits { };
    works: Int = 0;
    tasks: Int = 0;
    steps: Int = 0;
    depth: Int = 0;
}
topic ChildAdmitRequested { payload: ChildAdmission; subject: "dna.child.admit"; keyed_by scope; }
// A root execution asked of the executions owner: its admission is in
// the record already (card 07), and everything the execution is — its
// definition and bound revision, its recipe, its workflow identity, its
// limits — comes from the admission the projection accepted, never from
// the asker (card 13): an execution restored after a restart runs what
// it was admitted with, whatever the catalog offers now. The ask names
// the task, and which performer kind runs a leaf whose attempt is not
// yet admitted — an admitted attempt's kind is the record's. A child
// execution is not asked here: it is recovered through its parent.
// Card 18 wires it to the public admission: `Dna.ask` and
// `Dna.run_workflow` ask here, and a restart asks again for every
// admitted root not yet settled.
type ExecutionAsk {
    scope: String = "";
    task_id: String = "";
    kinds: String = "";
}
topic ExecutionAsked { payload: ExecutionAsk; subject: "dna.execution.asked"; keyed_by scope; }
// The owner asks the runtime for an execution's admission as the
// projection accepted it, under a question of its own identity; the
// runtime answers that question — the same scope, task and identity —
// or says why the execution cannot be resumed: never admitted, admitted
// with a row the projection refused, or a child of another Task. The
// owner holds the question outstanding and consumes the answer once.
type AdmissionAsk { scope: String = ""; ask_id: String = ""; task_id: String = ""; kinds: String = ""; }
topic AdmissionAsked { payload: AdmissionAsk; subject: "dna.admission.asked"; keyed_by scope; }
type AdmissionAnswer {
    scope: String = "";
    ask_id: String = "";
    task_id: String = "";
    kinds: String = "";
    admitted: Bool = false;
    definition: String = "";
    revision: Int = 0;
    workflow_id: String = "";
    recipe: String = "";
    limits: AdmissionLimits = AdmissionLimits { };
    why: String = "";
}
topic AdmissionAnswered { payload: AdmissionAnswer; subject: "dna.admission.answered"; keyed_by scope; }
// A Work asks the record what it holds about it before it proposes
// anything (card 13): its current attempt, if one is admitted — that
// attempt's number, id and performer kind are the record's, never the
// ask's — and whether it has settled. The question carries the Work's
// scope and an identity of its own; the answer carries both back, and
// the Work takes only the answer to its one outstanding question, once:
// a same-named Work in another scope's record — ids are minted within a
// record — is not this Work, and its record's answer is not this one's.
type WorkStateAsk { scope: String = ""; ask_id: String = ""; work_id: String = ""; }
topic WorkStateAsked { payload: WorkStateAsk; subject: "dna.work.state.asked"; keyed_by scope; }
type WorkState {
    scope: String = "";
    ask_id: String = "";
    work_id: String = "";
    attempted: Bool = false;
    attempt_id: String = "";
    attempt_no: Int = -1;
    performer_kind: String = "";
    attempt_disposition: String = "";
    disposition: String = "";
}
topic WorkStateAnswered { payload: WorkState; subject: "dna.work.state.answered"; keyed_by work_id; }
// An execution the owner would not run: what it was asked for and why.
type ExecutionRefusal { scope: String = ""; task_id: String = ""; why: String = ""; }
topic ExecutionRefused { payload: ExecutionRefusal; subject: "dna.execution.refused"; keyed_by scope; }
type ChildSettlement { step_id: String = ""; key: String = ""; task_id: String = ""; disposition: String = ""; }
topic ChildSettled { payload: ChildSettlement; subject: "dna.child.settled"; keyed_by step_id; }
// A child that left — its workflow drained and reclaimed — tells the
// step that spawned it, by that step: the step's drain waits for this,
// not for the child's settlement, so a tree reclaims from the leaves up.
type ChildLeave { step_id: String = ""; key: String = ""; task_id: String = ""; }
topic ChildLeft { payload: ChildLeave; subject: "dna.child.left"; keyed_by step_id; }
type WorkflowLeave { task_id: String = ""; }
topic WorkflowLeft { payload: WorkflowLeave; subject: "dna.workflow.left"; keyed_by task_id; }
// GH #646 workflow card 12a: what the record holds about one execution,
// asked of the runtime by its workflow before it starts — restored after
// a restart or fresh, the same question — and answered from the
// projection: an execution the record has settled is over, whatever is
// in memory.
type ExecutionStateAsk { scope: String = ""; task_id: String = ""; }
topic ExecutionStateAsked { payload: ExecutionStateAsk; subject: "dna.execution.state.asked"; keyed_by scope; }
type ExecutionState {
    task_id: String = "";
    admitted: Bool = false;
    disposition: String = "";
    reason: String = "";
    outstanding: Int = 0; // the responsibilities of a cancelled execution still undrained: Works with an admitted attempt and no settlement, and admitted descendant Tasks not yet settled
    current_step: Int = 0; // the first step the record has not completed
    cancelled_above: String = ""; // the durable fence over the execution's ancestry (card 18, review: a restored child reads it from the record, not from a fence published before it existed)
}
topic ExecutionStateAnswered { payload: ExecutionState; subject: "dna.execution.state.answered"; keyed_by task_id; }
// The record is writable again: a resident holding a transition the
// record refused proposes it again. Published by whoever knows — the
// host after a reconnect, a fixture — keyed by the committer's scope.
type RecordResume { scope: String = ""; why: String = ""; }
topic RecordResumed { payload: RecordResume; subject: "dna.record.resumed"; keyed_by scope; }
// what a resident says about its own life, for the owner and the proofs
type RunLife { key: String = ""; what: String = ""; }
topic RunLives { payload: RunLife; subject: "dna.run.life"; }

// Upward-only signals (child -> supersystem).
// GH #986: pressure is a row first, like a concern: `request` is the id
// of the `pressure.requested` row this came from, which the node relays
// until the organization's `pressure.raised` names it.
type Pressure { source: String = ""; what: String = ""; count: Int = 0; request: String = ""; }
topic PressureRaised { payload: Pressure; subject: "dna.pressure.raised"; }

// What a `pressure.raised` row carries: the signal's words, how often its
// source has raised pressure, and the request it answers. A row from
// before GH #986 is `<what> x<n>`, which `pressure_what` still reads.
fn pressure_body(what: String, count: Int, request: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("what", what);
    b.int_field("count", count);
    b.string_field("request", request);
    b.end_object();
    return b.result();
}

fn pressure_what(body: String) -> String {
    let named = std::json::find_string_field(body, "what");
    if len(named) > 0 { return named; }
    let x = std::str::index_of(body, " x");
    return if x > 0 { body[0..x] } else { body };
}

// GH #689: `request` is the id of the `concern.requested` row this came
// from, "" when it was raised live. A concern's entity is its source, so
// several concerns share one entity and only this id tells the host which
// request an answer answered.
type Concern { source: String = ""; what: String = ""; severity: Int = 0; request: String = ""; }
topic ConcernRaised { payload: Concern; subject: "dna.concern.raised"; }

// GH #986: a row a node's view of the organism gained — the record's or
// the ledger's, `seq` its place in the merged order — told on the nerves
// once, by that node. A head (the face's) hears that something changed
// and reads again: this is never a second data path, the record is. Its
// subject is a head's family, `head.`, not `dna.`: no organization's
// durable consumer pulls it.
type LandedRow { seq: Int = 0; kind: String = ""; entity: String = ""; }
topic RowLanded { payload: LandedRow; subject: "head.row.landed"; }

// What a concern row carries, written as one object rather than as prose
// with a marker appended (GH #689, second review). A concern's text is
// whatever a worker wrote, and text that looks like metadata must not be
// read as metadata: with a marker appended, a concern reading
// `observed [request c1] in a log` answered request c1. Here the text is
// one escaped string field among others, and the reader asks for the
// `request` member of the object — the JSON cursor walks the object's own
// members and never looks inside a string value, so `[request c1]` in the
// text is text.
//
// Rows written before this rule are prose and carry no object; every
// reader below answers "" or 0 for them, and the host matches those by
// counting, as it did before ids existed.
fn concern_body(what: String, severity: Int, occurrence: Int, request: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("what", what);
    b.int_field("severity", severity);
    b.int_field("occurrence", occurrence);
    b.string_field("request", request);
    b.end_object();
    return b.result();
}

// Why a concern under an id already used was refused, as an object, so
// the refusal is that request's answer and can be found by its id.
fn concern_refusal_body(why: String, request: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("why", why);
    b.string_field("request", request);
    b.end_object();
    return b.result();
}

fn request_named(body: String) -> String {
    return std::json::find_string_field(body, "request");
}

fn concern_what(body: String) -> String {
    return std::json::find_string_field(body, "what");
}

fn concern_severity(body: String) -> Int {
    return std::json::find_int_field(body, "severity");
}

// Whether a recorded concern row carries the same concern as this one:
// the whole payload a request is allowed to carry, not a prefix of its
// display text. One id used for a second, different concern — other
// words, or the same words at another severity — is a conflict.
fn same_concern(body: String, what: String, severity: Int) -> Bool {
    return concern_what(body) == what && concern_severity(body) == severity;
}

// A person proposes a practice for the whole organization (GH #602): a
// named text the Board ratifies, with who proposed it and what prompted it.
type PracticeRequest {
    request_id: String = "";
    name: String = "";
    text: String = "";
    by: String = "";
    because: String = "";
    supersedes: String = "";
}
topic PracticeRequested { payload: PracticeRequest; subject: "dna.practice.requested"; }

// GH #1091: someone proposes who holds a position. The organization
// proposes it to the Board as a graph proposal, whose receipt carries the
// `holds` edge, and the projection writes the edge once it is ratified,
// checking it again (the same-holder rule, a retired holder).
type HoldRequest {
    request_id: String = "";
    position: String = ""; // `position:<name>`
    holder: String = "";
    by: String = ""; // who proposes it: the review's author, who may not ratify it
}
topic HoldRequested { payload: HoldRequest; subject: "dna.hold.requested"; }

// A scoped native command asks the Body to propose a generic Knowledge node.
// Admission supplies the exact candidate and binding scope; Review still owns
// adoption. request_id is the command's durable identity, not a graph node ID.
type KnowledgeNodeRequest {
    request_id: String = "";
    operation: String = "";
    kind: String = "";
    name: String = "";
    text: String = "";
    author: String = "";
    target: String = "";
    supersedes: String = "";
    by: String = "";
    because: String = "";
    candidate_digest: String = "";
}
topic KnowledgeNodeRequested { payload: KnowledgeNodeRequest; subject: "dna.knowledge.node.requested"; }

// One reviewed change to an existing item's exact locus binding. The scoped
// command and captured grant are distinct from the authoring locus.
type KnowledgeBindingRequest {
    application_id: String = ""; request_id: String = "";
    command_fingerprint: String = ""; authority: String = ""; authority_basis: String = "";
    operation: String = ""; idea_id: String = ""; binding_id: String = "";
    author: String = ""; target: String = ""; by: String = ""; because: String = "";
    binding_basis: String = ""; candidate_digest: String = "";
}
topic KnowledgeBindingRequested { payload: KnowledgeBindingRequest; subject: "dna.knowledge.binding.requested"; }

// One exact directed relationship change under an independently settled Review.
type KnowledgeEdgeRequest {
    application_id: String = "";
    request_id: String = "";
    command_fingerprint: String = "";
    authority: String = "";
    authority_basis: String = "";
    operation: String = "";
    edge_id: String = "";
    from_id: String = "";
    to_id: String = "";
    rel: String = "";
    by: String = "";
    because: String = "";
    edge_basis: String = "";
    candidate_digest: String = "";
}
topic KnowledgeEdgeRequested { payload: KnowledgeEdgeRequest; subject: "dna.knowledge.edge.requested"; }

// The durable Organization source request is re-read by exact identity. Large
// prepared source and retained dependency metadata never travel in argv.
type OrganizationSourceTrigger { request_id: String = ""; }
topic OrganizationSourceRequested { payload: OrganizationSourceTrigger; subject: "dna.organization.source.requested"; }

// Review requests and verdicts cross the membrane (a human answers).
type ReviewRequest {
    review_id: String = "";
    question: String = "";
    subject_digest: String = ""; // exact candidate under review (TOCTOU pin)
    required_authority: String = "";
    // GH #566 F2: what a position deciding it needs — the mutation, its
    // class and disposition under the grant, the base to diff from, the
    // receipts (by digest) and the evidence line
    mutation_id: String = "";
    change_class: String = "";
    seed: String = ""; // the seed the change edits ("" = the genome's)
    disposition: String = "";
    base_commit: String = "";
    diff_text: String = "";
    evidence: String = "";
    magnitude: String = "";
}
topic ReviewRequested { payload: ReviewRequest; subject: "dna.review.requested"; }

type Verdict {
    command_id: String = ""; // durable caller-scoped admission, empty for legacy verdicts
    review_id: String = "";
    subject_digest: String = ""; // must equal the request's, or the verdict is refused
    verdict: String = ""; // "approve" | "revise" | "reject" | "abstain"
    reviewer: String = "";
    authority: String = ""; // the authority the reviewer claims
    comment: String = "";
}
topic ReviewVerdict { payload: Verdict; subject: "dna.review.verdict"; keyed_by review_id; }

// A Review settled (or refused a verdict): the owning Review announces
// it, the assembly journals it. The decision stays with the Review;
// this is the record of it (GH #528 `hale dna status`).
type ReviewSettlement {
    command_id: String = ""; // the exact review.command_decided that precedes this notification
    review_id: String = "";
    outcome: String = ""; // "approve" | "revise" | "reject" | "" when a verdict was refused
    decided_by: String = "";
    refusal: String = ""; // non-empty when a verdict was refused, with the reason
    comment: String = ""; // the deciding verdict's comment: a person's note, a model's reasoning (GH #566 F7)
    // A settled approval approved AGAIN by a verdict the Review admitted
    // in full — digest, authority, independence — so an approved
    // candidate that never applied can be applied. Never set for any
    // other verdict at a settled Review: those are refused.
    reapproval: Bool = false;
}
topic ReviewSettled { payload: ReviewSettlement; subject: "dna.review.settled"; }

// GH #596 L: an ask, before it becomes work — the leader says what it
// is. The assembly asks; the leader answers with a plan that only
// splits and classifies, never widens; the assembly journals it as
// `task.planned` and proceeds under the class and target it names.
type PlanRequest {
    org: String = "org"; // keys the exchange with this organism's leader
    task_id: String = "";
    work_id: String = "";
    objective: String = "";
    target: String = "";
    requires: String = "";
    data_class: String = "internal";
}
type Plan {
    org: String = "org";
    task_id: String = "";
    work_id: String = "";
    kind: String = "appendage"; // "organism" | "appendage" | "product" | "person" (not a software change)
    change_class: String = "application";
    target: String = "";
    count: Int = 1; // one change, or several
    narrative: String = "";
    package: String = ""; // the knowledge package the plan read ("" = none)
    by: String = "";
    assignee: String = ""; // who does it, when kind is person (GH #604 rule 4)
    obligation: String = ""; // the class of obligation a person's job discharges (GH #616)
    parsed: Bool = false; // the model's answer named a kind and a class; else the defaults stand
}
topic PlanRequested { payload: PlanRequest; subject: "dna.plan.requested"; keyed_by org; }

// GH #596 O: the optimize pass. On a cadence the org chart sets, the
// substrate reads the record's structural signals and asks the
// leader to walk the machinery, not the work; the leader answers with
// one small proposal or none, and the substrate journals `org.reviewed`
// either way. "If the state is clean, say so."
type OptimizeRequest {
    org: String = "org";
    signals: String = "";
}
type OrgReview {
    org: String = "org";
    proposal: String = ""; // "" = clean
    narrative: String = "";
    package: String = "";
    by: String = "";
}
// The parent supplies a clock; the organism processes it on the same
// owner queue as incoming work. A tick may refresh the journal, whose
// cached view must be complete before another handler reads or appends.
type TickRequest { org: String = "org"; now: Int = 0; }
topic TickRequested { payload: TickRequest; subject: "dna.tick.requested"; keyed_by org; }

topic OptimizeRequested { payload: OptimizeRequest; subject: "dna.optimize.requested"; keyed_by org; }
topic OrgReviewed { payload: OrgReview; subject: "dna.org.reviewed"; keyed_by org; }
topic TaskPlanned { payload: Plan; subject: "dna.task.planned"; keyed_by org; }

// A recorded model call (inside an Attempt; never a Work of its own):
// the evidence list from #521 comment 1. Published by the backend
// that made the call on `ModelCalled`; the assembly journals it.
type ModelEvidence {
    attempt_id: String = "";
    adapter: String = ""; // "openai-chat" | "local" | "fake"
    backend: String = ""; // the router-facing name ("quick", "deep", "private")
    endpoint: String = ""; // where the prompt went (never the credential)
    credential: String = ""; // the credential's fingerprint (a correlation handle), or ""
    requested_model: String = "";
    reported_model: String = ""; // what the endpoint said it ran
    params: String = ""; // decoding knobs as sent, "temperature=0.0 max_tokens=512"
    prompt_digest: String = "";
    context_digest: String = "";
    // GH #611: the prompt and the context as sent. The substrate files
    // them as receipts under the two digests above (a customer-class
    // call stores neither); the `model.called` row carries only the
    // digests.
    prompt: String = "";
    context: String = "";
    knowledge_bindings: String = ""; // ids of the bindings the context was assembled from
    tool_grant: String = ""; // tools offered on this call, "" when none
    response_digest: String = "";
    artifact_digest: String = ""; // digest of what the attempt produced from it, when known
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    elapsed: String = ""; // wall time of the call, as a Duration renders
    cost_micros: Int = 0;
    validation: String = ""; // what was checked on the response ("json", "schema:X", "")
    retry_of: String = ""; // the previous call in this attempt this one retries, or ""
    data_class: String = "";
    ok: Bool = false;
    refused: String = "";
}
topic ModelCalled { payload: ModelEvidence; subject: "dna.model.called"; }

// GH #529 D6: what became of the expression after an apply. The host
// (`hale dna run`) rebuilds and restarts on the organism's request,
// watches the observation window, and reports back on the membrane;
// the organism decides whether the Mutation is retained or rolled back.
type Observation {
    mutation_id: String = "";
    outcome: String = ""; // "healthy" | "crashed" | "build_failed"
    model_hash: String = ""; // the shape hash the restarted expression reports
    detail: String = "";
}
topic ExpressionObserved { payload: Observation; subject: "dna.expression.observed"; }

// ---- card 15: edit outcomes through Work completion -------------------
// An edit leaf's attempt, handed to the assembly that owns the editor,
// its gateway and its record: the performer of kind `edit` publishes it
// and answers pending; the assembly performs — or, for a Work whose
// contract is the review's outcome, waits — and reports the outcome
// for this exact attempt.
type EditAsk { scope: String = ""; attempt_id: String = ""; performer: String = ""; request: WorkRequest = WorkRequest { }; }
topic EditRequested { payload: EditAsk; subject: "dna.edit.requested"; keyed_by scope; }
// The outcome of one attempt, reported for it by the adapter that did
// the work — into the generic lifecycle: the runtime settles that
// attempt, and only it, and the Work answers its step as any Work does.
type AttemptReport { scope: String = ""; attempt_id: String = ""; result: WorkResult = WorkResult { }; }
topic AttemptReported { payload: AttemptReport; subject: "dna.attempt.reported"; keyed_by scope; }

// ---- card 16: a human Work's case ---------------------------------------
// A human leaf's attempt, handed to the assembly that owns the people,
// the practices and the record: the performer of kind `human` publishes
// it and answers pending; the assembly admits the Work's case — its own
// handed Task, `<task>.s<i>.<key>` — and leaves the attempt pending until
// the person reports the case done.
type CaseAsk { scope: String = ""; attempt_id: String = ""; performer: String = ""; request: WorkRequest = WorkRequest { }; }
topic CaseRequested { payload: CaseAsk; subject: "dna.case.requested"; keyed_by scope; }

// ---- GH #946 slice 3: a leg's outcome for the attempt it claimed --------
// A leg claims an admitted, outstanding attempt at the head
// (`dna.attempt.claim`: memory's claim on the attempt id with a TTL,
// and an `attempt.claimed` row naming the holder, its token and until
// when) and hands its outcome back through `dna.attempt.outcome`: an
// `attempt.outcome_requested` row the head writes once the lease still
// holds, which a node relays here. The owner settles it as it settles
// every reply (`AttemptReported`), or refuses it with an
// `attempt.outcome_refused` row naming why; either answers the row. The
// calls the leg made are its evidence, journaled as `model.called` on
// the attempt id, so tokens per task hold out of process.
type WorkSubmission {
    attempt_id: String = "";
    holder: String = ""; // the performer the claim was taken for
    token: Int = 0; // the claim's fencing token, as the lease was granted
    disposition: String = ""; // done | failed | declined | timeout
    result: String = "";
    result_ref: String = "";
    narrative: String = "";
    evidence_ref: String = ""; // the receipts filed with the outcome, digests space-separated
    calls: String = ""; // the model calls made under the attempt, a JSON array of evidence objects
    request: String = ""; // the command id the row answers
    at: Int = 0; // when the head admitted it: the lease is judged as of then
    // GH #946 hardening: the hat the leg wore, for the outcome row
    hat_digest: String = "";
    hat_head: String = "";
    hat_watermark: Int = -1;
    prompt_digest: String = "";
    renderer: String = "";
}
topic WorkSubmit { payload: WorkSubmission; subject: "dna.work.submit"; }
