// dna/tests/record_identity_test.hl — two projects created alike are two
// records (GH #1068).
//
// A record's identity is the sha of its journal's first commit, and
// memory's schema and roles and the nerves' subjects, stream and consumer
// all derive from it. The first commit's content comes from the project,
// which a scaffold makes the same: created by one author, from one
// scaffold, in one second, two projects had one identity, and each
// organization heard and answered the other's facts. The dates are
// pinned here so the collision would be certain; the first commit's
// nonce is what keeps the two apart.
//
// GH #1590: the genome pins the identity (`[dna] record` in hale.toml),
// and a pin that names another record than the clone's is refused, by
// memory and by `init` and `upgrade`, rather than read into the other
// record's memory.

import "../core" as dna;

// The project's hale.toml with its `[dna] record` line replaced by `line`.
fn repin(app: String, line: String) -> Bool {
    let r = dna::run_tool("sh\n-c\nsed -i \"s/^record = .*$/$2/\" \"$1/hale.toml\"\nsh\n" + app + "\n" + line);
    return r.code == 0;
}

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// `hale dna new app` in `dir`, as one author at one pinned moment.
fn new_app(dir: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\nmkdir -p \"$1\" && cd \"$1\" && export GIT_AUTHOR_DATE=2026-09-25T12:00:00Z GIT_COMMITTER_DATE=2026-09-25T12:00:00Z GIT_AUTHOR_NAME=riley GIT_AUTHOR_EMAIL=riley@dna GIT_COMMITTER_NAME=riley GIT_COMMITTER_EMAIL=riley@dna HALE_DNA_DISCOVER=off && exec \"$2\" dna new app\nsh\n" + dir + "\n" + toolchain());
}

main locus App {
    // With the manifest at `app` written as `text`: true when the identity
    // read is `id` ("" for none), or the refusal says `why`.
    fn reads(app: String, text: String, id: String, why: String) -> Bool {
        std::io::fs::write_file(app + "/hale.toml", text) or discard;
        let r = dna::record_identity_at(app);
        let ok = r.id == id && (if len(why) == 0 { len(r.why) == 0 } else { std::str::contains(r.why, why) });
        if !ok { eprintln("for ", text, ": id `", r.id, "`, why `", r.why, "`"); }
        return ok;
    }
    run() {
        let scratch = dna::scratch_root("record-identity");
        let a = new_app(scratch + "/a");
        let b = new_app(scratch + "/b");
        std::test::assert(a.code == 0 && b.code == 0, "two projects, created alike: " + a.stderr + b.stderr);
        let ja = dna::GitJournal { repo: scratch + "/a/app" };
        let jb = dna::GitJournal { repo: scratch + "/b/app" };
        let ia = ja.genesis();
        let ib = jb.genesis();
        std::test::assert(len(ia) == 40 && len(ib) == 40, "each has a record: " + ia + " " + ib);
        std::test::assert(ia != ib, "two records, two identities: " + ia);
        std::test::assert(dna::schema_for(ia) != dna::schema_for(ib), "so two schemas and two organizations on the nerves");
        // what makes them two: the first commit's nonce, and nothing else
        let msg = dna::run_tool("git\n-C\n" + scratch + "/a/app\nlog\n-1\n--format=%B\n" + ia).stdout;
        std::test::assert(std::str::contains(msg, "Record-Nonce: "), "the first commit carries a nonce: " + msg);
        let ta = dna::run_tool("git\n-C\n" + scratch + "/a/app\nrev-parse\n" + ia + "^{tree}").stdout;
        let tb = dna::run_tool("git\n-C\n" + scratch + "/b/app\nrev-parse\n" + ib + "^{tree}").stdout;
        std::test::assert_eq_str(ta, tb, "the first rows are the same: the nonce alone tells them apart");
        // only the first: a later row carries none
        let later = ja.append(ja.revision(), "note.kept", "n1", "");
        std::test::assert(later.ok, "a second row lands: " + later.error);
        let head = dna::run_tool("git\n-C\n" + scratch + "/a/app\nlog\n-1\n--format=%B\nrefs/dna/journal").stdout;
        std::test::assert(!std::str::contains(head, "Record-Nonce"), "and carries no nonce: " + head);
        // GH #1590: init pinned each identity in its genome
        let a_app = scratch + "/a/app";
        let b_app = scratch + "/b/app";
        std::test::assert_eq_str(dna::manifest_dna_value(a_app, "record").value, ia, "hale.toml pins a's record");
        std::test::assert_eq_str(dna::manifest_dna_value(b_app, "record").value, ib, "hale.toml pins b's record");
        std::test::assert_eq_str(dna::record_scope(a_app), ia, "the scope is the pin, which the record agrees with");
        // the pin as TOML lets it stand, read wherever it stands; one that
        // is present but unreadable here is refused, never taken for no pin
        let original = std::io::fs::read_file(b_app + "/hale.toml") or "";
        std::test::assert(std::str::contains(original, ib), "b's manifest holds its pin");
        std::test::assert(self.reads(b_app, "[dna]\nrecord = '" + ia + "'\n", "", ib), "a literal string naming another record is refused, not read as no pin");
        std::test::assert(self.reads(b_app, "[dna] # the record\nrecord = \"" + ib + "\"\n", ib, ""), "a commented header");
        std::test::assert(self.reads(b_app, "[\"dna\"]\nrecord = '" + ib + "'\n", ib, ""), "a quoted header and a literal string");
        std::test::assert(self.reads(b_app, "dna.record = \"" + ib + "\"\n[deps]\n", ib, ""), "a dotted key");
        std::test::assert(self.reads(b_app, "dna = { fleet = \"x\", record = \"" + ib + "\" }\n", ib, ""), "an inline table");
        std::test::assert(self.reads(b_app, "[dna]\nrecord = 7\n", "", "not readable"), "a pin that is not a string");
        std::test::assert(self.reads(b_app, "[dna]\nrecord = \"\"\"" + ib + "\"\"\"\n", "", "not readable"), "a multi-line string");
        std::io::fs::write_file(b_app + "/hale.toml", original) or discard;
        // the codex case through the CLI: a literal-string pin of another record
        std::test::assert(repin(b_app, "record = '" + ia + "'"), "b's pin rewritten to a's, as a literal string");
        let lit_up = dna::run_tool("sh\n-c\ncd \"$1\" && exec \"$2\" dna upgrade\nsh\n" + b_app + "\n" + toolchain());
        std::test::assert(lit_up.code != 0 && std::str::contains(lit_up.stderr, ia) && std::str::contains(lit_up.stderr, ib), "upgrade refuses it, naming both: " + lit_up.stdout + lit_up.stderr);
        // a pin naming another record: no scope, and the reason
        std::test::assert(repin(b_app, "record = \"" + ia + "\""), "b's pin rewritten to a's");
        let crossed = dna::record_identity_at(b_app);
        std::test::assert(len(crossed.id) == 0 && std::str::contains(crossed.why, ib), "a pin naming another record has no scope: " + crossed.id + " / " + crossed.why);
        let up = dna::run_tool("sh\n-c\ncd \"$1\" && exec \"$2\" dna upgrade\nsh\n" + b_app + "\n" + toolchain());
        std::test::assert(up.code != 0 && std::str::contains(up.stderr, "[dna] record"), "upgrade refuses the crossed pin: " + up.stdout + up.stderr);
        // with no pin, the record's root commit, as before the pin
        std::test::assert(repin(b_app, ""), "b's pin removed");
        std::test::assert_eq_str(dna::record_scope(b_app), ib, "an unpinned genome is its record's root commit");
        let again = dna::run_tool("sh\n-c\ncd \"$1\" && exec \"$2\" dna upgrade\nsh\n" + b_app + "\n" + toolchain());
        std::test::assert(again.code == 0 && std::str::contains(again.stdout, "pinned"), "upgrade pins a record from before the pin: " + again.stdout + again.stderr);
        std::test::assert_eq_str(dna::manifest_dna_value(b_app, "record").value, ib, "and the pin is b's own");
        // a genome copied with its pin, into a clone holding no record: init
        // refuses to start a second record under the first one's name
        let c_app = scratch + "/c";
        let copied = dna::run_tool("sh\n-c\ncp -r \"$1\" \"$2\" && rm -rf \"$2/.git\" && git init -q \"$2\"\nsh\n" + a_app + "\n" + c_app);
        std::test::assert(copied.code == 0, "a copy of a's genome, with no record: " + copied.stderr);
        let init = dna::run_tool("sh\n-c\ncd \"$1\" && HALE_DNA_DISCOVER=off exec \"$2\" dna init\nsh\n" + c_app + "\n" + toolchain());
        std::test::assert(init.code != 0 && std::str::contains(init.stderr, ia), "init refuses a pin of another record: " + init.stdout + init.stderr);
        std::test::assert(len(dna::GitRecord { repo: c_app }.identity()) == 0, "and starts no record");
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
