// dna/tests/candidates_upgrade_test.hl — candidates an earlier toolchain
// kept become branches at upgrade (GH #1590).
//
// A toolchain before the branches kept a Mutation's candidate as
// `refs/dna/candidates/<mutation>`; the readers now know the branch
// `dna/candidate/<mutation>` alone. `hale dna upgrade` moves each old ref
// to its branch once: a branch already at the same commit is kept, one at
// another commit stops the upgrade with both commits named and moves
// nothing about that candidate. What moved is listed, shown and dropped
// as any candidate is.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// A commit on top of HEAD that adds `file` with `text`, made without
// touching the working tree or the index; its sha.
fn side_commit(app: String, file: String, text: String) -> String {
    let r = dna::run_tool("sh\n-c\ncd \"$1\" && idx=$(mktemp) && GIT_INDEX_FILE=$idx git read-tree HEAD && blob=$(printf '%s\\n' \"$3\" | git hash-object -w --stdin) && GIT_INDEX_FILE=$idx git update-index --add --cacheinfo 100644,$blob,\"$2\" && tree=$(GIT_INDEX_FILE=$idx git write-tree) && rm -f $idx && git -c user.name=t -c user.email=t@dna commit-tree $tree -p HEAD -m \"candidate $2\"\nsh\n" + app + "\n" + file + "\n" + text);
    std::test::assert_eq_int(r.code, 0, "a side commit: " + r.stderr);
    return dna::trim_nl(r.stdout);
}

fn git(app: String, args: String) -> dna::RunResult { return dna::run_tool("git\n-C\n" + app + "\n" + args); }

main locus App {
    run() {
        let scratch = dna::scratch_root("candidates-upgrade");
        let made = dna::run_tool("sh\n-c\nmkdir -p \"$1\" && cd \"$1\" && HALE_DNA_DISCOVER=off exec \"$2\" dna new app\nsh\n" + scratch + "\n" + toolchain());
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stderr);
        let app = scratch + "/app";
        let base = in_dir(app, "sh\n-c\ngit add -A && git -c user.name=t -c user.email=t@dna commit -q -m base");
        std::test::assert_eq_int(base.code, 0, "the genome's first commit: " + base.stderr);

        // two candidates kept the old way, one of them already a branch at the same commit
        let m9 = side_commit(app, "nine.txt", "the ninth change");
        let m8 = side_commit(app, "eight.txt", "the eighth change");
        std::test::assert_eq_int(git(app, "update-ref\nrefs/dna/candidates/m9\n" + m9).code, 0, "an old-format candidate m9");
        std::test::assert_eq_int(git(app, "update-ref\nrefs/dna/candidates/m8\n" + m8).code, 0, "an old-format candidate m8");
        std::test::assert_eq_int(git(app, "update-ref\n" + dna::candidate_ref("m8") + "\n" + m8).code, 0, "m8 already a branch, at the same commit");

        let up = in_dir(app, toolchain() + "\ndna\nupgrade");
        std::test::assert_eq_int(up.code, 0, "upgrade: " + up.stdout + up.stderr);
        std::test::assert(std::str::contains(up.stdout, "candidates  1 moved to their branches (dna/candidate/<mutation>), 1 already there"), "upgrade says what it moved: " + up.stdout);
        std::test::assert_eq_str(dna::trim_nl(git(app, "for-each-ref\nrefs/dna/candidates/").stdout), "", "no old-format candidate is left");
        std::test::assert_eq_str(dna::trim_nl(git(app, "rev-parse\n" + dna::candidate_ref("m9")).stdout), m9, "m9 is its branch");
        std::test::assert_eq_str(dna::trim_nl(git(app, "rev-parse\n" + dna::candidate_ref("m8")).stdout), m8, "m8's branch is kept");

        // listed, shown and dropped as any candidate is
        let listed = in_dir(app, toolchain() + "\ndna\ncandidates");
        std::test::assert(listed.code == 0 && std::str::contains(listed.stdout, "candidates: 2") && std::str::contains(listed.stdout, "  m9  ") && std::str::contains(listed.stdout, "  m8  "), "both listed: " + listed.stdout + listed.stderr);
        let shown = in_dir(app, toolchain() + "\ndna\ncandidates\nm9");
        std::test::assert(shown.code == 0 && std::str::contains(shown.stdout, "nine.txt") && std::str::contains(shown.stdout, "the ninth change"), "m9 shown as a diff: " + shown.stdout + shown.stderr);
        let dropped = in_dir(app, toolchain() + "\ndna\ncandidates\ndrop\nm9\n--why\nmoved and read\n--as\nriley");
        std::test::assert(dropped.code == 0 && std::str::contains(dropped.stdout, "candidate m9 dropped by riley"), "m9 dropped: " + dropped.stdout + dropped.stderr);
        std::test::assert(git(app, "rev-parse\n-q\n--verify\n" + dna::candidate_ref("m9")).code != 0, "and its branch is gone");

        // a branch at another commit: the upgrade stops, both named, nothing moved
        let m7a = side_commit(app, "seven.txt", "one seventh change");
        let m7b = side_commit(app, "seven.txt", "another seventh change");
        std::test::assert_eq_int(git(app, "update-ref\nrefs/dna/candidates/m7\n" + m7a).code, 0, "an old-format m7");
        std::test::assert_eq_int(git(app, "update-ref\n" + dna::candidate_ref("m7") + "\n" + m7b).code, 0, "and a branch m7 elsewhere");
        let refused = in_dir(app, toolchain() + "\ndna\nupgrade");
        std::test::assert(refused.code != 0 && std::str::contains(refused.stderr, m7a) && std::str::contains(refused.stderr, m7b), "upgrade refuses, naming both commits: " + refused.stdout + refused.stderr);
        std::test::assert_eq_str(dna::trim_nl(git(app, "rev-parse\nrefs/dna/candidates/m7").stdout), m7a, "the old ref is untouched");
        std::test::assert_eq_str(dna::trim_nl(git(app, "rev-parse\n" + dna::candidate_ref("m7")).stdout), m7b, "and so is the branch");
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
