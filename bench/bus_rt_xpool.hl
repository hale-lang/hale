// bus_rt_xpool — a bus round trip across pools.
//
// As bus_rt_same, with Echo placed on a cooperative pool of its own
// (`io`, a second OS thread): each Ping crosses into io's queue and each
// Pong crosses back into main's. main yields until the Pong is in, then
// sends the next Ping, so the time per round trip is two cross-thread
// posts, their wake-ups and two dispatches. Prints `iters=`, `got=` and
// `ns_per_rt=`.

type Ping {
    n: Int;
}

type Pong {
    n: Int;
}

locus Echo {
    bus {
        subscribe "bench.xrt.ping" as on_ping of type Ping;
        publish "bench.xrt.pong" of type Pong;
    }
    fn on_ping(p: Ping) {
        "bench.xrt.pong" <- Pong { n: p.n };
    }
}

main locus App {
    params {
        echo: Echo = Echo { };
        got: Int = 0;
    }
    placement {
        echo: cooperative(pool = io);
    }
    bus {
        publish "bench.xrt.ping" of type Ping;
        subscribe "bench.xrt.pong" as on_pong of type Pong;
    }
    fn on_pong(p: Pong) {
        self.got = self.got + 1;
    }
    run() {
        let iters = 100000;
        let mut i = 0;
        while i < 1000 {
            "bench.xrt.ping" <- Ping { n: i };
            while self.got <= i { yield; }
            i = i + 1;
        }
        let base = self.got;
        let t0 = std::time::monotonic_ns();
        let mut k = 0;
        while k < iters {
            "bench.xrt.ping" <- Ping { n: k };
            while self.got - base <= k { yield; }
            k = k + 1;
        }
        let t1 = std::time::monotonic_ns();
        println(f"iters={iters}");
        println(f"got={self.got - base}");
        println(f"ns_per_rt={(t1 - t0) / iters}");
    }
}

fn main() {
    App { };
}
