    fn fill(h: HoldFill, ctx: std::api::Context) -> CommandReply {
        return self.submit(
            ctx,
            CommandRequest {
                request_id: h.request_id,
                operation: "dna.hold.fill",
                target_kind: "dna.position",
                target_id: seat_named(h.position, true),
                subject_digest: h.record_head,
                record_head: h.record_head,
                new_assignee: h.holder,
            },
        );
