// Decimal<S>: the scale is part of the type (2026-10-12). Plain
// `Decimal` is `Decimal<9>`; `Decimal<S>` holds S fractional digits,
// S from 0 to 18, in the one i128 mantissa. A literal and a parse take
// the scale of the place they flow into; two scales never mix, and
// `d.rescale(T)` is the one conversion between them.

type Fee { amount: Decimal<18>; cents: Decimal<2> = 0.25d; }

const WEI: Decimal<18> = 0.000000000000000001d;

fn half(x: Decimal<18>) -> Decimal<18> {
    return x / 2d;
}

fn tail_scale() -> Decimal<4> { 2.5001d }

fn s(d: Decimal<18>) -> String { return "" + d; }

fn main() {
    // Literals at several scales, each exact at its own.
    let wei: Decimal<18> = 0.000000000000000001d;
    let price: Decimal<2> = 19.99d;
    let whole: Decimal<0> = 7d;
    let plain = 1.5d;
    std::test::assert_eq_str("" + wei, "0.000000000000000001", "a Decimal<18> holds eighteen places");
    std::test::assert_eq_str("" + price, "19.99", "a Decimal<2> holds two");
    std::test::assert_eq_str("" + whole, "7", "a Decimal<0> is whole");
    std::test::assert_eq_str("" + plain, "1.5", "plain Decimal is scale 9, as before");
    std::test::assert_eq_str(s(WEI), "0.000000000000000001", "a const takes its ascription's scale");
    std::test::assert_eq_str("" + tail_scale(), "2.5001", "a fn's tail takes the return type's scale");
    let fee = Fee { amount: 0.000000000000000003d };
    std::test::assert_eq_str(s(fee.amount), "0.000000000000000003", "a field takes its type's scale");
    std::test::assert_eq_str("" + fee.cents, "0.25", "and a field default its own");
    let neg: Decimal<18> = -0.000000000000000009d;
    std::test::assert_eq_str(s(neg), "-0.000000000000000009", "a negated literal");

    // Arithmetic at one scale: + - % exact, * and / truncate toward
    // zero at the scale.
    let a: Decimal<18> = 1.5d;
    std::test::assert_eq_str(s(a + wei), "1.500000000000000001", "a sum is exact at 18 places");
    std::test::assert_eq_str(s(a * a), "2.25", "a product");
    std::test::assert_eq_str(s(1d / 3d * a), "0.499999999999999999", "1/3 at scale 18 truncates past the 18th place");
    std::test::assert_eq_str(s(half(wei)), "0", "half a unit truncates to zero");
    std::test::assert_eq_str(s((0d - 1d) / 3d), "-0.333333333333333333", "toward zero");
    std::test::assert_eq_str("" + price * 3d, "59.97", "Decimal<2> times a literal");
    std::test::assert_eq_str("" + price / 3d, "6.66", "Decimal<2> divides at two places");
    std::test::assert_eq_str("" + whole / 2d, "3", "Decimal<0> divides as an integer");
    std::test::assert_eq_str("" + (price % 5d), "4.99", "% is exact");
    // Above scale 9 the product is computed wide: 100 x 100 at scale 18
    // would overflow an i128 intermediate (10^20 x 10^20).
    let hundred: Decimal<18> = 100d;
    std::test::assert_eq_str(s(hundred * hundred), "10000", "a wide product");
    std::test::assert_eq_str(s(hundred / wei / hundred), "1000000000000000000", "a wide quotient");
    std::test::assert_eq_str("" + max(a, 2d), "2", "max takes the other operand's scale");
    std::test::assert_eq_str("" + abs(neg), "0.000000000000000009", "abs keeps the scale");
    if a > 1d {
        std::test::assert_eq_str("compared", "compared", "a literal compares at the other side's scale");
    } else {
        std::test::assert_eq_str("not", "compared", "1.5 > 1 at scale 18");
    }

    // A composite literal flows element by element: a scale-less element
    // takes the element scale beside a typed one, at any depth.
    let xs: [Decimal<2>; 2] = [price, 0.01d];
    std::test::assert_eq_str("" + xs[1], "0.01", "a literal beside a typed element");
    let grid: [[Decimal<18>; 2]; 2] = [[wei, 1d], [0.000000000000000002d, a]];
    std::test::assert_eq_str(s(grid[1][0]), "0.000000000000000002", "a nested array's literal");
    let pair: (Decimal<18>, Decimal<2>) = (0.000000000000000004d, price);
    std::test::assert_eq_str(s(pair.0), "0.000000000000000004", "a tuple's part");
    let filled: [Decimal<2>; 3] = [0.07d; 3];
    std::test::assert_eq_str("" + filled[2], "0.07", "a repeated literal");
    // An `if` or a `match` joins its arms as an operator joins operands.
    let chosen = if a > 2d { price } else { 0.05d };
    std::test::assert_eq_str("" + chosen, "0.05", "an if's literal arm takes the typed arm's scale");
    let picked = match whole {
        7d -> 0.000000000000000003d,
        _ -> a,
    };
    std::test::assert_eq_str(s(picked), "0.000000000000000003", "a match's literal arm takes the typed arm's scale");

    // rescale: widening is exact; narrowing says what becomes of the
    // dropped digits.
    let up = plain.rescale(18);
    std::test::assert_eq_str(s(up + wei), "1.500000000000000001", "widening is exact");
    let third: Decimal<18> = 1d / 3d;
    std::test::assert_eq_str("" + (third.rescale(2) or trunc), "0.33", "narrowing, truncated");
    std::test::assert_eq_str("" + (third.rescale(2) or ceil), "0.34", "narrowing, ceiling");
    let two_thirds: Decimal<18> = 2d / 3d;
    std::test::assert_eq_str("" + (two_thirds.rescale(2) or half_even), "0.67", "narrowing, half-even");
    std::test::assert_eq_str("" + (neg.rescale(9) or floor), "-0.000000001", "floor goes down");
    std::test::assert_eq_str("" + (a.rescale(2) or 0d), "1.5", "an exact narrowing keeps the value");
    std::test::assert_eq_str("" + (third.rescale(2) or 9d), "9", "the refusal path: a nonzero dropped digit takes the fallback");
    let lost = third.rescale(4) or {
        std::test::assert_eq_str(err.kind, "Decimal<4>", "the InexactError names the target");
        std::test::assert_eq_int(err.divisor, 100000000000000, "and the power of ten it divided by");
            -1d
    };
    std::test::assert_eq_str("" + lost, "-1", "refused, not truncated");

    // Formatting: the point is placed by the scale, trailing zeros trim;
    // format(d, places) is the fixed-places surface, places clamped at S.
    std::test::assert_eq_str(std::decimal::format(price, 1), "20.0", "format rounds half-up");
    std::test::assert_eq_str(std::decimal::format(price, 4), "19.99", "places clamp at the scale");
    std::test::assert_eq_str(std::decimal::format(third, 18), "0.333333333333333333", "eighteen places");
    std::test::assert_eq_str(f"{price:.1}", "20.0", "an f-string precision");
    let big: Decimal<0> = 170141183460469231731687303715884105727d;
    std::test::assert_eq_str("" + big, "170141183460469231731687303715884105727", "the whole i128 at scale 0");

    // parse_decimal takes the scale of the place its result flows into.
    let p: Decimal<18> = std::str::parse_decimal("0.123456789012345678") or raise;
    std::test::assert_eq_str(s(p), "0.123456789012345678", "parsed at scale 18");
    let q: Decimal<2> = std::str::parse_decimal("1.239") or 0d;
    std::test::assert_eq_str("" + q, "0", "a third place is no Decimal<2>: the parse fails");
    let r: Decimal<2> = std::str::parse_decimal("1.230") or raise;
    std::test::assert_eq_str("" + r, "1.23", "trailing zeros past the scale are the same value");
    let plain_parse = std::str::parse_decimal("0.123456789012") or 0d;
    std::test::assert_eq_str("" + plain_parse, "0", "unannotated, a parse is scale 9");
    let ranged: Decimal<18> = std::str::range_parse_decimal("x=0.000000000000000042;", 2, 22) or raise;
    std::test::assert_eq_str(s(ranged), "0.000000000000000042", "range_parse_decimal at scale 18");
    std::test::assert_eq_str(s((std::str::parse_decimal("2") or 0d) * a), "3", "a parse in an operand takes the other side's scale");
}
