// GH #1109, retargeted in R4 (GH #1417) — roles at a served surface.
//
// spec/api.md § Surfaces and their rows, § Identity sources: `role` is
// declared vocabulary with a grant-only hierarchy; a row's `requires:
// [R]` means a call arriving through the exposure is refused
// `unauthorized` (naming what the row requires) unless the caller holds R,
// directly or through a role that `includes` it. The static table
// (`std::api::StaticRoles`), the source the transport's `roles:` names,
// reads `LOTUS_API_ROLES` in every member spelling; the handler's context
// names the role the row requires; the description is served filtered to
// what the caller holds, and `hale check --api --exposure --caller` lists
// the same members for the same caller.
//
// What the structural binding did that a served surface does not has no
// test here: a gated read answered `unknown` so as not to disclose the
// role (a refusal now names `requires`), `on_unauthorized: drop` (there is
// no silent refusal), the `owner`-gated full description, the receipt's
// `role` and a baked `[environments.<env>.roles]` table. Streams are topic
// bindings to a hub (`crates/hale-codegen/tests/api_hub_streams.rs`).

fn app_source(sock: String) -> String {
    return "role support;\n"
        + "role auditor;\n"
        + "role owner includes support;\n"
        + "type Refund { order_id: Int; amount: Int; }\n"
        + "type Result { ok: Bool; by: String; role: String; }\n"
        + "type Note { text: String; }\n"
        + "type Ledger { balance: Int; }\n"
        + "type Count { n: Int; }\n"
        + "type Query { who: String = \"\"; }\n"
        + "locus Billing {\n"
        + "    params { ledger: Ledger = Ledger { balance: 100 }; count: Int = 0; }\n"
        + "    fn on_refund(r: Refund, ctx: std::api::Context) -> Result {\n"
        + "        self.ledger.balance = self.ledger.balance - r.amount;\n"
        + "        self.count = self.count + 1;\n"
        + "        return Result { ok: true, by: ctx.caller.name, role: ctx.role };\n"
        + "    }\n"
        + "    fn on_note(n: Note) { self.count = self.count + 1; }\n"
        + "    fn read_count(q: Query) -> Count { return Count { n: self.count }; }\n"
        + "    fn read_ledger(q: Query) -> Ledger { return self.ledger; }\n"
        + "}\n"
        + "api Public {\n"
        + "    rpc Billing::on_refund requires: [support];\n"
        + "    rpc Billing::on_note;\n"
        + "    rpc Billing::read_count;\n"
        + "    rpc Billing::read_ledger requires: [auditor];\n"
        + "}\n"
        + "main locus Shop {\n"
        + "    params {\n"
        + "        billing: Billing = Billing { };\n"
        + "        roles: std::api::StaticRoles = std::api::StaticRoles { known: \"support auditor owner\" };\n"
        + "    }\n"
        + "    placement { billing: cooperative(pool = work) where async_io; }\n"
        + "    run() {\n"
        + "        let h = api::serve(Public, unix::Rpc { path: \"" + sock + "\", roles: self.roles }, as: \"shop\", receivers: { Billing: self.billing }, bound: 8, on_full: refuse);\n"
        + "        std::time::sleep(12s);\n"
        + "        h.stop();\n"
        + "    }\n"
        + "}\n"
        + "fn main() { Shop { }; }\n";
}

locus Proc {
    params {
        child: std::process::Child = std::process::Child { };
        out: String = "";
    }

    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }

    // The child's exit code, waited for (bounded); -1 when it did not exit.
    fn exit_code() -> Int {
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return code;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        return -1;
    }

    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
        n: Int = 0;
    }

    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 {
            return false;
        }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }

    fn ask_line(line: String) -> String {
        self.stream.send(line + "\n") or discard;
        let mut i = 0;
        while i < 15 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let got = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return got;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                i = i + 1;
            } else {
                self.buf = self.buf + chunk;
            }
        }
        return "";
    }

    // A call of `member` with `payload`.
    fn call(member: String, payload: String) -> String {
        self.n = self.n + 1;
        return self.ask_line("{\"call\":\"" + member + "\",\"payload\":" + payload + ",\"id\":\"c-" + to_string(self.n) + "\"}");
    }

    fn describe() -> String {
        return self.ask_line("{\"describe\":true}");
    }
}

fn run_tool(argv: String) -> std::process::ProcessOutput {
    return std::process::run(argv)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
}

fn has(s: String, needle: String) -> Bool {
    return std::str::contains(s, needle);
}

// The n-th space-separated word of `s`, "" past the end.
fn nth_word(s: String, n: Int) -> String {
    let mut rest = s + " ";
    let mut i = 0;
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let w = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        if len(w) > 0 {
            if i == n { return w; }
            i = i + 1;
        }
    }
    return "";
}

// Whether the description lists the member `name`.
fn lists(desc: String, name: String) -> Bool {
    let part = std::json::find_field_raw(desc, "members");
    return std::str::contains(part, "\"name\":\"" + name + "\"");
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let me = std::str::trim(run_tool("id\n-u").stdout);
    let my_name = std::str::trim(run_tool("id\n-un").stdout);
    let my_gid = std::str::trim(run_tool("id\n-g").stdout);
    let my_group = std::str::trim(run_tool("id\n-gn").stdout);
    let other = to_string((std::str::parse_int(me) or 0) + 1);
    let tag = to_string(std::process::pid());
    let sock = "/tmp/hale-roles-" + tag + ".sock";
    let src = std::io::fs::mktemp("/tmp/hale-1109-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source(sock)) or discard;
    let built = run_tool(hale + "\nbuild\n" + src);
    std::test::assert_eq_int(built.code, 0, "the app builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];
    // What `hale check --api` says this caller may use, per exposure.
    let emitted = run_tool(hale + "\ncheck\n--api\n--exposure\nshop\n--caller\nuid:" + me + "\n--holds\nsupport\n" + src);
    std::test::assert_eq_int(emitted.code, 0, "hale check --api --exposure: " + emitted.stderr);
    std::test::assert(has(emitted.stdout, "\"name\": \"Billing::on_refund\"") && !has(emitted.stdout, "\"name\": \"Billing::read_ledger\""), "the emitted description carries the role requirement: " + emitted.stdout);

    // Table A: this uid holds support (by user name), an auditor and an
    // owner who is someone else.
    let table_a = "support=user:" + my_name + ";auditor=uid:" + other + ";owner=uid:" + other;
    let p = Proc { };
    std::test::assert(p.start("env\nLOTUS_API_ROLES=" + table_a + "\n" + bin), "the app started under table A");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);

    let r1 = api.call("Billing::on_refund", "{\"order_id\":4,\"amount\":5}");
    std::test::assert(has(r1, "\"ok\":true"), "a holder's call is answered: " + r1);
    std::test::assert(has(r1, "\"role\":\"support\""), "the handler's context named the authorizing role: " + r1);
    let r2 = api.call("Billing::read_ledger", "{}");
    std::test::assert(has(r2, "\"ok\":false") && has(r2, "\"kind\":\"unauthorized\"") && has(r2, "\"requires\":[\"auditor\"]"), "a row the caller does not hold the role for is refused, naming what it requires: " + r2);
    let r3 = api.call("Billing::read_count", "{}");
    std::test::assert(has(r3, "\"ok\":true") && has(r3, "\"n\":1"), "an ungated row answers: " + r3);
    let r5 = api.call("Billing::on_note", "{\"text\":\"hi\"}");
    std::test::assert(has(r5, "\"ok\":true"), "an ungated command is answered with no role: " + r5);
    let d1 = api.describe();
    let desc1 = std::json::find_field_raw(d1, "value");
    std::test::assert(lists(desc1, "Billing::on_refund") && lists(desc1, "Billing::on_note") && lists(desc1, "Billing::read_count"), "the description lists what this caller may call: " + desc1);
    std::test::assert(!lists(desc1, "Billing::read_ledger"), "the description hides the row this caller may not use: " + desc1);
    // The live answer and `hale check --api` list the same members for the
    // same caller (the live document carries the identity, the caller and
    // the members; the schemas stay the compiler's document's).
    for m in ["Billing::on_refund", "Billing::on_note", "Billing::read_count", "Billing::read_ledger"] {
        std::test::assert(lists(desc1, m) == has(emitted.stdout, "\"name\": \"" + m + "\""), "the live description and `check --api` agree on " + m);
    }
    p.stop();
    std::io::fs::unlink(sock) or discard;

    // Table B: this principal holds auditor by a group the kernel says it
    // is in — a supplementary one when there is one (SO_PEERGROUPS), else
    // its primary group by name — someone else holds support, nobody is
    // owner.
    let groups = std::str::trim(run_tool("id\n-G").stdout);
    let mut supplementary = "";
    let mut gi = 0;
    while len(nth_word(groups, gi)) > 0 {
        if nth_word(groups, gi) != my_gid && len(supplementary) == 0 { supplementary = nth_word(groups, gi); }
        gi = gi + 1;
    }
    let auditor_member = if len(supplementary) > 0 { "gid:" + supplementary } else { "group:" + my_group };
    let table_b = "support=uid:" + other + ";auditor=" + auditor_member + ";owner=";
    let q = Proc { };
    std::test::assert(q.start("env\nLOTUS_API_ROLES=" + table_b + "\n" + bin), "the app started under table B");
    let api2 = Api { };
    std::test::assert(api2.connect(sock), "connected under table B");
    let b1 = api2.call("Billing::on_refund", "{\"order_id\":4,\"amount\":5}");
    std::test::assert(has(b1, "\"kind\":\"unauthorized\"") && !has(b1, "\"by\""), "a non-holder's call is refused: " + b1);
    let b4 = api2.call("Billing::read_ledger", "{}");
    std::test::assert(has(b4, "\"balance\":100"), "the auditor reads the gated field, by group membership (" + auditor_member + "): " + b4);
    let d3 = std::json::find_field_raw(api2.describe(), "value");
    std::test::assert(!lists(d3, "Billing::on_refund") && lists(d3, "Billing::read_ledger"), "the description is this caller's slice: " + d3);
    q.stop();
    std::io::fs::unlink(sock) or discard;

    // Table C: this uid is owner, which includes support.
    let table_c = "support=;auditor=;owner=uid:" + me;
    let w = Proc { };
    std::test::assert(w.start("env\nLOTUS_API_ROLES=" + table_c + "\n" + bin), "the app started under table C");
    let api3 = Api { };
    std::test::assert(api3.connect(sock), "connected under table C");
    let c1 = api3.call("Billing::on_refund", "{\"order_id\":1,\"amount\":1}");
    std::test::assert(has(c1, "\"ok\":true") && has(c1, "\"role\":\"support\""), "owner includes support, and the handler sees the row's role: " + c1);
    let c3 = api3.call("Billing::read_ledger", "{}");
    std::test::assert(has(c3, "\"kind\":\"unauthorized\""), "owner does not include auditor: " + c3);
    w.stop();
    std::io::fs::unlink(sock) or discard;
    std::io::fs::unlink(bin) or discard;
    std::io::fs::unlink(src) or discard;

    // The matrix still wants every declared role mapped in an
    // environment (the manifest's table is the deployment's record).
    let dir = "/tmp/hale-1109-env-" + tag;
    std::io::fs::mkdir(dir) or discard;
    std::io::fs::write_file(dir + "/hale.toml",
        "[claims]\nno_base = true\n\n[environments.test]\nsource_only = true\nentrypoints = [\".\"]\n\n[environments.test.roles]\nsupport = [\"uid:" + me + "\"]\nauditor = []\nowner = []\n") or discard;
    std::io::fs::write_file(dir + "/main.hl", app_source(sock)) or discard;
    let matrix = run_tool(hale + "\ncheck\n--matrix\n" + dir);
    std::test::assert_eq_int(matrix.code, 0, "every declared role is mapped, so the matrix passes: " + matrix.stderr + matrix.stdout);
    let _rm = run_tool("rm\n-rf\n" + dir);

    // A table the program cannot act on is refused at birth, as
    // LOTUS_API_ROLES: a role nothing declares, a member outside the five
    // spellings.
    let bad_src = std::io::fs::mktemp("/tmp/hale-1109-bad-", ".hl") or "";
    std::io::fs::write_file(bad_src, app_source(sock)) or discard;
    std::test::assert_eq_int(run_tool(hale + "\nbuild\n" + bad_src).code, 0, "built for the refusals");
    let bad_bin = bad_src[0..(len(bad_src) - 3)];
    let x = Proc { };
    std::test::assert(x.start("env\nLOTUS_API_ROLES=suport=uid:" + me + "\n" + bad_bin), "started under an undeclared role");
    let x_code = x.exit_code();
    std::test::assert_eq_int(x_code, 2, "a table naming an undeclared role refuses to start: " + x.out);
    std::test::assert(has(x.out, "refusing to start") && has(x.out, "`suport` is not a role this program declares"), "and says why: " + x.out);
    let y = Proc { };
    std::test::assert(y.start("env\nLOTUS_API_ROLES=support=riley\n" + bad_bin), "started under a bad member spelling");
    std::test::assert_eq_int(y.exit_code(), 2, "a member outside the five spellings refuses to start: " + y.out);
    std::test::assert(has(y.out, "`riley` is not a role member"), "and says which: " + y.out);
    std::io::fs::unlink(bad_bin) or discard;
    std::io::fs::unlink(bad_src) or discard;
}
