// The HTTP adapter copies typed values only. Native admission, identity,
// authority, eligibility and recovery remain in operations::GovernanceCommands.
import ".." as api;
import "../../operations" as ops;

interface GovernanceService {
    fn supported(operation: String, version: String) -> Bool;
    fn capability(context: ops::GovernanceContext, operation: String, version: String) -> ops::GovernanceCapability;
    fn submit(context: ops::GovernanceContext, command: ops::GovernanceCommand) -> ops::GovernanceResult;
    fn lookup(context: ops::GovernanceContext, request_id: String) -> ops::GovernanceResult;
}

interface GovernanceOrganizationCapabilities {
    fn organization_capability(context: ops::GovernanceContext, operation: String, version: String) -> ops::GovernanceCapability;
}
interface GovernancePeople {
    fn retirement_read(context: ops::GovernanceContext, person: String) -> ops::PersonAdministrationRead;
}
locus NoGovernancePeople {
    params { }
    fn retirement_read(context: ops::GovernanceContext, person: String) -> ops::PersonAdministrationRead { return ops::PersonAdministrationRead { code: "commands_unsupported" }; }
}
locus NoGovernanceOrganizationCapabilities {
    params { }
    fn organization_capability(context: ops::GovernanceContext, operation: String, version: String) -> ops::GovernanceCapability { return ops::GovernanceCapability { }; }
}
locus PracticeReviewCommands {
    params { root: String = ""; application_id: String = ""; service: GovernanceService; source_capabilities: GovernanceOrganizationCapabilities = NoGovernanceOrganizationCapabilities { }; organization_configured: Bool = false; people: GovernancePeople = NoGovernancePeople { }; }
    fn person(context: api::CommandContext, id: String) -> ops::PersonAdministrationRead {
        if !self.bound(context) { return ops::PersonAdministrationRead { code: "command_context_changed" }; }
        return self.people.retirement_read(self.context(context), id);
    }
    fn supported(operation: String, version: String) -> Bool {
        return (operation != "dna.organization.propose" || self.organization_configured) && self.service.supported(operation, version);
    }
    fn bound(context: api::CommandContext) -> Bool {
        return context.source.ok && context.root == self.root && len(self.application_id) > 0 && context.source.identity == self.application_id;
    }
    fn context(context: api::CommandContext) -> ops::GovernanceContext {
        return ops::GovernanceContext { application_id: context.source.identity, principal_mode: context.principal_mode, principal_name: context.principal_name };
    }
    fn capability(context: api::CommandContext, operation: String, version: String) -> api::CommandCapability {
        if !self.bound(context) { return api::CommandCapability { reason: "The command provider is not bound to this application." }; }
        if operation == "dna.organization.propose" { if version != "1" { return api::CommandCapability { reason: "This Organization command version is not supported." }; } let source = self.organization_capabilities(context); return source.proposal; }
        let value = self.service.capability(self.context(context), operation, version);
        return api::CommandCapability { available: value.available, authorized: value.authorized, reason: value.reason, recipients: value.recipients };
    }
    fn organization_capabilities(context: api::CommandContext) -> api::OrganizationCommandCapabilities {
        if !self.organization_configured || !self.bound(context) { return api::OrganizationCommandCapabilities { }; }
        let proposal = self.source_capabilities.organization_capability(self.context(context), "dna.organization.propose", "1");
        let review = self.source_capabilities.organization_capability(self.context(context), "dna.review.verdict", "1");
        return api::OrganizationCommandCapabilities { configured: true,
            proposal: api::CommandCapability { available: proposal.available, authorized: proposal.authorized, reason: proposal.reason },
            review: api::CommandCapability { available: review.available, authorized: review.authorized, reason: review.reason } };
    }
    fn receipt(value: ops::GovernanceReceipt) -> api::CommandReceipt {
        return api::CommandReceipt {
            command_id: value.command_id, request_id: value.request_id, application_id: value.application_id,
            operation: value.operation, operation_version: value.operation_version,
            principal_mode: value.principal_mode, principal_name: value.principal_name,
            position_id: value.position_id, target_kind: value.target_kind, target_id: value.target_id,
            subject_digest: value.subject_digest, fingerprint: value.fingerprint, state: value.state, reason: value.reason,
            proposal_state: value.proposal_state, verdict_value: value.verdict_value, verdict_state: value.verdict_state,
            candidate_digest: value.candidate_digest, review_id: value.review_id, review_state: value.review_state,
            review_outcome: value.review_outcome, review_subject_digest: value.review_subject_digest,
            activation_state: value.activation_state, activation_reason: value.activation_reason,
            organization: api::OrganizationCommandOutcome { proposal_state: value.organization.proposal_state, source_head: value.organization.source_head, source_digest: value.organization.source_digest,
                mutation_id: value.organization.mutation_id, candidate_commit: value.organization.candidate_commit, application_state: value.organization.application_state,
                application_reason_code: value.organization.application_reason_code, restart_handoff_state: value.organization.restart_handoff_state },
            task: api::TaskCommandOutcome { state: value.task.state, from: value.task.from, to: value.task.to, event_id: value.task.event_id },
            person: api::PersonRetirementOutcome { state: value.person.state, from: value.person.from, to: value.person.to, event_id: value.person.event_id, transferred: value.person.transferred },
            task_create: api::TaskCreateOutcome { intent_id: value.task_create.intent_id, intent_state: value.task_create.intent_state, task_id: value.task_create.task_id, event_id: value.task_create.event_id },
            attempt: api::AttemptCommandOutcome { state: value.attempt.state, attempt_id: value.attempt.attempt_id, work_id: value.attempt.work_id, task_id: value.attempt.task_id, performer_kind: value.attempt.performer_kind,
                holder: value.attempt.holder, token: value.attempt.token, until: value.attempt.until, disposition: value.attempt.disposition, reason: value.attempt.reason, event_id: value.attempt.event_id }
        };
    }
    fn result(context: api::CommandContext, value: ops::GovernanceResult) -> api::CommandResult {
        if value.ok && (value.application_id != self.application_id || len(value.head) == 0 || value.revision < 1) { return api::CommandResult { code: "commands_unavailable" }; }
        // Use the service's captured evidence; a fresh read here could attach an
        // unrelated later Record head to this command's outcome.
        let source = api::Source { ok: value.ok, identity: value.application_id, head: value.head, revision: value.revision, name: context.source.name, code: if value.ok { "" } else { value.code }, error: "" };
        return api::CommandResult { ok: value.ok, code: value.code, source: source, receipt: self.receipt(value.receipt) };
    }
    // Pure field mapping: expected principal never becomes trusted context.
    fn native_request(command: api::CommandRequest) -> ops::GovernanceCommand {
        return ops::GovernanceCommand {
            request_id: command.request_id, operation: command.operation, operation_version: command.operation_version,
            application_id: command.application_id, position_id: command.position_id, target_kind: command.target_kind,
            target_id: command.target_id, subject_digest: command.subject_digest, text: command.text, rationale: command.rationale,
            expected_review_state: command.expected_review_state, verdict: command.verdict, comment: command.comment,
            source_head: command.source_head, dependency_source: command.dependency_source, dependency_digest: command.dependency_digest,
            record_head: command.record_head, source_text: command.source_text,
            expected_assignee: command.expected_assignee, new_assignee: command.new_assignee,
            outcome: command.outcome, to: command.to,
            performer_kind: command.performer_kind, performer: command.performer, capabilities: command.capabilities, data_classes: command.data_classes,
            organizations: command.organizations, ttl: command.ttl, attempt_id: command.attempt_id, holder: command.holder, token: command.token,
            disposition: command.disposition, result: command.result, result_ref: command.result_ref, narrative: command.narrative,
            evidence: command.evidence, receipts: command.receipts
        };
    }
    fn submit(context: api::CommandContext, command: api::CommandRequest) -> api::CommandResult {
        if !self.bound(context) || command.expected_principal_mode != context.principal_mode || command.expected_principal_name != context.principal_name { return api::CommandResult { code: "command_context_changed" }; }
        if !command.valid { return api::CommandResult { code: "invalid_command" }; }
        if command.operation == "dna.organization.propose" && !self.supported(command.operation, command.operation_version) { return api::CommandResult { code: "commands_unsupported" }; }
        let value = self.native_request(command);
        return self.result(context, self.service.submit(self.context(context), value));
    }
    fn lookup(context: api::CommandContext, request_id: String) -> api::CommandResult {
        if !self.bound(context) { return api::CommandResult { code: "command_context_changed" }; }
        return self.result(context, self.service.lookup(self.context(context), request_id));
    }
}
