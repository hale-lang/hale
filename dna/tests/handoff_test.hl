// GH #615, #1590 — a cross-record handoff between two organizations, two
// records, through the CLI, over their nerves. A firm connects to its
// accountant's record by reading the accountant's card on its nerves; the
// connection pins the key the card names and is a Board Review, in force
// once someone other than its proposer approves it. A Task handed across
// arrives in the accountant's inbox as an envelope signed with the firm's
// key, with its origin, lineage and purpose; a `customer` receipt crosses
// as its digest, never its body, and a connection that does not carry
// `customer` refuses it at the edge. The accountant admits what arrives
// only under its own connection back, under the key that connection
// pinned, and accepts it; the firm's Task settles only when that
// acceptance arrives. An envelope signed with another key is not
// admitted, a delivery repeated is kept once, and an inbox that is full
// refuses. Neither record reads the other's record. Disconnecting leaves
// history in both records and admits nothing further.

import "../core" as dna;
import "../core/pond/realtime/nats" as nats;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, model discovery off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

// The lines of `text` that carry every one of `needles` (tab-separated).
fn text_lines_with(text: String, needles: String) -> Int {
    let tabbed = needles + "\t";
    let mut n = 0;
    let mut rest = text;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let mut all = len(line) > 0;
        let mut ns = tabbed;
        while len(ns) > 0 && all {
            let t = std::str::index_of(ns, "\t");
            let needle = ns[0..t];
            ns = ns[(t + 1)..len(ns)];
            if len(needle) > 0 && !std::str::contains(line, needle) { all = false; }
        }
        if all { n = n + 1; }
    }
    return n;
}

// The rows of the record a clone holds that carry every one of `needles`,
// read through the toolchain (`hale dna record-rows`).
fn record_lines_with(repo: String, needles: String) -> Int {
    let r = in_dir(repo, toolchain() + "\ndna\nrecord-rows");
    std::test::assert_eq_int(r.code, 0, "the record at " + repo + " reads: " + r.stderr);
    return text_lines_with(r.stdout + "\n", needles);
}

// How many of a repository's git objects contain `needle`.
fn objects_with(repo: String, needle: String) -> String {
    return dna::trim_nl(in_dir(repo, "sh\n-c\ngit cat-file --batch-all-objects --batch 2>/dev/null | grep -c -F \"$1\" || true\nsh\n" + needle).stdout);
}

// A project, its genome committed and its record pushed to a bare remote
// beside it (a verdict from a clone with no organism running reaches one
// through it).
fn project(scratch: String, name: String, user: String) -> String {
    let made = in_dir(scratch, toolchain() + "\ndna\nnew\n" + name);
    std::test::assert_eq_int(made.code, 0, "hale dna new " + name + ": " + made.stdout + made.stderr);
    let app = scratch + "/" + name;
    let g = in_dir(app, "sh\n-c\ngit init -q --bare -b main \"$2\" && git config user.name \"$1\" && git config user.email \"$1@local\" && git add -A && git commit -q -m 'the app' && git remote add origin \"$2\" && git push -q origin main\nsh\n" + user + "\n" + scratch + "/" + name + ".git");
    std::test::assert_eq_int(g.code, 0, "the genome committed and pushed: " + g.stderr);
    let synced = in_dir(app, toolchain() + "\ndna\nsync");
    std::test::assert_eq_int(synced.code, 0, "synced " + name + ": " + synced.stdout + synced.stderr);
    return app;
}

// The text after `marker` up to the next space.
fn word_after(text: String, marker: String) -> String {
    let at = std::str::index_of(text, marker);
    if at < 0 { return ""; }
    let rest = text[(at + len(marker))..len(text)];
    let sp = std::str::index_of(rest, " ");
    return if sp < 0 { dna::trim_nl(rest) } else { rest[0..sp] };
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

// A secret of the test's own into the vault the organisms use.
fn vault_put(name: String, value: String) {
    let dir = std::secret::vault_local_dir();
    let made = dna::run_tool("sh\n-c\numask 077 && mkdir -p \"$1\" && printf '%s' \"$3\" > \"$1/$2\"\nsh\n" + dir + "\n" + name + "\n" + value);
    std::test::assert_eq_int(made.code, 0, "the vault holds " + name + ": " + made.stderr);
}

main locus App {
    params {
        // pointed at the projects in run(); never at the working directory
        j: dna::GitJournal = dna::GitJournal { repo: "/nonexistent/dna-handoff" };
        k: dna::GitJournal = dna::GitJournal { repo: "/nonexistent/dna-handoff" };
        firm: String = "";
        acct: String = "";
        firm_head: String = "";
        acct_head: String = "";
        nerves: String = "";
    }
    // `hale dna <args>` in `app`, as a head of its record: its memory and its nerves.
    fn cli(app: String, args: String) -> String {
        let head = if app == self.firm { self.firm_head } else { self.acct_head };
        let r = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_HEAD=\"$2\" HALE_DNA_NATS_URL_SPINE=\"$3\" && shift 3 && exec \"$@\"\nsh\n" + app + "\n" + head + "\n" + self.nerves + "\n" + toolchain() + "\ndna\n" + args);
        return r.stdout + r.stderr;
    }
    fn row(kind: String, entity: String, body: String) {
        self.j.refresh();
        let x = self.j.append(self.j.revision(), kind, entity, body);
    }
    run() {
        // ---- the pure rules
        std::test::assert_eq_str(dna::classes_refusal("internal, customer"), "", "known classes");
        std::test::assert(std::str::contains(dna::classes_refusal("internal,secret"), "`secret` is not a data class"), "an unknown class");
        std::test::assert(dna::classes_allow("internal, customer", "customer") && !dna::classes_allow("internal", "customer") && !dna::classes_allow("internal", "intern"), "a class is carried whole or not at all");
        std::test::assert(len(dna::connection_name_refusal("Acct")) > 0 && len(dna::connection_name_refusal("sync")) > 0 && len(dna::connection_name_refusal("acct-2")) == 0, "connection names");
        std::test::assert(dna::handoff_id("g", "p", "task", "t7") == dna::handoff_id("g", "p", "task", "t7") && dna::handoff_id("g", "p", "task", "t7") != dna::handoff_id("g", "p", "receipt", "t7") && dna::handoff_id("g", "p", "task", "t7") != dna::handoff_id("g", "q", "task", "t7"), "a handoff's id is its origin, peer, kind and subject");

        // ---- envelopes and cards, signed by a record's key, in memory
        vault_put("dna-exchange-test-one", "the first record's exchange secret");
        vault_put("dna-exchange-test-two", "the second record's exchange secret");
        let one = dna::ExchangeKey { vault: "dna-exchange-test-one" };
        let two = dna::ExchangeKey { vault: "dna-exchange-test-two" };
        std::test::assert(len(one.public()) == 64 && one.public() != two.public(), "two keys: " + one.public());
        std::test::assert(len(dna::ExchangeKey { vault: "dna-exchange-test-none" }.seal(dna::Envelope { id: "x" })) == 0, "no key, no envelope");
        let ex = dna::MemExchange { identity: "b" };
        ex.publish_card("b", two.card("b", "g-b"));
        let card = ex.card("mem://b", "b");
        std::test::assert(card.ok && card.key == two.public() && card.genome == "g-b", "a card read and its key: " + card.why);
        std::test::assert(!ex.card("mem://b", "c").ok, "a card that is not the named record's");
        let e = dna::Envelope { id: "h1.received", sender: "a", recipient: "b", kind: "received", entity: "handoff:h1", body: "{}", author: "riley" };
        let line = one.seal(e);
        std::test::assert(dna::signed_line_holds(line), "an envelope's signature holds");
        std::test::assert(!dna::signed_line_holds(std::str::replace(line, "riley", "mallory")), "a changed envelope's does not");
        std::test::assert(ex.deliver("mem://b", "b", e.id, line).ok && ex.deliver("mem://b", "b", e.id, line).ok, "delivered twice");
        std::test::assert_eq_int(text_lines_with(ex.received(), "h1.received"), 1, "and kept once");
        ex.full_at = 1;
        let full = ex.deliver("mem://b", "b", "h2.received", one.seal(dna::Envelope { id: "h2.received", sender: "a", recipient: "b", kind: "received" }));
        std::test::assert(!full.ok && full.full, "a full inbox refuses: " + full.why);

        // ---- two records on their nerves
        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        let nats_owner = if std::env::var_exists("HALE_DNA_NATS_URL_OWNER") { std::env::var("HALE_DNA_NATS_URL_OWNER") } else { "" };
        if len(owner) == 0 || len(nats_owner) == 0 {
            eprintln("handoff_test: no HALE_DNA_MEMORY_DSN_OWNER or HALE_DNA_NATS_URL_OWNER; the records' exchange over their nerves was not exercised");
            return;
        }
        self.nerves = dna::nerves_server_url(nats_owner);
        let scratch = dna::scratch_root("handoff");
        self.firm = project(scratch, "firm", "riley");
        self.acct = project(scratch, "acct", "noor");
        let firm = self.firm;
        let acct = self.acct;
        let firm_genesis = dna::GitJournal { repo: firm }.genesis();
        let acct_genesis = dna::GitJournal { repo: acct }.genesis();
        std::test::assert(len(firm_genesis) == 40 && firm_genesis != acct_genesis, "two records: " + firm_genesis + " " + acct_genesis);
        let fm = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_OWNER=\"$2\" HALE_DNA_RECEIPT_KEY=handoff-test-receipt-key && exec \"$3\" dna memory migrate\nsh\n" + firm + "\n" + owner + "\n" + toolchain());
        let am = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_OWNER=\"$2\" HALE_DNA_RECEIPT_KEY=handoff-test-receipt-key && exec \"$3\" dna memory migrate\nsh\n" + acct + "\n" + owner + "\n" + toolchain());
        self.firm_head = line_value(fm.stdout, "HALE_DNA_MEMORY_DSN_HEAD");
        self.acct_head = line_value(am.stdout, "HALE_DNA_MEMORY_DSN_HEAD");
        std::test::assert(len(self.firm_head) > 0 && len(self.acct_head) > 0, "each record's memory: " + fm.stdout + fm.stderr + am.stdout + am.stderr);
        // the accountant's inbox holds seven envelopes from one sender: its bound
        let fnv = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_NATS_URL_OWNER=\"$2\" && exec \"$3\" dna nerves migrate\nsh\n" + firm + "\n" + nats_owner + "\n" + toolchain());
        let anv = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_NATS_URL_OWNER=\"$2\" HALE_DNA_EXCHANGE_PER_SENDER=7 && exec \"$3\" dna nerves migrate\nsh\n" + acct + "\n" + nats_owner + "\n" + toolchain());
        std::test::assert(fnv.code == 0 && anv.code == 0, "each record's nerves, its exchange and its card: " + fnv.stdout + fnv.stderr + anv.stdout + anv.stderr);
        let acct_org = line_value(anv.stdout, "HALE_DNA_NATS_ORG");
        let firm_org = line_value(fnv.stdout, "HALE_DNA_NATS_ORG");

        // the accountant's private history: another client's affairs
        self.k = dna::GitJournal { repo: acct };
        self.k.refresh();
        let private = self.k.append(self.k.revision(), "task.born", "t90", "i90: UNRELATED_PRIVATE_FACT about another client's payroll");

        // the firm's facts: people's jobs, a customer receipt, an internal one
        self.j = dna::GitJournal { repo: firm };
        let mut t = 7;
        while t <= 11 {
            self.row("task.born", "t" + to_string(t), "i-t" + to_string(t) + ": job " + to_string(t) + " for the accountant");
            self.row("task.handed", "t" + to_string(t), "{\"work\": \"t" + to_string(t) + "/w\", \"assignee\": \"mara\", \"by\": \"leader\", \"narrative\": \"handed: not a software change\"}");
            t = t + 1;
        }
        let customer = dna::digest_of("the client's customer list");
        self.row("receipt.classified", customer, "{\"class\": \"customer\", \"by\": \"org\", \"store\": \"knowledge\"}");
        let notes = in_dir(scratch, "sh\n-c\nprintf '%s' \"$1\" > notes.txt\nsh\nledger notes for the accountant");
        let filed = self.cli(firm, "receipt\nfile\n" + scratch + "/notes.txt");
        let internal = filed[std::str::index_of(filed, "sha256:")..(std::str::index_of(filed, "sha256:") + 71)];

        // ---- no connection, not to itself, a card that is not there
        std::test::assert(std::str::contains(self.cli(firm, "handoff\nacct\ntask\nt7"), "no connection `acct`"), "nothing crosses without a connection");
        let to_self = self.cli(firm, "connect\n" + self.nerves + "\n--record\n" + firm_genesis + "\n--name\nself\n--as\nitself\n--purpose\nnone\n--classes\ninternal");
        std::test::assert(std::str::contains(to_self, "is this record itself"), "a replica is not a connection: " + to_self);
        let unreached = self.cli(firm, "connect\nnats://127.0.0.1:1\n--record\n" + acct_genesis + "\n--name\nnowhere\n--as\nnobody\n--purpose\nnone\n--classes\ninternal");
        std::test::assert(std::str::contains(unreached, "could not be reached") && std::str::contains(unreached, "nothing was changed"), "nerves that do not answer: " + unreached);
        let nobody = self.cli(firm, "connect\n" + self.nerves + "\n--record\n0123456789abcdef0123456789abcdef01234567\n--name\nnobody\n--as\nnobody\n--purpose\nnone\n--classes\ninternal");
        std::test::assert(std::str::contains(nobody, "publishes no card"), "a record with no card there: " + nobody);
        std::test::assert(std::str::contains(self.cli(firm, "connect\n" + self.nerves + "\n--record\n" + acct_genesis + "\n--name\nacct\n--as\naccountant\n--purpose\nbooks\n--classes\nsecret"), "`secret` is not a data class"), "classes are checked");

        // ---- the connection is a Board Review, pinning the card's key
        let proposed = self.cli(firm, "connect\n" + self.nerves + "\n--record\n" + acct_genesis + "\n--name\nacct\n--as\naccountant\n--purpose\nyear-end books\n--classes\ninternal,customer\n--by\nriley");
        std::test::assert(std::str::contains(proposed, "connection acct proposed: record ") && std::str::contains(proposed, "its card's key") && std::str::contains(proposed, "carrying internal,customer"), "proposed: " + proposed);
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"connection.proposed\"\t\\\"peer_key\\\": \\\"" + dna::ExchangeKey { vault: dna::exchange_key_vault(acct_org) }.public() + "\\\"\t\\\"exchange\\\": \\\"nerves\\\""), 1, "the accountant's key is pinned");
        let rid = word_after(proposed, "hale dna review ");
        std::test::assert(std::str::starts_with(rid, "c-acct-"), "its Review: " + proposed);
        std::test::assert(std::str::contains(self.cli(firm, "handoff\nacct\ntask\nt7\n--as\nriley"), "is proposed: Review " + rid), "not in force before the Board decides");
        let own = self.cli(firm, "review\n" + rid + "\napprove\n--as\nriley\n--authority\nboard\n--no-wait");
        std::test::assert(std::str::contains(self.cli(firm, "handoff\nacct\ntask\nt7\n--as\nriley"), "needs an approval by a board member other than riley"), "its proposer's approval does not put it in force");
        let approved = self.cli(firm, "review\n" + rid + "\napprove\n--as\nana\n--authority\nboard\n--no-wait");
        let listed = self.cli(firm, "connect");
        std::test::assert(std::str::contains(listed, "connections: 1\n  acct → record ") && std::str::contains(listed, "in force (approved by ana)"), "in force: " + listed);
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"review.settled\"\t\"entity\": \"review:" + rid + "\"\t\"author\": \"ana\""), 1, "its Review settled once, in ana's name");

        // ---- a Task handed across, into the accountant's inbox
        let handed = self.cli(firm, "handoff\nacct\ntask\nt7\n--as\nriley\n--note\nclose by March");
        std::test::assert(std::str::contains(handed, ": task t7 [internal] delivered to record ") && std::str::contains(handed, "_EXCHANGE#"), "handed across: " + handed);
        let hid = word_after(handed, "handoff ");
        let hid7 = hid[0..(len(hid) - 1)];
        std::test::assert_eq_str(dna::handoff_id(firm_genesis, acct_genesis, "task", "t7"), hid7, "a handoff's id is its origin, its peer, its kind and its subject");
        std::test::assert(std::str::contains(self.cli(firm, "status"), "t7 [transfer_requested]"), "the Task waits for acceptance");
        std::test::assert(std::str::contains(self.cli(firm, "handoff\nacct\ntask\nt7\n--as\nriley"), "is transfer_requested"), "a Task crosses once");
        std::test::assert_eq_int(record_lines_with(acct, "handoff"), 0, "nothing is written into the accountant's record by a delivery");

        // ---- a crash after the envelope landed and before the firm's own
        // row: handing it again lands it once (#637)
        let hid9 = dna::handoff_id(firm_genesis, acct_genesis, "task", "t9");
        std::io::fs::write_file(firm + "/.git/refs/dna/journal.lock", "held by the test") or discard;
        let interrupted = self.cli(firm, "handoff\nacct\ntask\nt9\n--as\nriley");
        std::io::fs::unlink(firm + "/.git/refs/dna/journal.lock") or discard;
        std::test::assert(std::str::contains(interrupted, "but this record refused the append"), "the envelope landed, the firm's row did not: " + interrupted);
        let resumed = self.cli(firm, "handoff\nacct\ntask\nt9\n--as\nriley");
        std::test::assert(std::str::contains(resumed, "handoff " + hid9 + ": task t9 [internal] delivered to record"), "handed again, it completes: " + resumed);
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"handoff.published\"\t\"entity\": \"handoff:" + hid9 + "\""), 1, "one row here");

        // ---- a customer receipt: the digest crosses, the body never
        let receipt = self.cli(firm, "handoff\nacct\nreceipt\n" + customer + "\n--as\nriley");
        std::test::assert(std::str::contains(receipt, "receipt " + customer + " [customer] delivered to record "), "the reference crosses: " + receipt);
        let rhid = word_after(receipt, "handoff ");
        let rhid7 = rhid[0..(len(rhid) - 1)];
        let notes_handed = self.cli(firm, "handoff\nacct\nreceipt\n" + internal + "\n--as\nriley");
        std::test::assert(std::str::contains(notes_handed, "[internal] delivered to record"), "an internal reference: " + notes_handed);
        std::test::assert(in_dir(acct, "git\nrev-parse\n-q\n--verify\nrefs/dna/receipts/" + internal[7..71]).code != 0, "no receipt body crossed, internal or not");
        std::test::assert(in_dir(acct, "git\nrev-parse\n-q\n--verify\nrefs/dna/receipts/" + customer[7..71]).code != 0, "the customer body is nowhere there");

        // ---- a connection that does not carry `customer` refuses it at the edge
        let narrow = self.cli(firm, "connect\n" + self.nerves + "\n--record\n" + acct_genesis + "\n--name\nnarrow\n--as\nauditor\n--purpose\naudit\n--classes\ninternal\n--by\nriley");
        let narrow_ok = self.cli(firm, "review\n" + word_after(narrow, "hale dna review ") + "\napprove\n--as\nana\n--authority\nboard\n--no-wait");
        let refused = self.cli(firm, "handoff\nnarrow\nreceipt\n" + customer + "\n--as\nriley");
        std::test::assert(std::str::contains(refused, "`customer` does not cross connection `narrow` (it carries internal); refused at the edge"), "refused: " + refused);
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"handoff.refused\""), 1, "the refusal is a row here");

        // ---- an envelope claiming the firm, signed with another key
        let forger = dna::ExchangeKey { vault: "dna-exchange-test-two" };
        let forged = forger.seal(dna::Envelope { id: "hforged.received", sender: firm_genesis, recipient: acct_genesis, kind: "received", entity: "handoff:hforged", body: "{\"kind\": \"task\", \"subject\": \"t99\", \"class\": \"internal\", \"purpose\": \"year-end books\", \"fact\": \"FORGED\"}", author: "mallory" });
        let c = nats::NatsClient { url: self.nerves, name: "handoff-test-forger", timeout: 3s };
        std::test::assert(c.open(), "the forger reaches the nerves: " + c.last_error);
        let fack = nats::js_publish_id(c, dna::exchange_inbox_subject(acct_org, firm_org, "received"), "hforged.received", std::bytes::from_string(forged)) or nats::PubAck { };
        let fwhy = c.last_error;
        c.close();
        std::test::assert(fack.seq > 0, "the forged envelope is in the inbox: " + fwhy);

        // ---- the accountant admits only under its own connection back
        let unadmitted = self.cli(acct, "handoff");
        std::test::assert(std::str::contains(unadmitted, hid7 + " ← task t7 from record ") && std::str::contains(unadmitted, "(riley as `accountant`, for `year-end books`) [internal] i-t7: job 7 for the accountant") && std::str::contains(unadmitted, "not admitted: no connection in force"), "listed, not admitted: " + unadmitted);
        std::test::assert_eq_int(text_lines_with(unadmitted, hid9 + " ← "), 1, "an envelope delivered twice is kept once");
        std::test::assert(std::str::contains(self.cli(acct, "handoff\naccept\n" + hid7 + "\n--as\nnoor"), "is not admitted — no connection in force"), "acceptance waits for a connection");
        let back = self.cli(acct, "connect\n" + self.nerves + "\n--record\n" + firm_genesis + "\n--name\nfirm\n--as\nclient\n--purpose\nyear-end books\n--classes\ninternal\n--by\nnoor");
        let back_ok = self.cli(acct, "review\n" + word_after(back, "hale dna review ") + "\napprove\n--as\nlee\n--authority\nboard\n--no-wait");
        let admitted = self.cli(acct, "handoff");
        std::test::assert(std::str::contains(admitted, hid7 + " ← task t7") && std::str::contains(admitted, "admitted under `firm`"), "admitted: " + admitted);
        std::test::assert(std::str::contains(admitted, "hforged ← task t99") && std::str::contains(admitted, "not admitted: it is not signed with the key connection `firm` pinned"), "the forged one is not: " + admitted);
        std::test::assert(std::str::contains(self.cli(acct, "handoff\naccept\nhforged\n--as\nnoor"), "is not admitted"), "and cannot be accepted");
        std::test::assert(std::str::contains(self.cli(acct, "handoff\naccept\n" + rhid7 + "\n--as\nnoor"), "`customer` does not cross connection `firm`"), "its own classes decide too");
        let accepted = self.cli(acct, "handoff\naccept\n" + hid7 + "\n--as\nnoor\n--note\ntaken on");
        std::test::assert(std::str::contains(accepted, "handoff " + hid7 + " accepted by noor under connection `firm`"), "accepted: " + accepted);
        std::test::assert_eq_int(record_lines_with(acct, "\"kind\": \"handoff.accepted\"\t\"entity\": \"handoff:" + hid7 + "\"\t\\\"origin_record\\\": \\\"" + firm_genesis + "\\\"\t\\\"purpose\\\": \\\"year-end books\\\""), 1, "admitted into the accountant's own record, with its origin and purpose");

        // t9 is accepted too; the firm read that acceptance and crashed between
        // its `handoff.accepted_by_peer` and the Task's `task.transfer_accepted` (#637)
        let accepted9 = self.cli(acct, "handoff\naccept\n" + hid9 + "\n--as\nnoor");
        std::test::assert(std::str::contains(accepted9, "accepted by noor"), "t9 accepted there: " + accepted9);
        self.row("handoff.accepted_by_peer", "handoff:" + hid9, "{\"connection\": \"acct\", \"handoff\": \"" + hid9 + "\", \"accepted_by\": \"noor\"}");

        // ---- the firm's Task settles only on that acceptance
        std::test::assert(std::str::contains(self.cli(firm, "status"), "t7 [transfer_requested]"), "not before the firm reads it");
        let read_back = self.cli(firm, "handoff\nsync");
        std::test::assert(std::str::contains(read_back, "handoff sync: 2 acceptance(s) admitted") && std::str::contains(read_back, "task t7 accepted by noor") && std::str::contains(read_back, "task t9 accepted by noor"), "read back, the interrupted one completed: " + read_back);
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"handoff.accepted_by_peer\"\t\"entity\": \"handoff:" + hid9 + "\""), 1, "t9's acceptance row is not written twice");
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"task.transfer_accepted\"\t\"entity\": \"t9\""), 1, "and its Task settles");
        std::test::assert(std::str::contains(self.cli(firm, "status"), "t7 [transfer_accepted]"), "settled");
        std::test::assert(std::str::contains(self.cli(firm, "handoff\nsync"), "0 acceptance(s) admitted"), "admitted once");

        // ---- nothing of the accountant's private history reached the firm
        std::test::assert_eq_str(objects_with(firm, "UNRELATED_PRIVATE_FACT"), "0", "no object in the firm's repository holds it");

        // ---- a full inbox refuses: the accountant holds seven of the firm's
        // envelopes (t7, t9, two receipts, the forged one, t8, t10)
        let t8 = self.cli(firm, "handoff\nacct\ntask\nt8\n--as\nriley");
        let hid8 = word_after(t8, "handoff ");
        let t10 = self.cli(firm, "handoff\nacct\ntask\nt10\n--as\nriley");
        std::test::assert(std::str::contains(t8, "delivered to record") && std::str::contains(t10, "delivered to record"), "the sixth and seventh: " + t8 + t10);
        let t11 = self.cli(firm, "handoff\nacct\ntask\nt11\n--as\nriley");
        std::test::assert(std::str::contains(t11, "inbox is full") && std::str::contains(t11, "nothing was recorded here"), "the eighth is refused: " + t11);
        std::test::assert(std::str::contains(self.cli(firm, "status"), "t11 [handed]"), "and its Task stays here");

        // ---- disconnecting leaves history and admits nothing further
        let closed = self.cli(firm, "disconnect\nacct\n--why\nthe engagement ended\n--by\nana");
        std::test::assert(std::str::contains(closed, "connection acct closed by ana"), "closed: " + closed);
        std::test::assert(std::str::contains(self.cli(firm, "handoff\nacct\ntask\nt11\n--as\nriley"), "is closed (the engagement ended)"), "nothing further crosses");
        let late = self.cli(acct, "handoff\naccept\n" + hid8[0..(len(hid8) - 1)] + "\n--as\nnoor");
        std::test::assert(std::str::contains(late, "accepted by noor"), "the accountant still accepts in its own record: " + late);
        let after_close = self.cli(firm, "handoff\nsync");
        std::test::assert(std::str::contains(after_close, "0 acceptance(s) admitted") && std::str::contains(after_close, "acct: closed — nothing admitted from it"), "nothing admitted after closing: " + after_close);
        std::test::assert(std::str::contains(self.cli(firm, "status"), "t8 [transfer_requested]"), "t8 is not settled by it");
        std::test::assert_eq_int(record_lines_with(firm, "\"kind\": \"handoff.published\""), 6, "history stays here");

        // ---- the nerves and memory the two records used, gone
        let d1 = dna::run_tool("sh\n-c\ncd \"$1\" && HALE_DNA_NATS_URL_OWNER=\"$2\" exec \"$3\" dna nerves drop\nsh\n" + firm + "\n" + nats_owner + "\n" + toolchain());
        let d2 = dna::run_tool("sh\n-c\ncd \"$1\" && HALE_DNA_NATS_URL_OWNER=\"$2\" exec \"$3\" dna nerves drop\nsh\n" + acct + "\n" + nats_owner + "\n" + toolchain());
        let u1 = dna::unmigrate(owner, firm_genesis);
        let u2 = dna::unmigrate(owner, acct_genesis);
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
