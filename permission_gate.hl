// PermissionGate — per-pane (read, write) policy gate.
//
// Phase 1: default-allow, no lock UI. Tools that don't yet exist
// will consult `allows(pane, op)` before publishing into a pane's
// command subject. Phase 5 adds the lock UI (Ctrl+L), persistence
// to <workspace>/.iris/permissions.json, and the
// ide.event.gate.denied toast.

type PanePolicy {
    read:  Bool = true;
    write: Bool = true;
}

locus PermissionGate {
    params {
        shell:  PanePolicy = PanePolicy { };
        source: PanePolicy = PanePolicy { };
        viz:    PanePolicy = PanePolicy { };
        agent:  PanePolicy = PanePolicy { };
    }

    fn allows(pane: String, op: String) -> Bool {
        if pane == "shell"  { return policy_allows(self.shell,  op); }
        if pane == "source" { return policy_allows(self.source, op); }
        if pane == "viz"    { return policy_allows(self.viz,    op); }
        if pane == "agent"  { return policy_allows(self.agent,  op); }
        return false;
    }

    // Phase 1 stub helpers for tests. The user-facing lock UI
    // (Ctrl+L → ide.cmd.gate.set → gate update) lands in Phase 5
    // with the visible window. Until then, tests flip policy via
    // these helpers directly.
    fn stub_lock_source_write() {
        self.source = PanePolicy { read: self.source.read, write: false };
    }

    fn stub_unlock_source_write() {
        self.source = PanePolicy { read: self.source.read, write: true };
    }
}

fn policy_allows(p: PanePolicy, op: String) -> Bool {
    if op == "read"  { return p.read; }
    if op == "write" { return p.write; }
    return false;
}
