// AgentPane — streaming prompt + response display.
//
// Phase 2a.2: subscribe to AgentChunk + AgentTurnDone, accumulate
// chunks into a scrollback BytesBuilder.
// Phase 2a.3 (this slice): on_key handles Enter to commit the
// input buffer as a UserPromptIn. Real char accumulation (typing)
// requires raylib's char-event surface; until that's wired,
// stub_fill_input lets the smoke test drive the input from
// outside.

import "lib/raylib" as ray;

locus AgentPane {
    params {
        focused:    Bool = false;
        scrollback: std::bytes::BytesBuilder
                  = std::bytes::BytesBuilder { initial_cap: 8192 };
        input_buf:  std::bytes::BytesBuilder
                  = std::bytes::BytesBuilder { initial_cap: 1024 };
        turns:      Int  = 0;
        applied:    Int  = 0;
        denied:     Int  = 0;
        last_denial: String = "";
    }

    bus {
        subscribe AgentChunk      as on_chunk;
        subscribe AgentTurnDone   as on_turn_done;
        subscribe ProposalApplied as on_applied;
        subscribe ProposalDenied  as on_denied;
        publish   UserPromptIn;
    }

    fn focus_gain() { self.focused = true;  }
    fn focus_lose() { self.focused = false; }
    fn name() -> String { return "agent"; }

    fn render(s: RenderSurface) {
        render_frame(s, "agent");
        // Real scrollback + input rendering lands once we have
        // font metrics + line wrapping. Phase 2a confirms the
        // chunks arrive; drawing them comes in a later sub-phase.
    }

    // ---- Bus handlers.

    fn on_chunk(c: Chunk) {
        self.scrollback.append(std::bytes::from_string(c.text));
    }

    fn on_turn_done(t: TurnComplete) {
        let _ = t;
        self.scrollback.append(std::bytes::from_string("\n"));
        self.turns = self.turns + 1;
    }

    fn on_applied(a: Applied) {
        self.applied = self.applied + 1;
        self.scrollback.append(std::bytes::from_string("\n[applied: "));
        self.scrollback.append(std::bytes::from_string(a.channel));
        self.scrollback.append(std::bytes::from_string("]"));
    }

    fn on_denied(d: Denial) {
        self.denied = self.denied + 1;
        self.last_denial = d.why;
        self.scrollback.append(std::bytes::from_string("\n[denied: "));
        self.scrollback.append(std::bytes::from_string(d.channel));
        self.scrollback.append(std::bytes::from_string(" — "));
        self.scrollback.append(std::bytes::from_string(d.why));
        self.scrollback.append(std::bytes::from_string("]"));
    }

    // ---- Input.

    fn on_key(k: KeyEvent) {
        if k.code == ray::KEY_ENTER {
            self.commit_input();
            return;
        }
        if k.code == ray::KEY_BACKSPACE {
            // Pop last byte. BytesBuilder doesn't expose pop_back
            // at v1; for now this is a no-op until real keyboard
            // input lights up and we either get the method or
            // implement via clear+re-append.
            return;
        }
        // Printable char accumulation requires an Int → 1-byte
        // helper that the stdlib doesn't surface today. Stub
        // raylib produces no chars anyway; real char accumulation
        // lights up when the keyboard FFI lands.
        let _ = k;
    }

    fn commit_input() {
        let text = std::str::from_bytes(self.input_buf.view());
        UserPromptIn <- UserPrompt { text: text };
        self.input_buf.clear();
    }

    // ---- Test / debug surface (goes away when real input lands).

    fn stub_fill_input(text: String) {
        self.input_buf.append(std::bytes::from_string(text));
    }

    // ---- Inspection (also test-only).

    fn scrollback_text() -> String {
        return std::str::from_bytes(self.scrollback.view());
    }

    fn turn_count() -> Int {
        return self.turns;
    }

    fn applied_count() -> Int {
        return self.applied;
    }

    fn denied_count() -> Int {
        return self.denied;
    }

    fn last_denial_reason() -> String {
        return self.last_denial;
    }
}
