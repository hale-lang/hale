// dna/core/legs/client.hl — the head, as a leg sees it (GH #946 slice 4;
// GH #1104 piece 5).
//
// A leg holds nothing between tasks and has no database role: everything
// it knows it reads from the head — the record and the hat over HTTP,
// which stay reads — and everything it does is a call on a member of the
// head's surface over its socket (`Commands::claim`, GH #1417): the
// claim, the renewal, the ask for its spend (GH #1131), the outcome, the
// release, the friction, and the
// lookup that reads a command back, each under a request id the leg
// mints from what it asks, so a verb run twice is one act and the second
// run reads the first's receipt. The socket authenticates: the principal
// is the peer's credentials, mapped to a person by the record
// (`dna.unix.member`), and a verb outside what that person holds is not
// in the description the socket gives it (a call to it is `unauthorized`).
// The commands are the generated client of `HeadCommands` (`head_commands/`,
// `hale api client --lang hale`, held current by scripts/api-clients.sh): a
// typed request per member, the five outcomes as an enum, the surface's digest
// sent on every call. This file only maps those outcomes onto the verbs' `Reply`.
// This seed sits beside the core it imports as `..` in the repository
// (`dna/core/legs`), in the toolchain cache, and in a project's
// `vendor/dna/legs`, like pond's copies do.
import ".." as dna;
import "./head_commands" as hc;

// The members the leg's attach looks for in the description the socket serves it.
const CLAIM_MEMBER: String = "Commands::claim";
const ALLOWANCE_MEMBER: String = "Commands::ask_allowance";

type Reply {
    ok: Bool = false; // an answer with a receipt (a refusal is a receipt: `state: refused`)
    status: Int = 0; // 0 when the head could not be reached
    body: String = ""; // `{"data": <receipt>, "source": {record_head, record_id, record_revision}}`
    error: String = ""; // the transport's failure, the binding's refusal, or the head's error code
}

// Whether a head's answer admitted nothing because its record moved
// under it: asked again, it is answered. Both are error codes, never a
// receipt: a refusal is a receipt, and a binding's refusal names its kind.
fn head_moved(error: String) -> Bool {
    return std::str::starts_with(error, "snapshot_changed") || error == "command_busy";
}

// How long a leg asks again a command, or a read, its head's moving
// record left unanswered: ten seconds, by the clock.
const HEAD_MOVED_NS: Int = 10000000000;

// A command's answer as the verbs read one. The value is the head's
// `CommandReply`: its receipt goes under `data`, its head under `source`; a
// reply that carries no receipt is the head's error code; a refusal of the
// binding (`unknown`, `unauthorized`, `malformed`) is the error, naming its kind.
fn command_reply(value: hc::CommandReply) -> Reply {
    if !value.ok && len(value.receipt.state) == 0 {
        return Reply { status: 400, error: value.code };
    }
    let body = "{\"data\":" + hc::api_enc_CommandReceipt(value.receipt) + ",\"source\":{\"record_head\":" + hc::api_str(value.head) + ",\"record_id\":" + hc::api_str(value.application_id) + ",\"record_revision\":" + hc::api_str(to_string(value.revision)) + "}}";
    return Reply { ok: true, status: 200, body: body };
}

fn refusal_reply(f: hc::ApiRefusal) -> Reply {
    return Reply { status: 400, error: (if len(f.kind) > 0 { f.kind } else { "refused" }) + ": " + f.reason };
}

fn server_reply() -> Reply {
    return Reply { status: 500, error: "server: the head failed while it ran the command" };
}

fn lost_reply(path: String, why: String) -> Reply {
    return Reply { status: 0, error: "the head's socket at " + path + " gave no answer: " + why };
}

fn claim_reply(path: String, o: hc::CommandsClaimOutcome) -> Reply {
    return match o {
        hc::CommandsClaimOutcome::Result(v) -> command_reply(v),
        hc::CommandsClaimOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsClaimOutcome::ServerError -> server_reply(),
        hc::CommandsClaimOutcome::Lost(why) -> lost_reply(path, why),
    };
}

fn renew_reply(path: String, o: hc::CommandsRenewOutcome) -> Reply {
    return match o {
        hc::CommandsRenewOutcome::Result(v) -> command_reply(v),
        hc::CommandsRenewOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsRenewOutcome::ServerError -> server_reply(),
        hc::CommandsRenewOutcome::Lost(why) -> lost_reply(path, why),
    };
}

fn release_reply(path: String, o: hc::CommandsReleaseAttemptOutcome) -> Reply {
    return match o {
        hc::CommandsReleaseAttemptOutcome::Result(v) -> command_reply(v),
        hc::CommandsReleaseAttemptOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsReleaseAttemptOutcome::ServerError -> server_reply(),
        hc::CommandsReleaseAttemptOutcome::Lost(why) -> lost_reply(path, why),
    };
}

fn outcome_reply(path: String, o: hc::CommandsOutcomeOutcome) -> Reply {
    return match o {
        hc::CommandsOutcomeOutcome::Result(v) -> command_reply(v),
        hc::CommandsOutcomeOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsOutcomeOutcome::ServerError -> server_reply(),
        hc::CommandsOutcomeOutcome::Lost(why) -> lost_reply(path, why),
    };
}

fn allowance_reply(path: String, o: hc::CommandsAskAllowanceOutcome) -> Reply {
    return match o {
        hc::CommandsAskAllowanceOutcome::Result(v) -> command_reply(v),
        hc::CommandsAskAllowanceOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsAskAllowanceOutcome::ServerError -> server_reply(),
        hc::CommandsAskAllowanceOutcome::Lost(why) -> lost_reply(path, why),
    };
}

fn friction_reply(path: String, o: hc::CommandsFileFrictionOutcome) -> Reply {
    return match o {
        hc::CommandsFileFrictionOutcome::Result(v) -> command_reply(v),
        hc::CommandsFileFrictionOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsFileFrictionOutcome::ServerError -> server_reply(),
        hc::CommandsFileFrictionOutcome::Lost(why) -> lost_reply(path, why),
    };
}

fn lookup_reply(path: String, o: hc::CommandsLookupOutcome) -> Reply {
    return match o {
        hc::CommandsLookupOutcome::Result(v) -> command_reply(v),
        hc::CommandsLookupOutcome::Refusal(f) -> refusal_reply(f),
        hc::CommandsLookupOutcome::ServerError -> server_reply(),
        hc::CommandsLookupOutcome::Lost(why) -> lost_reply(path, why),
    };
}

locus Head {
    params {
        api: String = "http://127.0.0.1:8793"; // the API's origin: the reads
        socket: String = ""; // the head's api socket: the commands (--socket, HALE_DNA_SOCKET, or as /capabilities names it)
        application: String = "";
        record_head: String = "";
        record_revision: String = "";
        principal_mode: String = "";
        principal_name: String = "";
        attached: Bool = false;
        error: String = "";
        // the members this head lists for the leg
        claim_member: String = "";
        allowance_member: String = "";
    }
    fn transport_failed(e: std::http::HttpError) -> std::http::ClientResponse {
        return std::http::ClientResponse { status: 0, body: std::bytes::from_string(e.kind + " " + e.detail) };
    }
    fn http(method: String, url: String, headers: String, body: String) -> std::http::ClientResponse fallible(std::http::HttpError) {
        let u = std::http::parse_url(url) or raise;
        let req = std::http::ClientRequest { method: method, url: u, headers: headers, body: std::bytes::from_string(body) };
        return std::http::request(req) or raise;
    }
    fn reply(r: std::http::ClientResponse) -> Reply {
        let text = std::str::from_bytes(r.body);
        if r.status == 0 { return Reply { status: 0, error: "the head at " + self.api + " cannot be reached: " + text }; }
        if r.status < 200 || r.status >= 300 {
            let e = std::json::find_field_raw(text, "error");
            let code = std::json::find_string_field(e, "code");
            let message = std::json::find_string_field(e, "message");
            return Reply { status: r.status, body: text, error: if len(code) > 0 { code + ": " + message } else { "HTTP " + to_string(r.status) } };
        }
        return Reply { ok: true, status: r.status, body: text };
    }
    // A read over the head's HTTP. Under OIDC (GH #989) a head reads
    // nothing to a caller with no token: the leg presents its person's ID
    // token as the bearer (HALE_DNA_ID_TOKEN); its commands stay on the
    // socket, where the kernel vouches for the peer.
    fn get(path: String) -> Reply {
        // never to plain http off this machine
        let safe = std::str::starts_with(self.api, "https://") || std::str::starts_with(self.api, "http://127.0.0.1:") || std::str::starts_with(self.api, "http://localhost:");
        let token = if safe { std::env::var("HALE_DNA_ID_TOKEN") } else { "" };
        let headers = "Accept: application/json" + (if len(token) > 0 { "\r\nAuthorization: Bearer " + token } else { "" });
        let r = self.http("GET", self.api + path, headers, "") or self.transport_failed(err);
        return self.reply(r);
    }
    fn prefix() -> String { return "/api/hale/v1/applications/" + self.application; }
    // The application the head serves, its record head, the socket its
    // commands are on, and the principal: what the reads say, then the
    // binding's own word on what this peer may call. Once per verb, or
    // once per renewal of a lease held through a wait.
    @unbounded
    fn attach() -> Bool {
        // a read while another leg's row lands answers `snapshot_changed`:
        // read again, for up to ten seconds
        let mut until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let mut apps = self.get("/api/hale/v1/applications");
        while !apps.ok && head_moved(apps.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            apps = self.get("/api/hale/v1/applications");
        }
        if !apps.ok { self.error = apps.error; return false; }
        let source = std::json::find_field_raw(apps.body, "source");
        self.application = std::json::find_string_field(source, "record_id");
        self.record_head = std::json::find_string_field(source, "record_head");
        self.record_revision = std::json::find_string_field(source, "record_revision");
        if len(self.application) == 0 { self.error = "the head at " + self.api + " names no application"; return false; }
        let mut caps = self.get(self.prefix() + "/capabilities");
        until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        while !caps.ok && head_moved(caps.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            caps = self.get(self.prefix() + "/capabilities");
        }
        if !caps.ok { self.error = caps.error; return false; }
        let data = std::json::find_field_raw(caps.body, "data");
        let principal = std::json::find_field_raw(data, "principal");
        self.principal_mode = std::json::find_string_field(principal, "mode");
        self.principal_name = std::json::find_string_field(principal, "name");
        if len(self.socket) == 0 { self.socket = std::json::find_string_field(std::json::find_field_raw(data, "api"), "socket"); }
        if len(self.socket) == 0 { self.error = "the head at " + self.api + " names no socket for its commands (an older head: `hale dna upgrade` the toolchain that serves it)"; return false; }
        // the socket serves the description its peer's person is admitted to
        // (the generated client reads it): a peer that holds no position is
        // listed no claim
        if hc::api_lists(self.socket, "", CLAIM_MEMBER) { self.claim_member = CLAIM_MEMBER; }
        if hc::api_lists(self.socket, "", ALLOWANCE_MEMBER) { self.allowance_member = ALLOWANCE_MEMBER; }
        if len(self.claim_member) == 0 {
            self.error = "the head's socket lists no `" + CLAIM_MEMBER + "` for " + self.principal_name + ": this peer holds no position the record knows (`git config --local --add dna.unix.member \"uid:<n>=<person>\"`, and a `holds` edge), or the head serves no commands";
            return false;
        }
        self.attached = true;
        return true;
    }
    // The commands, each one call on its member of the generated client, the
    // receipt as the verbs read it. A head that read its record while another
    // writer's row landed answers `snapshot_changed`, and one whose record kept
    // moving through all of its reads answers `command_busy`: neither admitted
    // the command. It is asked again, 200ms apart, until ten seconds have
    // passed, under the same request id, so it is the same act: one that landed
    // meanwhile is found by it and answered with its receipt. A record several
    // legs and the owner write moves often; the answer is never the leg's to
    // give up on.
    // `effect_class` is the performer's (GH #946): the claim is filtered on it
    @unbounded
    fn claim(request_id: String, performer_kind: String, performer: String, effect_class: String, capabilities: String, data_classes: String, organizations: String, ttl: Int) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Claim { request_id: request_id, record_head: self.record_head, performer_kind: performer_kind, performer: performer, effect_class: effect_class, capabilities: capabilities, data_classes: data_classes, organizations: organizations, ttl: ttl };
        let mut r = claim_reply(self.socket, hc::commands_claim(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = claim_reply(self.socket, hc::commands_claim(self.socket, "", req));
        }
        return r;
    }
    @unbounded
    fn renew(request_id: String, attempt_id: String, holder: String, token: Int, ttl: Int) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Renewal { request_id: request_id, attempt_id: attempt_id, holder: holder, token: token, ttl: ttl };
        let mut r = renew_reply(self.socket, hc::commands_renew(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = renew_reply(self.socket, hc::commands_renew(self.socket, "", req));
        }
        return r;
    }
    @unbounded
    fn give_back(request_id: String, attempt_id: String, holder: String, token: Int, why: String) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Release { request_id: request_id, attempt_id: attempt_id, holder: holder, token: token, why: why };
        let mut r = release_reply(self.socket, hc::commands_release_attempt(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = release_reply(self.socket, hc::commands_release_attempt(self.socket, "", req));
        }
        return r;
    }
    // The outcome: `evidence` and `receipts` travel as JSON arrays in text;
    // the hat fields are empty and -1 when no hat was worn.
    @unbounded
    fn outcome(request_id: String, attempt_id: String, holder: String, token: Int, effect_class: String, disposition: String, result: String, result_ref: String, narrative: String, evidence: String, receipts: String, hat_digest: String, hat_head: String, hat_watermark: Int, prompt_digest: String, renderer: String) -> Reply {
        // the hat's five fields travel together or not at all
        let worn = len(hat_digest) > 0;
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Outcome { request_id: request_id, attempt_id: attempt_id, holder: holder, token: token, effect_class: effect_class, disposition: disposition, result: result, result_ref: result_ref, narrative: narrative, evidence: if len(evidence) > 0 { evidence } else { "[]" }, receipts: if len(receipts) > 0 { receipts } else { "[]" }, hat_digest: if worn { hat_digest } else { "" }, hat_head: if worn { hat_head } else { "" }, hat_watermark: if worn { hat_watermark } else { -1 }, prompt_digest: if worn { prompt_digest } else { "" }, renderer: if worn { renderer } else { "" } };
        let mut r = outcome_reply(self.socket, hc::commands_outcome(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = outcome_reply(self.socket, hc::commands_outcome(self.socket, "", req));
        }
        return r;
    }
    // The ask for the attempt's spend (GH #1131), under the lease: the
    // spine answers it with a row, which the ask's lookup reads back
    // (`granted` with the allowance, or `refused` with why).
    @unbounded
    fn allowance(request_id: String, attempt_id: String, holder: String, token: Int) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Allowance { request_id: request_id, attempt_id: attempt_id, holder: holder, token: token };
        let mut r = allowance_reply(self.socket, hc::commands_ask_allowance(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = allowance_reply(self.socket, hc::commands_ask_allowance(self.socket, "", req));
        }
        return r;
    }
    @unbounded
    fn friction(request_id: String, position: String, attempt_id: String, text: String) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Friction { request_id: request_id, record_head: self.record_head, position: position, attempt_id: attempt_id, text: text };
        let mut r = friction_reply(self.socket, hc::commands_file_friction(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = friction_reply(self.socket, hc::commands_file_friction(self.socket, "", req));
        }
        return r;
    }
    // A command read back by the request id the leg minted.
    @unbounded
    fn lookup(request_id: String) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let req = hc::Lookup { request_id: request_id };
        let mut r = lookup_reply(self.socket, hc::commands_lookup(self.socket, "", req));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = lookup_reply(self.socket, hc::commands_lookup(self.socket, "", req));
        }
        return r;
    }
    // The hat of one Work, as the head renders it: structure, never a
    // prompt (a read). The head refuses a hat the record moved under
    // while it was built (`snapshot_changed`, another leg's row landing):
    // read again, as a command is asked again, for up to ten seconds.
    @unbounded
    fn context(work_id: String) -> Reply {
        let until = std::time::monotonic_ns() + HEAD_MOVED_NS;
        let mut r = self.get(self.prefix() + "/dna/context?id=" + dna::url_encode(work_id));
        while !r.ok && head_moved(r.error) && std::time::monotonic_ns() < until {
            std::time::sleep(200ms);
            r = self.get(self.prefix() + "/dna/context?id=" + dna::url_encode(work_id));
        }
        return r;
    }
}
