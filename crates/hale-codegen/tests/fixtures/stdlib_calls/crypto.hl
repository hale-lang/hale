// Build-only call fixture (F.40 phase 4, S0): `std::crypto` at statement
// position, and the two digests the rest of the line S shadow set calls
// only through the stdlib, at expression position. Never run;
// `stdlib_call_fixtures` builds it to IR. `ecdsa_p256_sign` can fail, so
// it takes an `or` (S5): the empty Bytes its bare call used to answer.

fn main() {
    let b = std::bytes::from_string("message");
    std::crypto::crc32(b);
    let sig = std::crypto::ecdsa_p256_sign(b, b) or b"";
    std::crypto::ecdsa_p256_verify(b, b, b);
    std::crypto::hmac_sha256(b, b);
    std::crypto::hmac_sha512(b, b);
    std::crypto::sha1(b);
    std::crypto::sha256(b);
    std::crypto::sha512(b);
    std::crypto::__ed25519_public_key(b);
    std::crypto::ed25519_verify(b, b, b);
    let mac = std::crypto::hmac_sha512(b, b);
    let digest = std::crypto::sha512(b);
    let pk = std::crypto::__ed25519_public_key(b);
    let ed = std::crypto::ed25519_sign(b, b) or b"";
    let ok = std::crypto::ed25519_verify(pk, b, ed);
    let h = std::crypto::__sha256_new();
    std::crypto::__sha256_update(h, b);
    let streamed = std::crypto::__sha256_finish(h);
    std::crypto::__sha256_free(h);
    let filed = std::crypto::sha256_file("/dev/null") or b"";
    println(len(mac) + len(digest) + len(sig) + len(pk) + len(ed) + len(streamed) + len(filed), ok);
}
