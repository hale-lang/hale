// raylib bindings — real, @ffi-backed (Phase 5).
//
// Surface unchanged from the prior stub era; iris consumer code
// (`ray::init_window(...)` etc.) compiles identically. Internally
// each function delegates to an @ffi("c") extern declared
// against the C glue in glue.c.
//
// Build picks up the link surface (libraylib + glue.c) from this
// directory's hale.toml. Consumers don't need flags.
//
// Layout: user structs (Color, Vec3, Rect, Camera3D) in types.hl
// are passed by pointer per spec/ffi.md §"User-type structs"; the
// C glue does field-by-field conversion to raylib's compact-byte /
// float-shaped equivalents.

// ---- @ffi extern decls (one per upstream binding) ----

@ffi("c") fn raylib_init_window(w: Int, h: Int, title: String);
@ffi("c") fn raylib_close_window();
@ffi("c") fn raylib_should_close() -> Bool;
@ffi("c") fn raylib_set_target_fps(fps: Int);
@ffi("c") fn raylib_get_screen_width() -> Int;
@ffi("c") fn raylib_get_screen_height() -> Int;
@ffi("c") fn raylib_set_window_title(title: String);

@ffi("c") fn raylib_begin_frame();
@ffi("c") fn raylib_end_frame();
@ffi("c") fn raylib_clear_background(c: Color);
@ffi("c") fn raylib_begin_scissor(r: Rect);
@ffi("c") fn raylib_end_scissor();

@ffi("c") fn raylib_draw_text(text: String, x: Int, y: Int, size: Int, c: Color);
@ffi("c") fn raylib_measure_text(text: String, size: Int) -> Int;
@ffi("c") fn raylib_draw_rect(r: Rect, c: Color);
@ffi("c") fn raylib_draw_rect_lines(r: Rect, c: Color);
@ffi("c") fn raylib_draw_line(x1: Int, y1: Int, x2: Int, y2: Int, c: Color);
@ffi("c") fn raylib_draw_circle(x: Int, y: Int, radius: Float, c: Color);

@ffi("c") fn raylib_begin_mode_3d(cam: Camera3D);
@ffi("c") fn raylib_end_mode_3d();
@ffi("c") fn raylib_draw_cube(pos: Vec3, size: Vec3, c: Color);
@ffi("c") fn raylib_draw_sphere(center: Vec3, radius: Float, c: Color);
@ffi("c") fn raylib_draw_line_3d(start: Vec3, finish: Vec3, c: Color);
@ffi("c") fn raylib_draw_grid(slices: Int, spacing: Float);
@ffi("c") fn raylib_draw_plane(center: Vec3, size: Vec3, c: Color);
@ffi("c") fn raylib_update_camera(cam: Camera3D, mode: Int) -> Camera3D;

@ffi("c") fn raylib_is_key_down(key: Int) -> Bool;
@ffi("c") fn raylib_is_key_pressed(key: Int) -> Bool;
@ffi("c") fn raylib_is_key_released(key: Int) -> Bool;
@ffi("c") fn raylib_get_char_pressed() -> Int;
@ffi("c") fn raylib_get_key_pressed() -> Int;
@ffi("c") fn raylib_is_mouse_button_down(b: Int) -> Bool;
@ffi("c") fn raylib_is_mouse_button_pressed(b: Int) -> Bool;
@ffi("c") fn raylib_get_mouse_position() -> Vec2;
@ffi("c") fn raylib_get_mouse_delta() -> Vec2;
@ffi("c") fn raylib_get_mouse_wheel_move() -> Float;

// ---- User-facing wrappers (consumer surface unchanged from stubs).

locus Window {
    params {
        width:      Int = 1280;
        height:     Int = 720;
        title:      String = "iris";
        target_fps: Int = 60;
        opened:     Bool = false;
    }
    // No auto-open on birth — callers (Renderer.open_window via
    // Iris.interactive_loop) explicitly request the GUI surface.
    // This lets --mcp / headless modes construct an Iris without
    // triggering raylib_init_window.
    fn open() {
        if self.opened { return; }
        raylib_init_window(self.width, self.height, self.title);
        raylib_set_target_fps(self.target_fps);
        self.opened = true;
    }
    dissolve() {
        if self.opened {
            raylib_close_window();
        }
    }
}

// ---- Window lifecycle ----

fn init_window(width: Int, height: Int, title: String) -> () {
    raylib_init_window(width, height, title);
}

fn close_window() -> () {
    raylib_close_window();
}

fn should_close() -> Bool {
    return raylib_should_close();
}

fn set_target_fps(fps: Int) -> () {
    raylib_set_target_fps(fps);
}

fn get_screen_width()  -> Int { return raylib_get_screen_width(); }
fn get_screen_height() -> Int { return raylib_get_screen_height(); }

fn set_window_title(title: String) -> () {
    raylib_set_window_title(title);
}

// ---- Frame ----

fn begin_frame() -> () { raylib_begin_frame(); }
fn end_frame()   -> () { raylib_end_frame(); }

fn clear_background(c: Color) -> () {
    raylib_clear_background(c);
}

fn begin_scissor(r: Rect) -> () { raylib_begin_scissor(r); }
fn end_scissor()          -> () { raylib_end_scissor(); }

// ---- 2D drawing ----

fn draw_text(text: String, x: Int, y: Int, size: Int, c: Color) -> () {
    raylib_draw_text(text, x, y, size, c);
}

fn measure_text(text: String, size: Int) -> Int {
    return raylib_measure_text(text, size);
}

fn draw_rect(r: Rect, c: Color) -> () {
    raylib_draw_rect(r, c);
}

fn draw_rect_lines(r: Rect, c: Color) -> () {
    raylib_draw_rect_lines(r, c);
}

fn draw_line(x1: Int, y1: Int, x2: Int, y2: Int, c: Color) -> () {
    raylib_draw_line(x1, y1, x2, y2, c);
}

fn draw_circle(x: Int, y: Int, radius: Float, c: Color) -> () {
    raylib_draw_circle(x, y, radius, c);
}

// ---- 3D drawing ----

fn begin_mode_3d(cam: Camera3D) -> () {
    raylib_begin_mode_3d(cam);
}

fn end_mode_3d() -> () {
    raylib_end_mode_3d();
}

fn draw_cube(pos: Vec3, size: Vec3, c: Color) -> () {
    raylib_draw_cube(pos, size, c);
}

fn draw_sphere(center: Vec3, radius: Float, c: Color) -> () {
    raylib_draw_sphere(center, radius, c);
}

fn draw_line_3d(start: Vec3, finish: Vec3, c: Color) -> () {
    raylib_draw_line_3d(start, finish, c);
}

fn draw_grid(slices: Int, spacing: Float) -> () {
    raylib_draw_grid(slices, spacing);
}

fn draw_plane(center: Vec3, size: Vec3, c: Color) -> () {
    raylib_draw_plane(center, size, c);
}

fn update_camera(cam: Camera3D, mode: Int) -> Camera3D {
    return raylib_update_camera(cam, mode);
}

// ---- Input ----

fn is_key_down(key: Int)     -> Bool { return raylib_is_key_down(key); }
fn is_key_pressed(key: Int)  -> Bool { return raylib_is_key_pressed(key); }
fn is_key_released(key: Int) -> Bool { return raylib_is_key_released(key); }
fn get_char_pressed()        -> Int  { return raylib_get_char_pressed(); }
fn get_key_pressed()         -> Int  { return raylib_get_key_pressed(); }
fn is_mouse_button_down(b: Int)    -> Bool { return raylib_is_mouse_button_down(b); }
fn is_mouse_button_pressed(b: Int) -> Bool { return raylib_is_mouse_button_pressed(b); }
fn get_mouse_position() -> Vec2 { return raylib_get_mouse_position(); }
fn get_mouse_delta()    -> Vec2 { return raylib_get_mouse_delta(); }
fn get_mouse_wheel_move() -> Float { return raylib_get_mouse_wheel_move(); }
