// Shape types that flow on the iris bus.
//
// These are pure data — types, not loci — per the styleguide.
// Bus payload types live here; behavior lives on the loci that
// produce / consume them.

import "lib/raylib" as ray;

// Raw keystroke from InputCapture. Routed by Iris.on_key to the
// focused pane via `ide.input.<pane>.key`.
type KeyEvent {
    code:  Int  = 0;        // raylib keycode (KEY_A, KEY_ENTER, ...)
    char:  Int  = 0;        // unicode char if any (0 otherwise)
    shift: Bool = false;
    ctrl:  Bool = false;
    alt:   Bool = false;
}

// Focus change notification published by Iris when the focused
// pane changes.
type FocusChange {
    from: String = "";      // previous focused pane name
    to:   String = "";      // new focused pane name
}

// Programmatic focus request — a pane or tool asks to be focused.
type FocusRequest {
    pane: String = "";      // target pane name
}

// What Iris passes to Pane.render() each frame. Carries the
// pane's allocated bounds and its focus state so render is
// self-contained — the pane doesn't need to query Iris for its
// rect or focus.
type RenderSurface {
    bounds:  ray::Rect;
    focused: Bool = false;
}

// Quit signal fired by Ctrl+Q or window close.
type QuitRequest {
    reason: String = "user";
}

// ---- Agent loop payloads ----------------------------------------

// User prompt committed from AgentPane on Enter.
type UserPrompt {
    text: String = "";
}

// One streamed text chunk from the active AgentBackend.
type Chunk {
    text: String = "";
}

// Marks the end of an assistant turn — caller can re-enable input.
type TurnComplete {
    ts: Int = 0;       // monotonic timestamp (0 when unknown)
}

// Agent requested a tool call (display + dispatch).
type ToolCall {
    id:        String = "";
    name:      String = "";
    args_json: String = "";
}

// Result of a tool invocation, echoed back to the agent.
type ToolResult {
    id:          String = "";
    result_json: String = "";
}

// Backend-level error (transport / auth / rate-limit).
type AgentErrorPayload {
    kind:   String = "";
    detail: String = "";
}

// Backend ready-state changed (e.g. reconnect, key swap).
type AgentReadyChanged {
    ready: Bool = false;
}

// ---- Proposal pipeline payloads (Phase 1) ----------------------

// A structured-output proposal extracted from the agent's
// response stream. The agent emits `iris.proposal { ... }` blocks
// in its response text; ProposalExtractor parses them and
// publishes Proposal payloads onto ide.proposal.in.
type Proposal {
    id:      String = "";
    channel: String;          // required — e.g. "ide.cmd.source.open"
    payload: String;          // required — raw JSON of the payload object
    reason:  String = "";
    ts:      Int    = 0;
}

// Dispatched proposal succeeded (gate allowed; channel published).
type Applied {
    proposal_id: String = "";
    channel:     String;
    ts:          Int = 0;
}

// Dispatched proposal denied (gate refused OR unknown channel).
type Denial {
    proposal_id: String = "";
    channel:     String;
    why:         String;
    ts:          Int = 0;
}

// ---- Per-channel command payloads ------------------------------
// One type per `ide.cmd.<pane>.<action>` channel that
// ProposalDispatcher can dispatch into. Add as channels light up.

type SourceOpen {
    path: String;
    line: Int = 0;
}

// Source pane's file pointer changed. Fired by SourcePane.on_open
// today; will be fired by the fsnotify watcher once that's wired.
type SourceChanged {
    path:    String;
    content: String = "";   // file content; empty until fsnotify lands
}

// Viz mode switch (bulk / harmonic / resolution).
type VizMode {
    mode: String;
}
