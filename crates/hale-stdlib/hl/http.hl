// Hale stdlib — std::http.
//
// HTTP request parsing + response writing. Composes on
// std::io::tcp::Stream (defined in io_tcp.hl, which comes
// before this file in the concat order so __write_http_response's
// signature can resolve `std::io::tcp::Stream` at fn-decl
// time).
//
// User code reaches these via:
//   - `std::http::Request` / `std::http::Response`
//     (struct literals; types declared here)
//   - `std::http::parse_request(raw)` (path-call dispatch
//     in codegen routes to __parse_http_request below)
//   - `std::http::write_response(s, resp)` (similarly routed
//     to __write_http_response)

// m84 — HTTP types: Request and Response.
//
// Both are `type` (records), not loci — they're plain data
// with no lifecycle. Returnable from fns by value, embeddable
// in larger structures, no dissolve to schedule. User code
// references them via `std::http::Request` / `std::http::Response`
// (path-rewritten to `__StdHttp*` at codegen time).
//
// Request carries the parsed request line (method, path,
// HTTP version), the body, and a raw `headers` block
// containing all header lines joined by `\r\n` (no trailing
// CRLF). Users look up individual headers via the free fn
// `std::http::header(req, name)` which walks the block.
// Headers stay packed (not parsed into a map) because v0 has
// no map type and a fixed-cap key/value array adds enough
// machinery for marginal benefit on the typical < 30 headers
// per request. Lookup is case-sensitive at v1 — callers that
// need RFC-7230 case-insensitive semantics pre-normalize the
// header name.
/// One parsed HTTP request as the Server hands it to a Handler:
/// method / path (raw target incl. query string) / version /
/// CRLF-joined headers / body — plus `conn_fd` for the takeover
/// surface. Look headers up with `std::http::header(req, name)`
/// (case-insensitive).
type __StdHttpRequest {
    method: String;
    path: String;
    /// Defaults let a hand-built Request (unit tests, Router
    /// dispatch probes — the documented parse_request-adjacent
    /// pattern) spell only what it means: method + path (+ body).
    /// GH #470 made literal fields checked for real; these
    /// defaults keep that check ergonomic rather than pedantic.
    version: String = "HTTP/1.1";
    headers: String = "";
    body: String = "";
    /// The live connection fd (Upgrade/takeover surface,
    /// 2026-07-19). Populated by the Server's per-connection
    /// loop before dispatch; -1 when the Request was built by
    /// `parse_request` outside a Server (unit tests, Router
    /// dispatch probes). Only meaningful together with
    /// `Response { takeover: true }` — stash it (typically
    /// publish to a session locus) and the connection is yours.
    conn_fd: Int = -1;
}

// Response carries the status code (200, 404, etc.) plus a
// content_type, an optional user-supplied `headers` block, and
// the body. The fixed header set (Content-Type, Content-Length,
// Connection: close) is still emitted unconditionally by
// `write_response`; the C11 `headers` field (pond follow-up)
// lets user code attach additional header lines (Set-Cookie,
// X-Custom-*, CORS, etc.) without dropping down to a custom
// Stream-driven writer. Mirrors `Request.headers` semantics:
// CRLF-joined header lines with no trailing CRLF; lookup is
// handled by the symmetric `std::http::header(resp, name)`
// path-call. `content_type` defaults to "text/plain" so the
// common case (`Response { status: 200, body: "ok" }`) writes
// a valid response without the agent having to populate every
// field. Set it explicitly for JSON / HTML / etc.
/// The Handler's answer. `content_type` defaults to text/plain;
/// `headers` carries extra CRLF-joined lines (Set-Cookie, CORS);
/// `takeover: true` switches to the Upgrade path (see field doc).
type __StdHttpResponse {
    status: Int;
    content_type: String = "text/plain";
    headers: String = "";
    body: String;
    /// Connection takeover (2026-07-19): when true, the Server
    /// writes ONLY the status line + `headers` + blank line — no
    /// Content-Type/Content-Length/Connection: close, no body —
    /// and returns without closing the fd. The handler owns the
    /// connection from that moment (it read `req.conn_fd`); the
    /// 5s recv timeout the conn loop set is still armed — clear
    /// or re-arm it via `std::io::tcp::set_recv_timeout`. The
    /// canonical use is `101 Switching Protocols` with
    /// `Upgrade:`/`Connection: Upgrade` lines in `headers`
    /// (WebSocket), but takeover is status-agnostic (a CONNECT
    /// tunnel's 200 works the same way).
    takeover: Bool = false;
    /// Raw takeover (Crumb batch-3, 2026-07-28): when true, the
    /// Server writes NOTHING — no status line, no headers — and
    /// ownership of `conn_fd` transfers exactly as with
    /// `takeover`. For the deferred-response shape: the handler
    /// doesn't know the status yet (the answer arrives later
    /// from another locus — a resolved promise, a bus reply),
    /// so whoever ends up owning the fd writes the entire
    /// response including the status line, via the raw-fd
    /// surface (`std::io::tcp::send_fd`). Also the shape for
    /// CONNECT tunnels negotiated elsewhere and server-initiated
    /// protocols. `status`/`headers`/`body` are ignored; the
    /// conn loop's 5s recv timeout is still armed on the fd
    /// (clear via `set_recv_timeout(fd, 0)`); a handler that
    /// sets this without stashing `req.conn_fd` leaks the fd.
    /// Takes precedence over `takeover` if both are set.
    takeover_raw: Bool = false;
    /// A streamed body (2026-10-17): the handler sent the head and
    /// the chunks itself, through a `std::http::BodyWriter` or
    /// `std::http::SseWriter` on `req.conn_fd`, and returned the
    /// writer's `end()`, which sets this. The Server then writes
    /// only the last chunk (`0\r\n\r\n`) and closes the connection;
    /// `status`/`content_type`/`headers`/`body` are not written
    /// again. Set by `end()`, never by hand.
    streamed: Bool = false;
}

// Map a numeric HTTP status to its reason phrase: the one table every
// status line the stdlib writes uses (`write_response`, the TCP
// substrate's takeover line in io_tcp_serve.hl, the api runtime's
// replies in api_rpc.hl and api_hub.hl). Every status RFC 9110 § 15
// defines, in its wording (413 is "Content Too Large", 422
// "Unprocessable Content"), and the others the IANA registry assigns
// (102, 103, 207, 208, 226, 423, 424, 425, 428, 429, 431, 451, 506, 507,
// 508, 510, 511). An unassigned status reads "Status": a reason phrase
// is advisory (RFC 9112 § 4), and a client reads the code. It held seven
// statuses until 2026-10-12 (downstream handoff: a 201 or 503 went out
// as "Status").
fn __status_phrase(status: Int) -> String {
    return match status {
        100 -> "Continue",
        101 -> "Switching Protocols",
        102 -> "Processing",
        103 -> "Early Hints",
        200 -> "OK",
        201 -> "Created",
        202 -> "Accepted",
        203 -> "Non-Authoritative Information",
        204 -> "No Content",
        205 -> "Reset Content",
        206 -> "Partial Content",
        207 -> "Multi-Status",
        208 -> "Already Reported",
        226 -> "IM Used",
        300 -> "Multiple Choices",
        301 -> "Moved Permanently",
        302 -> "Found",
        303 -> "See Other",
        304 -> "Not Modified",
        305 -> "Use Proxy",
        307 -> "Temporary Redirect",
        308 -> "Permanent Redirect",
        400 -> "Bad Request",
        401 -> "Unauthorized",
        402 -> "Payment Required",
        403 -> "Forbidden",
        404 -> "Not Found",
        405 -> "Method Not Allowed",
        406 -> "Not Acceptable",
        407 -> "Proxy Authentication Required",
        408 -> "Request Timeout",
        409 -> "Conflict",
        410 -> "Gone",
        411 -> "Length Required",
        412 -> "Precondition Failed",
        413 -> "Content Too Large",
        414 -> "URI Too Long",
        415 -> "Unsupported Media Type",
        416 -> "Range Not Satisfiable",
        417 -> "Expectation Failed",
        421 -> "Misdirected Request",
        422 -> "Unprocessable Content",
        423 -> "Locked",
        424 -> "Failed Dependency",
        425 -> "Too Early",
        426 -> "Upgrade Required",
        428 -> "Precondition Required",
        429 -> "Too Many Requests",
        431 -> "Request Header Fields Too Large",
        451 -> "Unavailable For Legal Reasons",
        500 -> "Internal Server Error",
        501 -> "Not Implemented",
        502 -> "Bad Gateway",
        503 -> "Service Unavailable",
        504 -> "Gateway Timeout",
        505 -> "HTTP Version Not Supported",
        506 -> "Variant Also Negotiates",
        507 -> "Insufficient Storage",
        508 -> "Loop Detected",
        510 -> "Not Extended",
        511 -> "Network Authentication Required",
        _ -> "Status",
    };
}

// m84 — parse one HTTP request from a raw buffer.
//
// Pulls the request line (`METHOD PATH HTTP/VER\r\n`) and
// the body (everything after `\r\n\r\n`). Headers between
// the request line and the blank line are skipped — they
// appear neither on the resulting Request nor on the wire
// for the response. Malformed inputs (no CRLF in request
// line, missing space, etc.) yield a Request with empty
// fields rather than erroring; callers that care should
// check `req.method == ""` and respond with 400.
//
// The caller is responsible for handing in a COMPLETE request:
// `__http_handle_one_conn` reassembles multi-segment requests
// (accumulate to `\r\n\r\n`, then to Content-Length bytes,
// 1 MiB cap) before parsing. This fn itself takes body =
// everything after the blank line and never re-reads.
fn __parse_http_request(raw: String) -> std::http::Request {
    // Locate end of request line.
    let line_end = std::str::index_of(raw, "\r\n");
    if line_end < 0 {
        return std::http::Request {
            method: "",
            path: "",
            version: "",
            headers: "",
            body: ""
        };
    }
    let request_line = raw[0..line_end];
    let raw_len = len(raw);

    // Headers + body: split at `\r\n\r\n`. Headers are the
    // raw lines between request-line end and that double-CRLF,
    // joined as they appear on the wire (no trailing CRLF).
    let header_end = std::str::index_of(raw, "\r\n\r\n");
    let mut headers = "";
    let mut body = "";
    if header_end >= 0 {
        let headers_start = line_end + 2;
        if headers_start < header_end {
            headers = raw[headers_start..header_end];
        }
        let body_start = header_end + 4;
        if body_start < raw_len {
            body = raw[body_start..raw_len];
        }
    }

    // Split request line on spaces: METHOD SP PATH SP VERSION.
    let sp1 = std::str::index_of(request_line, " ");
    if sp1 < 0 {
        return std::http::Request {
            method: "",
            path: "",
            version: "",
            headers: headers,
            body: body
        };
    }
    let line_len = len(request_line);
    let method = request_line[0..sp1];
    let after_method = request_line[(sp1 + 1)..line_len];

    let sp2 = std::str::index_of(after_method, " ");
    if sp2 < 0 {
        return std::http::Request {
            method: method,
            path: after_method,
            version: "",
            headers: headers,
            body: body
        };
    }
    let after_method_len = len(after_method);
    let path = after_method[0..sp2];
    let version = after_method[(sp2 + 1)..after_method_len];

    return std::http::Request {
        method: method,
        path: path,
        version: version,
        headers: headers,
        body: body
    };
}

// Header lookup over a CRLF-joined `name: value` block.
// Walks the block looking for a line whose prefix matches
// `name:` and returns the value with leading whitespace
// trimmed, or an empty String if no header matches. Lookup is
// case-insensitive per RFC 7230 §3.2 — both the needle and each
// scanned header name are lowercased via std::str::lower before
// comparison, so `Host` and `host` resolve identically. The
// block shape matches the wire-side `\r\n`-joined header lines
// produced by parse_request (no trailing CRLF) and the same
// shape consumers attach via `Response.headers`. Factored out
// of `__http_request_header` so the symmetric Response-side
// getter (C11) doesn't duplicate the walker logic.
fn __http_find_header_in_block(headers: String, name: String) -> String {
    let total = len(headers);
    if total <= 0 {
        return "";
    }
    let needle = std::str::lower(name) + ":";
    let needle_len = len(needle);
    let mut cursor = 0;
    while cursor < total {
        // Find end of current line; fall through to total on
        // the last unterminated entry (joined-by-CRLF block
        // has no trailing CRLF).
        let rel = std::str::index_of(headers[cursor..total], "\r\n");
        let line_end = if rel < 0 { total } else { cursor + rel };
        let line = headers[cursor..line_end];
        let line_len = len(line);
        if line_len >= needle_len {
            let head = std::str::lower(line[0..needle_len]);
            if head == needle {
                // Trim leading whitespace on the value side.
                let mut vstart = needle_len;
                while vstart < line_len {
                    let ch = line[vstart..(vstart + 1)];
                    if ch == " " {
                        vstart = vstart + 1;
                    } else {
                        return line[vstart..line_len];
                    }
                }
                return "";
            }
        }
        if rel < 0 {
            return "";
        }
        cursor = line_end + 2;
    }
    return "";
}

// Request-side header lookup. Walks `req.headers` via the shared
// block walker. Surfaced as `std::http::header(req, name)`.
fn __http_request_header(req: std::http::Request, name: String) -> String {
    return __http_find_header_in_block(req.headers, name);
}

// Response-side header lookup (C11, pond follow-up). Walks the
// user-attached `resp.headers` block — the same CRLF-joined
// shape as Request.headers. Surfaced as `std::http::header(resp,
// name)`; the codegen dispatch forks on the first argument's
// type so callers can use one path-call name regardless of
// whether the receiver is a Request or a Response.
fn __http_response_header(resp: std::http::Response, name: String) -> String {
    return __http_find_header_in_block(resp.headers, name);
}

// m85 — write a Response to a Stream as HTTP/1.1 wire bytes.
//
// Wire shape:
//   HTTP/1.1 <status> <phrase>\r\n
//   Content-Type: <content_type>\r\n
//   Content-Length: <byte length of body>\r\n
//   Connection: close\r\n
//   \r\n
//   <body>
//
// Each Stream.send call ships one chunk through the m72
// length-prefix-framed TCP substrate, but TCP is a stream —
// peers see the raw bytes concatenated, which is what HTTP
// expects. v0 sends headers + body separately to keep the
// String concat work bounded; for very large bodies a future
// milestone might stream chunks through the same Stream.
//
// `Connection: close` is hardcoded so the client knows the
// connection terminates after this response. Keep-alive
// would need a different request-handling loop in the
// callback (read another request after responding); that's
// deferred until persistent connections are actually
// useful — most curl/browser doc-fetches close after one
// request anyway.
fn __write_http_response(s: std::io::tcp::Stream, resp: std::http::Response) {
    let phrase = __status_phrase(resp.status);
    let body_len = len(resp.body);
    let status_line = "HTTP/1.1 " + to_string(resp.status) + " " + phrase + "\r\n";
    let ct_header = "Content-Type: " + resp.content_type + "\r\n";
    let cl_header = "Content-Length: " + to_string(body_len) + "\r\n";
    // C11 (pond follow-up): user-supplied headers go after the
    // fixed Content-Type / Content-Length / Connection lines but
    // before the blank-line separator. When `resp.headers` is
    // empty the wire bytes are byte-identical to the v0 shape:
    // the existing `Connection: close\r\n\r\n` block is split
    // into `Connection: close\r\n` + (optional user headers +
    // `\r\n`) + a final `\r\n` blank-line — so the empty-headers
    // path concatenates to the original four-line block exactly.
    let conn_line = "Connection: close\r\n";
    let extra_headers = if len(resp.headers) > 0 {
        resp.headers + "\r\n"
    } else {
        ""
    };
    let blank_line = "\r\n";
    let header = status_line + ct_header + cl_header + conn_line + extra_headers + blank_line;
    // #209: send is fallible(IoError) now. A response-write
    // failure means the peer is gone — nothing useful to do
    // per-connection, so discard (the conn closes at scope exit).
    s.send(header) or discard;
    s.send(resp.body) or discard;
}

// 2026-10-17 — a streamed response body: chunked transfer encoding
// (RFC 9112 § 7.1) on the Server's response path, and Server-Sent
// Events (the WHATWG `text/event-stream` format) as a writer over it.
//
// A handler opts in by building a writer on `req.conn_fd` inside
// `handle`. The writer's birth sends the head at once (the status
// line, Content-Type, `Transfer-Encoding: chunked`, `Connection:
// close`, the user's headers); each `chunk` / `event` is one chunk and
// one write(2), with no buffering in user space, so it is on the wire
// when the call returns; the handler returns the writer's `end()`.
// The Server sees `Response.streamed`, ends the body (the zero-length
// last chunk) and closes the connection, as it does after every
// response. A handler that builds no writer pays one Bool test per
// response, and its wire bytes are unchanged.
//
// Wire shape:
//   HTTP/1.1 <status> <phrase>\r\n
//   Content-Type: <content_type>\r\n
//   Transfer-Encoding: chunked\r\n
//   Connection: close\r\n
//   <headers>\r\n               (when non-empty)
//   \r\n
//   <hex size>\r\n<bytes>\r\n   (one per chunk / event)
//   0\r\n\r\n                   (written by the Server on return)

// `n` in lowercase hex, the chunk-size line's spelling. An Int is at
// most 16 hex digits, which bounds the loop.
fn __http_hex(n: Int) -> String {
    if n <= 0 {
        return "0";
    }
    let digits = "0123456789abcdef";
    let mut out = "";
    let mut v = n;
    let mut i = 0;
    while v > 0 && i < 16 {
        let d = v % 16;
        out = digits[d..(d + 1)] + out;
        v = v / 16;
        i = i + 1;
    }
    return out;
}

// The head of a streamed response: `write_response`'s fixed lines with
// `Transfer-Encoding: chunked` in place of Content-Length.
fn __http_stream_head(status: Int, content_type: String, headers: String) -> String {
    let status_line = "HTTP/1.1 " + to_string(status) + " " + __status_phrase(status) + "\r\n";
    let extra = if len(headers) > 0 {
        headers + "\r\n"
    } else {
        ""
    };
    return status_line + "Content-Type: " + content_type + "\r\n"
        + "Transfer-Encoding: chunked\r\n" + "Connection: close\r\n" + extra + "\r\n";
}

// One chunk's framing around `data`: its size in hex, CRLF, the bytes,
// CRLF.
fn __http_chunk_frame(data: String) -> String {
    return __http_hex(len(data)) + "\r\n" + data + "\r\n";
}

/// A streamed response body in chunked transfer encoding, built in a
/// handler on `req.conn_fd`. Birth sends the head (`status`,
/// `content_type`, the CRLF-joined `headers`, `Transfer-Encoding:
/// chunked`, `Connection: close`); `chunk(data)` sends one chunk in one
/// write; the handler returns `end()`, and the Server ends the body and
/// closes the connection. It never closes the fd: the Server owns it.
locus __StdHttpBodyWriter {
    params {
        conn_fd: Int = -1;
        status: Int = 200;
        content_type: String = "application/octet-stream";
        headers: String = "";
        // a borrow of the Server's connection: the Server closes it
        s: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: self.conn_fd, owns_fd: false };
    }
    birth() {
        // a head that cannot be sent (the client is gone) fails the first
        // chunk the same way
        self.s.send(__http_stream_head(self.status, self.content_type, self.headers)) or discard;
    }
    /// Send `data` as one chunk, on the wire when the call returns. An
    /// empty `data` sends nothing (a zero-length chunk ends a body). A
    /// failure is the client gone: stop, and return `end()`.
    fn chunk(data: String) -> () fallible(IoError) {
        if len(data) == 0 {
            return;
        }
        self.s.send(__http_chunk_frame(data)) or raise;
    }
    /// The Response a streaming handler returns: the Server writes the
    /// last chunk and closes the connection.
    fn end() -> std::http::Response {
        return std::http::Response {
            status: self.status,
            content_type: self.content_type,
            body: "",
            streamed: true
        };
    }
}

/// One Server-Sent Event. `data` is the payload (one `data:` line per
/// line of it); `event` its type (the client's `message` when empty);
/// `id` the client's last-event id; `retry` the client's reconnection
/// delay, written in whole milliseconds (`0ns`: not sent). A line break
/// in `event` or `id` is dropped.
type __StdHttpSseEvent {
    data: String;
    event: String = "";
    id: String = "";
    retry: Duration = 0ns;
}

// A field value that must stay on one line.
fn __http_sse_one_line(v: String) -> String {
    return std::str::replace(std::str::replace(v, "\r", ""), "\n", "");
}

// One event in the text/event-stream format: its fields, a `data:` line
// per line of the payload (CRLF, CR and LF each end a line there), and
// the blank line that dispatches it.
fn __http_sse_frame(e: std::http::SseEvent) -> String {
    let mut out = "";
    if len(e.event) > 0 {
        out = out + "event: " + __http_sse_one_line(e.event) + "\n";
    }
    if len(e.id) > 0 {
        out = out + "id: " + __http_sse_one_line(e.id) + "\n";
    }
    let retry_ms = e.retry / 1ms;
    if retry_ms > 0 {
        out = out + "retry: " + to_string(retry_ms) + "\n";
    }
    let data = std::str::replace(std::str::replace(e.data, "\r\n", "\n"), "\r", "\n");
    return out + "data: " + std::str::replace(data, "\n", "\ndata: ") + "\n\n";
}

// An event stream's headers: no caching of the stream, then the user's.
fn __http_sse_headers(headers: String) -> String {
    if len(headers) > 0 {
        return "Cache-Control: no-cache\r\n" + headers;
    }
    return "Cache-Control: no-cache";
}

/// A Server-Sent Events stream (`text/event-stream`) over a
/// `BodyWriter`, built in a handler on `req.conn_fd`. Birth sends the
/// head (`Cache-Control: no-cache`, then the CRLF-joined `headers`);
/// `event(e)` sends one event as one chunk in one write; the handler
/// returns `end()`.
locus __StdHttpSseWriter {
    params {
        conn_fd: Int = -1;
        status: Int = 200;
        headers: String = "";
        body: std::http::BodyWriter = std::http::BodyWriter {
            conn_fd: self.conn_fd,
            status: self.status,
            content_type: "text/event-stream",
            headers: __http_sse_headers(self.headers)
        };
    }
    /// Send `e`, on the wire when the call returns. A failure is the
    /// client gone: stop, and return `end()`.
    fn event(e: std::http::SseEvent) -> () fallible(IoError) {
        self.body.chunk(__http_sse_frame(e)) or raise;
    }
    /// The Response a streaming handler returns.
    fn end() -> std::http::Response {
        return self.body.end();
    }
}

// 2026-05-16 — std::http::Handler interface. The contract a
// Server's `handler` field is typed against. Any locus whose
// method set covers `fn handle(req: Request) -> Response`
// satisfies the interface structurally (F.20) — no `impl I
// for L` ceremony. State lives on the handler-locus's params;
// the Server's accept loop dispatches each request to
// `handler.handle(req)` through a fat-pointer vtable.
//
// This replaces the v0 `handler: fn(Request) -> Response`
// shape, which had no place to put per-request state because
// Hale has no closures. Stateful HTTP (URL shortener, todo
// list, session store) lands naturally now.
/// The Server's dispatch contract: any locus with
/// `fn handle(req: Request) -> Response` satisfies it
/// structurally — Router, metrics Endpoint, or your own locus.
interface __StdHttpHandler {
    fn handle(req: std::http::Request) -> std::http::Response;
}

// 2026-05-16 — std::http::Server. Bundles the recv +
// parse_request + dispatch + write_response loop every HTTP
// program had to hand-roll on top of Listener. The agent
// supplies a handler-locus whose state lives in its params
// and whose `fn handle(req: Request) -> Response` method
// dispatches each request; the Server locus owns the accept
// loop and the per-connection scope.
//
// Usage:
//   locus Routes {
//       params {
//           hits: Int = 0;
//       }
//       fn handle(req: std::http::Request) -> std::http::Response {
//           self.hits = self.hits + 1;
//           if req.path == "/health" {
//               return std::http::Response { status: 200, body: "ok" };
//           }
//           return std::http::Response { status: 404, body: "not found" };
//       }
//   }
//   fn main() {
//       std::http::Server { port: 8080, handler: Routes { } };
//   }
//
// Routes live inside the user-supplied handler's `handle`
// body — Hale doesn't have a separate route-table primitive
// and a string-keyed switch ladder inside one handler is
// sized for the small route counts most apps actually have.
// The Server locus covers the lifecycle (bind, accept loop,
// per-connection Stream dissolution) and the wire protocol;
// the handler-locus owns routing + state.

// `std::http::Server` itself — the listener and the connections it
// serves, on the TCP connection substrate — is in io_tcp_serve.hl, which
// joins a program that names it (`hale_stdlib::TCP_SERVE_SOURCE`).

// =====================================================================
// std::http::Router — path routing + middleware (promoted from
// pond/router, 2026-07-17).
// =====================================================================
//
// The routing battery the Server was missing: register
// `METHOD /path/:capture` patterns against handler loci, get
// path/query params extracted, and wrap the chain in
// before/after middleware. The Router satisfies
// `std::http::Handler` structurally, so it plugs straight into
// the Server:
//
//   locus Hello {
//       fn handle(ctx: std::http::Context) -> std::http::Response {
//           let who = std::http::path_param(ctx.params, "name");
//           return std::http::Response { status: 200, body: "hi " + who };
//       }
//   }
//   fn main() {
//       let r = std::http::Router { };
//       r.add("GET", "/hello/:name", Hello { });
//       std::http::Server { port: 8080, handler: r };
//   }
//
// Two handler contracts exist on purpose:
//   - `std::http::Handler`      — `handle(req: Request) -> Response`;
//     the Server's contract. One locus owns everything.
//   - `std::http::RouteHandler` — `handle(ctx: Context) -> Response`;
//     the Router's contract. The Context adds extracted params.
// The Router is the bridge: it IS a Handler, and it dispatches
// to RouteHandlers.
//
// Promotion notes vs the pond original: handlers return
// `std::http::Response` directly (pond's local Response type +
// boundary conversion existed only because vendored libs can't
// alias stdlib types); the storage loci are declared before the
// Router in this file, retiring pond's lists.hl name-ordering
// workaround. `path_param` / `query_param` percent-decode the value
// they hand back (`std::url`, 2026-10-12).

// Per-request capture state. `qs` is the raw query string with
// the leading `?` stripped ("a=1&b=2") — kept raw because most
// requests never read it. Path captures live in the bounded
// parallel pair; capacity 8 bounds the number of `:name`
// segments in a route pattern (a developer-authored constant —
// exceeding it is a programming error, surfaced loudly by the
// matcher's `or raise`).
/// Captures + query params for one routed request; read via
/// `path_param` / `query_param`.
type __StdHttpRouteParams {
    qs: String = "";
    path_keys: bounded[String; 8];
    path_vals: bounded[String; 8];
}

// The per-request bundle a RouteHandler receives: the parsed
// Request nested under `req`, the matcher's captures under
// `params`. Note `ctx.req.path` is the RAW request target
// including any query string; the Router matches against the
// query-stripped path and `ctx.params.qs` carries the query
// half.
/// What a RouteHandler receives: the parsed Request (`ctx.req`)
/// plus its RouteParams (`ctx.params`).
type __StdHttpContext {
    req: std::http::Request;
    params: std::http::RouteParams;
}

// Route-table handler contract. Structural (F.20): any locus
// with a matching `handle` satisfies it.
/// A Router target: `fn handle(ctx: Context) -> Response`.
interface __StdHttpRouteHandler {
    fn handle(ctx: std::http::Context) -> std::http::Response;
}

// Middleware contract — onion order: every `before` runs
// forward over the Context, the matched handler runs, every
// `after` runs backward over the Response.
/// Router middleware, onion-ordered: `before(ctx)` runs forward
/// on the way in, `after(ctx, resp)` backward on the way out.
interface __StdHttpMiddleware {
    fn before(ctx: std::http::Context) -> std::http::Context;
    fn after(ctx: std::http::Context, resp: std::http::Response) -> std::http::Response;
}

// Sentinel for entries registered through `add` (locus handler):
// stored in the fn slot, never called — `is_fn` gates the branch.
fn __http_fn_unset(ctx: std::http::Context) -> std::http::Response {
    return std::http::Response { status: 500, body: "unset fn route" };
}

// One registered route. `method` stored uppercased; `pattern`
// as-written; `handler` is the F.20 fat-pointer interface value
// coerced from the concrete locus at the literal-init site. A
// route registered with `add_fn` stores a bare fn pointer in
// `handler_fn` instead (`is_fn` discriminates) — a fn needs no
// storage locus, so there is nothing whose lifetime could dangle
// (an adapter locus instantiated inside the register method
// would dissolve at method exit, out from under the entry). The
// unused slot holds the sentinel / the router's own not_found.
/// One registered route (internal storage shape for Router).
type __StdHttpRouteEntry {
    method: String;
    pattern: String;
    handler: std::http::RouteHandler;
    handler_fn: fn (std::http::Context) -> std::http::Response;
    is_fn: Bool;
}

// Route + middleware storage ("one form per locus" — each vec
// is its own child locus, held as Router params).
@form(vec)
locus __StdHttpEntryList {
    capacity { heap items of __StdHttpRouteEntry; }
}

@form(vec)
locus __StdHttpMwList {
    capacity { heap items of __StdHttpMiddleware; }
}

// ---- path / query helpers -------------------------------------------

// `std::http::path_param(ctx.params, "name")` — the value a
// `:name` pattern segment captured, percent-decoded, or "" when
// absent. Matching ran on the raw segment; only the value handed back
// is decoded, with `std::url::decode` (a `+` in a path is a plus).
/// A `:name` capture's value for this request, percent-decoded
/// (`%20` is a space, `+` stays `+`), or "" when the pattern had no
/// such capture.
fn __http_path_param(p: std::http::RouteParams, name: String) -> String {
    let n = count(p.path_keys);
    let mut i = 0;
    while i < n {
        let k = at(p.path_keys, i) or "";
        if k == name {
            return __std_url_decode(at(p.path_vals, i) or "");
        }
        i = i + 1;
    }
    return "";
}

// `std::http::query_param(ctx.params, "q")` — the value of the
// first `k=v` pair whose key is `name`, or "" when absent. Walks
// pair-by-pair so an early hit skips the rest; comparisons are
// case-sensitive. Both sides of a pair are decoded with
// `std::url::decode_query` (`%XX`, and `+` as a space) before the key
// is compared, so `?first%20name=a+b` answers `query_param(p,
// "first name")` with "a b". A pair with no `=` is a key with the
// empty value.
/// The value of the first `k=v` query pair whose key is `name`,
/// percent-decoded with `+` as a space, or "" when absent.
fn __http_query_param(p: std::http::RouteParams, name: String) -> String {
    let qs = p.qs;
    let total = len(qs);
    if total == 0 {
        return "";
    }
    let mut cursor = 0;
    while cursor <= total {
        let amp = std::str::index_of_from(qs, "&", cursor);
        let pair_end = if amp < 0 { total } else { amp };
        let eq = std::str::index_of_from(qs, "=", cursor);
        let key_end = if eq < 0 || eq > pair_end { pair_end } else { eq };
        if __std_url_decode_query(qs[cursor..key_end]) == name {
            if key_end >= pair_end {
                return "";
            }
            return __std_url_decode_query(qs[key_end + 1..pair_end]);
        }
        if amp < 0 {
            return "";
        }
        cursor = pair_end + 1;
    }
    return "";
}

// Path component of a request target (before any `?`).
fn __http_path_only(target: String) -> String {
    let n = len(target);
    if n == 0 {
        return "";
    }
    let q = std::str::index_of(target, "?");
    if q < 0 {
        return target;
    }
    return target[0..q];
}

// Query component of a request target (after the `?`, which is
// stripped). "" when absent.
fn __http_query_only(target: String) -> String {
    let n = len(target);
    if n == 0 {
        return "";
    }
    let q = std::str::index_of(target, "?");
    if q < 0 {
        return "";
    }
    let start = q + 1;
    if start >= n {
        return "";
    }
    return target[start..n];
}

// Count `/`-separated non-empty segments ("/users/42" and
// "/users/42/" both count 2).
fn __http_seg_count(p: String) -> Int {
    let n = len(p);
    if n == 0 {
        return 0;
    }
    let mut count = 0;
    let mut i = 0;
    let mut in_seg = false;
    while i < n {
        let ch = p[i..(i + 1)];
        if ch == "/" {
            if in_seg {
                count = count + 1;
                in_seg = false;
            }
        } else {
            in_seg = true;
        }
        i = i + 1;
    }
    if in_seg {
        count = count + 1;
    }
    return count;
}

// The idx-th non-empty segment (0-based), or "" out of range.
fn __http_seg_at(p: String, idx: Int) -> String {
    let n = len(p);
    if n == 0 {
        return "";
    }
    let mut seen = 0;
    let mut i = 0;
    let mut start = -1;
    while i < n {
        let ch = p[i..(i + 1)];
        if ch == "/" {
            if start >= 0 {
                if seen == idx {
                    return p[start..i];
                }
                seen = seen + 1;
                start = -1;
            }
        } else {
            if start < 0 {
                start = i;
            }
        }
        i = i + 1;
    }
    if start >= 0 {
        if seen == idx {
            return p[start..n];
        }
    }
    return "";
}

// Bind `path` against `pattern`, pushing `:name` captures into
// the RouteParams' bounded pair. True on match; a false return
// leaves the captures cleared so the dispatch loop can retry
// the next pattern with the same RouteParams. Bool-not-fallible
// because match failure is the COMMON path. Trailing-slash
// tolerant on both sides; no implicit wildcard suffix.
fn __http_match_pattern_into(pattern: String, path: String, p: std::http::RouteParams) -> Bool {
    // Literal-head prefilter, BEFORE the segment counts: those
    // scan both strings end to end, and on a route table nearly
    // every candidate is rejected, so paying two full scans to
    // discover it is the wrong order. Every segment before the pattern's
    // first `:` is literal, so a successful match REQUIRES that
    // text to prefix the path — one memcmp instead of the
    // segment walk below, which re-scans and allocates a
    // substring twice per segment.
    //
    // Sound because it only rejects where the walk would: it is
    // implied by the per-segment equality the walk enforces. It
    // never accepts anything extra — a pass still falls through
    // to the full walk.
    //
    // This is the hot path for a route TABLE, where nearly every
    // candidate differs in its first segment and pays the whole
    // walk to discover it (measured ~385ns/route before this).
    let colon = std::str::index_of(pattern, ":");
    let raw_head = if colon < 0 { pattern } else { std::str::substring(pattern, 0, colon) };
    // Drop a trailing `/` before testing. Matching is
    // trailing-slash tolerant ON BOTH SIDES, so pattern `/users/`
    // must still match path `/users` — testing the slash as part
    // of the prefix rejected exactly that pair. Dropping it makes
    // the filter weaker and still sound; the walk decides.
    let hl = len(raw_head);
    let head = if hl > 0 && raw_head[hl - 1..hl] == "/" {
        std::str::substring(raw_head, 0, hl - 1)
    } else {
        raw_head
    };
    if len(head) > 0 && !std::str::starts_with(path, head) {
        return false;
    }
    let pn = __http_seg_count(pattern);
    let rn = __http_seg_count(path);
    if pn != rn {
        return false;
    }
    clear(p.path_keys);
    clear(p.path_vals);
    let mut i = 0;
    while i < pn {
        let ps = __http_seg_at(pattern, i);
        let rs = __http_seg_at(path, i);
        let psl = len(ps);
        if psl > 0 && ps[0..1] == ":" {
            push(p.path_keys, ps[1..psl]) or raise;
            push(p.path_vals, rs) or raise;
        } else {
            if ps != rs {
                clear(p.path_keys);
                clear(p.path_vals);
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

// ---- direct dispatch (build_context / is_route) ----------------------

// `std::http::build_context(req)` — the Context a Router would build
// for this request: query string split off the raw target into
// `params.qs`, captures empty. The entry point for the
// self-dispatching handler shape (a locus whose `handle` walks
// `is_route` checks — no Router, no per-endpoint handler loci).
/// Build the per-request Context from a Request; `params.qs`
/// carries the query half of the raw target.
fn __http_build_context(req: std::http::Request) -> std::http::Context {
    return std::http::Context {
        req: req,
        params: std::http::RouteParams {
            qs: __http_query_only(req.path)
        }
    };
}

// `std::http::is_route(ctx, "GET", "/users/:id")` — true when
// the request matches method + pattern, with `:name` captures
// filled into `ctx.params` (read via `path_param`). ANY false
// return leaves the captures cleared, so checks chain as an
// if-ladder with first-match-wins order:
//
//     fn handle(req: std::http::Request) -> std::http::Response {
//         let ctx = std::http::build_context(req);
//         if std::http::is_route(ctx, "GET", "/users/:id") {
//             return self.show(ctx);
//         }
//         return std::http::Response { status: 404, body: "no" };
//     }
//
// Method compare is case-insensitive on the argument side, like
// `Router.add` (the wire method is uppercase per RFC 9110);
// matching is the Router's own: query-stripped path,
// trailing-slash tolerant, no implicit wildcard suffix.
/// True when `ctx.req` matches method + pattern; `:name`
/// captures land in `ctx.params` (any miss leaves them cleared).
fn __http_is_route(
    ctx: std::http::Context,
    method: String,
    pattern: String
) -> Bool {
    if std::str::upper(method) != ctx.req.method {
        clear(ctx.params.path_keys);
        clear(ctx.params.path_vals);
        return false;
    }
    return __http_match_pattern_into(
        pattern, __http_path_only(ctx.req.path), ctx.params
    );
}

// ---- the Router ------------------------------------------------------

// Default 404. Consumer-overridable via `Router { not_found: ... }`.
/// The Router's default 404 handler; override via the
/// `not_found` param.
locus __StdHttpNotFound404 {
    fn handle(ctx: std::http::Context) -> std::http::Response {
        return std::http::Response {
            status: 404,
            content_type: "text/plain",
            body: "not found"
        };
    }
}

// Middleware-route-middleware chain. Free fn (not a Router
// method) because it is naturally return-bearing. First match
// wins — register more-specific patterns first.
fn __http_run_chain(
    entries: __StdHttpEntryList,
    mws: __StdHttpMwList,
    ctx: std::http::Context,
    not_found: std::http::RouteHandler
) -> std::http::Response {
    let mut cur = ctx;
    let mlen = mws.len();
    let mut i = 0;
    while i < mlen {
        let m = mws.get(i) or raise;
        cur = m.before(cur);
        i = i + 1;
    }

    let path_only = __http_path_only(cur.req.path);
    let mut resp = not_found.handle(cur);
    let rlen = entries.len();
    let mut j = 0;
    while j < rlen {
        let e = entries.get(j) or raise;
        if e.method == cur.req.method {
            if __http_match_pattern_into(e.pattern, path_only, cur.params) {
                if e.is_fn {
                    // Hoisted under a __-prefixed name: the stdlib
                    // merges with user code, and a bare `f(cur)`
                    // would resolve a user's top-level `fn f` over
                    // the local fn-pointer.
                    let __route_fn = e.handler_fn;
                    resp = __route_fn(cur);
                } else {
                    resp = e.handler.handle(cur);
                }
                break;
            }
        }
        j = j + 1;
    }

    let mut k = mlen - 1;
    while k >= 0 {
        let m = mws.get(k) or raise;
        resp = m.after(cur, resp);
        k = k - 1;
    }
    return resp;
}

// `std::http::Router` — register routes with `add`, middleware
// with `use`, hand the Router to a Server as its handler.
/// Method + pattern dispatch that IS a `std::http::Handler`:
/// `add("GET", "/hello/:name", handler)` registers (first match
/// wins, register specific-before-general), `use(mw)` stacks
/// middleware, `dispatch(req)` runs the chain. Mount directly:
/// `Server { handler: router }`. Patterns cap at 8 captures;
/// trailing-slash tolerant.
locus __StdHttpRouter {
    params {
        not_found: std::http::RouteHandler = __StdHttpNotFound404 { };
        entries: __StdHttpEntryList = __StdHttpEntryList { };
        mws: __StdHttpMwList = __StdHttpMwList { };
    }

    // Register a route. Method matching is case-insensitive at
    // the register site (stored uppercased); pattern segments
    // are literal or `:name` captures.
    fn add(method: String, pattern: String, h: std::http::RouteHandler) {
        self.entries.push(__StdHttpRouteEntry {
            method: std::str::upper(method),
            pattern: pattern,
            handler: h,
            handler_fn: __http_fn_unset,
            is_fn: false
        });
    }

    // Register a bare fn as a route — no handler locus needed:
    // `router.add_fn("GET", "/hello/:name", greet)` where
    // `fn greet(ctx: std::http::Context) -> std::http::Response`.
    // Same matching and precedence as `add` (one list, first
    // match wins in registration order). The interface slot is
    // filled with the router's own `not_found` instance purely as
    // ballast — `is_fn` routes dispatch through the fn pointer.
    fn add_fn(
        method: String,
        pattern: String,
        f: fn (std::http::Context) -> std::http::Response
    ) {
        self.entries.push(__StdHttpRouteEntry {
            method: std::str::upper(method),
            pattern: pattern,
            handler: self.not_found,
            handler_fn: f,
            is_fn: true
        });
    }

    // Register a middleware (onion order).
    fn use(m: std::http::Middleware) {
        self.mws.push(m);
    }

    // Route lookup entry point: builds the Context (query split
    // off the raw target), runs the chain.
    fn dispatch(req: std::http::Request) -> std::http::Response {
        let ctx = std::http::Context {
            req: req,
            params: std::http::RouteParams {
                qs: __http_query_only(req.path)
            }
        };
        return __http_run_chain(
            self.entries, self.mws, ctx, self.not_found
        );
    }

    // `std::http::Handler` satisfaction — lets
    // `Server { handler: router }` dispatch through the vtable.
    fn handle(req: std::http::Request) -> std::http::Response {
        return self.dispatch(req);
    }
}
