// dna/core/review.hl — judgment with provenance, and autonomy as a
// boundary grant (#521 "Review", "Autonomy is a boundary grant").
//
// A Review is a locus, not a Boolean: it owns the exact question, the
// candidate's digest at decision time, the authority required, and
// the verdicts it received with their provenance. It settles only when
// a verdict (a) names the exact candidate digest under review, (b)
// comes from a reviewer whose claimed authority satisfies the
// requirement, and (c) is independent of the authoring Attempt. A
// capable performer with the wrong authority does not settle it.
//
// The AutonomyBoundary is owned by the PARENT for one child
// relationship. It computes the disposition from the grant, the
// magnitude vector and the evidence (pure fn `dispose` in types.hl),
// contracts on failure, and never expands on the child's say-so.

// ---- authority -----------------------------------------------------
//
// GH #566 F2: authorities are ranked, board over leader over
// supervisor over reviewer, and a claimed authority satisfies a
// requirement of its rank or below. `maintainer` is the board's older
// name and ranks with it. An unknown name satisfies only itself.
fn authority_rank(name: String) -> Int {
    if name == "board" || name == "maintainer" { return 4; }
    if name == "leader" { return 3; }
    if name == "supervisor" { return 2; }
    if name == "reviewer" { return 1; }
    return 0;
}

fn authority_satisfies(claimed: String, required: String) -> Bool {
    if claimed == required { return true; }
    let c = authority_rank(claimed);
    let r = authority_rank(required);
    // An unknown name satisfies ONLY itself, which the equality above
    // already decided. This was a substring test, so `not-board`
    // satisfied `board` and `operator-intern` satisfied `operator`
    // (the shakeout's finding 3).
    if c == 0 || r == 0 { return false; }
    return c >= r;
}

// ---- Review -------------------------------------------------------

@form(vec)
locus VerdictRows {
    capacity { heap rows of Verdict; }
}

// A concrete, assembly-owned forwarding child keeps the Journal handle alive
// for spawned Reviews without forwarding an interface through a constructor.
locus ReviewJournal {
    params { inner: Journal = MemJournal { }; }
    fn bind(j: Journal) { self.inner = j; }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn read(i: Int) -> Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> AppendResult { return self.inner.append(expected, kind, entity, body); }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> AppendResult { return self.inner.append_exact(expected, kind, entity, body); }
}

// Command outcomes are separate from Review settlement: an admitted abstention
// has an outcome of its own, and a refusal cannot borrow another caller's approval.
fn review_command_body(v: Verdict, accepted: Bool, refusal: String, settled: Bool, outcome: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("command_id", v.command_id);
    b.string_field("review_id", v.review_id);
    b.string_field("subject_digest", v.subject_digest);
    b.string_field("verdict", v.verdict);
    b.string_field("reviewer", v.reviewer);
    b.string_field("authority", v.authority);
    b.bool_field("accepted", accepted);
    b.string_field("refusal", refusal);
    b.bool_field("settled", settled);
    b.string_field("outcome", outcome);
    b.string_field("comment", v.comment);
    b.end_object();
    return b.result();
}

fn review_command_verdict(command_id: String, body: String) -> Verdict {
    return Verdict {
        command_id: command_id,
        review_id: native_json_string(body, "review_id"),
        subject_digest: native_json_string(body, "subject_digest"),
        verdict: native_json_string(body, "verdict"),
        reviewer: native_json_string(body, "reviewer"),
        authority: native_json_string(body, "authority"),
        comment: native_json_string(body, "comment")
    };
}

fn review_command_matches(body: String, v: Verdict) -> Bool {
    let old = review_command_verdict(v.command_id, body);
    return native_json_string(body, "command_id") == v.command_id
        && old.review_id == v.review_id && old.subject_digest == v.subject_digest
        && old.verdict == v.verdict && old.reviewer == v.reviewer
        && old.authority == v.authority && old.comment == v.comment;
}

@unbounded
fn review_command_decision(j: Journal, command_id: String) -> String {
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if e.kind == "review.command_decided" && e.entity == command_id { return e.body; }
        i = i + 1;
    }
    return "";
}

locus Review {
    params {
        journal: Journal = MemJournal { };
        organization_source_request: OrganizationSourceRequest = OrganizationSourceRequest { };
        organization_source_facts: OrganizationSourceFacts = NoOrganizationSourceFacts { };
        review_id: String = "";
        question: String = "";
        subject_digest: String = ""; // the candidate, pinned
        required_authority: String = ""; // e.g. "maintainer", "operator"
        author: String = ""; // the Attempt/performer that authored the candidate
        // GH #664: owners that must each approve, `<owner>=<member>,<member> …`;
        // "" means one admitted verdict decides
        approvers: String = "";
        approved_owners: String = ""; // owners whose approval is in, space-separated
        blocking: Bool = true;
        verdicts: VerdictRows = VerdictRows { };
        settled: Bool = false;
        outcome: String = ""; // "approve" | "revise" | "reject" | ""
        decided_by: String = "";
        comment: String = ""; // the deciding verdict's comment
        refused: Int = 0; // verdicts refused (wrong digest / authority / independence)
        last_refusal: String = "";
        command_verdicts: VerdictRows = VerdictRows { };
    }
    birth() { self.restore_command_decisions(); }
    contract {
        expose review_id: String;
        expose settled: Bool;
        expose outcome: String;
        expose decided_by: String;
        expose refused: Int;
        expose last_refusal: String;
    }
    // GH #527 B6: a verdict crossing the membrane (a human in Iris,
    // `hale dna review`) arrives on the typed channel, keyed to THIS
    // review, and goes through the same admission as a local one.
    // Nothing about authority or the TOCTOU pin is relaxed for a
    // remote verdict — the reviewer's claimed authority is checked
    // here, by the owning locus, never by the transport. (F.12, fixed:
    // the receive side of a binding derives the key, so the keyed
    // idiom means the same thing on both sides of a socket.)
    bus {
        subscribe ReviewVerdict as on_verdict where key == self.review_id;
        publish ReviewSettled;
    }
    @unbounded
    fn on_verdict(v: Verdict) {
        if len(v.command_id) > 0 {
            let decision = self.command_decide(v);
            if len(decision) == 0 { return; }
            ReviewSettled <- ReviewSettlement {
                command_id: v.command_id, review_id: self.review_id,
                outcome: native_json_string(decision, "outcome"),
                decided_by: native_json_string(decision, "reviewer"),
                refusal: native_json_string(decision, "refusal"),
                comment: native_json_string(decision, "comment")
            };
            return;
        }
        if self.settled {
            // A verdict at a settled Review. The verdict is spent — but
            // an approved candidate that never applied can be applied
            // by approving AGAIN, and that approval is admitted here, by
            // the owning locus, under every rule a first one meets: the
            // pinned digest, the required authority, independence from
            // the author, and the word `approve` itself. A rejection,
            // a wrong digest, a weak authority or the author's own
            // verdict is refused; the fourth review round showed each
            // of them applying the candidate when a generic refusal
            // stood in for this admission.
            if self.readmit(v) {
                ReviewSettled <- ReviewSettlement { review_id: self.review_id, outcome: self.outcome, decided_by: v.reviewer, comment: v.comment, reapproval: true };
            } else {
                ReviewSettled <- ReviewSettlement { review_id: self.review_id, refusal: self.last_refusal };
            }
            return;
        }
        let admitted = self.consider(v);
        if admitted && self.settled {
            ReviewSettled <- ReviewSettlement { review_id: self.review_id, outcome: self.outcome, decided_by: self.decided_by, comment: self.comment };
        }
        if !admitted {
            ReviewSettled <- ReviewSettlement { review_id: self.review_id, refusal: self.last_refusal };
        }
    }
    // Rebuild only persisted command decisions. A decision survives even if
    // the process stopped before the assembly wrote Review/knowledge facts.
    @unbounded
    fn restore_command_decisions() {
        let mut i = 0;
        while i < self.journal.revision() {
            let e = self.journal.read(i);
            if e.kind == "review.command_decided" && native_json_string(e.body, "review_id") == self.review_id {
                let v = review_command_verdict(e.entity, e.body);
                let mut seen = false;
                let mut k = 0;
                while k < self.command_verdicts.len() {
                    let prior = self.command_verdicts.get(k) or Verdict { };
                    if prior.command_id == e.entity { seen = true; }
                    k = k + 1;
                }
                if !seen {
                    self.command_verdicts.push(v);
                    if std::json::find_bool_field(e.body, "accepted") && v.subject_digest == self.subject_digest && self.source_verdict_admitted(v, e.seq) {
                        self.verdicts.push(v);
                        if v.verdict == "approve" && len(self.approvers) > 0 {
                            self.approved_owners = word_add(self.approved_owners, approver_owner(self.approvers, v.reviewer));
                        }
                        if std::json::find_bool_field(e.body, "settled") {
                            self.settled = true;
                            self.outcome = native_json_string(e.body, "outcome");
                            self.decided_by = v.reviewer;
                            self.comment = v.comment;
                        }
                    } else {
                        self.refused = self.refused + 1;
                        self.last_refusal = native_json_string(e.body, "refusal");
                    }
                }
            }
            i = i + 1;
        }
    }
    fn source_verdict_admitted(v: Verdict, before: Int) -> Bool {
        if len(self.organization_source_request.request_id) == 0 { return true; }
        let codec = OrganizationSourceRequestCodec { };
        return codec.verdict_admitted(self.journal, self.organization_source_facts, self.organization_source_request, v, before);
    }
    @unbounded
    fn command_refusal(v: Verdict) -> String {
        if !self.source_verdict_admitted(v, self.journal.revision()) { return "prepared source requires its exact authorized command profile"; }
        if self.settled { return "already settled: " + self.outcome; }
        let mut i = 0;
        while i < self.journal.revision() {
            let e = self.journal.read(i);
            if e.kind == "review.settled" && e.entity == self.review_id { return "already settled: " + e.body; }
            i = i + 1;
        }
        if v.subject_digest != self.subject_digest { return "digest mismatch: " + v.subject_digest + " != " + self.subject_digest; }
        if !authority_satisfies(v.authority, self.required_authority) { return "authority " + v.authority + " does not satisfy " + self.required_authority; }
        if v.reviewer == self.author { return "reviewer " + v.reviewer + " authored the candidate"; }
        if v.verdict != "approve" && v.verdict != "reject" && v.verdict != "revise" && v.verdict != "abstain" { return "unknown verdict: " + v.verdict; }
        if len(self.approvers) > 0 && len(approver_owner(self.approvers, v.reviewer)) == 0 { return "reviewer " + v.reviewer + " is a member of no owner this change affects (" + approver_owners(self.approvers) + ")"; }
        return "";
    }
    @unbounded
    fn command_settles(v: Verdict) -> Bool {
        if v.verdict == "abstain" { return false; }
        if v.verdict != "approve" || len(self.approvers) == 0 { return true; }
        let owners = word_add(self.approved_owners, approver_owner(self.approvers, v.reviewer));
        let mut i = 0;
        while len(nth_word(approver_owners(self.approvers), i)) > 0 {
            if !word_in(nth_word(approver_owners(self.approvers), i), owners) { return false; }
            i = i + 1;
        }
        return true;
    }
    // The exact append is the decision. No live state changes before it. On
    // an ambiguous error, re-read the same identity before reporting nothing;
    // redelivery can then recover the original acceptance instead of refusing
    // it merely because an in-memory Review had advanced ahead of its Record.
    @unbounded
    fn command_decide(v: Verdict) -> String {
        if len(v.command_id) == 0 || v.review_id != self.review_id { return ""; }
        let mut tries = 0;
        while tries < 20 {
            let moved = self.journal.refresh();
            let revision = self.journal.revision();
            let existing = review_command_decision(self.journal, v.command_id);
            if len(existing) > 0 {
                if !review_command_matches(existing, v) { return ""; }
                let codec = OrganizationSourceRequestCodec { }; let decided = codec.fact(self.journal, "review.command_decided", v.command_id);
                if std::json::find_bool_field(existing, "accepted") && !self.source_verdict_admitted(v, decided.seq) { return ""; }
                self.restore_command_decisions();
                return existing;
            }
            self.restore_command_decisions();
            let refusal = self.command_refusal(v);
            let accepted = len(refusal) == 0;
            let settled = accepted && self.command_settles(v);
            let decision = review_command_body(v, accepted, refusal, settled, if settled { v.verdict } else { "" });
            let appended = self.journal.append_exact(revision, "review.command_decided", v.command_id, decision);
            if appended.ok {
                self.restore_command_decisions();
                return decision;
            }
            let refreshed = self.journal.refresh();
            let recovered = review_command_decision(self.journal, v.command_id);
            if len(recovered) > 0 {
                if !review_command_matches(recovered, v) { return ""; }
                let codec = OrganizationSourceRequestCodec { }; let decided = codec.fact(self.journal, "review.command_decided", v.command_id);
                if std::json::find_bool_field(recovered, "accepted") && !self.source_verdict_admitted(v, decided.seq) { return ""; }
                self.restore_command_decisions();
                return recovered;
            }
            if appended.error != "stale_revision" { return ""; }
            tries = tries + 1;
        }
        return "";
    }
    // Whether a verdict at a settled Review is the same approval again.
    // Reached per verdict from the membrane handler, like `consider`:
    // bounded by the reviewers of one candidate.
    @unbounded
    fn readmit(v: Verdict) -> Bool {
        if len(self.organization_source_request.request_id) > 0 {
            self.last_refusal = "prepared source requires its exact authorized command profile"; self.refused = self.refused + 1; return false;
        }
        self.refused = self.refused + 1;
        if self.outcome != "approve" { self.last_refusal = "already settled: " + self.outcome; return false; }
        if v.verdict != "approve" { self.last_refusal = "already settled: approve; a " + v.verdict + " does not reopen it"; return false; }
        if v.subject_digest != self.subject_digest { self.last_refusal = "already settled; digest mismatch: " + v.subject_digest + " != " + self.subject_digest; return false; }
        if !authority_satisfies(v.authority, self.required_authority) { self.last_refusal = "already settled; authority " + v.authority + " does not satisfy " + self.required_authority; return false; }
        if v.reviewer == self.author { self.last_refusal = "already settled; reviewer " + v.reviewer + " authored the candidate"; return false; }
        self.refused = self.refused - 1;
        return true;
    }
    // A verdict is admitted only if it names THIS candidate, carries the
    // required authority, and is independent of the author. Reached
    // per verdict from the membrane handler: bounded by the reviewers
    // of one candidate.
    @unbounded
    fn consider(v: Verdict) -> Bool {
        if len(self.organization_source_request.request_id) > 0 {
            self.last_refusal = "prepared source requires its exact authorized command profile"; self.refused = self.refused + 1; return false;
        }
        if self.settled { self.last_refusal = "already settled"; self.refused = self.refused + 1; return false; }
        if v.subject_digest != self.subject_digest {
            self.last_refusal = "digest mismatch: " + v.subject_digest + " != " + self.subject_digest;
            self.refused = self.refused + 1;
            return false;
        }
        if !authority_satisfies(v.authority, self.required_authority) {
            self.last_refusal = "authority " + v.authority + " does not satisfy " + self.required_authority;
            self.refused = self.refused + 1;
            return false;
        }
        if v.reviewer == self.author {
            self.last_refusal = "reviewer " + v.reviewer + " authored the candidate";
            self.refused = self.refused + 1;
            return false;
        }
        if len(self.approvers) > 0 {
            // GH #664: the change touches who owns what; each affected owner
            // approves through one of its members, and one rejection settles
            let owner = approver_owner(self.approvers, v.reviewer);
            if len(owner) == 0 {
                self.last_refusal = "reviewer " + v.reviewer + " is a member of no owner this change affects (" + approver_owners(self.approvers) + ")";
                self.refused = self.refused + 1;
                return false;
            }
            self.verdicts.push(v);
            if v.verdict == "abstain" { return true; }
            if v.verdict != "approve" {
                self.settled = true;
                self.outcome = v.verdict;
                self.decided_by = v.reviewer;
                self.comment = v.comment;
                return true;
            }
            self.approved_owners = word_add(self.approved_owners, owner);
            let mut i = 0;
            while len(nth_word(approver_owners(self.approvers), i)) > 0 {
                if !word_in(nth_word(approver_owners(self.approvers), i), self.approved_owners) { return true; }
                i = i + 1;
            }
            self.settled = true;
            self.outcome = "approve";
            self.decided_by = v.reviewer;
            self.comment = v.comment + " (every affected owner approved: " + self.approved_owners + ")";
            return true;
        }
        self.verdicts.push(v);
        if v.verdict == "abstain" { return true; }
        self.settled = true;
        self.outcome = v.verdict;
        self.decided_by = v.reviewer;
        self.comment = v.comment;
        return true;
    }
    fn verdict_count() -> Int { return self.verdicts.len(); }
    // GH #664: the owners still to approve, "" when none or not an owners change.
    @unbounded
    fn awaiting_owners() -> String {
        let mut out = "";
        let mut i = 0;
        while len(nth_word(approver_owners(self.approvers), i)) > 0 {
            let w = nth_word(approver_owners(self.approvers), i);
            if !word_in(w, self.approved_owners) { out = word_add(out, w); }
            i = i + 1;
        }
        return out;
    }
}

// ---- AutonomyBoundary ---------------------------------------------

@form(vec)
locus AuditRows {
    capacity { heap rows of AuditRow; }
}

type AuditRow {
    seq: Int = 0;
    change_class: String = "";
    magnitude: Int = 0;
    evidence: Int = 0;
    disposition: String = "";
    note: String = "";
}

locus AutonomyBoundary {
    params {
        child: String = "";
        grant: Grant = Grant { };
        ceiling: Grant = Grant { }; // the parent's grant, as it is now; no child = no ceiling
        audit: AuditRows = AuditRows { };
        decisions: Int = 0;
        contractions: Int = 0;
        expansions_refused: Int = 0;
        failures_in_row: Int = 0;
    }
    contract {
        expose child: String;
        expose decisions: Int;
        expose contractions: Int;
        expose expansions_refused: Int;
    }
    fn current_grant() -> Grant { return self.grant; }
    // The grant as it binds now: this boundary's, read through its
    // parent's current grant (GH #596, layering). The owner sets
    // `ceiling` from the parent before each assessment, so a parent's
    // contraction reaches the child at use, not only at birth.
    fn effective() -> Grant { return intersect_grants(self.grant, self.ceiling); }
    // The disposition of a proposed change under the current grant.
    // One audit row per assessment; bounded by the Mutations proposed.
    @unbounded
    fn assess(change_class: String, m: Magnitude, e: Evidence) -> Disposition {
        let d = dispose(self.effective(), change_class, m, e);
        self.decisions = self.decisions + 1;
        self.audit.push(AuditRow {
            seq: self.decisions, change_class: change_class,
            magnitude: magnitude_sum(m), evidence: evidence_score(e),
            disposition: disposition_name(d)
        });
        return d;
    }
    // Autonomy evolution is asymmetric: failure contracts automatically...
    fn note_outcome(ok: Bool) {
        if ok { self.failures_in_row = 0; return; }
        self.failures_in_row = self.failures_in_row + 1;
        if self.failures_in_row >= 2 && self.grant.max_magnitude > 0 {
            self.grant = Grant {
                child: self.grant.child, classes: self.grant.classes,
                max_magnitude: self.grant.max_magnitude / 2,
                review: "pre", may_expand_self: false,
                // GH #605: the resources stay as granted, and the epoch
                // advances so an admission made before the contraction
                // is fenced
                amounts: self.grant.amounts, window_amounts: self.grant.window_amounts, window: self.grant.window,
                counterparties: self.grant.counterparties, routes: self.grant.routes, expires: self.grant.expires,
                authority_epoch: self.grant.authority_epoch + 1
            };
            self.contractions = self.contractions + 1;
            self.audit.push(AuditRow { seq: self.decisions, disposition: "contract", note: "repeated failure" });
        }
    }
    // Whether this outcome contracts the grant (what `note_outcome` is
    // about to do), so the contraction can be recorded before it happens.
    fn would_contract(ok: Bool) -> Bool {
        return !ok && self.failures_in_row + 1 >= 2 && self.grant.max_magnitude > 0;
    }
    // A contraction read back from the record at birth (the second review
    // of #626): the magnitude and the epoch where it left the grant, review
    // `pre`, the resources as granted.
    fn restore_contraction(max_magnitude: Int, at_epoch: Int) {
        self.grant = Grant {
            child: self.grant.child, classes: self.grant.classes,
            max_magnitude: max_magnitude,
            review: "pre", may_expand_self: false,
            amounts: self.grant.amounts, window_amounts: self.grant.window_amounts, window: self.grant.window,
            counterparties: self.grant.counterparties, routes: self.grant.routes, expires: self.grant.expires,
            authority_epoch: at_epoch
        };
        self.contractions = self.contractions + 1;
        self.audit.push(AuditRow { seq: self.decisions, disposition: "contract", note: "restored from the record" });
    }
    // ...and expansion needs the PARENT. A request from the child (or
    // anyone who is not the owning parent) is refused and recorded.
    fn expand(requested_by: String, parent: String, new_max: Int, add_classes: String) -> Bool {
        // the child never expands its own grant, whatever it names as
        // the parent; and only the parent may ask at all
        if requested_by == self.child || requested_by != parent || self.grant.may_expand_self {
            self.expansions_refused = self.expansions_refused + 1;
            self.audit.push(AuditRow { seq: self.decisions, disposition: "refuse-expand", note: "requested by " + requested_by });
            return false;
        }
        self.grant = Grant {
            child: self.grant.child,
            classes: self.grant.classes + " " + add_classes,
            max_magnitude: new_max,
            review: self.grant.review,
            may_expand_self: false,
            amounts: self.grant.amounts, window_amounts: self.grant.window_amounts, window: self.grant.window,
            counterparties: self.grant.counterparties, routes: self.grant.routes, expires: self.grant.expires,
            authority_epoch: self.grant.authority_epoch
        };
        self.audit.push(AuditRow { seq: self.decisions, disposition: "expand", note: "by " + parent });
        return true;
    }
    // GH #605: revocation is the parent's, like expansion. Nothing is
    // left granted and the epoch advances, so every admission made under
    // the old grant is fenced.
    fn revoke(requested_by: String, parent: String) -> Bool {
        if requested_by == self.child || requested_by != parent {
            self.expansions_refused = self.expansions_refused + 1;
            self.audit.push(AuditRow { seq: self.decisions, disposition: "refuse-revoke", note: "requested by " + requested_by });
            return false;
        }
        self.grant = Grant { child: self.grant.child, classes: "", max_magnitude: 0, review: "pre", may_expand_self: false, window: self.grant.window, authority_epoch: self.grant.authority_epoch + 1 };
        self.audit.push(AuditRow { seq: self.decisions, disposition: "revoke", note: "by " + parent });
        return true;
    }
    // A revocation read back from the record at birth: nothing granted,
    // the epoch where the revocation left it.
    fn restore_revocation(revoked_at: Int) {
        self.grant = Grant { child: self.grant.child, classes: "", max_magnitude: 0, review: "pre", may_expand_self: false, window: self.grant.window, authority_epoch: revoked_at };
        self.audit.push(AuditRow { seq: self.decisions, disposition: "revoke", note: "restored from the record" });
    }
    fn audit_count() -> Int { return self.audit.len(); }
    fn audit_at(i: Int) -> AuditRow { return self.audit.get(i) or AuditRow { }; }
}
