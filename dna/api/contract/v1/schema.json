{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hale API v1 — DNA reads and declared organization",
  "description": "Implemented read contract. Organization is checked committed Structure, with its own source and artifact basis. No acting-context or command contract is advertised.",
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_head": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "record_id",
        "record_head",
        "record_revision"
      ],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1000000
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "Application": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "dna"
        },
        "name": {
          "type": "string"
        },
        "capabilities_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "capabilities_url"
      ],
      "additionalProperties": false
    },
    "Practice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "text_status": {
          "enum": [
            "available",
            "missing",
            "redacted",
            "protected",
            "source_unavailable",
            "digest_mismatch",
            "invalid_document"
          ]
        },
        "author": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "binding_class": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "review_id": {
          "type": "string"
        },
        "review_state": {
          "type": "string"
        },
        "review_settled": {
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "ratified",
            "declined",
            "retired",
            "refused"
          ]
        },
        "text_available": {
          "type": "boolean"
        },
        "ratified": {
          "type": "boolean"
        },
        "retired": {
          "type": "boolean"
        },
        "declined": {
          "type": "boolean"
        },
        "requester": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "review_outcome": {
          "enum": [
            "",
            "approve",
            "reject",
            "revise",
            "abstain"
          ]
        }
      },
      "required": [
        "id",
        "digest",
        "name",
        "kind",
        "text",
        "text_status",
        "author",
        "target",
        "binding_class",
        "provenance",
        "supersedes",
        "request_id",
        "review_id",
        "review_state",
        "review_settled",
        "state",
        "text_available",
        "ratified",
        "retired",
        "declined",
        "requester",
        "rationale",
        "review_outcome"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "text_available": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "const": ""
              },
              "rationale": {
                "const": ""
              },
              "review_settled": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "Review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string"
        },
        "subject_digest": {
          "type": "string"
        },
        "required_authority": {
          "type": "string"
        },
        "settled": {
          "type": "string"
        },
        "knowledge_digest": {
          "type": "string"
        },
        "text_status": {
          "enum": [
            "not_applicable",
            "available",
            "missing",
            "redacted",
            "protected",
            "source_unavailable",
            "digest_mismatch",
            "invalid_document"
          ]
        },
        "question": {
          "type": "string"
        },
        "text_available": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "",
            "approve",
            "reject",
            "revise",
            "abstain"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "subject_digest",
        "required_authority",
        "settled",
        "knowledge_digest",
        "text_status",
        "question",
        "text_available",
        "outcome"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "text_status": {
                "enum": [
                  "missing",
                  "redacted",
                  "protected",
                  "source_unavailable",
                  "digest_mismatch",
                  "invalid_document"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "text_available": {
                "const": false
              },
              "question": {
                "const": ""
              },
              "settled": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1
        },
        "read_only": {
          "const": true
        },
        "principal": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "local",
                "oidc"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "name"
          ],
          "additionalProperties": false
        },
        "reads": {
          "type": "object",
          "properties": {
            "practices": {
              "const": true
            },
            "reviews": {
              "const": true
            },
            "organization": {
              "type": "boolean"
            }
          },
          "required": [
            "practices",
            "reviews"
          ],
          "additionalProperties": false
        },
        "writes": {
          "type": "object",
          "properties": {
            "practice_propose": {
              "const": false
            },
            "review_verdict": {
              "const": false
            }
          },
          "required": [
            "practice_propose",
            "review_verdict"
          ],
          "additionalProperties": false
        },
        "runtime_observation": {
          "const": false
        },
        "recursive_workflows": {
          "const": false
        },
        "receipt_text": {
          "const": "record_visibility_only"
        }
      },
      "required": [
        "application_id",
        "read_only",
        "principal",
        "reads",
        "writes",
        "runtime_observation",
        "recursive_workflows",
        "receipt_text"
      ],
      "additionalProperties": false
    },
    "ApplicationsResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "hale.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Application"
              }
            },
            "page": {
              "$ref": "#/$defs/Page"
            }
          },
          "required": [
            "items",
            "page"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api_version",
        "source",
        "data"
      ],
      "additionalProperties": false
    },
    "CapabilitiesResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "hale.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "data": {
          "$ref": "#/$defs/Capabilities"
        }
      },
      "required": [
        "api_version",
        "source",
        "data"
      ],
      "additionalProperties": false
    },
    "PracticesResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "hale.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Practice"
              }
            },
            "page": {
              "$ref": "#/$defs/Page"
            }
          },
          "required": [
            "items",
            "page"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api_version",
        "source",
        "data"
      ],
      "additionalProperties": false
    },
    "ReviewsResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "hale.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Review"
              }
            },
            "page": {
              "$ref": "#/$defs/Page"
            }
          },
          "required": [
            "items",
            "page"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api_version",
        "source",
        "data"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "hale.v1"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api_version",
        "error"
      ],
      "additionalProperties": false
    },
    "OrganizationParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "OrganizationSubscription": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "capacity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "shed": {
          "type": "string"
        }
      },
      "required": [
        "topic",
        "handler",
        "capacity",
        "shed"
      ],
      "additionalProperties": false
    },
    "OrganizationSupervision": {
      "type": "object",
      "properties": {
        "child": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "child",
        "error",
        "ops",
        "retry"
      ],
      "additionalProperties": false
    },
    "OrganizationNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "declaration": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string"
        },
        "thread_domain": {
          "type": "string"
        },
        "role": {
          "enum": [
            "position",
            "structure"
          ]
        },
        "in_position_outline": {
          "type": "boolean"
        },
        "source_file": {
          "type": "string"
        },
        "sealed": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrganizationParameter"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subscribes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrganizationSubscription"
          }
        },
        "supervises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrganizationSupervision"
          }
        }
      },
      "required": [
        "id",
        "declaration",
        "parent_id",
        "thread_domain",
        "role",
        "in_position_outline",
        "source_file",
        "sealed",
        "parameters",
        "methods",
        "publishes",
        "subscribes",
        "supervises"
      ],
      "additionalProperties": false
    },
    "OrganizationBasis": {
      "type": "object",
      "properties": {
        "source_head": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "const": "dna/org"
        },
        "artifact_digest": {
          "type": "string",
          "minLength": 1
        },
        "shape_hash": {
          "type": "string"
        },
        "schema": {
          "const": "1.19"
        },
        "semantics": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "position_group_declared": {
          "type": "boolean"
        },
        "exact_ownership": {
          "type": "boolean"
        },
        "coverage": {
          "const": "static_instances"
        },
        "declaration_count": {
          "type": "integer",
          "minimum": 0
        },
        "uninstantiated_declaration_count": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_digest": {
          "type": "string",
          "minLength": 1
        },
        "dependency_source": {
          "enum": [
            "local_vendor_snapshot",
            "committed_source",
            "none"
          ]
        }
      },
      "required": [
        "source_head",
        "seed",
        "artifact_digest",
        "shape_hash",
        "schema",
        "semantics",
        "position_group_declared",
        "exact_ownership",
        "coverage",
        "declaration_count",
        "uninstantiated_declaration_count",
        "dependency_digest",
        "dependency_source"
      ],
      "additionalProperties": false
    },
    "OrganizationOwnership": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "single_owner",
            "shared"
          ]
        },
        "host_owner": {
          "type": "string"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            },
            "required": [
              "position",
              "owner"
            ],
            "additionalProperties": false
          }
        },
        "memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "owner",
              "members"
            ],
            "additionalProperties": false
          }
        },
        "instance_binding": {
          "const": "unavailable"
        }
      },
      "required": [
        "mode",
        "host_owner",
        "positions",
        "memberships",
        "instance_binding"
      ],
      "additionalProperties": false
    },
    "OrganizationResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "hale.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OrganizationNode"
              }
            },
            "page": {
              "$ref": "#/$defs/Page"
            },
            "basis": {
              "$ref": "#/$defs/OrganizationBasis"
            },
            "ownership": {
              "$ref": "#/$defs/OrganizationOwnership"
            }
          },
          "required": [
            "items",
            "page",
            "basis",
            "ownership"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api_version",
        "source",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
