// dna/core/legs/codebase.hl — a leg at work on an attached codebase
// (phase 3, heart-protocol item 4).
//
// The codebase's own repository is the leg's world: its worktree is a
// scratch clone of that repository on a branch of the default branch, the
// codebase's build and test commands are the leg's verify step, run in the
// worktree as the codebase's own opaque strings, and the review opens at
// the codebase's forge from the pushed branch. Nothing here reaches the
// organism's own genome.
import ".." as dna;

// `leg/<codebase>/<task>` -- a branch name from tokens.
fn codebase_branch(c: dna::Codebase, task: String) -> String {
    let mut t = "";
    let mut i = 0;
    while i < len(task) {
        let ch = task[i..(i + 1)];
        t = t + (if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "-" || ch == "_" { ch } else { "-" });
        i = i + 1;
    }
    return "leg/" + c.name + "/" + t;
}

// The attached codebase a hat names (`codebase` in the hat), else none.
fn hat_codebase(hat: String) -> dna::Codebase {
    let raw = std::json::find_field_raw(hat, "codebase");
    if len(raw) == 0 || raw == "null" { return dna::Codebase { }; }
    let branch = std::json::find_string_field(raw, "branch");
    return dna::Codebase {
        present: true, name: std::json::find_string_field(raw, "name"), repo: std::json::find_string_field(raw, "repo"),
        build: std::json::find_string_field(raw, "build"), test: std::json::find_string_field(raw, "test"),
        branch: if len(branch) > 0 { branch } else { "main" }, by: std::json::find_string_field(raw, "by")
    };
}

locus CodebaseWork {
    params { codebase: dna::Codebase = dna::Codebase { }; hands: Hands = Hands { }; branch: String = ""; }
    // The worktree: a clone of the codebase's repository at its default
    // branch, on the leg's own branch for `task`. The path.
    fn open(task: String) -> HandResult {
        if !self.codebase.present { return HandResult { error: "no such codebase attached" }; }
        let wt = self.hands.git.worktree(self.codebase.repo, self.codebase.branch);
        if !wt.ok { return wt; }
        self.branch = codebase_branch(self.codebase, task);
        let on = self.hands.git.branch(wt.output, self.branch);
        if !on.ok { return on; }
        return wt;
    }
    // The codebase's build, then its test, in the worktree: the first to
    // fail answers its output, else both did.
    fn verify(worktree: String) -> HandResult {
        let built = self.run_in(worktree, self.codebase.build);
        if !built.ok { return HandResult { error: "build failed: " + built.error }; }
        let tested = self.run_in(worktree, self.codebase.test);
        if !tested.ok { return HandResult { error: "test failed: " + tested.error }; }
        return HandResult { ok: true, output: dna::trim_nl(built.output + tested.output) };
    }
    fn run_in(worktree: String, cmd: String) -> HandResult {
        if len(cmd) == 0 { return HandResult { ok: true }; }
        let r = dna::run_tool("sh\n-c\ncd \"$1\" && eval \"$2\" 2>&1\nsh\n" + worktree + "\n" + cmd);
        if r.code != 0 { return HandResult { error: "`" + cmd + "` exited " + to_string(r.code) + (if len(r.stdout) > 0 { ": " + dna::trim_nl(r.stdout) } else { "" }) }; }
        return HandResult { ok: true, output: dna::trim_nl(r.stdout) };
    }
    // The change committed, its branch pushed to the codebase's repository,
    // and a review opened there: the review's reference. The forge decides.
    fn propose(worktree: String, title: String, body: String) -> HandResult {
        let done = self.hands.git.commit(worktree, title);
        if !done.ok { return done; }
        let pushed = self.hands.git.push(worktree, self.branch);
        if !pushed.ok { return pushed; }
        return self.hands.forge.open_review(worktree, title, body);
    }
}
