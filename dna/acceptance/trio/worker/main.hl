// dna/acceptance/trio/worker — the worker: fulfils what the api asks
// and is the only service that may send mail (the fleet's law).
//
// The application side of the knowledge graph (GH #583 K4): the
// worker observes a recurring condition — its mail backlog behind
// fulfilment — and raises a CONCERN about it, once per observation
// window, three times. A concern is one of its own events (GH #986,
// #987): it declares it as its own topic, `concern.raised` under its
// own subject `app.trio.`, and publishes it onto the nerves through
// pond's publish-only adapter (`NatsPublisher`: it dispatches nothing
// into the worker, so the fleet's law stays provable over it) as the
// application's own account its node names (HALE_DNA_NATS_URL_APP, the
// user HALE_DNA_NATS_USER_APP and the vault entry HALE_DNA_NATS_VAULT_APP,
// under HALE_DNA_NATS_ORG; GH #989). It imports
// nothing of the DNA. The organism's heart lands it as a reading, and
// the spine puts it into the record as a concern; the organization
// proposes it as knowledge; the Board ratifies; the next change to the
// trio is made with it in hand.

import "vendor/dna/pond/realtime/nats" as nats;

effect mail;

type Fulfilment { order: Int = 0; }
topic Fulfil { payload: Fulfilment; subject: "trio.fulfil"; }

/// A concern, as the worker says it: its own id, what it is about.
type Concern { id: String = ""; source: String = ""; what: String = ""; severity: Int = 0; }
topic WorkerConcerns { payload: Concern; subject: "app.trio.concern.raised"; }

type CodecError { kind: String = ""; }

// A JSON string literal (a codec is pure: no builder locus).
fn json_str(s: String) -> String {
    return "\"" + std::str::replace(std::str::replace(s, "\\", "\\\\"), "\"", "\\\"") + "\"";
}

/// A concern on the wire: one JSON object.
locus ConcernJson {
    fn encode(c: Concern) -> Bytes fallible(CodecError) {
        return std::bytes::from_string("{\"id\":" + json_str(c.id) + ",\"source\":" + json_str(c.source) + ",\"what\":" + json_str(c.what) + ",\"severity\":" + to_string(c.severity) + "}");
    }
    fn decode(b: Bytes) -> Concern fallible(CodecError) {
        let t = std::str::from_bytes(b);
        return Concern {
            id: std::json::find_string_field(t, "id"),
            source: std::json::find_string_field(t, "source"),
            what: std::json::find_string_field(t, "what"),
            severity: std::json::find_int_field(t, "severity")
        };
    }
}

fn env_or_empty(name: String) -> String { return if std::env::var_exists(name) { std::env::var(name) } else { "" }; }

locus Mailer {
    params { sent: Int = 0; backlog: Int = 0; }
    bus { subscribe Fulfil as on_fulfil; }
    @effects(is: { mail })
    fn on_fulfil(f: Fulfilment) { self.sent = self.sent + 1; self.backlog = self.backlog + 1; }
}

main locus TrioWorker {
    params {
        mailer: Mailer = Mailer { };
        raised: Int = 0;
        windows: Int = 0;
    }
    bus { publish Fulfil; publish WorkerConcerns; }
    // the nerves its node handed it (no url: it says nothing)
    // the application's own account: its user and the vault's entry holding
    // its password, as its node names them (HALE_DNA_NATS_USER_APP,
    // HALE_DNA_NATS_VAULT_APP), presented on CONNECT alone (GH #989)
    bindings { WorkerConcerns: nats::NatsPublisher { url: env_or_empty("HALE_DNA_NATS_URL_APP"), subject_prefix: env_or_empty("HALE_DNA_NATS_ORG") + ".", name: "trio-worker", user: env_or_empty("HALE_DNA_NATS_USER_APP"), credential: std::secret::Credential { vault: env_or_empty("HALE_DNA_NATS_VAULT_APP") } } codec(ConcernJson { }); }
    run() {
        Fulfil <- Fulfilment { order: 1 };
        std::time::sleep(100ms);
        println("worker: ", self.mailer.sent, " mail(s) sent");
        if std::env::var_exists("HALE_DNA_ONESHOT") { return; }
        // every observation window the backlog is still there: say so,
        // three times, then leave it to the organization
        while true {
            std::time::sleep(100ms);
            self.windows = self.windows + 1;
            if self.windows % 20 == 0 && self.raised < 3 && self.mailer.backlog > 0 && std::env::var_exists("HALE_DNA_NATS_URL_APP") {
                self.raised = self.raised + 1;
                // an id is this concern's alone: a repeat is a replay
                WorkerConcerns <- Concern { id: "backlog-" + to_string(std::time::nanos(std::time::current())) + "-" + to_string(self.raised), source: "org/trio/worker", what: "mail backlog behind fulfilment", severity: 2 };
                println("worker: concern raised (", self.raised, "/3)");
            }
        }
    }
}

fn main() {
    TrioWorker { };
}
