// The organization's practices, as the record holds them (C3, family 5):
// a practice asked of the organization and its own rows (refused, started,
// proposed), the Reviews this incarnation has ratified through
// practice-ratify, the execution a proposal is ratified under, and the
// practice-ratify step that reads the hat. It was part of the assembly; as
// a locus of its own it holds the one thing only it keeps, the Reviews it
// has ratified through (`ratified_through`, never scanned for again), with
// the journal the assembly lends it at birth. Memory's client the hat is
// read from is the assembly's, passed on the call. The knowledge a
// practice is, its Review, the ratification and the schedule a practice
// carries are other families' and the assembly's: the assembly admits a
// ratification's execution and performs its `ratify` step, and records
// through this family what it has ratified (dna/core/record_rows.hl).
locus PracticeRecord {
    params {
        journal: Journal = MemJournal { }; // the assembly's, lent at its birth
        ratified_through: String = "\n"; // GH #995: the Reviews this incarnation has ratified through practice-ratify, never scanned for again
    }
    fn bind(j: Journal) { self.journal = j; }
    // GH #682: whether a practice request already has its answer.
    fn answered(request_id: String) -> Bool {
        if len(request_id) == 0 { return false; }
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.entity == request_id && (e.kind == "practice.proposed" || e.kind == "practice.refused") { return true; }
            i = i + 1;
        }
        return false;
    }
    // A practice request's own rows: refused for want of a name and a text,
    // started once the body received it, proposed with the knowledge's
    // digest. Whether each is in the record.
    fn refused(r: PracticeRequest) -> Bool { return append_once(self.journal, "practice.refused", r.request_id, "a practice has a name and a text"); }
    fn started(r: PracticeRequest) -> Bool {
        let started = std::json::Builder { };
        started.begin_object();
        started.string_field("request_id", r.request_id);
        started.string_field("name", r.name);
        started.string_field("text", r.text);
        started.string_field("by", r.by);
        started.string_field("because", r.because);
        started.string_field("supersedes", r.supersedes);
        started.end_object();
        return append_once(self.journal, "practice.started", r.request_id, started.result());
    }
    fn proposed(r: PracticeRequest, digest: String) -> Bool {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("name", r.name);
        b.string_field("digest", digest);
        b.string_field("review_id", knowledge_review_id(digest));
        b.string_field("by", r.by);
        b.string_field("because", r.because);
        b.string_field("supersedes", r.supersedes);
        b.end_object();
        return append_once(self.journal, "practice.proposed", r.request_id, b.result());
    }
    // Whether this incarnation has ratified `review_id` through
    // practice-ratify, and so never asks it again.
    fn ratified(review_id: String) -> Bool { return std::str::contains(self.ratified_through, "\n" + review_id + "\n"); }
    // One line per Review ratified this incarnation, as the journal holds them.
    @bounded_by(self.journal)
    fn ratified_now(review_id: String) { self.ratified_through = self.ratified_through + review_id + "\n"; }
    // ---- practice-ratify ----
    // The execution a knowledge proposal is ratified under, "" when none.
    fn ratification_of(digest: String) -> String {
        let n = self.journal.revision();
        let mut i = 0;
        while i < n {
            let e = self.journal.read(i);
            if e.kind == "workflow.admitted" && std::json::find_string_field(e.body, "definition") == "practice-ratify" && std::json::find_string_field(std::json::find_string_field(e.body, "inputs"), "digest") == digest { return e.entity; }
            i = i + 1;
        }
        return "";
    }
    // practice-ratify's `hat` step for a family (the library): done once
    // memory's projection holds the family's last idea, ratified.
    fn family_hat(task: String, digest: String, last: String, knowledge: MemoryKnowledge, memory_ready: Bool) -> StepVerdict {
        let read = first_row(self.journal, "practice.read", digest);
        if len(read.kind) > 0 { return step_done(digest, "memory read the family at row " + to_string(std::json::find_int_field(read.body, "head"))); }
        if !knowledge.ready() { return step_failed("no memory is named (" + knowledge.dsn_env + " is not set): the library is memory's to read"); }
        if len(last) == 0 { return step_failed("the family names no idea"); }
        let at = knowledge.ratified_at(last);
        if at < 0 { return step_waits(); }
        if !memory_ready { return step_waits(); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("digest", digest);
        b.int_field("ratified_at", at);
        b.int_field("head", self.journal.revision());
        b.string_field("task", task);
        b.end_object();
        if !append_once(self.journal, "practice.read", digest, b.result()) { return step_waits(); }
        return step_done(digest, "memory read the family at row " + to_string(self.journal.revision()));
    }
    // practice-ratify's `hat` step for the proposal at `digest`: what the
    // hat reads once memory's projection holds the idea and its binding —
    // the package for the target at memory's head, and whether it carries
    // the proposal, the row it was fenced to. `memory_ready`: memory's
    // projection had caught up when last asked.
    fn hat(task: String, digest: String, knowledge: MemoryKnowledge, memory_ready: Bool) -> StepVerdict {
        // what the hat reads once memory's projection holds the idea and its
        // binding: the package for the target at memory's head, and whether
        // it carries the proposal — the row it was fenced to
        let read = first_row(self.journal, "practice.read", digest);
        if len(read.kind) > 0 { return step_done(std::json::find_string_field(read.body, "hat"), "the hat read it at row " + to_string(std::json::find_int_field(read.body, "head"))); }
        // no memory named: the hat is memory's to read, and nothing will
        // come to wait for — the chain ends saying so. Memory named but
        // behind, or unreachable a moment: the step waits for it.
        if !knowledge.ready() { return step_failed("no memory is named (" + knowledge.dsn_env + " is not set): the hat is memory's to read"); }
        let at = knowledge.ratified_at(digest);
        if at < 0 { return step_waits(); }
        // never block the organization's handler on memory's projection:
        // behind the record's knowledge, the step waits and is performed
        // again at the tick
        if !memory_ready { return step_waits(); }
        let target = std::json::find_string_field(first_row(self.journal, "knowledge.proposed", digest).body, "target");
        let pkg = knowledge.package_for(target, "");
        if len(pkg.error) > 0 { return step_waits(); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("digest", digest);
        b.string_field("target", target);
        b.int_field("ratified_at", at);
        b.string_field("hat", pkg.digest);
        b.int_field("head", pkg.revision);
        b.bool_field("included", std::str::contains(" " + pkg.included + " ", " " + digest + " "));
        b.string_field("task", task);
        b.end_object();
        if !append_once(self.journal, "practice.read", digest, b.result()) { return step_waits(); }
        return step_done(pkg.digest, "the hat for " + target + " at row " + to_string(pkg.revision));
    }
}

// ---- a practice's terms: the parameters of what it runs (phase 3) ----------
//
// A practice's text may carry terms: words `<key>=<value>`, the value the
// rest of the word. They are the parameters of what the practice runs. A
// practice that names a cadence (`every=`) and a step (`step=<definition>`)
// declares that schedule once it is ratified, as one whose receipt carries
// a `schedule` does, convened by the position it is bound to (its target).
// Either way the occurrences' inputs name the practice, `practice` (its
// digest) and `name`, so the step reads its parameters from the practice's
// own text: amended by the next version, never copied beside it.

// The value of `key` among `text`'s terms, "" when it names none.
@bounded_by(text)
fn practice_term(text: String, key: String) -> String {
    let mut rest = std::str::replace(std::str::replace(text, "\n", " "), "\t", " ");
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let w = if sp < 0 { rest } else { rest[0..sp] };
        rest = if sp < 0 { "" } else { rest[(sp + 1)..len(rest)] };
        if std::str::starts_with(w, key + "=") { return w[(len(key) + 1)..len(w)]; }
    }
    return "";
}

// The inputs an occurrence of practice `digest` (named `name`) is admitted
// with: the practice, and whatever `args` (a JSON object) adds.
fn practice_args(digest: String, name: String, args: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("practice", digest);
    b.string_field("name", name);
    b.end_object();
    let own = b.result();
    let rest = std::str::trim(args);
    if !std::str::starts_with(rest, "{") || std::str::trim(rest[1..len(rest)]) == "}" { return own; }
    return own[0..(len(own) - 1)] + ", " + rest[1..len(rest)];
}

// The schedule the practice `doc` (its receipt, under `digest`) declares
// once ratified: its receipt's `schedule`, or, for a practice, the cadence
// and step its text names, convened by the position it is bound to. No id and no definition
// when it declares none.
fn practice_schedule(digest: String, doc: String) -> Schedule {
    let name = std::json::find_string_field(doc, "name");
    let sched = std::json::find_string_field(doc, "schedule");
    if len(sched) > 0 {
        return Schedule {
            id: std::json::find_string_field(sched, "id"),
            every_ms: std::json::find_int_field(sched, "every_ms"),
            cron: std::json::find_string_field(sched, "cron"),
            definition: std::json::find_string_field(sched, "definition"),
            args: practice_args(digest, name, std::json::find_string_field(sched, "args")),
            convener: std::json::find_string_field(sched, "convener")
        };
    }
    // only a practice runs anything: an idea or a mandate whose text shows
    // terms (an example, say) schedules nothing
    if std::json::find_string_field(doc, "kind") != "practice" { return Schedule { }; }
    let text = std::json::find_string_field(doc, "text");
    let step = practice_term(text, "step");
    let every = practice_term(text, "every");
    if len(step) == 0 && len(every) == 0 { return Schedule { }; }
    let target = std::json::find_string_field(doc, "target");
    return Schedule {
        id: name, every_ms: every_ms_of(every), definition: step, args: practice_args(digest, name, "{}"),
        convener: if std::str::starts_with(target, "position:") { target } else { "" }
    };
}

// An interval as a schedule takes it: milliseconds with a unit (`500ms`,
// `30s`, `15m`, `1h`, `1d`); 0 when it is none.
fn every_ms_of(text: String) -> Int {
    let t = std::str::trim(text);
    let unit = if std::str::ends_with(t, "ms") { "ms" } else if len(t) > 0 { t[(len(t) - 1)..len(t)] } else { "" };
    let digits = if unit == "ms" { t[0..(len(t) - 2)] } else if len(unit) > 0 { t[0..(len(t) - 1)] } else { "" };
    let n = std::str::parse_int(digits) or 0;
    if n <= 0 { return 0; }
    if unit == "ms" { return n; }
    if unit == "s" { return n * 1000; }
    if unit == "m" { return n * 60000; }
    if unit == "h" { return n * 3600000; }
    if unit == "d" { return n * 86400000; }
    return 0;
}
