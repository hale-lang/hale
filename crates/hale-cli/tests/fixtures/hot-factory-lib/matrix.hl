/// A locus factory. `build` here returns a locus; the same name in
/// `hot-factory-ambig` does not.
locus Matrix {
    params { n: Int = 0; }
}

fn build(n: Int) -> Matrix {
    let m = Matrix { n: n };
    return m;
}

fn zeros(n: Int) -> Matrix {
    let m = Matrix { n: n };
    return m;
}

/// Its name ends as a stdlib fn's does (`std::env::arg`): a call of that
/// fn is never a call of this one.
fn one_arg(n: Int) -> Matrix {
    let m = Matrix { n: n };
    return m;
}
