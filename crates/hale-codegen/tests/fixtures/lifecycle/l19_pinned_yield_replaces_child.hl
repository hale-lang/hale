// Decision line 19, a pinned mailbox handler retains its subscriber
// across a nested yield (Handler, inventory row R52).
//
// Go precedes Swap in the mailbox. Kid yields until Owner's Swap handler
// replaces it and sets a shared gate, then reads its old heap-backed
// name. Both handlers and the gate run on the same pinned thread. The
// gate forces the nested replacement without relying on a timed window.
// Logical dissolve may run during replacement; physical storage must
// remain until the suspended handler and its delivery region have ended.
//
// Expected: `read-whole reclaimed-after-handler dissolved-once-each`.
// Removing the handler hold restores a heap-use-after-free; retaining
// the hold but removing handler-boundary retirement restores a deadlock.

type Go { k: Int; }
topic Gos { payload: Go; subject: "lifecycle.l19.pinned_yield.go"; }
topic Swap { payload: Go; subject: "lifecycle.l19.pinned_yield.swap"; }

locus Gate { params { swapped: Int = 0; } }

locus Kid {
    params { tag: Int = 0; name: String = ""; gate: Gate; }
    bus { subscribe Gos as on_go; }
    birth() { self.name = "kid-" + to_string(self.tag) + "-name"; }
    fn on_go(g: Go) {
        if g.k == self.tag {
            println("ev kid-handler-enter " + to_string(self.tag));
            while self.gate.swapped == 0 { std::time::sleep(1ms); }
            println("ev kid-handler-read " + self.name);
        }
    }
    dissolve() { println("ev kid-dissolve " + to_string(self.tag)); }
}

locus Owner {
    params { gate: Gate = Gate { }; c: Kid = Kid { tag: 1, gate: self.gate }; }
    bus { subscribe Swap as on_swap; }
    fn swap() {
        self.c = Kid { tag: 2, gate: self.gate };
        self.gate.swapped = 1;
    }
    fn on_swap(s: Go) {
        println("ev owner-swap");
        self.swap();
    }
}

main locus App {
    params { p: Owner = Owner { }; }
    placement { p: pinned; }
    bus { publish Gos; publish Swap; }
    run() {
        Gos <- Go { k: 1 };
        Swap <- Go { k: 0 };
        println("ev finished");
    }
}

fn main() { App { }; }
