// Typed governance reads over a loaded Journal. No query refreshes, appends,
// publishes or starts a service. The caller owns snapshot validation/lifetime.
import "../core" as dna;

type ReviewRow {
    id: String = "";
    state: String = "pending";
    question: String = "";
    required_authority: String = "";
    subject_digest: String = "";
    refusals: String = ""; // one per line
    refusal_count: Int = 0;
    settled: String = "";
    reasoned: String = "";
    has_reasoned: Bool = false;
    mutation_id: String = "";
    is_mutation: Bool = false;
    group: String = ""; // "design" or "operating" for the toolchain's seeded practices (GH #596 C, #994): listed together by family, decided one by one
    change_class: String = "";
    seed: String = "";
    disposition: String = "";
    base_commit: String = "";
    candidate_commit: String = "";
    candidate_shape: String = "";
    evidence: String = "";
    magnitude_raw: String = "";
    diff_text: String = "";
    diff_json: String = "";
    author: String = "";
    outcome: String = "";
    knowledge_digest: String = "";
    knowledge_binding_digest: String = "";
    binding_request_id: String = "";
    knowledge_edge_digest: String = "";
    edge_request_id: String = "";
    organization_source: Bool = false;
    organization_source_request_id: String = "";
    organization_source_digest: String = "";
    target: String = "";
    binding_class: String = "";
    approvers: String = "";
    text_status: String = "not_applicable";
    text_available: Bool = false;
}

type BindingReviewCandidate {
    ok: Bool = false;
    status: String = "missing";
    review_id: String = "";
    document: String = "";
    sequence: Int = -1;
    request: dna::KnowledgeBindingRequest = dna::KnowledgeBindingRequest { };
}

type EdgeReviewCandidate {
    ok: Bool = false;
    status: String = "missing";
    review_id: String = "";
    document: String = "";
    sequence: Int = -1;
    request: dna::KnowledgeEdgeRequest = dna::KnowledgeEdgeRequest { };
}

type PracticeRow {
    id: String = "";
    digest: String = "";
    name: String = "";
    kind: String = "";
    author: String = "";
    target: String = "";
    binding_class: String = "";
    provenance: String = "";
    text: String = "";
    text_available: Bool = false;
    text_status: String = "missing";
    supersedes: String = "";
    requester: String = "";
    because: String = "";
    request_id: String = "";
    review_id: String = "";
    review_state: String = "";
    review_settled: String = "";
    review_outcome: String = "";
    state: String = "pending";
    ratified: Bool = false;
    retired: Bool = false;
    declined: Bool = false;
    refusal: String = "";
    proposed_seq: Int = -1;
}

type PracticeRequestRow {
    id: String = "";
    name: String = "";
    requester: String = "";
    seq: Int = -1;
}

locus NoReceipts {
    params { }
    fn store(text: String) -> String { return ""; }
    fn read(digest: String) -> String { return ""; }
    fn erase(digest: String) -> Bool { return false; }
    fn kind() -> String { return "unavailable"; }
}

fn review_id_of(e: dna::Event) -> String {
    if std::str::starts_with(e.entity, "review:") { return e.entity[7..len(e.entity)]; }
    return e.entity;
}

// Native projection, shared with terminal consumers. It deliberately retains
// every existing Review field. Hosted readers use Queries.review_of, which also
// applies receipt visibility to knowledge-derived free text.
@unbounded
fn review_row(j: dna::Journal, id: String) -> ReviewRow {
    let mut r = ReviewRow { };
    let mut i = 0;
    while i < j.revision() {
        let e = j.read(i);
        if review_id_of(e) == id {
            if e.kind == "review.requested" {
                let b = e.body;
                let mid = std::json::find_string_field(b, "mutation_id");
                // A later malformed duplicate cannot erase the source privacy
                // classification established by an earlier tagged request.
                let source_marked = r.organization_source || std::json::find_field_raw(b, "organization_source_request_id") != "" || std::json::find_field_raw(b, "organization_source_digest") != "";
                r = ReviewRow {
                    id: id, state: "pending",
                    question: dna::native_json_string(b, "question"),
                    required_authority: std::json::find_string_field(b, "required_authority"),
                    subject_digest: std::json::find_string_field(b, "subject_digest"),
                    mutation_id: mid, is_mutation: len(mid) > 0,
                    group: std::json::find_string_field(b, "group"),
                    change_class: std::json::find_string_field(b, "change_class"),
                    seed: std::json::find_string_field(b, "seed"),
                    disposition: std::json::find_string_field(b, "disposition"),
                    base_commit: std::json::find_string_field(b, "base_commit"),
                    candidate_commit: std::json::find_string_field(b, "candidate_commit"),
                    candidate_shape: std::json::find_string_field(b, "candidate_shape"),
                    evidence: std::json::find_string_field(b, "evidence"),
                    magnitude_raw: std::json::find_field_raw(b, "magnitude"),
                    diff_text: std::json::find_string_field(b, "diff_text"),
                    diff_json: std::json::find_string_field(b, "diff_json"),
                    author: std::json::find_string_field(b, "author"),
                    knowledge_digest: std::json::find_string_field(b, "knowledge_digest"),
                    knowledge_binding_digest: dna::native_json_string(b, "knowledge_binding_digest"),
                    binding_request_id: dna::native_json_string(b, "binding_request_id"),
                    knowledge_edge_digest: dna::native_json_string(b, "knowledge_edge_digest"),
                    edge_request_id: dna::native_json_string(b, "edge_request_id"),
                    organization_source: source_marked,
                    organization_source_request_id: dna::native_json_string(b, "organization_source_request_id"),
                    organization_source_digest: dna::native_json_string(b, "organization_source_digest"),
                    target: std::json::find_string_field(b, "target"),
                    binding_class: std::json::find_string_field(b, "class"),
                    approvers: std::json::find_string_field(b, "approvers")
                };
            } else if len(r.id) > 0 {
                if e.kind == "review.settled" { r.state = "settled"; r.settled = e.body; r.outcome = review_outcome(e.body); }
                if e.kind == "review.reasoned" { r.reasoned = e.body; r.has_reasoned = true; }
                if e.kind == "review.refused" { r.refusals = r.refusals + e.body + "\n"; r.refusal_count = r.refusal_count + 1; }
            }
        }
        i = i + 1;
    }
    return r;
}

fn review_outcome(settled: String) -> String {
    if std::str::starts_with(settled, "approve by ") { return "approve"; }
    if std::str::starts_with(settled, "reject by ") { return "reject"; }
    if std::str::starts_with(settled, "revise by ") { return "revise"; }
    if std::str::starts_with(settled, "abstain by ") { return "abstain"; }
    return "";
}

// Practice documents are produced by one canonical native codec. Re-encode
// every field and compare bytes: hash equality alone does not validate JSON,
// required fields, types or agreement with the proposal's metadata.
fn canonical_practice(doc: String, p: PracticeRow) -> Bool {
    let i = dna::Idea {
        kind: dna::native_json_string(doc, "kind"),
        text: dna::native_json_string(doc, "text"),
        author: dna::native_json_string(doc, "author"),
        provenance: dna::native_json_string(doc, "provenance"),
        name: dna::native_json_string(doc, "name"),
        supersedes: dna::native_json_string(doc, "supersedes")
    };
    let target = dna::native_json_string(doc, "target");
    if i.kind != p.kind || i.name != p.name || i.author != p.author || target != p.target || i.supersedes != p.supersedes { return false; }
    if dna::knowledge_document(i, target) == doc { return true; }
    // Seeded design practices predate knowledge_document and use their own
    // compact canonical codec (host/record_verbs.hl: design_document).
    if i.provenance != "design" || i.author != "org" || i.kind != "practice" || target != "org" { return false; }
    let q = std::json::Builder { };
    let design = "{\"author\":\"org\",\"kind\":\"practice\",\"name\":" + q.quote(i.name) + ",\"provenance\":\"design\"," + (if len(i.supersedes) > 0 { "\"supersedes\":" + q.quote(i.supersedes) + "," } else { "" }) + "\"target\":\"org\",\"text\":" + q.quote(i.text) + ",\"toolchain\":" + q.quote(dna::native_json_string(doc, "toolchain")) + "}";
    return design == doc;
}

fn raw_digest(digest: String) -> String {
    if std::str::starts_with(digest, "sha256:") { return digest[7..len(digest)]; }
    return digest;
}

locus Queries {
    params {
        j: dna::Journal = dna::MemJournal { };
        receipts: dna::Receipts = NoReceipts { };
    }
    fn revision() -> Int { return self.j.revision(); }
    fn head() -> String { return self.j.head(); }
    fn event_at(i: Int) -> dna::Event { return self.j.read(i); }
    fn has(kind: String, entity: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == kind && e.entity == entity { return true; }
            i = i + 1;
        }
        return false;
    }
    // The CLI historically lists all named knowledge proposals, including
    // seeded practices. Preserve that catalog; kind remains explicit.
    fn practice_event(e: dna::Event) -> Bool {
        return e.kind == "knowledge.proposed" && len(std::json::find_string_field(e.body, "name")) > 0;
    }
    fn first_practice(i: Int) -> Bool {
        let e = self.j.read(i);
        if !self.practice_event(e) { return false; }
        let mut k = 0;
        while k < i {
            let earlier = self.j.read(k);
            if self.practice_event(earlier) && earlier.entity == e.entity { return false; }
            k = k + 1;
        }
        return true;
    }
    fn practice_count() -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            if self.first_practice(i) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    fn practice_at(index: Int) -> PracticeRow {
        if index < 0 { return PracticeRow { }; }
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            if self.first_practice(i) {
                if n == index { return self.practice_of(self.j.read(i).entity); }
                n = n + 1;
            }
            i = i + 1;
        }
        return PracticeRow { };
    }
    // Receipt families move to Ledger after adoption. A Record-only reader
    // cannot prove their current visibility; fail closed even if a stale local
    // blob remains. No protected-service read or disclosure write is performed.
    fn receipt_status(digest: String) -> String {
        let mut adopted = false;
        let mut redacted = false;
        let mut protected = false;
        let mut uncertain = false;
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "ledger.adopted" { adopted = true; }
            // Abandonment empties Ledger; it does not restore every prior
            // receipt restriction into Record. Once adopted, this projection
            // alone cannot establish completeness again.
            if raw_digest(e.entity) == raw_digest(digest) {
                if e.kind == "receipt.redacted" { redacted = true; }
                if e.kind == "receipt.classified" || e.kind == "receipt.withheld" || e.kind == "receipt.filed" {
                    let class = std::json::find_string_field(e.body, "class");
                    if dna::protected_class(class) { protected = true; }
                    else if e.kind == "receipt.withheld" || (class != "public" && class != "internal") { uncertain = true; }
                }
            }
            i = i + 1;
        }
        if redacted { return "redacted"; }
        if protected { return "protected"; }
        if adopted || uncertain { return "source_unavailable"; }
        return "available";
    }
    // Recorded provenance from an exact admitted generic node request, not a
    // fresh authorization decision. Legacy Practice request fields take
    // precedence; ambiguous generic origins expose no guessed request link.
    fn node_provenance(row: PracticeRow) -> PracticeRow {
        if row.id == "" || row.request_id != "" || self.j.revision() < 1 || self.receipt_status(row.id) != "available" { return row; }
        let codec = KnowledgeNodeCommandCodec { }; let native = dna::KnowledgeNodeRequestCodec { }; let text = GovernanceCommandCodec { }; let view = GovernanceProjection { };
        let mut origin = KnowledgeFact { }; let mut sequence = -1; let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "knowledge.node.requested" && text.string(e.body, "candidate_digest") == row.id {
                if origin.valid { return row; }
                let parsed = codec.decode_fact(e);
                if !parsed.valid || parsed.context.application_id != self.j.read(0).digest || parsed.node.candidate_digest != row.id { return row; }
                origin = parsed; sequence = i;
            }
            i = i + 1;
        }
        if !origin.valid { return row; }
        let r = origin.node; let id = r.request_id; let review_id = dna::knowledge_review_id(row.id);
        if row.review_id != review_id || row.kind != r.kind || row.name != r.name || row.author != r.author || row.target != r.target || row.supersedes != r.supersedes { return row; }
        let started = view.fact(self.j, "knowledge.node.started", id, false); let proposed = view.fact(self.j, "knowledge.node.proposed", id, false);
        let refused = view.fact(self.j, "knowledge.node.refused", id, false); let candidate = view.fact(self.j, "knowledge.proposed", row.id, false);
        let review = view.fact(self.j, "review.requested", review_id, true);
        if !started.found || started.invalid || started.sequence <= sequence || started.body != native.started(r)
            || !proposed.found || proposed.invalid || refused.found || refused.invalid || proposed.body != native.proposed(r)
            || !candidate.found || candidate.invalid || candidate.sequence <= started.sequence || !review.found || review.invalid
            || review.sequence <= candidate.sequence || proposed.sequence <= review.sequence || !view.review(self.j, review_id, row.id).ok { return row; }
        // Preserve existing visibility and reject a reused namespace identity,
        // including conflicting command variants which name another candidate.
        i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            let command = e.kind == "knowledge.edge.linked" || e.kind == "knowledge.edge.unlinked" || e.kind == "knowledge.edge.requested" || e.kind == "knowledge.node.requested" || e.kind == "knowledge.binding.requested";
            if command && e.entity == id && i != sequence { return row; }
            let support = i == sequence || (e.entity == id && (e.kind == "knowledge.node.started" || e.kind == "knowledge.node.proposed"))
                || (e.kind == "knowledge.proposed" && e.entity == row.id)
                || (e.kind == "review.requested" && (e.entity == review_id || e.entity == "review:" + review_id));
            if support && (self.receipt_status(e.digest) != "available" || self.receipt_status(e.entity) != "available") { return row; }
            i = i + 1;
        }
        let doc = self.receipts.read(raw_digest(row.id));
        if len(doc) == 0 || len(doc) > 98304 || dna::digest_of(doc) != row.id || doc != native.document(r) { return row; }
        let mut out = row; out.request_id = id; out.requester = r.by; out.because = r.because; return out;
    }
    @unbounded
    fn candidate_metadata(digest: String, named_only: Bool) -> PracticeRow {
        let mut r = PracticeRow { };
        let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            let kind = dna::native_json_string(e.body, "kind");
            let supported = kind == "idea" || kind == "concept" || kind == "practice" || kind == "task_concept" || kind == "retirement";
            if (if named_only { self.practice_event(e) } else { e.kind == "knowledge.proposed" && supported }) && e.entity == digest && len(r.id) == 0 {
                r = PracticeRow {
                    id: digest, digest: digest, proposed_seq: i,
                    name: std::json::find_string_field(e.body, "name"),
                    kind: std::json::find_string_field(e.body, "kind"),
                    author: std::json::find_string_field(e.body, "author"),
                    target: std::json::find_string_field(e.body, "target"),
                    binding_class: std::json::find_string_field(e.body, "class"),
                    supersedes: std::json::find_string_field(e.body, "supersedes"),
                    review_id: std::json::find_string_field(e.body, "review_id")
                };
            }
            i = i + 1;
        }
        if len(r.id) == 0 { return r; }
        // Some older named proposal rows omit review_id. Never slice an
        // arbitrary short digest to invent one.
        if len(r.review_id) == 0 && len(raw_digest(digest)) >= 12 { r.review_id = dna::knowledge_review_id(digest); }
        r.ratified = self.has("knowledge.ratified", digest);
        r.retired = self.has("knowledge.retired", digest);
        r.declined = self.has("knowledge.declined", digest);
        i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.kind == "practice.proposed" && std::json::find_string_field(e.body, "digest") == digest {
                r.request_id = e.entity;
                r.requester = std::json::find_string_field(e.body, "by");
                r.because = dna::native_json_string(e.body, "because");
            }
            if e.kind == "knowledge.refused" && e.entity == digest { r.refusal = e.body; }
            i = i + 1;
        }
        r.state = if r.retired { "retired" } else if r.ratified { "ratified" } else if r.declined { "declined" } else if len(r.refusal) > 0 { "refused" } else { "pending" };
        let review = review_row(self.j, r.review_id);
        r.review_state = if len(review.id) > 0 { review.state } else { "" };
        r.review_settled = review.settled;
        r.review_outcome = review.outcome;
        return self.node_provenance(r);
    }
    fn practice_metadata(digest: String) -> PracticeRow { return self.candidate_metadata(digest, true); }
    // Exact candidate lookup supports unnamed Knowledge proposals without
    // adding them to the named Practice catalog's membership or pagination.
    fn knowledge_metadata(digest: String) -> PracticeRow { return self.candidate_metadata(digest, false); }
    fn practice_of(digest: String) -> PracticeRow {
        let mut r = self.practice_metadata(digest);
        if len(r.id) == 0 { r = self.knowledge_metadata(digest); }
        if len(r.id) == 0 { return r; }
        r.text_status = self.receipt_status(digest);
        if r.text_status == "available" {
            let doc = self.receipts.read(raw_digest(digest));
            if len(doc) == 0 { r.text_status = "missing"; }
            else if dna::digest_of(doc) != "sha256:" + raw_digest(digest) { r.text_status = "digest_mismatch"; }
            else if !canonical_practice(doc, r) { r.text_status = "invalid_document"; }
            else {
                r.text = dna::native_json_string(doc, "text");
                r.provenance = dna::native_json_string(doc, "provenance");
                r.text_available = true;
            }
        }
        if !r.text_available { r.because = ""; r.refusal = ""; r.review_settled = ""; }
        return r;
    }
    fn first_review(i: Int) -> Bool {
        let e = self.j.read(i);
        if e.kind != "review.requested" { return false; }
        let mut k = 0;
        while k < i {
            let earlier = self.j.read(k);
            if earlier.kind == "review.requested" && review_id_of(earlier) == review_id_of(e) { return false; }
            k = k + 1;
        }
        return true;
    }
    fn review_count() -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            if self.first_review(i) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    fn review_at(index: Int) -> ReviewRow {
        if index < 0 { return ReviewRow { }; }
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            if self.first_review(i) {
                if n == index { return self.review_of(review_id_of(self.j.read(i))); }
                n = n + 1;
            }
            i = i + 1;
        }
        return ReviewRow { };
    }
    fn mask_source_review(row: ReviewRow) -> ReviewRow {
        let mut r = row; r.text_available = false; r.text_status = "source_unavailable";
        r.question = ""; r.settled = ""; r.reasoned = ""; r.has_reasoned = false; r.refusals = "";
        r.diff_text = ""; r.diff_json = ""; r.evidence = ""; r.magnitude_raw = "";
        r.author = ""; r.approvers = ""; r.target = ""; r.binding_class = "";
        r.base_commit = ""; r.candidate_commit = ""; r.candidate_shape = "";
        r.change_class = ""; r.seed = ""; r.disposition = "";
        r.organization_source_request_id = ""; r.organization_source_digest = "";
        return r;
    }
    fn source_review_status(r: ReviewRow) -> String {
        if !r.is_mutation || r.organization_source_request_id == "" || r.organization_source_digest == "" || r.knowledge_digest != "" || r.knowledge_binding_digest != "" || r.knowledge_edge_digest != "" { return "invalid_document"; }
        let codec = OrganizationCommandCodec { }; let native = dna::OrganizationSourceRequestCodec { }; let mut found = OrganizationCommandFact { }; let mut i = 0;
        while i < self.j.revision() {
            let e = self.j.read(i);
            if e.entity == r.organization_source_request_id && e.kind == "organization.source.requested" {
                let fact = codec.decode_fact(e);
                if found.valid || !fact.valid || fact.context.application_id != self.j.read(0).digest { return "invalid_document"; }
                found = fact;
            }
            i = i + 1;
        }
        if !found.valid || native.mutation_id(found.request) != r.id || found.request.source_digest != r.organization_source_digest
            || r.base_commit != found.request.source_head || r.candidate_commit != r.subject_digest || r.author != found.request.by { return "invalid_document"; }
        let ids = found.request.module_digest + " " + found.request.source_digest + " " + found.request.source_head + " " + r.candidate_commit + " " + r.diff_text + " " + r.diff_json;
        if r.diff_text == "" || r.diff_json == "" { return "invalid_document"; }
        i = 0; while i < dna::word_count(ids) {
            let status = self.receipt_status(dna::nth_word(ids, i)); if status != "available" { return status; } i = i + 1;
        }
        return "available";
    }
    fn review_of(id: String) -> ReviewRow {
        let mut r = review_row(self.j, id);
        if len(r.id) == 0 { return r; }
        if r.organization_source {
            let status = self.source_review_status(r);
            if status != "available" { let mut hidden = self.mask_source_review(r); hidden.text_status = status; return hidden; }
            r.text_available = true; r.text_status = "available"; return r;
        }
        if len(r.knowledge_edge_digest) > 0 || len(r.edge_request_id) > 0 {
            let edge = self.edge_candidate_of(id);
            r.text_available = edge.ok; r.text_status = if edge.ok { "available" } else { edge.status };
            if !edge.ok {
                r.settled = ""; r.question = ""; r.reasoned = ""; r.has_reasoned = false; r.refusals = "";
                r.diff_text = ""; r.diff_json = ""; r.evidence = "";
                r.author = ""; r.target = ""; r.binding_class = ""; r.edge_request_id = "";
            }
            return r;
        }
        if len(r.knowledge_binding_digest) > 0 || len(r.binding_request_id) > 0 {
            let binding = self.binding_candidate_of(id);
            r.text_available = binding.ok; r.text_status = if binding.ok { "available" } else { binding.status };
            if !binding.ok {
                r.settled = ""; r.question = ""; r.reasoned = ""; r.has_reasoned = false; r.refusals = "";
                r.diff_text = ""; r.diff_json = ""; r.evidence = "";
                r.author = ""; r.target = ""; r.binding_class = ""; r.binding_request_id = "";
            }
            return r;
        }
        let digest = if len(r.knowledge_digest) > 0 { r.knowledge_digest } else { r.subject_digest };
        let status = self.receipt_status(digest);
        let knowledge = len(r.knowledge_digest) > 0 || self.has("knowledge.proposed", digest);
        let inconsistent = len(r.knowledge_digest) > 0 && len(r.subject_digest) > 0 && r.knowledge_digest != r.subject_digest;
        // Non-knowledge question text is declared directly in the Review row;
        // not_applicable means no canonical practice receipt governs it. Never
        // ignore a recorded restriction on its subject merely because an older
        // review.requested row omitted knowledge_digest.
        if !knowledge && status == "available" { return r; }
        let p = self.practice_of(digest);
        r.text_status = if len(p.id) > 0 { p.text_status } else if status != "available" { status } else { "missing" };
        r.text_available = p.text_available;
        if inconsistent { r.text_status = "invalid_document"; r.text_available = false; }
        if !r.text_available {
            r.settled = "";
            r.question = "";
            r.reasoned = "";
            r.has_reasoned = false;
            r.refusals = "";
            r.diff_text = "";
            r.diff_json = "";
            r.evidence = "";
        }
        return r;
    }
    fn binding_candidate_of(id: String) -> BindingReviewCandidate {
        let row = review_row(self.j, id); let view = GovernanceProjection { }; let native = dna::KnowledgeBindingCodec { };
        if row.id == "" || row.knowledge_binding_digest == "" || row.knowledge_digest != "" || row.knowledge_edge_digest != "" || row.edge_request_id != "" || row.subject_digest != row.knowledge_binding_digest || row.is_mutation || row.approvers != "" { return BindingReviewCandidate { }; }
        let fact = view.binding_fact(self.j, row.subject_digest, id);
        if !fact.valid || row.binding_request_id != fact.binding.request_id { return BindingReviewCandidate { }; }
        let r = fact.binding;
        let candidate_access = self.receipt_status(r.candidate_digest); let idea_access = self.receipt_status(r.idea_id);
        if candidate_access != "available" || idea_access != "available" { return BindingReviewCandidate { status: if candidate_access != "available" { candidate_access } else { idea_access } }; }
        let item = native.subject(self.j, self.receipts, r.idea_id);
        if !item.ok || !item.ratified { return BindingReviewCandidate { status: "invalid_document" }; }
        let original = view.fact(self.j, "knowledge.binding.requested", r.request_id, false);
        let proposed = view.fact(self.j, "knowledge.binding.proposed", r.request_id, false);
        if !original.found || original.invalid || !proposed.found || proposed.invalid || proposed.sequence <= original.sequence || proposed.body != native.proposed(r) { return BindingReviewCandidate { status: "invalid_document" }; }
        let basis = native.basis(self.j, self.receipts, r, original.sequence);
        if !basis.ok || basis.event_id != r.binding_basis { return BindingReviewCandidate { status: "invalid_document" }; }
        let doc = self.receipts.read(raw_digest(r.candidate_digest));
        if len(doc) > 32768 || dna::digest_of(doc) != r.candidate_digest || doc != native.document(r) { return BindingReviewCandidate { status: "invalid_document" }; }
        let review = view.binding_review(self.j, r);
        if !review.ok { return BindingReviewCandidate { status: "invalid_document" }; }
        return BindingReviewCandidate { ok: true, status: "available", review_id: id, document: doc, sequence: original.sequence, request: r };
    }
    fn edge_candidate_of(id: String) -> EdgeReviewCandidate {
        let row = review_row(self.j, id); let view = GovernanceProjection { }; let native = dna::KnowledgeEdgeCodec { };
        if row.id == "" || row.knowledge_edge_digest == "" || row.knowledge_digest != "" || row.knowledge_binding_digest != "" || row.binding_request_id != "" || row.subject_digest != row.knowledge_edge_digest || row.is_mutation || row.approvers != "" { return EdgeReviewCandidate { }; }
        let fact = view.edge_fact(self.j, row.subject_digest, id);
        if !fact.valid || row.edge_request_id != fact.edge.request_id { return EdgeReviewCandidate { }; }
        let r = fact.edge;
        let candidate_access = self.receipt_status(r.candidate_digest); let from_access = self.receipt_status(r.from_id); let to_access = self.receipt_status(r.to_id);
        if candidate_access != "available" || from_access != "available" || to_access != "available" { return EdgeReviewCandidate { status: if candidate_access != "available" { candidate_access } else if from_access != "available" { from_access } else { to_access } }; }
        let endpoints = native.endpoints(self.j, self.receipts, r, self.j.revision());
        if !endpoints.ok || !endpoints.ratified { return EdgeReviewCandidate { status: "invalid_document" }; }
        let original = view.fact(self.j, "knowledge.edge.requested", r.request_id, false);
        let proposed = view.fact(self.j, "knowledge.edge.proposed", r.request_id, false);
        if !original.found || original.invalid || !proposed.found || proposed.invalid || proposed.sequence <= original.sequence || proposed.body != native.proposed(r) { return EdgeReviewCandidate { status: "invalid_document" }; }
        let direct = StrictKnowledgeDirectEdgeFacts { };
        let basis = native.basis(self.j, self.receipts, direct, r, original.sequence);
        if !basis.ok || basis.event_id != r.edge_basis { return EdgeReviewCandidate { status: "invalid_document" }; }
        let doc = self.receipts.read(raw_digest(r.candidate_digest));
        if len(doc) > 32768 || dna::digest_of(doc) != r.candidate_digest || doc != native.document(r) { return EdgeReviewCandidate { status: "invalid_document" }; }
        let review = view.edge_review(self.j, r);
        if !review.ok { return EdgeReviewCandidate { status: "invalid_document" }; }
        return EdgeReviewCandidate { ok: true, status: "available", review_id: id, document: doc, sequence: original.sequence, request: r };
    }
    fn request_at_seq(i: Int) -> PracticeRequestRow {
        if i < 0 || i >= self.j.revision() { return PracticeRequestRow { }; }
        let e = self.j.read(i);
        if e.kind != "practice.requested" { return PracticeRequestRow { }; }
        let mut k = i + 1;
        while k < self.j.revision() {
            let later = self.j.read(k);
            if later.entity == e.entity && (later.kind == "practice.proposed" || later.kind == "practice.refused") { return PracticeRequestRow { }; }
            k = k + 1;
        }
        return PracticeRequestRow { id: e.entity, seq: i, name: std::json::find_string_field(e.body, "name"), requester: std::json::find_string_field(e.body, "by") };
    }
}
