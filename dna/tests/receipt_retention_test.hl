// GH #606 part 2 — retention. A hold refuses redaction until it is
// released. A redaction removes the body and keeps the digest with a
// row naming who, why and under what policy: a git receipt's ref goes
// from this clone, from the remote, and from another clone at its next
// sync; a protected body is memory's (GH #985): a head records the
// redaction and the spine — the body host, memory's one eraser — erases
// the body on its tick, after which a read answers with the redaction;
// and the spine keeps projecting the record when a knowledge receipt it
// read is redacted.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, model discovery off.
fn in_dir(dir: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && shift && export HALE_DNA_DISCOVER=off && exec \"$@\"\nsh\n" + dir + "\n" + argv);
}

fn hex_of(digest: String) -> String {
    return if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
}

// `argv` in `dir` as a head of the record: memory reached by the head's
// role alone (GH #985).
fn as_head(dir: String, head_dsn: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_HEAD=\"$2\" && shift 2 && exec \"$@\"\nsh\n" + dir + "\n" + head_dsn + "\n" + argv);
}

// `hale dna memory migrate` in `dir` with the owner's DSN and a receipt key.
fn migrate_with(dir: String, owner: String, key: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_OWNER=\"$2\" HALE_DNA_RECEIPT_KEY=\"$3\" && exec \"$4\" dna memory migrate\nsh\n" + dir + "\n" + owner + "\n" + key + "\n" + toolchain());
}

// The value of `NAME=` on its own line of `text`.
fn line_value(text: String, name: String) -> String {
    let at = std::str::index_of(text, name + "=");
    if at < 0 { return ""; }
    let rest = text[(at + len(name) + 1)..len(text)];
    let nl = std::str::index_of(rest, "\n");
    return if nl < 0 { rest } else { rest[0..nl] };
}

// The spine: `hale dna dev` in the background with the owner's DSN (dev
// migrates and hands the host the spine's role), bounded; its pid.
fn start_spine(app: String, owner: String) -> String {
    let started = dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_DNA_DISCOVER=off HALE_DNA_MEMORY_DSN_OWNER=\"$2\" && nohup timeout 600 \"$3\" dna dev . --no-iris >>.hale/dev.log 2>&1 </dev/null & echo $!\nsh\n" + app + "\n" + owner + "\n" + toolchain());
    return dna::trim_nl(started.stdout);
}

// The host, then everything it started.
fn stop_spine(app: String, pid: String) {
    let k = dna::run_tool("kill\n" + pid);
    let gone = dna::run_tool("sh\n-c\nn=0; while kill -0 \"$1\" 2>/dev/null && [ $n -lt 100 ]; do sleep 0.1; n=$((n+1)); done; cd \"$2\" && for f in org app; do [ -f .hale/dna/$f.pid ] && kill -9 $(cat .hale/dna/$f.pid) 2>/dev/null; rm -f .hale/dna/$f.pid; done; true\nsh\n" + pid + "\n" + app);
}

main locus App {
    params {
        core: dna::Dna = dna::Dna { planned: true, org_id: "retention-placeholder" };
        owner_conn: dna::Pq = dna::Pq { };
        head: dna::Pq = dna::Pq { };
    }
    // How many protected bodies memory keeps under `digest`, read with the
    // owner's DSN ("?" when it could not be read).
    @unbounded
    fn kept(record: String, digest: String) -> String {
        let r = self.owner_conn.conn.query_one("SELECT count(*) FROM " + dna::schema_for(record) + ".protected_receipts WHERE digest = '" + digest + "'");
        return if r.ok { dna::trim_nl(r.data) } else { "? " + r.err.kind + " " + r.err.detail };
    }
    // The spine's graph projection watermark once it reaches `at` or
    // `secs` pass; the watermark it last read (-1 when unread).
    @unbounded
    fn projected_to(record: String, at: Int, secs: Int) -> Int {
        let deadline = std::time::now() + dna::wait_secs(secs);
        let mut projected = -1;
        while projected < at && std::time::now() <= deadline {
            let w = self.owner_conn.conn.query_one("SELECT value FROM " + dna::schema_for(record) + ".knowledge_meta WHERE key = 'watermark'");
            projected = if w.ok { std::str::parse_int(dna::trim_nl(w.data)) or - 1 } else { -1 };
            if projected < at { std::time::sleep(200ms); }
        }
        return projected;
    }
    // Whether memory comes to keep `want` bodies under `digest` within
    // `secs` (the spine erases on its tick).
    @unbounded
    fn kept_becomes(record: String, digest: String, want: String, secs: Int) -> Bool {
        let deadline = std::time::now() + dna::wait_secs(secs);
        while std::time::now() <= deadline {
            if self.kept(record, digest) == want { return true; }
            std::time::sleep(200ms);
        }
        return false;
    }
    @unbounded
    fn last(repo: String, kind: String, entity: String) -> String {
        let j = dna::GitJournal { repo: repo };
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && e.entity == entity { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn rows_of(repo: String, kind: String, entity: String) -> Int {
        let j = dna::GitJournal { repo: repo };
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && e.entity == entity { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    run() {
        // what an erasure does from what the store answered
        std::test::assert_eq_str(dna::protected_erase_step(true, "", false), "", "a kept body, not yet redacted: record, then erase");
        std::test::assert_eq_str(dna::protected_erase_step(true, "", true), "", "a kept body under a recorded redaction: erase it");
        std::test::assert_eq_str(dna::protected_erase_step(false, "", true), "already", "no body, redaction recorded: already redacted");
        std::test::assert_eq_str(dna::protected_erase_step(false, "", false), "", "no body, never kept: the redaction is recorded");
        std::test::assert_eq_str(dna::protected_erase_step(false, "get: connection refused", false), "unread: get: connection refused", "a store that could not read records nothing");
        std::test::assert_eq_str(dna::protected_erase_step(false, "get: connection refused", true), "unread: get: connection refused", "and never says already redacted");
        let scratch = dna::scratch_root("retention");
        // whatever this fixture starts under its scratch stops when it does (#637)
        dna::reap_on_exit(scratch);
        let bare = scratch + "/origin.git";
        let init = in_dir(scratch, "git\ninit\n-q\n--bare\n-b\nmain\n" + bare);
        let made = in_dir(scratch, toolchain() + "\ndna\nnew\nkept");
        std::test::assert_eq_int(made.code, 0, "hale dna new: " + made.stdout + made.stderr);
        let app = scratch + "/kept";
        let c1 = in_dir(app, "git\nconfig\nuser.name\nmara");
        let c2 = in_dir(app, "git\nconfig\nuser.email\nmara@local");
        let c3 = in_dir(app, "git\nadd\n-A");
        let c4 = in_dir(app, "git\ncommit\n-q\n-m\nthe app");
        let c5 = in_dir(app, "git\nremote\nadd\norigin\n" + bare);

        self.core = dna::Dna {
            journal: dna::GitJournal { repo: app, author: "mara" },
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: app }, repo: app },
            vault: dna::MemoryVault { repo: app, dsn_env: "" },
            planned: true, org_id: "retention"
        };
        let note = "a supplier note the retention policy covers";
        let d = self.core.file_evidence(note, "internal", "mara");
        let receipts = dna::GitReceipts { repo: app };
        std::test::assert_eq_str(receipts.read(hex_of(d)), note, "an internal receipt");

        // a second clone that has fetched it
        let pushed = in_dir(app, "git\npush\n-q\norigin\nmain\nrefs/dna/*:refs/dna/*");
        std::test::assert_eq_int(pushed.code, 0, "pushed: " + pushed.stderr);
        let other = scratch + "/other";
        let cloned = in_dir(scratch, "git\nclone\n-q\n" + bare + "\n" + other);
        let o1 = in_dir(other, "git\nconfig\nuser.name\ntomasz");
        let o2 = in_dir(other, "git\nconfig\nuser.email\ntomasz@local");
        let synced = in_dir(other, toolchain() + "\ndna\nsync");
        std::test::assert_eq_int(synced.code, 0, "the other clone syncs: " + synced.stdout + synced.stderr);
        let other_receipts = dna::GitReceipts { repo: other };
        std::test::assert_eq_str(other_receipts.read(hex_of(d)), note, "and holds the receipt");

        // ---- a hold refuses redaction until it is released
        std::test::assert_eq_str(self.core.hold_evidence(d, "counsel", "litigation hold on supplier records"), "", "counsel holds it");
        std::test::assert(std::str::contains(self.core.hold_evidence(d, "counsel", "again"), "already held"), "a hold is once");
        let refused = self.core.redact_evidence(d, "mara", "no longer needed", "retention:30d");
        std::test::assert(std::str::contains(refused, "held: counsel: litigation hold on supplier records"), "redaction waits for the hold: " + refused);
        std::test::assert_eq_str(receipts.read(hex_of(d)), note, "and nothing was removed");
        std::test::assert_eq_str(self.core.release_hold(d, "counsel", "matter closed"), "", "counsel releases it");
        std::test::assert(std::str::contains(self.core.release_hold(d, "counsel", "again"), "is not held"), "a release needs a hold");

        // ---- redaction: the body goes, the digest and the row stay
        std::test::assert_eq_str(self.core.redact_evidence(d, "mara", "no longer needed", "retention:30d"), "", "redacted under the policy");
        std::test::assert_eq_str(receipts.read(hex_of(d)), "", "the ref is gone from this clone");
        let row = self.last(app, "receipt.redacted", d);
        std::test::assert(std::str::contains(row, "\"by\": \"mara\"") && std::str::contains(row, "\"why\": \"no longer needed\"") && std::str::contains(row, "\"policy\": \"retention:30d\"") && std::str::contains(row, "\"store\": \"git\""), "the record keeps who, why and the policy: " + row);
        std::test::assert(std::str::contains(self.core.redact_evidence(d, "mara", "again", "retention:30d"), "already redacted"), "a redaction is once");
        // filed again, a redacted receipt keeps no body (#636)
        std::test::assert_eq_str(self.core.file_evidence(note, "internal", "mara"), d, "the same document files as the same digest");
        std::test::assert_eq_str(receipts.read(hex_of(d)), "", "and its ref does not come back");
        std::io::fs::write_file(scratch + "/note.txt", note) or discard;
        let refiled = in_dir(app, toolchain() + "\ndna\nreceipt\nfile\n" + scratch + "/note.txt\n--as\nmara");
        std::test::assert(refiled.code != 0 && std::str::contains(refiled.stdout + refiled.stderr, "was redacted; a redacted body is not filed again"), "nor through the CLI: " + refiled.stdout + refiled.stderr);
        std::test::assert_eq_str(receipts.read(hex_of(d)), "", "whose ref stays gone");

        // ---- a redaction the record cannot hold erases nothing
        let second = "a second supplier note under the same policy";
        let d2 = self.core.file_evidence(second, "internal", "mara");
        std::io::fs::write_file(app + "/.git/refs/dna/journal.lock", "held by the test") or discard;
        let unrecorded = self.core.redact_evidence(d2, "mara", "no longer needed", "retention:30d");
        let cli_unrecorded = in_dir(app, toolchain() + "\ndna\nreceipt\nredact\n" + d2 + "\n--why\nno longer needed\n--policy\nretention:30d\n--as\nmara");
        std::io::fs::unlink(app + "/.git/refs/dna/journal.lock") or discard;
        std::test::assert(std::str::contains(unrecorded, "nothing was erased"), "the organism refuses it: " + unrecorded);
        std::test::assert(cli_unrecorded.code != 0 && std::str::contains(cli_unrecorded.stdout + cli_unrecorded.stderr, "nothing was erased"), "and so does the CLI: " + cli_unrecorded.stdout + cli_unrecorded.stderr);
        std::test::assert_eq_str(receipts.read(hex_of(d2)), second, "the body is intact");
        std::test::assert_eq_str(self.last(app, "receipt.redacted", d2), "", "and no redaction is in the record");

        // ---- a hold that arrives while the CLI redacts wins (#636): a git on
        // the CLI's PATH places a hold the moment the redaction reads the body
        let third = "a third supplier note, about to be held";
        let d3 = self.core.file_evidence(third, "internal", "mara");
        let bin = scratch + "/bin";
        std::io::fs::mkdir(bin) or discard;
        let real_git = dna::trim_nl(dna::run_tool("sh\n-c\ncommand -v git").stdout);
        let flag = scratch + "/hold-now";
        std::io::fs::write_file(flag, "once") or discard;
        std::io::fs::write_file(bin + "/git", "#!/bin/sh\ncase \"$*\" in *cat-file*refs/dna/receipts/" + hex_of(d3) + "*) if [ -f \"" + flag + "\" ]; then rm -f \"" + flag + "\"; (cd \"" + app + "\" && \"" + toolchain() + "\" dna receipt hold " + d3 + " --why \"a hold that arrived mid-redaction\" --as counsel) >/dev/null 2>&1; fi ;; esac\nexec \"" + real_git + "\" \"$@\"\n") or discard;
        let gx = dna::run_tool("chmod\n+x\n" + bin + "/git");
        let raced = in_dir(app, "sh\n-c\nPATH=\"$1:$PATH\" exec \"$2\" dna receipt redact \"$3\" --why \"no longer needed\" --policy retention:30d --as mara\nsh\n" + bin + "\n" + toolchain() + "\n" + d3);
        std::test::assert(!std::io::fs::file_exists(flag), "the hold was placed during the redaction");
        std::test::assert(std::str::contains(self.last(app, "receipt.held", d3), "a hold that arrived mid-redaction"), "the hold is in the record");
        std::test::assert(raced.code != 0 && std::str::contains(raced.stdout + raced.stderr, "the record moved while redacting"), "the redaction that read no hold does not land: " + raced.stdout + raced.stderr);
        std::test::assert_eq_str(self.last(app, "receipt.redacted", d3), "", "no redaction is in the record");
        std::test::assert_eq_str(receipts.read(hex_of(d3)), third, "and the held body is intact");
        let after_hold = in_dir(app, toolchain() + "\ndna\nreceipt\nredact\n" + d3 + "\n--why\nno longer needed\n--policy\nretention:30d\n--as\nmara");
        std::test::assert(after_hold.code != 0 && std::str::contains(after_hold.stdout + after_hold.stderr, "held: counsel: a hold that arrived mid-redaction"), "redacting again meets the hold: " + after_hold.stdout + after_hold.stderr);

        // ---- sync forgets it everywhere
        let s1 = in_dir(app, toolchain() + "\ndna\nsync");
        std::test::assert_eq_int(s1.code, 0, "this clone syncs: " + s1.stdout + s1.stderr);
        let remote_ref = in_dir(app, "git\nls-remote\norigin\nrefs/dna/receipts/" + hex_of(d));
        std::test::assert_eq_str(dna::trim_nl(remote_ref.stdout), "", "the remote no longer has the ref");
        let s2 = in_dir(other, toolchain() + "\ndna\nsync");
        std::test::assert_eq_int(s2.code, 0, "the other clone syncs again: " + s2.stdout + s2.stderr);
        std::test::assert_eq_str(other_receipts.read(hex_of(d)), "", "and drops the ref it had fetched");
        let listed = in_dir(other, toolchain() + "\ndna\nreceipt\nredact\n" + d + "\n--why\nx\n--policy\ny");
        std::test::assert(listed.code != 0 && std::str::contains(listed.stdout + listed.stderr, "already redacted"), "the other clone knows it was redacted: " + listed.stdout + listed.stderr);

        // ---- a protected body, kept in memory (GH #985): a head files,
        // holds and redacts it through the CLI; the spine erases it
        let owner = if std::env::var_exists("HALE_DNA_MEMORY_DSN_OWNER") { std::env::var("HALE_DNA_MEMORY_DSN_OWNER") } else { "" };
        if len(owner) == 0 {
            eprintln("receipt_retention_test: no HALE_DNA_MEMORY_DSN_OWNER; the protected half (memory's erasure) was not exercised here");
            dna::scratch_done(scratch);
            return;
        }
        let record = dna::GitJournal { repo: app }.genesis();
        let migrated = migrate_with(app, owner, "a receipt key of forty characters, test");
        let head_dsn = line_value(migrated.stdout, "HALE_DNA_MEMORY_DSN_HEAD");
        let spine_dsn = line_value(migrated.stdout, "HALE_DNA_MEMORY_DSN_SPINE");
        std::test::assert(migrated.code == 0 && std::str::starts_with(head_dsn, "postgres") && std::str::starts_with(spine_dsn, "postgres"), "the owner migrates memory with the receipt key: " + migrated.stdout + migrated.stderr);
        self.owner_conn = dna::Pq { conn: dna::pq_conn(dna::parse_dsn(owner)) };
        let st = self.owner_conn.conn.open();
        std::test::assert(st.ok, "the owner connects: " + st.err.detail);
        let secret = "payroll line for employee 88: 4100.00";
        std::io::fs::write_file(scratch + "/p1.txt", secret) or discard;
        let filed = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nfile\n" + scratch + "/p1.txt\n--class\nconfidential\n--as\nmara");
        std::test::assert(filed.code == 0 && std::str::contains(filed.stdout, "kept in memory"), "a head files it into memory: " + filed.stdout + filed.stderr);
        let p = dna::digest_of(secret);
        std::test::assert_eq_str(self.kept(record, p), "1", "memory keeps it");
        let disclosed = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\ndisclose\n" + p + "\n--to\ntomasz\n--purpose\naudit\n--as\nmara");
        std::test::assert_eq_int(disclosed.code, 0, "disclosed: " + disclosed.stderr);
        let shown = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + p + "\n--purpose\naudit\n--as\ntomasz");
        std::test::assert(shown.code == 0 && std::str::contains(shown.stdout, secret), "readable before redaction: " + shown.stdout + shown.stderr);
        let held = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nhold\n" + p + "\n--why\naudit in progress\n--as\ncounsel");
        std::test::assert_eq_int(held.code, 0, "held from the CLI: " + held.stderr);
        let blocked = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nredact\n" + p + "\n--why\nleft the company\n--policy\ngdpr-erasure\n--as\nmara");
        std::test::assert(blocked.code != 0 && std::str::contains(blocked.stdout + blocked.stderr, "held: counsel: audit in progress"), "a redaction is refused while held: " + blocked.stdout + blocked.stderr);
        std::test::assert_eq_str(self.last(app, "receipt.redacted", p), "", "and none is in the record");
        let released = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nrelease-hold\n" + p + "\n--why\naudit done\n--as\ncounsel");
        std::test::assert_eq_int(released.code, 0, "released: " + released.stderr);
        let redacted = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nredact\n" + p + "\n--why\nleft the company\n--policy\ngdpr-erasure\n--as\nmara");
        std::test::assert(redacted.code == 0 && std::str::contains(redacted.stdout, "the body erases it from memory on its next tick"), "a head records the redaction; the spine erases: " + redacted.stdout + redacted.stderr);
        let prow = self.last(app, "receipt.redacted", p);
        std::test::assert(std::str::contains(prow, "\"policy\": \"gdpr-erasure\"") && std::str::contains(prow, "\"class\": \"confidential\"") && std::str::contains(prow, "\"by\": \"mara\""), "the row names who, the policy and the class: " + prow);
        std::test::assert_eq_str(self.kept(record, p), "1", "recorded, not yet erased: no spine has run");
        // the spine erases it on its tick
        let spine = start_spine(app, owner);
        std::test::assert(self.kept_becomes(record, p, "0", 300), "the spine erases the redacted body on its tick: " + self.kept(record, p) + " kept; " + (std::io::fs::read_file(app + "/.hale/dev.log") or ""));
        let gone = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + p + "\n--purpose\naudit\n--as\ntomasz");
        std::test::assert(gone.code != 0 && std::str::contains(gone.stdout + gone.stderr, "was redacted: by mara under gdpr-erasure: left the company"), "a read learns the body is gone, not missing: " + gone.stdout + gone.stderr);
        // filed again, a redacted protected body is not kept (#636)
        std::test::assert_eq_str(self.core.file_evidence(secret, "confidential", "mara"), p, "the same body files as the same digest");
        std::test::assert_eq_int(self.rows_of(app, "receipt.withheld", p), 0, "without a withheld row");
        let refiled = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nfile\n" + scratch + "/p1.txt\n--class\nconfidential\n--as\nmara");
        std::test::assert(refiled.code != 0 && std::str::contains(refiled.stdout + refiled.stderr, "a redacted body is not kept again"), "a head refuses to file it into memory again: " + refiled.stdout + refiled.stderr);
        // a replay straight into memory's own function, past the record's
        // check, is erased again by the spine: memory keeps no body the
        // record says was redacted for longer than a tick
        self.head = dna::Pq { conn: dna::pq_conn(dna::parse_dsn(head_dsn)) };
        let hs = self.head.conn.open();
        std::test::assert(hs.ok, "the head's role connects: " + hs.err.detail);
        let replayed = self.head.conn.query_one("SELECT " + dna::schema_for(record) + ".receipt_file('" + p + "', 'confidential', '" + secret + "', 0)");
        std::test::assert(self.kept_becomes(record, p, "0", 300), "whatever reaches memory under a redacted digest, the spine erases (the replay " + (if replayed.ok { "landed" } else { "was refused: " + replayed.err.detail }) + "): " + self.kept(record, p) + " kept");
        self.head.conn.close();
        let nothing_kept = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nredact\n" + p + "\n--why\nleft the company\n--policy\ngdpr-erasure\n--as\nmara");
        std::test::assert(nothing_kept.code == 0 && std::str::contains(nothing_kept.stdout, "the redaction is in the record"), "redacting again records nothing new: " + nothing_kept.stdout + nothing_kept.stderr);
        std::test::assert_eq_int(self.rows_of(app, "receipt.redacted", p), 1, "one redaction in the record");
        let listing = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt");
        std::test::assert(std::str::contains(listing.stdout, "redacted by mara under gdpr-erasure"), "the list says so: " + listing.stdout);

        // the redaction is recorded before anything erases: a redaction the
        // record cannot hold is refused, and the body stays
        let secret2 = "payroll line for employee 91: 3900.00";
        std::io::fs::write_file(scratch + "/p2.txt", secret2) or discard;
        let filed2 = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nfile\n" + scratch + "/p2.txt\n--class\nconfidential\n--as\nmara");
        std::test::assert_eq_int(filed2.code, 0, "filed: " + filed2.stdout + filed2.stderr);
        let p2 = dna::digest_of(secret2);
        let d22 = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\ndisclose\n" + p2 + "\n--to\ntomasz\n--purpose\naudit\n--as\nmara");
        std::test::assert_eq_int(d22.code, 0, "disclosed: " + d22.stderr);
        std::io::fs::write_file(app + "/.git/refs/dna/journal.lock", "held by the test") or discard;
        let unerased = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nredact\n" + p2 + "\n--why\nleft the company\n--policy\ngdpr-erasure\n--as\nmara");
        std::io::fs::unlink(app + "/.git/refs/dna/journal.lock") or discard;
        std::test::assert(unerased.code != 0 && std::str::contains(unerased.stdout + unerased.stderr, "the record refused the redaction"), "a redaction the record cannot hold is refused: " + unerased.stdout + unerased.stderr);
        std::test::assert_eq_str(self.last(app, "receipt.redacted", p2), "", "no redaction is in the record");
        let still = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nshow\n" + p2 + "\n--purpose\naudit\n--as\ntomasz");
        std::test::assert(still.code == 0 && std::str::contains(still.stdout, secret2), "and the protected body is intact: " + still.stdout + still.stderr);
        std::test::assert_eq_str(self.kept(record, p2), "1", "memory still keeps it");
        // a redaction recorded, its erasure not yet carried out (no spine
        // runs): the body is still kept, redacting again through the CLI
        // records nothing new, and the spine's next tick completes it
        stop_spine(app, spine);
        let rec2 = self.core.journal.append(self.core.journal.revision(), "receipt.redacted", p2, "{\"by\": \"mara\", \"why\": \"left the company\", \"policy\": \"gdpr-erasure\", \"class\": \"confidential\", \"store\": \"memory\"}");
        std::test::assert(rec2.ok, "the interrupted redaction's row: " + rec2.error);
        std::test::assert_eq_str(self.kept(record, p2), "1", "recorded and not yet erased");
        let completed = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nredact\n" + p2 + "\n--why\nleft the company\n--policy\ngdpr-erasure\n--as\nmara");
        std::test::assert(completed.code == 0 && std::str::contains(completed.stdout, "the redaction is in the record; the body erases it from memory on its next tick"), "a retry through the CLI leaves the erasure to the spine: " + completed.stdout + completed.stderr);
        // …and through the core, as the spine holds memory: it completes the
        // erasure of a redaction already recorded, then has nothing to erase
        let secret3 = "payroll line for employee 93: 4200.00";
        std::io::fs::write_file(scratch + "/p3.txt", secret3) or discard;
        let filed3 = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nfile\n" + scratch + "/p3.txt\n--class\nconfidential\n--as\nmara");
        std::test::assert_eq_int(filed3.code, 0, "filed: " + filed3.stdout + filed3.stderr);
        let p3 = dna::digest_of(secret3);
        self.core = dna::Dna {
            journal: dna::GitJournal { repo: app, author: "mara" },
            verification: dna::HaleVerification { receipts: dna::GitReceipts { repo: app }, repo: app },
            vault: dna::MemoryVault { repo: app, dsn_env: "", store: dna::PqProtected { conn: dna::pq_conn(dna::parse_dsn(spine_dsn)) } },
            planned: true, org_id: "retention"
        };
        let rec3 = self.core.journal.append(self.core.journal.revision(), "receipt.redacted", p3, "{\"by\": \"mara\", \"why\": \"left the company\", \"policy\": \"gdpr-erasure\", \"class\": \"confidential\", \"store\": \"memory\"}");
        std::test::assert(rec3.ok, "the interrupted redaction's row: " + rec3.error);
        std::test::assert_eq_str(self.core.redact_evidence(p3, "mara", "left the company", "gdpr-erasure"), "", "a retry through the core completes the erasure");
        std::test::assert_eq_str(self.kept(record, p3), "0", "and memory keeps nothing under it");
        std::test::assert(std::str::contains(self.core.redact_evidence(p3, "mara", "left the company", "gdpr-erasure"), "already redacted"), "and then nothing is left to erase");
        std::test::assert_eq_int(self.rows_of(app, "receipt.redacted", p3), 1, "one redaction in the record");
        let spine2 = start_spine(app, owner);
        std::test::assert(self.kept_becomes(record, p2, "0", 300), "the spine's next tick completes the recorded redaction: " + self.kept(record, p2) + " kept; " + (std::io::fs::read_file(app + "/.hale/dev.log") or ""));
        let twice = as_head(app, head_dsn, toolchain() + "\ndna\nreceipt\nredact\n" + p2 + "\n--why\nleft the company\n--policy\ngdpr-erasure\n--as\nmara");
        std::test::assert(twice.code == 0 && std::str::contains(twice.stdout, "the redaction is in the record"), "and then redacting again records nothing new: " + twice.stdout + twice.stderr);
        std::test::assert_eq_int(self.rows_of(app, "receipt.redacted", p2), 1, "one redaction in the record");

        // ---- a redacted knowledge receipt does not stop the spine's projection
        let proposed = self.core.propose_knowledge(dna::Idea { id: "k1", kind: "practice", text: "keep supplier notes a month", author: "org" }, "org");
        std::test::assert(std::str::starts_with(proposed, "sha256:"), "a knowledge proposal: " + proposed);
        std::test::assert_eq_str(self.core.redact_evidence(proposed, "mara", "superseded", "retention:30d"), "", "its receipt redacted");
        let at = dna::GitJournal { repo: app }.revision();
        let projected = self.projected_to(record, at, 300);
        std::test::assert(projected >= at, "the spine still projects the record past the redaction: at " + to_string(projected) + " of " + to_string(at) + "; " + (std::io::fs::read_file(app + "/.hale/dev.log") or ""));

        stop_spine(app, spine2);
        self.owner_conn.conn.close();
        std::test::assert_eq_str(dna::unmigrate(owner, record), "", "this run's schema and roles dropped");
        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
