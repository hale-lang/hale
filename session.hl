// SessionStore — persists iris's per-workspace state to
// <workspace>/.iris/session.json so each run can resume where
// the prior one left off (per PLAN §5 Phase 7).
//
// v0 minimum: tracks the source pane's current path + line.
// Subscribes to SrcOpenCmd (the upstream signal that has both
// fields; SourceChanged drops line) and writes the session
// JSON on each open. Iris.birth() calls try_restore() to
// re-emit a SrcOpenCmd if a saved session exists — that
// triggers the normal open path, so SourcePane updates and
// VizPane / scenes react identically to a fresh open.
//
// `--no-restore` flag skips the restore step but doesn't
// disable the save side; new state still persists for the
// next run.

locus SessionStore {
    params {
        session_path: String = ".iris/session.json";
        current_source_path: String = "";
        current_source_line: Int    = 0;
    }

    bus {
        subscribe SrcOpenCmd as on_open;
        publish   SrcOpenCmd;
    }

    fn on_open(o: SourceOpen) {
        // Mirror the most recent open into our tracked state.
        self.current_source_path = o.path;
        self.current_source_line = o.line;
        self.save();
    }

    fn save() {
        // DEBUG bisect: mkdir + write_file with dynamic content
        if len(self.current_source_path) == 0 { return; }
        std::io::fs::mkdir(".iris") or discard;
        let json = self.build_json();
        std::io::fs::write_file(self.session_path, json) or discard;
    }

    fn try_restore() {
        if !std::io::fs::file_exists(self.session_path) { return; }
        let content = std::io::fs::read_file(self.session_path) or empty_string();
        if len(content) == 0 { return; }
        let source = std::json::find_field_raw(content, "source");
        if len(source) == 0 { return; }
        let path = std::json::find_string_field(source, "path");
        if len(path) == 0 { return; }
        let line = std::json::find_int_field(source, "line");
        // Re-emit as a SrcOpenCmd. SourcePane subscribes; the
        // open propagates as if the user had just opened the
        // file. SessionStore's own on_open fires too (writes
        // the same state back; idempotent).
        SrcOpenCmd <- SourceOpen { path: path, line: line };
    }

    // ---- Internals.

    fn build_json() -> String {
        let b = std::str::builder_new();
        std::str::builder_append(b, "{\"source\":{\"path\":\"");
        std::str::builder_append(b, std::json::escape_string(self.current_source_path));
        std::str::builder_append(b, "\",\"line\":");
        std::str::builder_append(b, to_string(self.current_source_line));
        std::str::builder_append(b, "}}");
        return std::str::builder_finish(b);
    }

    // ---- Inspection (test-time).

    fn snapshot_path() -> String { return self.current_source_path; }
    fn snapshot_line() -> Int    { return self.current_source_line; }
}

fn empty_string() -> String {
    return "";
}
