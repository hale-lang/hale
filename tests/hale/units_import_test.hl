// GH #1076: an imported seed's quantity, point, identity and range
// convert into through the import's path, `u::T(x)`, as a declaration
// of the program's own does (spec/units.md § Conversions). The cast
// checked as an unresolved path and the build refused it in expression
// position; with no narrowing for its `or` to discharge, `or half_even`
// after it was refused as an unknown name (downstream handoff).
import "./units_import_lib" as u;

fn main() {
    // A point from a quantity literal: the point that far from its origin.
    let room = u::Celsius(25K);
    std::test::assert(room == u::Celsius(25_000mK), "25 K above the origin");
    std::test::assert_eq_str(to_string(room), "25000", "a point prints its count");
    let t0 = u::Instant(0monotonic_ns);
    std::test::assert_eq_str(to_string(t0), "0", "the origin");
    let later = t0 + 5monotonic_ns;
    std::test::assert(later - t0 == 5monotonic_ns, "a point moves by a quantity");

    // A rounding policy after the imported cast discharges its narrowing.
    let distance = 1500mm;
    let rounded = u::Metres(distance) or half_even;
    std::test::assert_eq_str(to_string(rounded), "2m", "1.5 m rounds half to even: 2");
    let down = u::Metres(distance) or floor;
    std::test::assert(down == 1m, "or floor");
    let whole = u::Metres(distance) or 0m;
    std::test::assert(whole == 0m, "no whole number of metres: the substitute");
    let exact = u::Metres(2000mm);
    std::test::assert(exact == 2m, "a literal's cast is exact at compile time");

    // A range's narrowing through the import, and its `Int`.
    let sess = u::Session(70) or 0;
    std::test::assert_eq_int(Int(sess), 0, "70 is outside 0..64: the substitute");
    let top = u::Session(70) or clamp;
    std::test::assert_eq_int(Int(top), 63, "clamped to the last value");
}
