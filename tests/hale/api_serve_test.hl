// GH #1137, retargeted in R4 (GH #1417) — an imported seed's handlers are
// a surface the app serves, and nothing it merely holds.
//
// spec/api.md § Serving: an imported seed's `@rpc` handlers are the default
// surface its import alias names; the app serves that surface with
// `api::serve(lib, …, receivers: { lib::Handlers: self.handlers })`, and a
// locus of the library the app holds but no row names is on no surface.
// The structural binding put an imported locus on the surface with its
// serve clause; a served surface is named by its rows, and its
// receivers are the instances the serve site binds. The fixture builds a
// library seed with two loci — `Handlers`, whose `@rpc` handler answers a
// command, and `Internal`, which has none — and an app that holds both as
// params and serves the library's surface. The served locus's handler
// answers through the socket; the held-but-unserved locus is no member;
// `hale check --api` shows exactly the rows; and a receiver bound to a
// name that is no param of main is refused.

fn lib_source() -> String {
    return "type Order { id: Int; }\n"
        + "type Taken { id: Int; by: String; }\n"
        + "type Tick { n: Int; }\n"
        + "role clerk;\n"
        + "locus Handlers {\n"
        + "    @rpc(requires: [clerk])\n"
        + "    fn on_order(o: Order, ctx: std::api::Context) -> Taken { return Taken { id: o.id, by: ctx.caller.name }; }\n"
        + "}\n"
        + "locus Internal {\n"
        + "    fn on_tick(t: Tick) -> Tick { return t; }\n"
        + "}\n";
}

fn app_source(sock: String, me: String, receivers: String) -> String {
    return app_with("handlers: lib::Handlers = lib::Handlers { }; core: lib::Internal = lib::Internal { };", sock, me, receivers);
}

fn app_with(held: String, sock: String, me: String, receivers: String) -> String {
    return "import \"../lib\" as lib;\n"
        + "locus Table {\n"
        + "    fn holds(p: std::api::Principal, r: String) -> Bool { return p.name == \"uid:" + me + "\"; }\n"
        + "}\n"
        + "main locus App {\n"
        + "    params { " + held + " }\n"
        + "    run() {\n"
        + "        let h = api::serve(lib, unix::Rpc { path: \"" + sock + "\", roles: Table { } }, as: \"lib\"" + receivers + ", bound: 8, on_full: refuse);\n"
        + "        std::time::sleep(8s);\n"
        + "        h.stop();\n"
        + "    }\n"
        + "}\n"
        + "fn main() { App { }; }\n";
}

locus Proc {
    params { child: std::process::Child = std::process::Child { }; }
    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }
    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 { return; }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
    }
    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 { return false; }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }
    fn ask(line: String) -> String {
        self.stream.send(line + "\n") or discard;
        let mut i = 0;
        while i < 25 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let got = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return got;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 { i = i + 1; } else { self.buf = self.buf + chunk; }
        }
        return "";
    }
}

fn run_tool(argv: String) -> std::process::ProcessOutput {
    return std::process::run(argv) or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let me = std::str::trim(run_tool("id\n-u").stdout);
    let root = "/tmp/hale-1137-serve-" + to_string(std::process::pid());
    let sock = root + "/app.sock";
    std::io::fs::mkdir(root) or discard;
    std::io::fs::mkdir(root + "/lib") or discard;
    std::io::fs::mkdir(root + "/app") or discard;
    std::io::fs::write_file(root + "/lib/lib.hl", lib_source()) or discard;

    // ---- a receiver bound to a locus no row names is refused, located
    std::io::fs::write_file(root + "/app/main.hl", app_source(sock, me, ", receivers: { Nobody: self.handlers }")) or discard;
    let wrong = run_tool(hale + "\ncheck\n" + root + "/app");
    std::test::assert(wrong.code != 0 && std::str::contains(wrong.stderr, "binds `Nobody`, which no row of `lib` names"), "a receiver must be a locus the surface's rows name: " + wrong.stderr);

    // ---- a served type held twice, with no receiver chosen, would answer for both: refused
    std::io::fs::write_file(root + "/app/main.hl", app_with("handlers: lib::Handlers = lib::Handlers { }; spare: lib::Handlers = lib::Handlers { };", sock, me, "")) or discard;
    let twice = run_tool(hale + "\ncheck\n" + root + "/app");
    std::test::assert(twice.code != 0 && std::str::contains(twice.stderr, "Handlers"), "a served type held twice names no receiver: " + twice.stderr);

    // ---- holding the library's other locus serves nothing of it
    std::io::fs::write_file(root + "/app/main.hl", app_source(sock, me, "")) or discard;
    let served = run_tool(hale + "\ncheck\n--api\n" + root + "/app");
    std::test::assert_eq_int(served.code, 0, "the app checks: " + served.stderr);
    std::test::assert(std::str::contains(served.stdout, "lib::Handlers::on_order") && std::str::contains(served.stdout, "\"clerk\""), "the served locus's gated handler is on the surface: " + served.stdout);
    std::test::assert(!std::str::contains(served.stdout, "Internal") && !std::str::contains(served.stdout, "on_tick"), "the held, unserved locus is not: " + served.stdout);

    let built = run_tool(hale + "\nbuild\n" + root + "/app");
    std::test::assert_eq_int(built.code, 0, "and builds: " + built.stderr);
    let p = Proc { };
    std::test::assert(p.start(root + "/app/app"), "the app started");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);
    let r = api.ask("{\"call\":\"lib::Handlers::on_order\",\"payload\":{\"id\":7},\"id\":\"c-1\"}");
    std::test::assert(std::str::contains(r, "\"ok\":true") && std::str::contains(r, "\"id\":7") && std::str::contains(r, "\"by\":\"uid:" + me + "\""), "the imported handler answers through the socket, gated: " + r);
    let t = api.ask("{\"call\":\"lib::Internal::on_tick\",\"payload\":{\"n\":1},\"id\":\"c-2\"}");
    std::test::assert(std::str::contains(t, "\"kind\":\"malformed\"") && std::str::contains(t, "unknown_member"), "the internal locus is no member of the surface: " + t);
    p.stop();
    std::io::fs::unlink(sock) or discard;
    let _rm = run_tool("rm\n-rf\n" + root);
}
