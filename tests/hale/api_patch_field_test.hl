// tests/hale/api_patch_field_test.hl — the three-way field of a PATCH
// (spec/api.md § Codecs): a presence triple, `x` beside `has_x: Bool` and
// `clear_x: Bool`. A payload that leaves `x` out keeps it (both flags
// false), one that sends `null` clears it (`clear_x`), and one that sends a
// value sets it (`has_x`). The encoder writes each back as it came: no key,
// `null`, or the value. A key sent twice is its last occurrence, as for any
// field. A presence pair without the clear flag reads `null` as absent, as
// it always did. A scalar, a record and an enum field, through the
// program's own codec.

type Inner { a: Int; }
type Mood = enum { Calm, Busy };
type Patch {
    note: String = "";
    has_note: Bool = false;
    clear_note: Bool = false;
    inner: Inner = Inner { a: 0 };
    has_inner: Bool = false;
    clear_inner: Bool = false;
    mood: Mood = Mood::Calm;
    has_mood: Bool = false;
    clear_mood: Bool = false;
}
type Plain { note: String = ""; has_note: Bool = false; }

fn read(text: String) -> Patch {
    let p = Patch::api_decode(text) or {
        std::test::assert(false, text + ": " + err.kind + " " + err.field);
        return Patch { };
    };
    return p;
}

fn which(has: Bool, clear: Bool) -> String {
    if has && clear { return "both"; }
    if has { return "set"; }
    if clear { return "clear"; }
    return "keep";
}

fn main() {
    let keep = read("{}");
    std::test::assert_eq_str(which(keep.has_note, keep.clear_note), "keep", "absent keeps");
    std::test::assert_eq_str(Patch::api_encode(keep), "{}", "absent is no key");

    let clear = read("{\"note\":null,\"inner\":null,\"mood\":null}");
    std::test::assert_eq_str(which(clear.has_note, clear.clear_note), "clear", "null clears a scalar");
    std::test::assert_eq_str(which(clear.has_inner, clear.clear_inner), "clear", "null clears a record");
    std::test::assert_eq_str(which(clear.has_mood, clear.clear_mood), "clear", "null clears an enum");
    std::test::assert_eq_str(Patch::api_encode(clear), "{\"note\":null,\"inner\":null,\"mood\":null}", "a cleared field is null");

    let set = read("{\"note\":\"x\",\"inner\":{\"a\":3},\"mood\":\"Busy\"}");
    std::test::assert_eq_str(which(set.has_note, set.clear_note), "set", "a value sets");
    std::test::assert_eq_str(set.note, "x", "the value");
    std::test::assert_eq_int(set.inner.a, 3, "a record's value");
    std::test::assert_eq_str(Patch::api_encode(set), "{\"note\":\"x\",\"inner\":{\"a\":3},\"mood\":\"Busy\"}", "a set field is its value");

    // the last of a key sent twice
    let then_set = read("{\"note\":null,\"note\":\"y\"}");
    std::test::assert_eq_str(which(then_set.has_note, then_set.clear_note), "set", "null, then a value");
    let then_clear = read("{\"note\":\"y\",\"note\":null}");
    std::test::assert_eq_str(which(then_clear.has_note, then_clear.clear_note), "clear", "a value, then null");
    std::test::assert_eq_str(then_clear.note, "", "a cleared field holds its default");

    // set and clear both: written as set
    let both = Patch { note: "z", has_note: true, clear_note: true };
    std::test::assert_eq_str(Patch::api_encode(both), "{\"note\":\"z\"}", "a value wins over clear");

    // a presence pair: null is absent
    let plain = Plain::api_decode("{\"note\":null}") or {
        std::test::assert(false, "a pair's null: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert(!plain.has_note, "a pair's null is absent");
    std::test::assert_eq_str(Plain::api_encode(plain), "{}", "and is written as no key");
}
