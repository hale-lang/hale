// A block's trailing `match` (its last item, no `;`) is the block's
// value where the block is used as one (spec/semantics.md, `match` is
// dual-position): a match arm's block, an `if` expression's arm, a
// `let`'s block. Until 2026-11-06 the check passed these and the build
// refused them as a block with no trailing expression, where the same
// block ending in `if … else …` built (downstream handoff).

type Kind = enum { A, B };

fn pick(k: Kind, n: Int) -> String {
    let s = match k {
        Kind::A -> {
            let m = n + 1;
            match m {
                1 -> "one",
                _ -> "many",
            }
        },
        Kind::B -> "b",
    };
    return s;
}

fn nested(n: Int) -> Int {
    let v = {
        let m = n * 2;
        match m {
            0 -> 0,
            _ -> {
                let half = m / 2;
                match half {
                    1 -> 10,
                    _ -> 20,
                }
            },
        }
    };
    return v;
}

fn arm_of_if(flag: Bool, n: Int) -> String {
    let s = if flag {
        let m = n;
        match m {
            0 -> "zero",
            _ -> "some",
        }
    } else {
        "off"
    };
    return s;
}

fn early(n: Int) -> String {
    let s = match n {
        0 -> {
            let m = n + 7;
            match m {
                7 -> "seven",
                _ -> "other",
            }
        },
        _ -> {
            return "early";
        },
    };
    return s;
}

fn choose(n: Int) -> Int {
    let x = match n {
        0 -> {
            match n {
                0 -> {
                    return 1;
                },
                _ -> {
                    return 2;
                },
            }
        },
        _ -> 3,
    };
    return x;
}

fn choose_block(n: Int) -> Int {
    let x = {
        match n {
            0 -> {
                return 1;
            },
            _ -> {
                return 2;
            },
        }
    };
    return x;
}

type Rec {
    name: String = "";
}

fn twice(n: Int) -> Int {
    return n * 2;
}

fn shout(s: String) -> String {
    return s + "!";
}

fn size(b: Bytes) -> Int {
    return len(b);
}

fn int_arg(n: Int) -> Int {
    let x = twice({
        match n {
            0 -> {
                return 1;
            },
            _ -> {
                return 2;
            },
        }
    });
    return x;
}

fn string_arg(n: Int) -> String {
    let x = shout({
        match n {
            0 -> {
                return "a";
            },
            _ -> {
                return "b";
            },
        }
    });
    return x;
}

fn bytes_arg(n: Int) -> Int {
    let x = size({
        match n {
            0 -> {
                return 11;
            },
            _ -> {
                return 12;
            },
        }
    });
    return x;
}

fn string_return(n: Int) -> String {
    return {
        match n {
            0 -> {
                return "c";
            },
            _ -> {
                return "d";
            },
        }
    };
}

fn string_assign(n: Int) -> String {
    let mut s = "";
    s = {
        match n {
            0 -> {
                return "e";
            },
            _ -> {
                return "f";
            },
        }
    };
    return s;
}

fn string_field(n: Int) -> String {
    let r = Rec {
        name: {
            match n {
                0 -> {
                    return "g";
                },
                _ -> {
                    return "h";
                },
            }
        },
    };
    return r.name;
}

fn bool_cond(n: Int) -> Int {
    if {
        match n {
            0 -> {
                return 21;
            },
            _ -> {
                return 22;
            },
        }
    } {
        return 0;
    }
    return 1;
}

fn main() {
    std::test::assert_eq_int(int_arg(0), 1, "a diverging block as an Int argument");
    std::test::assert_eq_int(int_arg(1), 2, "its other arm");
    std::test::assert_eq_str(string_arg(0), "a", "a diverging block as a String argument");
    std::test::assert_eq_str(string_arg(1), "b", "its other arm");
    std::test::assert_eq_int(bytes_arg(0), 11, "a diverging block as a Bytes argument");
    std::test::assert_eq_str(string_return(1), "d", "a diverging block as a String return");
    std::test::assert_eq_str(string_assign(0), "e", "a diverging block as a String assignment");
    std::test::assert_eq_str(string_field(1), "h", "a diverging block as a String record field");
    std::test::assert_eq_int(bool_cond(0), 21, "a diverging block as a Bool condition");
    std::test::assert_eq_int(bool_cond(3), 22, "its other arm");
    std::test::assert_eq_int(
        choose_block(0),
        1,
        "a let block whose trailing match diverges in every arm",
    );
    std::test::assert_eq_int(choose_block(4), 2, "its other arm");
    std::test::assert_eq_int(
        choose(0),
        1,
        "an arm block whose trailing match diverges in every arm",
    );
    std::test::assert_eq_int(choose(5), 3, "the open arm beside it");
    std::test::assert_eq_str(pick(Kind::A, 0), "one", "an arm block ending in a match");
    std::test::assert_eq_str(pick(Kind::A, 5), "many", "the other inner arm");
    std::test::assert_eq_str(pick(Kind::B, 0), "b", "the expression arm beside it");
    std::test::assert_eq_int(nested(0), 0, "a let block ending in a match");
    std::test::assert_eq_int(nested(1), 10, "a match nested two blocks deep");
    std::test::assert_eq_int(nested(3), 20, "its other arm");
    std::test::assert_eq_str(
        arm_of_if(true, 0),
        "zero",
        "an if expression's arm ending in a match",
    );
    std::test::assert_eq_str(arm_of_if(true, 2), "some", "its other inner arm");
    std::test::assert_eq_str(arm_of_if(false, 0), "off", "the else arm");
    std::test::assert_eq_str(early(0), "seven", "a trailing match beside a diverging arm");
    std::test::assert_eq_str(early(1), "early", "the diverging arm returns");
}
