// A record field default may read the scope of the literal that leaves it
// (here `a`, a local of `main`): the codec cannot build such a default on
// its own, so the field is required on the wire, and a payload that carries
// it decodes as sent. A program like this one built before codecs filled
// defaults in, and builds and round-trips now.

type R { b: Int = a + 1; }
// a record literal default that leaves out such a field carries its
// default along: the codec cannot build it either, so `inner` is required
type Inner { b: Int = a + 1; }
type Outer { inner: Inner = Inner { }; }

fn main() {
    let a = 2;
    let original = R { };
    std::test::assert_eq_int(original.b, 3, "the literal's default, in the literal's scope");
    let back = R::api_decode("{\"b\":4}") or original;
    std::test::assert_eq_int(back.b, 4, "the value the payload carries");
    let absent = R::api_decode("{}") or R { b: -1 };
    std::test::assert_eq_int(absent.b, -1, "an absent field the codec cannot build is refused");
    let again = R::api_decode(R::api_encode(back)) or original;
    std::test::assert_eq_int(again.b, 4, "the round trip");

    let o = Outer { };
    std::test::assert_eq_int(o.inner.b, 3, "the nested default, in the literal's scope");
    let o_back = Outer::api_decode("{\"inner\":{\"b\":5}}") or o;
    std::test::assert_eq_int(o_back.inner.b, 5, "a nested record sent");
    let o_absent = Outer::api_decode("{}") or Outer { inner: Inner { b: -1 } };
    std::test::assert_eq_int(o_absent.inner.b, -1, "an absent field whose literal default leaves an open one is refused");
}
