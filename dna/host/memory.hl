// Memory's schema, applied by its owner (GH #985).
//
// `hale dna memory migrate` (and `upgrade`, and `dev` before it starts
// the organism) runs `memory-migrate`: the schema owner's DSN from
// HALE_DNA_KNOWLEDGE_DSN, or from dna/compose.yaml brought up, applies
// the record's schema and prints the spine's DSN. The host that runs the
// organism never holds the owner's DSN: it is handed the spine's and
// checks the schema version before it starts anything on it.

import "../knowledge" as know;

// `memory-migrate`: `HALE_DNA_MEMORY_DSN_SPINE=<dsn>` when the schema was
// applied, `memory` for the in-memory store, `none: <why>` when there is
// no database to apply it to.
fn memory_migrate_verb(root: String) -> Answer {
    let given = if std::env::var_exists("HALE_DNA_KNOWLEDGE_DSN") { std::env::var("HALE_DNA_KNOWLEDGE_DSN") } else { "" };
    if given == "memory" { return answer("memory\n"); }
    let mut owner = given;
    if len(owner) == 0 {
        let infra = ReferenceInfrastructure { root: root };
        let db = infra.knowledge_database(root);
        if !db.present { return answer("none: " + db.why + "\n"); }
        owner = db.dsn;
    }
    let m = know::migrate(know::parse_dsn(owner), record_identity(root));
    if !m.ok { return fail("memory migrate: " + m.why); }
    return answer("HALE_DNA_MEMORY_DSN_SPINE=" + m.spine_dsn + "\n");
}

// "" when the spine's DSN reaches a schema at this toolchain's version;
// otherwise why the host refuses to start the knowledge service on it.
fn memory_fence_for(spine: String, root: String) -> String {
    let d = know::parse_dsn(spine);
    if !d.ok { return "HALE_DNA_MEMORY_DSN_SPINE: " + d.why; }
    let c = know::pq_conn(d);
    let st = c.open();
    if !st.ok { return "memory: " + st.err.kind + " " + st.err.detail; }
    let why = know::memory_fence(c, know::schema_for(record_identity(root)));
    c.close();
    return why;
}
