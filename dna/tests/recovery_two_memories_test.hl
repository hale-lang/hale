// dna/tests/recovery_two_memories_test.hl — recovery between the two
// memories (GH #646 stage 4, #653).
//
// The restart scans an organism runs — a task born and stopped before
// its plan is planned now; one whose Mutation was in flight settles
// failed with it; a handed task waits for its person; an ask's birth
// precedes its plan — were written over one journal. An adopted
// organism reads its record and its ledger as one journal, so the same
// scans hold with the day's work in the ledger and the mutation's
// outcome in the record: no transaction spans the two, and none is
// needed. The ledger here is in memory; the record is a real git
// journal; the adoption is the copy `hale dna ledger adopt` makes.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn sh(argv: String) -> dna::RunResult { return dna::run_tool(argv); }

const PLAN: String = "{\"kind\": \"appendage\", \"change_class\": \"docs\", \"class_applied\": \"docs\", \"target\": \"main.hl\", \"assignee\": \"\", \"obligation\": \"\", \"count\": 1, \"narrative\": \"planned before the restart\"}";
const APP: String = "fn main() { println(\"app\"); }\n";
const DOCUMENTED: String = "// documented after a restart\nfn main() { println(\"app\"); }\n";

main locus App {
    params {
        repo: String = "";
        record: dna::GitJournal = dna::GitJournal { };
        ledger: dna::MemJournal = dna::MemJournal { };
        one: dna::Dna = dna::Dna { };
        // the leader plans for the organism named `rw`, over the bus
        lead: dna::Leader = dna::Leader {
            name: "leader", org: "rw", charter: "You are the architect.",
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answer: "kind: appendage\nclass: docs\ntarget: main.hl\ncount: 1\nplanned after the restart" },
                deep: dna::FakeModel { name: "deep", answer: "kind: appendage\nclass: docs\ntarget: main.hl\ncount: 1\nplanned after the restart" }
            }
        };
    }
    @unbounded
    fn rows(kind: String, entity: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && (len(entity) == 0 || e.entity == entity) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn body_of(kind: String, entity: String) -> String {
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && e.entity == entity { return e.body; }
            i = i + 1;
        }
        return "";
    }
    @unbounded
    fn seq_of(kind: String, entity: String) -> Int {
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && e.entity == entity { return e.seq; }
            i = i + 1;
        }
        return -1;
    }
    // The pre-split organism wrote every row into the record.
    fn put(kind: String, entity: String, body: String) {
        let r = self.record.append(self.record.revision(), kind, entity, body);
        std::test::assert(r.ok, "seeded " + kind + " " + entity);
    }
    // Adoption, as the service does it: every operational row copied to
    // the ledger in order; the record's copies are history git keeps.
    @unbounded
    fn adopt() -> Int {
        let mut copied = 0;
        let mut i = 0;
        while i < self.record.revision() {
            let e = self.record.read(i);
            if dna::memory_of(e.kind) == "ledger" {
                let c = self.ledger.append(self.ledger.revision(), e.kind, e.entity, e.body);
                std::test::assert(c.ok, "copied " + e.kind + " " + e.entity);
                copied = copied + 1;
            }
            i = i + 1;
        }
        self.put("ledger.adopted", "ledger", "{\"routing\": 1, \"checkpoint\": \"" + self.record.head() + "\", \"rows\": " + to_string(copied) + "}");
        return copied;
    }
    run() {
        let repo = "/tmp/dna-recovery-two-" + to_string(std::process::pid());
        let mk = sh("sh\n-c\nrm -rf \"$1\" && mkdir -p \"$1/app\" \"$1/org\" && cd \"$1\" && git init -q -b main && git config user.name t && git config user.email t@dna\nsh\n" + repo);
        std::test::assert(mk.code == 0, "a repository");
        std::io::fs::write_file(repo + "/app/main.hl", APP) or discard;
        std::io::fs::write_file(repo + "/org/main.hl", "fn main() { }\n") or discard;
        let c = sh("sh\n-c\ncd \"$1\" && git add -A && git commit -q -m genome\nsh\n" + repo);
        std::test::assert(c.code == 0, "the genome");
        self.repo = repo;
        self.record = dna::GitJournal { repo: repo };

        // ---- the pre-split record: work the organism left unfinished
        // t1: born, planned, stopped before its Mutation
        self.put("intent.offered", "i1", "a first");
        self.put("task.born", "t1", "i1: a first");
        self.put("task.pending", "t1", "");
        self.put("task.planned", "t1", PLAN);
        // t2: born, pending, never planned
        self.put("intent.offered", "i2", "a second");
        self.put("task.born", "t2", "i2: a second");
        self.put("task.pending", "t2", "");
        // t3: its Mutation was in flight (proposed, no outcome) when the organism stopped
        self.put("intent.offered", "i3", "a third");
        self.put("task.born", "t3", "i3: a third");
        self.put("task.pending", "t3", "");
        self.put("task.planned", "t3", PLAN);
        self.put("mutation.proposed", "m1", "task t3 docs: a third () at 0000000000000000000000000000000000000000");
        // t4: handed to a person
        self.put("intent.offered", "i4", "a fourth");
        self.put("task.born", "t4", "i4: a fourth");
        self.put("task.pending", "t4", "");
        self.put("task.handed", "t4", "{\"work\": \"a fourth\", \"assignee\": \"sam\", \"by\": \"dna\"}");
        let copied = self.adopt();
        std::test::assert(copied >= 14, "the operational rows are copied: " + to_string(copied));
        std::test::assert_eq_int(self.ledger.revision(), copied, "into the ledger");
        std::test::assert_eq_int(dna::routing_of(self.record), 1, "the record says routing 1");

        // ---- one organism is born over both memories, read as one
        self.one = dna::Dna {
            journal: dna::RoutedJournal { record: dna::GitJournal { repo: repo }, ledger: self.ledger },
            gateway: dna::MutationGateway {
                workspaces: dna::IsolatedWorktrees { repo: repo, root: repo + "/.hale/dna/worktrees" },
                repo: dna::LocalGit { repo: repo }
            },
            verification: dna::HaleVerification { hale_bin: toolchain(), receipts: dna::GitReceipts { repo: repo }, scratch: repo + "/.hale/dna/scratch", repo: repo },
            editor: dna::SourceEditor {
                models: dna::ModelRouter {
                    quick: dna::FakeModel { name: "quick", answer: DOCUMENTED, answer_role: "edit" },
                    deep: dna::FakeModel { name: "deep", answer: "clarity +" }
                },
                tools: dna::WorktreeTools { hale_bin: toolchain() }
            },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs refactor", max_magnitude: 8, review: "pre" } },
            genome_seed: "app", org_seed: "org", planned: true, org_id: "rw"
        };
        std::time::sleep(2500ms);

        // the scans read the ledger's rows: the same outcomes as over one journal
        std::test::assert(std::str::contains(self.body_of("task.resumed", "t1"), "not replanned"), "t1 resumed under the plan in the ledger: " + self.body_of("task.resumed", "t1"));
        std::test::assert_eq_int(self.rows("task.planned", "t1"), 1, "one plan for t1, the one copied");
        std::test::assert_eq_int(self.rows("model.called", "t1/plan"), 0, "t1 was not planned again");
        std::test::assert(std::str::contains(self.body_of("task.resumed", "t2"), "planned now"), "t2 planned after the restart: " + self.body_of("task.resumed", "t2"));
        std::test::assert_eq_int(self.rows("mutation.failed", "m1"), 1, "m1, in flight when the organism stopped, failed — in the record");
        std::test::assert(std::str::contains(self.body_of("task.failed", "t3"), "in flight"), "and t3 settled failed on it — in the ledger: " + self.body_of("task.failed", "t3"));
        std::test::assert_eq_int(self.rows("task.resumed", "t4"), 0, "a handed Task is not the organism's to resume");
        std::test::assert_eq_str(self.one.task_state("t4"), "handed", "and is still handed to its person");
        std::test::assert_eq_int(self.rows("task.born", ""), 4, "no Task was born by the restart itself");
        // what landed where: outcomes of the day in the ledger, of the organism in the record
        std::test::assert(self.ledger.revision() > copied, "the restart's operational rows went to the ledger");
        let mut i = copied;
        let mut kinds = "";
        while i < self.ledger.revision() { kinds = kinds + self.ledger.read(i).kind + " "; i = i + 1; }
        std::test::assert(std::str::contains(kinds, "task.resumed") && std::str::contains(kinds, "task.failed"), "the ledger took the task rows: " + kinds);
        let mut r = 0;
        let mut record_kinds = "";
        let rec_now = dna::GitJournal { repo: repo };
        while r < rec_now.revision() { let e = rec_now.read(r); if e.kind == "mutation.failed" || e.kind == "task.failed" { record_kinds = record_kinds + e.kind + " "; } r = r + 1; }
        std::test::assert(std::str::contains(record_kinds, "mutation.failed") && !std::str::contains(record_kinds, "task.failed"), "the record took the mutation's outcome and none of the task's: " + record_kinds);

        // ---- a live ask: the birth is in the ledger before anything runs
        let t5 = self.one.ask(dna::Intent { id: "i5", outcome: "document main.hl once more", from: "riley" }, dna::Knobs { routed: true, requires: "edit" });
        std::time::sleep(2500ms);
        let born = self.seq_of("task.born", t5);
        let planned = self.seq_of("task.planned", t5);
        let mut about = "";
        let mut k = 0;
        while k < self.one.journal.revision() { let e = self.one.journal.read(k); if e.entity == t5 || std::str::starts_with(e.entity, t5 + "/") { about = about + e.kind + "@" + to_string(e.seq) + " "; } k = k + 1; }
        std::test::assert(born >= 0 && planned > born, "the birth precedes the plan, in the merged order: born " + to_string(born) + ", planned " + to_string(planned) + " for " + t5 + ": " + about);
        let rm = sh("rm\n-rf\n" + repo);
    }
}

fn main() { App { }; }
