// The limits reader against a head of the test's own (voice#8): what a
// read that lands holds, and what one that does not leaves standing. The
// head answers each practices read from a script: whole and chunked, cut
// short mid-chunk, read to the close, then a project made ambiguous and
// another left in a supersession cycle. The reader runs here on the test's
// thread, read by read (`refresh`), and the head on a thread of its own.
import ".." as api;

const VAULT_ENTRY: String = "voice-reader-test-secret";

/// One ratified limit practice, as the head lists it.
fn item(project: String, id: String, supersedes: String, requests: Int) -> String {
    return "{\"id\": \"" + id + "\", \"digest\": \"" + id + "\", \"name\": \"operating/limits/" + project + "\", \"kind\": \"practice\", \"state\": \"ratified\", \"supersedes\": \"" + supersedes + "\", \"text\": \"The limit for " + project + ".\\nwindow_seconds: 60\\nrequests: " + to_string(requests) + "\"}";
}

/// A page of practices: the last one.
fn page(items: String) -> String {
    return "{\"api_version\": \"hale.v1\", \"data\": {\"items\": [" + items + "], \"page\": {\"limit\": 100, \"offset\": 0, \"total\": 2, \"next_offset\": -1, \"snapshot\": \"s1\"}}}";
}

/// `n` in hexadecimal.
@unbounded
fn hex(n: Int) -> String {
    let digits = "0123456789abcdef";
    if n < 16 { return digits[n..(n + 1)]; }
    return hex(n / 16) + digits[(n % 16)..(n % 16 + 1)];
}

/// `body` in chunks of at most 40 bytes, ended by the empty chunk.
@unbounded
fn chunked(body: String) -> String {
    let mut out = "";
    let mut i = 0;
    while i < len(body) {
        let end = if i + 40 < len(body) { i + 40 } else { len(body) };
        out = out + hex(end - i) + "\r\n" + body[i..end] + "\r\n";
        i = end;
    }
    return out + "0\r\n\r\n";
}

const HEAD: String = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\n";

/// The head: discovery and a token for anyone, and the practices from its
/// script, one answer per read, until the script is done.
locus FakeHead {
    params {
        fd: Int = -1;
        port: Int = 0;
        reads: Int = 0;
    }
    // an accept waits a second at most, and the head gives up after 30 s,
    // so a test that failed early does not wait on it for ever
    run() {
        std::io::tcp::__set_recv_timeout_ns(self.fd, 1000000000);
        let started = std::time::monotonic_ns();
        while self.reads < 5 && std::time::monotonic_ns() - started < 30000000000 {
            let conn = std::io::tcp::__accept_one(self.fd);
            if conn >= 0 { self.serve(conn); }
        }
    }

    /// One request, read whole (its body too, so the close is clean), and
    /// answered.
    @unbounded
    fn serve(conn: Int) {
        std::io::tcp::__set_recv_timeout_ns(conn, 2000000000);
        let s = std::io::tcp::Stream { conn_fd: conn, owns_fd: true };
        let mut got = "";
        let mut tries = 0;
        while api::head_end(got) < 0 && tries < 20 {
            let chunk = s.recv(65536) or "";
            if len(chunk) == 0 { tries = tries + 1; } else { got = got + chunk; }
        }
        let end = api::head_end(got);
        let length = std::str::parse_int(api::header_value(std::str::lower(got[0..end]), "content-length")) or 0;
        while len(got) - end - 4 < length && tries < 20 {
            let chunk = s.recv(65536) or "";
            if len(chunk) == 0 { tries = tries + 1; } else { got = got + chunk; }
        }
        let line = got[0..std::str::index_of(got, "\r\n")];
        if std::str::contains(line, "/.well-known/openid-configuration") {
            let body = "{\"token_endpoint\": \"http://127.0.0.1:" + to_string(self.port) + "/token\"}";
            s.send(HEAD + "Content-Length: " + to_string(len(body)) + "\r\n\r\n" + body) or discard;
            return;
        }
        if std::str::contains(line, "/token") {
            let body = "{\"access_token\": \"t-reader\", \"token_type\": \"Bearer\", \"expires_in\": 3600}";
            s.send(HEAD + "Content-Length: " + to_string(len(body)) + "\r\n\r\n" + body) or discard;
            return;
        }
        let n = self.reads;
        self.reads = self.reads + 1;
        if n == 0 {
            // whole, chunked
            s.send(HEAD + "Transfer-Encoding: chunked\r\n\r\n" + chunked(page(item("personal", "p1", "", 2) + ", " + item("other", "o1", "", 3)))) or discard;
        } else if n == 1 {
            // cut at 60%, mid-chunk, the peer gone
            let whole = chunked(page(item("personal", "p1", "", 2) + ", " + item("other", "o1", "", 3)));
            s.send(HEAD + "Transfer-Encoding: chunked\r\n\r\n" + whole[0..(len(whole) * 6 / 10)]) or discard;
        } else if n == 2 {
            // neither a length nor chunks: read to the close (and without
            // `other`, which a reader that took it would leave unlimited)
            s.send(HEAD + "\r\n" + page(item("personal", "p1", "", 2))) or discard;
        } else if n == 3 {
            // personal: two in force, both superseding p1; other superseded
            // plainly; fresh: two in force, and no limit held before
            let body = page(item("personal", "pa", "p1", 5) + ", " + item("personal", "pb", "p1", 6) + ", " + item("other", "o2", "o1", 4) + ", " + item("fresh", "fa", "", 1) + ", " + item("fresh", "fb", "", 1));
            s.send(HEAD + "Content-Length: " + to_string(len(body)) + "\r\n\r\n" + body) or discard;
        } else {
            // personal and fresh settled; other in a cycle
            let body = page(item("personal", "pc", "", 7) + ", " + item("other", "o3", "o4", 9) + ", " + item("other", "o4", "o3", 9) + ", " + item("fresh", "fc", "", 8));
            s.send(HEAD + "Content-Length: " + to_string(len(body)) + "\r\n\r\n" + body) or discard;
        }
    }
}

fn requests_of(held: api::HeldLimits, project: String) -> Int {
    let p = api::held_limit(held, project);
    if len(p.project) == 0 || p.closed { return -1; }
    return p.limit.requests;
}

main locus Reading {
    params {
        fd: Int = std::io::tcp::__listen_socket("127.0.0.1", 0);
        port: Int = std::io::tcp::__local_port(self.fd);
        head: FakeHead = FakeHead { fd: self.fd, port: self.port };
        held: api::HeldLimits = api::HeldLimits { };
    }
    placement { head: pinned; }

    run() {
        let entry = std::secret::vault_local_dir() + "/" + VAULT_ENTRY;
        std::io::fs::write_file(entry, "reader-secret") or discard;
        let url = "http://127.0.0.1:" + to_string(self.port);
        // built with no head, so its own schedule never starts; read by hand
        let g = api::Governance { application: "app-1", client: "voice-api", secret: std::secret::Credential { vault: VAULT_ENTRY }, within: 3s, held: self.held };
        g.head = url;
        g.issuer = url;

        g.refresh(std::time::monotonic_ns());
        std::test::assert(api::limits_landed(self.held) && requests_of(self.held, "personal") == 2 && requests_of(self.held, "other") == 3, "a whole chunked answer read: " + g.refused);
        std::test::assert(len(api::held_limit(self.held, "nobody").project) == 0, "a project with no practice is not limited");

        g.refresh(std::time::monotonic_ns());
        std::test::assert(std::str::contains(g.refused, "cut short"), "a cut chunked answer does not land: " + g.refused);
        std::test::assert(requests_of(self.held, "personal") == 2 && requests_of(self.held, "other") == 3, "and the limits read before stand");

        g.refresh(std::time::monotonic_ns());
        std::test::assert(std::str::contains(g.refused, "neither its length nor chunks"), "an answer read to the close does not land: " + g.refused);
        std::test::assert(requests_of(self.held, "other") == 3, "and other is not left unlimited");

        g.refresh(std::time::monotonic_ns());
        std::test::assert(len(g.refused) == 0, "a read with an ambiguous project lands: " + g.refused);
        std::test::assert(requests_of(self.held, "personal") == 2, "the ambiguous project keeps its last limit");
        std::test::assert(api::held_limit(self.held, "fresh").closed, "the one with no limit before is closed");
        std::test::assert(requests_of(self.held, "other") == 4, "every other project is read as it is");
        std::test::assert(std::str::contains(g.ambiguous, "personal") && std::str::contains(g.ambiguous, "fresh") && !std::str::contains(g.ambiguous, "other:"), "the ambiguous ones are named: " + g.ambiguous);

        g.refresh(std::time::monotonic_ns());
        std::test::assert(requests_of(self.held, "personal") == 7 && requests_of(self.held, "fresh") == 8, "settled, they are read again");
        std::test::assert(requests_of(self.held, "other") == 4, "a project in a supersession cycle keeps its last limit");
        std::test::assert(std::str::contains(g.ambiguous, "other: its ratified practices supersede each other in a cycle"), "and is named: " + g.ambiguous);

        std::io::fs::unlink(entry) or discard;
        std::io::tcp::close_fd(self.fd);
        std::process::exit(0);
    }
}

fn main() { Reading { }; }
