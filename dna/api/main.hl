// Build: hale build dna/api
// Run: dna/api/api <project-root> <port> [face-webroot]
// A single-Record surface, always loopback. Explicitly configured or composed
// command providers own native authority and durable recovery. No legacy
// UI mutation route is proxied.

import "../core" as dna;
import "../organization_source" as orgsource;
import "../operations" as ops;
import "../ui" as ui;

locus Wire {
    params { }
    fn practice(p: ops::PracticeRow) -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("id", p.id);
        b.string_field("digest", p.digest);
        b.string_field("name", p.name);
        b.string_field("kind", p.kind);
        b.field("text", dna::record_json_quote(p.text));
        b.string_field("text_status", p.text_status);
        b.bool_field("text_available", p.text_available);
        b.string_field("author", p.author);
        b.string_field("target", p.target);
        b.string_field("binding_class", p.binding_class);
        b.string_field("provenance", p.provenance);
        b.string_field("requester", p.requester);
        b.string_field("rationale", p.because);
        b.string_field("supersedes", p.supersedes);
        b.string_field("request_id", p.request_id);
        b.string_field("review_id", p.review_id);
        b.string_field("review_state", p.review_state);
        b.string_field("review_settled", p.review_settled);
        b.string_field("review_outcome", p.review_outcome);
        b.string_field("state", p.state);
        b.bool_field("ratified", p.ratified);
        b.bool_field("retired", p.retired);
        b.bool_field("declined", p.declined);
        b.end_object();
        return b.result();
    }
    fn review(r: ops::ReviewRow) -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("id", r.id);
        b.string_field("state", r.state);
        b.string_field("subject_digest", r.subject_digest);
        b.string_field("required_authority", r.required_authority);
        b.bool_field("is_mutation", r.is_mutation);
        b.string_field("approvers", r.approvers);
        b.string_field("settled", r.settled);
        b.string_field("outcome", r.outcome);
        b.string_field("knowledge_digest", r.knowledge_digest);
        if len(r.knowledge_binding_digest) > 0 || len(r.binding_request_id) > 0 {
            b.string_field("knowledge_binding_digest", r.knowledge_binding_digest);
            b.string_field("target", r.target); b.string_field("binding_class", r.binding_class);
        }
        if len(r.knowledge_edge_digest) > 0 || len(r.edge_request_id) > 0 { b.string_field("knowledge_edge_digest", r.knowledge_edge_digest); }
        if !r.organization_source && (len(r.knowledge_binding_digest) > 0 || len(r.binding_request_id) > 0 || len(r.knowledge_edge_digest) > 0 || len(r.edge_request_id) > 0) { b.string_field("author", r.author); }
        if r.organization_source {
            b.bool_field("organization_source", true); b.string_field("organization_source_request_id", r.organization_source_request_id); b.string_field("organization_source_digest", r.organization_source_digest); b.string_field("author", r.author);
        }
        b.string_field("text_status", r.text_status);
        b.bool_field("text_available", r.text_available);
        // For an ordinary Review the question is declared in Record itself;
        // no canonical practice receipt is involved. Restricted subjects have
        // already received a different status from the shared query layer.
        b.field("question", dna::record_json_quote(if r.text_available || r.text_status == "not_applicable" { r.question } else { "" }));
        b.end_object();
        return b.result();
    }
    fn applications(source: Source) -> String {
        let http = Http { };
        let b = std::json::Builder { };
        b.begin_object();
        b.begin_array_field("items");
        b.begin_object();
        b.string_field("id", source.identity);
        b.string_field("kind", "dna");
        b.string_field("name", source.name);
        b.string_field("capabilities_url", API_PREFIX + "/" + source.identity + "/capabilities");
        b.end_object();
        b.end_array();
        b.field("page", http.page(1, 0, 1, source.head));
        b.end_object();
        return b.result();
    }
    fn capabilities(source: Source, mode: String, name: String, organization: Bool, definitions: Bool, knowledge: Bool, commands: Bool, capability: CommandCapability, review_commands: Bool, review_capability: CommandCapability, command_origin: String, knowledge_write: Bool) -> String {
        return self.capabilities_with_source(source, mode, name, organization, definitions, knowledge, commands, capability, review_commands, review_capability, command_origin, knowledge_write, OrganizationCommandCapabilities { });
    }
    fn capabilities_with_source(source: Source, mode: String, name: String, organization: Bool, definitions: Bool, knowledge: Bool, commands: Bool, capability: CommandCapability, review_commands: Bool, review_capability: CommandCapability, command_origin: String, knowledge_write: Bool, source_commands: OrganizationCommandCapabilities) -> String {
        return self.capabilities_with_tasks(source, mode, name, organization, definitions, knowledge, commands, capability, review_commands, review_capability, command_origin, knowledge_write, source_commands, false, CommandCapability { });
    }
    fn capabilities_with_tasks(source: Source, mode: String, name: String, organization: Bool, definitions: Bool, knowledge: Bool, commands: Bool, capability: CommandCapability, review_commands: Bool, review_capability: CommandCapability, command_origin: String, knowledge_write: Bool, source_commands: OrganizationCommandCapabilities, tasks: Bool, task_capability: CommandCapability) -> String {
        return self.capabilities_with_people(source, mode, name, organization, definitions, knowledge, commands, capability, review_commands, review_capability, command_origin, knowledge_write, source_commands, tasks, task_capability, false, CommandCapability { });
    }
    fn capabilities_with_people(source: Source, mode: String, name: String, organization: Bool, definitions: Bool, knowledge: Bool, commands: Bool, capability: CommandCapability, review_commands: Bool, review_capability: CommandCapability, command_origin: String, knowledge_write: Bool, source_commands: OrganizationCommandCapabilities, tasks: Bool, task_capability: CommandCapability, people: Bool, person_capability: CommandCapability) -> String {
        return self.capabilities_with_task_create(source, mode, name, organization, definitions, knowledge, commands, capability, review_commands, review_capability, command_origin, knowledge_write, source_commands, tasks, task_capability, people, person_capability, false, CommandCapability { });
    }
    fn capabilities_with_task_create(source: Source, mode: String, name: String, organization: Bool, definitions: Bool, knowledge: Bool, commands: Bool, capability: CommandCapability, review_commands: Bool, review_capability: CommandCapability, command_origin: String, knowledge_write: Bool, source_commands: OrganizationCommandCapabilities, tasks: Bool, task_capability: CommandCapability, people: Bool, person_capability: CommandCapability, task_create: Bool, task_create_capability: CommandCapability) -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("application_id", source.identity);
        let command_wire = CommandWire { };
        let can_propose = commands && capability.available && capability.authorized && command_wire.origin_valid(command_origin);
        let can_verdict = review_commands && review_capability.available && review_capability.authorized && command_wire.origin_valid(command_origin);
        let can_source = source_commands.configured && source_commands.proposal.available && source_commands.proposal.authorized && command_wire.origin_valid(command_origin);
        let can_source_review = source_commands.configured && source_commands.review.available && source_commands.review.authorized && command_wire.origin_valid(command_origin);
        let can_reassign = tasks && command_wire.task_writable(task_capability, command_origin);
        let can_retire = people && command_wire.task_writable(person_capability, command_origin);
        let can_create = task_create && task_create_capability.available && task_create_capability.authorized && command_wire.origin_valid(command_origin);
        b.bool_field("read_only", !(can_propose || can_verdict || knowledge_write || can_source || can_source_review || can_reassign || can_retire || can_create));
        b.begin_object_field("principal");
        b.string_field("mode", mode);
        b.string_field("name", name);
        b.end_object();
        b.begin_object_field("reads");
        b.bool_field("practices", true);
        b.bool_field("reviews", true);
        b.bool_field("organization", organization);
        b.bool_field("definitions", definitions);
        b.bool_field("knowledge", knowledge);
        b.bool_field("workflows", mode == "local");
        b.bool_field("tasks", mode == "local");
        if people { b.bool_field("people", mode == "local"); }
        b.end_object();
        b.begin_object_field("writes");
        b.bool_field("practice_propose", can_propose);
        b.bool_field("review_verdict", can_verdict);
        if tasks { b.bool_field("task_reassign", can_reassign); }
        if people { b.bool_field("person_retire", can_retire); }
        if task_create { b.bool_field("task_create", can_create); }
        if source_commands.configured { b.bool_field("organization_propose", can_source); b.bool_field("organization_review_verdict", can_source_review); }
        b.end_object();
        if source_commands.configured {
            b.field("organization_commands", command_wire.organization_capability_json(source_commands.proposal, command_origin, false));
            b.field("organization_review_commands", command_wire.organization_capability_json(source_commands.review, command_origin, true));
        }
        if commands { b.field("commands", command_wire.capability_json(capability, command_origin, "dna.practice.propose")); }
        if review_commands { b.field("review_commands", command_wire.capability_json(review_capability, command_origin, "dna.review.verdict")); }
        if tasks { b.field("task_commands", command_wire.task_capability_json(task_capability, command_origin)); }
        if people { let person_wire = PersonWire { }; b.field("person_commands", person_wire.capability(person_capability, command_origin)); }
        if task_create { b.field("task_create_commands", command_wire.task_create_capability_json(task_create_capability, command_origin)); }
        if definitions && command_wire.origin_valid(command_origin) {
            let drafts = DefinitionDraftWire { };
            b.field("definition_drafts", drafts.capability());
        }
        b.bool_field("runtime_observation", false);
        b.bool_field("recursive_workflows", false);
        b.string_field("receipt_text", "record_visibility_only");
        b.end_object();
        return b.result();
    }
}

// dna/FRICTION.md F.3 (GH #730): an interface-typed field cannot be
// written into another locus's interface-typed field directly; the same
// value reaching the literal through a parameter is admitted and, under
// ASan, the temporary reader does not free the shared provider when it
// dissolves. One reader per request, as before.
fn definition_drafts_over(provider: ops::WorkflowCatalogProvider) -> ops::DefinitionDrafts { return ops::DefinitionDrafts { provider: provider }; }
fn definitions_over(provider: ops::WorkflowCatalogProvider) -> ops::Definitions { return ops::Definitions { provider: provider }; }

locus Api {
    params {
        root: String = ".";
        mode: String = "local";
        local_name: String = "local";
        web: WebAssets = WebAssets { };
        organization: orgsource::OrganizationSource = orgsource::OrganizationSource { };
        definitions: ops::WorkflowCatalogProvider = ops::NoWorkflowCatalog { };
        knowledge: KnowledgeProvider = NoKnowledge { };
        knowledge_commands: KnowledgeCommandProvider = NoKnowledgeCommands { };
        commands: CommandProvider = NoCommands { };
        people: PeopleProvider = NoPeople { };
        organization_commands: OrganizationCapabilityProvider = NoOrganizationCapabilities { };
        organization_candidates: OrganizationCandidateWire = OrganizationCandidateWire { };
        organization_runtime: OrganizationRuntimeProvider = NoOrganizationRuntime { };
        command_origin: String = "";
        // Reuse only the established session/authentication methods. Never
        // dispatch Ui.handle, whose legacy routes include domain mutations.
        auth: ui::Ui = ui::Ui { };
    }
    fn handle(req: std::http::Request) -> std::http::Response {
        let http = Http { };
        let cut = std::str::index_of(req.path, "?");
        let path = if cut < 0 { req.path } else { req.path[0..cut] };
        let raw_query = if cut < 0 { "" } else { req.path[(cut + 1)..len(req.path)] };
        let knowledge_commands_path = std::str::starts_with(path, API_PREFIX + "/") && std::str::ends_with(path, "/dna/knowledge/commands");
        let commands_path = !knowledge_commands_path && std::str::starts_with(path, API_PREFIX + "/") && std::str::ends_with(path, "/commands");
        let draft_path = std::str::starts_with(path, API_PREFIX + "/") && (std::str::ends_with(path, "/dna/definitions/draft") || std::str::ends_with(path, "/dna/organization/draft") || std::str::ends_with(path, "/dna/organization/ownership/draft"));
        // Preserve the standalone head's existing unsupported-mutation behavior.
        // A command provider opens command submission. Draft POST is separate
        // read preparation and requires a real catalog plus a configured origin.
        if req.method != "GET" && !(req.method == "POST" && (draft_path || knowledge_commands_path || (commands_path && (self.commands.supported("dna.practice.propose", "1") || self.commands.supported("dna.review.verdict", "1") || self.commands.supported("dna.organization.propose", "1") || self.commands.supported("dna.task.reassign", "1") || self.commands.supported("dna.person.retire", "1") || self.commands.supported("dna.task.create", "1"))))) { return http.error(405, "method_not_allowed", "this mutation route is not supported", false); }
        // The optional shell is public and static, so Runtime inspection can
        // work without a DNA session. Every Record read still passes auth below.
        if self.web.serves(path) { return self.web.response(path); }
        let mut actor = self.local_name;
        if self.mode == "oidc" {
            if path == "/auth/login" { return self.auth.begin_sign_in(); }
            if path == "/auth/callback" {
                let ctx = std::http::build_context(req);
                let code = http.decode(std::http::query_param(ctx.params, "code"));
                let state = http.decode(std::http::query_param(ctx.params, "state"));
                if !code.ok || !state.ok { return http.error(400, "invalid_query", "invalid authentication query encoding", false); }
                return self.auth.finish_sign_in(code.text, state.text, dna::cookie_value(std::http::header(req, "Cookie"), "dna_signin"));
            }
            if path == "/auth/logout" {
                self.auth.end_session(req);
                return ui::redirect("/auth/login", "dna_session=; Max-Age=0; Path=/");
            }
            actor = self.auth.session_name(req);
            if len(actor) == 0 { return http.error(401, "unauthenticated", "sign in at /auth/login", false); }
        }
        if !std::str::starts_with(path, API_PREFIX) { return http.error(404, "not_found", "no such read endpoint", false); }
        let knowledge_path = std::str::contains(path, "/dna/knowledge/");
        let query = if knowledge_path || commands_path || draft_path { Query { } } else if std::str::ends_with(path, "/dna/tasks") { http.task_query(raw_query) } else { http.query(raw_query) };
        if !query.ok { return http.error(400, "invalid_query", query.error, false); }
        let reader = SourceReader { root: self.root };
        let source = reader.read();
        if !source.ok { return http.error(if source.code == "snapshot_changed" { 409 } else { 503 }, source.code, source.error, source.code != "record_malformed"); }
        let prefix = API_PREFIX + "/" + source.identity;
        let organization = path == prefix + "/dna/organization";
        let definitions = path == prefix + "/dna/definitions";
        if !organization && !definitions && !knowledge_path && len(query.snapshot) > 0 && query.snapshot != source.head { return http.error(409, "snapshot_changed", "the Record changed; begin a new page sequence", true); }
        let wire = Wire { };
        if path == API_PREFIX {
            if len(raw_query) > 0 { return http.error(400, "invalid_query", "application discovery takes no query fields", false); }
            return http.success(source, wire.applications(source));
        }
        if !std::str::starts_with(path, prefix + "/") { return http.error(404, "application_not_found", "this server does not serve that application", false); }
        let command_context = CommandContext { root: self.root, source: source, principal_mode: self.mode, principal_name: actor };
        if path == prefix + "/dna/reviews/candidate" { return self.review_candidate_read(command_context, query, raw_query); }
        if path == prefix + "/dna/organization/source-status" { let status = OrganizationStatusWire { }; return status.read(command_context, query, raw_query, self.organization_candidates, self.organization_runtime); }
        if path == prefix + "/dna/organization/source-impact" { let impact = OrganizationImpactWire { }; return impact.read(command_context, query, raw_query, self.organization_candidates); }
        if path == prefix + "/commands" {
            return self.command_handle(req, raw_query, command_context);
        }
        if path == prefix + "/dna/knowledge/commands" || path == prefix + "/dna/knowledge/commands/capability" {
            let knowledge_wire = KnowledgeCommandWire { };
            return knowledge_wire.handle(req, raw_query, std::str::ends_with(path, "/capability"), command_context, self.knowledge_commands, self.command_origin);
        }
        if path == prefix + "/dna/definitions/draft" {
            return self.definition_draft_handle(req, cut >= 0, command_context);
        }
        if path == prefix + "/dna/organization/draft" {
            let authoring = OrganizationDraftWire { };
            return authoring.handle(req, cut >= 0, command_context, self.organization, self.command_origin);
        }
        if path == prefix + "/dna/organization/ownership/draft" {
            let authoring = OwnershipDraftWire { };
            return authoring.handle(req, cut >= 0, command_context, self.organization, self.command_origin);
        }
        if path == prefix + "/capabilities" {
            if len(raw_query) > 0 { return http.error(400, "invalid_query", "capabilities takes no query fields", false); }
            let supported = self.commands.supported("dna.practice.propose", "1");
            let review_supported = self.commands.supported("dna.review.verdict", "1");
            let capability = if supported { self.commands.capability(command_context, "dna.practice.propose", "1") } else { CommandCapability { } };
            let review_capability = if review_supported { self.commands.capability(command_context, "dna.review.verdict", "1") } else { CommandCapability { } };
            let knowledge_commands = KnowledgeCommandWire { };
            let knowledge_write = knowledge_commands.writable(command_context, self.knowledge_commands, self.command_origin);
            let source_capabilities = self.organization_commands.organization_capabilities(command_context);
            let tasks = self.commands.supported("dna.task.reassign", "1");
            let task_capability = if tasks { self.commands.capability(command_context, "dna.task.reassign", "1") } else { CommandCapability { } };
            let people = self.commands.supported("dna.person.retire", "1");
            let person_capability = if people { self.commands.capability(command_context, "dna.person.retire", "1") } else { CommandCapability { } };
            let creates = self.commands.supported("dna.task.create", "1");
            let create_capability = if creates { self.commands.capability(command_context, "dna.task.create", "1") } else { CommandCapability { } };
            let capabilities = wire.capabilities_with_task_create(source, self.mode, actor, self.organization.declared(), self.definitions.supported(), self.knowledge.supported(), supported, capability, review_supported, review_capability, self.command_origin, knowledge_write, source_capabilities, tasks, task_capability, people, person_capability, creates, create_capability);
            let authoring = OrganizationDraftWire { };
            let command_wire = CommandWire { };
            if self.organization.allow_drafts && self.organization.declared() && command_wire.origin_valid(self.command_origin) {
                let ownership_authoring = OwnershipDraftWire { };
                return http.success(source, capabilities[0..(len(capabilities) - 1)] + ",\"organization_drafts\":" + authoring.capability() + ",\"ownership_drafts\":" + ownership_authoring.capability() + "}");
            }
            return http.success(source, capabilities);
        }
        if knowledge_path {
            let knowledge_prefix = prefix + "/dna/knowledge/";
            if !std::str::starts_with(path, knowledge_prefix) { return http.error(404, "not_found", "no such read endpoint", false); }
            return self.knowledge_read(source, actor, path[len(knowledge_prefix)..len(path)], raw_query);
        }
        if path == prefix + "/dna/workflows" { let work = WorkflowWire { }; return work.read(self.root, self.mode, source, query); }
        if path == prefix + "/dna/tasks" { let tasks = TaskWire { }; return tasks.read(command_context, query); }
        if path == prefix + "/dna/people" { let people = PersonWire { }; return people.read(command_context, query, self.people); }
        if organization { return self.organization_read(source, query); }
        if definitions { return self.definitions_read(source, query); }
        let practices = path == prefix + "/dna/practices";
        let reviews = path == prefix + "/dna/reviews";
        if !practices && !reviews { return http.error(404, "not_found", "no such read endpoint", false); }
        let q = ops::Queries { j: dna::GitJournal { repo: self.root }, receipts: dna::GitReceipts { repo: self.root } };
        if q.head() != source.head || q.revision() != source.revision { return http.error(409, "snapshot_changed", "the Record changed while loading the query", true); }
        let total = if len(query.id) > 0 { 1 } else if practices { q.practice_count() } else { q.review_count() };
        let b = std::json::Builder { };
        b.begin_object();
        b.begin_array_field("items");
        let mut index = query.offset;
        let end = if query.offset + query.limit < total { query.offset + query.limit } else { total };
        while index < end {
            if practices {
                let p = if len(query.id) > 0 { q.practice_of(query.id) } else { q.practice_at(index) };
                if len(p.id) == 0 { return http.error(404, "practice_not_found", "no such practice", false); }
                b.value(wire.practice(p));
            } else {
                let r = if len(query.id) > 0 { q.review_of(query.id) } else { q.review_at(index) };
                if len(r.id) == 0 { return http.error(404, "review_not_found", "no such review", false); }
                b.value(wire.review(self.organization_candidates.review_row(command_context, r)));
            }
            index = index + 1;
        }
        b.end_array();
        b.field("page", http.page(query.limit, query.offset, total, source.head));
        b.end_object();
        // A redaction appended while receipt text was read invalidates the
        // entire response. The next request loads its suppression marker.
        let record = dna::GitRecord { repo: self.root };
        if record.head("journal") != source.head { return http.error(409, "snapshot_changed", "the Record changed while the response was being built", true); }
        return http.success(source, b.result());
    }
    fn definition_draft_handle(req: std::http::Request, has_query: Bool, context: CommandContext) -> std::http::Response {
        let http = Http { };
        let wire = DefinitionDraftWire { };
        if req.method != "POST" { return http.error(405, "method_not_allowed", "definition draft validation requires POST", false); }
        if has_query { return http.error(400, "invalid_query", "definition draft validation takes no query", false); }
        let guard = wire.guard(req, self.command_origin);
        if len(guard) > 0 { return wire.error(guard); }
        let request = wire.parse(req.body, context.source.identity);
        if !request.ok { return wire.error("invalid_definition_draft"); }
        if request.principal_mode != context.principal_mode || request.principal_name != context.principal_name { return wire.error("definition_draft_context_changed"); }
        if !self.definitions.supported() { return wire.error("definition_drafts_unsupported"); }
        let drafts = definition_drafts_over(self.definitions);
        let result = drafts.validate(request.base_id, request.basis, request.candidate);
        let data = if result.status == 200 { wire.data(request, context.principal_mode, context.principal_name, result) } else { "" };
        let record = dna::GitRecord { repo: self.root };
        if record.head("journal") != context.source.head { return http.error(409, "snapshot_changed", "the Record changed during definition draft validation", true); }
        if result.status != 200 { return http.error(result.status, result.code, result.message, result.status == 409 || result.status == 503); }
        return http.success(context.source, data);
    }
    fn command_handle(req: std::http::Request, query: String, context: CommandContext) -> std::http::Response {
        let wire = CommandWire { };
        if !(self.commands.supported("dna.practice.propose", "1") || self.commands.supported("dna.review.verdict", "1") || self.commands.supported("dna.organization.propose", "1") || self.commands.supported("dna.task.reassign", "1") || self.commands.supported("dna.person.retire", "1") || self.commands.supported("dna.task.create", "1")) { return wire.error("commands_unsupported"); }
        if req.method == "GET" {
            let request_id = wire.lookup_id(query);
            if len(request_id) == 0 { return wire.error("invalid_query"); }
            // Recovery permission is independent of current write capability.
            return wire.response(context, CommandRequest { request_id: request_id }, self.commands.lookup(context, request_id), false);
        }
        if req.method != "POST" {
            let http = Http { };
            return http.error(405, "method_not_allowed", "this command method is not supported", false);
        }
        if len(query) > 0 { return wire.error("invalid_query"); }
        let guard = wire.guard(req, self.command_origin);
        if len(guard) > 0 { return wire.error(guard); }
        let command = wire.parse(req.body, context.source.identity);
        if !command.valid { return wire.error("invalid_command"); }
        // Expected identity is a precondition, never an authentication source.
        // A browser session can change after review but before this request.
        if command.expected_principal_mode != context.principal_mode || command.expected_principal_name != context.principal_name { return wire.error("command_context_changed"); }
        if !self.commands.supported(command.operation, command.operation_version) { return wire.error("commands_unsupported"); }
        // Discovery grants no authority: the provider must authorize the native
        // decision and recover an existing request before considering admission.
        return wire.response(context, command, self.commands.submit(context, command), true);
    }
    fn review_candidate_read(context: CommandContext, query: Query, raw_query: String) -> std::http::Response {
        let http = Http { };
        if query.id == "" || query.snapshot == "" || len(raw_query) > 2048 { return http.error(400, "invalid_query", "candidate read requires exact id and snapshot", false); }
        let mut rest = raw_query; let mut count = 0;
        while len(rest) > 0 {
            let cut = std::str::index_of(rest, "&"); let pair = if cut < 0 { rest } else { rest[0..cut] }; let equals = std::str::index_of(pair, "=");
            if equals < 1 { return http.error(400, "invalid_query", "candidate read accepts only id and snapshot", false); }
            let key = http.decode(pair[0..equals]);
            if !key.ok || (key.text != "id" && key.text != "snapshot") { return http.error(400, "invalid_query", "candidate read accepts only id and snapshot", false); }
            count = count + 1; rest = if cut < 0 { "" } else { rest[(cut + 1)..len(rest)] };
        }
        if count != 2 { return http.error(400, "invalid_query", "candidate read requires exact id and snapshot", false); }
        let record = dna::GitRecord { repo: self.root }; let capture = ops::GovernanceCommands { record: record }; let source = capture.capture();
        if !source.ok { return http.error(503, "record_unavailable", "the canonical candidate source is unavailable", true); }
        if source.application_id != context.source.identity || source.head != context.source.head || source.revision != context.source.revision { return http.error(409, "snapshot_changed", "the Record changed while capturing the candidate", true); }
        let journal = ops::GovernanceJournal { snapshot: source }; let receipts = ops::GovernanceReceipts { record: dna::GitRecord { repo: self.root } };
        if !journal.valid { return http.error(503, "record_malformed", "the candidate source is invalid", false); }
        let row = ops::review_row(journal, query.id);
        if self.organization_candidates.source_review(row) { return self.organization_candidates.read(context, source, journal, query.id); }
        let commands = ops::KnowledgeCommands { };
        if !commands.active_person(journal, context.principal_name) { return http.error(403, "forbidden", "this principal cannot read the Knowledge candidate", false); }
        let queries = ops::Queries { j: journal, receipts: receipts };
        let wire = ops::GovernanceCommandCodec { };
        let mut kind = "knowledge_binding_change"; let mut document = ""; let mut digest = ""; let mut proposer = ""; let mut sequence = -1; let mut valid = false;
        if row.knowledge_edge_digest != "" || row.edge_request_id != "" {
            let candidate = queries.edge_candidate_of(query.id);
            valid = candidate.ok; kind = "knowledge_edge_change"; document = candidate.document; digest = candidate.request.candidate_digest; proposer = candidate.request.by; sequence = candidate.sequence;
        } else {
            let candidate = queries.binding_candidate_of(query.id);
            valid = candidate.ok; document = candidate.document; digest = candidate.request.candidate_digest; proposer = candidate.request.by; sequence = candidate.sequence;
        }
        if !valid || wire.string(dna::line_at(source.text, sequence), "author") != proposer { return http.error(404, "candidate_not_found", "no visible canonical candidate was found", false); }
        if record.head("journal") != source.head { return http.error(409, "snapshot_changed", "the Record changed while reading the candidate", true); }
        let b = std::json::Builder { }; b.begin_object(); b.string_field("kind", kind); b.string_field("review_id", query.id);
        b.string_field("candidate_digest", digest); b.field("document", dna::record_json_quote(document)); b.end_object();
        return http.success(context.source, b.result());
    }
    fn knowledge_read(source: Source, actor: String, kind: String, raw_query: String) -> std::http::Response {
        let http = Http { };
        if kind != "nodes" && kind != "edges" && kind != "bindings" && kind != "dependents" { return http.error(404, "not_found", "no such read endpoint", false); }
        let wire = KnowledgeWire { };
        let query = wire.query(raw_query, kind);
        if !query.ok { return http.error(400, "invalid_query", "invalid Knowledge query fields or values", false); }
        if !self.knowledge.supported() { return http.error(503, "knowledge_unsupported", "this application does not configure Knowledge reads", false); }
        let request = KnowledgeRequest { source: source, reader: actor, kind: kind, query: query };
        let response = wire.response(request, self.knowledge.read(request));
        let record = dna::GitRecord { repo: self.root };
        if record.head("journal") != source.head { return http.error(409, "snapshot_changed", "the Record changed during the Knowledge read", true); }
        return response;
    }
    fn definitions_read(source: Source, query: Query) -> std::http::Response {
        let http = Http { };
        // One provider capture owns this response. Its document, declared
        // policy and loaded-source provenance cannot be mixed across versions.
        let q = definitions_over(self.definitions);
        if !q.load() { return http.error(503, q.code(), q.error(), q.status() == "unavailable"); }
        let snapshot = source.head + ":" + q.snapshot();
        if len(query.snapshot) > 0 && query.snapshot != snapshot {
            return http.error(409, "snapshot_changed", "the definition catalog or Record changed; begin a new page sequence", true);
        }
        let total = if len(query.id) > 0 { 1 } else { q.count() };
        let b = std::json::Builder { };
        b.begin_object(); b.begin_array_field("items");
        let mut i = query.offset;
        let end = if query.offset + query.limit < total { query.offset + query.limit } else { total };
        while i < end {
            let row = if len(query.id) > 0 { q.definition_of(query.id) } else { q.at(i) };
            if len(row.id) == 0 { return http.error(404, "definition_not_found", "no such definition revision", false); }
            b.value(q.row_json(row));
            i = i + 1;
        }
        b.end_array();
        b.field("page", http.page(query.limit, query.offset, total, snapshot));
        b.field("basis", q.basis_json()); b.end_object();
        let record = dna::GitRecord { repo: self.root };
        if record.head("journal") != source.head {
            return http.error(409, "snapshot_changed", "the Record changed while the catalog response was built", true);
        }
        return http.success(source, b.result());
    }
    fn organization_read(source: Source, query: Query) -> std::http::Response {
        let http = Http { };
        let artifact = self.organization.read();
        if !artifact.ok {
            return http.error(if artifact.code == "snapshot_changed" { 409 } else { 503 }, artifact.code, artifact.error, artifact.available);
        }
        // The pure projection validates strict JSON and artifact integrity
        // before reading fields; do not scan the same large artifact twice.
        let q = ops::Organization { artifact: artifact.artifact, owners: artifact.owners, source_head: artifact.source_head, source_root: artifact.source_root, dependency_digest: artifact.dependency_digest, dependency_source: artifact.dependency_source, record_head: source.head };
        if !q.load() { return http.error(503, "organization_malformed", q.error(), false); }
        let snapshot = q.snapshot();
        if len(query.snapshot) > 0 && query.snapshot != snapshot {
            return http.error(409, "snapshot_changed", "the organization or Record changed; begin a new page sequence", true);
        }
        let total = if len(query.id) > 0 { 1 } else { q.count() };
        let b = std::json::Builder { };
        b.begin_object();
        b.begin_array_field("items");
        let mut i = query.offset;
        let end = if query.offset + query.limit < total { query.offset + query.limit } else { total };
        while i < end {
            let row = if len(query.id) > 0 { q.position_of(query.id) } else { q.at(i) };
            if len(row.id) == 0 { return http.error(404, "organization_node_not_found", "no such declared organization node", false); }
            b.value(q.row_json(row));
            i = i + 1;
        }
        b.end_array();
        b.field("page", http.page(query.limit, query.offset, total, snapshot));
        b.field("basis", q.basis_json());
        b.field("ownership", q.ownership_json());
        b.end_object();
        let record = dna::GitRecord { repo: self.root };
        if !self.organization.unchanged(artifact) || record.head("journal") != source.head {
            return http.error(409, "snapshot_changed", "the organization or Record changed while the response was built", true);
        }
        return http.success(source, b.result());
    }
}

fn main() {
    let root = std::env::arg_or(1, ".");
    let raw_port = std::env::arg_or(2, "8792");
    let http = Http { };
    let port = http.integer(raw_port, 65535);
    if port < 1 || std::env::args_count() > 4 || std::str::contains(root, "\n") || std::str::contains(root, "\r") {
        eprintln("hale dna api: expected <project-root> <port 1..65535> [face-webroot]");
        std::process::exit(2);
    }
    let web = WebAssets { };
    if std::env::args_count() > 3 && !web.load(std::env::arg(3)) {
        eprintln("hale dna api: " + web.error + "; refusing to start");
        std::process::exit(2);
    }
    serve(root, port, web, ops::NoWorkflowCatalog { });
}

// An application-composed head supplies its real catalog through the same
// authentication/startup path as the standalone head. The standalone executable
// cannot discover arbitrary in-memory catalog values from a project directory.
fn serve(root: String, port: Int, web: WebAssets, definitions: ops::WorkflowCatalogProvider) {
    serve_with_commands(root, port, web, definitions, NoCommands { });
}

// Explicit application composition only; standalone serve() always uses NoCommands.
// The permitted browser origin comes from our own bound host/port, never Host.
fn serve_with_commands(root: String, port: Int, web: WebAssets, definitions: ops::WorkflowCatalogProvider, commands: CommandProvider) {
    let authority = ops::NoGovernanceAuthority { };
    serve_with_source_evidence(root, port, web, definitions, commands, authority);
}

// Source evidence read/recovery permission is an explicit separate grant.
// It enables immutable reads only; Organization publishing remains disabled.
fn serve_with_source_evidence(root: String, port: Int, web: WebAssets, definitions: ops::WorkflowCatalogProvider, commands: CommandProvider, authority: ops::GovernanceAuthority) {
    let absent = NoOrganizationCapabilities { };
    serve_with_source_commands(root, port, web, definitions, commands, authority, absent);
}

// The optional capability facet is bound to the same command provider; it
// supplies no independent command registry or authority.
fn serve_with_source_commands(root: String, port: Int, web: WebAssets, definitions: ops::WorkflowCatalogProvider, commands: CommandProvider, authority: ops::GovernanceAuthority, source_capabilities: OrganizationCapabilityProvider) {
    let absent = NoOrganizationRuntime { };
    serve_with_source_runtime(root, port, web, definitions, commands, authority, source_capabilities, absent);
}

// Optional trusted host association. Historical status stays useful when absent.
fn serve_with_source_runtime(root: String, port: Int, web: WebAssets, definitions: ops::WorkflowCatalogProvider, commands: CommandProvider, authority: ops::GovernanceAuthority, source_capabilities: OrganizationCapabilityProvider, runtime: OrganizationRuntimeProvider) {
    let absent = NoPeople { };
    serve_with_people(root, port, web, definitions, commands, authority, source_capabilities, runtime, absent);
}
fn serve_with_people(root: String, port: Int, web: WebAssets, definitions: ops::WorkflowCatalogProvider, commands: CommandProvider, authority: ops::GovernanceAuthority, source_capabilities: OrganizationCapabilityProvider, runtime: OrganizationRuntimeProvider, people: PeopleProvider) {
    if port < 1 || port > 65535 || std::str::contains(root, "\n") || std::str::contains(root, "\r") {
        eprintln("hale dna api: expected a project root and port 1..65535");
        std::process::exit(2);
    }
    let record = dna::GitRecord { repo: root };
    let configured = record.git("config\n--get\ndna.principal");
    if configured.code != 0 && configured.code != 1 {
        eprintln("hale dna api: cannot read project authentication configuration");
        std::process::exit(2);
    }
    let mode = dna::trim_nl(configured.stdout);
    let command_origin = "http://127.0.0.1:" + to_string(port);
    let knowledge = ConfiguredKnowledge { url: std::env::var("HALE_DNA_KNOWLEDGE_URL"), read_key: std::env::var("HALE_DNA_KNOWLEDGE_READ_KEY") };
    let knowledge_commands = ConfiguredKnowledgeCommands { url: std::env::var("HALE_DNA_KNOWLEDGE_URL"), command_key: std::env::var("HALE_DNA_KNOWLEDGE_COMMAND_KEY"), read_key: std::env::var("HALE_DNA_KNOWLEDGE_READ_KEY") };
    let organization_candidates = OrganizationCandidateWire { authority: authority };
    let command_label = if commands.supported("dna.practice.propose", "1") || commands.supported("dna.review.verdict", "1") { "composed command provider" } else if knowledge_commands.supported() { "configured Knowledge command provider" } else { "no writes" };
    if mode == "oidc" {
        let issuer = record.setting("oidc.issuer");
        let client = record.setting("oidc.client");
        let redirect_uri = record.setting("oidc.redirect");
        if len(issuer) == 0 || len(client) == 0 || len(redirect_uri) == 0 || !dna::issuer_allowed(issuer) {
            eprintln("hale dna api: configured OIDC requires an allowed issuer, client and redirect; refusing local fallback");
            std::process::exit(2);
        }
        let members = record.git("config\n--get-all\ndna.oidc.member");
        println("hale dna api: http://127.0.0.1:", port, API_PREFIX, " (OIDC session; ", command_label, ")");
        std::http::Server { host: "127.0.0.1", port: port, handler: Api { root: root, web: web, organization: orgsource::OrganizationSource { root: root, allow_drafts: std::env::var("HALE_DNA_ORG_DRAFTS") == "1" }, definitions: definitions, knowledge: knowledge, knowledge_commands: knowledge_commands, commands: commands, people: people, organization_commands: source_capabilities, organization_candidates: organization_candidates, organization_runtime: runtime, command_origin: command_origin, mode: "oidc", auth: ui::Ui { principal: "oidc", issuer: issuer, client: client, redirect_uri: redirect_uri, members: members.stdout } } };
        return;
    }
    if len(mode) > 0 && mode != "local" {
        eprintln("hale dna api: unsupported principal source; refusing local fallback");
        std::process::exit(2);
    }
    let user = std::env::var("USER");
    println("hale dna api: http://127.0.0.1:", port, API_PREFIX, " (trusted local; ", command_label, ")");
    std::http::Server { host: "127.0.0.1", port: port, handler: Api { root: root, web: web, organization: orgsource::OrganizationSource { root: root, allow_drafts: std::env::var("HALE_DNA_ORG_DRAFTS") == "1" }, definitions: definitions, knowledge: knowledge, knowledge_commands: knowledge_commands, commands: commands, people: people, organization_commands: source_capabilities, organization_candidates: organization_candidates, organization_runtime: runtime, command_origin: command_origin, local_name: if len(user) > 0 { user } else { "local" } } };
}
