// dna/host/host.hl — `hale dna run` / `hale dna dev`: the stateless
// host beside the organization (GH #566 F8), a node of the organism. It
// builds and starts the organization, waits for it to read the nerves,
// attaches iris (the inspector, on the organization's process like any
// Hale binary), and then ticks: sync the record, mirror GitHub, publish
// the record's requests onto the nerves (GH #986), re-project
// `status.json`, answer restart requests — under
// `dev` by rebuilding and restarting the application and watching the
// window; under `run` with a fleet by a deploy row and the window over
// every touched instance; for the organization's own seed by
// restarting the organization. It holds no Task state and decides
// nothing; when the organization exits, so does it, with its code.

import "../core" as dna;
import "../organization_runtime" as org_runtime;
import "../organization_source" as orgsource;
import "../../iris/process_identity" as identity;
import "../core/pond/realtime/nats" as nats;

const ORG_SEED: String = "dna/org";

// A fact's identity in the record is its content and its place among
// rows of the same content, never its `seq`: a reconcile re-appends
// local-only events on top of the remote's and renumbers them, and a
// host that remembered what it had relayed or handled by seq relayed
// it again after one (GH #603). Content alone is not enough either —
// a node raising the same concern three times writes three identical
// rows, each a fact of its own — so the key counts the identical rows
// before this one; a reconcile keeps a source's rows in order, so the
// count holds across it.
@unbounded
fn fact_key(p: Projection, i: Int) -> String {
    let e = p.row(i);
    let mut before = 0;
    let mut j = 0;
    while j < i {
        let o = p.row(j);
        if o.kind == e.kind && o.entity == e.entity && o.body == e.body { before = before + 1; }
        j = j + 1;
    }
    return e.kind + "|" + e.entity + "|" + dna::hex(std::crypto::sha256(std::bytes::from_string(e.body))) + "#" + to_string(before);
}

fn keys_has(list: String, key: String) -> Bool {
    return std::str::contains(list, "\n" + key + "\n");
}

fn keys_add(list: String, key: String) -> String {
    return (if len(list) == 0 { "\n" } else { list }) + key + "\n";
}
// GH #689: whether the request at row `i` has ITS OWN answer.
//
// New verdict commands carry command_id and require their own exact
// review.command_decided; a Review's settlement cannot answer another
// command. Intents and practice requests each have an entity of their own.
// Several
// concerns from one source share an entity, so a concern carries its own
// id (`request` in its body) and the organization writes that id into the
// `concern.raised` it answers with, in a field of its own, which is read
// back whole and compared whole (`dna::request_named`): the answer is
// matched by identity, an answer to `c10` is not an answer to `c1`, and a
// repeated or a later answer can neither answer an earlier request nor
// hide one that was never delivered.
//
// A request written before this rule carries no id. Those fall back to
// counting: the k-th such request of a (kind, entity) is answered when k
// answers for that entity exist, which is what this host did before —
// enough while a record holds only pre-rule rows, and never applied to a
// request that has an id.
@unbounded
fn request_answered(p: Projection, i: Int, kinds: String) -> Bool {
    let r = p.row(i);
    let command_id = dna::native_json_string(r.body, "command_id");
    if r.kind == "review.verdict" && len(command_id) > 0 {
        let v = dna::review_command_verdict(command_id, r.body);
        let mut j = i + 1;
        while j < p.rows() {
            let o = p.row(j);
            if o.kind == "review.command_decided" && o.entity == command_id && dna::review_command_matches(o.body, v) { return true; }
            j = j + 1;
        }
        return false;
    }
    if r.kind == "knowledge.node.requested" {
        let codec = dna::KnowledgeNodeRequestCodec { };
        let request = codec.decode(r.body);
        if !codec.valid(request) || request.request_id != r.entity { return false; }
        let mut j = i + 1;
        while j < p.rows() {
            let answer = p.row(j);
            if answer.entity == request.request_id {
                if answer.kind == "knowledge.node.proposed" && answer.body == codec.proposed(request) { return true; }
                if answer.kind == "knowledge.node.refused" {
                    let why = dna::native_json_string(answer.body, "why");
                    if len(why) > 0 && answer.body == codec.refused(request, why) { return true; }
                }
            }
            j = j + 1;
        }
        return false;
    }
    if r.kind == "knowledge.binding.requested" {
        let codec = dna::KnowledgeBindingCodec { }; let request = codec.decode(r.body);
        if !codec.valid(request) || request.request_id != r.entity { return false; }
        let mut j = i + 1;
        while j < p.rows() {
            let answer = p.row(j);
            if answer.entity == request.request_id {
                if answer.kind == "knowledge.binding.proposed" && answer.body == codec.proposed(request) { return true; }
                if answer.kind == "knowledge.binding.refused" {
                    let code = dna::native_json_string(answer.body, "reason_code"); let why = dna::native_json_string(answer.body, "why");
                    if len(code) > 0 && len(why) > 0 && answer.body == codec.refused(request, code, why) { return true; }
                }
            }
            j = j + 1;
        }
        return false;
    }
    if r.kind == "knowledge.edge.requested" {
        let codec = dna::KnowledgeEdgeCodec { }; let request = codec.decode(r.body);
        if !codec.valid(request) || request.request_id != r.entity { return false; }
        let mut j = i + 1;
        while j < p.rows() {
            let answer = p.row(j);
            if answer.entity == request.request_id {
                if answer.kind == "knowledge.edge.proposed" && answer.body == codec.proposed(request) { return true; }
                if answer.kind == "knowledge.edge.refused" {
                    let code = dna::native_json_string(answer.body, "reason_code"); let why = dna::native_json_string(answer.body, "why");
                    if len(code) > 0 && len(why) > 0 && answer.body == codec.refused(request, code, why) { return true; }
                }
            }
            j = j + 1;
        }
        return false;
    }
    let id = std::json::find_string_field(r.body, "request");
    if len(id) > 0 {
        let mut j = i + 1;
        while j < p.rows() {
            let o = p.row(j);
            if o.entity == r.entity && std::str::contains(kinds, " " + o.kind + " ") && dna::request_named(o.body) == id { return true; }
            j = j + 1;
        }
        return false;
    }
    let mut occurrence = 0;
    let mut first = -1;
    let mut j = 0;
    while j <= i {
        let o = p.row(j);
        if o.kind == r.kind && o.entity == r.entity && len(std::json::find_string_field(o.body, "request")) == 0 {
            occurrence = occurrence + 1;
            if first < 0 { first = j; }
        }
        j = j + 1;
    }
    let mut answers = 0;
    j = first + 1;
    while j < p.rows() {
        let o = p.row(j);
        if o.entity == r.entity && std::str::contains(kinds, " " + o.kind + " ") && len(dna::request_named(o.body)) == 0 { answers = answers + 1; }
        j = j + 1;
    }
    return answers >= occurrence;
}

// GH #682: when a row was last relayed (`<key>@<unix>` lines), -1 never.
@unbounded
fn relayed_at(list: String, key: String) -> Int {
    let mut at = -1;
    let mut rest = list;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if std::str::starts_with(line, key + "@") {
            let t = std::str::parse_int(line[(len(key) + 1)..len(line)]) or - 1;
            if t > at { at = t; }
        }
    }
    return at;
}
fn relay_mark(list: String, key: String, now: Int) -> String {
    return keys_add(list, key + "@" + to_string(now));
}
// A publish is confirmed by its answer in the record, never by the
// transport: after this long unanswered, the row is relayed again
// (the organism admits an intent once by id; a duplicate verdict is refused
// as already settled).
const RELAY_AGAIN_AFTER: Int = 30;
// How many landed rows a node tells in one pass (the rest the next).
const ANNOUNCE_AT_ONCE: Int = 256;
// How long a pull lives on the stream: pond's NatsConn pulls with a one
// second expiry (its `pull`), and a little more for the server to drop it.
const NERVES_PULL_LIFE_MS: Int = 1250;
// How long a node inside an observation window waits for the organism to
// record its report before it goes on (the relay does not stop).
const OBSERVATION_WAIT: Int = 60;

// A source marker selects the strict prepared path even when its evidence is
// unavailable. Never fall back to an arbitrary live-checkout restart for it.
fn prepared_source_restart(p: Projection, r: dna::Event) -> Bool {
    if !std::str::starts_with(r.body, "apply ") || seed_named_in(r.body) != ORG_SEED { return false; }
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "review.requested" && e.entity == "review:" + r.entity
            && len(dna::native_json_string(e.body, "organization_source_request_id")) > 0 { return true; }
        i = i + 1;
    }
    return false;
}
fn prepared_source_restart_answered(p: Projection, r: dna::Event) -> Bool {
    let source = org_runtime::OrganizationLaunchSource { root: p.root }; let basis = source.basis(r.entity);
    if !basis.ok || basis.handoff.digest != r.digest { return false; }
    let a = source.attempt(basis); let codec = dna::OrganizationLaunchCodec { }; if !codec.valid(a) { return false; }
    let launched = source.launched(a); let observed = source.observed(launched); let exited = source.exited(a);
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if observed.valid && observed.outcome == "healthy" && e.kind == "expression.observed" && e.entity == r.entity
            && e.body == "healthy " + a.binary_digest + " organization launch " + a.attempt_id + " observed healthy" { return true; }

        i = i + 1;
    }
    let rollback = OrganizationRollbackCodec { };
    return rollback.answered(source, basis, a);
}

// The latest `expression.restart_requested` this host has not handled
// and the organism has not already answered with `expression.restarted`.
fn pending_restart(p: Projection, handled: String) -> dna::Event {
    let mut out = dna::Event { seq: -1 };
    let mut i = 0;
    while i < p.rows() {
        let r = p.row(i);
        if r.kind == "expression.restart_requested" && !keys_has(handled, fact_key(p, i)) {
            let prepared = prepared_source_restart(p, r);
            let mut answered = prepared && prepared_source_restart_answered(p, r);
            let mut k = i + 1;
            while k < p.rows() {
                let x = p.row(k);
                if !prepared && x.kind == "expression.restarted" && x.entity == r.entity { answered = true; }
                k = k + 1;
            }
            if !answered { out = r; }
        }
        i = i + 1;
    }
    return out;
}

fn seed_named_in(body: String) -> String {
    let i = std::str::index_of(body, " seed ");
    if i < 0 { return ""; }
    let rest = body[(i + 6)..len(body)];
    let sp = std::str::index_of(rest, " ");
    if sp < 0 { return rest; }
    return rest[0..sp];
}

fn second_word(body: String) -> String {
    let sp = std::str::index_of(body, " ");
    if sp < 0 { return ""; }
    let rest = body[(sp + 1)..len(body)];
    let sp2 = std::str::index_of(rest, " ");
    if sp2 < 0 { return rest; }
    return rest[0..sp2];
}

type FleetOutcome {
    outcome: String = ""; // "healthy" | "crashed" | "never"
    shape: String = "";
    instance: String = "";
    node: String = "";
    code: Int = 0;
    missing: String = "";
}

// ---- the organism's build cache -----------------------------------
//
// `hale build` re-emits the IR for a whole seed every time it is
// asked, and the organization's seed is the vendored DNA core (~17k
// lines) plus a handful of project files: 3.8s on a quiet machine
// (the tracing of PR #931), the same 3.8s on every start and every
// restart of an organism whose sources did not move — 58.6s of the
// 212s the eleven slowest DNA integration tests take. A build is a
// pure function of what it reads, so it is done ONCE per content
// fingerprint and copied thereafter — the discipline `hale iris`
// already uses for the observer, one level down: there the key is the
// toolchain alone, because those sources ship with it; here it is the
// toolchain AND the sources, because a body must see its own edits.
//
// The fingerprint names every file the build reads — `hale inputs`,
// which resolves imports exactly as the compiler does, rather than a
// glob here that would go stale the day a seed grows an import —
// each by its path relative to the project and the SHA-256 of its
// bytes; the project's manifest and lock; the toolchain version and
// the `hale` binary's own size and mtime, so a compiler rebuilt in
// place without a version bump is a different key; every environment
// variable that changes codegen; and the seed's own path, because a
// binary carries the paths of the sources it was built from.
//
// A hit is a copy and nothing else, so a fingerprint that cannot be
// taken whole is simply not taken: every miss builds exactly as
// before. `HALE_DNA_NO_BUILD_CACHE=1` turns the cache off.
const BUILD_CACHE_KEEP: Int = 32;
const BUILD_ENV_KNOBS: String = "HALE_DEV HALE_TS_SHIM_A LOTUS_LTO LOTUS_ASAN LOTUS_DUMP_IR LOTUS_NO_BUS_DEVIRT LOTUS_NO_DEBUGINFO LOTUS_NO_CHUNK_POOL";

// `$XDG_CACHE_HOME/hale/dna-build` (or `~/.cache/hale/dna-build`), a
// sibling of the toolchain cache `hale iris` builds the host itself
// into. "" when the cache is off or this machine names no cache home.
fn build_cache_dir() -> String {
    if std::env::var_exists("HALE_DNA_NO_BUILD_CACHE") && std::env::var("HALE_DNA_NO_BUILD_CACHE") != "0" { return ""; }
    let xdg = std::env::var("XDG_CACHE_HOME");
    let home = std::env::var("HOME");
    let base = if len(xdg) > 0 { xdg } else if len(home) > 0 { home + "/.cache" } else { "" };
    if len(base) == 0 { return ""; }
    let dir = base + "/hale/dna-build";
    let m = dna::run_tool("mkdir\n-p\n" + dir);
    if m.code != 0 { return ""; }
    return dir;
}

// Every file a build of `seed_dir` reads, one `<path> <sha256>` line
// each, in the order the compiler lists them; "" when it cannot say.
// A path under `root` is named relative to it, so the fingerprint is
// of the project and not of where the project happens to sit.
@unbounded
fn input_digests(hale: String, root: String, seed_dir: String) -> String {
    let r = dna::run_tool(hale + "\ninputs\n" + seed_dir);
    if r.code != 0 { return ""; }
    // `hale inputs` names canonical paths (on macOS `/tmp` is an alias
    // of `/private/tmp`), so the root is compared in the same spelling
    // or every path stays absolute and the fingerprint names the
    // machine (GH #970).
    let phys = dna::run_tool("sh\n-c\ncd \"$1\" && pwd -P\nsh\n" + root);
    let prefix = (if phys.code == 0 && len(dna::trim_nl(phys.stdout)) > 0 { dna::trim_nl(phys.stdout) } else { root }) + "/";
    let mut out = "";
    let mut rest = dna::trim_nl(r.stdout) + "\n";
    while len(rest) > 1 {
        let nl = std::str::index_of(rest, "\n");
        if nl < 0 { rest = "\n"; continue; }
        let path = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        if len(path) == 0 { continue; }
        let body = std::io::fs::read_file(path) or "";
        let rel = if std::str::starts_with(path, prefix) { path[len(prefix)..len(path)] } else { path };
        out = out + rel + " " + dna::hex(std::crypto::sha256(std::bytes::from_string(body))) + "\n";
    }
    return out;
}

// The content fingerprint of a build of `seed_dir`; "" when any part
// of it could not be read, which is how the cache declines rather
// than guesses.
@unbounded
fn build_fingerprint(hale: String, root: String, seed_dir: String) -> String {
    let files = input_digests(hale, root, seed_dir);
    if len(files) == 0 { return ""; }
    // the compiler's identity: what it says it is, and what this file
    // on this machine is — a dev build keeps its predecessor's version
    let id = dna::run_tool("sh\n-c\np=$(command -v -- \"$1\" 2>/dev/null || echo \"$1\"); ls -lnL -- \"$p\" 2>/dev/null; \"$1\" --version 2>&1\nsh\n" + hale);
    if id.code != 0 { return ""; }
    let mut t = "hale dna build cache v1\n";
    t = t + "toolchain " + std::env::var("HALE_DNA_TOOLCHAIN") + "\n";
    t = t + "compiler " + dna::trim_nl(id.stdout) + "\n";
    t = t + "seed " + seed_dir + "\n";
    let mut rest = BUILD_ENV_KNOBS + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        if sp < 0 { rest = ""; continue; }
        let name = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        if len(name) > 0 && std::env::var_exists(name) { t = t + "env " + name + "=" + std::env::var(name) + "\n"; }
    }
    let manifest = std::io::fs::read_file(root + "/hale.toml") or "";
    let lock = std::io::fs::read_file(root + "/hale.lock") or "";
    t = t + "manifest " + dna::hex(std::crypto::sha256(std::bytes::from_string(manifest))) + "\n";
    t = t + "lock " + dna::hex(std::crypto::sha256(std::bytes::from_string(lock))) + "\n";
    t = t + files;
    return dna::hex(std::crypto::sha256(std::bytes::from_string(t)));
}

// Put the cached binary at `bin`. The copy lands beside it and is
// renamed over it, so a reader sees the old file or the whole new one
// and never a half-copied one, and a binary that is still running is
// replaced rather than written through. The entry is touched on the
// way, so the pruning below is least-recently-USED.
fn build_cache_take(entry: String, bin: String) -> Bool {
    if !std::io::fs::file_exists(entry) { return false; }
    let r = dna::run_tool("sh\n-c\nset -e; cp -- \"$1\" \"$2.cache.$$\"; chmod +x -- \"$2.cache.$$\"; mv -f -- \"$2.cache.$$\" \"$2\"; touch -- \"$1\"\nsh\n" + entry + "\n" + bin);
    if r.code != 0 { return false; }
    return std::io::fs::file_exists(bin);
}

// Keep what was just built under its fingerprint, and hold the cache
// to BUILD_CACHE_KEEP binaries, pruned least-recently-used first. No
// lock: a store is a rename, so a reader finds a whole binary or
// none, and two hosts that build the same thing at once simply both
// store it. An entry pruned mid-copy fails that copy, and a failed
// copy builds — the behaviour without a cache at all.
fn build_cache_keep(entry: String, bin: String, cache: String) {
    let after = to_string(BUILD_CACHE_KEEP + 1);
    let r = dna::run_tool("sh\n-c\nset -e; cp -- \"$2\" \"$1.tmp.$$\"; mv -f -- \"$1.tmp.$$\" \"$1\"; cd -- \"$3\" && ls -1t 2>/dev/null | tail -n +" + after + " | while IFS= read -r x; do rm -f -- \"./$x\"; done\nsh\n" + entry + "\n" + bin + "\n" + cache);
}

// The exact production relay, also composed by the focused native command
// acceptance fixture without starting Host's build/deploy lifecycle.
type RelayState { relayed: String = "\n"; count: Int = 0; error: String = ""; }

fn edge_admits_here(root: String, r: dna::KnowledgeEdgeRequest) -> Bool {
    let codec = dna::KnowledgeEdgeCodec { };
    if !codec.valid(r) { return false; }
    let journal = dna::GitJournal { repo: root }; let receipts = dna::GitReceipts { repo: root };
    if journal.revision() == 0 || journal.read(0).digest != r.application_id { return false; }
    let e = codec.endpoints(journal, receipts, r, journal.revision());
    return e.ok && admits_here(root, e.from_author) && admits_here(root, e.from_target)
        && admits_here(root, e.to_author) && admits_here(root, e.to_target);
}

// The node's relay (GH #682, #986): the record's requests onto the nerves.
// The host owns one and ticks it; its publishes go out through the
// program's `bindings`, so a program that is not the host — a test's —
// can own one too and bind the topics itself.
locus NodeRelay {
    params {
        root: String = ".";
        seed: String = ".";
        toolchain: String = "";
        verb: String = "run";
        live: Bool = false; // the program's nerves are configured
        relayed: String = "\n";
        error: String = ""; // the last relay's failure, "" when it had none
        relayed_count: Int = 0; // what the last relay published
        announced: Int = -1; // the rows of the view already told (-1: not yet looked)
    }
    bus {
        publish dna::IntentOffered;
        publish dna::ReviewVerdict;
        publish dna::ExpressionObserved;
        publish dna::PressureRaised;
        publish dna::ConcernRaised;
        publish dna::PracticeRequested;
        publish dna::HoldRequested;
        publish dna::KnowledgeNodeRequested;
        publish dna::KnowledgeBindingRequested;
        publish dna::KnowledgeEdgeRequested;
        publish dna::WorkSubmit;
        publish dna::RowLanded;
    }
    // Every row this node's view gained since it last looked, onto the
    // nerves as a RowLanded (GH #986): what a head waits on to read
    // again. The rows this view held when the node started are its past,
    // never told; at most ANNOUNCE_AT_ONCE a pass, the rest the next.
    // How many were told.
    @unbounded
    fn announce(memory: dna::Memory) -> Int {
        if !self.live { return 0; }
        let p = open_projection(self.root, self.seed, self.toolchain, memory);
        let rows = p.rows();
        if self.announced < 0 { self.announced = rows; return 0; }
        let mut n = 0;
        while self.announced < rows && n < ANNOUNCE_AT_ONCE {
            let e = p.row(self.announced);
            dna::RowLanded <- dna::LandedRow { seq: self.announced, kind: e.kind, entity: e.entity };
            self.announced = self.announced + 1;
            n = n + 1;
        }
        return n;
    }
    // One fact onto the nerves, on the topic the organization subscribes:
    // the row the record holds, as the organization's own declaration of
    // it. "" when it was handed to the connection, which keeps it until the
    // stream acknowledges it; otherwise why not.
    fn publish_fact(kind: String, body: String) -> String {
        if !self.live { return "no nerves (" + dna::NATS_SPINE_URL_ENV + " and " + dna::NATS_ORG_ENV + " are not set)"; }
        if kind == "intent" {
            dna::IntentOffered <- dna::IntentOffer {
                intent_id: std::json::find_string_field(body, "intent_id"),
                outcome: std::json::find_string_field(body, "outcome"),
                from: std::json::find_string_field(body, "from"),
                to: std::json::find_string_field(body, "to")
            };
        } else if kind == "verdict" {
            dna::ReviewVerdict <- dna::Verdict {
                command_id: dna::native_json_string(body, "command_id"),
                review_id: dna::native_json_string(body, "review_id"),
                subject_digest: dna::native_json_string(body, "subject_digest"),
                verdict: dna::native_json_string(body, "verdict"),
                reviewer: dna::native_json_string(body, "reviewer"),
                authority: dna::native_json_string(body, "authority"),
                comment: dna::native_json_string(body, "comment"),
                evidence: dna::native_json_string(body, "evidence")
            };
        } else if kind == "observed" {
            dna::ExpressionObserved <- dna::Observation {
                mutation_id: std::json::find_string_field(body, "mutation_id"),
                outcome: std::json::find_string_field(body, "outcome"),
                model_hash: std::json::find_string_field(body, "model_hash"),
                detail: std::json::find_string_field(body, "detail")
            };
        } else if kind == "pressure" {
            dna::PressureRaised <- dna::Pressure {
                source: std::json::find_string_field(body, "source"),
                what: std::json::find_string_field(body, "what"),
                count: 1,
                request: std::json::find_string_field(body, "request")
            };
        } else if kind == "concern" {
            dna::ConcernRaised <- dna::Concern {
                source: std::json::find_string_field(body, "source"),
                what: std::json::find_string_field(body, "what"),
                severity: std::json::find_int_field(body, "severity"),
                request: std::json::find_string_field(body, "request")
            };
        } else if kind == "hold" {
            // GH #1091: a holder proposed for a position
            dna::HoldRequested <- dna::HoldRequest {
                request_id: dna::native_json_string(body, "request_id"),
                position: dna::native_json_string(body, "position"),
                holder: dna::native_json_string(body, "holder"),
                by: dna::native_json_string(body, "by")
            };
        } else if kind == "practice" {
            dna::PracticeRequested <- dna::PracticeRequest {
                request_id: dna::native_json_string(body, "request_id"),
                name: dna::native_json_string(body, "name"),
                text: dna::native_json_string(body, "text"),
                by: dna::native_json_string(body, "by"),
                because: dna::native_json_string(body, "because"),
                supersedes: dna::native_json_string(body, "supersedes")
            };
        } else if kind == "knowledge-node" {
            let codec = dna::KnowledgeNodeRequestCodec { };
            let request = codec.decode(body);
            if !codec.valid(request) { return "an invalid knowledge-node request"; }
            dna::KnowledgeNodeRequested <- request;
        } else if kind == "knowledge-binding" {
            let codec = dna::KnowledgeBindingCodec { };
            let request = codec.decode(body);
            if !codec.valid(request) { return "an invalid knowledge-binding request"; }
            dna::KnowledgeBindingRequested <- request;
        } else if kind == "knowledge-edge" {
            let codec = dna::KnowledgeEdgeCodec { };
            let request = codec.decode(body);
            if !codec.valid(request) { return "an invalid knowledge-edge request"; }
            dna::KnowledgeEdgeRequested <- request;
        } else if kind == "work-submit" {
            // a leg's outcome, handed back at the head (GH #946): the row's
            // fields, and the attempt id spliced in by the relay
            dna::WorkSubmit <- dna::WorkSubmission {
                attempt_id: std::json::find_string_field(body, "attempt_id"),
                holder: std::json::find_string_field(body, "holder"),
                token: std::json::find_int_field(body, "token"),
                disposition: std::json::find_string_field(body, "disposition"),
                result: std::json::find_string_field(body, "result"),
                result_ref: std::json::find_string_field(body, "result_ref"),
                narrative: std::json::find_string_field(body, "narrative"),
                evidence_ref: std::json::find_string_field(body, "evidence_ref"),
                calls: std::json::find_string_field(body, "calls"),
                request: std::json::find_string_field(body, "request"),
                at: std::json::find_int_field(body, "at"),
                hat_digest: std::json::find_string_field(body, "hat_digest"),
                hat_head: std::json::find_string_field(body, "hat_head"),
                hat_watermark: if std::str::contains(body, "\"hat_watermark\"") { std::json::find_int_field(body, "hat_watermark") } else { -1 },
                prompt_digest: std::json::find_string_field(body, "prompt_digest"),
                renderer: std::json::find_string_field(body, "renderer")
            };
        } else {
            return "no fact of kind `" + kind + "`";
        }
        return "";
    }
    // The record onto the nerves (GH #682, #986): a request row — an
    // `intent.requested`, a `review.verdict`, a `concern.requested`, a
    // `pressure.requested`, a practice or knowledge request — a CLI, a
    // head or a node wrote in any clone is published on the topic the
    // organization subscribes, once it is in this node's record, and again
    // every RELAY_AGAIN_AFTER while the record holds no answer to it. The
    // row is the durable fact; the publish only tells the organization.
    @unbounded
    fn relay(memory: dna::Memory) -> Int {
        let mut state = RelayState { relayed: self.relayed };
        // no record, or one that could not be read: nothing to do this pass
        let now = record_head(self.root);
        if !now.ok || now.absent { return 0; }
        let p = open_projection(self.root, self.seed, self.toolchain, memory);
        let trust = trust_mode(self.root);
        let mut i = 0;
        while i < p.rows() {
            let r = p.row(i);
            // Another owner's node request is theirs to verify and admit. Do not
            // write a refusal using this host's keyring before checking routing.
            let node_ours = if r.kind == "knowledge.node.requested" {
                let codec = dna::KnowledgeNodeRequestCodec { };
                let request = codec.decode(r.body);
                codec.valid(request) && request.request_id == r.entity && admits_here(self.root, request.author) && admits_here(self.root, request.target)
            } else if r.kind == "knowledge.binding.requested" {
                let codec = dna::KnowledgeBindingCodec { }; let request = codec.decode(r.body);
                codec.valid(request) && request.request_id == r.entity && admits_here(self.root, request.author) && admits_here(self.root, request.target)
            } else if r.kind == "knowledge.edge.requested" {
                let codec = dna::KnowledgeEdgeCodec { }; let request = codec.decode(r.body);
                request.request_id == r.entity && edge_admits_here(self.root, request)
            } else { true };
            let requested = node_ours && (r.kind == "intent.requested" || r.kind == "review.verdict" || r.kind == "concern.requested" || r.kind == "pressure.requested" || r.kind == "observation.requested" || r.kind == "practice.requested" || r.kind == "hold.requested" || r.kind == "knowledge.node.requested" || r.kind == "knowledge.binding.requested" || r.kind == "knowledge.edge.requested" || r.kind == "attempt.outcome_requested");
            let answers = if r.kind == "intent.requested" { " intent.offered intent.refused " } else if r.kind == "concern.requested" { " concern.raised concern.refused " } else if r.kind == "pressure.requested" { " pressure.raised pressure.refused " } else if r.kind == "observation.requested" { " expression.observed observation.refused " } else if r.kind == "practice.requested" { " practice.proposed practice.refused " } else if r.kind == "hold.requested" { " hold.proposed hold.refused " } else if r.kind == "knowledge.node.requested" { " knowledge.node.proposed knowledge.node.refused " } else if r.kind == "knowledge.binding.requested" { " knowledge.binding.proposed knowledge.binding.refused " } else if r.kind == "knowledge.edge.requested" { " knowledge.edge.proposed knowledge.edge.refused " } else if r.kind == "attempt.outcome_requested" { " attempt.outcome attempt.outcome_refused " } else { " review.settled review.refused " };
            if requested && trust == "signed" && !row_verified(self.root, r.digest) {
                // Verification gates EVERY attempt. Even when writing the refusal
                // failed, an expired retry marker must never admit an unsigned row.
                let last = relayed_at(state.relayed, fact_key(p, i));
                if !request_answered(p, i, answers) && (last < 0 || std::time::now() - last >= RELAY_AGAIN_AFTER) {
                    let why = "unverified writer: commit " + r.digest + " carries no signature git accepts (dna.trust = signed); not relayed";
                    let command_id = dna::native_json_string(r.body, "command_id");
                    if r.kind == "review.verdict" && len(command_id) > 0 {
                        let v = dna::review_command_verdict(command_id, r.body);
                        let ok = append_as(self.root, "review.command_decided", command_id, dna::review_command_body(v, false, why, false, ""), "host", memory);
                    } else if r.kind == "knowledge.node.requested" {
                        let codec = dna::KnowledgeNodeRequestCodec { };
                        let request = codec.decode(r.body);
                        if codec.valid(request) && request.request_id == r.entity {
                            let ok = append_as(self.root, "knowledge.node.refused", r.entity, codec.refused(request, why), "host", memory);
                        }
                    } else if r.kind == "knowledge.binding.requested" {
                        let codec = dna::KnowledgeBindingCodec { }; let request = codec.decode(r.body);
                        if codec.valid(request) && request.request_id == r.entity {
                            let ok = append_as(self.root, "knowledge.binding.refused", r.entity, codec.refused(request, "unverified_writer", why), "host", memory);
                        }
                    } else if r.kind == "knowledge.edge.requested" {
                        let codec = dna::KnowledgeEdgeCodec { }; let request = codec.decode(r.body);
                        if codec.valid(request) && request.request_id == r.entity {
                            let ok = append_as(self.root, "knowledge.edge.refused", r.entity, codec.refused(request, "unverified_writer", why), "host", memory);
                        }
                    } else {
                        let refused = if r.kind == "intent.requested" { "intent.refused" } else if r.kind == "concern.requested" { "concern.refused" } else if r.kind == "pressure.requested" { "pressure.refused" } else if r.kind == "observation.requested" { "observation.refused" } else if r.kind == "practice.requested" { "practice.refused" } else if r.kind == "hold.requested" { "hold.refused" } else if r.kind == "attempt.outcome_requested" { "attempt.outcome_refused" } else { "review.refused" };
                        // a request with an id of its own (a concern's, a
                        // pressure signal's) is answered only by a row naming
                        // that id; the refusal names it, so it answers
                        let id = std::json::find_string_field(r.body, "request");
                        let ok = append_as(self.root, refused, r.entity, if len(id) > 0 { dna::concern_refusal_body(why, id) } else { why }, "host", memory);
                    }
                    state.relayed = relay_mark(state.relayed, fact_key(p, i), std::time::now());
                    eprintln("hale dna ", self.verb, ": refused an unverified ", r.kind, " (", r.entity, ") from the record");
                }
            } else if requested {
                let answered = request_answered(p, i, answers);
                // GH #664: an intent for a position another owner holds is
                // theirs to admit; it stays in the record, unanswered here
                let ours = r.kind != "intent.requested" || admits_here(self.root, std::json::find_string_field(r.body, "to"));
                // GH #682: relayed before and still unanswered — relay again
                let last = relayed_at(state.relayed, fact_key(p, i));
                let due = last < 0 || std::time::now() - last >= RELAY_AGAIN_AFTER;
                if !answered && ours && due {
                    let mut body = r.body;
                    if r.kind == "intent.requested" {
                        // the row's entity is the intent id
                        let inner = dna::trim_nl(body);
                        let close = last_index_of(inner, "}");
                        if close > 0 { body = inner[0..close] + ", \"intent_id\": " + quote(r.entity) + "}"; }
                    }
                    if r.kind == "attempt.outcome_requested" {
                        // the row's entity is the attempt id (GH #946)
                        let inner = dna::trim_nl(body);
                        let close = last_index_of(inner, "}");
                        if close > 0 { body = inner[0..close] + ", \"attempt_id\": " + quote(r.entity) + "}"; }
                    }
                    if r.kind == "knowledge.node.requested" {
                        // Admission metadata stays in Record. Transport only the
                        // exact eleven native fields after trust/owner checks;
                        // duplicating command_payload can exceed process argv.
                        let codec = dna::KnowledgeNodeRequestCodec { };
                        body = codec.started(codec.decode(r.body));
                    }
                    if r.kind == "knowledge.binding.requested" { let codec = dna::KnowledgeBindingCodec { }; body = codec.started(codec.decode(r.body)); }
                    if r.kind == "knowledge.edge.requested" { let codec = dna::KnowledgeEdgeCodec { }; body = codec.started(codec.decode(r.body)); }
                    let e = self.publish_fact(if r.kind == "intent.requested" { "intent" } else if r.kind == "concern.requested" { "concern" } else if r.kind == "pressure.requested" { "pressure" } else if r.kind == "observation.requested" { "observed" } else if r.kind == "practice.requested" { "practice" } else if r.kind == "hold.requested" { "hold" } else if r.kind == "knowledge.node.requested" { "knowledge-node" } else if r.kind == "knowledge.binding.requested" { "knowledge-binding" } else if r.kind == "knowledge.edge.requested" { "knowledge-edge" } else if r.kind == "attempt.outcome_requested" { "work-submit" } else { "verdict" }, body);
                    if len(e) == 0 { state.relayed = relay_mark(state.relayed, fact_key(p, i), std::time::now()); state.count = state.count + 1; }
                    else { state.error = r.kind + " (" + r.entity + "): " + e; }
                }
            }
            i = i + 1;
        }
        self.relayed = state.relayed;
        self.error = state.error;
        self.relayed_count = state.count;
        return state.count;
    }
}

// The host is the program's `main locus` when it runs a node (`run`,
// `dev`), so its `bindings` are this program's: every fact the node
// publishes goes out through pond's NATS adapter, and the pinned
// `nerves` connection carries it to the organization's stream (GH #986).
// Nothing is instantiated for a one-shot verb, which never publishes: it
// writes its row, and a node relays it.
main locus Host {
    birth() { self.memory.point(self.root, dna::own_dsn_env()); }
    params {
        verb: String = "run";
        root: String = ".";
        seed: String = "."; // the application's seed, relative to the root
        fleet: String = "";
        plan: String = "";
        toolchain: String = "";
        port: String = "8787";
        iris: Bool = true;
        observe_secs: Int = 15;
        dna_dir: String = "";
        status_path: String = "";
        hale: String = "hale";
        org: Proc = Proc { };
        org_log: Int = 0;
        app: Proc = Proc { };
        app_log: Int = 0;
        app_bin: String = "";
        observer: Proc = Proc { };
        // GH #985, #1026: memory, as the spine — the graph and the org chart
        // projected from the record, an adoption the record asks for
        // carried out, redactions completed — on this node's tick, under
        // the record's spine role, beside any number of other nodes
        graph_projection: ops::MemoryProjection = ops::MemoryProjection { };
        adoption: dna::LedgerAdoption = dna::LedgerAdoption { };
        vault: dna::MemoryVault = dna::MemoryVault { };
        // this process's one handle on the ledger and the leases (GH #985):
        // opened on first use, held for the host's life, closed with it
        memory: dna::Memory = dna::Memory { };
        memory_on: Bool = false;
        memory_said: String = "";
        // GH #1026: the genome this node runs, pulled from the forge's
        // default branch every `genome_poll` seconds (HALE_DNA_GENOME_POLL;
        // 0 is never); a sha whose build failed is not restarted for again
        genome_sha: String = "";
        genome_poll: Int = 300;
        genome_polled: Int = 0;
        genome_failed: String = "";
        genome_said: String = ""; // the failed sha the poll has said it stays off
        genome_polls: Int = 0; // polls this node has made since it started
        org_ready: String = ""; // the organization's binary, built for `genome_sha`
        app_ready: String = ""; // the application's, under `dev`
        // GH #1091: a repository record (init on a directory with no Hale
        // source of its own) has no application: the organization runs
        // alone and oversees the repository's seeds
        repository: Bool = false;
        handled: String = "\n";
        app_gone_reported: Bool = false;
        exit_code: Int = 0;
        lease: BodyLease = BodyLease { }; // GH #617: this body's lease on the record
        holder: String = "";
        fence: Proc = Proc { }; // the second review of #622: the renewer that fences the organism
        // GH #986: the nerves, as the spine — the server and the
        // organization's token `dev` handed this host (HALE_DNA_NATS_URL_SPINE,
        // HALE_DNA_NATS_ORG); every publish is acknowledged by the stream.
        // Declared here, not passed in, so its failure reaches this host.
        nerves: nats::NatsConn = nats::NatsConn { url: dna::nerves_spine_url(), name: "dna-node", subject_prefix: dna::nerves_prefix_of(dna::nerves_org(), host_owner()), jetstream: true };
        nerves_on: Bool = false;
        relay: NodeRelay = NodeRelay { };
        // when this node last stopped an organization (monotonic ns; 0
        // never): its pulls outlive it for a pull's life
        org_stopped_at: Int = 0;
    }
    placement { nerves: pinned; }
    // Every topic the node publishes, onto the nerves: the record's
    // requests it relays, and the observation it reports.
    bindings {
        dna::IntentOffered: nats::NatsAdapter { };
        dna::ReviewVerdict: nats::NatsAdapter { };
        dna::ExpressionObserved: nats::NatsAdapter { };
        dna::PressureRaised: nats::NatsAdapter { };
        dna::ConcernRaised: nats::NatsAdapter { };
        dna::PracticeRequested: nats::NatsAdapter { };
        dna::HoldRequested: nats::NatsAdapter { };
        dna::KnowledgeNodeRequested: nats::NatsAdapter { };
        dna::KnowledgeBindingRequested: nats::NatsAdapter { };
        dna::KnowledgeEdgeRequested: nats::NatsAdapter { };
        dna::WorkSubmit: nats::NatsAdapter { };
        dna::RowLanded: nats::NatsAdapter { };
    }
    // A publish the stream did not acknowledge within the connection's
    // window collapses it here: a `nerves.lost` row says why, and the node
    // stops cleanly and exits with NODE_RESTART for its unit to start it
    // again: a fresh process, its connection and its organization's both
    // new, rather than one connection restarted in place beside an
    // organization that may be as stuck. The row first is what makes the
    // loss recoverable: the next node relays every request still
    // unanswered.
    on_failure(c: nats::NatsConn, err: ClosureViolation) {
        let why = c.last_error;
        self.say("nerves: " + why + "; stopping for the unit to start this node again");
        let ok = append_as(self.root, "nerves.lost", self.holder, "{\"why\": " + quote(why) + ", \"by\": \"host\"" + owner_json(self.root) + "}", "host", self.memory);
        self.stop_to_restart("nerves", dna::NODE_RESTART);
    }
    fn say(what: String) { eprintln("hale dna ", self.verb, ": ", what); }
    // `~/.config/hale-dna/<project>-<record>.env`: NAME=value lines, one per
    // credential, as `hale dna secret set` wrote them ("" when none).
    fn secrets_file() -> String {
        let home = std::env::var("HOME");
        if len(home) == 0 { return ""; }
        let text = std::io::fs::read_file(home + "/.config/hale-dna/" + body_key(self.root) + ".env") or "";
        return dna::trim_nl(text);
    }
    // GH #617: a missing credential surfaces at once — on the board and
    // in `status` — instead of on a task hours later. The catalog names
    // the credentials its hosted backends read; the body is short of one
    // when NONE of them is set here or in the secrets file. Rows only
    // name the variables.
    fn check_credentials() {
        let names = catalog_credentials(self.root);
        if len(names) == 0 { return; }
        let file = "\n" + self.secrets_file() + "\n";
        let mut have = false;
        let mut rest = names + " ";
        while len(rest) > 1 {
            let sp = std::str::index_of(rest, " ");
            let name = rest[0..sp];
            rest = rest[(sp + 1)..len(rest)];
            if len(name) > 0 && (std::env::var_exists(name) || std::str::contains(file, "\n" + name + "=")) { have = true; }
        }
        let p = open_projection(self.root, self.seed, self.toolchain, self.memory);
        let was_missing = len(credential_gap(p)) > 0;
        if !have && !was_missing {
            self.say("no credential for the model: none of " + names + " is set here or in ~/.config/hale-dna/" + body_key(self.root) + ".env (`hale dna secret set <NAME>`); the board says so until one is");
            let r = append_as(self.root, "body.credential_missing", "model", "{\"any_of\": " + quote(names) + ", \"holder\": " + quote(self.holder) + owner_json(self.root) + "}", "host", self.memory);
        }
        if !have && was_missing { self.say("no credential for the model (still): none of " + names + " is set"); }
        if have && was_missing {
            self.say("the model's credential is present now");
            let r = append_as(self.root, "body.credential_present", "model", "{\"holder\": " + quote(self.holder) + owner_json(self.root) + "}", "host", self.memory);
        }
    }
    // GH #617: the lease is asserted before every consequential act
    // (relay, restart, apply). The fence renews it beside the host and
    // writes what it proved to `body.fence.status`; the host reads that,
    // so a host blocked in a sync or a build holds nothing up (the second
    // review of #622). False once the lease is someone else's, released,
    // or past what the fence last proved: the body stops.
    fn body_alive() -> Bool {
        let now = std::time::now();
        // only this host's fence speaks for it: a line from the fence of a
        // host that ran here before (killed, its fence not yet gone) is not news
        let raw = dna::trim_nl(std::io::fs::read_file(self.dna_dir + "/body.fence.status") or "");
        let mine = to_string(std::process::pid()) + " ";
        let st = if std::str::starts_with(raw, mine) { raw[len(mine)..len(raw)] } else { "" };
        if std::str::starts_with(st, "ok ") {
            self.lease.expires = std::str::parse_int(st[3..len(st)]) or self.lease.expires;
        } else if std::str::starts_with(st, "lost") {
            let who = if len(st) > 5 { st[5..len(st)] } else { "" };
            self.say("the body lease is no longer mine: " + (if len(who) > 0 && who != self.holder { "held by " + who } else { "released" }) + "; a record admits one body — stopping");
            return false;
        } else if len(st) > 0 {
            self.say("the body lease could not be renewed and has expired (the remote cannot be reached); a body that cannot prove its lease executes nothing");
            return false;
        }
        if now >= self.lease.expires - FENCE_MARGIN {
            self.say("the body lease could not be renewed and has expired (the remote cannot be reached); a body that cannot prove its lease executes nothing");
            return false;
        }
        return true;
    }
    // The fence: a process of its own (this binary, `body-fence`) that
    // renews the lease every third of its life with every git call
    // bounded, and — when the lease is someone else's or released, when it
    // cannot prove the lease within FENCE_MARGIN of its expiry, or when the
    // host is gone — kills the organization and the expression by their
    // pid files and says why. It never waits on the host: a body executes
    // nothing past its TTL even while its host is blocked.
    fn start_fence() {
        std::io::fs::unlink(self.dna_dir + "/body.fence.status") or discard;
        // the mandate names this host: a fence left by a host that ran here
        // before stops at once, and kills nothing, when it reads another
        let m = write_text(self.dna_dir + "/body.fence", to_string(std::process::pid()) + "\n" + self.holder) or false;
        let exe = dna::run_tool("readlink\n-f\n/proc/" + to_string(std::process::pid()) + "/exe");
        // The fence is this host's own binary (`body-fence` is a host
        // verb). No /proc on macOS: its first mapped text is the
        // executable, as `lsof` reports it; argv[0] only as the last
        // resort, since a relative one resolves by cwd (GH #970).
        let own = if exe.code == 0 && len(dna::trim_nl(exe.stdout)) > 0 { dna::trim_nl(exe.stdout) } else { dna::trim_nl(dna::run_tool("sh\n-c\nlsof -a -p \"$1\" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -1\nsh\n" + to_string(std::process::pid())).stdout) };
        let bin = if len(own) > 0 { own } else { std::env::arg(0) };
        self.fence = start(self.dna_dir, "fence", self.root, "HALE_DNA_GIT_TIMEOUT=8",
            bin + "\nbody-fence\n.\n.\n-\n-\n--holder\n" + self.holder + "\n--token\n" + to_string(self.lease.token) + "\n--expires\n" + to_string(self.lease.expires) + "\n--host-pid\n" + to_string(std::process::pid()));
        if self.fence.pid <= 0 { self.say("the body fence did not start; a body that cannot fence its organism runs nothing"); std::process::exit(3); }
        // #638, #970: what the fence can reach on this machine. It stops
        // the sessions the organization and the expression began, which
        // hold every tool they started however it was regrouped or
        // reparented; only a tool that began a session of its own escapes
        // that, and the environment mark catches it where this machine
        // discloses another process's environment.
        if len(dna::body_scan()) == 0 {
            self.say("the body fence stops the organization's and the expression's sessions — every tool they started, orphaned or not; this machine shows no other process's environment, so a tool that began a session of its own (`setsid`) is not among them (GH #970)");
        }
    }
    fn stop_fence() {
        std::io::fs::unlink(self.dna_dir + "/body.fence") or discard;
        if self.fence.pid > 0 { stop_proc(self.fence); }
        self.fence = Proc { };
    }
    // What the body started, gone: the organization's and the expression's
    // trees, and every process carrying the body's mark wherever it is now.
    // Every exit once the lease is held runs it BEFORE the fence stops (the
    // fifth review of #622: a failed application build stopped the
    // organization's pid and then the fence, and its tool ran on).
    fn stop_started() {
        if self.org.pid > 0 { kill_tree(to_string(self.org.pid)); }
        if self.app.pid > 0 { kill_tree(to_string(self.app.pid)); }
        dna::kill_marked(dna::body_mark(self.holder, self.lease.token, std::process::pid()));
    }
    fn quit(code: Int) {
        self.stop_started();
        self.stop_fence();
        std::process::exit(code);
    }
    fn stop_body(code: Int) {
        self.stop_started();
        self.stop_fence();
        self.stop_org();
        if self.observer.pid > 0 { stop_proc(self.observer); }
        if self.app.pid > 0 { stop_proc(self.app); }
        std::io::fs::unlink(self.dna_dir + "/org.pid") or discard;
        std::io::fs::unlink(self.dna_dir + "/app.pid") or discard;
        std::process::exit(code);
    }
    fn seed_dir() -> String {
        if self.seed == "." || self.seed == "" { return self.root; }
        return self.root + "/" + self.seed;
    }
    fn app_name() -> String {
        let d = self.seed_dir();
        let sl = last_index_of(d, "/");
        return if sl < 0 { d } else { d[(sl + 1)..len(d)] };
    }
    // Cut the artifact of what is about to run ("" = failed).
    fn cut_artifact(seed_dir: String, artifact: String) -> String {
        let c = dna::run_tool(self.hale + "\ncheck\n" + seed_dir + "\n--dump-topology=" + artifact);
        if c.code != 0 { return "`hale check " + seed_dir + "` failed; nothing is run on a program that does not pass"; }
        return "";
    }
    // Build a seed; its binary path, or "" (the error said).
    // The lease proved again at the moment a process starts: read from
    // the record's authority now, and still this host's under the token it
    // took. A build longer than the lease's life, during which another
    // body took the lease, starts nothing (the review of GH #617: the
    // organism must never run under a lease that is not ours).
    fn body_assert(what: String) -> Bool {
        let now = std::time::now();
        let r = body_lease_read(self.root, self.memory);
        if r.ok && (!r.present || r.holder != self.holder || r.token != self.lease.token) {
            self.say("before starting " + what + ": the body lease is no longer mine (" + (if len(r.holder) > 0 && r.holder != self.holder { "held by " + r.holder } else { "released" }) + "); nothing is started");
            return false;
        }
        if !self.body_alive() {
            self.say("before starting " + what + ": the body lease could not be proved; nothing is started");
            return false;
        }
        if r.ok && r.expires > self.lease.expires { self.lease.expires = r.expires; }
        return true;
    }
    // A seed is built ONCE per content fingerprint and copied
    // thereafter (see `build_cache_dir` above): every start and every
    // restart of an organism whose sources did not move re-emitted the
    // IR for the whole vendored core, 3.8s of it, for a binary that
    // could only come out the same. A miss builds exactly as before.
    fn build_seed(seed_dir: String) -> String {
        let sl = last_index_of(seed_dir, "/");
        let bin = seed_dir + "/" + (if sl < 0 { seed_dir } else { seed_dir[(sl + 1)..len(seed_dir)] });
        let cache = build_cache_dir();
        let key = if len(cache) > 0 { build_fingerprint(self.hale, self.root, seed_dir) } else { "" };
        let entry = if len(key) > 0 { cache + "/" + key } else { "" };
        if len(entry) > 0 && build_cache_take(entry, bin) { return bin; }
        let b = dna::run_tool(self.hale + "\nbuild\n" + seed_dir);
        if b.code != 0 { self.say("`hale build " + seed_dir + "` failed"); return ""; }
        if !std::io::fs::file_exists(bin) { self.say("no binary at " + bin); return ""; }
        if len(entry) > 0 { build_cache_keep(entry, bin, cache); }
        return bin;
    }
    fn sha12(bin: String) -> String {
        let h = dna::sha256_file(bin);
        if len(h) < 12 { return ""; }
        return h[0..12];
    }
    fn child_envs(restart_for: String, expression: String) -> String {
        // GH #583: the genome a harness must never reach, whatever its
        // role. A HarnessModel reads it at birth (finding 1).
        let mut e = "LOTUS_OBS=1\nHALE_BIN=" + self.hale + "\nHALE_DNA_GENOME=" + self.root;
        // GH #617: the credentials `hale dna secret set` put on this
        // machine, for the organization and the knowledge service
        let file = self.secrets_file();
        if len(file) > 0 { e = e + "\n" + file; }
        // the fourth review of #622: the body's mark, inherited by every tool
        // a child starts, so the fence finds them even once that child is gone
        // GH #1026: and the node's name in the claims its organism takes
        if len(self.holder) > 0 { e = e + "\nHALE_DNA_BODY=" + dna::body_mark(self.holder, self.lease.token, std::process::pid()) + "\nHALE_DNA_NODE=" + self.holder; }
        if len(restart_for) > 0 { e = e + "\nHALE_DNA_RESTART_FOR=" + restart_for + "\nHALE_DNA_EXPRESSION=" + expression; }
        // GH #664: which owner this body is, over a shared record
        let me = owner_here(self.root);
        if len(me) > 0 { e = e + "\nHALE_DNA_OWNER=" + me; }
        // GH #665: the lease the body holds and its epoch; every ledger
        // write the organism makes carries them, and the service refuses
        // one under a lease it no longer holds
        if len(self.holder) > 0 && body_in_store(self.root) { e = e + "\nHALE_DNA_LEASE=" + store_lease_key(self.root) + "\nHALE_DNA_LEASE_TOKEN=" + to_string(self.lease.token); }
        return e;
    }
    // ---- memory, as the spine (GH #985) ----------------------------------
    // `dev` applies memory's schema before the host starts: the driver runs
    // `memory-migrate` with the owner's DSN and hands the host only the
    // record's spine DSN, which the organization inherits. The host refuses
    // a memory at another schema version, naming both; without a DSN it
    // says so and runs with no memory (nothing is projected or admitted).
    fn start_memory() {
        if !dna::dsn_set(dna::SPINE_DSN_ENV) {
            self.say("no memory: " + dna::SPINE_DSN_ENV + " is not set (`hale dna dev` applies memory's schema from HALE_DNA_MEMORY_DSN_OWNER or dna/compose.yaml and hands the host the spine's DSN); nothing is projected or admitted");
            return;
        }
        let fence = memory_fence_for(std::env::var(dna::SPINE_DSN_ENV), self.root);
        if len(fence) > 0 { self.say("memory: " + fence); self.quit(2); }
        self.graph_projection.root = self.root;
        self.graph_projection.j.repo = self.root;
        self.graph_projection.j.record.repo = self.root;
        self.graph_projection.receipts.repo = self.root;
        self.adoption.root = self.root;
        self.adoption.j.repo = self.root;
        self.adoption.j.record.repo = self.root;
        self.adoption.ledger.repo = self.root;
        self.adoption.carry_cell = BODY_LEASE;
        self.adoption.carry_key = store_lease_key(self.root);
        self.adoption.holder = self.holder;
        self.vault.repo = self.root;
        self.vault.j.repo = self.root;
        self.vault.j.record.repo = self.root;
        self.memory_on = true;
        self.say("memory: the graph, the ledger and protected evidence under the record's spine role");
    }
    // One pass of the spine's memory work (GH #985, #1026), which every
    // node does and none coordinates: the record applied into the graph
    // and the org chart, an adoption or abandonment the record asks for
    // carried out under a claim, the redactions the record holds erased.
    // The stores serialize them — the projection a row at a time, the
    // adoption by its claim, the erasure by digest. The projection goes
    // only as far as the record the remote holds after this tick's sync,
    // so a stamped row is always a shared one: a node that projected a row
    // it never shared and then died would leave every other node waiting
    // on a commit none of them can receive. With no remote there is one
    // clone, and nothing to wait on. What failed is said once, when it
    // changes, and tried again next tick.
    fn memory_tick(synced: Bool) {
        if !self.memory_on { return; }
        let remote = len(record_remote(self.root)) > 0;
        let shared = if remote { rec(self.root).head(REMOTE_JOURNAL) } else { dna::Head { } };
        let applied = if !synced { ops::ProjectionApplied { } } else if remote { self.graph_projection.apply_to(if shared.ok && !shared.absent { shared.id } else { "" }) } else { self.graph_projection.apply() };
        let adopted = self.adoption.tick(self.memory.leases);
        let erased = self.vault.complete_redactions();
        let mut why = "";
        if !synced { why = "projection waits for the record to be shared (the sync did not complete)"; }
        if len(applied.error) > 0 { why = "projection: " + applied.error; }
        if adopted < 0 { why = why + (if len(why) > 0 { "; " } else { "" }) + "adoption: " + self.adoption.last_error; }
        if erased < 0 { why = why + (if len(why) > 0 { "; " } else { "" }) + "redaction: " + self.vault.last_error; }
        if why != self.memory_said {
            if len(why) > 0 { self.say("memory: " + why); } else if len(self.memory_said) > 0 { self.say("memory: answering again"); }
            self.memory_said = why;
        }
    }
    // ---- the genome pull (GH #1026) ---------------------------------------
    // Nodes converge on the genome by pulling. At start a node fetches the
    // forge's default branch, moves its genome forward to it, and checks
    // and builds it; a genome that does not check or build is a
    // `node.build_failed` row, and the node goes back to the last genome
    // that built (`.hale/dna/genome.built`) and serves that. On its tick,
    // every `genome_poll` seconds, it fetches again; when the forge's head
    // moved past what it runs it stops cleanly and exits with
    // GENOME_RESTART, and its unit (`Restart=always`) starts it again on
    // the new genome — never an exec in place.
    fn prepare_genome() -> Bool {
        let knob = if std::env::var_exists("HALE_DNA_GENOME_POLL") { std::env::var("HALE_DNA_GENOME_POLL") } else { "" };
        self.genome_poll = if len(knob) > 0 { std::str::parse_int(knob) or 300 } else { 300 };
        let remote = record_remote(self.root);
        if len(remote) > 0 && self.genome_poll > 0 {
            let target = genome_fetch_default(self.root, remote);
            if len(target) == 0 { self.say("genome: the forge's default branch could not be fetched; running the genome here"); }
            else {
                let why = genome_fast_forward(self.root, target);
                if len(why) > 0 { self.say("genome: " + why); }
            }
        }
        self.genome_polled = std::time::now();
        self.genome_sha = genome_commit(self.root, "HEAD");
        let why = self.build_genome();
        if len(why) == 0 { self.keep_genome(); return true; }
        let kept = dna::trim_nl(std::io::fs::read_file(self.dna_dir + "/genome.built") or "");
        if len(kept) == 0 || kept == self.genome_sha { self.say(why); return false; }
        let failed = self.genome_sha;
        self.genome_row("node.build_failed", why);
        self.say("genome " + short(failed) + " does not build (" + why + "); staying on " + short(kept));
        if !genome_reset(self.root, kept) { self.say("genome: this clone cannot go back to " + short(kept)); return false; }
        self.genome_failed = failed;
        self.genome_sha = kept;
        let again = self.build_genome();
        if len(again) > 0 { self.say(again); return false; }
        return true;
    }
    // Whether the seed holds no Hale source of its own: a repository record,
    // with no application to check, build or express (GH #1091).
    fn no_application() -> Bool {
        return dna::run_tool("sh\n-c\nls \"$1\"/*.hl >/dev/null 2>&1\nsh\n" + self.seed_dir()).code != 0;
    }
    // The genome as it stands, checked and built: "" when it did, else why.
    fn build_genome() -> String {
        self.repository = self.no_application();
        if !self.repository {
            let cut = self.cut_artifact(self.seed_dir(), self.dna_dir + "/current.topology");
            if len(cut) > 0 { return cut; }
        }
        self.org_ready = self.build_seed(self.root + "/" + ORG_SEED);
        if len(self.org_ready) == 0 { return "`hale build " + ORG_SEED + "` failed"; }
        if self.verb == "dev" && !self.repository {
            self.app_ready = self.build_seed(self.seed_dir());
            if len(self.app_ready) == 0 { return "`hale build " + self.seed_dir() + "` failed"; }
        }
        return "";
    }
    // `.hale/dna/genome.json`: the sha this node runs, the one that did not
    // build (if any), and how many polls it has made since it started.
    fn write_genome() {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("sha", self.genome_sha);
        b.string_field("failed", self.genome_failed);
        b.int_field("polls", self.genome_polls);
        b.end_object();
        let tmp = self.dna_dir + "/genome.json.tmp";
        let w = write_text(tmp, b.result()) or false;
        if w { std::io::fs::rename(tmp, self.dna_dir + "/genome.json") or discard; }
    }
    fn keep_genome() {
        let w = write_text(self.dna_dir + "/genome.built", self.genome_sha + "\n") or false;
    }
    // `node.started` / `node.build_failed` <holder>: the sha this node runs
    // (and for a failure, the sha that did not build and why).
    fn genome_row(kind: String, why: String) {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("sha", self.genome_sha);
        if len(why) > 0 { b.string_field("why", why); }
        b.string_field("by", "host");
        b.end_object();
        let body = b.result();
        let o = owner_json(self.root);
        let full = if len(o) > 0 { body[0..(len(body) - 1)] + o + "}" } else { body };
        let ok = append_as(self.root, kind, self.holder, full, "host", self.memory);
    }
    fn poll_genome() {
        if self.genome_poll <= 0 { return; }
        let now = std::time::now();
        if now - self.genome_polled < self.genome_poll { return; }
        self.genome_polled = now;
        let remote = record_remote(self.root);
        if len(remote) == 0 { return; }
        let target = genome_fetch_default(self.root, remote);
        self.genome_polls = self.genome_polls + 1;
        self.write_genome();
        if target == self.genome_failed && self.genome_said != target {
            self.genome_said = target;
            self.say("genome: the forge's default branch is at " + short(target) + ", which did not build here; staying on " + short(self.genome_sha));
        }
        if len(target) == 0 || target == self.genome_sha || target == self.genome_failed { return; }
        self.say("genome: the forge's default branch is at " + short(target) + " and this node runs " + short(self.genome_sha) + "; restarting to take it");
        self.restart_for_genome();
    }
    // Stop cleanly — the organization and the expression drain on SIGTERM —
    // give the body lease back, and exit for the unit to start this node
    // again on the new genome.
    fn restart_for_genome() { self.stop_to_restart("genome", GENOME_RESTART); }
    // Stop cleanly, give the lease back naming `why`, and exit with `code`
    // for the supervisor to start this node again.
    fn stop_to_restart(why: String, code: Int) {
        self.stop_org();
        if self.observer.pid > 0 { stop_proc(self.observer); }
        if self.app.pid > 0 { stop_proc(self.app); }
        self.stop_started();
        std::io::fs::unlink(self.dna_dir + "/org.pid") or discard;
        std::io::fs::unlink(self.dna_dir + "/app.pid") or discard;
        self.stop_fence();
        if body_release(self.root, self.lease, self.memory) {
            let released = append_as(self.root, "body.released", self.holder, "{\"token\": " + to_string(self.lease.token) + ", \"by\": \"host\", \"why\": " + quote(why) + owner_json(self.root) + "}", "host", self.memory);
        }
        let s = sync_record(self.root, self.memory);
        std::process::exit(code);
    }
    // Stop the organization, noting when: its outstanding pull on the
    // stream lives on for a pull's life (wait_nerves).
    fn stop_org() {
        stop_proc(self.org);
        self.org_stopped_at = std::time::monotonic_ns();
    }
    // Whether the organization this host just started comes to read its
    // facts within `secs` (GH #986): its durable consumer on the stream
    // has a pull outstanding. A pull the organization this node stopped
    // left behind counts for nothing until its life is over, so a pull
    // seen before then is not this organization's. Without nerves there
    // is nothing to read; an organization still running is all there is.
    fn wait_nerves(secs: Int) -> Bool {
        let deadline = std::time::now() + secs;
        if !self.nerves_on { return exit_code(self.org) == -2; }
        let stale_until = if self.org_stopped_at > 0 { self.org_stopped_at + NERVES_PULL_LIFE_MS * 1000000 } else { 0 };
        let c = nats::NatsClient { url: dna::nerves_spine_url(), name: "dna-node-probe", timeout: 2s };
        let mut why = "";
        while true {
            if exit_code(self.org) != -2 { c.close(); return false; }
            if std::time::monotonic_ns() < stale_until {
                why = "the stopped organization's pull has not expired yet";
            } else if c.connected || c.open() {
                why = nerves_listening(c, dna::nerves_org(), owner_here(self.root));
                if len(why) == 0 { c.close(); return true; }
            } else { why = c.last_error; }
            if std::time::now() > deadline { self.say("nerves: the organization is not reading its facts (" + why + ")"); c.close(); return false; }
            std::time::sleep(100ms);
        }
        return false;
    }
    fn write_status() {
        // no record, or one that could not be read: nothing to do this pass
        let now = record_head(self.root);
        if !now.ok || now.absent { return; }
        let p = open_projection(self.root, self.seed, self.toolchain, self.memory);
        p.live = true;
        let tmp = self.status_path + ".tmp";
        let w = write_text(tmp, p.json()) or false;
        if w { std::io::fs::rename(tmp, self.status_path) or discard; }
    }
    fn launch_iris(diff_from: String) {
        let current = self.dna_dir + "/current.topology";
        let mut argv = self.hale + "\niris\n" + self.port + "\n" + current;
        if len(diff_from) > 0 { argv = argv + "\n--diff\n" + diff_from + "\n" + current; }
        self.observer = start(self.dna_dir, "iris", self.root, "", argv);
        if self.observer.pid > 0 { eprintln("hale dna run: iris at http://127.0.0.1:", self.port, "/"); }
        else { eprintln("hale dna run: could not launch hale iris"); }
    }
    fn observed(mutation_id: String, outcome: String, model_hash: String, detail: String) {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("mutation_id", mutation_id);
        b.string_field("outcome", outcome);
        b.string_field("model_hash", model_hash);
        b.string_field("detail", detail);
        b.end_object();
        // GH #682, #986: the report is a row first, like every request —
        // `observation.requested`, which the relay publishes as
        // ExpressionObserved until the organism answers it with
        // `expression.observed`. This node is inside its own tick here, so
        // it relays while it waits for the answer.
        if !append_as(self.root, "observation.requested", mutation_id, b.result(), "host", self.memory) {
            self.say("the " + outcome + " observation of " + mutation_id + " was not written into the record");
            return;
        }
        let deadline = std::time::now() + OBSERVATION_WAIT;
        while std::time::now() <= deadline {
            let n = self.relay.relay(self.memory);
            if self.observation_landed(mutation_id, outcome, 1) { return; }
        }
        self.say("the organism has not recorded the " + outcome + " observation of " + mutation_id + " yet; the relay goes on publishing it until it does");
    }
    // Whether `expression.observed <id>` with `outcome` is in the record,
    // waiting up to `secs` for it.
    @unbounded
    fn observation_landed(mutation_id: String, outcome: String, secs: Int) -> Bool {
        let deadline = std::time::now() + secs;
        while std::time::now() <= deadline {
            let p = open_projection(self.root, self.seed, self.toolchain, self.memory);
            let mut i = 0;
            while i < p.rows() {
                let e = p.row(i);
                if e.kind == "expression.observed" && e.entity == mutation_id && std::str::starts_with(e.body, outcome + " ") { return true; }
                i = i + 1;
            }
            std::time::sleep(500ms);
        }
        return false;
    }
    // Rebuild the organization and restart it for a Mutation of its own
    // seed: the old one stopped, the new org up with the Mutation in its
    // environment. True when it reads its facts from the nerves.
    // Durable identity precedes process replacement. Building/retaining exact
    // candidate inputs is preparatory; only an acknowledged new claim permits
    // start. A later call returns the existing attempt without rebuilding it.
    fn prepare_organization_launch(id: String) -> OrganizationLaunchPreparation {
        let source = org_runtime::OrganizationLaunchSource { root: self.root }; let basis = source.basis(id);
        if !basis.ok || !self.body_assert("the prepared organization") { return OrganizationLaunchPreparation { }; }
        let codec = dna::OrganizationLaunchCodec { }; let attempt_id = codec.attempt_id(basis.handoff.digest);
        let record = dna::GitJournal { repo: self.root }; let facts = dna::OrganizationSourceRequestCodec { };
        let previous = facts.fact(record, "organization.source.launch_requested", attempt_id);
        if len(previous.kind) > 0 {
            let a = source.attempt(basis); return OrganizationLaunchPreparation { valid: codec.valid(a), attempt: a };
        }
        let guard = orgsource::OrganizationPublicationInputs { root: self.root, compiler: self.hale, source_owner: basis.request.source_owner };
        if !guard.available() || !guard.applied(basis.request, basis.worktree, basis.candidate).ok { return OrganizationLaunchPreparation { }; }
        let shell = dna::OrganizationLaunchAttempt { attempt_id: attempt_id };
        let dir = source.directory(shell);
        let mkdir = dna::run_tool("mkdir\n-p\n" + dir); if mkdir.code != 0 { return OrganizationLaunchPreparation { }; }
        if std::io::fs::file_exists(dir + "/org.pid") || std::io::fs::file_exists(dir + "/org.exit") { return OrganizationLaunchPreparation { }; }
        let artifact = dir + "/topology.json"; let seed_dir = basis.worktree + "/" + ORG_SEED;
        if len(self.cut_artifact(seed_dir, artifact)) > 0 || !guard.applied(basis.request, basis.worktree, basis.candidate).ok { return OrganizationLaunchPreparation { }; }
        let built = self.build_seed(seed_dir); if len(built) == 0 || !guard.applied(basis.request, basis.worktree, basis.candidate).ok { return OrganizationLaunchPreparation { }; }
        let copied = dna::run_tool("cp\n" + built + "\n" + dir + "/program"); if copied.code != 0 { return OrganizationLaunchPreparation { }; }
        let permission = dna::run_tool("chmod\n0555\n" + dir + "/program"); if permission.code != 0 { return OrganizationLaunchPreparation { }; }
        let binary = source.file_digest(dir + "/program"); let topology = source.file_digest(artifact);
        if binary != source.file_digest(built) || !guard.applied(basis.request, basis.worktree, basis.candidate).ok || !self.body_assert("the exact prepared organization") { return OrganizationLaunchPreparation { }; }
        let receipts = dna::GitReceipts { repo: self.root }; let artifact_text = std::io::fs::read_file(artifact) or "";
        let kept = receipts.store(artifact_text); if "sha256:" + kept != topology { return OrganizationLaunchPreparation { }; }
        let identity = identity::Identity { };
        let a = dna::OrganizationLaunchAttempt { attempt_id: attempt_id, application_id: basis.request.application_id,
            request_id: basis.request.request_id, command_fingerprint: basis.request.command_fingerprint, source_owner: basis.request.source_owner,
            mutation_id: id, candidate_commit: basis.candidate, source_digest: basis.request.source_digest,
            applied_event_id: basis.applied.digest, restart_event_id: basis.handoff.digest, body_holder: self.holder, body_token: self.lease.token,
            host_pid: std::process::pid(), host_started: identity.start_ticks(std::process::pid()), binary_digest: binary,
            topology_digest: topology, topology_shape: shape_of(artifact), observation_seconds: self.observe_secs };
        if !codec.valid(a) { return OrganizationLaunchPreparation { }; }
        let written = organization_launch_write(self.root, "organization.source.launch_requested", a.attempt_id, codec.attempt_body(a), self.memory);
        return OrganizationLaunchPreparation { valid: written.ok, fresh: written.fresh, attempt: a };
    }
    // Kept separate from acknowledgment so a lost reply recovers this exact
    // owned process. This method is never called for an existing claim.
    fn start_organization_launch(prepared: OrganizationLaunchPreparation) -> Bool {
        let a = prepared.attempt; let codec = dna::OrganizationLaunchCodec { }; let source = org_runtime::OrganizationLaunchSource { root: self.root };
        if !prepared.valid || !prepared.fresh || !codec.valid(a) || a.host_pid != std::process::pid() || !source.scope(a, self.memory.leases) { return false; }
        let requested = source.fact("organization.source.launch_requested", a.attempt_id);
        let basis = source.basis(a.mutation_id);
        let guard = orgsource::OrganizationPublicationInputs { root: self.root, compiler: self.hale, source_owner: a.source_owner };
        if requested.body != codec.attempt_body(a) || !source.matches(a, basis)
            || !guard.applied(basis.request, basis.worktree, basis.candidate).ok || !self.body_assert("the retained prepared organization") { return false; }
        let dir = source.directory(a);
        if std::io::fs::file_exists(dir + "/org.pid") || source.file_digest(dir + "/program") != a.binary_digest
            || source.file_digest(dir + "/topology.json") != a.topology_digest { return false; }
        self.stop_org();
        if !self.body_assert("the retained prepared organization") { return false; }
        self.org = start(dir, "org", self.root, self.child_envs(a.mutation_id, a.binary_digest) + "\nHALE_DNA_ORGANIZATION_LAUNCH=" + a.attempt_id, dir + "/program");
        self.org_log = 0;
        let pid = write_text(self.dna_dir + "/org.pid", to_string(self.org.pid)) or false;
        let artifact = dna::run_tool("cp\n" + dir + "/topology.json\n" + self.dna_dir + "/org.topology");
        return self.org.pid > 0 && pid && artifact.code == 0;
    }
    fn note_organization_exit(a: dna::OrganizationLaunchAttempt) -> Bool {
        let source = org_runtime::OrganizationLaunchSource { root: self.root }; let codec = dna::OrganizationLaunchCodec { };
        if !source.scope(a, self.memory.leases) || a.host_pid != std::process::pid() { return false; }
        let read = source.process(a); let proc = Proc { pid: read.pid, dir: read.dir, name: read.name }; let code = exit_code(proc);
        if proc.pid < 1 || code < 0 { return false; }
        return organization_launch_write(self.root, "organization.source.launch_exited", a.attempt_id, codec.exit_body(a, proc.pid, code), self.memory).ok;
    }
    fn recover_organization_launch(id: String) -> dna::OrganizationLaunchReceipt {
        let source = org_runtime::OrganizationLaunchSource { root: self.root }; let basis = source.basis(id); let a = source.attempt(basis); let codec = dna::OrganizationLaunchCodec { };
        if !codec.valid(a) || a.host_pid != std::process::pid() || !source.scope(a, self.memory.leases) || !self.body_assert("the same prepared organization attempt") { return dna::OrganizationLaunchReceipt { }; }
        let read = source.process(a); let proc = Proc { pid: read.pid, dir: read.dir, name: read.name }; let exited = exit_code(proc);
        if proc.pid > 0 && exited >= 0 {
            let saved = organization_launch_write(self.root, "organization.source.launch_exited", a.attempt_id, codec.exit_body(a, proc.pid, exited), self.memory);
            return dna::OrganizationLaunchReceipt { };
        }
        if proc.pid <= 0 { return dna::OrganizationLaunchReceipt { }; }
        self.org = proc;
        if !self.wait_nerves(20) { let noted = self.note_organization_exit(a); return dna::OrganizationLaunchReceipt { }; }
        let live = source.live(a, self.memory.leases); if !live.valid { let noted = self.note_organization_exit(a); return dna::OrganizationLaunchReceipt { }; }
        let existing = source.launched(a);
        if existing.valid {
            return if existing.pid == live.pid && existing.process_key == live.process_key && existing.process_started == live.process_started { existing } else { dna::OrganizationLaunchReceipt { } };
        }
        let guard = orgsource::OrganizationPublicationInputs { root: self.root, compiler: self.hale, source_owner: a.source_owner };
        if !guard.applied(basis.request, basis.worktree, basis.candidate).ok { return dna::OrganizationLaunchReceipt { }; }
        let pid = write_text(self.dna_dir + "/org.pid", to_string(live.pid)) or false; if !pid { return dna::OrganizationLaunchReceipt { }; }
        let saved = organization_launch_write(self.root, "organization.source.launched", a.attempt_id, codec.launch_body(a, live.pid, live.process_key, live.process_started), self.memory);
        return if saved.ok { source.launched(a) } else { dna::OrganizationLaunchReceipt { } };
    }
    fn rollback_organization_launch(basis: org_runtime::OrganizationLaunchBasis, code: Int) -> Bool {
        let source = org_runtime::OrganizationLaunchSource { root: self.root }; let a = source.attempt(basis); let codec = dna::OrganizationLaunchCodec { };
        let rollback = OrganizationRollbackCodec { }; let guard = orgsource::OrganizationPublicationInputs { root: self.root, compiler: self.hale, source_owner: a.source_owner };
        let exited = source.exited(a); let failure = source.fact("organization.source.launch_exited", a.attempt_id);
        if !basis.ok || !codec.valid(a) || !exited.valid || code != exited.code || !source.scope(a, self.memory.leases) || a.host_pid != std::process::pid()
            || !self.body_assert("the prepared organization rollback") { return false; }
        if rollback.answered(source, basis, a) { return true; }
        let id = a.mutation_id;
        let old_claim = source.fact("organization.source.rollback_requested", a.attempt_id);
        if len(old_claim.kind) == 0 {
            // Only this still-exact failed candidate may authorize a reset.
            if genome_commit(self.root, "HEAD") != basis.candidate || !guard.applied(basis.request, basis.worktree, basis.candidate).ok { return false; }
            let saved = organization_launch_write(self.root, "organization.source.rollback_requested", a.attempt_id,
                rollback.reset(a, failure.digest, basis.request.source_head), self.memory);
            if !saved.ok { return false; }
            // An unacknowledged claim is not permission to repeat the reset.
            if saved.fresh && !genome_reset(self.root, basis.request.source_head) { return false; }
        }
        let reset_claim = rollback.claimed(source, basis, a);
        // A lost reset reply can be repaired only from the exact original base,
        // current module bytes and dependencies. No repeated reset on a claim.
        if len(reset_claim.kind) == 0 || genome_commit(self.root, "HEAD") != basis.request.source_head || !guard.current(basis.request).ok { return false; }
        let crashed = organization_launch_write(self.root, "expression.crashed", id, "organization exited " + to_string(code) + " in the prepared launch", self.memory);
        if !crashed.ok { return false; }
        let recorded = organization_launch_write(self.root, "mutation.rolled_back", id, basis.request.source_head + " by host after the organization crashed", self.memory);
        if !recorded.ok { return false; }
        let rolled_back = rollback.rolled_back(source, basis, a); if len(rolled_back.kind) == 0 { return false; }
        let dir = source.directory(a); let mut fresh = false;
        let old_launch = source.fact("organization.source.rollback_launch_requested", a.attempt_id);
        if len(old_launch.kind) == 0 {
            if std::io::fs::file_exists(dir + "/rollback.pid") || std::io::fs::file_exists(dir + "/rollback.exit") { return false; }
            let artifact = dir + "/rollback.topology"; let base_seed = self.root + "/" + ORG_SEED;
            if len(self.cut_artifact(base_seed, artifact)) > 0 || !guard.current(basis.request).ok { return false; }
            let built = self.build_seed(base_seed); if len(built) == 0 || !guard.current(basis.request).ok { return false; }
            let copied = dna::run_tool("cp\n" + built + "\n" + dir + "/rollback.program");
            let mode = dna::run_tool("chmod\n0555\n" + dir + "/rollback.program");
            let binary = source.file_digest(dir + "/rollback.program"); let topology = source.file_digest(artifact);
            if copied.code != 0 || mode.code != 0 || binary != source.file_digest(built) || !guard.current(basis.request).ok || !self.body_assert("the original organization") { return false; }
            let saved = organization_launch_write(self.root, "organization.source.rollback_launch_requested", a.attempt_id,
                rollback.launch(a, rolled_back.digest, binary, topology), self.memory);
            if !saved.ok { return false; } fresh = saved.fresh;
        }
        let claim = rollback.launch_claim(source, basis, a); if !claim.valid { return false; }
        if fresh {
            if !source.scope(a, self.memory.leases) || !guard.current(basis.request).ok || source.file_digest(dir + "/rollback.program") != claim.binary_digest
                || source.file_digest(dir + "/rollback.topology") != claim.topology_digest { return false; }
            self.stop_org(); if !self.body_assert("the original organization") { return false; }
            self.org = start(dir, "rollback", self.root, self.child_envs(id, "rollback " + claim.binary_digest), dir + "/rollback.program"); self.org_log = 0;
        } else {
            let pid = std::str::parse_int(dna::trim_nl(std::io::fs::read_file(dir + "/rollback.pid") or "")) or - 1;
            self.org = Proc { pid: pid, dir: dir, name: "rollback" };
        }
        if self.org.pid <= 0 || exit_code(self.org) != -2 || !self.wait_nerves(20) { return false; }
        let process = identity::Identity { }; let before = process.capture(self.org.pid);
        if len(before.key) == 0 || source.file_digest("/proc/" + self.org.pid + "/exe") != claim.binary_digest
            || source.file_digest(dir + "/rollback.program") != claim.binary_digest || source.file_digest(dir + "/rollback.topology") != claim.topology_digest
            || !guard.current(basis.request).ok || !source.scope(a, self.memory.leases) { return false; }
        let after = process.capture(self.org.pid); if before.key != after.key || before.started != after.started { return false; }
        let pid = write_text(self.dna_dir + "/org.pid", to_string(self.org.pid)) or false;
        let artifact = dna::run_tool("cp\n" + dir + "/rollback.topology\n" + self.dna_dir + "/org.topology"); if !pid || artifact.code != 0 { return false; }
        let saved = organization_launch_write(self.root, "organization.source.rollback_launched", a.attempt_id,
            rollback.launched(a, claim.event_id, self.org.pid, after.key, after.started), self.memory);
        return saved.ok && rollback.answered(source, basis, a);
    }
    fn answer_prepared_org(id: String) -> Bool {
        let source = org_runtime::OrganizationLaunchSource { root: self.root }; let basis = source.basis(id);
        let prepared = self.prepare_organization_launch(id); let codec = dna::OrganizationLaunchCodec { };
        if !prepared.valid { return false; }
        if prepared.fresh { let started = self.start_organization_launch(prepared); }
        let launched = self.recover_organization_launch(id);
        if !launched.valid {
            let exited = source.exited(prepared.attempt);
            return if exited.valid { self.rollback_organization_launch(basis, exited.code) } else { false };
        }
        let previous = source.observed(launched);
        if previous.valid {
            if previous.outcome == "healthy" { self.observed(id, "healthy", launched.attempt.binary_digest, "organization launch " + launched.attempt.attempt_id + " observed healthy"); return prepared_source_restart_answered(open_projection(self.root, self.seed, self.toolchain, self.memory), basis.handoff); }
            let exited = source.exited(prepared.attempt);
            return if exited.valid { self.rollback_organization_launch(basis, exited.code) } else { false };
        }
        let first = source.live(launched.attempt, self.memory.leases);
        if !first.valid || first.process_key != launched.process_key { return false; }
        let began = std::time::now(); let end = began + launched.attempt.observation_seconds; let mut code = -2;
        while std::time::now() < end && code == -2 {
            if !self.body_alive() { return false; }
            code = exit_code(self.org); self.org_log = drain_log(self.org, self.org_log); std::time::sleep(100ms);
        }
        code = exit_code(self.org);
        if code >= 0 {
            if !self.note_organization_exit(launched.attempt) { return false; }
            let saved = organization_launch_write(self.root, "organization.source.launch_observed", launched.attempt.attempt_id,
                codec.observation_body(launched, "crashed", began, std::time::now()), self.memory);
            return if saved.ok { self.rollback_organization_launch(basis, code) } else { false };
        }
        let after = source.live(launched.attempt, self.memory.leases);
        if !after.valid || after.pid != launched.pid || after.process_key != launched.process_key || after.process_started != launched.process_started { return false; }
        let saved = organization_launch_write(self.root, "organization.source.launch_observed", launched.attempt.attempt_id,
            codec.observation_body(launched, "healthy", began, std::time::now()), self.memory);
        if !saved.ok { return false; }
        self.observed(id, "healthy", launched.attempt.binary_digest, "organization launch " + launched.attempt.attempt_id + " observed healthy");
        return prepared_source_restart_answered(open_projection(self.root, self.seed, self.toolchain, self.memory), basis.handoff);
    }
    fn restart_org(id: String, rollback: Bool) -> Bool {
        let org_seed = self.root + "/" + ORG_SEED;
        let art = self.dna_dir + "/org.topology";
        let cut = self.cut_artifact(org_seed, art);
        if len(cut) > 0 { self.say(id + ": the organization does not express: " + cut); if !rollback { self.observed(id, "build_failed", "", cut); } return false; }
        let bin = self.build_seed(org_seed);
        if len(bin) == 0 { self.say(id + ": the organization does not express"); if !rollback { self.observed(id, "build_failed", "", "build failed"); } return false; }
        let expression = (if rollback { "rollback " } else { "" }) + shape_of(art) + " build " + self.sha12(bin);
        self.stop_org();
        if !self.body_assert("the organization again") { self.stop_body(3); }
        self.org = start(self.dna_dir, "org", self.root, self.child_envs(id, expression), bin);
        self.org_log = 0;
        let w = write_text(self.dna_dir + "/org.pid", to_string(self.org.pid)) or false;
        eprintln("hale dna: organization restarted (pid ", self.org.pid, ") as ", expression);
        return self.wait_nerves(20);
    }
    // The window over the touched instances of a fleet deploy.
    @unbounded
    fn fleet_window(rev: String, touched: String, deploy_seq: Int, settle_secs: Int) -> FleetOutcome {
        let settle = std::time::now() + settle_secs;
        let mut all_up_at = -1;
        let mut shape = "";
        while true {
            let s = sync_record(self.root, self.memory);
            self.write_status();
            let p = open_projection(self.root, self.seed, self.toolchain, self.memory);
            let mut missing = "";
            let mut rest = touched + " ";
            while len(rest) > 0 {
                let sp = std::str::index_of(rest, " ");
                let t = rest[0..sp];
                rest = rest[(sp + 1)..len(rest)];
                if len(t) == 0 { continue; }
                let mut up = false;
                let mut i = 0;
                while i < p.rows() {
                    let e = p.row(i);
                    if e.seq > deploy_seq && e.entity == t && std::json::find_string_field(e.body, "revision") == rev {
                        if e.kind == "instance.exited" { return FleetOutcome { outcome: "crashed", shape: shape, instance: t, node: std::json::find_string_field(e.body, "node"), code: std::json::find_int_field(e.body, "code") }; }
                        if e.kind == "instance.up" { up = true; if len(shape) == 0 { shape = std::json::find_string_field(e.body, "model_hash"); } }
                    }
                    i = i + 1;
                }
                if !up { missing = missing + (if len(missing) > 0 { " " } else { "" }) + t; }
            }
            if len(missing) == 0 {
                if all_up_at < 0 { all_up_at = std::time::now(); }
                if std::time::now() - all_up_at >= self.observe_secs { return FleetOutcome { outcome: "healthy", shape: shape }; }
            } else if std::time::now() > settle {
                return FleetOutcome { outcome: "never", missing: missing };
            }
            std::time::sleep(500ms);
        }
        return FleetOutcome { outcome: "never" };
    }
    // Under `run` with a fleet: the deploy row and the window.
    fn answer_with_fleet(id: String, body: String, rollback: Bool) {
        let rev = second_word(body);
        let seed_named = seed_named_in(body);
        self.say(id + " requests a restart (" + body + "); deploying to the fleet `" + self.fleet + "`");
        let d = fleet_deploy(self.root, self.fleet, self.plan, rev, seed_named, id, if rollback { "rollback" } else { "apply" }, self.memory);
        if !d.ok {
            self.say(id + ": the fleet does not deploy: " + d.error);
            if !rollback { self.observed(id, "build_failed", "", "fleet: " + d.error); }
            return;
        }
        self.say(id + ": fleet.deploy " + (if rollback { "rollback to" } else { "apply" }) + " " + short(d.revision) + " touching " + d.touched);
        if rollback { return; }
        let o = self.fleet_window(d.revision, d.touched, d.seq, 180);
        let n = to_string(count_words(d.touched));
        if o.outcome == "healthy" {
            self.say(id + ": " + n + " instance(s) observed healthy for " + to_string(self.observe_secs) + "s as " + o.shape);
            self.observed(id, "healthy", o.shape, n + " instance(s) up for " + to_string(self.observe_secs) + "s");
        } else if o.outcome == "crashed" {
            self.say(id + ": instance " + o.instance + " on " + o.node + " exited (" + to_string(o.code) + ") inside the observation window");
            let a = append_as(self.root, "expression.crashed", id, "instance " + o.instance + " on " + o.node + " exited " + to_string(o.code) + " in the observation window", "", self.memory);
            self.observed(id, "crashed", o.shape, "instance " + o.instance + " on " + o.node + " exited " + to_string(o.code) + " in the observation window");
        } else {
            self.say(id + ": never expressed by " + o.missing);
            let a = append_as(self.root, "expression.crashed", id, "never expressed: " + o.missing, "", self.memory);
            self.observed(id, "build_failed", "", "never expressed by " + o.missing);
        }
    }
    // Under `dev`: rebuild, restart, watch the window.
    fn answer_here(id: String, body: String, rollback: Bool) {
        self.say(id + " requests a restart (" + body + ")");
        if self.repository { self.say(id + ": a repository has no application to express here"); return; }
        let current = self.dna_dir + "/current.topology";
        let previous = self.dna_dir + "/previous.topology";
        let cur_text = std::io::fs::read_file(current) or "";
        let w = write_text(previous, cur_text) or false;
        let cut = self.cut_artifact(self.seed_dir(), current);
        let bin = if len(cut) == 0 { self.build_seed(self.seed_dir()) } else { "" };
        if len(bin) == 0 {
            self.say(id + ": the candidate does not express: " + (if len(cut) > 0 { cut } else { "build failed" }));
            if !rollback { self.observed(id, "build_failed", "", if len(cut) > 0 { cut } else { "build failed" }); }
            let back = write_text(current, cur_text) or false;
            return;
        }
        self.app_bin = bin;
        let shape = shape_of(current);
        let expression = (if rollback { "rollback " } else { "" }) + shape + " build " + self.sha12(bin);
        if self.app.pid > 0 { stop_proc(self.app); }
        if !self.body_assert("the expression again") { self.stop_body(3); }
        self.app = start(self.dna_dir, "app", self.root, self.child_envs(id, expression), bin);
        self.app_log = 0;
        let pw = write_text(self.dna_dir + "/app.pid", to_string(self.app.pid)) or false;
        self.app_gone_reported = false;
        // the expression carries no organism now: the host records that it restarted
        let a = append_as(self.root, "expression.restarted", id, expression, "", self.memory);
        self.say("expression restarted (pid " + to_string(self.app.pid) + ") as " + expression);
        self.write_status();
        if self.observer.pid > 0 {
            stop_proc(self.observer);
            self.launch_iris(previous);
        }
        if rollback { return; }
        // the observation window: the expression must stay up
        let end = std::time::now() + self.observe_secs;
        let mut crashed = -2;
        while std::time::now() < end && crashed == -2 {
            crashed = exit_code(self.app);
            self.app_log = drain_log(self.app, self.app_log);
            let s = sync_record(self.root, self.memory);
            self.write_status();
            std::time::sleep(250ms);
        }
        if crashed == -2 {
            self.say(id + " observed healthy for " + to_string(self.observe_secs) + "s as " + shape);
            self.observed(id, "healthy", shape, "up for " + to_string(self.observe_secs) + "s");
        } else {
            // the organization is up and decides; the host reports the crash
            self.say(id + ": the expression exited (" + to_string(crashed) + ") inside the observation window");
            self.observed(id, "crashed", shape, "exited " + to_string(crashed) + " in the observation window");
            self.app = Proc { };
        }
    }
    // The organization's own seed changed: restart it and watch it.
    fn answer_org(id: String, rollback: Bool) {
        let bound = self.restart_org(id, rollback);
        let pw = write_text(self.dna_dir + "/org.pid", to_string(self.org.pid)) or false;
        self.write_status();
        if rollback || !bound { return; }
        let end = std::time::now() + self.observe_secs;
        let mut crashed = -2;
        while std::time::now() < end && crashed == -2 {
            crashed = exit_code(self.org);
            self.org_log = drain_log(self.org, self.org_log);
            let s = sync_record(self.root, self.memory);
            self.write_status();
            std::time::sleep(250ms);
        }
        let shape = shape_of(self.dna_dir + "/org.topology");
        if crashed == -2 {
            self.observed(id, "healthy", shape, "organization up for " + to_string(self.observe_secs) + "s");
            self.say(id + " organization observed healthy for " + to_string(self.observe_secs) + "s");
            return;
        }
        // nobody is left to decide: the host accounts for it, resets the
        // genome to the base and restarts the old organization
        self.say(id + ": the organization exited (" + to_string(crashed) + ") inside the window; rolling back");
        let base = base_of(open_projection(self.root, self.seed, self.toolchain, self.memory), id);
        let c = append_as(self.root, "expression.crashed", id, "organization exited " + to_string(crashed) + " in the observation window", "", self.memory);
        if genome_reset(self.root, base) {
            let r = append_as(self.root, "mutation.rolled_back", id, base + " by host after the organization crashed", "", self.memory);
        }
        if !self.restart_org(id, true) {
            self.say("the base organization does not come back");
            self.exit_code = 1;
        }
        let pw2 = write_text(self.dna_dir + "/org.pid", to_string(self.org.pid)) or false;
    }
    @unbounded
    fn tick() {
        if !self.body_alive() { self.stop_body(3); }
        self.org_log = drain_log(self.org, self.org_log);
        if self.app.pid > 0 {
            self.app_log = drain_log(self.app, self.app_log);
            let ac = exit_code(self.app);
            if ac != -2 && !self.app_gone_reported {
                self.say("the expression exited (" + to_string(ac) + ") outside a window; the organization is still up");
                self.app_gone_reported = true;
            }
        }
        // the record's requests onto the nerves first (GH #986): the relay
        // is what a person waiting on an answer waits for, so it never
        // waits behind the sync, memory's work or the forge. A row another
        // clone wrote arrives with the sync below and is relayed on the
        // next tick; the sync below shares what this relay answers.
        let n = self.relay.relay(self.memory);
        if len(self.relay.error) > 0 { self.say("relay onto the nerves failed: " + self.relay.error); }
        if n > 0 { self.say("relayed " + to_string(n) + " fact(s) from the record onto the nerves"); }
        let s = sync_record(self.root, self.memory);
        if !s.ok { self.say("sync: " + s.summary); }
        self.memory_tick(s.ok);
        self.poll_genome();
        if forge_kind(self.root) != "none" {
            let g = github_sync(self.root, self.seed, self.memory);
            if g.ok { print(indent_lines(dna::trim_nl(g.text), "hale dna " + self.verb + ": github: ")); } else { self.say("github: " + g.text); }
        }
        // the sync above may have blocked past the lease's life: prove it
        // again before answering anything
        if !self.body_alive() { self.stop_body(3); }
        // what the view gained — this tick's rows, the sync's and memory's
        // — onto the nerves for the heads
        let told = self.relay.announce(self.memory);
        self.write_status();
        // no record, or one that could not be read: nothing to do this pass
        let now = record_head(self.root);
        if !now.ok || now.absent { return; }
        let p = open_projection(self.root, self.seed, self.toolchain, self.memory);
        let req = pending_restart(p, self.handled);
        if req.seq < 0 { return; }
        if prepared_source_restart(p, req) {
            if self.answer_prepared_org(req.entity) { self.handled = keys_add(self.handled, fact_key(p, req.seq)); }
            return;
        }
        self.handled = keys_add(self.handled, fact_key(p, req.seq));
        let rollback = std::str::starts_with(req.body, "rollback ");
        let seed_named = seed_named_in(req.body);
        if seed_named == ORG_SEED { self.answer_org(req.entity, rollback); return; }
        if self.verb == "dev" { self.answer_here(req.entity, req.body, rollback); return; }
        if len(self.fleet) > 0 { self.answer_with_fleet(req.entity, req.body, rollback); return; }
        self.say(req.entity + " requests a restart (" + req.body + "); no expression is under this host — `hale dna dev`, a fleet (`[dna] fleet`), or a deployment gateway expresses it");
    }
    run() {
        self.hale = std::env::var("HALE_BIN");
        self.dna_dir = self.root + "/.hale/dna";
        std::io::fs::mkdir(self.root + "/.hale") or discard;
        std::io::fs::mkdir(self.dna_dir) or discard;
        self.status_path = self.dna_dir + "/status.json";
        let org_seed = self.root + "/" + ORG_SEED;
        if !std::io::fs::file_exists(org_seed + "/main.hl") { self.say("no organization at " + org_seed + " (run `hale dna init`)"); std::process::exit(2); }
        // 0. the body lease (GH #617): a record admits one body at a
        //    time; nothing is built or run under a lease that is not ours
        self.holder = body_holder(self.root);
        let now0 = std::time::now();
        let l = body_acquire(self.root, self.holder, now0, false, self.memory);
        if !l.ok { self.say("the record's remote cannot be reached, so the body lease cannot be taken; a body runs only under a lease it can prove"); std::process::exit(3); }
        if !l.present || l.holder != self.holder {
            self.say("a body for this record is live on " + l.holder + " (ticked " + ago(now0 - (l.expires - BODY_TTL)) + ", lease expires in " + to_string(l.expires - now0) + "s); a record admits one body — `hale dna body claim --force` takes it over when that body is gone");
            std::process::exit(3);
        }
        self.lease = l;
        let claimed = append_as(self.root, "body.claimed", self.holder, "{\"token\": " + to_string(l.token) + ", \"forced\": false, \"by\": \"host\"" + owner_json(self.root) + "}", "host", self.memory);
        self.say("body lease taken as " + self.holder + " (token " + to_string(l.token) + ")");
        self.start_fence();
        self.check_credentials();
        // 1. the genome as the forge has it, checked and built: the
        //    expression identity (a fresh artifact of the application) and
        //    the binaries, or the last genome that built (GH #1026)
        if !self.prepare_genome() { self.quit(1); }
        // 2. memory, before the organization that reads and writes it (GH #985),
        //    and the nerves it hears the record's requests on (GH #986)
        self.start_memory();
        self.nerves_on = dna::nerves_here();
        self.relay.root = self.root;
        self.relay.seed = self.seed;
        self.relay.toolchain = self.toolchain;
        self.relay.verb = self.verb;
        self.relay.live = self.nerves_on;
        if !self.nerves_on { self.say("no nerves: " + dna::NATS_SPINE_URL_ENV + " and " + dna::NATS_ORG_ENV + " are not set (`hale dna dev` creates the stream from HALE_DNA_NATS_URL_OWNER or dna/compose.yaml and hands the host the spine's); the organization hears nothing the record asks"); }
        // A pending prepared handoff uses its claimed attempt even at host
        // startup. An unknown old attempt never falls through to a second start.
        let incoming = open_projection(self.root, self.seed, self.toolchain, self.memory);
        let prepared_restart = pending_restart(incoming, self.handled);
        let prepared_startup = prepared_restart.seq >= 0 && prepared_source_restart(incoming, prepared_restart);
        if prepared_startup {
            let answered = self.answer_prepared_org(prepared_restart.entity);
            if self.org.pid <= 0 { self.say("prepared organization launch remains unavailable; no second attempt started"); self.quit(3); }
        } else {
            // 3. the organization: built (above), started from the root, observable
            let org_bin = self.org_ready;
            if len(org_bin) == 0 { self.quit(1); }
            std::io::fs::unlink(self.dna_dir + "/org.log") or discard;
            std::io::fs::unlink(self.dna_dir + "/app.log") or discard;
            if !self.body_assert("the organization") {
                self.quit(3);
            }
            self.org = start(self.dna_dir, "org", self.root, self.child_envs("", ""), org_bin);
            if self.org.pid <= 0 { self.say("cannot start " + org_bin); self.quit(1); }
            let pw = write_text(self.dna_dir + "/org.pid", to_string(self.org.pid)) or false;
            self.say("organization (pid " + to_string(self.org.pid) + ") from " + self.root + " under LOTUS_OBS=1");
        }
        // 3. the organization reads its facts from the nerves
        let bound = self.wait_nerves(20);
        if bound && self.nerves_on { self.say("the organization reads its facts from the nerves (" + dna::nerves_stream(dna::nerves_org()) + ")"); }
        else if exit_code(self.org) == -2 && self.nerves_on { self.say("the organization did not come to read the nerves within 20s; the facts wait in the stream"); }
        // 4. dev: the application too, under this host — a repository has
        // none, and its organization runs alone
        if self.verb == "dev" && self.repository { self.say("a repository: no application runs under this host; the organization oversees its seeds"); }
        if self.verb == "dev" && !self.repository {
            let bin = self.app_ready;
            if len(bin) == 0 { self.stop_org(); self.quit(1); }
            self.app_bin = bin;
            if !self.body_assert("the expression") {
                self.stop_org();
                self.quit(3);
            }
            self.app = start(self.dna_dir, "app", self.root, self.child_envs("", ""), bin);
            if self.app.pid <= 0 { self.say("cannot start " + bin); self.stop_org(); self.quit(1); }
            let aw = write_text(self.dna_dir + "/app.pid", to_string(self.app.pid)) or false;
            self.say("expression " + self.app_name() + " (pid " + to_string(self.app.pid) + ") under LOTUS_OBS=1");
        }
        if self.verb == "run" && len(self.fleet) > 0 { self.say("the fleet `" + self.fleet + "` (" + self.root + "/" + self.plan + ") is the expression; `hale node <name>` runs its nodes"); }
        // the node is up on its genome: a row naming the sha it runs
        self.genome_row("node.started", "");
        self.say("genome " + short(self.genome_sha) + (if self.genome_poll > 0 && len(record_remote(self.root)) > 0 { ", pulled from the forge every " + to_string(self.genome_poll) + "s" } else { "" }));
        // 5. iris
        self.write_status();
        if self.iris && bound {
            let baseline = self.dna_dir + "/baseline.topology";
            self.launch_iris(if std::io::fs::file_exists(baseline) { baseline } else { "" });
        }
        // 6. supervise: the organization's exit is ours — and a SIGTERM to
        //    this node (its unit stopping it) ends the supervision: the
        //    runtime drains the program, and this loop is what reads it
        let mut code = -2;
        while code == -2 && !self.draining {
            code = exit_code(self.org);
            if code == -2 {
                self.tick();
                std::time::sleep(HOST_TICK);
            } else {
                // A proven failed prepared child may still need its exact
                // rollback acknowledgment. Keep this host/lease alive to
                // reconcile that one handoff; never replace an unknown claim.
                let waiting = open_projection(self.root, self.seed, self.toolchain, self.memory);
                let handoff_fact = pending_restart(waiting, self.handled);
                if handoff_fact.seq >= 0 && prepared_source_restart(waiting, handoff_fact) {
                    if !self.body_alive() { self.stop_body(3); }
                    self.tick(); code = -2; std::time::sleep(HOST_TICK);
                }
            }
        }
        // the fence stopped it: the lease is not ours to keep
        if !self.body_alive() { self.stop_body(3); }
        // told to stop: the organization drains on SIGTERM like this node
        if self.draining {
            self.say("stopping: the organization and what it started go with this node");
            self.stop_org();
            code = exit_code(self.org);
        }
        // the organization is gone; what it started goes with it
        self.stop_started();
        self.org_log = drain_log(self.org, self.org_log);
        if self.observer.pid > 0 { stop_proc(self.observer); }
        if self.app.pid > 0 { stop_proc(self.app); }
        std::io::fs::unlink(self.dna_dir + "/org.pid") or discard;
        std::io::fs::unlink(self.dna_dir + "/app.pid") or discard;
        self.write_status();
        self.stop_fence();
        if body_release(self.root, self.lease, self.memory) {
            let released = append_as(self.root, "body.released", self.holder, "{\"token\": " + to_string(self.lease.token) + ", \"by\": \"host\"" + owner_json(self.root) + "}", "host", self.memory);
            let s3 = sync_record(self.root, self.memory);
        }
        self.say("organization exited (" + to_string(code) + "); " + RECORD_REF + " in " + self.root + " is the record");
        // drained: return, and the runtime ends the process by its signal
        if self.draining { return; }
        if self.exit_code != 0 { self.quit(self.exit_code); }
        self.quit(if code < 0 { 1 } else { code });
    }
}

fn count_words(s: String) -> Int {
    let mut n = 0;
    let mut rest = s + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        if sp > 0 { n = n + 1; }
        rest = rest[(sp + 1)..len(rest)];
    }
    return n;
}

// `body-fence` (the second review of #622): the renewer beside a body.
// The host's `body.fence` file, naming that host's pid, is its mandate; it
// ends when that file is gone or names another host (a host restarted on
// the same clone). Every status line it writes starts with its host's pid.
// Bounded by the life of the body it fences.
@unbounded
fn fence_main(holder: String, token: Int, expires: Int, host_pid: Int, memory: dna::Memory) {
    let dir = ".hale/dna";
    let mut lease = BodyLease { present: true, holder: holder, token: token, expires: expires };
    let mark = dna::body_mark(holder, token, host_pid);
    let mut renewed = 0;
    while fence_mandate(dir, host_pid) {
        let now = std::time::now();
        // every git call a renewal makes stops at this deadline
        let d = write_text(dir + "/body.deadline", to_string(lease.expires - FENCE_MARGIN)) or false;
        if dna::run_tool("kill\n-0\n" + to_string(host_pid)).code != 0 { fence_stop(dir, host_pid, mark, "orphaned: the host is gone"); return; }
        if now - renewed >= BODY_TTL / 3 {
            let r = body_renew(".", lease, now, memory);
            if r.ok {
                if !r.present || r.holder != holder { fence_stop(dir, host_pid, mark, "lost " + r.holder); return; }
                lease = r;
                renewed = now;
                let w = write_text(dir + "/body.fence.status", to_string(host_pid) + " ok " + to_string(lease.expires)) or false;
            }
        }
        if std::time::now() >= lease.expires - FENCE_MARGIN { fence_stop(dir, host_pid, mark, "expired " + to_string(lease.expires)); return; }
        std::time::sleep(1s);
    }
}

// Whether the mandate at `dir` is still the one `host_pid` wrote.
fn fence_mandate(dir: String, host_pid: Int) -> Bool {
    let m = std::io::fs::read_file(dir + "/body.fence") or "";
    let nl = std::str::index_of(m, "\n");
    return len(m) > 0 && (if nl < 0 { m } else { m[0..nl] }) == to_string(host_pid);
}

// Say why, then kill what executes under the lease — unless the mandate
// has passed to another host in the meantime, whose processes these are.
fn fence_stop(dir: String, host_pid: Int, mark: String, why: String) {
    if !fence_mandate(dir, host_pid) { return; }
    let w = write_text(dir + "/body.fence.status", to_string(host_pid) + " " + why) or false;
    // each with every process it started — still under it, and, carrying the
    // body's mark, anywhere else (a tool whose organism already died)
    kill_tree(dna::trim_nl(std::io::fs::read_file(dir + "/org.pid") or ""));
    kill_tree(dna::trim_nl(std::io::fs::read_file(dir + "/app.pid") or ""));
    dna::kill_marked(mark);
}

fn host_main(verb: String, root: String, seed: String, fleet: String, plan: String, toolchain: String, a: Args) {
    // GH #646 decision 3: an adopted organism starts active work only
    // when its store is reachable — `dev` brings the service up itself;
    // `run` needs to be told where it is
    if verb == "run" && routing_here(root) > 0 && !dna::dsn_set(dna::SPINE_DSN_ENV) {
        eprintln("hale dna run: this record's operations live in the ledger (adopted at ", short(checkpoint_here(root)), "), and no memory is named here (", dna::SPINE_DSN_ENV, "); a body without its memory admits nothing — set it, or run under `hale dna dev`");
        std::process::exit(2);
    }
    // GH #664: a body over a shared record says which owner it is, and it
    // must be one the map names — a body that names none admits nothing
    if (verb == "run" || verb == "dev") && shared_here(root) {
        let me = owner_here(root);
        if len(me) == 0 {
            eprintln("hale dna ", verb, ": this record's positions have owners (", OWNERS_FILE, ": ", owners_here(root), "); say which this body is — `git config dna.owner <owner>` — or it admits nothing");
            std::process::exit(2);
        }
        if !dna::word_in(me, owners_here(root)) {
            eprintln("hale dna ", verb, ": dna.owner is `", me, "`, which ", OWNERS_FILE, " does not name (owners: ", owners_here(root), ")");
            std::process::exit(2);
        }
        // GH #665: the owners' controllers coordinate through the ledger —
        // a lease per owner in the store, an epoch on every write
        if verb == "run" && routing_here(root) == 0 {
            eprintln("hale dna run: this record is shared (", OWNERS_FILE, ": ", owners_here(root), "), and its controllers coordinate through the ledger, which it has not adopted; `hale dna ledger adopt` first (under `hale dna dev`)");
            std::process::exit(2);
        }
    }
    let port_flag = flag(a, "--port");
    let observe_flag = flag(a, "--observe");
    Host {
        verb: verb, root: root, seed: seed, fleet: if verb == "dev" { "" } else { fleet }, plan: plan, toolchain: toolchain,
        port: if len(port_flag) > 0 { port_flag } else { "8787" },
        iris: !has_flag(a, "--no-iris"),
        observe_secs: if len(observe_flag) > 0 { std::str::parse_int(observe_flag) or 15 } else { 15 }
    };
}
