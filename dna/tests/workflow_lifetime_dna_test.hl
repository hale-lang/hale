// dna/tests/workflow_lifetime_dna_test.hl — the waiting-instance lifetime
// and the committer wiring inside a program that imports the DNA core
// (DNA workflow card 03, integration case).
//
// Same shape as workflow_lifetime_test.hl, now against DNA itself:
//
// - the committer owns a real `dna::Journal` and commits with exact
//   compare-and-append; a refusal is the journal's own answer;
// - requests and replies are DNA's `WorkRequested` / `WorkDone`, keyed by
//   `work_id`, so the resident types share topics with DNA's flow types;
// - a standalone `dna::Metabolism` runs routed and in-tower Tasks in the
//   same program, answered by the same responder;
// - every transition carries a proposal id (`<key>@s<stage>`): the
//   proposer acts on the answer to its one outstanding proposal, once, and
//   the committer answers a proposal it already committed without
//   appending again (the review of card 03). A replayed answer while work
//   is pending, an old answer while a newer transition is held, and a
//   proposal re-sent after its answer was lost each dispatch nothing extra.
//
// The resident types are test-local: DNA's Task, Workflow, Step, Work and
// Attempt are flows program-wide because each has a `release` hook.

import "../core" as dna;

type Life { key: String = ""; what: String = ""; }
topic Lives { payload: Life; subject: "wfd.life"; }

type Offer { scope: String = ""; key: String = ""; nested: Bool = false; }
topic Offers { payload: Offer; subject: "wfd.offer"; keyed_by scope; }

type Proposal { scope: String = ""; key: String = ""; proposal_id: String = ""; kind: String = ""; entity: String = ""; }
topic Proposals { payload: Proposal; subject: "wfd.proposal"; keyed_by scope; }
type Ack { scope: String = ""; key: String = ""; proposal_id: String = ""; ok: Bool = false; revision: Int = 0; why: String = ""; }
topic Acks { payload: Ack; subject: "wfd.ack"; keyed_by key; }

// The test's hand on the committer: commit a held proposal, and lose the
// answer when told to.
type Release { proposal_id: String = ""; lose_answer: Bool = false; }
topic Releases { payload: Release; subject: "wfd.release"; }
// The test's hand on a proposer: send the outstanding proposal again.
type Resend { key: String = ""; }
topic Resends { payload: Resend; subject: "wfd.resend"; keyed_by key; }

type Done { key: String = ""; disposition: String = ""; }
topic Completions { payload: Done; subject: "wfd.done"; keyed_by key; }

type Flush { work_id: String = ""; times: Int = 1; }
topic Flushes { payload: Flush; subject: "wfd.flush"; }

// A real journal that refuses what the test marks: the refusal is the
// journal's answer, as a store's would be.
locus RefuseMarked {
    params { inner: dna::MemJournal = dna::MemJournal { }; refusals: Int = 0; }
    fn refresh() -> Bool { return self.inner.refresh(); }
    fn revision() -> Int { return self.inner.revision(); }
    fn head() -> String { return self.inner.head(); }
    fn append(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if std::str::contains(entity, "refuse") {
            self.refusals = self.refusals + 1;
            return dna::AppendResult { error: "refused", expected: expected, actual: self.inner.revision() };
        }
        return self.inner.append(expected, kind, entity, body);
    }
    fn append_exact(expected: Int, kind: String, entity: String, body: String) -> dna::AppendResult {
        if std::str::contains(entity, "refuse") {
            self.refusals = self.refusals + 1;
            return dna::AppendResult { error: "refused", expected: expected, actual: self.inner.revision() };
        }
        return self.inner.append_exact(expected, kind, entity, body);
    }
    fn read(i: Int) -> dna::Event { return self.inner.read(i); }
    fn verify_chain() -> Bool { return self.inner.verify_chain(); }
}

// The one journal owner. A committed row's body is its proposal id, so a
// proposal already committed is found in the journal and answered again
// without a second append. It holds a stage-2 proposal of "h-hold" until
// released, so the test can make a newer transition wait.
locus Committer {
    params {
        scope: String = "";
        journal: dna::Journal = dna::MemJournal { };
        refused: Int = 0;
        repeated: Int = 0; // proposals answered from the journal, not appended
        held: Proposal = Proposal { };
    }
    bus {
        subscribe Proposals as on_proposal where key == self.scope;
        subscribe Releases as on_release;
        publish Acks;
    }
    // The revision a proposal was committed at, -1 when it was not.
    @unbounded
    fn committed_at(proposal_id: String) -> Int {
        let mut i = 0;
        while i < self.journal.revision() {
            let e = self.journal.read(i);
            if e.kind == "wfprobe.dispatched" && e.body == proposal_id { return i + 1; }
            i = i + 1;
        }
        return -1;
    }
    fn answer(p: Proposal, ok: Bool, revision: Int, why: String) {
        Acks <- Ack { scope: self.scope, key: p.key, proposal_id: p.proposal_id, ok: ok, revision: revision, why: why };
    }
    // Exact compare-and-append. A stale revision is read again once; the
    // proof has no domain state to re-evaluate (cards 06 and 07 do).
    fn commit(p: Proposal) -> dna::AppendResult {
        let mut r = self.journal.append_exact(self.journal.revision(), p.kind, p.entity, p.proposal_id);
        if !r.ok && r.error == "stale_revision" {
            let moved = self.journal.refresh();
            r = self.journal.append_exact(self.journal.revision(), p.kind, p.entity, p.proposal_id);
        }
        if !r.ok { self.refused = self.refused + 1; }
        return r;
    }
    fn on_proposal(p: Proposal) {
        let at = self.committed_at(p.proposal_id);
        if at >= 0 {
            self.repeated = self.repeated + 1;
            self.answer(p, true, at, "");
            return;
        }
        if std::str::starts_with(p.key, "h-hold") && std::str::ends_with(p.proposal_id, "@s2") && len(self.held.proposal_id) == 0 {
            // a payload's strings live only as long as its delivery: keep copies
            self.held = Proposal {
                scope: std::str::clone(p.scope),
                key: std::str::clone(p.key),
                proposal_id: std::str::clone(p.proposal_id),
                kind: std::str::clone(p.kind),
                entity: std::str::clone(p.entity)
            };
            return;
        }
        let r = self.commit(p);
        self.answer(p, r.ok, r.revision, r.error);
    }
    fn on_release(rel: Release) {
        if rel.proposal_id != self.held.proposal_id || len(rel.proposal_id) == 0 { return; }
        let r = self.commit(self.held);
        if !rel.lose_answer { self.answer(self.held, r.ok, r.revision, r.error); }
        // cleared last: a local bound to the field would follow it
        self.held = Proposal { };
    }
}

// DNA's work topics, answered at once, or held for work ids starting "h-".
locus Responder {
    params { held: String = ""; requests: String = ""; }
    bus {
        subscribe dna::WorkRequested as on_request;
        subscribe Flushes as on_flush;
        publish dna::WorkDone;
    }
    @unbounded
    fn on_request(r: dna::WorkRequest) {
        self.requests = self.requests + r.work_id + " ";
        if std::str::starts_with(r.work_id, "h-") {
            self.held = self.held + r.work_id + "\n";
            return;
        }
        dna::WorkDone <- dna::WorkSettlement { work_id: r.work_id, disposition: "done", result: "ok:" + r.objective, attempts: 1, history: "a0:responder:done " };
    }
    @unbounded
    fn on_flush(f: Flush) {
        if !std::str::contains(self.held, f.work_id + "\n") { return; }
        let mut i = 0;
        while i < f.times {
            dna::WorkDone <- dna::WorkSettlement { work_id: f.work_id, disposition: "done", result: "late", attempts: 1, history: "a0:responder:done " };
            i = i + 1;
        }
    }
}

locus Inner {
    params { scope: String = ""; key: String = ""; settled: Bool = false; outstanding: String = ""; }
    bus {
        subscribe Acks as on_ack where key == self.key;
        subscribe dna::WorkDone as on_done where key == self.key;
        publish Lives;
        publish Proposals;
        publish dna::WorkRequested;
        publish Completions;
    }
    birth() { Lives <- Life { key: self.key, what: "born" }; }
    run() {
        self.outstanding = self.key + "@s0";
        Proposals <- Proposal { scope: self.scope, key: self.key, proposal_id: self.outstanding, kind: "wfprobe.dispatched", entity: self.key };
    }
    fn on_ack(a: Ack) {
        // only the answer to the one outstanding proposal, and only once
        if a.scope != self.scope || a.proposal_id != self.outstanding || len(self.outstanding) == 0 { return; }
        self.outstanding = "";
        if !a.ok {
            Completions <- Done { key: self.key, disposition: "refused" };
            terminate;
        }
        dna::WorkRequested <- dna::WorkRequest { work_id: self.key, objective: "nested work" };
    }
    fn on_done(s: dna::WorkSettlement) {
        if self.settled { return; }
        self.settled = true;
        Completions <- Done { key: self.key, disposition: s.disposition };
        terminate;
    }
    dissolve() { Lives <- Life { key: self.key, what: "dissolved" }; }
}

locus Waiter {
    params {
        scope: String = "";
        key: String = "";
        nested: Bool = false;
        child_key: String = ""; // given at construction: a keyed subscription reads it at registration
        stage: Int = 0;
        settled: Bool = false;
        outstanding: String = ""; // the one proposal awaiting its answer
    }
    bus {
        subscribe Acks as on_ack where key == self.key;
        subscribe dna::WorkDone as on_done where key == self.key;
        subscribe Completions as on_child where key == self.child_key;
        subscribe Resends as on_resend where key == self.key;
        publish Lives;
        publish Proposals;
        publish dna::WorkRequested;
        publish Completions;
    }
    accept(c: Inner) { }
    birth() { Lives <- Life { key: self.key, what: "born" }; }
    run() { self.propose(); }
    // One proposal per transition, named by the stage it dispatches.
    fn propose() {
        self.outstanding = self.key + "@s" + to_string(self.stage);
        Proposals <- Proposal { scope: self.scope, key: self.key, proposal_id: self.outstanding, kind: "wfprobe.dispatched", entity: self.key };
    }
    // A proposal whose answer was lost is sent again under the same id.
    fn on_resend(r: Resend) {
        if len(self.outstanding) == 0 { return; }
        Proposals <- Proposal { scope: self.scope, key: self.key, proposal_id: self.outstanding, kind: "wfprobe.dispatched", entity: self.key };
    }
    fn on_ack(a: Ack) {
        // only the answer to the one outstanding proposal, and only once
        if a.scope != self.scope || a.proposal_id != self.outstanding || len(self.outstanding) == 0 { return; }
        self.outstanding = "";
        if !a.ok {
            self.settled = true;
            Completions <- Done { key: self.key, disposition: "refused" };
            terminate;
        }
        dna::WorkRequested <- dna::WorkRequest { work_id: self.key, objective: "stage " + to_string(self.stage), attempt_no: self.stage };
    }
    fn on_done(s: dna::WorkSettlement) {
        if self.settled { return; }
        if self.nested && self.stage == 0 {
            self.stage = 1;
            Inner { scope: self.scope, key: self.child_key };
            return;
        }
        if self.nested && self.stage == 1 { return; } // a late stage-0 duplicate while the child runs
        self.settled = true;
        Completions <- Done { key: self.key, disposition: s.disposition };
        terminate;
    }
    fn on_child(d: Done) {
        if self.settled || self.stage != 1 { return; }
        if d.disposition != "done" {
            self.settled = true;
            Completions <- Done { key: self.key, disposition: "failed" };
            terminate;
        }
        self.stage = 2;
        self.propose();
    }
    dissolve() { Lives <- Life { key: self.key, what: "dissolved" }; }
}

locus Manager {
    params { scope: String = ""; offers: Int = 0; }
    bus { subscribe Offers as on_offer where key == self.scope; }
    accept(w: Waiter) { }
    @unbounded
    fn on_offer(o: Offer) {
        self.offers = self.offers + 1;
        Waiter { scope: self.scope, key: o.key, nested: o.nested, child_key: o.key + ".c" };
    }
}

locus Session {
    params { scope: String = "short"; }
    bus { publish Offers; }
    run() {
        let m = Manager { scope: self.scope };
        let c = Committer { scope: self.scope };
        Offers <- Offer { scope: self.scope, key: "h-short" };
        std::time::sleep(50ms);
    }
}

main locus App {
    params {
        committer: Committer = Committer { scope: "main", journal: RefuseMarked { } };
        responder: Responder = Responder { };
        manager: Manager = Manager { scope: "main" };
        metabolism: dna::Metabolism = dna::Metabolism { };
        lives: String = "";
        done: String = "";
    }
    bus {
        subscribe Lives as on_life;
        subscribe Completions as on_completion;
        publish Offers;
        publish Flushes;
        publish dna::WorkDone;
        publish Acks;
        publish Releases;
        publish Resends;
    }
    @unbounded
    fn on_life(l: Life) { self.lives = self.lives + l.key + ":" + l.what + " "; }
    @unbounded
    fn on_completion(d: Done) { self.done = self.done + d.key + ":" + d.disposition + " "; }
    @unbounded
    fn count(list: String, item: String) -> Int {
        let mut n = 0;
        let mut rest = list;
        while len(rest) > 0 {
            let sp = std::str::index_of(rest, " ");
            if rest[0..sp] == item { n = n + 1; }
            rest = rest[(sp + 1)..len(rest)];
        }
        return n;
    }
    @unbounded
    fn committed(entity: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.committer.journal.revision() {
            let e = self.committer.journal.read(i);
            if e.kind == "wfprobe.dispatched" && e.entity == entity { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    // Let the queue dispatch. A loaded machine is slower than this
    // fixture's steps, so a wait that expects something waits for it;
    // `settle` alone is for the checks that expect nothing to happen.
    fn settle() {
        let mut i = 0;
        while i < 10 {
            std::time::sleep(20ms);
            i = i + 1;
        }
    }
    // Wait until `item` has been seen `n` times in `lives`, or give up
    // after twenty seconds and let the assertion say what happened.
    @unbounded
    fn until_life(item: String, n: Int) {
        let mut i = 0;
        while i < 1000 {
            if self.count(self.lives, item) >= n { return; }
            std::time::sleep(20ms);
            i = i + 1;
        }
    }
    @unbounded
    fn until_done(item: String, n: Int) {
        let mut i = 0;
        while i < 1000 {
            if self.count(self.done, item) >= n { return; }
            std::time::sleep(20ms);
            i = i + 1;
        }
    }
    run() {
        // DNA's own flow types in the same program: in-tower and routed Tasks
        let t_in = self.metabolism.offer(dna::Intent { outcome: "in tower", from: "test" }, dna::Knobs { });
        std::test::assert_eq_str(self.metabolism.find(t_in).disposition, "done", "an in-tower Task still settles");
        let t_routed = self.metabolism.offer(dna::Intent { outcome: "routed", from: "test" }, dna::Knobs { routed: true });
        std::test::assert_eq_str(self.metabolism.find(t_routed).disposition, "done", "a routed Task is answered by the same responder: " + self.metabolism.find(t_routed).detail);

        // immediate
        Offers <- Offer { scope: "main", key: "k-now" };
        self.until_done("k-now:done", 1);
        self.until_life("k-now:dissolved", 1);
        std::test::assert_eq_int(self.count(self.done, "k-now:done"), 1, "immediate: completed once: " + self.done);
        std::test::assert_eq_int(self.committed("k-now"), 1, "immediate: the dispatch was committed in the journal");
        std::test::assert_eq_int(self.count(self.lives, "k-now:dissolved"), 1, "immediate: reclaimed: " + self.lives);

        // delayed, with duplicates
        Offers <- Offer { scope: "main", key: "h-late" };
        self.settle();
        std::test::assert_eq_int(self.count(self.responder.requests, "h-late"), 1, "delayed: one request: " + self.responder.requests);
        std::test::assert_eq_int(self.count(self.lives, "h-late:dissolved"), 0, "delayed: alive after its handler and run(): " + self.lives);
        // a replayed answer while the work is pending dispatches nothing more
        Acks <- Ack { scope: "main", key: "h-late", proposal_id: "h-late@s0", ok: true, revision: 1 };
        self.settle();
        std::test::assert_eq_int(self.count(self.responder.requests, "h-late"), 1, "delayed: a replayed commit answer does not dispatch the work again: " + self.responder.requests);
        dna::WorkDone <- dna::WorkSettlement { work_id: "h-unrelated", disposition: "done" };
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-late:done"), 0, "delayed: an unrelated WorkDone does not reach it");
        Flushes <- Flush { work_id: "h-late", times: 2 };
        self.until_done("h-late:done", 1);
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-late:done"), 1, "delayed: two replies, one completion: " + self.done);
        std::test::assert_eq_int(self.count(self.lives, "h-late:dissolved"), 1, "delayed: reclaimed once: " + self.lives);

        // nested
        Offers <- Offer { scope: "main", key: "h-nest", nested: true };
        self.settle();
        Flushes <- Flush { work_id: "h-nest" };
        self.until_life("h-nest.c:born", 1);
        std::test::assert_eq_int(self.count(self.lives, "h-nest.c:born"), 1, "nested: the child was born: " + self.lives);
        Flushes <- Flush { work_id: "h-nest.c" };
        self.until_done("h-nest.c:done", 1);
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-nest.c:done"), 1, "nested: the child completed: " + self.done);
        std::test::assert_eq_int(self.count(self.lives, "h-nest.c:dissolved"), 1, "nested: and was reclaimed");
        std::test::assert_eq_int(self.committed("h-nest"), 2, "nested: stage 0 and stage 2 were committed");
        std::test::assert_eq_int(self.count(self.responder.requests, "h-nest"), 2, "nested: and requested, once each: " + self.responder.requests);
        std::test::assert_eq_int(self.count(self.done, "h-nest:done"), 0, "nested: the parent waits for stage 2");
        Flushes <- Flush { work_id: "h-nest" };
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-nest:done"), 1, "nested: completed once: " + self.done);
        std::test::assert_eq_int(self.count(self.lives, "h-nest:dissolved"), 1, "nested: reclaimed");

        // transition identity: an old answer while a newer transition waits,
        // and a proposal re-sent after its answer was lost
        Offers <- Offer { scope: "main", key: "h-hold", nested: true };
        self.until_life("h-hold:born", 1);
        Flushes <- Flush { work_id: "h-hold" };
        self.until_life("h-hold.c:born", 1);
        Flushes <- Flush { work_id: "h-hold.c" };
        self.until_done("h-hold.c:done", 1);
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-hold.c:done"), 1, "hold: the child completed: " + self.done);
        std::test::assert_eq_int(self.committed("h-hold"), 1, "hold: stage 2 is proposed and held, not committed");
        std::test::assert_eq_str(self.committer.held.proposal_id, "h-hold@s2", "hold: the committer holds stage 2");
        Acks <- Ack { scope: "main", key: "h-hold", proposal_id: "h-hold@s0", ok: true, revision: 1 };
        self.settle();
        std::test::assert_eq_int(self.count(self.responder.requests, "h-hold"), 1, "hold: an old answer does not release the newer transition: " + self.responder.requests);
        Acks <- Ack { scope: "other", key: "h-hold", proposal_id: "h-hold@s2", ok: true, revision: 1 };
        self.settle();
        std::test::assert_eq_int(self.count(self.responder.requests, "h-hold"), 1, "hold: nor does another committer's answer with the right id: " + self.responder.requests);
        Releases <- Release { proposal_id: "h-hold@s2", lose_answer: true };
        self.settle();
        std::test::assert_eq_int(self.committed("h-hold"), 2, "hold: stage 2 committed, its answer lost");
        std::test::assert_eq_int(self.count(self.responder.requests, "h-hold"), 1, "hold: nothing dispatched without the answer");
        Resends <- Resend { key: "h-hold" };
        self.settle();
        std::test::assert_eq_int(self.committed("h-hold"), 2, "hold: the re-sent proposal is not appended again");
        std::test::assert_eq_int(self.committer.repeated, 1, "hold: it is answered from the journal");
        std::test::assert_eq_int(self.count(self.responder.requests, "h-hold"), 2, "hold: and stage 2 is dispatched once: " + self.responder.requests);
        Resends <- Resend { key: "h-hold" };
        Acks <- Ack { scope: "main", key: "h-hold", proposal_id: "h-hold@s2", ok: true, revision: 99 };
        self.settle();
        std::test::assert_eq_int(self.count(self.responder.requests, "h-hold"), 2, "hold: once answered, a resend or a repeated answer changes nothing: " + self.responder.requests);
        Flushes <- Flush { work_id: "h-hold" };
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-hold:done"), 1, "hold: completed once: " + self.done);
        std::test::assert_eq_int(self.count(self.lives, "h-hold:dissolved") + self.count(self.lives, "h-hold.c:dissolved"), 2, "hold: both reclaimed");

        // a journal refusal: nothing dispatched
        Offers <- Offer { scope: "main", key: "k-refuse" };
        self.until_done("k-refuse:refused", 1);
        std::test::assert_eq_int(self.committer.refused, 1, "refusal: the journal refused the append");
        std::test::assert_eq_int(self.count(self.responder.requests, "k-refuse"), 0, "refusal: no request: " + self.responder.requests);
        std::test::assert_eq_int(self.committed("k-refuse"), 0, "refusal: nothing in the journal");
        std::test::assert_eq_int(self.count(self.done, "k-refuse:refused"), 1, "refusal: reported once: " + self.done);
        std::test::assert_eq_int(self.count(self.lives, "k-refuse:dissolved"), 1, "refusal: reclaimed");

        // parent shutdown
        Session { };
        self.until_life("h-short:dissolved", 1);
        std::test::assert(self.count(self.lives, "h-short:born") == 1 && self.count(self.lives, "h-short:dissolved") == 1, "shutdown: born, and reclaimed with its manager: " + self.lives);
        Flushes <- Flush { work_id: "h-short" };
        self.settle();
        std::test::assert_eq_int(self.count(self.done, "h-short:done"), 0, "shutdown: its late reply reaches nobody");

        // the flow Tasks are unaffected, and nothing leaked
        let t_after = self.metabolism.offer(dna::Intent { outcome: "after", from: "test" }, dna::Knobs { routed: true });
        std::test::assert_eq_str(self.metabolism.find(t_after).disposition, "done", "a routed Task still settles after the residents came and went");
        std::test::assert_eq_int(self.count(self.lives, "k-now:born") + self.count(self.lives, "h-late:born") + self.count(self.lives, "h-nest:born") + self.count(self.lives, "h-nest.c:born") + self.count(self.lives, "h-hold:born") + self.count(self.lives, "h-hold.c:born") + self.count(self.lives, "k-refuse:born"), 7, "seven residents were born in main's scope");
        std::test::assert_eq_int(self.count(self.lives, "k-now:dissolved") + self.count(self.lives, "h-late:dissolved") + self.count(self.lives, "h-nest:dissolved") + self.count(self.lives, "h-nest.c:dissolved") + self.count(self.lives, "h-hold:dissolved") + self.count(self.lives, "h-hold.c:dissolved") + self.count(self.lives, "k-refuse:dissolved"), 7, "and all seven were reclaimed");
    }
}

fn main() { App { }; }
