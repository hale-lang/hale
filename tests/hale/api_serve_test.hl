// GH #1137 — the entry's `serve:` puts an imported locus on the surface.
//
// spec/semantics.md § "The api binding": the surface is the entrypoint
// seed's own loci plus the loci its entry names in `serve:`, whichever
// seed declared them, and nothing else. The fixture builds a library
// seed with two loci — `Handlers`, whose gated handler answers a command,
// and `Internal`, which subscribes the library's own bus — and an app
// that holds both as params and names only `Handlers`. The served
// locus's command answers through the socket; the held-but-unnamed
// locus's topic is on no surface; `--dump-api` shows exactly what
// `serve:` names; and a name that is no param of main is refused.

fn lib_source() -> String {
    return "type Order { id: Int; }\n"
        + "type Taken { id: Int; by: String; }\n"
        + "type Tick { n: Int; }\n"
        + "topic Orders { payload: Order; subject: \"lib.orders\"; }\n"
        + "topic Ticks { payload: Tick; subject: \"lib.internal.tick\"; }\n"
        + "role clerk;\n"
        + "locus Handlers {\n"
        + "    bus { subscribe Orders as on_order; }\n"
        + "    @gated(role: clerk)\n"
        + "    fn on_order(o: Order, ctx: std::api::Context) -> Taken { return Taken { id: o.id, by: ctx.caller.name }; }\n"
        + "}\n"
        + "locus Internal {\n"
        + "    bus { subscribe Ticks as on_tick; }\n"
        + "    fn on_tick(t: Tick) -> Tick { return t; }\n"
        + "}\n";
}

fn app_source(sock: String, me: String, serve: String) -> String {
    return app_with("handlers: lib::Handlers = lib::Handlers { }; core: lib::Internal = lib::Internal { };", sock, me, serve);
}

fn app_with(held: String, sock: String, me: String, serve: String) -> String {
    return "import \"../lib\" as lib;\n"
        + "locus Table {\n"
        + "    fn holds(p: std::api::Principal, r: String) -> Bool { return p.name == \"uid:" + me + "\"; }\n"
        + "}\n"
        + "main locus App {\n"
        + "    params { " + held + " }\n"
        + "    bindings { api: unix(\"" + sock + "\", bound: 8, on_full: refuse, roles: Table { })" + serve + "; }\n"
        + "    run() { std::time::sleep(8s); }\n"
        + "}\n"
        + "fn main() { App { }; }\n";
}

locus Proc {
    params { child: std::process::Child = std::process::Child { }; }
    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }
    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 { return; }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
    }
    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 { return false; }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        return true;
    }
    fn ask(line: String) -> String {
        self.stream.send(line + "\n") or discard;
        let mut i = 0;
        while i < 25 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let got = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return got;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 { i = i + 1; } else { self.buf = self.buf + chunk; }
        }
        return "";
    }
}

fn run_tool(argv: String) -> std::process::ProcessOutput {
    return std::process::run(argv) or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let me = std::str::trim(run_tool("id\n-u").stdout);
    let root = "/tmp/hale-1137-serve-" + to_string(std::process::pid());
    let sock = root + "/app.sock";
    std::io::fs::mkdir(root) or discard;
    std::io::fs::mkdir(root + "/lib") or discard;
    std::io::fs::mkdir(root + "/app") or discard;
    std::io::fs::write_file(root + "/lib/lib.hl", lib_source()) or discard;

    // ---- a name that is no param of main is refused, located
    std::io::fs::write_file(root + "/app/main.hl", app_source(sock, me, ", serve: [nobody]")) or discard;
    let wrong = run_tool(hale + "\ncheck\n" + root + "/app");
    std::test::assert(wrong.code != 0 && std::str::contains(wrong.stderr, "`serve:` names `nobody`, which is not a param of the main locus"), "a serve name must be a param of main: " + wrong.stderr);

    // ---- the binding serves a locus type: one main holds twice is refused
    std::io::fs::write_file(root + "/app/main.hl", app_with("handlers: lib::Handlers = lib::Handlers { }; spare: lib::Handlers = lib::Handlers { };", sock, me, ", serve: [handlers]")) or discard;
    let twice = run_tool(hale + "\ncheck\n" + root + "/app");
    std::test::assert(twice.code != 0 && std::str::contains(twice.stderr, "but the main locus also holds `lib::Handlers` as `spare`"), "a served type held twice would answer for both: " + twice.stderr);
    // ---- and the seed's own locus is on the surface already
    std::io::fs::write_file(root + "/app/main.hl", app_with("mine: Table = Table { };", sock, me, ", serve: [mine]")) or discard;
    let own = run_tool(hale + "\ncheck\n" + root + "/app");
    std::test::assert(own.code != 0 && std::str::contains(own.stderr, "is the entrypoint seed's own and on the surface already"), "naming the seed's own locus is refused: " + own.stderr);

    // ---- without serve, holding the locus serves nothing of it
    std::io::fs::write_file(root + "/app/main.hl", app_source(sock, me, "")) or discard;
    let unserved = run_tool(hale + "\ncheck\n--dump-api\n" + root + "/app");
    std::test::assert_eq_int(unserved.code, 0, "the app checks: " + unserved.stderr);
    std::test::assert(!std::str::contains(unserved.stdout, "lib::Orders") && !std::str::contains(unserved.stdout, "lib::Ticks") && std::str::contains(unserved.stdout, "\"serve\":[]"), "a held imported locus is not on the surface: " + unserved.stdout);

    // ---- serve: [handlers] — exactly that locus, and --dump-api says so
    std::io::fs::write_file(root + "/app/main.hl", app_source(sock, me, ", serve: [handlers]")) or discard;
    let served = run_tool(hale + "\ncheck\n--dump-api\n" + root + "/app");
    std::test::assert_eq_int(served.code, 0, "the app with serve checks: " + served.stderr);
    std::test::assert(std::str::contains(served.stdout, "\"serve\":[{\"param\":\"handlers\",\"locus\":\"lib::Handlers\"}]"), "the description names what serve names: " + served.stdout);
    std::test::assert(std::str::contains(served.stdout, "\"name\":\"lib::Orders\"") && std::str::contains(served.stdout, "\"role\":\"clerk\""), "the served locus's gated command is on the surface: " + served.stdout);
    std::test::assert(!std::str::contains(served.stdout, "lib::Ticks") && !std::str::contains(served.stdout, "lib.internal"), "the held, unnamed locus's bus is not: " + served.stdout);

    let built = run_tool(hale + "\nbuild\n" + root + "/app");
    std::test::assert_eq_int(built.code, 0, "and builds: " + built.stderr);
    let p = Proc { };
    std::test::assert(p.start(root + "/app/app"), "the app started");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);
    let r = api.ask("{\"id\":1,\"call\":\"Orders\",\"payload\":{\"id\":7}}");
    std::test::assert(std::str::contains(r, "\"ok\":true") && std::str::contains(r, "\"id\":7") && std::str::contains(r, "\"by\":\"uid:" + me + "\""), "the imported handler answers through the socket, gated: " + r);
    let t = api.ask("{\"id\":2,\"call\":\"lib::Ticks\",\"payload\":{\"n\":1}}");
    std::test::assert(std::str::contains(t, "\"kind\":\"unknown\""), "the internal topic is unknown to the binding: " + t);
    p.stop();
    std::io::fs::unlink(sock) or discard;
    let _rm = run_tool("rm\n-rf\n" + root);
}
