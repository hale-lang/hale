// dna/oidc/serve — the stub OpenID provider as a program (GH #989):
// `serve <port> [client]`, on 127.0.0.1. Local mode runs it in the seed
// compose's `oidc` service (`hale dna oidc up`), where it listens on the
// container's interface (HALE_DNA_OIDC_LISTEN) and compose publishes the
// port on the host's loopback alone; its issuer is the loopback URL
// either way. The client's secret is the vault's
// `oidc-client-<client>` (GH #989: the organism's bootstrap provisions it;
// this only consumes it, and refuses to start without it), and the key
// made for the launch — a PEM file (0600) named by
// HALE_DNA_OIDC_KEY_FILE, its coordinates in HALE_DNA_OIDC_KEY_X and _Y
// — never on argv. HALE_DNA_OIDC_SERVICES names the service clients
// (space-separated ids) it answers the `client_credentials` grant for,
// each secret the vault's `oidc-service-<id>`. A fixture hosts
// `oidc::StubIssuer` in its own process, or runs this one where the
// vault's environment has to be its own.

import ".." as oidc;

fn main() {
    let port = std::str::parse_int(std::env::arg_or(1, "")) or 0;
    let client = std::env::arg_or(2, "dna-local");
    let secret_vault = "oidc-client-" + client;
    if !std::secret::Credential { vault: secret_vault }.ready() {
        eprintln("hale dna oidc: the vault holds no secret for the client ", client, " (", secret_vault, "): `hale dna init` or `hale dna upgrade` in a project provisions it");
        std::process::exit(2);
    }
    let key_file = std::env::var("HALE_DNA_OIDC_KEY_FILE");
    let key = if len(key_file) > 0 { std::io::fs::read_file(key_file) or "" } else { "" };
    let x = std::env::var("HALE_DNA_OIDC_KEY_X");
    let y = std::env::var("HALE_DNA_OIDC_KEY_Y");
    if port < 1 || port > 65535 || len(key) == 0 || len(x) == 0 || len(y) == 0 {
        eprintln("usage: serve <port> [client], with the vault's oidc-client-<client> and the launch's key: HALE_DNA_OIDC_KEY_FILE, HALE_DNA_OIDC_KEY_X, HALE_DNA_OIDC_KEY_Y");
        std::process::exit(2);
    }
    // the issuer as the browser and the head reach it: the loopback port,
    // or the one compose publishes this container's port on
    let base = if std::env::var_exists("HALE_DNA_OIDC_BASE") && len(std::env::var("HALE_DNA_OIDC_BASE")) > 0 { std::env::var("HALE_DNA_OIDC_BASE") } else { "http://127.0.0.1:" + to_string(port) };
    println("hale dna oidc: ", base, " (stub provider; client ", client, ")");
    let listen = if std::env::var_exists("HALE_DNA_OIDC_LISTEN") && len(std::env::var("HALE_DNA_OIDC_LISTEN")) > 0 { std::env::var("HALE_DNA_OIDC_LISTEN") } else { "127.0.0.1" };
    std::http::Server { host: listen, port: port, handler: oidc::StubIssuer { base: base, client: client, secret_vault: secret_vault, key: key, kid: "launch", x: x, y: y, services: std::env::var("HALE_DNA_OIDC_SERVICES") } };
}
