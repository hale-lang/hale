// scene.hl — LotusFlowerScene.
//
// The default VizScene shipped with iris core. Ties together
// model + aesthetics + layout + animator + parse to render
// any Hale locus tower as an animated lotus flower.
//
// Works uniformly for Hale source projects (codebase IS
// the model) and non-Hale domains (agent writes Hale
// modeling the domain into <workspace>/.iris/models/; flower
// renders the model).
//
// Strategic frame: VISION.md §4. Implementation phase:
// PLAN.md §5 Phase 3. Design pins: ./DESIGN.md.

import "../raylib" as ray;

// heron itself is imported by heron_adapter.hl (same seed
// as this file). TreeSitterHaleParser is declared there
// and visible here through F.19's intra-seed scope sharing.

// ---- The scene ----

locus LotusFlowerScene {
    params {
        // Camera — substrate concern surfaced via VizScene.
        cam: ray::Camera3D = ray::Camera3D {
            position: ray::Vec3 { x: 0.0, y: 8.0, z: 12.0 },
            target:   ray::Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            up:       ray::Vec3 { x: 0.0, y: 1.0, z: 0.0 },
            fovy:     50.0,
        };

        // Tree provider — interface-typed (F.20). Default is
        // the heron-backed TreeSitterHaleParser declared in
        // heron_adapter.hl (same seed). Falls back gracefully
        // to an empty tree if the parser can't be allocated
        // (TreeSitterHaleParser checks is_ready() before
        // each parse_file call).
        provider: LocusTreeProvider
                = TreeSitterHaleParser { };

        // Per-petal animation state.
        animator: Animator = Animator { };

        // Which file the source pane is currently showing
        // (purely for state_json reporting).
        current_file: String = "";

        // Cached frame timestamp — updated at the start of
        // each render() so query helpers don't all hit the
        // syscall.
        frame_now_ns: Int = 0;
    }

    // ---- VizScene identity ----

    fn name() -> String   { return "lotus.flower"; }
    fn domain() -> String { return "hale"; }

    // ---- Lifecycle ----

    fn install() {
        // No-op for now. When the agent-driven prompt-priming
        // shape lands, install would seed a welcome animation
        // (root petal pulsing, "open me" caption).
        let _ = 0;
    }

    fn uninstall() {
        // No-op. Resources owned by params (F.29 cascade).
        let _ = 0;
    }

    // ---- Camera ----

    fn camera() -> ray::Camera3D { return self.cam; }

    fn set_camera(c: ray::Camera3D) { self.cam = c; }

    // ---- Source change → re-parse + re-layout ----

    fn on_source_changed(file: String, content: String) {
        self.current_file = file;
        // For v0, parse just the single file the source pane
        // shows. Multi-file workspace parsing (walking
        // .iris/models/) lands when the provider upgrades to
        // the tree-sitter impl AND fsnotify is wired across
        // the workspace.
        self.provider.clear();
        self.provider.parse_file(file, content);
        layout_tree(self.provider.tree());
    }

    // ---- Click → source.goto ----

    fn on_click(screen_x: Int, screen_y: Int) {
        // Phase 3 stub: real impl unprojects (screen_x,
        // screen_y) to a 3D ray under self.cam, hit-tests
        // each petal's bounding sphere (center = petal.x/y/z,
        // radius = petal.size * 1.3), picks the closest hit,
        // and publishes ide.cmd.source.goto to the petal's
        // (file, line).
        //
        // Defers on: (a) raylib's GetMouseRay / GetScreenToWorldRay
        // not yet in our @ffi surface, (b) topic publish
        // wiring for direct send from scene loci. Both small
        // follow-ups once the frame loop is exercising clicks.
        let _ = screen_x;
        let _ = screen_y;
    }

    // ---- Scene channel discovery (MCP viz.scene_info) ----

    fn channels_json() -> String {
        // The flower's cinematic surface — what the agent can
        // do beyond the universal viz primitives.
        let b = std::str::builder_new();
        std::str::builder_append(b, "[");
        std::str::builder_append(b, "{\"channel\":\"ide.cmd.viz.scene.spotlight\",");
        std::str::builder_append(b, "\"payload_schema\":\"{id:String}\",");
        std::str::builder_append(b, "\"description\":\"Spotlight one petal; non-spotlit petals dim. Send id=\\\"\\\" to clear.\"},");
        std::str::builder_append(b, "{\"channel\":\"ide.cmd.viz.scene.pulse\",");
        std::str::builder_append(b, "\"payload_schema\":\"{id:String,color:String?,repeats:Int?}\",");
        std::str::builder_append(b, "\"description\":\"Pulse a single petal N times in a color.\"},");
        std::str::builder_append(b, "{\"channel\":\"ide.cmd.viz.scene.draw_edge\",");
        std::str::builder_append(b, "\"payload_schema\":\"{a:String,b:String,color:String?,fade_ms:Int?}\",");
        std::str::builder_append(b, "\"description\":\"Draw an arced edge between two petals; fades after fade_ms. (v0 stub — render not yet wired.)\"},");
        std::str::builder_append(b, "{\"channel\":\"ide.cmd.viz.scene.narrate\",");
        std::str::builder_append(b, "\"payload_schema\":\"{id:String,text:String,duration_ms:Int?}\",");
        std::str::builder_append(b, "\"description\":\"Caption overlay anchored to a petal. (v0 stub — render not yet wired.)\"}");
        std::str::builder_append(b, "]");
        return std::str::builder_finish(b);
    }

    // ---- Scene channel dispatch ----

    fn dispatch(channel: String, payload_json: String) {
        let now = std::time::monotonic_ns();
        if channel == "ide.cmd.viz.scene.spotlight" {
            self.handle_spotlight(payload_json, now);
            return;
        }
        if channel == "ide.cmd.viz.scene.pulse" {
            self.handle_pulse(payload_json, now);
            return;
        }
        if channel == "ide.cmd.viz.scene.draw_edge" {
            // v0 stub — edge list + render not yet wired.
            let _ = payload_json;
            return;
        }
        if channel == "ide.cmd.viz.scene.narrate" {
            // v0 stub — caption overlay not yet wired.
            let _ = payload_json;
            return;
        }
        // Unknown channel — silent no-op. (Diagnostic is the
        // dispatcher's job, not the scene's.)
        let _ = channel;
        let _ = payload_json;
    }

    // ---- Spotlight handler ----
    //
    // v0 supports SINGLE id per call (matches the most common
    // cinematic step — "focus on this one petal"). Multi-id
    // spotlight needs a @form(vec) StringList type to carry
    // the array cleanly through dispatch; deferred. Send
    // id="" to clear.

    fn handle_spotlight(payload_json: String, now_ns: Int) {
        let id = std::json::find_string_field(payload_json, "id") or "";
        if id == "" {
            self.animator.clear_spotlight();
            return;
        }
        // set_spotlight takes an array; build a 1-element one.
        let ids: [String; 1] = [id];
        self.animator.set_spotlight(ids, now_ns);
    }

    // ---- Pulse handler ----

    fn handle_pulse(payload_json: String, now_ns: Int) {
        let id = std::json::find_string_field(payload_json, "id") or "";
        if id == "" { return; }
        let repeats = std::json::find_int_field(payload_json, "repeats") or 0;
        // Color stub: parsing "#RRGGBB" needs char-level
        // String ops we don't have ergonomic primitives for
        // yet. v0 ships white pulses. Polish phase wires
        // proper color parsing.
        let r = 255;
        let g = 255;
        let b = 255;
        self.animator.start_pulse(id, r, g, b, repeats, now_ns);
    }

    // ---- Scene-state snapshot (MCP viz.scene_info) ----

    fn state_json() -> String {
        let tree = self.provider.tree();
        let b = std::str::builder_new();
        std::str::builder_append(b, "{\"current_file\":\"");
        std::str::builder_append(b, self.current_file);
        std::str::builder_append(b, "\",\"petal_count\":");
        std::str::builder_append(b, to_string(tree.len()));
        std::str::builder_append(b, "}");
        return std::str::builder_finish(b);
    }

    // ---- Render ----

    fn render(s: RenderSurface) {
        let _ = s;   // RenderSurface is a clipping/area handle;
                     // raylib calls draw in absolute coords
                     // for now. VizPane will provide scissor
                     // when needed.

        self.frame_now_ns = std::time::monotonic_ns();
        self.animator.tick(self.frame_now_ns);

        ray::begin_mode_3d(self.cam);

        // Subtle reference grid on the y=0 plane below the
        // dome. Helps the camera orient during orbit.
        ray::draw_grid(20, 1.0);

        // Walk and render each petal.
        let tree = self.provider.tree();
        let n = tree.len();
        let any_spot = self.animator.any_spotlit();
        let mut i = 0;
        while i < n {
            let p = tree.get(i) or raise;
            self.render_petal(p, i, any_spot);
            i = i + 1;
        }

        ray::end_mode_3d();
    }

    // ---- Per-petal render ----

    fn render_petal(p: Petal, idx: Int, any_spot: Bool) {
        let scale = self.animator.scale_for(p.id, self.frame_now_ns);
        let alpha = self.animator.alpha_for(p.id, self.frame_now_ns);
        let dz    = self.animator.z_offset_for(p.id, self.frame_now_ns);

        if alpha <= 0.01 { return; }   // fully transparent — skip

        let sway = self.animator.sway_radians(idx, self.frame_now_ns);
        let petal_radius = p.size * scale;

        // Sway translates the petal slightly around its
        // angle; cheap approximation since raylib's 3D
        // primitives don't carry per-instance transforms in
        // our binding surface.
        let sway_dx = 0.05 * sin_approx(sway) * p.size;
        let sway_dy = 0.05 * cos_approx(sway) * p.size;

        let center = ray::Vec3 {
            x: p.x + sway_dx,
            y: p.z + dz,         // raylib y is "up" in our camera setup
            z: p.y + sway_dy,
        };

        // Color: kind + projection drive the outer hue.
        let mut c = outer_color_for(p);

        // Spotlight de-emphasis: non-spotlit petals dim when
        // any spotlight is active.
        if any_spot {
            if !self.animator.is_spotlit(p.id) {
                c = desaturate(c, SPOTLIGHT_OTHERS_SATURATION);
            }
        }

        // Pulse tint: mix toward the pulse color by pulse_mix.
        let pulse_mix = self.animator.pulse_mix_for(p.id, self.frame_now_ns);
        if pulse_mix > 0.0 {
            let tint = self.animator.pulse_tint_color_for(p.id);
            c = mix_color(c, tint, pulse_mix);
        }

        // Apply alpha multiplier.
        c.a = Int(255.0 * alpha);

        ray::draw_sphere(center, petal_radius, c);

        // (Inner gradient sphere — slightly smaller, paler —
        // would go here when we move from solid spheres to
        // disk-with-gradient. v0 ships solid spheres.)
    }
}

// ---- Per-petal color lookup (free fns) ----

fn outer_color_for(p: Petal) -> ray::Color {
    if p.kind.tag == 1 { return type_outer(); }
    if p.kind.tag == 2 { return iface_outer(); }
    // Locus — projection drives hue.
    if p.projection.tag == 1 { return locus_rich_outer(); }
    if p.projection.tag == 2 { return locus_chunked_outer(); }
    if p.projection.tag == 3 { return locus_recognition_outer(); }
    return locus_plain_outer();
}

fn inner_color_for(p: Petal) -> ray::Color {
    if p.kind.tag == 1 { return type_inner(); }
    if p.kind.tag == 2 { return iface_inner(); }
    if p.projection.tag == 1 { return locus_rich_inner(); }
    if p.projection.tag == 2 { return locus_chunked_inner(); }
    if p.projection.tag == 3 { return locus_recognition_inner(); }
    return locus_plain_inner();
}

// ---- Color math helpers ----

// Pull a color toward neutral gray by `factor` (0..1).
// 0 = no change; 1 = fully gray.
fn desaturate(c: ray::Color, factor: Float) -> ray::Color {
    let gray = (c.r + c.g + c.b) / 3;
    let f = factor;
    let inv = 1.0 - f;
    return ray::Color {
        r: Int((c.r + 0.0) * inv + (gray + 0.0) * f),
        g: Int((c.g + 0.0) * inv + (gray + 0.0) * f),
        b: Int((c.b + 0.0) * inv + (gray + 0.0) * f),
        a: c.a,
    };
}

// Mix `c` toward `tint` (rgb array) by `mix` (0..1).
fn mix_color(c: ray::Color, tint: [Int; 3], mix: Float) -> ray::Color {
    let inv = 1.0 - mix;
    return ray::Color {
        r: Int((c.r + 0.0) * inv + (tint[0] + 0.0) * mix),
        g: Int((c.g + 0.0) * inv + (tint[1] + 0.0) * mix),
        b: Int((c.b + 0.0) * inv + (tint[2] + 0.0) * mix),
        a: c.a,
    };
}
