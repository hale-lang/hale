// GH #1417 (R8b, spec/api.md § gRPC) — the protobuf codec of a record.
//
// A program that serves a surface over `grpc::Rpc` gets, beside the JSON
// codec of each record its rows carry, `__api_pb_decode_<T>` and
// `__api_pb_encode_<T>`: proto3's wire format, the fields numbered in the
// order the struct declares them. This program names no port: the serve site
// is in a method nothing calls, which is all the compiler needs to write the
// codecs, and the program calls them as the transport's thunks do.
//
// Held here: encode then decode is identity (zeros and negatives included, a
// field with a default too), the JSON and protobuf decoders agree on a value,
// an unknown field is skipped by its wire type, a field of the wrong wire
// type is `wrong_type`, a field with no default that is absent is
// `missing_field` (the words of the JSON codec), a cut message is refused,
// the last of a field sent twice wins, a singular message sent twice is merged
// (at every level), and a scalar row's one-field message is read the same way.

unit cent;
type Money = quantity Int in cent;
type OrderId = distinct Int;
type Count = Int;

type Inner { tag: String; weight: Float; live: Bool; }
type Rich {
    id: OrderId;
    amount: Money;
    n: Count;
    name: String;
    ratio: Float;
    live: Bool;
    inner: Inner;
    note: String = "none";
    level: Int = 3;
}

type Part { a: Int = 0; b: Int = 0; }
type Whole { part: Part; }
type Top { whole: Whole; }
type Need { x: Int; y: Int; }
type Needs { need: Need; }

api Pb {
    rpc Probe::whole;
    rpc Probe::top;
    rpc Probe::needs;
    rpc Probe::wide;
    rpc Probe::index;
    rpc Probe::count;
}

locus Probe {
    fn whole(w: Whole) -> Whole { return w; }
    fn top(t: Top) -> Top { return t; }
    fn needs(n: Needs) -> Needs { return n; }
    fn wide(r: Rich) -> Rich { return r; }
    fn index(e: IndexError) -> IndexError { return e; }
    fn count(n: Int) -> Int { return n; }
}

locus Tokens {
    fn principal(token: String) -> std::api::Principal {
        return std::api::Principal { mode: "bearer", name: "" };
    }
    fn refused() -> String { return "no such token"; }
}

main locus Desk {
    params {
        probe: Probe = Probe { };
        bearer: Tokens = Tokens { };
    }

    // Never called: the serve site is what makes the compiler write the codecs.
    fn serving() {
        let h = api::serve(Pb, grpc::Rpc { bind: "127.0.0.1:0", codec: json, principals: self.bearer }, as: "pb", receivers: { Probe: self.probe }, bound: 4, on_full: refuse);
        h.stop();
    }

    fn make(id: Int, amount: Int, n: Int, name: String, ratio: Float, live: Bool, note: String, level: Int) -> Rich {
        return Rich { id: OrderId(id), amount: amount * 1cent, n: n, name: name, ratio: ratio, live: live, inner: Inner { tag: "tag", weight: 2.5, live: true }, note: note, level: level };
    }

    // The same value through the JSON codec: text.
    fn same(a: Rich, b: Rich, what: String) {
        std::test::assert_eq_str(__api_encode_Rich(a), __api_encode_Rich(b), what);
    }

    fn round(v: Rich, what: String) {
        let bytes = __api_pb_encode_Rich(v);
        let back = __api_pb_decode_Rich(bytes) or {
            std::test::assert(false, what + ": decode failed " + err.kind + " " + err.field);
            return;
        };
        self.same(v, back, what);
    }

    // The fields a Rich must carry, as a message: id, amount, n, name, ratio,
    // live, inner. `note` (8) and `level` (9) have defaults.
    fn required() -> Bytes {
        let inner = std::bytes::concat(std::bytes::concat(__api_pb_put_str(1, "in"), __api_pb_put_f64(2, 0.5)), __api_pb_put_bool(3, false));
        let a = std::bytes::concat(__api_pb_put_int(1, 7), __api_pb_put_int(2, 250));
        let b = std::bytes::concat(__api_pb_put_int(3, 4), __api_pb_put_str(4, "name"));
        let c = std::bytes::concat(__api_pb_put_f64(5, 1.25), __api_pb_put_bool(6, true));
        return std::bytes::concat(std::bytes::concat(a, b), std::bytes::concat(c, __api_pb_put_msg(7, inner)));
    }

    fn fails(bytes: Bytes, kind: String, field: String, what: String) {
        let got = __api_pb_decode_Rich(bytes) or {
            std::test::assert_eq_str(err.kind, kind, what + ": the kind");
            std::test::assert_eq_str(err.field, field, what + ": the field");
            return;
        };
        std::test::assert(false, what + ": it decoded " + got.name);
    }

    run() {
        // ---- encode then decode is identity ----
        self.round(self.make(7, 12500, 3, "ACME", 0.1, true, "x", 9), "a value");
        self.round(self.make(0, 0, 0, "", 0.0, false, "", 0), "zeros are values, not absences");
        self.round(self.make(0 - 5, 0 - 12500, 0 - 1, "neg", 0.0 - 2.75, true, "n", 0 - 3), "negatives, ten bytes a varint");
        let top = 9223372036854775807;
        self.round(self.make(top, 0 - top, top, "big", 1.7976931348623157e308, true, "b", 0 - top - 1), "the ends of Int");
        self.round(self.make(1, 1, 1, "line\nbreak \"quoted\" \\ tab\t", 1.0e-300, false, "note", 2), "text that JSON escapes");
        // a negative Int is ten bytes on the wire, as proto3 writes int64
        let neg = __api_pb_put_int(1, 0 - 1);
        std::test::assert_eq_int(len(neg), 11, "a negative varint is ten bytes after its tag");

        // ---- the two decoders read a value the same ----
        let json = "{\"id\":7,\"amount\":12500,\"n\":3,\"name\":\"ACME\",\"ratio\":0.5,\"live\":true,\"inner\":{\"tag\":\"x\",\"weight\":1.5,\"live\":false},\"note\":\"hi\",\"level\":4}";
        let from_json = __api_decode_Rich(json) or {
            std::test::assert(false, "the JSON decoder: " + err.kind + " " + err.field);
            return;
        };
        let through = __api_pb_decode_Rich(__api_pb_encode_Rich(from_json)) or {
            std::test::assert(false, "the protobuf decoder: " + err.kind + " " + err.field);
            return;
        };
        self.same(from_json, through, "a value read from JSON, carried as protobuf");
        std::test::assert_eq_str(__api_encode_Rich(through), json, "and written back as the same JSON");
        // a field with a default, left out of the JSON, is left out of the message and read as the default
        let bare = __api_decode_Rich("{\"id\":7,\"amount\":250,\"n\":4,\"name\":\"name\",\"ratio\":1.25,\"live\":true,\"inner\":{\"tag\":\"in\",\"weight\":0.5,\"live\":false}}") or {
            std::test::assert(false, "the JSON decoder, defaults");
            return;
        };
        let defaulted = __api_pb_decode_Rich(self.required()) or {
            std::test::assert(false, "the protobuf decoder, defaults: " + err.kind + " " + err.field);
            return;
        };
        self.same(bare, defaulted, "a message without the fields that have defaults is the JSON without them");
        std::test::assert_eq_str(defaulted.note, "none", "the default of a String");
        std::test::assert_eq_int(defaulted.level, 3, "the default of an Int");

        // ---- unknown fields are skipped by their wire type ----
        let extra = std::bytes::concat(std::bytes::concat(__api_pb_put_int(99, 5), __api_pb_put_str(98, "zz")), __api_pb_put_f64(97, 1.5));
        let skipped = __api_pb_decode_Rich(std::bytes::concat(extra, self.required())) or {
            std::test::assert(false, "unknown fields: " + err.kind + " " + err.field);
            return;
        };
        self.same(bare, skipped, "unknown fields before the known ones");
        let after = __api_pb_decode_Rich(std::bytes::concat(self.required(), extra)) or {
            std::test::assert(false, "unknown fields after: " + err.kind + " " + err.field);
            return;
        };
        self.same(bare, after, "unknown fields after the known ones");

        // ---- the last of a field sent twice wins ----
        let twice = __api_pb_decode_Rich(std::bytes::concat(self.required(), __api_pb_put_str(4, "second"))) or {
            std::test::assert(false, "a repeated field");
            return;
        };
        std::test::assert_eq_str(twice.name, "second", "the later name");

        // ---- a message field sent twice is merged, not replaced ----
        // `part { a: 7 }` then `part { b: 9 }` is `part { a: 7, b: 9 }`
        let one = __api_pb_put_msg(1, __api_pb_put_int(1, 7));
        let two = __api_pb_put_msg(1, __api_pb_put_int(2, 9));
        std::test::assert_eq_int(len(std::bytes::concat(one, two)), 8, "the bytes 0a0208070a021009");
        let merged = __api_pb_decode_Whole(std::bytes::concat(one, two)) or {
            std::test::assert(false, "a message sent twice: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_int(merged.part.a, 7, "the first occurrence's field survives");
        std::test::assert_eq_int(merged.part.b, 9, "and the second's is added");
        // a scalar sent in several occurrences: the last wins
        let wide_a = __api_pb_put_msg(1, std::bytes::concat(__api_pb_put_int(1, 1), __api_pb_put_int(2, 5)));
        let last = __api_pb_put_msg(1, __api_pb_put_int(1, 3));
        let three = __api_pb_decode_Whole(std::bytes::concat(std::bytes::concat(wide_a, two), last)) or {
            std::test::assert(false, "three occurrences: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_int(three.part.a, 3, "the last a");
        std::test::assert_eq_int(three.part.b, 9, "the last b");
        // two levels: `whole { part { a: 7 } }` then `whole { part { b: 9 } }`
        let deep = std::bytes::concat(__api_pb_put_msg(1, one), __api_pb_put_msg(1, two));
        let top = __api_pb_decode_Top(deep) or {
            std::test::assert(false, "two levels: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_int(top.whole.part.a, 7, "two levels, a");
        std::test::assert_eq_int(top.whole.part.b, 9, "two levels, b");
        // the fields with no default may arrive in different occurrences
        let nx = __api_pb_put_msg(1, __api_pb_put_int(1, 4));
        let ny = __api_pb_put_msg(1, __api_pb_put_int(2, 6));
        let needs = __api_pb_decode_Needs(std::bytes::concat(nx, ny)) or {
            std::test::assert(false, "required fields split: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_int(needs.need.x, 4, "x");
        std::test::assert_eq_int(needs.need.y, 6, "y");

        // ---- what a message gets wrong, in the JSON codec's words ----
        let no_name = std::bytes::concat(std::bytes::concat(__api_pb_put_int(1, 7), __api_pb_put_int(2, 250)), std::bytes::concat(__api_pb_put_int(3, 4), __api_pb_put_f64(5, 1.25)));
        self.fails(no_name, "missing_field", "name", "a field with no default, absent");
        self.fails(std::bytes::from_string(""), "missing_field", "id", "an empty message: the first field that is missing");
        self.fails(__api_pb_put_str(1, "x"), "wrong_type", "id", "a string where a varint is");
        self.fails(__api_pb_put_int(4, 1), "wrong_type", "name", "a varint where a string is");
        self.fails(__api_pb_put_int(5, 1), "wrong_type", "ratio", "a varint where a double is");
        self.fails(__api_pb_put_int(7, 1), "wrong_type", "inner", "a varint where a message is");
        let cut = __api_pb_put_str(4, "hello");
        self.fails(std::bytes::slice(cut, 0, len(cut) - 2), "wrong_type", "payload", "a string cut short");
        self.fails(std::bytes::slice(__api_pb_put_int(1, 300), 0, 2), "wrong_type", "payload", "a varint cut short");
        let ff = std::bytes::from_int(255);
        let four = std::bytes::concat(std::bytes::concat(ff, ff), std::bytes::concat(ff, ff));
        self.fails(std::bytes::concat(std::bytes::concat(four, four), std::bytes::concat(four, std::bytes::from_int(1))), "wrong_type", "payload", "a varint longer than ten bytes");

        // ---- a builtin record is its fields ----
        let ie = IndexError { kind: "short", index: 3, len: 2 };
        let ie_back = __api_pb_decode_IndexError(__api_pb_encode_IndexError(ie)) or {
            std::test::assert(false, "IndexError: " + err.kind + " " + err.field);
            return;
        };
        std::test::assert_eq_str(__api_encode_IndexError(ie_back), __api_encode_IndexError(ie), "a builtin record");

        // ---- a scalar row's message holds the value in field 1 ----
        let n = __api_pb_box_int(__api_pb_put_int(1, 42)) or { return; };
        std::test::assert_eq_int(n, 42, "an Int");
        let m = __api_pb_box_int(__api_pb_put_int(1, 0 - 42)) or { return; };
        std::test::assert_eq_int(m, 0 - 42, "a negative Int");
        let s = __api_pb_box_str(__api_pb_put_str(1, "text")) or { return; };
        std::test::assert_eq_str(s, "text", "a String");
        let f = __api_pb_box_float(__api_pb_put_f64(1, 2.5)) or { return; };
        std::test::assert(f == 2.5, "a Float");
        let t = __api_pb_box_bool(__api_pb_put_bool(1, true)) or { return; };
        std::test::assert(t, "a Bool");
        let none = __api_pb_box_int(std::bytes::from_string("")) or {
            std::test::assert_eq_str(err.kind, "missing_field", "an empty scalar message: the kind");
            std::test::assert_eq_str(err.field, "value", "an empty scalar message: the field");
            0
        };
        std::test::assert_eq_int(none, 0, "the substitute");
        let wrong = __api_pb_box_int(__api_pb_put_str(1, "x")) or {
            std::test::assert_eq_str(err.kind, "wrong_type", "a scalar of the wrong wire type");
            0
        };
        std::test::assert_eq_int(wrong, 0, "the substitute");
    }
}

fn main() { Desk { }; }
