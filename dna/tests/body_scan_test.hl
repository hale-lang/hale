// GH #638, GH #970 — a body finds what it started wherever that ended
// up. The body fence stops a tool whose organization has already died,
// which a walk down from the organization's pid cannot reach: the tool was
// reparented the moment its parent went, and it took a process group of
// its own (every `std::process::run` child does).
//
// What the fence has on every platform is the session: everything a body
// starts begins one (`dna::in_new_session`), and a descendant keeps it
// through any regrouping or reparenting. That is the part this fixture
// proves everywhere. The environment mark is a second net where a machine
// discloses another process's environment (Linux's /proc); macOS never
// does, `ps -E` included, and there the scan reports nothing.
//
// The full lease story is body_lease_blocked_test.

import "../core" as dna;

fn alive(pid: String) -> Bool {
    return len(pid) > 0 && dna::run_tool("kill\n-0\n" + pid).code == 0;
}

// A tool orphaned before it is looked for, in a process group of its own,
// inside a session begun for it — what an organization that started a
// tool through `run_tool` and then crashed leaves behind. The tool is a
// script under `dir`, a program of this body's own (a COPY of a system
// binary will not even start on macOS: its signature is the platform's).
// Carries `mark` in its environment. Returns "<session leader> <tool>".
fn orphan_in_session(mark: String, dir: String) -> String {
    let tool = dir + "/tool";
    std::io::fs::write_file(tool, "#!/bin/sh\necho $$ > \"$1\"\nwhile :; do sleep 1; done\n") or discard;
    let x = dna::run_tool("chmod\n+x\n" + tool);
    // the leader records itself, starts the tool in a group of its own
    // (`set -m`), and exits: the tool is reparented at once. Every stream
    // is its own, so nothing holds the pipe this call reads.
    let inner = "exec </dev/null >/dev/null 2>&1; echo $$ > \"$1\"; set -m; env HALE_DNA_BODY=\"$3\" \"$4\" \"$2\" & exit 0";
    let started = dna::run_tool(dna::in_new_session("sh\n-c\n" + inner + "\nsh\n" + dir + "/leader.pid\n" + dir + "/orphan.pid\n" + mark + "\n" + tool));
    let mut tries = 0;
    while tries < 200 {
        let leader = dna::trim_nl(std::io::fs::read_file(dir + "/leader.pid") or "");
        let pid = dna::trim_nl(std::io::fs::read_file(dir + "/orphan.pid") or "");
        if len(leader) > 0 && len(pid) > 0 && !alive(leader) { return leader + " " + pid; }
        std::time::sleep(50ms);
        tries = tries + 1;
    }
    return "";
}

fn field(s: String, n: Int) -> String {
    let sp = std::str::index_of(s, " ");
    if sp < 0 { return if n == 0 { s } else { "" }; }
    return if n == 0 { s[0..sp] } else { s[(sp + 1)..len(s)] };
}

fn stopped(pid: String) -> Bool {
    let mut tries = 0;
    while alive(pid) && tries < 100 {
        std::time::sleep(50ms);
        tries = tries + 1;
    }
    return !alive(pid);
}

main locus App {
    run() {
        let scratch = dna::scratch_root("bodyscan");
        dna::reap_on_exit(scratch);

        // the mark is one body's: another body's does not match it, and no
        // mark is a prefix of another
        let mine = dna::body_mark("riley@srv:/srv/books", 7, 4242);
        std::test::assert_eq_str(mine, "riley@srv:/srv/books#7#4242#", "holder, token and host pid");
        std::test::assert(mine != dna::body_mark("riley@srv:/srv/books", 7, 42), "a host pid that starts the same is another body");
        std::test::assert(mine != dna::body_mark("riley@srv:/srv/books", 71, 4242), "so is a token that starts the same");

        let scan = dna::body_scan();
        std::test::assert(scan == "proc" || scan == "ps" || scan == "", "a scan is /proc, ps -E, or nothing: " + scan);

        // a tool of this body's, already orphaned, in a group of its own
        let mark = dna::body_mark("fixture@here", 1, std::process::pid());
        let got = orphan_in_session(mark, scratch);
        let leader = field(got, 0);
        let orphan = field(got, 1);
        std::test::assert(alive(orphan), "the tool runs: " + got);
        std::test::assert(dna::trim_nl(dna::run_tool("ps\n-o\nppid=\n-p\n" + orphan).stdout) != leader, "and is its dead leader's child no longer");
        std::test::assert(dna::trim_nl(dna::run_tool("ps\n-o\npgid=\n-p\n" + orphan).stdout) != leader, "and leads a process group of its own");

        // the session: found on every platform, and stopped by it
        let members = dna::session_members(leader);
        std::test::assert(std::str::contains("\n" + members + "\n", "\n" + orphan + "\n"), "the orphaned tool is in the session its leader began: found [" + members + "], wanted " + orphan);
        std::test::assert(!std::str::contains("\n" + dna::session_members(to_string(std::process::pid())) + "\n", "\n" + orphan + "\n"), "and in no other");
        std::test::assert_eq_str(dna::session_members(""), "", "no leader finds nothing");

        // the mark, where this machine discloses environments
        if len(scan) == 0 {
            std::test::assert_eq_str(dna::marked(mark), "", "a machine with no scan finds nothing by mark");
        } else {
            let found = dna::marked(mark);
            std::test::assert(std::str::contains("\n" + found + "\n", "\n" + orphan + "\n"), "the orphaned tool is found by its mark (" + scan + "): found [" + found + "], wanted " + orphan);
            std::test::assert_eq_str(dna::marked(dna::body_mark("nobody@nowhere", 1, 1)), "", "another body's mark finds nothing");
            std::test::assert_eq_str(dna::marked(""), "", "no mark finds nothing");
        }

        let k = dna::run_tool("kill\n-KILL\n" + members);
        std::test::assert(stopped(orphan), "and is stopped by its session");
        std::test::assert_eq_str(dna::session_members(leader), "", "nothing of that session is left");

        dna::scratch_done(scratch);
    }
}

fn main() { App { }; }
