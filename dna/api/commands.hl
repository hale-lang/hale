    fn inactive_attempt(r: CommandReceipt) -> Bool {
        let a = r.attempt;
        return a.state == "" && a.attempt_id == "" && a.work_id == "" && a.task_id == "" && a.performer_kind == "" && a.holder == "" && a.token == -1 && a.until == 0 && a.disposition == "" && a.reason == "" && a.event_id == "";
    }
    // A claim reads back its lease, or its refusal; an outcome reads back
    // `requested` until the owner settles or refuses it.
    fn attempt_valid(r: CommandReceipt) -> Bool {
        let a = r.attempt; let source = ops::OrganizationCommandCodec { }; let claim = r.operation == "dna.attempt.claim";
        let renew = r.operation == "dna.attempt.renew"; let give_back = r.operation == "dna.attempt.release"; let friction = r.operation == "dna.friction.file";
        if r.target_kind != if claim { "dna.work" } else if friction { "dna.friction" } else { "dna.attempt" } || !self.bounded(r.subject_digest, 256, true, false)
            || r.proposal_state != "" || r.verdict_value != "" || r.verdict_state != "" || r.candidate_digest != "" || r.review_id != ""
            || r.review_state != "unavailable" || r.activation_state != "unknown" || r.activation_reason != "" { return false; }
        if (claim || friction) && r.target_id != r.application_id { return false; }
        if !claim && !friction && (r.target_id != a.attempt_id || !self.bounded(a.attempt_id, 256, true, false)) { return false; }
        if a.state == "unknown" { return r.state == "outcome_unknown" && a.event_id == "" && a.until == 0; }
        // a refusal at the head names no row; one the owner wrote (`attempt.outcome_refused`) names the requested row it answers
        if a.state == "refused" { return r.state == "refused" && self.bounded(a.reason, 2048, true, true) && a.reason == r.reason && (a.event_id == "" || source.commit_id(a.event_id)); }
        if r.state != "succeeded" || !source.commit_id(a.event_id) || !self.bounded(a.holder, 256, true, false) { return false; }
        if friction { return a.state == "filed" && a.token == -1 && a.until == 0 && a.disposition == ""; }
        if a.token < 0 { return false; }
        if claim { return a.state == "claimed" && self.bounded(a.attempt_id, 256, true, false) && self.bounded(a.work_id, 256, true, false) && self.bounded(a.task_id, 256, true, false) && self.bounded(a.performer_kind, 64, true, false) && a.until > 0; }
        if renew { return a.state == "renewed" && a.until > 0 && a.disposition == ""; }
        if give_back { return a.state == "released" && a.until == 0 && a.disposition == ""; }
        if a.state != "requested" && a.state != "settled" { return false; }
        return a.until == 0 && (a.disposition == "done" || a.disposition == "failed" || a.disposition == "declined" || a.disposition == "timeout");
    }
    fn task_create_capability_json(capability: CommandCapability, origin: String) -> String {
        let available = capability.available && self.origin_valid(origin);
        let b = std::json::Builder { }; b.begin_object();
        b.string_field("profile", "dna.task.create.v1"); b.bool_field("available", available); b.bool_field("authorized", available && capability.authorized);
        b.string_field("position_id", "org"); b.string_field("recovery", "record_lifetime");
        b.string_field("max_outcome_bytes", "8192"); b.string_field("max_identity_bytes", "256"); b.string_field("max_request_bytes", "32768");
        b.string_field("reason", if !self.origin_valid(origin) { "Command submission has no configured origin." } else if self.bounded(capability.reason, 512, false, true) { capability.reason } else { "Task creation capability is unavailable." });
        b.end_object(); return b.result();
