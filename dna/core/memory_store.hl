// dna/core/memory_store.hl — the knowledge graph in memory (GH #583 K1,
// GH #985).
//
// The record holds the decided half: every ratified idea is a
// `knowledge.ratified` row naming a receipt. Memory holds the live,
// queryable half: a `KnowledgeStore` the spine applies the record's rows
// into on its tick (dna/operations/memory_tail.hl) and heads read under
// their own role. `Pq` is Postgres through pond's driver, one schema per
// record. Nothing here lives on the local filesystem.

import "./pond/db" as db;
import "./pond/pq" as pq;

// ---- the store ----------------------------------------------------------

interface KnowledgeStore {
    fn kind() -> String;
    // The record this store projects, by its identity (the sha of its
    // first commit). Set before `open`: a Postgres store keeps one
    // schema per record, so two records on one database each see only
    // their own graph, and a store opened for one record refuses
    // another's schema (GH #613). Empty while the record has no rows.
    fn scope(record: String);
    fn record() -> String;
    // Migrate and connect; false with `last_error` set when it cannot.
    fn open() -> Bool;
    // Whether the connection this store holds still answers. An open
    // that succeeded once says nothing about now: a database restart,
    // or anything that drops the session, leaves a store that reports
    // itself open and fails every query (the review's second round,
    // finding 4). Cheap enough to ask on each request.
    fn healthy() -> Bool;
    // Drop whatever is held and connect again, whatever the store
    // thinks its state is.
    fn reopen() -> Bool;
    fn last_error() -> String;
    // Forget the last error, so a caller can tell whether the read it
    // is about to make failed rather than inheriting an older one.
    fn forget_error();
    // The next record seq to apply (0 = nothing applied yet).
    fn watermark() -> Int;
    fn set_watermark(seq: Int) -> Bool;
    // The projection is derived and rebuildable: drop every projected row
    // and every projection stamp, so the next apply starts from row 0. The
    // record's identity and the store's scope stay. A reconcile that
    // re-appended rows beneath a stamped prefix is the reason this exists.
    fn rebuild() -> Bool;
    // Idempotent by id: a second write with the same id updates in place.
    fn upsert(i: Idea, ratified_seq: Int) -> Bool;
    // The idea is no longer accepted (a ratified supersession retired
    // it): it leaves every package but stays readable by id.
    fn retire(id: String, seq: Int) -> Bool;
    fn bind(b: KnowledgeBinding) -> Bool;
    // Exact idea/target/author tuple; absent is an idempotent success.
    fn unbind(b: KnowledgeBinding) -> Bool;
    fn link(e: KnowledgeEdge) -> Bool;
    // Ensure this exact directed tuple is absent. Missing is an idempotent
    // success; only an actual removal changes the graph generation.
    fn unlink(e: KnowledgeEdge) -> Bool;
    // One idea by id (`present` false when absent).
    fn idea(id: String) -> Stored;
    // Ids of accepted ideas bound to `target` or any of its ancestors
    // (goals flow down), space-separated, at most `budget`, in
    // ratification order.
    fn context_ids(target: String, budget: Int) -> String;
    // The same bounded set, ranked by similarity to `query_vec` (an
    // `embed_text` literal) so the budget keeps the most relevant;
    // an empty literal is `context_ids` (GH #583 K3).
    fn ranked_ids(target: String, budget: Int, query_vec: String) -> String;
    // "ideas" | "ratified" | "proposed" | "bindings" | "edges"
    fn count(what: String) -> Int;
    // ---- projections (K3): the code's structure by record row, and the
    // operational signals, so the graph has what ideas bind to and what
    // the fleet is saying ----
    fn put_structure(kind: String, name: String, seq: Int, body: String) -> Bool;
    fn structure_count(kind: String) -> Int; // "" = every kind
    fn structure_names(kind: String) -> String; // space-separated
    // one row per (kind, source, what): the count and the last record row
    fn put_signal(kind: String, source: String, what: String, seq: Int) -> Bool;
    fn signals() -> String; // a JSON array of {kind, source, what, count, last_seq}
}

type Signal { kind: String = ""; source: String = ""; what: String = ""; count: Int = 0; last_seq: Int = 0; }
type Structure { kind: String = ""; name: String = ""; seq: Int = 0; }

fn signal_json(x: Signal) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("kind", x.kind);
    b.string_field("source", x.source);
    b.string_field("what", x.what);
    b.int_field("count", x.count);
    b.int_field("last_seq", x.last_seq);
    b.end_object();
    return b.result();
}

type Stored {
    present: Bool = false;
    idea: Idea = Idea { };
    ratified_seq: Int = 0;
}

// A separate structural surface keeps existing projection-only stores valid.
// Cursors are the last visible tuple, with each native key kept separately.
// A failed page invalidates everything already offered to its sink.
type GraphQuery {
    kind: String = "nodes";
    id: String = "";
    target: String = "";
    after_first: String = "";
    after_second: String = "";
    after_third: String = "";
    limit: Int = 25;
}
interface KnowledgeReadPolicy { fn visible(id: String) -> Bool; }
interface GraphSink {
    fn node(row: Stored) -> Bool;
    fn edge(row: KnowledgeEdge) -> Bool;
    fn binding(row: KnowledgeBinding) -> Bool;
}
type GraphProjection {
    ok: Bool = false;
    watermark: Int = 0;
    head: String = "";
    live_watermark: Int = 0;
    pending_watermark: Int = 0;
    pending_head: String = "";
}

type GraphPage {
    ok: Bool = false;
    error: String = "";
    record: String = "";
    generation: Int = 0;
    watermark: Int = 0;
    // Last proven applied Record prefix, distinct from the live watermark
    // while an event or catch-up is being applied. Zero/empty is unproven.
    projection_watermark: Int = 0;
    projection_head: String = "";
    // A target is recorded before any projection writes. Its presence
    // withholds public reads even if a failed event left the live mark behind.
    projection_pending_watermark: Int = 0;
    projection_pending_head: String = "";
    // Exact requested identity exists and is visible, independent of target
    // relevance or cursor position. False for a collection without an id.
    subject_present: Bool = false;
    has_more: Bool = false;
    last_first: String = "";
    last_second: String = "";
    last_third: String = "";
}
interface GraphStore {
    fn read_graph(query: GraphQuery, policy: KnowledgeReadPolicy, sink: GraphSink) -> GraphPage;
    // -1 means the authoritative generation could not be read.
    fn graph_generation() -> Int;
    fn projection_basis() -> GraphProjection;
    // Compare the complete observed basis, including live progress, before
    // writes. The caller proves both stamped and pending Record ancestry.
    fn begin_projection(previous: GraphProjection, watermark: Int, head: String) -> Bool;
    // Compare stamped/pending pairs and complete only the fully applied target.
    // An identical checkpoint succeeds without changing generation.
    fn checkpoint_projection(previous: GraphProjection, watermark: Int, head: String) -> Bool;
}

type GraphKey { first: String = ""; second: String = ""; third: String = ""; index: Int = 0; }
@form(vec)
locus GraphKeys { capacity { heap rows of GraphKey; } }
type GraphTarget { id: String = ""; }
@form(hashmap)
locus GraphTargets { capacity { pool rows of GraphTarget indexed_by id; } }

locus GraphRules {
    params { }
    fn projection_valid(basis: GraphProjection) -> Bool {
        if !basis.ok || basis.watermark < 0 || basis.live_watermark < basis.watermark || basis.pending_watermark < 0 || len(basis.head) > 4096 || len(basis.pending_head) > 4096 { return false; }
        if (basis.watermark == 0) != (len(basis.head) == 0) || (basis.pending_watermark == 0) != (len(basis.pending_head) == 0) { return false; }
        // A legacy unstamped store can still be inspected natively. It is
        // never admitted by begin: clean progress must equal its stamp.
        return basis.pending_watermark == 0 || (basis.pending_watermark > basis.watermark && basis.pending_watermark >= basis.live_watermark);
    }
    fn projection_begin_valid(previous: GraphProjection, watermark: Int, head: String) -> Bool {
        if !self.projection_valid(previous) || watermark <= previous.watermark || watermark < previous.live_watermark || watermark < previous.pending_watermark || len(head) == 0 || len(head) > 4096 { return false; }
        return previous.pending_watermark > 0 || previous.live_watermark == previous.watermark;
    }
    fn validate(q: GraphQuery) -> String {
        if q.kind != "nodes" && q.kind != "edges" && q.kind != "bindings" { return "invalid_query"; }
        if q.limit < 1 || q.limit > 100 { return "invalid_query"; }
        if q.kind == "edges" && (len(q.id) == 0 || len(q.target) > 0) { return "invalid_query"; }
        if q.kind == "nodes" && (len(q.after_second) > 0 || len(q.after_third) > 0) { return "invalid_query"; }
        if len(q.after_first) == 0 && (len(q.after_second) > 0 || len(q.after_third) > 0) { return "invalid_query"; }
        if len(q.id) > 4096 || len(q.target) > 4096 || len(q.after_first) > 4096 || len(q.after_second) > 4096 || len(q.after_third) > 4096 { return "read_limit"; }
        return "";
    }
    // Compare UTF-8 bytes, never joined or normalized strings. This agrees
    // with Postgres COLLATE "C", including embedded separators/newlines.
    fn compare(a: String, b: String) -> Int {
        let mut n = 0;
        while n < len(a) && n < len(b) {
            let x = std::str::byte_at_unchecked(a, n);
            let y = std::str::byte_at_unchecked(b, n);
            if x < y { return -1; }
            if x > y { return 1; }
            n = n + 1;
        }
        if len(a) < len(b) { return -1; }
        if len(a) > len(b) { return 1; }
        return 0;
    }
    fn compare_key(a: GraphKey, b: GraphKey) -> Int {
        let first = self.compare(a.first, b.first);
        if first != 0 { return first; }
        let second = self.compare(a.second, b.second);
        if second != 0 { return second; }
        return self.compare(a.third, b.third);
    }
    fn key_ok(k: GraphKey) -> Bool { return len(k.first) <= 4096 && len(k.second) <= 4096 && len(k.third) <= 4096; }
    fn after(k: GraphKey, q: GraphQuery) -> Bool {
        return len(q.after_first) == 0 || self.compare_key(k, GraphKey { first: q.after_first, second: q.after_second, third: q.after_third }) > 0;
    }
    fn node_bytes(i: Idea) -> Int { return len(i.id) + len(i.kind) + len(i.text) + len(i.author) + len(i.provenance) + len(i.name) + len(i.supersedes) + 32; }
    fn edge_bytes(e: KnowledgeEdge) -> Int { return len(e.from) + len(e.to) + len(e.rel); }
    fn binding_bytes(b: KnowledgeBinding) -> Int { return len(b.idea) + len(b.target) + len(b.author) + len(b.class); }
    fn applies(bound: String, target: String) -> Bool { return bound == target || is_ancestor(bound, target); }
    fn stored(row: String) -> Stored {
        return Stored { present: true, idea: Idea {
            id: std::json::find_string_field(row, "id"), kind: std::json::find_string_field(row, "kind"),
            text: std::json::find_string_field(row, "text"), author: std::json::find_string_field(row, "author"),
            provenance: std::json::find_string_field(row, "provenance"), revision: std::json::find_int_field(row, "revision"),
            accepted: std::json::find_bool_field(row, "accepted"), name: std::json::find_string_field(row, "name"),
            supersedes: std::json::find_string_field(row, "supersedes") }, ratified_seq: std::json::find_int_field(row, "ratified_seq") };
    }
    fn key(row: String, kind: String) -> GraphKey {
        if kind == "nodes" { return GraphKey { first: std::json::find_string_field(row, "id") }; }
        if kind == "edges" { return GraphKey { first: std::json::find_string_field(row, "src"), second: std::json::find_string_field(row, "dst"), third: std::json::find_string_field(row, "rel") }; }
        return GraphKey { first: std::json::find_string_field(row, "idea"), second: std::json::find_string_field(row, "target"), third: std::json::find_string_field(row, "author") };
    }
    fn emit(row: String, kind: String, sink: GraphSink) -> Bool {
        if kind == "nodes" { return sink.node(self.stored(row)); }
        if kind == "edges" { return sink.edge(KnowledgeEdge { from: std::json::find_string_field(row, "src"), to: std::json::find_string_field(row, "dst"), rel: std::json::find_string_field(row, "rel") }); }
        return sink.binding(KnowledgeBinding { idea: std::json::find_string_field(row, "idea"), target: std::json::find_string_field(row, "target"), author: std::json::find_string_field(row, "author"), class: std::json::find_string_field(row, "class") });
    }
    // One ordered candidate per round trip avoids the driver's unbounded
    // row concatenation. Values, cursors and the remaining byte budget are
    // parameters. Both raw and JSON-escaped bytes are guarded on the server,
    // before the row can cross the wire; an empty payload means read_limit.
    fn sql(kind: String) -> String {
        let prefix = "WITH candidate AS MATERIALIZED (";
        let mut select = "";
        let mut bytes = "";
        if kind == "nodes" {
            select = "SELECT id, kind, text, author, provenance, revision, accepted, ratified_seq, name, supersedes FROM knowledge_ideas i WHERE ($1 = '' OR i.id = $1) AND ($2 = '' OR (i.accepted AND EXISTS (SELECT 1 FROM knowledge_bindings b WHERE b.idea = i.id AND ($2 = b.target OR left($2, length(b.target) + 1) = b.target || '/')))) AND ($3 = '' OR i.id COLLATE \"C\" > $3 COLLATE \"C\") ORDER BY i.id COLLATE \"C\" LIMIT 1";
            bytes = "octet_length(id) + octet_length(kind) + octet_length(text) + octet_length(author) + octet_length(provenance) + octet_length(name) + octet_length(supersedes) + 32";
        } else if kind == "edges" {
            select = "SELECT src, dst, rel FROM knowledge_edges WHERE (src = $1 OR dst = $1) AND ($2 = '') AND ($3 = '' OR (src COLLATE \"C\", dst COLLATE \"C\", rel COLLATE \"C\") > ($3 COLLATE \"C\", $4 COLLATE \"C\", $5 COLLATE \"C\")) ORDER BY src COLLATE \"C\", dst COLLATE \"C\", rel COLLATE \"C\" LIMIT 1";
            bytes = "octet_length(src) + octet_length(dst) + octet_length(rel)";
        } else {
            select = "SELECT idea, target, author, class FROM knowledge_bindings WHERE ($1 = '' OR idea = $1) AND ($2 = '' OR $2 = target OR left($2, length(target) + 1) = target || '/') AND ($3 = '' OR (idea COLLATE \"C\", target COLLATE \"C\", author COLLATE \"C\") > ($3 COLLATE \"C\", $4 COLLATE \"C\", $5 COLLATE \"C\")) ORDER BY idea COLLATE \"C\", target COLLATE \"C\", author COLLATE \"C\" LIMIT 1";
            bytes = "octet_length(idea) + octet_length(target) + octet_length(author) + octet_length(class)";
        }
        // Keep $4/$5 typed even in the node statement.
        return prefix + select + "), encoded AS MATERIALIZED (SELECT CASE WHEN (" + bytes + ") <= $6::bigint THEN row_to_json(candidate)::text ELSE '' END AS payload FROM candidate WHERE $4::text IS NOT NULL AND $5::text IS NOT NULL) SELECT CASE WHEN octet_length(payload) <= $6::bigint THEN payload ELSE '' END FROM encoded";
    }
}

// A request-scoped bounded selection for the unordered memory projection.
// Only keys and source indices are retained; idea bodies are emitted once.
locus GraphSelection {
    params { keys: GraphKeys = GraphKeys { }; scanned: Int = 0; bytes: Int = 0; }
    fn account(size: Int) -> Bool {
        self.scanned = self.scanned + 1;
        if self.scanned > 10000 || size > 8388608 - self.bytes { return false; }
        self.bytes = self.bytes + size;
        return true;
    }
    fn offer(key: GraphKey, limit: Int) {
        let rules = GraphRules { };
        let mut at = 0;
        while at < self.keys.len() {
            if rules.compare_key(key, self.keys.get(at) or GraphKey { }) < 0 { break; }
            at = at + 1;
        }
        if at > limit { return; }
        if self.keys.len() < limit + 1 { self.keys.push(GraphKey { }); }
        let mut end = self.keys.len() - 1;
        while end > at {
            self.keys.set(end, self.keys.get(end - 1) or GraphKey { }) or discard;
            end = end - 1;
        }
        self.keys.set(at, key) or discard;
    }
}

// ---- in memory ----------------------------------------------------------

// ---- Postgres -----------------------------------------------------------
//
// One connection, the schema migrated at open. Idea writes are keyed by
// digest and relationship effects by exact tuple. Ordered Record replay
// converges, including later unlink effects that supersede earlier links.

fn tab_field(line: String, n: Int) -> String {
    let mut rest = line;
    let mut k = 0;
    while true {
        let t = std::str::index_of(rest, "\t");
        let f = if t < 0 { rest } else { rest[0..t] };
        if k == n { return f; }
        if t < 0 { return ""; }
        rest = rest[(t + 1)..len(rest)];
        k = k + 1;
    }
    return "";
}

// The first column of every row, space-separated.
@unbounded
fn ids_of(csv: String) -> String {
    let mut out = "";
    let mut rest = csv;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        if nl < 0 { rest = ""; } else { rest = rest[(nl + 1)..len(rest)]; }
        let id = tab_field(line, 0);
        if len(id) > 0 { out = out + id + " "; }
    }
    return trim_nl(out);
}

fn line_one(s: String) -> String {
    let nl = std::str::index_of(s, "\n");
    return if nl < 0 { s } else { s[0..nl] };
}

locus Pq {
    params {
        conn: pq::PgConn = pq::PgConn { sslmode: "prefer" };
        // GH #985: the environment variable naming this store's DSN, read
        // at open; "" when the connection was built from a DSN in hand
        dsn_env: String = "";
        opened: Bool = false;
        error: String = "";
        record_id: String = "";
        projection_claim: Bool = false;
        projection_claim_key: String = "";
    }
    // a store holds one connection, and gives it back when it goes (GH #985)
    dissolve() { self.conn.close(); }
    fn kind() -> String { return "postgres"; }
    fn scope(record: String) {
        if record == self.record_id { return; }
        self.close();
        self.record_id = record;
        // a different record is a different schema: the connection
        // must be opened again to select it
        self.opened = false;
    }
    fn record() -> String { return self.record_id; }
    // The schema this record's graph lives in: `dna_<identity>`, the
    // identity lowercased with anything but a letter or digit folded to
    // `_`, so a git sha names it as is. A record with no rows yet has
    // no identity and opens under `dna_unscoped`, where nothing is ever
    // applied (there is nothing to apply); its first row moves it to
    // its own schema.
    fn schema() -> String { return schema_for(self.record_id); }
    @unbounded
    fn fail(what: String, e: db::DbError) -> Bool {
        self.error = what + ": " + e.kind + " " + e.detail;
        return false;
    }
    // A read that failed is recorded too. These returned an empty
    // answer and said nothing, so a connected database that could not
    // run the query — a schema gone, a permission withdrawn, a
    // statement timeout — reached a caller as "there is no knowledge
    // here" (the third-round review's finding 3). The caller compares
    // `last_error` around a read and refuses rather than answering.
    @unbounded
    fn note(what: String, e: db::DbError) {
        self.error = what + ": " + e.kind + " " + e.detail;
    }
    @unbounded
    fn open() -> Bool {
        if self.opened { return true; }
        // A failed migration or scope change may have left a live session.
        // Never replace its socket while retaining a session advisory claim.
        self.close();
        let dialled = dial_from_env(self.conn, self.dsn_env);
        if len(dialled) > 0 { self.error = dialled; return false; }
        let st = self.conn.open();
        if !st.ok { return self.fail("open", st.err); }
        // one schema per record, selected for this session; `public`
        // stays on the path for the vector type. The schema is the
        // owner's to create (GH #985): here it is only checked.
        let sch = self.schema();
        let ns = self.conn.exec("SET search_path TO " + sch + ", public");
        if !ns.ok { return self.fail("scope (schema " + sch + ")", ns.err); }
        let fence = memory_fence(self.conn, sch);
        if len(fence) > 0 { self.error = fence; self.close(); return false; }
        // the schema names its record, and the record it names must be
        // this one: a schema renamed or copied under another record's
        // name is refused, not read
        if len(self.record_id) > 0 {
            let owner = self.conn.query_one("SELECT value FROM knowledge_meta WHERE key = 'record'");
            if !owner.ok && owner.err.kind != "no_row" { return self.fail("scope", owner.err); }
            if !owner.ok || trim_nl(owner.data) != self.record_id {
                self.error = "scope: schema " + sch + " belongs to " + (if owner.ok { "record " + trim_nl(owner.data) } else { "no record" }) + ", not " + self.record_id + "; it is not read";
                self.close();
                return false;
            }
        }
        self.opened = true;
        return true;
    }
    @unbounded
    fn healthy() -> Bool {
        if !self.opened { return false; }
        let r = self.conn.query_one("SELECT 1");
        if !r.ok { self.error = "connection: " + r.err.kind + " " + r.err.detail; return false; }
        return true;
    }
    fn reopen() -> Bool {
        self.close();
        return self.open();
    }
    fn close() {
        // PostgreSQL releases this session's advisory locks on disconnect,
        // including when an error made the unlock reply indeterminate.
        self.conn.close();
        self.opened = false;
        self.projection_claim = false;
        self.projection_claim_key = "";
    }
    fn last_error() -> String { return self.error; }
    fn forget_error() { self.error = ""; }
    fn graph_generation() -> Int {
        if !self.opened || self.conn.tx_status() != "idle" { self.error = "graph generation: store is not idle and open"; return -1; }
        let row = self.conn.query_one("SELECT value::bigint FROM knowledge_meta WHERE key = 'graph_generation'");
        if !row.ok { self.note("graph generation", row.err); return -1; }
        let generation = std::str::parse_int(row.data) or - 1;
        if generation < 0 { self.error = "graph generation: invalid generation"; }
        return generation;
    }
    fn projection_basis() -> GraphProjection {
        if !self.opened || self.conn.tx_status() != "idle" { self.error = "projection basis: store is not idle and open"; return GraphProjection { }; }
        let row = self.conn.query_one("SELECT row_to_json(t) FROM (SELECT (SELECT value::bigint FROM knowledge_meta WHERE key = 'graph_projection_watermark') AS watermark, (SELECT CASE WHEN octet_length(value) <= 4096 THEN value ELSE NULL END FROM knowledge_meta WHERE key = 'graph_projection_head') AS head, (SELECT value::bigint FROM knowledge_meta WHERE key = 'watermark') AS live_watermark, (SELECT value::bigint FROM knowledge_meta WHERE key = 'graph_projection_pending_watermark') AS pending_watermark, (SELECT CASE WHEN octet_length(value) <= 4096 THEN value ELSE NULL END FROM knowledge_meta WHERE key = 'graph_projection_pending_head') AS pending_head, (SELECT value FROM knowledge_meta WHERE key = 'graph_projection_protocol') AS protocol) t");
        if !row.ok { self.note("projection basis", row.err); return GraphProjection { }; }
        let basis = GraphProjection { ok: std::json::find_string_field(row.data, "protocol") == "1" && std::str::starts_with(std::json::find_field_raw(row.data, "head"), "\"") && std::str::starts_with(std::json::find_field_raw(row.data, "pending_head"), "\""), watermark: std::str::parse_int(std::json::find_field_raw(row.data, "watermark")) or - 1, head: std::json::find_string_field(row.data, "head"), live_watermark: std::str::parse_int(std::json::find_field_raw(row.data, "live_watermark")) or - 1, pending_watermark: std::str::parse_int(std::json::find_field_raw(row.data, "pending_watermark")) or - 1, pending_head: std::json::find_string_field(row.data, "pending_head") };
        let rules = GraphRules { };
        if !rules.projection_valid(basis) { self.error = "projection basis: missing or invalid stamp"; return GraphProjection { }; }
        return basis;
    }
    fn begin_projection(previous: GraphProjection, watermark: Int, head: String) -> Bool {
        let rules = GraphRules { };
        if !rules.projection_begin_valid(previous, watermark, head) { return false; }
        let held = self.projection_claim;
        if !self.claim_projection() { return false; }
        if self.projection_change(previous, watermark, head, true) { return true; }
        // No effect ran after this failed begin. Keep an earlier successful
        // claim for retry, but do not strand a newly acquired session claim.
        if !held { let released = self.release_projection(); }
        return false;
    }
    fn checkpoint_projection(previous: GraphProjection, watermark: Int, head: String) -> Bool {
        let rules = GraphRules { };
        if !rules.projection_valid(previous) || watermark < 1 || len(head) == 0 || len(head) > 4096 { return false; }
        if previous.pending_watermark == 0 {
            if previous.watermark != watermark || previous.head != head { return false; }
        } else if previous.pending_watermark != watermark || previous.pending_head != head { return false; }
        let held = self.projection_claim;
        if !self.claim_projection() { return false; }
        if self.projection_change(previous, watermark, head, false) { return self.release_projection(); }
        if !held { let released = self.release_projection(); }
        return false;
    }
    fn claim_projection() -> Bool {
        if !self.opened || !self.conn.connected || self.conn.tx_status() != "idle" { self.error = "projection claim: store is not idle and open"; return false; }
        let key = "hale.knowledge.projection:" + self.schema();
        // Supported service projectors cooperate here; this does not fence
        // legacy binaries or arbitrary direct SQL writers. Reentry after an
        // interrupted effect must not increment PostgreSQL's
        // advisory-lock reference count; one checkpoint releases one claim.
        if self.projection_claim { return self.projection_claim_key == key; }
        let args = db::Args { }; args.add(key);
        let result = self.conn.query_params("SELECT pg_try_advisory_lock(hashtextextended($1, 0))::text", args);
        if !result.ok {
            self.note("projection claim", result.err);
            self.close();
            return false;
        }
        if result.n == 1 && result.csv == "false" { self.error = "projection claim: another Knowledge projector owns this Record"; return false; }
        if result.n != 1 || result.csv != "true" {
            self.error = "projection claim: invalid lock response";
            self.close();
            return false;
        }
        self.projection_claim = true; self.projection_claim_key = key;
        return true;
    }
    fn release_projection() -> Bool {
        if !self.projection_claim { return true; }
        let args = db::Args { }; args.add(self.projection_claim_key);
        let result = self.conn.query_params("SELECT pg_advisory_unlock(hashtextextended($1, 0))::text", args);
        if !result.ok {
            self.note("projection release", result.err);
            self.close();
            return false;
        }
        if result.n != 1 || result.csv != "true" {
            self.error = "projection release: session claim was lost";
            self.close();
            return false;
        }
        self.projection_claim = false; self.projection_claim_key = "";
        return true;
    }
    fn projection_change(previous: GraphProjection, watermark: Int, head: String, begin: Bool) -> Bool {
        if !self.opened || self.conn.tx_status() != "idle" { self.error = "projection transition: store is not idle and open"; return false; }
        let args = db::Args { };
        args.add(to_string(previous.watermark)); args.add(previous.head);
        args.add(to_string(previous.pending_watermark)); args.add(previous.pending_head);
        args.add(to_string(previous.live_watermark)); args.add(to_string(watermark)); args.add(head);
        args.add(if begin { "true" } else { "false" });
        // Both transitions lock the same metadata in the same order. Begin
        // compares the observed live mark; checkpoint expects the target live
        // mark after application. SQL errors roll back every metadata write.
        let sql = "WITH locked AS MATERIALIZED (SELECT key, value FROM knowledge_meta WHERE key IN ('watermark', 'graph_projection_watermark', 'graph_projection_head', 'graph_projection_pending_watermark', 'graph_projection_pending_head', 'graph_generation', 'graph_projection_protocol') ORDER BY key FOR UPDATE), checked AS MATERIALIZED (SELECT ((SELECT value::bigint FROM locked WHERE key = 'watermark') = CASE WHEN $8::boolean THEN $5::bigint ELSE $6::bigint END AND (SELECT value::bigint FROM locked WHERE key = 'graph_projection_watermark') = $1::bigint AND (SELECT value FROM locked WHERE key = 'graph_projection_head') = $2 AND (SELECT value::bigint FROM locked WHERE key = 'graph_projection_pending_watermark') = $3::bigint AND (SELECT value FROM locked WHERE key = 'graph_projection_pending_head') = $4 AND (SELECT value::bigint FROM locked WHERE key = 'graph_generation') >= 0 AND (SELECT value FROM locked WHERE key = 'graph_projection_protocol') = '1') AS valid, CASE WHEN $8::boolean THEN ($3::bigint = $6::bigint AND $4 = $7) ELSE ($3::bigint = 0 AND $1::bigint = $6::bigint AND $2 = $7) END AS unchanged), changed AS (UPDATE knowledge_meta SET value = CASE key WHEN 'graph_projection_watermark' THEN CASE WHEN $8::boolean THEN $1::text ELSE $6::text END WHEN 'graph_projection_head' THEN CASE WHEN $8::boolean THEN $2 ELSE $7 END WHEN 'graph_projection_pending_watermark' THEN CASE WHEN $8::boolean THEN $6::text ELSE '0' END WHEN 'graph_projection_pending_head' THEN CASE WHEN $8::boolean THEN $7 ELSE '' END ELSE ((value::bigint) + 1)::text END WHERE key IN ('graph_projection_watermark', 'graph_projection_head', 'graph_projection_pending_watermark', 'graph_projection_pending_head', 'graph_generation') AND (SELECT valid AND NOT unchanged FROM checked) RETURNING key) SELECT (valid AND (unchanged OR (SELECT count(*) FROM changed) = 5))::text FROM checked";
        let result = self.conn.query_params(sql, args);
        if !result.ok { self.note("projection transition", result.err); return false; }
        return result.n == 1 && result.csv == "true";
    }
    fn graph_abort(code: String) -> GraphPage {
        let rolled = self.conn.rollback();
        if !rolled.ok { self.note("graph rollback", rolled.err); }
        return GraphPage { error: code };
    }
    fn graph_next(query: GraphQuery, after: GraphKey, remaining: Int) -> db::Rows {
        let rules = GraphRules { };
        let args = db::Args { };
        args.add(query.id); args.add(query.target); args.add(after.first); args.add(after.second); args.add(after.third); args.add(to_string(remaining));
        return self.conn.query_params(rules.sql(query.kind), args);
    }
    // Every candidate and the metadata basis use one coherent snapshot.
    // This is not atomic application of an event: callers must also compare
    // the captured Record revision to watermark, then recheck generation.
    fn read_graph(query: GraphQuery, policy: KnowledgeReadPolicy, sink: GraphSink) -> GraphPage {
        let rules = GraphRules { };
        let invalid = rules.validate(query);
        if len(invalid) > 0 { return GraphPage { error: invalid }; }
        if !self.opened || self.conn.tx_status() != "idle" { self.error = "graph read: store is not idle and open"; return GraphPage { error: "read_failed" }; }
        self.forget_error();
        let begun = self.conn.exec("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY");
        if !begun.ok { self.note("graph begin", begun.err); return GraphPage { error: "read_failed" }; }
        let basis = self.conn.query_one("SELECT row_to_json(t) FROM (SELECT coalesce((SELECT CASE WHEN octet_length(value) <= 4096 THEN value ELSE NULL END FROM knowledge_meta WHERE key = 'record'), '') AS record, (SELECT value::bigint FROM knowledge_meta WHERE key = 'graph_generation') AS generation, (SELECT value::bigint FROM knowledge_meta WHERE key = 'watermark') AS watermark, (SELECT value::bigint FROM knowledge_meta WHERE key = 'graph_projection_watermark') AS projection_watermark, (SELECT CASE WHEN octet_length(value) <= 4096 THEN value ELSE NULL END FROM knowledge_meta WHERE key = 'graph_projection_head') AS projection_head, (SELECT value::bigint FROM knowledge_meta WHERE key = 'graph_projection_pending_watermark') AS projection_pending_watermark, (SELECT CASE WHEN octet_length(value) <= 4096 THEN value ELSE NULL END FROM knowledge_meta WHERE key = 'graph_projection_pending_head') AS projection_pending_head, (SELECT value FROM knowledge_meta WHERE key = 'graph_projection_protocol') AS protocol) t");
        if !basis.ok { self.note("graph basis", basis.err); return self.graph_abort("read_failed"); }
        let record = std::json::find_string_field(basis.data, "record");
        let generation = std::str::parse_int(std::json::find_field_raw(basis.data, "generation")) or - 1;
        let mark = std::str::parse_int(std::json::find_field_raw(basis.data, "watermark")) or - 1;
        if std::json::find_string_field(basis.data, "protocol") != "1" || record != self.record_id || generation < 0 || mark < 0 { self.error = "graph basis: invalid scope, generation or watermark"; return self.graph_abort("read_failed"); }
        let stamped = GraphProjection { ok: std::str::starts_with(std::json::find_field_raw(basis.data, "projection_head"), "\"") && std::str::starts_with(std::json::find_field_raw(basis.data, "projection_pending_head"), "\""), watermark: std::str::parse_int(std::json::find_field_raw(basis.data, "projection_watermark")) or - 1, head: std::json::find_string_field(basis.data, "projection_head"), live_watermark: mark, pending_watermark: std::str::parse_int(std::json::find_field_raw(basis.data, "projection_pending_watermark")) or - 1, pending_head: std::json::find_string_field(basis.data, "projection_pending_head") };
        if !rules.projection_valid(stamped) { self.error = "graph basis: missing or invalid projection stamp"; return self.graph_abort("read_failed"); }
        let mut subject_present = false;
        if len(query.id) > 0 {
            let subject_args = db::Args { };
            subject_args.add(query.id);
            // Identity-only indexed probe: no Idea text or JSON crosses the
            // wire, including for nodes whose body exceeds the graph budget.
            // It shares the repeatable-read snapshot with the basis and rows.
            let subject = self.conn.query_params("SELECT 1 FROM knowledge_ideas WHERE id = $1 LIMIT 1", subject_args);
            if !subject.ok { self.note("graph subject", subject.err); return self.graph_abort("read_failed"); }
            subject_present = subject.n == 1 && policy.visible(query.id);
        }
        let mut page = GraphPage { ok: true, record: record, generation: generation, watermark: mark, projection_watermark: stamped.watermark, projection_head: stamped.head, projection_pending_watermark: stamped.pending_watermark, projection_pending_head: stamped.pending_head, subject_present: subject_present };
        let mut after = GraphKey { first: query.after_first, second: query.after_second, third: query.after_third };
        let mut scanned = 0;
        let mut bytes = 0;
        let mut visible = 0;
        while true {
            // At the row cap, probe only for existence: a nonempty next
            // candidate is represented by the zero-budget sentinel, never
            // transported as a 10,001st input row.
            let remaining = if scanned >= 10000 { 0 } else { 8388608 - bytes };
            let rows = self.graph_next(query, after, remaining);
            if !rows.ok { self.note("graph query", rows.err); return self.graph_abort("read_failed"); }
            if rows.n == 0 { break; }
            if scanned >= 10000 || len(rows.csv) == 0 { return self.graph_abort("read_limit"); }
            scanned = scanned + 1;
            bytes = bytes + len(rows.csv);
            let key = rules.key(rows.csv, query.kind);
            if !rules.key_ok(key) { return self.graph_abort("read_limit"); }
            // Receipt identities are nonempty. Refuse malformed stored keys
            // rather than letting an empty key reset a keyset scan forever.
            if len(key.first) == 0 || (len(after.first) > 0 && rules.compare_key(key, after) <= 0) { self.error = "graph query: invalid stored cursor"; return self.graph_abort("read_failed"); }
            after = key;
            if !policy.visible(key.first) { continue; }
            if query.kind == "edges" && !policy.visible(key.second) { continue; }
            if visible == query.limit { page.has_more = true; break; }
            if !rules.emit(rows.csv, query.kind, sink) { return self.graph_abort("read_limit"); }
            visible = visible + 1;
            page.last_first = key.first; page.last_second = key.second; page.last_third = key.third;
        }
        let committed = self.conn.commit();
        if !committed.ok { self.note("graph commit", committed.err); return self.graph_abort("read_failed"); }
        return page;
    }
    fn rebuild() -> Bool {
        if !self.opened { self.error = "rebuild: the store is not open"; return false; }
        let sql = "TRUNCATE knowledge_ideas, knowledge_bindings, knowledge_edges, knowledge_structure, knowledge_signals;"
            + " UPDATE knowledge_meta SET value = '0' WHERE key IN ('watermark', 'graph_projection_watermark', 'graph_projection_pending_watermark');"
            + " UPDATE knowledge_meta SET value = '' WHERE key IN ('graph_projection_head', 'graph_projection_pending_head');"
            + " UPDATE knowledge_meta SET value = (value::bigint + 1)::text WHERE key = 'graph_generation'";
        let r = self.conn.exec(sql);
        if !r.ok { self.note("rebuild", r.err); return false; }
        return true;
    }
    fn watermark() -> Int {
        let row = self.conn.query_one("SELECT value FROM knowledge_meta WHERE key = 'watermark'");
        // no row yet is the normal state of a store nothing has been
        // applied to: zero, not a failure (the fourth review round's
        // P3 — a fresh Postgres answered 503 over an empty record)
        if !row.ok && row.err.kind == "no_row" { return 0; }
        if !row.ok { self.note("watermark", row.err); return 0; }
        return std::str::parse_int(trim_nl(row.data)) or 0;
    }
    fn set_watermark(seq: Int) -> Bool {
        let a = db::Args { };
        a.add(to_string(seq));
        let r = self.conn.exec_params("INSERT INTO knowledge_meta (key, value) VALUES ('watermark', $1) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value WHERE EXCLUDED.value::bigint > knowledge_meta.value::bigint", a);
        if !r.ok { return self.fail("watermark", r.err); }
        return true;
    }
    fn upsert(i: Idea, ratified_seq: Int) -> Bool {
        let a = db::Args { };
        a.add(i.id);
        a.add(i.kind);
        a.add(i.text);
        a.add(i.author);
        a.add(i.provenance);
        a.add(to_string(i.revision));
        a.add(if i.accepted { "true" } else { "false" });
        a.add(to_string(ratified_seq));
        a.add(embed_text(i.text));
        a.add(i.name);
        a.add(i.supersedes);
        let r = self.conn.exec_params("INSERT INTO knowledge_ideas (id, kind, text, author, provenance, revision, accepted, ratified_seq, embedding, name, supersedes) VALUES ($1, $2, $3, $4, $5, $6::bigint, $7::boolean, $8::bigint, $9::vector, $10, $11) ON CONFLICT (id) DO UPDATE SET kind = EXCLUDED.kind, text = EXCLUDED.text, author = EXCLUDED.author, provenance = EXCLUDED.provenance, revision = EXCLUDED.revision, accepted = EXCLUDED.accepted, ratified_seq = EXCLUDED.ratified_seq, embedding = EXCLUDED.embedding, name = EXCLUDED.name, supersedes = EXCLUDED.supersedes", a);
        if !r.ok { return self.fail("upsert", r.err); }
        return true;
    }
    fn retire(id: String, seq: Int) -> Bool {
        let a = db::Args { };
        a.add(id);
        a.add(to_string(seq));
        let r = self.conn.exec_params("UPDATE knowledge_ideas SET accepted = false, provenance = 'retired', revision = $2::bigint WHERE id = $1", a);
        if !r.ok { return self.fail("retire", r.err); }
        return true;
    }
    fn bind(b: KnowledgeBinding) -> Bool {
        let a = db::Args { };
        a.add(b.idea);
        a.add(b.target);
        a.add(b.author);
        a.add(b.class);
        let r = self.conn.exec_params("INSERT INTO knowledge_bindings (idea, target, author, class) VALUES ($1, $2, $3, $4) ON CONFLICT (idea, target, author) DO UPDATE SET class = EXCLUDED.class WHERE knowledge_bindings.class IS DISTINCT FROM EXCLUDED.class", a);
        if !r.ok { return self.fail("bind", r.err); }
        return true;
    }
    fn unbind(b: KnowledgeBinding) -> Bool {
        let a = db::Args { }; a.add(b.idea); a.add(b.target); a.add(b.author);
        let r = self.conn.exec_params("DELETE FROM knowledge_bindings WHERE idea = $1 AND target = $2 AND author = $3", a);
        if !r.ok { return self.fail("unbind", r.err); }
        return true;
    }
    fn link(e: KnowledgeEdge) -> Bool {
        let a = db::Args { };
        a.add(e.from);
        a.add(e.to);
        a.add(e.rel);
        let r = self.conn.exec_params("INSERT INTO knowledge_edges (src, dst, rel) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", a);
        if !r.ok { return self.fail("link", r.err); }
        return true;
    }
    fn unlink(e: KnowledgeEdge) -> Bool {
        let a = db::Args { };
        a.add(e.from);
        a.add(e.to);
        a.add(e.rel);
        let r = self.conn.exec_params("DELETE FROM knowledge_edges WHERE src = $1 AND dst = $2 AND rel = $3", a);
        if !r.ok { return self.fail("unlink", r.err); }
        return true;
    }
    // Read the row as JSON, not as tab-separated text. The driver's
    // rows are newline- and tab-separated with no escaping, so an idea
    // whose text contains either — an ordinary paragraph — came back
    // truncated with its author, acceptance and sequence shifted into
    // nothing (the shakeout's finding 9). JSON from the server escapes
    // both, so the row survives the transport intact.
    fn idea(id: String) -> Stored {
        let a = db::Args { };
        a.add(id);
        let rows = self.conn.query_params("SELECT row_to_json(t) FROM (SELECT id, kind, text, author, provenance, revision, accepted, ratified_seq, name, supersedes FROM knowledge_ideas WHERE id = $1) t", a);
        if !rows.ok { self.note("idea", rows.err); return Stored { }; }
        if rows.n == 0 { return Stored { }; }
        let row = trim_nl(line_one(rows.csv));
        if len(row) == 0 { return Stored { }; }
        return Stored {
            present: true,
            idea: Idea {
                id: std::json::find_string_field(row, "id"),
                kind: std::json::find_string_field(row, "kind"),
                text: std::json::find_string_field(row, "text"),
                author: std::json::find_string_field(row, "author"),
                provenance: std::json::find_string_field(row, "provenance"),
                revision: std::json::find_int_field(row, "revision"),
                accepted: std::json::find_bool_field(row, "accepted"),
                name: std::json::find_string_field(row, "name"),
                supersedes: std::json::find_string_field(row, "supersedes")
            },
            ratified_seq: std::json::find_int_field(row, "ratified_seq")
        };
    }
    // The tower rule in one query: bound to the target, or to any prefix
    // of its path; goals flow down, initiatives stay local.
    @unbounded
    fn context_ids(target: String, budget: Int) -> String {
        let a = db::Args { };
        a.add(target);
        a.add(to_string(budget));
        let rows = self.conn.query_params("SELECT i.id FROM knowledge_ideas i WHERE i.accepted AND EXISTS (SELECT 1 FROM knowledge_bindings b WHERE b.idea = i.id AND ($1 = b.target OR left($1, length(b.target) + 1) = b.target || '/')) ORDER BY i.ratified_seq, i.id LIMIT $2::bigint", a);
        if !rows.ok { self.note("context", rows.err); return ""; }
        return ids_of(rows.csv);
    }
    // The same bound, ranked by pgvector's cosine distance to the query.
    fn ranked_ids(target: String, budget: Int, query_vec: String) -> String {
        if len(query_vec) == 0 { return self.context_ids(target, budget); }
        let a = db::Args { };
        a.add(target);
        a.add(query_vec);
        a.add(to_string(budget));
        let rows = self.conn.query_params("SELECT i.id FROM knowledge_ideas i WHERE i.accepted AND EXISTS (SELECT 1 FROM knowledge_bindings b WHERE b.idea = i.id AND ($1 = b.target OR left($1, length(b.target) + 1) = b.target || '/')) ORDER BY i.embedding <=> $2::vector, i.ratified_seq, i.id LIMIT $3::bigint", a);
        if !rows.ok { self.note("ranked", rows.err); return ""; }
        return ids_of(rows.csv);
    }
    fn put_structure(kind: String, name: String, seq: Int, body: String) -> Bool {
        let a = db::Args { };
        a.add(kind);
        a.add(name);
        a.add(to_string(seq));
        a.add(body);
        let r = self.conn.exec_params("INSERT INTO knowledge_structure (kind, name, seq, body) VALUES ($1, $2, $3::bigint, $4) ON CONFLICT (kind, name) DO UPDATE SET seq = EXCLUDED.seq, body = EXCLUDED.body WHERE knowledge_structure.seq <= EXCLUDED.seq", a);
        if !r.ok { return self.fail("structure", r.err); }
        return true;
    }
    fn structure_count(kind: String) -> Int {
        let a = db::Args { };
        a.add(kind);
        let rows = self.conn.query_params("SELECT count(*) FROM knowledge_structure WHERE $1 = '' OR kind = $1", a);
        if !rows.ok { self.note("structure_count", rows.err); return 0; }
        return std::str::parse_int(trim_nl(line_one(rows.csv))) or 0;
    }
    fn structure_names(kind: String) -> String {
        let a = db::Args { };
        a.add(kind);
        let rows = self.conn.query_params("SELECT name FROM knowledge_structure WHERE $1 = '' OR kind = $1 ORDER BY seq, name", a);
        if !rows.ok { self.note("structure_names", rows.err); return ""; }
        return ids_of(rows.csv);
    }
    fn put_signal(kind: String, source: String, what: String, seq: Int) -> Bool {
        let a = db::Args { };
        a.add(kind);
        a.add(source);
        a.add(what);
        a.add(to_string(seq));
        // Counted once per record row: the projection write and the
        // watermark advance are separate, so a crash between them
        // replays the row, and an unconditional increment counted the
        // same event twice (the shakeout's finding 12). `last_seq` is
        // the dedupe key: a row at or before it changes nothing.
        let r = self.conn.exec_params("INSERT INTO knowledge_signals (kind, source, what, count, last_seq) VALUES ($1, $2, $3, 1, $4::bigint) ON CONFLICT (kind, source, what) DO UPDATE SET count = knowledge_signals.count + 1, last_seq = EXCLUDED.last_seq WHERE knowledge_signals.last_seq < EXCLUDED.last_seq", a);
        if !r.ok { return self.fail("signal", r.err); }
        return true;
    }
    // One JSON array, built by the server: a concern's text is free
    // prose and carries tabs and newlines (finding 9).
    fn signals() -> String {
        let rows = self.conn.query_all("SELECT coalesce(json_agg(row_to_json(t) ORDER BY t.last_seq DESC, t.source), '[]') FROM (SELECT kind, source, what, count, last_seq FROM knowledge_signals) t");
        if !rows.ok { self.note("signals", rows.err); return "[]"; }
        let row = trim_nl(line_one(rows.csv));
        if len(row) == 0 { return "[]"; }
        return row;
    }
    fn count(what: String) -> Int {
        let sql = if what == "bindings" { "SELECT count(*) FROM knowledge_bindings" }
        else if what == "edges" { "SELECT count(*) FROM knowledge_edges" }
        else if what == "ratified" { "SELECT count(*) FROM knowledge_ideas WHERE accepted" }
        else if what == "proposed" { "SELECT count(*) FROM knowledge_ideas WHERE provenance = 'proposed'" }
        else { "SELECT count(*) FROM knowledge_ideas" };
        let row = self.conn.query_one(sql);
        if !row.ok { self.note("count " + what, row.err); return 0; }
        return std::str::parse_int(trim_nl(row.data)) or 0;
    }
}

// ---- the DSN ------------------------------------------------------------
//
// `postgres://user:password@host:port/database?sslmode=…`, the shape
// every tool prints. The password never leaves the connection's params.

type Dsn {
    ok: Bool = false;
    user: String = "postgres";
    password: String = "";
    host: String = "127.0.0.1";
    port: Int = 5432;
    database: String = "postgres";
    sslmode: String = "prefer";
    why: String = "";
}

fn parse_dsn(s: String) -> Dsn {
    let mut rest = s;
    if std::str::starts_with(rest, "postgresql://") { rest = rest[13..len(rest)]; }
    else if std::str::starts_with(rest, "postgres://") { rest = rest[11..len(rest)]; }
    else { return Dsn { why: "not a postgres:// URL" }; }
    let mut d = Dsn { ok: true };
    let q = std::str::index_of(rest, "?");
    if q >= 0 {
        let query = rest[(q + 1)..len(rest)];
        rest = rest[0..q];
        let m = std::str::index_of(query, "sslmode=");
        if m >= 0 {
            let v = query[(m + 8)..len(query)];
            let amp = std::str::index_of(v, "&");
            d.sslmode = if amp < 0 { v } else { v[0..amp] };
        }
    }
    let at = std::str::index_of(rest, "@");
    if at >= 0 {
        let cred = rest[0..at];
        rest = rest[(at + 1)..len(rest)];
        let colon = std::str::index_of(cred, ":");
        if colon < 0 { d.user = cred; } else { d.user = cred[0..colon]; d.password = cred[(colon + 1)..len(cred)]; }
    }
    let slash = std::str::index_of(rest, "/");
    let hostport = if slash < 0 { rest } else { rest[0..slash] };
    if slash >= 0 && slash + 1 < len(rest) { d.database = rest[(slash + 1)..len(rest)]; }
    let pc = std::str::index_of(hostport, ":");
    if pc < 0 { d.host = hostport; } else { d.host = hostport[0..pc]; d.port = std::str::parse_int(hostport[(pc + 1)..len(hostport)]) or 5432; }
    if len(d.host) == 0 { d.host = "127.0.0.1"; }
    return d;
}

// The connection a DSN names; a `Pq` is built around it in place
// (`Pq { conn: pq_conn(d) }`), since a locus is structure, not a
// value a factory hands back into a field.
fn pq_conn(d: Dsn) -> pq::PgConn {
    return pq::PgConn { host: d.host, port: d.port, user: d.user, password: d.password, database: d.database, sslmode: d.sslmode };
}

// The schema a record's projections live in (GH #613): `dna_<identity>`,
// the identity lowercased with anything but a letter or digit folded to
// `_`; `dna_unscoped` while the record has no rows. The protected store
// (GH #606) keeps its table in the same schema.
fn schema_for(record_id: String) -> String {
    if len(record_id) == 0 { return "dna_unscoped"; }
    let mut out = "dna_";
    let mut i = 0;
    while i < len(record_id) && i < 56 {
        let c = record_id[i..(i + 1)];
        let lower = std::str::lower(c);
        let ok = (lower >= "a" && lower <= "z") || (lower >= "0" && lower <= "9");
        out = out + (if ok { lower } else { "_" });
        i = i + 1;
    }
    return out;
}
