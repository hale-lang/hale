{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hale:api-description:1",
  "title": "The API description and the program-wide inventory (spec/api.md, GH #1417)",
  "$comment": "A description is one exposure's document, filtered for one caller (\"description\": 1): a serve site's, or a hub's that serves no surface; the inventory is the program-wide document hale check --api prints (\"inventory\": 1). The v1 outcome mappings and the ws frame envelope are consts: a transport may not choose others.",
  "oneOf": [
    { "$ref": "#/$defs/description" },
    { "$ref": "#/$defs/inventory" }
  ],
  "$defs": {
    "description": {
      "$comment": "One document type for both kinds of exposure: a serve site's (a surface over a transport) and a hub's that serves no surface (its stream rows alone, surface null, no members, the ws outcome form).",
      "oneOf": [
        { "$ref": "#/$defs/surface_description" },
        { "$ref": "#/$defs/hub_description" }
      ]
    },
    "surface_description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "exposure", "name", "surface", "digest", "listener", "codec", "caller", "members", "streams", "outcomes", "schemas", "notes"],
      "properties": {
        "description": { "const": 1 },
        "exposure": { "$ref": "#/$defs/exposure_id" },
        "name": { "$ref": "#/$defs/exposure_name" },
        "surface": { "$ref": "#/$defs/surface_name" },
        "digest": { "$ref": "#/$defs/digest" },
        "listener": { "$ref": "#/$defs/listener" },
        "codec": { "$ref": "#/$defs/codec" },
        "caller": { "$ref": "#/$defs/caller" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "streams": { "type": "array", "items": { "$ref": "#/$defs/stream" } },
        "outcomes": { "$ref": "#/$defs/outcomes" },
        "schemas": { "$ref": "#/$defs/schemas" },
        "notes": { "$ref": "#/$defs/description_notes" }
      }
    },
    "hub_description": {
      "$comment": "A hub exposure's document (spec/api.md, Streams): identified hub@<stream digest>/<name>, the digest the stream digest, surface null and members empty, streams the rows this caller may subscribe to, outcomes the ws frame envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "exposure", "name", "surface", "digest", "listener", "codec", "caller", "members", "streams", "outcomes", "schemas", "notes"],
      "properties": {
        "description": { "const": 1 },
        "exposure": { "$ref": "#/$defs/hub_exposure_id" },
        "name": { "$ref": "#/$defs/exposure_name" },
        "surface": { "type": "null" },
        "digest": { "$ref": "#/$defs/digest" },
        "listener": { "$ref": "#/$defs/listener" },
        "codec": { "$ref": "#/$defs/codec" },
        "caller": { "$ref": "#/$defs/caller" },
        "members": { "const": [] },
        "streams": { "type": "array", "items": { "$ref": "#/$defs/stream" } },
        "outcomes": { "$ref": "#/$defs/outcomes_ws" },
        "schemas": { "$ref": "#/$defs/schemas" },
        "notes": { "$ref": "#/$defs/description_notes" }
      }
    },
    "description_notes": {
      "type": "object",
      "required": ["authorization", "lifecycle", "discovery"],
      "additionalProperties": { "type": "string" }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "app", "surfaces", "exposures", "hubs", "schemas", "notes"],
      "properties": {
        "inventory": { "const": 1 },
        "app": { "$ref": "#/$defs/identifier" },
        "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
        "exposures": { "type": "array", "items": { "$ref": "#/$defs/exposure" } },
        "hubs": { "type": "array", "items": { "$ref": "#/$defs/hub" } },
        "schemas": { "$ref": "#/$defs/schemas" },
        "notes": {
          "type": "object",
          "required": ["inventory"],
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "members"],
      "properties": {
        "name": { "$ref": "#/$defs/surface_name" },
        "digest": { "$ref": "#/$defs/digest" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposure", "name", "surface", "digest", "listener", "codec", "principals", "roles", "receivers"],
      "properties": {
        "exposure": { "$ref": "#/$defs/exposure_id" },
        "name": { "$ref": "#/$defs/exposure_name" },
        "surface": { "$ref": "#/$defs/surface_name" },
        "digest": { "$ref": "#/$defs/digest" },
        "listener": { "$ref": "#/$defs/listener" },
        "codec": { "$ref": "#/$defs/codec" },
        "principals": { "$ref": "#/$defs/source" },
        "roles": { "$ref": "#/$defs/source" },
        "receivers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receiver" } }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instance", "binding", "pool"],
      "properties": {
        "type": { "$ref": "#/$defs/surface_name" },
        "instance": { "type": "string" },
        "binding": { "enum": ["explicit", "inferred"] },
        "pool": { "type": "string" }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposure", "name", "digest", "instance", "listener", "codec", "principals", "roles", "streams"],
      "properties": {
        "exposure": { "$ref": "#/$defs/hub_exposure_id" },
        "name": { "$ref": "#/$defs/exposure_name" },
        "digest": { "$ref": "#/$defs/digest" },
        "instance": { "type": "string" },
        "listener": { "$ref": "#/$defs/listener" },
        "codec": { "$ref": "#/$defs/codec" },
        "principals": { "$ref": "#/$defs/source" },
        "roles": { "$ref": "#/$defs/source" },
        "streams": { "type": "array", "items": { "$ref": "#/$defs/stream" } }
      }
    },
    "source": {
      "$comment": "A bearer or role source as the program names it: the param it is (self.bearer) and its locus type; \"kernel\" for the Unix transport's peer credentials, which has no type.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "request", "response", "error", "requires"],
      "properties": {
        "name": { "$ref": "#/$defs/member_name" },
        "request": { "$ref": "#/$defs/type_ref" },
        "response": { "$ref": "#/$defs/type_ref" },
        "error": { "$ref": "#/$defs/error" },
        "requires": { "$ref": "#/$defs/requires" }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "subject", "direction", "payload", "codec", "bound", "on_full", "loss", "replay", "requires"],
      "properties": {
        "topic": { "$ref": "#/$defs/surface_name" },
        "subject": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["out", "in"] },
        "payload": { "$ref": "#/$defs/type_ref" },
        "codec": { "$ref": "#/$defs/codec" },
        "bound": { "type": "integer", "minimum": 1 },
        "on_full": { "enum": ["drop_old", "drop_new"] },
        "loss": { "type": "string", "minLength": 1 },
        "replay": { "type": "boolean" },
        "requires": { "$ref": "#/$defs/requires" }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "roles"],
      "properties": {
        "principal": { "$ref": "#/$defs/principal" },
        "roles": { "$ref": "#/$defs/requires" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "name"],
      "properties": {
        "mode": { "enum": ["unix", "bearer", "local"] },
        "name": { "type": "string" },
        "uid": { "type": "integer" },
        "gid": { "type": "integer" },
        "pid": { "type": "integer" }
      }
    },
    "outcomes": {
      "oneOf": [
        { "$ref": "#/$defs/outcomes_http" },
        { "$ref": "#/$defs/outcomes_mcp" },
        { "$ref": "#/$defs/outcomes_unix" }
      ]
    },
    "outcomes_http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "result", "handler_error", "refusal", "server_error", "transport_failure"],
      "properties": {
        "transport": { "const": "http" },
        "result": { "const": { "status": 200, "body": "response" } },
        "handler_error": { "const": { "status": 422, "body": "error" } },
        "refusal": {
          "const": {
            "body": "refusal",
            "status": { "malformed": 400, "digest_mismatch": 409, "unauthenticated": 401, "unauthorized": 403, "full": 429, "shutting_down": 503, "unavailable": 503 }
          }
        },
        "server_error": { "const": { "status": 500, "body": "refusal" } },
        "transport_failure": { "const": "the transport's own: the connection ends without a response" }
      }
    },
    "outcomes_mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "result", "handler_error", "refusal", "server_error", "transport_failure"],
      "properties": {
        "transport": { "const": "mcp" },
        "result": { "const": { "field": "result", "body": "response" } },
        "handler_error": { "const": { "field": "error", "code": -32001, "data": "error" } },
        "refusal": {
          "const": {
            "field": "error",
            "data": "refusal",
            "code": { "malformed": -32602, "digest_mismatch": -32003, "unauthenticated": -32004, "unauthorized": -32005, "full": -32006, "shutting_down": -32007, "unavailable": -32008 }
          }
        },
        "server_error": { "const": { "field": "error", "code": -32603, "data": "refusal" } },
        "transport_failure": { "const": "the transport's own: the connection ends without a response" }
      }
    },
    "outcomes_unix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "result", "handler_error", "refusal", "server_error", "transport_failure"],
      "properties": {
        "transport": { "const": "unix" },
        "result": { "const": { "ok": true, "field": "value" } },
        "handler_error": { "const": { "ok": false, "field": "error" } },
        "refusal": {
          "const": { "ok": false, "field": "refusal", "kinds": ["malformed", "digest_mismatch", "unauthenticated", "unauthorized", "full", "shutting_down", "unavailable"] }
        },
        "server_error": { "const": { "ok": false, "field": "refusal", "kind": "server" } },
        "transport_failure": { "const": "eof" }
      }
    },
    "outcomes_ws": {
      "$comment": "The ws form: the frames a hub exchanges, each a JSON object whose type names it. The client sends subscribe; the hub answers subscribed or refusal, then sends event frames whose seq increases by one per event offered to the subscription (a gap is the frames shed), unauthorized once when the subscription is invalidated, and closed at stop(). No member, no status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "subscribe", "subscribed", "refusal", "event", "unauthorized", "closed", "transport_failure"],
      "properties": {
        "transport": { "const": "ws" },
        "subscribe": { "const": { "type": "subscribe", "fields": ["topic"] } },
        "subscribed": { "const": { "type": "subscribed", "fields": ["topic"] } },
        "refusal": {
          "const": { "type": "refusal", "fields": ["topic", "refusal"], "kinds": ["malformed", "unauthenticated", "unauthorized", "shutting_down"] }
        },
        "event": { "const": { "type": "event", "fields": ["topic", "seq", "payload"] } },
        "unauthorized": { "const": { "type": "unauthorized", "fields": ["topic", "reason"], "reasons": ["expired", "revoked"] } },
        "closed": { "const": { "type": "closed", "fields": ["reason"], "reasons": ["shutting_down"] } },
        "transport_failure": { "const": "the connection closes without a closed frame" }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "address"],
      "properties": {
        "transport": { "enum": ["unix", "http", "ws", "udp", "grpc", "mcp"] },
        "address": { "type": "string", "minLength": 1 }
      }
    },
    "type_ref": {
      "$comment": "A JSON Schema for the type: a reference into the document's schemas (#/schemas/<Type>) or an inline schema for a scalar; null when the member has none (no request, a () response, not fallible). ClosureViolation is never a schema of the document.",
      "type": ["object", "null"],
      "properties": { "$ref": { "not": { "const": "#/schemas/ClosureViolation" } } }
    },
    "error": {
      "$comment": "A member's error: the schema of its handler's E, whose failure is the handler error; the string ClosureViolation for a fallible(ClosureViolation) handler, whose failure is the server error and which has no error schema; null when the handler is not fallible (spec/api.md, Surfaces and their rows).",
      "oneOf": [
        { "$ref": "#/$defs/type_ref" },
        { "const": "ClosureViolation" }
      ]
    },
    "schemas": {
      "$comment": "The JSON Schema of every type the document's members and streams name, by type name. A quantity's field carries x-hale-unit (its q(...) tag, spec/units.md); a named scalar's carries x-hale-type. ClosureViolation is no member's schema: a structural failure is the server error.",
      "type": "object",
      "properties": { "ClosureViolation": false },
      "additionalProperties": { "type": "object" }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "codec": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "surface_name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_:]*$" },
    "member_name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_:]*::[A-Za-z_][A-Za-z0-9_]*$" },
    "exposure_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "exposure_id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_:]*@fnv1a64:[0-9a-f]{16}/[A-Za-z0-9_.-]+$" },
    "hub_exposure_id": { "type": "string", "pattern": "^hub@fnv1a64:[0-9a-f]{16}/[A-Za-z0-9_.-]+$" }
  }
}
