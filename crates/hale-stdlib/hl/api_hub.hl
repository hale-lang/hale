// ---- the hub (spec/api.md § Streams; GH #1417, R5) ----
//
// A hub is a core and a listener. The core (`std::api::ws::Hub`) is the
// param the program writes: it holds the sources, admits subscriptions
// against the rows of the topics bound to it, and is the `Rpc` a surface
// is served over. The listener and a locus per connection run on an
// `async_io` pool of their own (as `unix::Rpc`'s do), and the two talk
// over the bus: peers publish what a connection says (`__ApiHubUpT`),
// the core answers (`__ApiHubOutT`), and each topic bound to the hub is an
// adapter binding (`__StdApiWsStream`) that publishes the encoded event
// (`__ApiHubEventT`) to the connections' queues.
//
// Who holds what. The core authenticates a connection once, when it
// connects (the bearer source and the credential's expiry), and admits a
// subscription against the stream row's `requires` (the role source).
// Each connection holds its subscriptions' queues, because only the
// connection knows when its socket takes a frame: at most `bound` frames
// per subscription, shed under the row's `on_full`, every event offered
// taking the next `seq` whether it is delivered or shed. A role source
// announces a revision on `__api.roles.revision`; the connection, which
// subscribes to it, delivers nothing to its subscriptions until the core
// has answered a recheck it asked for after the announcement, so no event
// is delivered under an authorization older than the revision. A
// credential's expiry is the connection's to enforce, at every delivery
// and at the instant itself.

/// The error of a stream codec the compiler generates.
type __StdApiHubCodecError {
    kind: String = "";
}

/// An event a bound topic offers, for the hub whose number is `key`.
type __StdApiHubEvent {
    key: Int;
    stream: Int;
    payload: String;
}

/// What a connection says to the core, for the hub `key`. kind: 1 connect
/// (`text` the credential), 2 subscribe (`text` the topic), 3 the
/// connection expired its subscriptions, 4 gone (`text` the correlations
/// of the rpcs it still had pending), 5 recheck (`a` the connection's
/// count), 6 describe (`text` the credential), 7 an rpc (`a` its sequence
/// number, `text` the frame).
type __StdApiHubUp {
    key: Int;
    conn: Int;
    kind: Int;
    a: Int;
    text: String;
    text2: String;
}

/// What the core says to a connection (`key` = hub * 2^32 + connection) or
/// to the listener and every connection (`key` = hub). To a connection,
/// kind: 1 authenticated (`a` the credential's expiry, 0 for none; `b` 1
/// when the sources named the caller), 2 admitted (`a` the stream, `b` its
/// bound, `text` the policy and the topic), 3 send this frame, 4 revoked
/// (`a` the stream), 5 the recheck numbered `a` is answered, 6 the
/// description (`a` the status, `text` the document), 9 an rpc's reply
/// (`text` the frame), 10 close. To all, kind: 1 stop, 7 the core is
/// there, 8 is the core there.
type __StdApiHubOut {
    key: Int;
    kind: Int;
    a: Int;
    b: Int;
    text: String;
}

/// The rows of a hub, generated per hub by the compiler: its streams in
/// binding order.
interface __StdApiHubRows {
    fn count() -> Int;
    fn topic(i: Int) -> String;
    fn requires(i: Int) -> String;
    fn bound(i: Int) -> Int;
    fn on_full(i: Int) -> String;
    fn find(topic: String) -> Int;
    fn grants(role: String) -> String;
    fn head() -> String;
    fn stream_doc(i: Int) -> String;
    fn types() -> Int;
    fn type_doc(j: Int) -> String;
    fn type_mask(j: Int) -> Int;
    fn outcomes() -> String;
    fn notes() -> String;
    fn required() -> String;
}

/// Rows with no stream: the default of a hub's.
locus __StdApiNoHubRows {
    fn count() -> Int { return 0; }
    fn topic(i: Int) -> String { return ""; }
    fn requires(i: Int) -> String { return ""; }
    fn bound(i: Int) -> Int { return 0; }
    fn on_full(i: Int) -> String { return ""; }
    fn find(topic: String) -> Int { return -1; }
    fn grants(role: String) -> String { return role; }
    fn head() -> String { return ""; }
    fn stream_doc(i: Int) -> String { return ""; }
    fn types() -> Int { return 0; }
    fn type_doc(j: Int) -> String { return ""; }
    fn type_mask(j: Int) -> Int { return 0; }
    fn outcomes() -> String { return ""; }
    fn notes() -> String { return ""; }
    fn required() -> String { return ""; }
}

/// `a,b` as the JSON array `["a","b"]`.
fn __api_hub_csv_json(csv: String) -> String {
    let mut out = "[";
    let mut rest = csv;
    let mut first = true;
    while len(rest) > 0 {
        let comma = std::str::index_of(rest, ",");
        let mut item = rest;
        if comma >= 0 {
            item = rest[0..comma];
            rest = rest[(comma + 1)..len(rest)];
        } else {
            rest = "";
        }
        if !first { out = out + ","; }
        out = out + "\"" + std::json::escape_string(item) + "\"";
        first = false;
    }
    return out + "]";
}

fn __api_hub_quote(s: String) -> String {
    return "\"" + std::json::escape_string(s) + "\"";
}

/// A refusal frame (spec/api.md § Streams, the `ws` frames).
fn __api_hub_refusal(topic: String, kind: String, reason: String, requires: String) -> String {
    let mut t = "null";
    if len(topic) > 0 { t = __api_hub_quote(topic); }
    let mut extra = "";
    if len(requires) > 0 { extra = ",\"requires\":" + __api_hub_csv_json(requires); }
    return "{\"type\":\"refusal\",\"topic\":" + t + ",\"refusal\":{\"kind\":" + __api_hub_quote(kind) + ",\"reason\":" + __api_hub_quote(reason) + extra + "}}";
}

/// A topic bound to a hub (`std::api::ws::Stream`): the adapter the compiler
/// binds the topic to. `send` is the publish contract's delivery: it hands
/// the event, encoded by the topic's codec, to every connection's queue.
locus __StdApiWsStream {
    params {
        hub: Int = 0;
        stream: Int = 0;
        offered: Int = 0;
    }
    bus { publish __ApiHubEventT; }
    fn send(subject: String, bytes: Bytes) {
        self.offered = self.offered + 1;
        __ApiHubEventT <- __StdApiHubEvent { key: self.hub, stream: self.stream, payload: std::str::from_bytes(bytes) };
    }
}

/// The hub's listening socket, on its own pool (`std::api::ws::Listener`;
/// the compiler adds one to the main locus per `ws::Hub`).
locus __StdApiWsListener {
    params {
        bind: String = "";
        tid: Int = 0;
        fd: Int = -1;
        started: Bool = false;
        stopped: Bool = false;
        next_conn: Int = 1;
    }
    bus {
        subscribe __ApiHubOutT as on_ctl where key == self.tid;
        publish __ApiHubOutT;
    }
    birth() {
        let colon = std::str::index_of(self.bind, ":");
        let mut host = "127.0.0.1";
        let mut port = 0;
        if colon >= 0 {
            host = self.bind[0..colon];
            port = std::str::parse_int(self.bind[(colon + 1)..len(self.bind)]) or 0;
        }
        self.fd = std::io::tcp::__listen_socket(host, port);
        if self.fd < 0 {
            // the structural failure of a binding that cannot be realized
            // (spec/semantics.md): the diagnostic and a non-zero exit
            eprintln("api: ws::Hub could not listen on " + self.bind);
            std::process::exit(2);
        }
    }
    @unbounded
    run() {
        // A connection accepted before the hub's core is subscribed would
        // publish to nobody: the core answers the listener's asking (kind 8)
        // with kind 7 from its pool, whose handlers run once the program
        // has finished booting.
        while !self.started && !self.stopped && !self.draining {
            __ApiHubOutT <- __StdApiHubOut { key: self.tid, kind: 8, a: 0, b: 0, text: "" };
            std::time::sleep(2ms);
        }
        while !self.stopped && !self.draining {
            let conn = std::io::tcp::__accept_one(self.fd);
            if conn < 0 {
                if self.stopped || self.draining { break; }
                // a failed accept ends one connection, never the listener
                std::time::sleep(20ms);
                continue;
            }
            // (a connection is spoken to from the next commit on)
            std::io::tcp::__close_fd(conn);
        }
    }
    fn on_ctl(o: __StdApiHubOut) {
        if o.kind == 7 { self.started = true; }
        if o.kind == 1 {
            self.stopped = true;
            self.release_socket();
        }
    }
    fn release_socket() {
        if self.fd < 0 { return; }
        std::io::tcp::__shutdown_listen_socket(self.fd);
        std::io::tcp::__close_fd(self.fd);
        self.fd = -1;
    }
    dissolve() {
        self.release_socket();
    }
}

/// The hub (`std::api::ws::Hub`). `tid` and `rows` are the compiler's,
/// written into the literal with the sources' optional extensions.
locus __StdApiWsHub {
    params {
        bind: String = "";
        principals: std::api::BearerSource = std::api::NoBearer { };
        roles: std::api::RoleSource = __StdApiNoRoles { };
        name: String = "";
        tid: Int = 0;
        rows: std::api::HubRows = __StdApiNoHubRows { };
        expiring: std::api::ExpiringBearerSource = __StdApiNoExpiry { };
        revised: std::api::RevisedRoleSource = __StdApiNoRevision { };
        has_expiry: Bool = false;
        has_revised: Bool = false;
        stopped: Bool = false;
        offered: Int = 0;
        said: Int = 0;
    }
    bus {
        subscribe __ApiHubOutT as on_ask where key == self.tid;
        subscribe __ApiHubUpT as on_up where key == self.tid;
        subscribe __ApiHubEventT as on_event where key == self.tid;
        publish __ApiHubOutT;
        publish __ApiHubUpT;
    }
    // The listener asks whether the core is there to be published to. A
    // handler of this pool runs only after the boot, which has subscribed
    // the core, so any answer is a true one.
    fn on_ask(o: __StdApiHubOut) {
        if o.kind == 8 {
            __ApiHubOutT <- __StdApiHubOut { key: self.tid, kind: 7, a: 0, b: 0, text: "" };
        }
    }
    fn on_up(u: __StdApiHubUp) {
        self.said = self.said + 1;
    }
    fn on_event(e: __StdApiHubEvent) {
        self.offered = self.offered + 1;
    }
    /// The events offered to this hub by the topics bound to it.
    fn events() -> Int {
        return self.offered;
    }
    /// Stop accepting and release the socket.
    fn stop() {
        if self.stopped { return; }
        self.stopped = true;
        __ApiHubOutT <- __StdApiHubOut { key: self.tid, kind: 1, a: 0, b: 0, text: "" };
    }
    drain() { self.stop(); }
    dissolve() { self.stop(); }
}
