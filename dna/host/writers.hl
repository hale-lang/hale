// dna/host/writers.hl — the verbs that put a fact into the world
// (GH #566 F8): an intent, a verdict, a pressure signal, a sync, a
// deploy row, the GitHub mirror. Each goes the way it always did:
// onto the membrane when an organization is bound here, into the
// record otherwise, in the name of whoever asked. Nothing here
// decides.

import "../core" as dna;
import "../operations" as ops;

// Before append attempt `tries`: nothing on the first, then (tries-1) ×
// 100ms. A living organism appends to its record every few seconds — a
// schedule firing, a model call — and each attempt here is a read and an
// exact append, slower still on a loaded machine; sixteen back-to-back
// attempts could all land inside the organism's writes and give up with
// "the Record kept changing" (the full DNA suite on a laptop did, GH #970).
// Waiting a little longer each time lets one land; the sixteen together
// wait about twelve seconds at most.
fn stale_pause(tries: Int) {
    let mut w = 1;
    while w < tries {
        std::time::sleep(100ms);
        w = w + 1;
    }
}
fn who_am_i() -> String {
    let u = std::env::var("USER");
    if len(u) == 0 { return "human"; }
    return u;
}

fn hex(n: Int) -> String {
    if n == 0 { return "0"; }
    let digits = "0123456789abcdef";
    let mut v = n;
    let mut out = "";
    while v > 0 {
        let d = v % 16;
        out = digits[d..(d + 1)] + out;
        v = v / 16;
    }
    return out;
}

fn millis() -> Int {
    return std::time::monotonic_ns() / 1000000;
}

fn no_organism(root: String) -> String {
    return "the organism is not running here (no membrane under " + root + "/.hale/dna) and the repository has no remote to reach one through; start it with `hale dna run`";
}

// An event after `from` of one of `kinds` (space-separated) naming `entity`.
fn find_after(p: Projection, from: Int, kinds: String, entity: String) -> dna::Event {
    let mut i = from;
    while i < p.rows() {
        let e = p.row(i);
        if e.entity == entity && std::str::contains(kinds, " " + e.kind + " ") { return e; }
        i = i + 1;
    }
    return dna::Event { seq: -1 };
}

// Eligibility belongs to the captured projection. A stale append must return
// to the verb's complete decision, never retry a previously chosen assignee.
interface TaskWriterAdmission {
    fn append(expected: String, ledger_expected: Int, routing: Int, row: dna::Row) -> String;
}
locus RecordTaskWriterAdmission {
    params { root: String = "."; }
    fn append(expected: String, ledger_expected: Int, routing: Int, row: dna::Row) -> String {
        let r = rec(self.root);
        let now = r.head(JOURNAL);
        if !now.ok { return "the record's head could not be read: " + now.why; }
        if now.id != expected { return "stale_revision"; }
        if routing > 0 {
            // Preserve the existing owning-Ledger path. This is not a joint
            // Record/Ledger transaction; atomic person retirement is Record-only.
            return append_as_at(self.root, expected, ledger_expected, row.kind, row.entity, row.body, row.author);
        }
        // Do not choose a different memory after reading routing 0. Concurrent
        // Ledger adoption moves this exact Record predecessor and loses this CAS.
        let a = r.append(JOURNAL, expected, row, signing(self.root), "");
        if a.ok { return ""; }
        return if a.error == "stale" { "stale_revision" } else { "the row could not be written" };
    }
}

// ---- task create ----------------------------------------------------

@unbounded
// GH #596 W: a person reports a handed Task done. A row in the record
// in their name; nothing runs, nothing is applied — the organism's
// part ended when it handed the Task on. Refused for a Task that is
// not handed: a Task the organism is working, or has settled, is not
// a person's to close.
fn task_done_verb(root: String, seed: String, id: String, who_flag: String, note: String, evidence_flag: String, exception: String, authorized_by: String) -> Answer {
    let writer = RecordTaskWriterAdmission { root: root };
    return task_done_admit(root, seed, id, who_flag, note, evidence_flag, exception, authorized_by, writer);
}

@unbounded
fn task_done_admit(root: String, seed: String, id: String, who_flag: String, note: String, evidence_flag: String, exception: String, authorized_by: String, writer: TaskWriterAdmission) -> Answer {
    if len(id) == 0 { return fail("task done: which Task? `hale dna task done <id>`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let mut stage = 0;
    let mut tries = 0;
    while tries < 16 {
        tries = tries + 1;
        stale_pause(tries);
        let p = open_projection(root, seed, "");
        let read_at = p.j.record.head();
        let ledger_at = if p.j.routing > 0 { p.j.ledger.revision() } else { -1 };
        let t = p.task_of(id);
        if len(t.id) == 0 { return fail("no Task `" + id + "` in the record"); }
        if t.state != "handed" { return fail("Task `" + id + "` is " + t.state + ", not handed to a person: nothing to report done"); }
        let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
        if p.has_row("person.retired", who) { return fail("task done: " + who + " retired; no new admission is made in their name"); }
        // GH #604 rule 4: completion is checked at admission — the row must
        // be the assignee's. Reassignment is its own row, by its own verb.
        if len(t.assignee) > 0 && t.assignee != who {
            return fail("Task `" + id + "` is handed to " + t.assignee + ", not to " + who + "; `hale dna task reassign " + id + " --to " + who + "` first");
        }
        // GH #604: the acceptance condition bound at hand-off. A note never
        // verifies anything: the evidence is linked, or an exception someone
        // else authorized is recorded as such, or the completion is shown as
        // human-reported.
        let evidence = if len(evidence_flag) > 0 { dna::evidence_digest(evidence_flag) } else { "" };
        let refusal = dna::completion_refusal(who, t.evidence_required, evidence, exception, authorized_by);
        if refusal == "evidence required" {
            return fail("Task `" + id + "` closes only with its evidence, under acceptance/" + t.obligation + " (" + t.acceptance + ") as it stood when the Task was handed: link it with `--evidence <digest>` (file it first: `hale dna receipt file <path>`), or record an exception with `--exception <why> --authorized-by <who>`; a note alone does not verify it");
        }
        if len(refusal) > 0 { return fail("task done: " + refusal); }
        if len(evidence) > 0 {
            if !dna::digest_well_formed(evidence) { return fail("task done: `" + evidence_flag + "` is not a receipt digest (sha256:<64 hex digits>)"); }
            if !evidence_held(root, p, evidence) { return fail("task done: no receipt " + evidence + " in the record; file it first: `hale dna receipt file <path>`"); }
            if stage == 0 {
                let lb = std::json::Builder { };
                lb.begin_object();
                lb.string_field("task", id);
                lb.string_field("evidence", evidence);
                lb.string_field("by", who);
                lb.string_field("practice", t.acceptance);
                lb.end_object();
                let linked = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "completion.linked", entity: id, body: lb.result(), author: who });
                if linked == "stale_revision" { continue; }
                if len(linked) > 0 { return fail("the record refused the append: " + linked); }
                stage = 1; continue;
            }
        }
        if len(exception) > 0 {
            // an exception is its authorizer's act, in their own name: the
            // assignee's naming someone is not an authorization
            // and it closes the Task only as it was authorized: the exception
            // text the authorizer approved, under the practice bound to the Task
            // — never another the assignee writes over it (the second review
            // of #632)
            let mut authorized = "";
            let mut matched = false;
            let mut k = 0;
            while k < p.rows() {
                let e = p.row(k);
                if e.kind == "exception.authorized" && e.entity == id && dna::same_party(std::json::find_string_field(e.body, "by"), authorized_by) {
                    authorized = std::json::find_string_field(e.body, "why");
                    if authorized == exception && std::json::find_string_field(e.body, "practice") == t.acceptance { matched = true; }
                }
                k = k + 1;
            }
            if len(authorized) == 0 { return fail("task done: no exception for `" + id + "` authorized by " + authorized_by + " in the record; " + authorized_by + " authorizes it: `hale dna task authorize " + id + " --exception <why> --as " + authorized_by + "`"); }
            if !matched { return fail("task done: " + authorized_by + " authorized a different exception for `" + id + "` (\"" + authorized + "\"); an exception closes a Task only as it was authorized — close it with that exception, or " + authorized_by + " authorizes this one: `hale dna task authorize " + id + " --exception <why> --as " + authorized_by + "`"); }
            if stage < 2 {
                let xb = std::json::Builder { };
                xb.begin_object();
                xb.string_field("task", id);
                xb.string_field("why", exception);
                xb.string_field("authorized_by", authorized_by);
                xb.string_field("by", who);
                xb.string_field("practice", t.acceptance);
                xb.end_object();
                let excepted = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "completion.excepted", entity: id, body: xb.result(), author: who });
                if excepted == "stale_revision" { continue; }
                if len(excepted) > 0 { return fail("the record refused the append: " + excepted); }
                stage = 2; continue;
            }
        }
        let body = "by " + who + (if len(note) > 0 { ": " + note } else { "" });
        let landed = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "task.done", entity: id, body: body, author: who });
        if landed == "stale_revision" { continue; }
        if len(landed) > 0 { return fail("the record refused the append: " + landed); }
        let s2 = sync_record(root);
        let label = if len(evidence) > 0 { " — evidence " + evidence + " linked" } else if len(exception) > 0 { " — exception authorized by " + authorized_by + ": " + exception } else { " — human-reported, no evidence linked" };
        return answer("task " + id + " done " + body + label + "\n");
    }
    return fail("task done: the Record kept changing; no further admission was made, inspect the Task before retrying");
}

// Evidence the record holds: a receipt under refs/dna/receipts, or a
// protected one the record classified or withheld.
fn evidence_held(root: String, p: Projection, evidence: String) -> Bool {
    return receipt_read(root, evidence[7..len(evidence)]).present || p.has_row("receipt.classified", evidence) || p.has_row("receipt.withheld", evidence);
}

// GH #604 (the review of #632): an exception to a Task's acceptance
// condition is authorized by its authorizer, in their own name, as a row;
// the assignee then closes the Task citing it. Not the assignee's own, and
// only one of the people the bound practice names when it names them.
@unbounded
fn task_authorize_verb(root: String, seed: String, id: String, exception: String, who_flag: String) -> Answer {
    let writer = RecordTaskWriterAdmission { root: root };
    return task_authorize_admit(root, seed, id, exception, who_flag, writer);
}

@unbounded
fn task_authorize_admit(root: String, seed: String, id: String, exception: String, who_flag: String, writer: TaskWriterAdmission) -> Answer {
    if len(id) == 0 || len(exception) == 0 { return fail("task authorize: `hale dna task authorize <id> --exception <why> [--as <authorizer>]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let mut tries = 0;
    while tries < 16 {
        tries = tries + 1;
        stale_pause(tries);
        let p = open_projection(root, seed, "");
        let read_at = p.j.record.head();
        let ledger_at = if p.j.routing > 0 { p.j.ledger.revision() } else { -1 };
        let t = p.task_of(id);
        if len(t.id) == 0 { return fail("no Task `" + id + "` in the record"); }
        if t.state != "handed" { return fail("Task `" + id + "` is " + t.state + ", not handed to a person: no exception to authorize"); }
        let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
        if p.has_row("person.retired", who) { return fail("task authorize: " + who + " retired; no new admission is made in their name"); }
        if dna::same_party(who, t.assignee) { return fail("task authorize: " + who + " holds `" + id + "`; an exception is authorized by someone other than its assignee"); }
        if len(t.acceptance) > 0 {
            let doc = receipt_read(root, t.acceptance[7..len(t.acceptance)]);
            // the bound practice is read, or nothing is authorized under it: a
            // practice absent from this clone, unreadable or redacted is not a
            // practice that names no one (the second review of #632)
            if !doc.present { return fail("task authorize: the practice bound to `" + id + "` (" + t.acceptance + ") cannot be read here; an exception is authorized only under the practice it binds — `hale dna sync` fetches it where the record has it"); }
            let text = std::json::find_string_field(doc.text, "text");
            if len(text) == 0 { return fail("task authorize: the practice bound to `" + id + "` (" + t.acceptance + ") has no text this host reads; nothing is authorized under it"); }
            if !dna::may_authorize(text, who) { return fail("task authorize: acceptance/" + t.obligation + " (" + t.acceptance + ") lets only " + dna::exception_authorizers(text) + " authorize an exception"); }
        }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("task", id);
        b.string_field("why", exception);
        b.string_field("by", who);
        b.string_field("practice", t.acceptance);
        b.end_object();
        let landed = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "exception.authorized", entity: id, body: b.result(), author: who });
        if landed == "stale_revision" { continue; }
        if len(landed) > 0 { return fail("the record refused the append: " + landed); }
        let s2 = sync_record(root);
        return answer("task " + id + ": exception authorized by " + who + ": " + exception + " (exception.authorized); " + t.assignee + " closes it with `hale dna task done " + id + " --exception \"" + exception + "\" --authorized-by " + who + "`\n");
    }
    return fail("task authorize: the Record kept changing; no further admission was made, inspect the Task before retrying");
}

// GH #616: a person reports a decision someone else made — a manager,
// a client — naming who decided, through what, and on what evidence. One
// `decision.reported` row in the reporter's name. Whether it settles the
// Task is the obligation's acceptance practice, read here at admission and
// kept in the row, so a later change of practice never rewrites what was
// admitted. The reporter is the Task's assignee (GH #604 rule 4) and never
// the decider.
@unbounded
fn task_decide_verb(root: String, seed: String, id: String, decided_by: String, via: String, evidence_flag: String, note: String, who_flag: String) -> Answer {
    let writer = RecordTaskWriterAdmission { root: root };
    return task_decide_admit(root, seed, id, decided_by, via, evidence_flag, note, who_flag, writer);
}

@unbounded
fn task_decide_admit(root: String, seed: String, id: String, decided_by: String, via: String, evidence_flag: String, note: String, who_flag: String, writer: TaskWriterAdmission) -> Answer {
    if len(id) == 0 { return fail("task decide: `hale dna task decide <id> --decided-by <party> --via <channel> --evidence <digest> [--note …] [--as <reporter>]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let mut tries = 0;
    while tries < 16 {
        tries = tries + 1;
        stale_pause(tries);
        let p = open_projection(root, seed, "");
        let read_at = p.j.record.head();
        let ledger_at = if p.j.routing > 0 { p.j.ledger.revision() } else { -1 };
        let t = p.task_of(id);
        if len(t.id) == 0 { return fail("no Task `" + id + "` in the record"); }
        if t.state != "handed" { return fail("Task `" + id + "` is " + t.state + ", not handed to a person: no decision to report"); }
        let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
        if p.has_row("person.retired", who) { return fail("task decide: " + who + " retired; no new admission is made in their name"); }
        let malformed = dna::report_refusal(who, decided_by, via, evidence_flag);
        if len(malformed) > 0 { return fail("task decide: " + malformed); }
        if len(t.assignee) > 0 && t.assignee != who {
            return fail("Task `" + id + "` is handed to " + t.assignee + ", not to " + who + "; only its assignee reports a decision on it (`hale dna task reassign " + id + " --to " + who + "` first)");
        }
        let evidence = dna::evidence_digest(evidence_flag);
        if !dna::digest_well_formed(evidence) { return fail("task decide: `" + evidence_flag + "` is not a receipt digest (sha256:<64 hex digits>)"); }
        let held = evidence_held(root, p, evidence);
        if !held { return fail("task decide: no receipt " + evidence + " in the record; file the mail or document first: `hale dna receipt file <path>`"); }
        let practice = if len(t.obligation) > 0 { dna::acceptance_practice(t.obligation) } else { "" };
        // the practice bound when the Task was handed governs every way it
        // closes; only a Task handed before practices were bound reads the one
        // in force now
        let policy = if t.acceptance_bound { t.acceptance } else if len(practice) > 0 { p.practice_in_force(practice) } else { "" };
        let mut accepted = false;
        let mut why = "";
        if len(t.obligation) == 0 {
            why = "the Task names no obligation class, so no acceptance practice lets a report settle it; its assignee closes it with `hale dna task done " + id + "`";
        } else if len(policy) == 0 {
            why = (if t.acceptance_bound { "no practice `" + practice + "` was in force when the Task was handed" } else { "no ratified practice `" + practice + "`" }) + ": a reported decision does not settle a `" + t.obligation + "` obligation; its assignee closes it with `hale dna task done " + id + "`";
        } else {
            let doc = receipt_read(root, policy[7..len(policy)]);
            if dna::acceptance_allows_reports(std::json::find_string_field(doc.text, "text")) { accepted = true; }
            else { why = "practice `" + practice + "` (" + policy + ") requires a native decision: `hale dna task done " + id + "` by " + t.assignee; }
        }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("reporter", who);
        b.string_field("decider", decided_by);
        b.string_field("channel", via);
        b.string_field("evidence", evidence);
        b.string_field("scope", id);
        b.string_field("obligation", t.obligation);
        b.string_field("practice", practice);
        b.string_field("policy", policy);
        b.bool_field("accepted", accepted);
        b.string_field("why", why);
        b.string_field("note", note);
        b.end_object();
        let landed = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "decision.reported", entity: id, body: b.result(), author: who });
        if landed == "stale_revision" { continue; }
        if len(landed) > 0 { return fail("the record refused the append: " + landed); }
        let s2 = sync_record(root);
        let line = dna::decision_line(who, decided_by, via, evidence);
        if accepted { return answer("task " + id + " decided: " + line + ", under " + practice + " (" + policy + ")\n"); }
        return answer("task " + id + " still handed: the report is kept (" + line + ") and does not settle it — " + why + "\n");
    }
    return fail("task decide: the Record kept changing; no further admission was made, inspect the Task before retrying");
}

// GH #616: file a document — a mail, a signed page — as evidence a report
// can cite. Internal text goes under the record's receipts with a
// `receipt.filed` row; a protected class is kept in memory alone (GH #606),
// and is refused when this head names no memory.
@unbounded
fn receipt_file_verb(root: String, path: String, class_flag: String, who_flag: String) -> Answer {
    if len(path) == 0 { return fail("receipt file: `hale dna receipt file <path> [--class internal|customer|confidential] [--as <who>]`"); }
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let text = std::io::fs::read_file(path) or "";
    if len(text) == 0 { return fail("receipt file: nothing to file at " + path); }
    let class = if len(class_flag) > 0 { class_flag } else { "internal" };
    if class != "internal" && !dna::protected_class(class) { return fail("receipt file: class `" + class + "` is not internal, customer or confidential"); }
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    let s = sync_record(root);
    if dna::protected_class(class) {
        // kept in memory alone (GH #606), sealed there under a key this
        // head never holds: filing runs a function memory owns (GH #985)
        let vault = dna::MemoryVault { repo: root, dsn_env: dna::own_dsn_env() };
        let kept = vault.keep(text, class, who);
        if len(kept) == 0 { return fail("receipt file: " + vault.last_error); }
        let s2 = sync_record(root);
        return answer("receipt " + dna::evidence_digest(kept) + " filed (" + class + ", kept in memory; receipt.classified, by " + who + ")\n");
    }
    let digest = dna::evidence_digest(dna::digest_of(text));
    // a receipt the record says was redacted is not filed again: its ref
    // would come back behind a row that says the body is gone (#636)
    let p = open_projection(root, ".", "");
    if p.has_row("receipt.redacted", digest) { return fail("receipt file: " + digest + " was redacted; a redacted body is not filed again"); }
    let r = rec(root);
    if len(r.keep(text)) == 0 { return fail("receipt file: the record could not keep " + path + ": " + r.why()); }
    let slash = last_index_of(path, "/");
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("by", who);
    b.string_field("name", if slash < 0 { path } else { path[(slash + 1)..len(path)] });
    b.int_field("bytes", len(text));
    b.string_field("class", "internal");
    b.string_field("store", "git");
    b.end_object();
    if !append_as(root, "receipt.filed", digest, b.result(), who) { return fail("the record refused the append"); }
    let s3 = sync_record(root);
    return answer("receipt " + digest + " filed (internal, " + to_string(len(text)) + " bytes, under refs/dna/receipts; receipt.filed, by " + who + ")\n");
}

// GH #604 rule 5: a handed Task moves to another person as a row that
// names both; the Task stays handed. Reached per command.
@unbounded
fn task_reassign_verb(root: String, seed: String, id: String, to: String, by_flag: String) -> Answer {
    let writer = RecordTaskWriterAdmission { root: root };
    return task_reassign_admit(root, seed, id, to, by_flag, writer);
}

@unbounded
fn task_reassign_admit(root: String, seed: String, id: String, to: String, by_flag: String, writer: TaskWriterAdmission) -> Answer {
    if len(id) == 0 || len(to) == 0 { return fail("task reassign: `hale dna task reassign <id> --to <who> [--as <by>]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let mut tries = 0;
    while tries < 16 {
        tries = tries + 1;
        stale_pause(tries);
        let p = open_projection(root, seed, "");
        let read_at = p.j.record.head();
        let ledger_at = if p.j.routing > 0 { p.j.ledger.revision() } else { -1 };
        let t = p.task_of(id);
        if len(t.id) == 0 { return fail("no Task `" + id + "` in the record"); }
        if t.state != "handed" { return fail("Task `" + id + "` is " + t.state + ", not handed to a person: nothing to reassign"); }
        let by = if len(by_flag) > 0 { by_flag } else { who_am_i() };
        if p.has_row("person.retired", by) { return fail("task reassign: " + by + " retired; no new admission is made in their name"); }
        // GH #604 rule 5: no new work reaches a person who retired
        let mut gone = false;
        let mut k = 0;
        while k < p.rows() {
            let e = p.row(k);
            if e.kind == "person.retired" && e.entity == to { gone = true; }
            k = k + 1;
        }
        if gone { return fail("task reassign: " + to + " retired; no new work reaches them — reassign to someone who works here"); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("from", t.assignee);
        b.string_field("to", to);
        b.string_field("by", by);
        b.end_object();
        let landed = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "task.reassigned", entity: id, body: b.result(), author: by });
        if landed == "stale_revision" { continue; }
        if len(landed) > 0 { return fail("the record refused the append: " + landed); }
        let s2 = sync_record(root);
        return answer("task " + id + " reassigned " + (if len(t.assignee) > 0 { "from " + t.assignee + " " } else { "" }) + "to " + to + " by " + by + "\n");
    }
    return fail("task reassign: the Record kept changing; no further admission was made, inspect the Task before retrying");
}

// GH #667: `hale dna task accept <id> [--as <who>] [--note …]` — a member
// of the owner a transfer names accepts it; their controller then hands
// the Task to the assignee the request named. Refused for anyone else:
// settlement is the receiving owner's alone.
fn task_accept_verb(root: String, seed: String, id: String, who_flag: String, note: String) -> Answer {
    let writer = RecordTaskWriterAdmission { root: root };
    return task_accept_admit(root, seed, id, who_flag, note, writer);
}

@unbounded
fn task_accept_admit(root: String, seed: String, id: String, who_flag: String, note: String, writer: TaskWriterAdmission) -> Answer {
    if len(id) == 0 { return fail("task accept: `hale dna task accept <id> [--as <who>] [--note <why>]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let mut tries = 0;
    while tries < 16 {
        tries = tries + 1;
        stale_pause(tries);
        let p = open_projection(root, seed, "");
        let read_at = p.j.record.head();
        let ledger_at = if p.j.routing > 0 { p.j.ledger.revision() } else { -1 };
        let t = p.task_of(id);
        if len(t.id) == 0 { return fail("no Task `" + id + "` in the record"); }
        if t.state != "transfer_requested" { return fail("Task `" + id + "` is " + t.state + ", not offered to another owner: nothing to accept"); }
        let to = std::json::find_string_field(t.detail, "to");
        let from = std::json::find_string_field(t.detail, "owner");
        if len(to) == 0 { return fail("Task `" + id + "` is offered to another record (`hale dna handoff accept`), not to an owner of this one"); }
        let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
        if p.has_row("person.retired", who) { return fail("task accept: " + who + " retired; no new admission is made in their name"); }
        let assignee = std::json::find_string_field(t.detail, "assignee");
        if len(assignee) == 0 || p.has_row("person.retired", assignee) { return fail("task accept: the requested assignee is unavailable or retired; a new owner-approved transfer is required"); }
        let theirs = owner_of_person_here(root, who);
        if theirs != to { return fail("task accept: " + id + " is offered to " + to + "; " + who + " is " + (if len(theirs) > 0 { theirs + "'s" } else { "no owner's" }) + " member, and only " + to + "'s accepts"); }
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("owner", to);
        b.string_field("from", from);
        b.string_field("by", who);
        b.string_field("assignee", std::json::find_string_field(t.detail, "assignee"));
        b.string_field("note", note);
        b.end_object();
        let landed = writer.append(read_at, ledger_at, p.j.routing, dna::Row { kind: "task.transfer_accepted", entity: id, body: b.result(), author: who });
        if landed == "stale_revision" { continue; }
        if len(landed) > 0 { return fail("the record refused the append: " + landed); }
        let s2 = sync_record(root);
        return answer("task " + id + " accepted for " + to + " by " + who + " (task.transfer_accepted); " + to + "'s controller hands it to " + std::json::find_string_field(t.detail, "assignee") + "\n");
    }
    return fail("task accept: the Record kept changing; no further admission was made, inspect the Task before retrying");
}

// GH #604 rule 5: a person retires. Admission of new work to them
// stops; what they hold is transferred to a named successor, each a
// `task.reassigned` row, and the retirement is a row in the retiring
// or retiring-them person's name. Refused while they hold work and no
// successor is named: pending work is accounted for, never dropped.
@unbounded
fn retire_verb(root: String, seed: String, who: String, to: String, by_flag: String) -> Answer {
    if len(who) == 0 { return fail("retire: `hale dna retire <who> [--to <successor>] [--as <by>]`"); }
    let synced = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    return retire_rows(root, seed, who, to, by_flag);
}

// GH #604 rule 5, row by row: admission of new work to the person stops,
// what they hold is transferred to a named successor (`task.reassigned`
// each), and the retirement is a row in the retiring or retiring-them
// person's name. Refused while they hold work and no successor is named.
@unbounded
fn retire_rows(root: String, seed: String, who: String, to: String, by_flag: String) -> Answer {
    let p = open_projection(root, seed, "");
    let by = if len(by_flag) > 0 { by_flag } else { who_am_i() };
    let mut held = "";
    let mut n = 0;
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == "task.born" {
            let t = p.task_of(e.entity);
            if t.state == "handed" && t.assignee == who { held = held + e.entity + " "; n = n + 1; }
        }
        i = i + 1;
    }
    if n > 0 && len(to) == 0 { return fail(who + " holds " + to_string(n) + " handed task(s): " + dna::trim_nl(held) + "; name a successor: `hale dna retire " + who + " --to <who>`"); }
    // a successor is someone who works here: not the person retiring, and
    // not a person who retired before
    if len(to) > 0 {
        if to == who { return fail("retire: " + who + " cannot succeed themselves"); }
        let mut k = 0;
        while k < p.rows() {
            let e = p.row(k);
            if e.kind == "person.retired" && e.entity == to { return fail("retire: " + to + " retired; name a successor who works here"); }
            k = k + 1;
        }
    }
    let mut rest = held;
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let id = if sp < 0 { rest } else { rest[0..sp] };
        rest = if sp < 0 { "" } else { rest[(sp + 1)..len(rest)] };
        if len(id) == 0 { continue; }
        let one = task_reassign_verb(root, seed, id, to, by);
        if !one.ok { return one; }
    }
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("by", by);
    b.string_field("to", to);
    b.int_field("transferred", n);
    b.end_object();
    if !append_as(root, "person.retired", who, b.result(), by) { return fail("the record refused the append"); }
    let s2 = sync_record(root);
    return answer(who + " retired by " + by + "; " + to_string(n) + " task(s) transferred" + (if n > 0 { " to " + to } else { "" }) + "\n");
}

// The ids in a retirement plan's task array, space-separated, as the
// refusal names them (`noor holds 1 handed task(s): t2`).
@unbounded
fn held_task_ids(tasks: String) -> String {
    let mut out = "";
    let mut entries = std::json::array_first(tasks);
    while !entries.done {
        let id = std::json::find_string_field(entries.element, "id");
        if len(id) > 0 { out = if len(out) > 0 { out + " " + id } else { id }; }
        entries = std::json::array_next(entries);
    }
    return out;
}

// Trusted-local CLI attribution is its existing authority model. The HTTP
// provider independently requires its explicit application policy grant.
@unbounded
fn retire_admit(root: String, seed: String, who: String, to: String, by_flag: String, batch: ops::GovernanceBatchRecord) -> Answer {
    if len(who) == 0 { return fail("retire: `hale dna retire <who> [--to <successor>] [--as <by>]`"); }
    let synced = sync_record(root);
    let record = dna::GitRecord { repo: root };
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let principal = record.setting("principal");
    // The atomic batch below is the trusted-local Record's. A record with
    // Ledger routing or a hosted principal retires the way it did before
    // the batch existed: each transfer a row, then the retirement, in the
    // named person's name (the two-heads fixture retires under both).
    if trust_mode(root) != "local" || (principal != "" && principal != "local") || routing_here(root) != 0 {
        return retire_rows(root, seed, who, to, by_flag);
    }
    let by = if len(by_flag) > 0 { by_flag } else { who_am_i() };
    let context = ops::GovernanceContext { application_id: record.identity(), principal_mode: "local", principal_name: by };
    let common = ops::GovernanceCommandCodec { }; let codec = ops::PersonRetirementCodec { }; let retirement = ops::PersonRetirement { };
    if !common.context_valid(context) || !common.bounded(who, 256, true, false) || !common.bounded(to, 256, false, false) || to == who { return fail("retire: name an exact person and a distinct successor, when one is supplied"); }
    let grant = ops::GovernanceGrant { allowed: true, authority: "trusted-local-cli", basis: "dna.trusted-local-cli-retirement/1" };
    let cli = GovernanceCli { root: root }; let request_id = cli.request_id("");
    let native = ops::GovernanceCommands { record: record };
    let mut attempts = 0;
    while attempts < 4 {
        attempts = attempts + 1;
        let snapshot = native.capture();
        if !snapshot.ok { return fail("retire: " + snapshot.code); }
        let journal = ops::GovernanceJournal { snapshot: snapshot };
        if !journal.valid || !native.source_supported(journal) { return fail("retire: the complete Record-only history is unavailable"); }
        let plan = retirement.plan(journal, who, grant.basis);
        if !plan.ok { return fail("retire: " + plan.code + "; no partial transfers were published"); }
        if plan.state == "retired" { return fail("retire: " + who + " already retired" + (if plan.successor != "" { " to " + plan.successor } else { " without a successor" }) + "; inspect the existing retirement and Task history rather than publishing it again"); }
        if !retirement.active(journal, by) { return fail("retire: " + by + " retired; no new admission is made in their name"); }
        if plan.transferred > 0 && to == "" { return fail(who + " holds " + to_string(plan.transferred) + " handed task(s): " + held_task_ids(plan.tasks) + "; name a successor: `hale dna retire " + who + " --to <who>`"); }
        let command = ops::GovernanceCommand { request_id: request_id, operation: "dna.person.retire", application_id: context.application_id, target_kind: "dna.person", target_id: who,
            subject_digest: plan.subject_digest, new_assignee: to };
        if !codec.valid(context, command) { return fail("retire: invalid exact retirement command"); }
        let existing = native.find(snapshot, journal, context, request_id);
        if existing.ok || existing.code != "command_not_found" { return fail("retire: the fresh request identity is unavailable: " + request_id); }
        if trust_mode(root) != "local" || record.setting("principal") != principal { return fail("retire: local authority changed before admission; nothing was published"); }
        eprintln("hale dna retirement request_id: ", request_id);
        let published = retirement.publish_retirement(batch, snapshot, context, command, grant, plan, false);
        if published.code == "stale" { continue; }
        if !published.ok { return fail("retire: " + published.code + "; no partial transfers were published; request_id " + request_id); }
        // Both a successful and an uncertain ref update are observed through
        // the same shared namespace and native chain proof. Never republish an
        // uncertain batch, and never infer admission from off-ref commits.
        let after = native.capture();
        if after.ok {
            let current = ops::GovernanceJournal { snapshot: after };
            if current.valid {
                let found = native.find(after, current, context, request_id);
                if found.ok && found.fingerprint == codec.fingerprint(context, command) {
                    let result = native.result(after, current, found);
                    if result.ok && result.receipt.person.state == "applied" {
                        // Reconciliation may rewrite event IDs; it cannot run
                        // implicitly across this exact local transfer manifest.
                        return answer(who + " retired by " + by + "; " + to_string(result.receipt.person.transferred) + " task(s) transferred" + (if result.receipt.person.transferred > 0 { " to " + to } else { "" }) + "\nrequest_id: " + request_id + "\nretirement event: " + result.receipt.person.event_id + "\nRecorded atomically in this local Record; remote synchronization is not automatic after this transaction.\n");
                    }
                }
            }
        }
        return fail("retire: outcome unknown; no second publication was attempted. Retain request_id " + request_id + "; inspect the native retirement and Task history before any new command");
    }
    return fail("retire: the Record kept changing; no retirement batch was admitted by this request. Retain request_id " + request_id);
}

// GH #604 rule 3: a person resolves an effect whose outcome the
// organism could not establish after a restart. The last
// `effect.result` for a key is its status, so the resolution is one
// row in the resolver's name, and the gate proceeds or stops on it.
fn effect_resolve_verb(root: String, seed: String, key: String, outcome: String, who_flag: String, note: String) -> Answer {
    if len(key) == 0 || !(outcome == "ok" || outcome == "failed") { return fail("effect resolve: `hale dna effect resolve <key> --outcome ok|failed [--as <who>] [--note …]`"); }
    let s = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    let mut requested = false;
    let mut last = "";
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.entity == key && e.kind == "effect.requested" { requested = true; }
        if e.entity == key && e.kind == "effect.result" { last = e.body; }
        i = i + 1;
    }
    if !requested { return fail("no effect `" + key + "` in the record"); }
    if !std::str::starts_with(last, "unknown") { return fail("effect `" + key + "` is " + (if len(last) == 0 { "still in flight" } else { last }) + ", not unknown: nothing to resolve"); }
    let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
    let body = outcome + " (resolved by " + who + (if len(note) > 0 { ": " + note } else { "" }) + ")";
    if !append_as(root, "effect.result", key, body, who) { return fail("the record refused the append"); }
    let s2 = sync_record(root);
    return answer("effect " + key + " " + body + "\n");
}

// `hale dna task create`: asking for an outcome is one kind of task (the
// face exposes the same operation as `dna.task.create`). The row kinds
// it writes and reads (`intent.requested`, `intent.refused`,
// `workflow.admitted`) and the membrane kind `intent` keep their names.
fn task_create_verb(root: String, outcome: String, to: String, no_wait: Bool, as_flag: String) -> Answer {
    if len(outcome) == 0 { return fail("task create: say what should happen — `hale dna task create \"<outcome>\"`"); }
    let s0 = sync_record(root);
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, ".", "");
    let before = p.rows();
    let intent_id = "i" + hex(millis());
    // GH #612: a hosted head names the principal it resolved
    let who = if len(as_flag) > 0 { as_flag } else { who_am_i() };
    // GH #664: a body here admits the intent only for a position its owner
    // holds; for another owner's the intent goes into the record, where
    // their controller relays it
    let ours = admits_here(root, to);
    let local = membrane_up(root) && ours;
    let b = std::json::Builder { };
    b.begin_object();
    if local { b.string_field("intent_id", intent_id); }
    b.string_field("outcome", outcome);
    b.string_field("from", who);
    b.string_field("to", to);
    // GH #682: published by this head as well; the host relays it only if
    // it stays unanswered
    if local { b.string_field("via", "membrane"); }
    b.end_object();
    // `--no-wait`: the one notice, on either path, once the row is in the record
    let requested = "intent " + intent_id + " requested in the record" + (if ours { "; the organism answers there" } else { " for its owner's controller (" + ownership_note(root, to) + "); it answers there" }) + " (`hale dna sync`, then `status`)\n";
    if local {
        // GH #682: the durable fact precedes the act, on this path too — the
        // row lands first, so a publish the membrane loses is relayed by the
        // host beside the organism, which admits an intent once by its id
        if !append_as(root, "intent.requested", intent_id, b.result(), if len(as_flag) > 0 { as_flag } else { "" }) { return fail("the record refused the append"); }
        let e = publish_on_membrane(root, "intent", b.result());
        if len(e) > 0 { eprintln("hale dna task create: ", e, "; the intent is in the record, and the host beside the organism relays it"); }
        if no_wait { return answer(requested); }
    } else {
        // no organism here: the intent goes into the record, and the host
        // beside the organism relays it (GH #566 F1)
        if len(record_remote(root)) == 0 { return fail(if ours { no_organism(root) } else { "task create: " + ownership_note(root, to) + "; their controller reads the record at its remote, and this clone has none" }); }
        if !append_as(root, "intent.requested", intent_id, b.result(), if len(as_flag) > 0 { as_flag } else { "" }) { return fail("the record refused the append"); }
        let s = sync_record(root);
        if !s.ok { return fail(s.summary); }
        if no_wait { return answer(requested); }
    }
    // the organism's answer, from the record
    let deadline = std::time::now() + (if local { 10 } else { 60 });
    while true {
        if !local { let s = sync_record(root); }
        let q = open_projection(root, ".", "");
        let refused = find_after(q, before, " intent.refused ", intent_id);
        if refused.seq >= 0 { return answer("refused: " + refused.body + "\n"); }
        // card 18: the ask's own execution — the admission that names this
        // intent as its request — never the next birth in the record,
        // which may be another ask's; its state is the projection's
        let mut i = before;
        while i < q.rows() {
            let t = q.row(i);
            if t.kind == "workflow.admitted" && std::json::find_string_field(t.body, "request") == intent_id {
                let projected = q.task_of(t.entity);
                let state = if len(projected.state) > 0 { projected.state } else { "active" };
                return answer("task " + t.entity + " born for intent " + intent_id + " [" + state + "]\n");
            }
            i = i + 1;
        }
        if std::time::now() > deadline { return fail("published intent " + intent_id + ", but the organism journaled no answer in time (record revision " + to_string(q.rows()) + ")"); }
        std::time::sleep(if local { 150ms } else { 1000ms });
    }
    return fail("unreachable");
}

// ---- native governance command adapter -------------------------------

type GovernanceCliSettings {
    ok: Bool = false;
    error: String = "";
    context: ops::GovernanceContext = ops::GovernanceContext { };
    policy: ops::AuthorityPolicy = ops::AuthorityPolicy { };
}
type GovernanceCliReview {
    ok: Bool = false;
    error: String = "";
    supported: Bool = false;
    subject_digest: String = "";
}

// CLI parsing/presentation only. FixedAuthority and GovernanceCommands are
// shared with the HTTP head; this adapter never appends or publishes a trigger.
locus GovernanceCli {
    params { root: String = "."; }
    fn settings(who_flag: String) -> GovernanceCliSettings {
        let actor = std::env::var("USER");
        if len(actor) == 0 || (len(who_flag) > 0 && who_flag != actor) { return GovernanceCliSettings { error: "command_context_changed: --as must match the trusted local USER identity" }; }
        let path = std::env::var("HALE_DNA_COMMAND_POLICY");
        if len(path) == 0 { return GovernanceCliSettings { error: "HALE_DNA_COMMAND_POLICY must name an explicit authority policy for native commands" }; }
        let record = dna::GitRecord { repo: self.root };
        let identity = record.identity();
        let context = ops::GovernanceContext { application_id: identity, principal_mode: "local", principal_name: actor };
        let command_codec = ops::GovernanceCommandCodec { };
        if !command_codec.context_valid(context) { return GovernanceCliSettings { error: "invalid native application or local principal identity" }; }
        let trust_setting = record.git("config\n--get\ndna.trust");
        if trust_setting.code != 0 && trust_setting.code != 1 { return GovernanceCliSettings { error: "cannot read Record trust policy" }; }
        let declared = dna::trim_nl(trust_setting.stdout);
        let trust = if len(declared) == 0 { "local" } else { declared };
        let size = std::io::fs::file_size(path) or - 1;
        if size < 1 || size > 65536 { return GovernanceCliSettings { error: "authority policy must be a readable file of 1..65536 bytes" }; }
        let document = std::io::fs::read_file(path) or "";
        let codec = ops::AuthorityPolicyCodec { };
        let policy = codec.decode(document, identity, trust);
        if !policy.valid { return GovernanceCliSettings { error: "invalid authority policy, application binding, or Record trust mode" }; }
        return GovernanceCliSettings { ok: true, context: context, policy: policy };
    }
    fn request_id(supplied: String) -> String {
        if len(supplied) > 0 { return supplied; }
        return "cli-" + to_string(std::time::now()) + "-" + to_string(std::process::pid()) + "-" + to_string(std::time::monotonic_ns());
    }
    fn recovery_hint(id: String) -> String {
        return "Retain request_id " + id + "; recover either operation with `hale dna practice lookup --request-id <request_id>` under the same local identity and policy.\n";
    }
    fn render(result: ops::GovernanceResult, request_id: String) -> Answer {
        if !result.ok { return fail("command " + request_id + ": " + result.code + "\n" + self.recovery_hint(request_id)); }
        let r = result.receipt;
        let mut out = "request_id: " + r.request_id + "\ncommand_id: " + r.command_id + "\n" + r.operation + ": " + r.state + "\n";
        if len(r.reason) > 0 { out = out + r.reason + "\n"; }
        if r.operation == "dna.practice.propose" {
            out = out + "proposal: " + r.proposal_state + "\n";
            if len(r.candidate_digest) > 0 { out = out + "candidate: " + r.candidate_digest + "\n"; }
            if len(r.review_id) > 0 { out = out + "review_id: " + r.review_id + "\n"; }
        } else { out = out + "verdict: " + r.verdict_value + " [" + r.verdict_state + "]\n"; }
        out = out + "review: " + r.review_state + (if len(r.review_outcome) > 0 { " [" + r.review_outcome + "]" } else { "" }) + "\nactivation: " + r.activation_state + "\n";
        if len(r.activation_reason) > 0 { out = out + r.activation_reason + "\n"; }
        out = out + "Record: " + result.head + " (revision " + to_string(result.revision) + ")\n";
        if r.state != "succeeded" && r.state != "refused" && r.state != "failed" { out = out + self.recovery_hint(request_id); }
        return Answer { ok: r.state != "refused" && r.state != "failed", text: out };
    }
    fn finished(result: ops::GovernanceResult) -> Bool {
        if !result.ok { return true; }
        let state = result.receipt.state;
        return state == "succeeded" || state == "refused" || state == "failed" || state == "outcome_unknown";
    }
    fn submit(native: ops::GovernanceCommands, authority: ops::FixedAuthority, context: ops::GovernanceContext, command: ops::GovernanceCommand, authority_flag: String, no_wait: Bool) -> Answer {
        let codec = ops::GovernanceCommandCodec { };
        if !codec.valid(context, command) { return fail("invalid_command: native replacements require exact subject, nonempty text and rationale; verdicts require approve, reject or revise on an exact pending Practice Review"); }
        if len(authority_flag) > 0 {
            let snapshot = native.capture();
            if !snapshot.ok { return fail("cannot check --authority against current policy: " + snapshot.code); }
            let journal = ops::GovernanceJournal { snapshot: snapshot };
            if !journal.valid { return fail("cannot check --authority against an invalid Record"); }
            let grant = authority.authorize(context, command.operation, false, journal);
            if authority_flag != grant.authority { return fail("forbidden: --authority is an expected policy role; it cannot grant or replace authority"); }
        }
        // stderr is delivered before the potentially uncertain operation. The
        // final answer also repeats the key for scripts capturing stdout.
        eprintln("hale dna command request_id: ", command.request_id);
        let mut result = native.submit(context, command);
        if no_wait || self.finished(result) || !membrane_up(self.root) { return self.render(result, command.request_id); }
        let deadline = std::time::monotonic_ns() + (if command.operation == "dna.practice.propose" { 60000000000 } else { 10000000000 });
        while std::time::monotonic_ns() < deadline {
            std::time::sleep(150ms);
            result = native.lookup(context, command.request_id);
            if self.finished(result) { return self.render(result, command.request_id); }
        }
        let answer = self.render(result, command.request_id);
        return Answer { ok: answer.ok, text: answer.text + "No terminal native answer before the wait ended; the command remains recoverable.\n" };
    }
    fn practice(name: String, text: String, because: String, supersedes: String, who_flag: String, supplied_id: String, no_wait: Bool) -> Answer {
        let settings = self.settings(who_flag);
        if !settings.ok { return fail(settings.error); }
        let record = dna::GitRecord { repo: self.root };
        let authority = ops::FixedAuthority { policy: settings.policy };
        let native = ops::GovernanceCommands { record: record, authority: authority, sign: settings.policy.sign };
        let snapshot = native.capture();
        if !snapshot.ok { return fail("cannot read Practice predecessor: " + snapshot.code); }
        let journal = ops::GovernanceJournal { snapshot: snapshot };
        if !journal.valid { return fail("cannot read Practice predecessor: invalid Record"); }
        let queries = ops::Queries { j: journal };
        let selected = queries.practice_metadata(supersedes);
        if len(name) == 0 || selected.name != name { return fail("stale_subject: the supplied name must match the selected native Practice predecessor"); }
        let command = ops::GovernanceCommand {
            request_id: self.request_id(supplied_id), operation: "dna.practice.propose", application_id: settings.context.application_id,
            target_kind: "dna.practice", target_id: supersedes, subject_digest: supersedes, text: text, rationale: because
        };
        return self.submit(native, authority, settings.context, command, "", no_wait);
    }
    fn review_profile(id: String) -> GovernanceCliReview {
        let record = dna::GitRecord { repo: self.root };
        let native = ops::GovernanceCommands { record: record };
        let snapshot = native.capture();
        if !snapshot.ok { return GovernanceCliReview { error: snapshot.code }; }
        let journal = ops::GovernanceJournal { snapshot: snapshot };
        if !journal.valid { return GovernanceCliReview { error: "command_history_invalid" }; }
        let review = ops::review_row(journal, id);
        let queries = ops::Queries { j: journal };
        let practice = queries.practice_metadata(review.knowledge_digest);
        if len(review.id) == 0 { return GovernanceCliReview { error: "review_not_found" }; }
        // Missing Practice metadata cannot prove this is an unrelated legacy
        // Review. Never use a failed classification to bypass shared admission.
        if !review.is_mutation && len(review.knowledge_digest) > 0 && len(practice.id) == 0 { return GovernanceCliReview { error: "knowledge_subject_unavailable" }; }
        let supported = len(review.id) > 0 && !review.is_mutation && len(review.approvers) == 0 && practice.kind == "practice" && practice.target == "org";
        return GovernanceCliReview { ok: true, supported: supported, subject_digest: review.subject_digest };
    }
    fn verdict(id: String, verdict: String, who_flag: String, authority_flag: String, comment: String, digest: String, supplied_id: String, no_wait: Bool) -> Answer {
        let settings = self.settings(who_flag);
        if !settings.ok { return fail(settings.error); }
        let record = dna::GitRecord { repo: self.root };
        let authority = ops::FixedAuthority { policy: settings.policy };
        let native = ops::GovernanceCommands { record: record, authority: authority, sign: settings.policy.sign };
        let command = ops::GovernanceCommand {
            request_id: self.request_id(supplied_id), operation: "dna.review.verdict", application_id: settings.context.application_id,
            target_kind: "dna.review", target_id: id, subject_digest: digest, expected_review_state: "pending", verdict: verdict, comment: comment
        };
        return self.submit(native, authority, settings.context, command, authority_flag, no_wait);
    }
    fn lookup(request_id: String, who_flag: String) -> Answer {
        let settings = self.settings(who_flag);
        if !settings.ok { return fail(settings.error); }
        let codec = ops::GovernanceCommandCodec { };
        if len(codec.identity(settings.context, request_id)) == 0 { return fail("lookup requires one valid --request-id"); }
        let record = dna::GitRecord { repo: self.root };
        let authority = ops::FixedAuthority { policy: settings.policy };
        let native = ops::GovernanceCommands { record: record, authority: authority, sign: settings.policy.sign };
        return self.render(native.lookup(settings.context, request_id), request_id);
    }
}

fn practice_command_verb(root: String, seed: String, sub: String, name: String, text: String, because: String, supersedes: String, who_flag: String, request_id: String, no_wait: Bool) -> Answer {
    let cli = GovernanceCli { root: root };
    if sub == "lookup" {
        if len(name) > 0 || len(text) > 0 || len(because) > 0 || len(supersedes) > 0 { return fail("practice lookup accepts --request-id and optional matching --as only"); }
        return cli.lookup(request_id, who_flag);
    }
    if sub == "propose" && len(supersedes) > 0 && len(std::env::var("HALE_DNA_COMMAND_POLICY")) > 0 { return cli.practice(name, text, because, supersedes, who_flag, request_id, no_wait); }
    if len(request_id) > 0 { return fail("--request-id requires the configured native replacement profile; set HALE_DNA_COMMAND_POLICY and supply --supersedes"); }
    return practice_verb(root, seed, sub, name, text, because, supersedes, who_flag);
}

fn verdict_command_verb(root: String, seed: String, id: String, verdict: String, reviewer_flag: String, authority_flag: String, comment: String, digest_flag: String, no_wait: Bool, request_id: String) -> Answer {
    if len(std::env::var("HALE_DNA_COMMAND_POLICY")) > 0 && id != "design" {
        let cli = GovernanceCli { root: root };
        let selected = cli.review_profile(id);
        if !selected.ok { return fail("cannot determine native Review profile: " + selected.error); }
        if selected.supported {
            return cli.verdict(id, verdict, reviewer_flag, authority_flag, comment, if len(digest_flag) > 0 { digest_flag } else { selected.subject_digest }, request_id, no_wait);
        }
    }
    if len(request_id) > 0 { return fail("--request-id requires a configured native Practice Review command; design batches and unrelated Reviews keep their existing paths"); }
    return verdict_verb(root, seed, id, verdict, reviewer_flag, authority_flag, comment, digest_flag, no_wait);
}

// ---- a verdict ------------------------------------------------------

@unbounded
fn verdict_verb(root: String, seed: String, id: String, verdict: String, reviewer_flag: String, authority_flag: String, comment: String, digest_flag: String, no_wait: Bool) -> Answer {
    if !(verdict == "approve" || verdict == "revise" || verdict == "reject" || verdict == "abstain") {
        return fail("review: verdict `" + verdict + "` is not one of approve | revise | reject | abstain");
    }
    let local = membrane_up(root);
    if !local { let s = sync_record(root); }
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    let p = open_projection(root, seed, "");
    // GH #596 C: `design` names every pending seeded practice; each is
    // decided by its own verdict, in turn — a convenience over the
    // individual Reviews, never a batch object in the record
    if id == "design" {
        let ids = p.review_ids();
        let n = list_len(ids);
        let mut out = "";
        let mut i = 0;
        while i < n {
            let r = p.review_of(nth(ids, i));
            if r.state == "pending" && r.group == "design" {
                let one = verdict_verb(root, seed, r.id, verdict, reviewer_flag, authority_flag, comment, "", no_wait);
                if !one.ok { return one; }
                out = out + one.text;
            }
            i = i + 1;
        }
        if len(out) == 0 { return fail("no pending design Review"); }
        return answer(out);
    }
    let r = p.review_of(id);
    if len(r.id) == 0 { return fail("no `review.requested` for `" + id + "` in the Journal (pending: " + pending_ids(p) + ")"); }
    if !local && len(record_remote(root)) == 0 { return fail("the organism is not running here (no membrane) and the repository has no remote to reach one through; start it with `hale dna run`"); }
    let reviewer = if len(reviewer_flag) > 0 { reviewer_flag } else { who_am_i() };
    let authority = if len(authority_flag) > 0 { authority_flag } else { "board" };
    // the verdict names the candidate the reviewer LOOKED AT
    let named = if len(digest_flag) > 0 { digest_flag } else { r.subject_digest };
    let before = p.rows();
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("review_id", id);
    b.string_field("subject_digest", named);
    b.string_field("verdict", verdict);
    b.string_field("reviewer", reviewer);
    b.string_field("authority", authority);
    b.string_field("comment", comment);
    // GH #682: the row first, then the publish; the host relays it only if
    // it stays unanswered
    if local { b.string_field("via", "membrane"); }
    b.end_object();
    if local {
        if !append_as(root, "review.verdict", id, b.result(), if len(reviewer_flag) > 0 { reviewer_flag } else { "" }) { return fail("the record refused the append"); }
        let e = publish_on_membrane(root, "verdict", b.result());
        if len(e) > 0 { eprintln("hale dna review: ", e, "; the verdict is in the record, and the host beside the organism relays it"); }
    } else {
        // a row in the record, in the reviewer's name; the host beside the
        // organism relays it, and the Review answers in the record
        if !append_as(root, "review.verdict", id, b.result(), if len(reviewer_flag) > 0 { reviewer_flag } else { "" }) { return fail("the record refused the append"); }
        let s = sync_record(root);
        if !s.ok { return fail(s.summary); }
    }
    if no_wait { return answer("verdict " + verdict + " on " + id + " by " + reviewer + " sent " + (if local { "over the membrane" } else { "into the record" }) + "; the Review answers in the record\n"); }
    let deadline = std::time::now() + (if local { 10 } else { 60 });
    while true {
        if !local { let s = sync_record(root); }
        let q = open_projection(root, seed, "");
        let e = find_after(q, before, " review.settled review.refused ", id);
        if e.seq >= 0 {
            if e.kind == "review.settled" { return answer("review " + id + " settled: " + e.body + "\n"); }
            return answer("review " + id + " refused the verdict: " + e.body + "\n");
        }
        if std::time::now() > deadline { return fail("published the verdict, but the organism journaled no answer for `" + id + "` in time"); }
        std::time::sleep(if local { 150ms } else { 1000ms });
    }
    return fail("unreachable");
}

// ---- pressure -------------------------------------------------------

fn pressure_raise(root: String, source: String, what: String) -> Answer {
    if len(source) == 0 || len(what) == 0 { return fail("pressure raise needs a <source> and what"); }
    if !membrane_up(root) { return fail("the organization is not running here (no membrane); pressure is a live signal"); }
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("source", source);
    b.string_field("what", what);
    b.int_field("count", 1);
    b.end_object();
    let e = publish_on_membrane(root, "pressure", b.result());
    if len(e) > 0 { return fail(e); }
    return answer("pressure raised on " + source + ": " + what + "\n");
}

// A concern (GH #583 K2): a child's signal about the part above it,
// live like pressure; persistent concerns become knowledge proposals.
fn concern_raise(root: String, source: String, what: String, severity: Int) -> Answer {
    if len(source) == 0 || len(what) == 0 { return fail("concern raise needs a <source> (a locus path under org) and what"); }
    let b = std::json::Builder { };
    b.begin_object();
    // GH #689: this concern's own id, carried into the answer
    b.string_field("request", "c" + hex(millis()));
    b.string_field("source", source);
    b.string_field("what", what);
    b.int_field("severity", severity);
    if membrane_up(root) {
        // GH #682: the row first, then the publish
        b.string_field("via", "membrane");
        b.end_object();
        if !append_as(root, "concern.requested", source, b.result(), "") { return fail("the record refused the append"); }
        let e = publish_on_membrane(root, "concern", b.result());
        if len(e) > 0 { eprintln("hale dna concern: ", e, "; the concern is in the record, and the host beside the organization relays it"); }
        return answer("concern raised by " + source + ": " + what + "\n");
    }
    b.end_object();
    // no organization here: into the record, and the host beside the
    // organization relays it (GH #583 K4)
    if len(record_remote(root)) == 0 { return fail(no_organism(root)); }
    if !append_as(root, "concern.requested", source, b.result(), "") { return fail("the record refused the append"); }
    let s = sync_record(root);
    if !s.ok { return fail(s.summary); }
    return answer("concern from " + source + " requested in the record; the organization hears it there\n");
}

// ---- practices (GH #602) ---------------------------------------------
// A person proposes a practice for the whole organization: a named text
// the Board ratifies. Over the membrane when an organization is bound
// here, into the record otherwise; the organization records who proposed
// it and why, and opens the Board's Review. Nothing is in force until the
// Board approves it. `hale dna practice` lists practices as the record has
// them.
@unbounded
fn practice_verb(root: String, seed: String, sub: String, name: String, text: String, because: String, supersedes: String, who_flag: String) -> Answer {
    let usage = "practice: `hale dna practice propose <name> --text <text> [--because <what prompted it>] [--supersedes <digest>] [--as <who>]`, or `hale dna practice` to list";
    let no_head = record_refusal(root);
    if len(no_head) > 0 { return fail(no_head); }
    if sub == "propose" {
        if len(name) == 0 || len(text) == 0 { return fail(usage); }
        let who = if len(who_flag) > 0 { who_flag } else { who_am_i() };
        let request_id = "p" + hex(millis());
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("request_id", request_id);
        b.string_field("name", name);
        b.string_field("text", text);
        b.string_field("by", who);
        b.string_field("because", because);
        b.string_field("supersedes", supersedes);
        if membrane_up(root) {
            // GH #682: the row first, then the publish; the organization
            // answers a request once, however often it is delivered
            b.string_field("via", "membrane");
            b.end_object();
            let before = open_projection(root, seed, "").rows();
            if !append_as(root, "practice.requested", request_id, b.result(), who) { return fail("the record refused the append"); }
            let e = publish_on_membrane(root, "practice", b.result());
            if len(e) > 0 { eprintln("hale dna practice: ", e, "; the proposal is in the record, and the host beside the organization relays it"); }
            // the organization answers from its bus; give a busy one a minute
            let deadline = std::time::now() + 60;
            while std::time::now() <= deadline {
                let q = open_projection(root, seed, "");
                let r = find_after(q, before, " practice.proposed practice.refused ", request_id);
                if r.seq >= 0 {
                    if r.kind == "practice.refused" { return fail("practice " + name + " refused: " + r.body); }
                    let digest = std::json::find_string_field(r.body, "digest");
                    return answer("practice " + name + " proposed by " + who + " as " + digest + "; the Board ratifies it: `hale dna review " + dna::knowledge_review_id(digest) + " approve --authority board`\n");
                }
                std::time::sleep(150ms);
            }
            return fail("published the proposal, but the organization journaled no answer for " + request_id + " in time");
        }
        b.end_object();
        if len(record_remote(root)) == 0 { return fail(no_organism(root)); }
        if !append_as(root, "practice.requested", request_id, b.result(), who) { return fail("the record refused the append"); }
        let s = sync_record(root);
        if !s.ok { return fail(s.summary); }
        return answer("practice " + name + " requested in the record by " + who + " (" + request_id + "); the organization proposes it to the Board when it hears it\n");
    }
    if len(sub) > 0 { return fail(usage); }
    let s = sync_record(root);
    // Governance reads need only Record. The shared projection supplies native
    // identities/state; this legacy CLI retains its existing receipt renderer.
    // Hosted readers use Queries.practice_of's fail-closed visibility instead.
    let q = ops::Queries { j: dna::GitJournal { repo: root } };
    let mut out = "";
    let mut n = 0;
    let mut i = 0;
    while i < q.revision() {
        let e = q.event_at(i);
        if q.practice_event(e) {
            let p = q.practice_metadata(e.entity);
            let state = if p.retired { "retired" } else if p.ratified { "in force" } else if p.declined { "declined" } else { "awaiting the Board (" + p.review_id + ")" };
            let doc = receipt_read(root, ops::raw_digest(p.digest));
            let body = std::json::find_string_field(doc.text, "text");
            let nl = std::str::index_of(body, "\n");
            let by = if len(p.request_id) > 0 { " · proposed by " + p.requester + (if len(p.because) > 0 { " because " + p.because } else { "" }) } else { "" };
            out = out + "  " + p.name + " " + short(p.digest) + " [" + state + "] " + (if nl < 0 { body } else { body[0..nl] }) + by + "\n";
            n = n + 1;
        }
        let pending = q.request_at_seq(i);
        if len(pending.id) > 0 {
            out = out + "  " + pending.name + " [requested by " + pending.requester + ", not yet heard by the organization] " + pending.id + "\n";
            n = n + 1;
        }
        i = i + 1;
    }
    return answer("practices: " + (if n == 0 { "none" } else { to_string(n) }) + "\n" + out);
}

// ---- sync -----------------------------------------------------------

fn sync_verb(root: String) -> Answer {
    let s = sync_record(root);
    if !s.ok { return fail(s.summary); }
    let h = record_head(root);
    if !h.ok { return fail("record " + RECORD_REF + ": " + s.summary + "; its head could not be read after: " + h.why); }
    let n = if h.absent { 0 } else { open_projection(root, ".", "").rows() };
    return answer("record " + RECORD_REF + ": " + s.summary + "; " + to_string(n) + " event(s)\n");
}

// ---- the fleet's deploy row ----------------------------------------

// Fold `.` and `..` out of a path, so a plan's `seed` (relative to the
// plan) and a mutation's seed (relative to the root) compare as the
// same directory.
@unbounded
fn normalize(path: String) -> String {
    let mut out = "";
    let mut rest = path + "/";
    while len(rest) > 0 {
        let sl = std::str::index_of(rest, "/");
        let c = rest[0..sl];
        rest = rest[(sl + 1)..len(rest)];
        if c == "" || c == "." { continue; }
        if c == ".." {
            let last = last_index_of(out, "/");
            out = if last < 0 { "" } else { out[0..last] };
            continue;
        }
        out = out + "/" + c;
    }
    return out;
}

fn plan_dir_of(plan_rel: String) -> String {
    let sl = last_index_of(plan_rel, "/");
    if sl < 0 { return ""; }
    return plan_rel[0..sl];
}

type Deploy {
    ok: Bool = false;
    error: String = "";
    seq: Int = 0;
    revision: String = "";
    touched: String = ""; // space-separated instance ids
}

// The instances a change to `seed` touches: every instance a node
// expresses whose seed is that directory; every one when the seed is "".
@unbounded
fn touched_by(root: String, plan_rel: String, plan: String, seed: String) -> String {
    let plan_dir = plan_dir_of(plan_rel);
    let want = if len(seed) == 0 { "" } else { normalize(root + "/" + seed) };
    let mut out = "";
    let mut it = std::json::array_first(std::json::find_field_raw(plan, "instances"));
    while !it.done {
        let node = std::json::find_string_field(it.element, "node");
        let iseed = std::json::find_string_field(it.element, "seed");
        let id = std::json::find_string_field(it.element, "id");
        if len(node) > 0 {
            let hit = if len(want) == 0 { true } else { len(iseed) > 0 && normalize(root + "/" + plan_dir + "/" + iseed) == want };
            if hit { out = out + (if len(out) > 0 { " " } else { "" }) + id; }
        }
        it = std::json::array_next(it);
    }
    return out;
}

fn touched_json(touched: String) -> String {
    let b = std::json::Builder { };
    b.begin_array();
    let mut rest = touched + " ";
    while len(rest) > 0 {
        let sp = std::str::index_of(rest, " ");
        let w = rest[0..sp];
        rest = rest[(sp + 1)..len(rest)];
        if len(w) > 0 { b.string_value(w); }
    }
    b.end_array();
    return b.result();
}

// Ask the fleet to express `rev`: the revision pushed where every node
// fetches from (`refs/dna/revisions/<rev>`), then one `fleet.deploy` row.
@unbounded
fn fleet_deploy(root: String, fleet: String, plan_rel: String, rev_in: String, seed: String, entity: String, reason: String) -> Deploy {
    let rev = genome_commit(root, rev_in);
    if len(rev) == 0 { return Deploy { error: "no such revision: " + rev_in }; }
    let plan = genome_show(root, rev, plan_rel);
    if len(plan) == 0 { return Deploy { error: "no plan " + plan_rel + " at " + short(rev) }; }
    let touched = touched_by(root, plan_rel, plan, seed);
    let remote = record_remote(root);
    if len(remote) > 0 {
        let r = rec(root);
        if !r.point("revisions/" + rev, rev) { return Deploy { error: "the revision could not be pointed at: " + r.why() }; }
        let t = r.share(remote, "revisions/" + rev, "force");
        if !t.ok { return Deploy { error: if len(t.why) == 0 { "push failed" } else { t.why } }; }
    }
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("plan", fleet);
    b.string_field("revision", rev);
    b.string_field("seed", seed);
    b.field("touched", touched_json(touched));
    b.string_field("reason", reason);
    b.end_object();
    if !append_as(root, "fleet.deploy", entity, b.result(), "") { return Deploy { error: "the record refused the append" }; }
    let s = sync_record(root);
    let p = open_projection(root, ".", "");
    let mut seq = 0;
    let mut i = p.rows() - 1;
    while i >= 0 && seq == 0 {
        let e = p.row(i);
        if e.kind == "fleet.deploy" && e.entity == entity { seq = e.seq; }
        i = i - 1;
    }
    return Deploy { ok: true, seq: seq, revision: rev, touched: touched };
}

fn base_of(p: Projection, id: String) -> String {
    let r = p.review_of(id);
    return r.base_commit;
}

fn deploy_verb(root: String, fleet: String, plan_rel: String, what: String, rollback: Bool) -> Answer {
    let verb = if rollback { "rollback" } else { "deploy" };
    if len(what) == 0 { return fail("usage: hale dna " + verb + " <" + (if rollback { "mutation id" } else { "revision" }) + ">"); }
    let s0 = sync_record(root);
    if len(fleet) == 0 { return fail("no `[dna] fleet = \"<name>\"` in hale.toml: the DNA expresses no fleet here"); }
    let mut rev = what;
    let mut entity = "";
    let mut reason = "deploy by operator";
    if rollback {
        let no_head = record_refusal(root);
        if len(no_head) > 0 { return fail(no_head); }
        let base = base_of(open_projection(root, ".", ""), what);
        if len(base) == 0 { return fail(what + ": no Review in the record names its base"); }
        rev = base;
        entity = what;
        reason = "rollback " + what + " by operator";
    } else {
        let full = genome_commit(root, what);
        if len(full) == 0 { return fail("no such revision: " + what); }
        rev = full;
        entity = short(full);
    }
    let d = fleet_deploy(root, fleet, plan_rel, rev, "", entity, reason);
    if !d.ok { return fail(d.error); }
    return answer("fleet.deploy #" + to_string(d.seq) + ": " + fleet + " at " + short(d.revision) + " touching " + (if len(d.touched) == 0 { "no instance (none has a node)" } else { d.touched }) + "\n");
}

// ---- the forge as a membrane (GH #648) -----------------------------------
//
// One pass, written against `dna::Forge` and nothing of GitHub's: every
// pending mutation Review without a review at the forge gets one; every
// verdict the forge reports becomes a `review.verdict` row in the
// reviewer's name, once each (keyed by the forge's own key); every
// settled Review with a review at the forge gets the outcome as a
// comment, and an approval pushes the genome. The forge is a projection
// of the record, never the record. The rows are `github.pr` and
// `github.commented` still: a reader that met them before meets them
// now, whichever forge answered.

fn github_repo(root: String) -> String {
    return rec(root).setting("github");
}

// The review opened at the forge for a Review, "" when none.
fn pr_of(p: Projection, id: String) -> String {
    let mut i = p.rows() - 1;
    while i >= 0 {
        let e = p.row(i);
        if e.kind == "github.pr" && e.entity == id { return e.body; }
        i = i - 1;
    }
    return "";
}

fn has_row(p: Projection, kind: String, entity: String, needle: String) -> Bool {
    let mut i = 0;
    while i < p.rows() {
        let e = p.row(i);
        if e.kind == kind && e.entity == entity && (len(needle) == 0 || std::str::contains(e.body, needle)) { return true; }
        i = i + 1;
    }
    return false;
}

@unbounded
fn forge_sync(root: String, seed: String, forge: dna::Forge) -> Answer {
    if !forge.present() { return fail("no forge: " + forge.name()); }
    let board = "," + std::str::replace(rec(root).setting("github.board"), " ", "") + ",";
    let remote_named = record_remote(root);
    let remote = if len(remote_named) == 0 { "origin" } else { remote_named };
    let branch_named = genome_branch(root);
    let branch = if len(branch_named) == 0 { "main" } else { branch_named };
    let mut out = "";
    let p = open_projection(root, seed, "");
    let ids = p.review_ids();
    let n = list_len(ids);
    // 1. out: a review at the forge per pending mutation Review
    let mut i = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        if r.state == "pending" && r.is_mutation && len(pr_of(p, r.id)) == 0 {
            let head = "dna/" + r.id;
            if forge.kind() == "github" {
                let e = genome_push_branch(root, remote, r.candidate_commit, head, true);
                if len(e) > 0 { return fail(e); }
            }
            let body = render_review(p, r.id, false);
            let opened = forge.open_review(if forge.kind() == "github" { head } else { r.candidate_commit }, r.question, body.text);
            if !opened.present { return fail(opened.why); }
            let url = opened.ref;
            let sl = last_index_of(url, "/");
            let number = std::str::parse_int(if sl < 0 { url } else { url[(sl + 1)..len(url)] }) or 0;
            let b = std::json::Builder { };
            b.begin_object();
            b.int_field("number", number);
            b.string_field("url", url);
            b.string_field("head", head);
            b.string_field("candidate", r.candidate_commit);
            b.string_field("forge", forge.kind());
            b.end_object();
            if !append_as(root, "github.pr", r.id, b.result(), "") { return fail("the record refused the append"); }
            out = out + r.id + ": review opened at the forge (" + url + ")\n";
        }
        i = i + 1;
    }
    // 2. in: the forge's verdicts become verdicts here, once each
    i = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        let pr = pr_of(p, r.id);
        if r.state == "pending" && r.is_mutation && len(pr) > 0 {
            let ref = std::json::find_string_field(pr, "url");
            let number = to_string(std::json::find_int_field(pr, "number"));
            let mut rest = forge.verdicts(ref);
            while len(rest) > 0 {
                let nl = std::str::index_of(rest, "\n");
                let line = if nl < 0 { rest } else { rest[0..nl] };
                rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
                if len(line) == 0 { continue; }
                let login = tab_field(line, 0);
                let verdict = tab_field(line, 1);
                let oid = tab_field(line, 2);
                let key = tab_field(line, 3);
                if login == "error" { return fail("the forge did not answer: " + verdict); }
                if len(verdict) == 0 { continue; }
                let q = open_projection(root, seed, "");
                if !has_row(q, "review.verdict", r.id, "\"github\": \"" + key + "\"") {
                    let authority = if std::str::contains(board, "," + login + ",") { "board" } else { "reviewer" };
                    let b = std::json::Builder { };
                    b.begin_object();
                    b.string_field("review_id", r.id);
                    b.string_field("subject_digest", oid);
                    b.string_field("verdict", verdict);
                    b.string_field("reviewer", login);
                    b.string_field("authority", authority);
                    b.string_field("comment", forge.kind() + " review #" + number);
                    b.string_field("github", key);
                    b.end_object();
                    if !append_as(root, "review.verdict", r.id, b.result(), "") { return fail("the record refused the append"); }
                    out = out + r.id + ": " + verdict + " by " + login + " (" + authority + ") from the forge's review #" + number + "\n";
                }
            }
        }
        i = i + 1;
    }
    // 3. back: settlements as comments; an approval pushes the genome
    i = 0;
    while i < n {
        let r = p.review_of(nth(ids, i));
        let pr = pr_of(p, r.id);
        if r.state == "settled" && r.is_mutation && len(pr) > 0 && !has_row(p, "github.commented", r.id, "") {
            let ref = std::json::find_string_field(pr, "url");
            let number = to_string(std::json::find_int_field(pr, "number"));
            if std::str::starts_with(r.settled, "approve") && forge.kind() == "github" { let pushed = genome_push_branch(root, remote, branch, branch, false); }
            if !forge.comment(ref, "dna: review " + r.id + " settled: " + r.settled) { return fail("the forge did not take the comment"); }
            if !append_as(root, "github.commented", r.id, "#" + number + ": " + r.settled, "") { return fail("the record refused the append"); }
            out = out + r.id + ": the forge's review #" + number + " told: " + r.settled + "\n";
        }
        i = i + 1;
    }
    return answer(out);
}

// The n-th tab-separated field of a line.
fn tab_field(line: String, n: Int) -> String {
    let mut rest = line;
    let mut i = 0;
    while i < n {
        let t = std::str::index_of(rest, "\t");
        if t < 0 { return ""; }
        rest = rest[(t + 1)..len(rest)];
        i = i + 1;
    }
    let t = std::str::index_of(rest, "\t");
    return if t < 0 { rest } else { rest[0..t] };
}

// The forge the record's configuration names, as `dna::Forge`.
// (each forge is bound to a local before it is handed to the interface
// parameter: constructed inline as the argument it reaches the callee
// unborn)
fn github_sync(root: String, seed: String) -> Answer {
    let k = forge_kind(root);
    if k == "github" {
        let branch = genome_branch(root);
        let gh_forge = GitHubForge { repo: github_repo(root), base: (if len(branch) == 0 { "main" } else { branch }) };
        return forge_sync(root, seed, gh_forge);
    }
    if k == "file" {
        let forge_dir = root + "/.hale/dna/forge";
        let file_forge = FileForge { dir: forge_dir };
        return forge_sync(root, seed, file_forge);
    }
    let none = dna::NoForge { };
    return forge_sync(root, seed, none);
}

fn github_verb(root: String, seed: String, sub: String) -> Answer {
    if sub != "sync" { return fail("usage: hale dna github sync"); }
    let s0 = sync_record(root);
    let a = github_sync(root, seed);
    if !a.ok { return a; }
    let s1 = sync_record(root);
    if len(a.text) == 0 { return answer("github: nothing to mirror\n"); }
    return a;
}
