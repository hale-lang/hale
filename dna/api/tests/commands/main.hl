// Scripted adapter/browser conformance only. This is NOT durable native command
// admission or recovery and MUST NOT be composed into a production head.
import "../.." as api;
import "../../../core" as dna;
import "../../../operations" as ops;

const SCRIPTED_CANDIDATE: String = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";

locus ScriptedCommands {
    params {
        root: String = "";
        mode: String = "recorded";
        available: Bool = true;
        authorized: Bool = true;
        practice_supported: Bool = true;
        review_supported: Bool = true;
        practice_authorized: Bool = true;
        review_authorized: Bool = true;
        capability_calls: Int = 0;
        submit_calls: Int = 0;
        lookup_calls: Int = 0;
        last_context: api::CommandContext = api::CommandContext { };
        last_command: api::CommandRequest = api::CommandRequest { };
        saved_context: api::CommandContext = api::CommandContext { };
        saved_command: api::CommandRequest = api::CommandRequest { };
        result_head: String = "";
    }
    fn supported(operation: String, version: String) -> Bool {
        return version == "1" && ((operation == "dna.practice.propose" && self.practice_supported) || (operation == "dna.review.verdict" && self.review_supported));
    }
    fn current_mode() -> String {
        let mode = if len(self.root) > 0 { std::io::fs::read_file(self.root + "/command-mode") or self.mode } else { self.mode };
        return std::str::trim(mode);
    }
    fn capability(context: api::CommandContext, operation: String, version: String) -> api::CommandCapability {
        self.capability_calls = self.capability_calls + 1;
        let mode = self.current_mode();
        return api::CommandCapability { available: self.available && mode != "unavailable", authorized: self.authorized && (if operation == "dna.review.verdict" { self.review_authorized } else { self.practice_authorized }) && mode != "forbidden", reason: "Scripted adapter conformance provider; native durability is not implemented." };
    }
    fn result(context: api::CommandContext, command: api::CommandRequest) -> api::CommandResult {
        let mode = self.current_mode();
        if mode == "forbidden" || mode == "stale_subject" || mode == "request_conflict" || mode == "command_not_found" { return api::CommandResult { code: mode }; }
        if mode == "unavailable" || mode == "lookup_unavailable" { return api::CommandResult { }; }
        if command.operation == "dna.review.verdict" { return self.verdict_result(context, command, mode); }
        let created = mode == "succeeded" || mode == "approve_pending" || mode == "adopted" || mode == "activation_refused";
        let approved = mode == "approve_pending" || mode == "adopted" || mode == "activation_refused";
        let receipt = api::CommandReceipt {
            command_id: "scripted:" + command.request_id, request_id: command.request_id,
            application_id: if mode == "malformed" { "another-application" } else { context.source.identity },
            principal_mode: context.principal_mode, principal_name: context.principal_name,
            target_id: command.target_id, subject_digest: command.subject_digest,
            fingerprint: self.fingerprint(command),
            state: if created { "succeeded" } else if mode == "refused" { "refused" } else if mode == "outcome_unknown" { "outcome_unknown" } else { "recorded" },
            reason: if mode == "refused" { "Scripted domain refusal." } else { "" },
            proposal_state: if created { "created" } else if mode == "refused" { "refused" } else { "pending" },
            candidate_digest: if created { SCRIPTED_CANDIDATE } else { "" },
            review_id: if created { "org/reviews/scripted-candidate" } else { "" },
            review_state: if approved { "settled" } else if created { "pending" } else { "unavailable" },
            review_subject_digest: if created { SCRIPTED_CANDIDATE } else { "" },
            review_outcome: if approved { "approve" } else { "" },
            activation_state: if mode == "adopted" { "adopted" } else if mode == "activation_refused" { "refused" } else if created { "pending" } else { "unknown" }
        };
        let mut source = context.source;
        if len(self.result_head) > 0 { source.head = self.result_head; source.revision = source.revision + 1; }
        return api::CommandResult { ok: true, source: source, receipt: receipt };
    }
    fn fingerprint(command: api::CommandRequest) -> String {
        let b = std::json::Builder { }; b.begin_object();
        b.string_field("operation", command.operation); b.string_field("version", command.operation_version);
        b.string_field("target", command.target_id); b.string_field("subject", command.subject_digest);
        b.string_field("text", command.text); b.string_field("rationale", command.rationale);
        b.string_field("verdict", command.verdict); b.string_field("comment", command.comment);
        b.end_object(); return dna::digest_of(b.result());
    }
    fn verdict_result(context: api::CommandContext, command: api::CommandRequest, mode: String) -> api::CommandResult {
        let accepted = mode == "succeeded" || mode == "verdict_pending" || mode == "verdict_settled" || mode == "approve_pending" || mode == "activation_refused" || mode == "adopted";
        let other_adoption = mode == "verdict_refused_after_adoption";
        let refused = mode == "refused" || other_adoption;
        let settled = other_adoption || mode == "verdict_settled" || mode == "approve_pending" || mode == "activation_refused" || mode == "adopted";
        let outcome = if other_adoption { "approve" } else if settled { command.verdict } else { "" };
        let receipt = api::CommandReceipt {
            command_id: "scripted:" + command.request_id, request_id: command.request_id,
            application_id: if mode == "malformed" { "another-application" } else { context.source.identity },
            operation: command.operation, operation_version: command.operation_version,
            principal_mode: context.principal_mode, principal_name: context.principal_name,
            target_kind: "dna.review", target_id: command.target_id, subject_digest: command.subject_digest,
            fingerprint: self.fingerprint(command),
            state: if accepted { "succeeded" } else if refused { "refused" } else if mode == "outcome_unknown" { "outcome_unknown" } else { "recorded" },
            reason: if refused { "Scripted verdict refusal." } else { "" },
            proposal_state: "", verdict_value: command.verdict,
            verdict_state: if accepted { "accepted" } else if refused { "refused" } else { "pending" },
            review_state: if settled { "settled" } else { "pending" },
            review_subject_digest: command.subject_digest, review_outcome: outcome,
            activation_state: if other_adoption || (mode == "adopted" && outcome == "approve") { "adopted" } else if mode == "activation_refused" && outcome == "approve" { "refused" } else if mode == "approve_pending" && outcome == "approve" { "pending" } else { "unknown" }
        };
        let mut source = context.source;
        if len(self.result_head) > 0 { source.head = self.result_head; source.revision = source.revision + 1; }
        return api::CommandResult { ok: true, source: source, receipt: receipt };
    }
    fn submit(context: api::CommandContext, command: api::CommandRequest) -> api::CommandResult {
        self.submit_calls = self.submit_calls + 1; self.last_context = context; self.last_command = command;
        if !self.authorized || (command.operation == "dna.review.verdict" && !self.review_authorized) || (command.operation == "dna.practice.propose" && !self.practice_authorized) { return api::CommandResult { code: "forbidden" }; }
        // Deliberately bounded, process-local conformance state, not a durable
        // registry. The retained key shares one namespace across operations.
        if command.request_id == self.saved_command.request_id && context.source.identity == self.saved_context.source.identity && context.principal_mode == self.saved_context.principal_mode && context.principal_name == self.saved_context.principal_name && command.operation != self.saved_command.operation { return api::CommandResult { code: "request_conflict" }; }
        let mode = self.current_mode();
        if mode == "forbidden" || mode == "stale_subject" || mode == "request_conflict" || mode == "unavailable" { return api::CommandResult { code: if mode == "unavailable" { "commands_unavailable" } else { mode } }; }
        self.saved_context = context; self.saved_command = command;
        return self.result(context, command);
    }
    fn lookup(context: api::CommandContext, request_id: String) -> api::CommandResult {
        self.lookup_calls = self.lookup_calls + 1; self.last_context = context;
        if request_id != self.saved_command.request_id || context.source.identity != self.saved_context.source.identity || context.principal_name != self.saved_context.principal_name || context.principal_mode != self.saved_context.principal_mode { return api::CommandResult { code: "command_not_found" }; }
        return self.result(context, self.saved_command);
    }
}

fn main() {
    if std::env::var("HALE_COCKPIT_SCRIPTED_COMMANDS") != "1" {
        eprintln("scripted command fixture requires HALE_COCKPIT_SCRIPTED_COMMANDS=1; adapter conformance only");
        std::process::exit(2);
    }
    let root = std::env::arg(1);
    let port = std::str::parse_int(std::env::arg(2)) or 0;
    let web = api::WebAssets { };
    std::test::assert(web.load(std::env::arg(3)), "fixture web assets");
    // Retain the mutable provider for the complete HTTP server lifetime.
    let commands = ScriptedCommands { root: root };
    api::serve_with_commands(root, port, web, ops::NoWorkflowCatalog { }, commands);
}
