// dna/tests/rehydrate_work_test.hl — GH #604 rules 1 and 2: the record
// holds a Task's birth before anything runs, and a Task born and not
// settled re-enters the tower after a restart from its last durable
// state — under the plan in the record when there is one (never
// replanned), planned for the first time when there is none. An
// intent offered before a restart with no birth is noted, not
// re-offered; a Mutation in flight fails and settles its Task; a
// handed Task is a person's and waits. Here the record is written by
// hand into the shapes a stopped organism leaves, and one Dna is born
// over it.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn sh(argv: String) -> dna::RunResult { return dna::run_tool(argv); }

const APP: String = "fn main() { println(\"app\"); }\n";
const DOCUMENTED: String = "// documented after a restart\nfn main() { println(\"app\"); }\n";
const PLAN: String = "{\"kind\": \"appendage\", \"change_class\": \"docs\", \"class_applied\": \"docs\", \"target\": \"main.hl\", \"count\": 1, \"narrative\": \"planned before the stop\", \"package\": \"\", \"by\": \"leader\", \"parsed\": true}";

main locus App {
    params {
        repo: String = "";
        j: dna::GitJournal = dna::GitJournal { };
        one: dna::Dna = dna::Dna { };
        lead: dna::Leader = dna::Leader {
            name: "leader", org: "rw", charter: "You are the architect.",
            models: dna::ModelRouter {
                quick: dna::FakeModel { name: "quick", answer: "kind: appendage\nclass: docs\ntarget: main.hl\ncount: 1\nplanned after the restart" },
                deep: dna::FakeModel { name: "deep", answer: "kind: appendage\nclass: docs\ntarget: main.hl\ncount: 1\nplanned after the restart" }
            }
        };
    }
    @unbounded
    fn rows(kind: String, entity: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && (len(entity) == 0 || e.entity == entity) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn seq_of(kind: String, entity: String) -> Int {
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && e.entity == entity { return e.seq; }
            i = i + 1;
        }
        return -1;
    }
    @unbounded
    fn body_of(kind: String, entity: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.one.journal.revision() {
            let e = self.one.journal.read(i);
            if e.kind == kind && e.entity == entity { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    fn put(kind: String, entity: String, body: String) {
        let r = self.j.append(self.j.revision(), kind, entity, body);
        std::test::assert(r.ok, "seeded " + kind + " " + entity);
    }
    run() {
        let repo = "/tmp/dna-rw-" + to_string(std::process::pid());
        self.repo = repo;
        std::io::fs::mkdir(repo) or discard;
        std::io::fs::mkdir(repo + "/app") or discard;
        std::io::fs::mkdir(repo + "/.hale") or discard;
        std::io::fs::mkdir(repo + "/.hale/dna") or discard;
        std::io::fs::write_file(repo + "/hale.toml", "[deps]\n") or discard;
        std::io::fs::write_file(repo + "/app/main.hl", APP) or discard;
        std::io::fs::write_file(repo + "/.gitignore", "/.hale/\n") or discard;
        let init = sh("git\n-C\n" + repo + "\ninit\n-q\n-b\nmain");
        let add = sh("git\n-C\n" + repo + "\nadd\n-A");
        let c0 = sh("git\n-C\n" + repo + "\n-c\nuser.name=t\n-c\nuser.email=t@local\ncommit\n-q\n-m\nbase");
        std::test::assert_eq_int(c0.code, 0, "base commit: " + c0.stderr);
        // ---- the record a stopped organism left behind
        self.j = dna::GitJournal { repo: repo, author: "dna" };
        // t1: born, pending, planned — stopped before the editor ran
        self.put("intent.offered", "i1", "document main.hl");
        self.put("task.born", "t1", "i1: document main.hl");
        self.put("task.pending", "t1", "routed");
        self.put("task.planned", "t1", PLAN);
        // t2: born, pending, never planned
        self.put("intent.offered", "i2", "document main.hl again");
        self.put("task.born", "t2", "i2: document main.hl again");
        self.put("task.pending", "t2", "routed");
        // i9: offered, no birth — the shape from before rule 1
        self.put("intent.offered", "i9", "lost before its birth");
        // t3: born, planned, its Mutation m1 proposed and in flight
        self.put("intent.offered", "i3", "a third");
        self.put("task.born", "t3", "i3: a third");
        self.put("task.pending", "t3", "routed");
        self.put("task.planned", "t3", PLAN);
        self.put("mutation.proposed", "m1", "task t3 docs: a third () at 0000000000000000000000000000000000000000");
        // t4: born and handed to a person
        self.put("intent.offered", "i4", "file the receipts");
        self.put("task.born", "t4", "i4: file the receipts");
        self.put("task.pending", "t4", "routed");
        self.put("task.handed", "t4", "w by leader: handed: not a software change");

        // t6: resumed after an earlier restart, which stopped before it dispatched
        self.put("intent.offered", "i6", "document main.hl a fourth time");
        self.put("task.born", "t6", "i6: document main.hl a fourth time");
        self.put("task.pending", "t6", "routed");
        self.put("task.planned", "t6", PLAN);
        self.put("task.resumed", "t6", "after a restart, under the plan in the record; not replanned");
        // t7: resumed after an earlier restart, its Mutation m7 then in flight
        self.put("intent.offered", "i7", "a seventh");
        self.put("task.born", "t7", "i7: a seventh");
        self.put("task.pending", "t7", "routed");
        self.put("task.planned", "t7", PLAN);
        self.put("task.resumed", "t7", "after a restart, under the plan in the record; not replanned");
        self.put("mutation.proposed", "m7", "task t7 docs: a seventh () at 0000000000000000000000000000000000000000");
        // t8: born and planned, stopped before its `task.pending`, its Mutation m8 then in flight
        self.put("intent.offered", "i8", "an eighth");
        self.put("task.born", "t8", "i8: an eighth");
        self.put("task.planned", "t8", PLAN);
        self.put("mutation.proposed", "m8", "task t8 docs: an eighth () at 0000000000000000000000000000000000000000");
        // t10: born, stopped before its `task.pending` and before any plan
        self.put("intent.offered", "i10", "a tenth");
        self.put("task.born", "t10", "i10: a tenth");

        // ---- one organism is born over it
        self.one = dna::Dna {
            journal: dna::GitJournal { repo: repo },
            gateway: dna::MutationGateway {
                workspaces: dna::IsolatedWorktrees { repo: repo, root: repo + "/.hale/dna/worktrees" },
                repo: dna::LocalGit { repo: repo }
            },
            verification: dna::HaleVerification { hale_bin: toolchain(), receipts: dna::GitReceipts { repo: repo }, scratch: repo + "/.hale/dna/scratch", repo: repo },
            editor: dna::SourceEditor {
                models: dna::ModelRouter {
                    quick: dna::FakeModel { name: "quick", answer: DOCUMENTED, answer_role: "edit" },
                    deep: dna::FakeModel { name: "deep", answer: "clarity +" }
                },
                tools: dna::WorktreeTools { hale_bin: toolchain() }
            },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "docs refactor", max_magnitude: 8, review: "pre" } },
            genome_seed: "app", org_seed: "org", planned: true, org_id: "rw"
        };
        std::time::sleep(2500ms);

        // t1 resumed under its plan: no replanning, the editor ran
        std::test::assert(std::str::contains(self.body_of("task.resumed", "t1"), "not replanned"), "t1 resumed under the plan in the record: " + self.body_of("task.resumed", "t1"));
        std::test::assert_eq_int(self.rows("model.called", "t1/plan"), 0, "t1 was not planned again");
        std::test::assert_eq_int(self.rows("task.planned", "t1"), 1, "one plan for t1, the one in the record");
        std::test::assert(self.rows("mutation.proposed", "") >= 3, "t1 and t2 proposed their Mutations after the restart");
        // t2 planned for the first time
        std::test::assert(std::str::contains(self.body_of("task.resumed", "t2"), "planned now"), "t2 planned after the restart: " + self.body_of("task.resumed", "t2"));
        std::test::assert_eq_int(self.rows("model.called", "t2/plan"), 1, "t2's plan was made once");
        std::test::assert_eq_int(self.rows("task.planned", "t2"), 1, "and journaled");
        // i9 noted, never re-offered
        std::test::assert_eq_int(self.rows("intent.unrecovered", "i9"), 1, "i9 is noted as unrecovered");
        std::test::assert_eq_int(self.rows("task.born", ""), 8, "no Task was born by the restart itself");
        // a Task resumed before is resumed again, and a resumed Task still settles
        std::test::assert(std::str::contains(self.body_of("task.failed", "t7"), "in flight"), "t7, resumed and then in flight, settles failed: " + self.body_of("task.failed", "t7"));
        std::test::assert_eq_int(self.rows("task.resumed", "t6"), 2, "t6, stopped after its earlier resume, is resumed again");
        // a Task born and never pending is pending after the restart, and settles
        std::test::assert_eq_int(self.rows("task.pending", "t8"), 1, "t8, born and never pending, is pending after the restart");
        std::test::assert(std::str::contains(self.body_of("task.failed", "t8"), "in flight"), "t8's in-flight Mutation settles it: " + self.body_of("task.failed", "t8"));
        std::test::assert_eq_int(self.rows("task.pending", "t10"), 1, "t10, born and never pending, is pending after the restart");
        std::test::assert(std::str::contains(self.body_of("task.resumed", "t10"), "planned now"), "and resumed: " + self.body_of("task.resumed", "t10"));
        // t3's in-flight Mutation failed and settled its Task; it did not resume
        std::test::assert_eq_int(self.rows("mutation.failed", "m1"), 1, "m1 failed in flight");
        std::test::assert(std::str::contains(self.body_of("task.failed", "t3"), "in flight"), "t3 settled failed: " + self.body_of("task.failed", "t3"));
        std::test::assert_eq_int(self.rows("task.resumed", "t3"), 0, "t3 was not resumed");
        // t4 waits for its person
        std::test::assert_eq_int(self.rows("task.resumed", "t4"), 0, "a handed Task is not the organism's to resume");
        std::test::assert_eq_str(self.one.task_state("t4"), "handed", "and is still handed");

        // ---- rule 1 on a live ask: the birth is in the record before anything runs
        let t5 = self.one.ask(dna::Intent { id: "i5", outcome: "document main.hl once more", from: "riley" }, dna::Knobs { routed: true, requires: "edit" });
        std::time::sleep(1500ms);
        let born = self.seq_of("task.born", t5);
        let planned = self.seq_of("task.planned", t5);
        std::test::assert(born >= 0 && planned > born, "the birth precedes the plan in the record");
        let rm = sh("rm\n-rf\n" + repo);
    }
}
fn main() { App { }; }
