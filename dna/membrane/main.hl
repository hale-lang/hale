// dna/membrane — the membrane client: publishes ONE typed fact on the
// organism's control topics and exits (GH #528 `hale dna ask`).
//
//   membrane intent  '{"intent_id": "...", "outcome": "...", "from": "...", "to": "..."}'
//   membrane verdict '{"review_id": "...", "subject_digest": "...", "verdict": "...", "reviewer": "...", "authority": "...", "comment": "..."}'
//   membrane observed '{"mutation_id": "...", "outcome": "healthy|crashed|build_failed", "model_hash": "...", "detail": "..."}'
//   membrane pressure '{"source": "...", "what": "...", "count": 1}'
//
// `hale dna` execs it with LOTUS_BUS_CONFIG routing the two topics to
// the organism's listen sockets. The organism decides; this program
// only carries the fact — the same declarations the organism binds,
// imported from the core.

import "../core" as dna;

main locus Client {
    params {
        kind: String = "";
        body: String = "";
    }
    bus {
        publish dna::IntentOffered;
        publish dna::ReviewVerdict;
        publish dna::ExpressionObserved;
        publish dna::PressureRaised;
        publish dna::ConcernRaised;
        publish dna::PracticeRequested;
        publish dna::KnowledgeNodeRequested;
        publish dna::KnowledgeBindingRequested;
        publish dna::KnowledgeEdgeRequested;
    }
    run() {
        if self.kind == "intent" {
            dna::IntentOffered <- dna::IntentOffer {
                intent_id: std::json::find_string_field(self.body, "intent_id"),
                outcome: std::json::find_string_field(self.body, "outcome"),
                from: std::json::find_string_field(self.body, "from"),
                to: std::json::find_string_field(self.body, "to")
            };
        } else if self.kind == "verdict" {
            dna::ReviewVerdict <- dna::Verdict {
                command_id: dna::native_json_string(self.body, "command_id"),
                review_id: dna::native_json_string(self.body, "review_id"),
                subject_digest: dna::native_json_string(self.body, "subject_digest"),
                verdict: dna::native_json_string(self.body, "verdict"),
                reviewer: dna::native_json_string(self.body, "reviewer"),
                authority: dna::native_json_string(self.body, "authority"),
                comment: dna::native_json_string(self.body, "comment")
            };
        } else if self.kind == "observed" {
            dna::ExpressionObserved <- dna::Observation {
                mutation_id: std::json::find_string_field(self.body, "mutation_id"),
                outcome: std::json::find_string_field(self.body, "outcome"),
                model_hash: std::json::find_string_field(self.body, "model_hash"),
                detail: std::json::find_string_field(self.body, "detail")
            };
        } else if self.kind == "pressure" {
            dna::PressureRaised <- dna::Pressure {
                source: std::json::find_string_field(self.body, "source"),
                what: std::json::find_string_field(self.body, "what"),
                count: std::json::find_int_field(self.body, "count")
            };
        } else if self.kind == "concern" {
            dna::ConcernRaised <- dna::Concern {
                source: std::json::find_string_field(self.body, "source"),
                what: std::json::find_string_field(self.body, "what"),
                severity: std::json::find_int_field(self.body, "severity"),
                request: std::json::find_string_field(self.body, "request")
            };
        } else if self.kind == "practice" {
            dna::PracticeRequested <- dna::PracticeRequest {
                request_id: dna::native_json_string(self.body, "request_id"),
                name: dna::native_json_string(self.body, "name"),
                text: dna::native_json_string(self.body, "text"),
                by: dna::native_json_string(self.body, "by"),
                because: dna::native_json_string(self.body, "because"),
                supersedes: dna::native_json_string(self.body, "supersedes")
            };
        } else if self.kind == "knowledge-node" {
            let codec = dna::KnowledgeNodeRequestCodec { };
            let request = codec.decode(self.body);
            if !codec.valid(request) { println("membrane: invalid knowledge-node request"); return; }
            dna::KnowledgeNodeRequested <- request;
        } else if self.kind == "knowledge-binding" {
            let codec = dna::KnowledgeBindingCodec { }; let request = codec.decode(self.body);
            if !codec.valid(request) { println("membrane: invalid knowledge-binding request"); return; }
            dna::KnowledgeBindingRequested <- request;
        } else if self.kind == "knowledge-edge" {
            let codec = dna::KnowledgeEdgeCodec { }; let request = codec.decode(self.body);
            if !codec.valid(request) { println("membrane: invalid knowledge-edge request"); return; }
            dna::KnowledgeEdgeRequested <- request;
        } else {
            println("membrane: unknown kind `", self.kind, "` (intent | verdict | observed | pressure | concern | practice | knowledge-node | knowledge-binding | knowledge-edge)");
            return;
        }
        // let the connect-role fanout flush before the process ends
        std::time::sleep(300ms);
        println("membrane: published ", self.kind);
    }
}

fn main() {
    Client { kind: std::env::arg_or(1, ""), body: std::env::arg_or(2, "") };
}
