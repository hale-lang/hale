// Decision line 19, a parked started coroutine (Cancellation, Run).
// Inventory row R20a, shipped in the trace build.
//
// `srv` is an async_io listener nobody connects to, so its run() is a
// started coroutine parked in accept() when the pools are joined. The
// worker abandons it: its stack is freed without resuming it, and its
// run end never runs. That is a cancellation after start; the worker's
// quiescence is the pool join's completion, witnessed separately.
//
// Expected terminal outcome: the run ends in a named
// `canceled-after-start`, which the trace build (L2) records where the
// worker frees the coroutine, and the listener is torn down once,
// judged by the harness from the trace: `named:canceled-after-start`.

fn noop(s: std::io::tcp::Stream) { }

main locus App {
    params {
        srv: std::io::tcp::Listener = std::io::tcp::Listener {
            host: "127.0.0.1",
            port: 0,
            max_accepts: 1,
            on_connection: noop,
        };
    }
    placement { srv: cooperative(pool = io) where async_io; }
    run() { std::time::sleep(100ms); }
}

fn main() { App { }; }
