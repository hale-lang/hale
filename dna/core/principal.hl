// dna/core/principal.hl — the principal source (GH #612).
//
// Who acts where a verdict, an intent or a task completion enters. Two
// sources: `local` — the operator of this clone, as `--as` and the git
// identity have always said — and `oidc` — an identity provider, whose
// subject is the stable identity (never an email alone), mapped to a
// member name by a reviewed mapping, `git config dna.oidc.member
// "<subject>=<name>"`, the shape `dna.github.board` has. The hosted head
// (`hale dna ui` under `oidc`) resolves the principal and passes it on;
// it never acts in its own name.
//
// The flow is OpenID Connect's authorization code, and a caller that is
// not a browser presents its ID token as a bearer (GH #989). Either way the
// token is verified here: its ES256 signature against a key of the
// issuer's JWKS, which the head reads with the discovery document once, at
// start (`jwks_keys`, `es256_refusal`) — an RS256 token is refused, since
// the standard library verifies ES256 only — then the issuer, the audience,
// the expiry, and for a sign-in its nonce.

type IdClaims {
    present: Bool = false;
    iss: String = "";
    aud: String = ""; // as the token carries it: a string, or a JSON array
    sub: String = "";
    email: String = "";
    nonce: String = "";
    exp: Int = 0;
}

// GH #989: a head's principal path is the only way in. Trusted-local —
// a session under the head's own identity (the launch token, `hale dna
// ui`'s operator) — is a fixture's mode alone: served only where
// HALE_DNA_TRUSTED_LOCAL=1, which a fixture sets; a project serves its
// heads under OIDC.
fn trusted_local_fixture() -> Bool { return std::env::var("HALE_DNA_TRUSTED_LOCAL") == "1"; }
const TRUSTED_LOCAL_REFUSED: String = "trusted-local is a fixture's mode (HALE_DNA_TRUSTED_LOCAL=1); a project serves its head under OIDC: `git config dna.principal oidc` with dna.oidc.issuer, dna.oidc.client and dna.oidc.member (dna/face/start.sh sets them up with the stub provider, dna/oidc)";

// A base64url part of a JWT (no padding, `-` and `_` for `+` and `/`) as text.
fn b64url_text(s: String) -> String {
    let mut t = std::str::replace(std::str::replace(s, "-", "+"), "_", "/");
    while len(t) % 4 != 0 { t = t + "="; }
    return std::str::from_bytes(std::text::base64::decode(t));
}

// A base64url part as bytes.
fn b64url_bytes(s: String) -> Bytes {
    let mut t = std::str::replace(std::str::replace(s, "-", "+"), "_", "/");
    while len(t) % 4 != 0 { t = t + "="; }
    return std::text::base64::decode(t);
}

// The DER of a P-256 public key up to its point: SubjectPublicKeyInfo,
// id-ecPublicKey, prime256v1, and the uncompressed point's 0x04.
const P256_SPKI_PREFIX: String = "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE";

// The signing keys of a JWKS document, `kid\t<SubjectPublicKeyInfo,
// base64>` per line: the P-256 keys (`kty` EC, `crv` P-256) meant for
// signatures (no `use`, or `sig`), whose coordinates are 32 bytes each.
@unbounded
fn jwks_keys(doc: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(std::json::find_field_raw(doc, "keys"));
    while !it.done {
        let k = it.element;
        let usage = std::json::find_string_field(k, "use");
        if std::json::find_string_field(k, "kty") == "EC" && std::json::find_string_field(k, "crv") == "P-256" && (len(usage) == 0 || usage == "sig") {
            let x = b64url_bytes(std::json::find_string_field(k, "x"));
            let y = b64url_bytes(std::json::find_string_field(k, "y"));
            if len(x) == 32 && len(y) == 32 {
                let der = std::bytes::concat(std::text::base64::decode(P256_SPKI_PREFIX), std::bytes::concat(x, y));
                out = out + std::json::find_string_field(k, "kid") + "\t" + std::text::base64::encode(der) + "\n";
            }
        }
        it = std::json::array_next(it);
    }
    return out;
}

// A SubjectPublicKeyInfo (base64) as the PEM the verifier reads.
@unbounded
fn spki_pem(b64: String) -> Bytes {
    let mut body = "";
    let mut i = 0;
    while i < len(b64) {
        let end = if i + 64 < len(b64) { i + 64 } else { len(b64) };
        body = body + b64[i..end] + "\n";
        i = end;
    }
    return std::bytes::from_string("-----BEGIN PUBLIC KEY-----\n" + body + "-----END PUBLIC KEY-----\n");
}

// Why a JWT's signature is refused ("" when it verifies): ES256 alone,
// under the key its header names (`kid`) among `keys` (`jwks_keys`), or
// the one key when the header names none and there is one.
@unbounded
fn es256_refusal(jwt: String, keys: String) -> String {
    let a = std::str::index_of(jwt, ".");
    if a < 0 { return "token: not a JWT"; }
    let second = std::str::index_of(jwt[(a + 1)..len(jwt)], ".");
    if second < 0 { return "token: not a JWT"; }
    let b = a + 1 + second;
    let header = b64url_text(jwt[0..a]);
    let alg = std::json::find_string_field(header, "alg");
    if alg != "ES256" { return "algorithm: `" + alg + "` is not ES256"; }
    let kid = std::json::find_string_field(header, "kid");
    let mut spki = "";
    let mut count = 0;
    let mut rest = keys;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let tab = std::str::index_of(line, "\t");
        if tab < 0 { continue; }
        count = count + 1;
        if line[0..tab] == kid { spki = line[(tab + 1)..len(line)]; }
        if len(kid) == 0 && count == 1 { spki = line[(tab + 1)..len(line)]; }
    }
    if len(kid) == 0 && count != 1 { return "key: the token names no key, and the issuer has " + to_string(count); }
    if len(spki) == 0 { return "key: the issuer's JWKS has no signing key `" + kid + "`"; }
    let sig = b64url_bytes(jwt[(b + 1)..len(jwt)]);
    if len(sig) != 64 { return "signature: not an ES256 signature"; }
    if !std::crypto::ecdsa_p256_verify(spki_pem(spki), std::bytes::from_string(jwt[0..b]), sig) { return "signature: does not verify under the issuer's key `" + kid + "`"; }
    return "";
}

// The token of an `Authorization: Bearer <token>` header ("" when none).
fn bearer_token(header: String) -> String {
    let h = std::str::trim(header);
    if !std::str::starts_with(h, "Bearer ") { return ""; }
    return std::str::trim(h[7..len(h)]);
}

// The claims of an ID token (`header.payload.signature`), from its payload.
fn id_token_claims(jwt: String) -> IdClaims {
    let a = std::str::index_of(jwt, ".");
    if a < 0 { return IdClaims { }; }
    let rest = jwt[(a + 1)..len(jwt)];
    let b = std::str::index_of(rest, ".");
    if b < 0 { return IdClaims { }; }
    let payload = std::str::trim(b64url_text(rest[0..b]));
    if !std::str::starts_with(payload, "{") { return IdClaims { }; }
    let aud_raw = std::str::trim(std::json::find_field_raw(payload, "aud"));
    return IdClaims {
        present: true,
        iss: std::json::find_string_field(payload, "iss"),
        aud: if std::str::starts_with(aud_raw, "[") { aud_raw } else { std::json::find_string_field(payload, "aud") },
        sub: std::json::find_string_field(payload, "sub"),
        email: std::json::find_string_field(payload, "email"),
        nonce: std::json::find_string_field(payload, "nonce"),
        exp: std::json::find_int_field(payload, "exp")
    };
}

// Why a token's claims are refused ("" when accepted): the issuer the
// deployment names, this client among the audience, not expired, the
// nonce of the sign-in that asked for it, a subject.
fn claims_refusal(c: IdClaims, issuer: String, client: String, nonce: String, now: Int) -> String {
    let why = bearer_refusal(c, issuer, client, now);
    if len(why) > 0 { return why; }
    if len(nonce) == 0 || c.nonce != nonce { return "nonce: the token does not answer this sign-in"; }
    return "";
}

// Why a bearer's claims are refused ("" when accepted): as a sign-in's,
// without the nonce a caller that did not sign in here has none of.
fn bearer_refusal(c: IdClaims, issuer: String, client: String, now: Int) -> String {
    if !c.present { return "token: not an ID token"; }
    if c.iss != issuer { return "issuer: `" + c.iss + "` is not `" + issuer + "`"; }
    let aud_ok = if std::str::starts_with(c.aud, "[") { std::str::contains(c.aud, "\"" + client + "\"") } else { c.aud == client };
    if !aud_ok { return "audience: the token is not for client `" + client + "`"; }
    if c.exp <= now { return "expired: the token expired at " + to_string(c.exp); }
    if len(c.sub) == 0 { return "subject: none"; }
    return "";
}

// The member a subject maps to, from `subject=name` lines ("" when none).
@unbounded
fn member_of(mapping: String, subject: String) -> String {
    if len(subject) == 0 { return ""; }
    let mut rest = mapping + "\n";
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = std::str::trim(rest[0..nl]);
        rest = rest[(nl + 1)..len(rest)];
        let eq = std::str::index_of(line, "=");
        if eq > 0 && std::str::trim(line[0..eq]) == subject { return std::str::trim(line[(eq + 1)..len(line)]); }
    }
    return "";
}

// An issuer the flow may use: https, or plain http on this machine only
// (an issuer a test serves).
fn issuer_allowed(issuer: String) -> Bool { return endpoint_allowed(issuer); }

// A URL's scheme, host and port, as DNA reads an identity provider's URLs
// (#635): the authority ends at the first `/`, `?` or `#`; a URL with
// userinfo (`user@host`), a non-numeric port or no host reads as no host.
type UrlParts {
    scheme: String = "";
    host: String = "";
    port: String = "";
}

@unbounded
fn url_parts(url: String) -> UrlParts {
    let sep = std::str::index_of(url, "://");
    if sep <= 0 { return UrlParts { }; }
    let scheme = url[0..sep];
    let rest = url[(sep + 3)..len(url)];
    let mut end = len(rest);
    let mut i = 0;
    while i < len(rest) {
        let c = rest[i..(i + 1)];
        if c == "/" || c == "?" || c == "#" {
            end = i;
            i = len(rest);
        } else {
            i = i + 1;
        }
    }
    let authority = rest[0..end];
    if std::str::contains(authority, "@") { return UrlParts { scheme: scheme }; }
    let colon = std::str::index_of(authority, ":");
    let host = if colon < 0 { authority } else { authority[0..colon] };
    let port = if colon < 0 { "" } else { authority[(colon + 1)..len(authority)] };
    let mut k = 0;
    while k < len(port) {
        let d = std::str::byte_at_unchecked(port, k);
        if d < 48 || d > 57 { return UrlParts { scheme: scheme }; }
        k = k + 1;
    }
    return UrlParts { scheme: scheme, host: host, port: port };
}

// Whether a URL may be an identity provider's: https to a host, or plain
// http to this machine exactly (`127.0.0.1` or `localhost`), never by
// prefix.
fn endpoint_allowed(url: String) -> Bool {
    let u = url_parts(url);
    if len(u.host) == 0 { return false; }
    if u.scheme == "https" { return true; }
    return u.scheme == "http" && (u.host == "127.0.0.1" || u.host == "localhost");
}

// The endpoints an issuer's discovery document names, checked before the
// head sends a browser or a code to them (#635): "" when both may be used,
// else why. The ID token is authenticated by TLS to the token endpoint, so
// that endpoint is https unless the issuer itself is on this machine.
fn discovery_refusal(issuer: String, authorize: String, token: String) -> String {
    if len(authorize) == 0 || len(token) == 0 { return "it names no authorization_endpoint or token_endpoint"; }
    let local = url_parts(issuer).scheme == "http";
    if !endpoint_allowed(authorize) || (!local && url_parts(authorize).scheme != "https") { return "authorization_endpoint `" + authorize + "` is not https"; }
    if !endpoint_allowed(token) || (!local && url_parts(token).scheme != "https") { return "token_endpoint `" + token + "` is not https"; }
    return "";
}

// The value of cookie `name` in a Cookie header ("" when absent).
@unbounded
fn cookie_value(header: String, name: String) -> String {
    let mut rest = header + ";";
    while len(rest) > 0 {
        let sc = std::str::index_of(rest, ";");
        let part = std::str::trim(rest[0..sc]);
        rest = rest[(sc + 1)..len(rest)];
        if std::str::starts_with(part, name + "=") { return part[(len(name) + 1)..len(part)]; }
    }
    return "";
}

// A header of a client response by name, case-insensitively.
// (`std::http::header` takes a Request or a Response, not a ClientResponse.)
@unbounded
fn response_header(headers: String, name: String) -> String {
    let want = std::str::lower(name) + ":";
    let mut rest = headers + "\r\n";
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\r\n");
        if nl < 0 { break; }
        let line = rest[0..nl];
        rest = rest[(nl + 2)..len(rest)];
        if std::str::starts_with(std::str::lower(line), want) { return std::str::trim(line[len(want)..len(line)]); }
    }
    return "";
}
