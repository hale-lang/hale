// The consumer fixture of the API surface contract (GH #1417; the
// contract is spec/api.md, the plan's § 3 program). The documents
// beside this file were made by hand from it: what a client reads
// (the per-exposure descriptions, the program-wide inventory), what
// crosses each transport (wire/), and the digest worked byte for byte
// (digest.md). They are the handoff consumers build against before
// any transport ships.
//
// This file is written in spec/api.md's syntax: `api` blocks, `rpc`
// rows with `requires:`, `api::serve(…)` sites, transport instances and
// a topic bound to a hub with `requires:`. From R1 it parses and checks,
// and `hale check --api` prints its inventory and descriptions from its
// rows (crates/hale-cli/tests/api_contract_fixtures.rs holds them to the
// documents beside it); it builds, its serve sites and its hub being served
// (R2, R3, R5), and crates/hale-codegen/tests/api_witness_whole.rs runs it
// whole. No other gate reads this directory: the
// corpus (hale-corpus), the examples sweep and the in-language suite
// (`tests/hale`) each walk directories of their own.
//
// What it exercises (spec/api.md § The witness): two surfaces sharing
// `Orders::cancel` under different `requires`; `Public` over HTTP
// twice, under two role sources and bound to two `Orders` instances,
// and `Admin` over the Unix socket under a third, its operator a Unix
// peer (`uid:1000`); one fallible rpc (`Orders::cancel`, the handler
// error); two rpcs that violate on a structural limit (`Orders::place`,
// `Ledger::rebalance`), each `fallible(ClosureViolation)` as F.42 makes
// any value-returning method that may violate, so their failure is the
// server error; one outward stream (`Fills`) through a hub under a
// fourth role source, whose operator is a bearer (`dave`), so a fixture
// caller can subscribe. No fn here calls either violating handler, so
// no `or` is written; one that did would write it. The unbound case — a
// serve of `Public` naming no `Orders` while two are held — is a check
// error and so is not here.

role trader;
role operator;

unit cent;
type Money = quantity Int in cent;
type OrderId = distinct Int;

type PlaceOrder { symbol: String; qty: Int; limit: Money; }
type OrderReceipt { order: OrderId; notional: Money; }
type CancelOrder { order: OrderId; }
type Cancelled { order: OrderId; was_open: Bool; }
type OrderError { code: String; reason: String; }
type Rebalance { book: String; }
type Rebalanced { moved: Money; }
type Fill { order: OrderId; qty: Int; price: Money; }

topic Fills { payload: Fill; subject: "desk.fills"; }

api Public {
    rpc Orders::place;
    rpc Orders::cancel requires: [trader];
}

api Admin {
    rpc Orders::cancel requires: [operator];
    rpc Ledger::rebalance requires: [operator];
}

// Who a bearer token is. A name the source does not know is nobody,
// and the transport refuses the request as `unauthenticated`.
locus Tokens {
    fn principal(token: String) -> std::api::Principal {
        if token == "t-alice" { return std::api::Principal { mode: "bearer", name: "alice" }; }
        if token == "t-bob" { return std::api::Principal { mode: "bearer", name: "bob" }; }
        if token == "t-carol" { return std::api::Principal { mode: "bearer", name: "carol" }; }
        if token == "t-dave" { return std::api::Principal { mode: "bearer", name: "dave" }; }
        return std::api::Principal { mode: "bearer", name: "" };
    }
    fn refused() -> String { return "no such token"; }
}

// A role source: one holder per role. Four instances are four
// sources, and a grant in one is no grant in another, whatever the
// role is called: `operator` is `uid:1000`'s under `admin_roles` (the
// Unix exposure) and `dave`'s under `hub_roles` (the hub), and neither
// holds it under the other.
locus Grants {
    params {
        trader: String = "";
        operator: String = "";
    }
    fn holds(p: std::api::Principal, r: String) -> Bool {
        if r == "trader" { return len(self.trader) > 0 && p.name == self.trader; }
        if r == "operator" { return len(self.operator) > 0 && p.name == self.operator; }
        return false;
    }
}

locus Orders {
    params {
        next: Int = 41;
        open: Int = 0;
    }
    bus { publish Fills; }
    closure position_limit { captures: open; epoch inline; }

    fn place(o: PlaceOrder) -> OrderReceipt fallible(ClosureViolation) {
        if o.qty > 10000 { violate position_limit; }
        let id = OrderId(self.next);
        self.next = self.next + 1;
        self.open = self.open + 1;
        Fills <- Fill { order: id, qty: o.qty, price: o.limit };
        return OrderReceipt { order: id, notional: o.limit * o.qty };
    }

    fn cancel(c: CancelOrder, ctx: std::api::Context) -> Cancelled fallible(OrderError) {
        let n = Int(c.order);
        if n < 41 || n >= self.next {
            fail OrderError { code: "unknown_order", reason: "no order " + to_string(n) };
        }
        self.open = self.open - 1;
        return Cancelled { order: c.order, was_open: true };
    }
}

locus Ledger {
    params { moved: Int = 0; }
    closure books_balanced { captures: moved; epoch inline; }

    fn rebalance(r: Rebalance) -> Rebalanced fallible(ClosureViolation) {
        if len(r.book) == 0 { violate books_balanced; }
        self.moved = self.moved + 1500;
        return Rebalanced { moved: 1500cent };
    }
}

main locus Desk {
    params {
        bearer: Tokens = Tokens { };
        public_roles: Grants = Grants { trader: "alice" };
        partner_roles: Grants = Grants { trader: "carol" };
        admin_roles: Grants = Grants { operator: "uid:1000" };
        hub_roles: Grants = Grants { operator: "dave" };
        orders: Orders = Orders { };
        partner_orders: Orders = Orders { next: 9001 };
        ledger: Ledger = Ledger { };
        hub: ws::Hub = ws::Hub { bind: "127.0.0.1:9000", principals: self.bearer, roles: self.hub_roles, as: "fills" };
        orders_failed: Int = 0;
        ledger_failed: Int = 0;
    }
    placement {
        orders: cooperative(pool = desk) where async_io;
        partner_orders: cooperative(pool = partner) where async_io;
        ledger: cooperative(pool = desk) where async_io;
    }
    bindings {
        Fills: self.hub requires: [operator], bound: 64, on_full: drop_old;
    }
    on_failure(o: Orders, err: ClosureViolation) { self.orders_failed = self.orders_failed + 1; }
    on_failure(l: Ledger, err: ClosureViolation) { self.ledger_failed = self.ledger_failed + 1; }

    run() {
        let public = api::serve(Public, http::Rpc { bind: "127.0.0.1:8080", codec: json, principals: self.bearer, roles: self.public_roles }, as: "public", receivers: { Orders: self.orders }, bound: 64, on_full: refuse);
        let partner = api::serve(Public, http::Rpc { bind: "127.0.0.1:8081", codec: json, principals: self.bearer, roles: self.partner_roles }, as: "partner", receivers: { Orders: self.partner_orders }, bound: 64, on_full: refuse);
        let admin = api::serve(Admin, unix::Rpc { path: "/run/desk/admin.sock", roles: self.admin_roles }, as: "admin", receivers: { Orders: self.orders }, bound: 16, on_full: refuse);
        while !self.draining { std::time::sleep(100ms); }
        public.stop();
        partner.stop();
        admin.stop();
    }
}

fn main() { Desk { }; }
