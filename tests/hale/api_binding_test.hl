// GH #1106, retargeted in R4 (GH #1417) — a surface served over a Unix
// socket, driven as a client drives it.
//
// The structural binding made every subscribed topic a command; a
// program now declares the operations it
// serves, `api Public { rpc Head::on_claim; … }`, and serves them with
// `api::serve(Public, unix::Rpc { path: … }, …)` (spec/api.md § The Unix
// JSON transport). The behaviours this file proved of the binding are
// proved of the served surface: a handler's return type is the reply; a
// payload that does not decode is refused before dispatch; the request
// bound refuses the caller, never the program. What the binding did that
// a served surface does not has no test here: an `expose` read is an `rpc`
// row whose handler returns the field (it carries no `as_of` digest), a
// stream is a topic binding to a hub (`crates/hale-codegen/tests/
// api_hub_streams.rs`), and `hale run --api` is refused (below).
//
// The fixture builds a child program with the toolchain running the
// test (`HALE_BIN`, which `hale test` exports), connects with
// `std::io::unix::connect_wait`, and reads replies line by line with a
// bounded recv timeout. A reply is found by its echoed `id`.

fn app_source(sock: String) -> String {
    return "type Claim { task: Int; who: String; }\n"
        + "type Lease { task: Int; token: String; }\n"
        + "type Slow { n: Int; }\n"
        + "type Query { who: String = \"\"; }\n"
        + "type Stats { claims: Int; slow: Int; }\n"
        + "locus Head {\n"
        + "    params { stats: Stats = Stats { claims: 0, slow: 0 }; }\n"
        + "    fn on_claim(c: Claim) -> Lease {\n"
        + "        self.stats.claims = self.stats.claims + 1;\n"
        + "        return Lease { task: c.task, token: \"lease-\" + c.who };\n"
        + "    }\n"
        + "    fn on_slow(s: Slow) -> Slow {\n"
        + "        std::time::sleep(300ms);\n"
        + "        self.stats.slow = self.stats.slow + 1;\n"
        + "        return s;\n"
        + "    }\n"
        + "    fn read_stats(q: Query) -> Stats { return self.stats; }\n"
        + "}\n"
        + "api Public { rpc Head::on_claim; rpc Head::on_slow; rpc Head::read_stats; }\n"
        + "main locus App {\n"
        + "    params { head: Head = Head { }; }\n"
        + "    placement { head: cooperative(pool = work) where async_io; }\n"
        + "    run() {\n"
        + "        let h = api::serve(Public, unix::Rpc { path: \"" + sock + "\" }, as: \"public\", receivers: { Head: self.head }, bound: 1, on_full: refuse);\n"
        + "        std::time::sleep(8s);\n"
        + "        h.stop();\n"
        + "    }\n"
        + "}\n"
        + "fn main() { App { }; }\n";
}

locus Proc {
    params {
        child: std::process::Child = std::process::Child { };
        out: String = "";
    }

    fn start(argv: String) -> Bool {
        let spawned = std::process::spawn(argv) or std::process::Child { };
        std::process::adopt(self.child, spawned);
        return self.child.pid > 0;
    }

    fn stop() {
        std::process::signal(self.child, 15) or discard;
        let mut i = 0;
        while i < 300 {
            let code = std::process::try_wait(self.child) or - 3;
            if code != -2 {
                self.out = self.out + (std::process::read_stderr(self.child) or "");
                return;
            }
            std::time::sleep(20ms);
            i = i + 1;
        }
        std::process::kill(self.child) or discard;
    }
}

// One connection to the served surface: sends lines, reads lines, finds a
// reply by its echoed id.
locus Api {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        buf: String = "";
        connected: Bool = false;
    }

    fn connect(sock: String) -> Bool {
        let fd = std::io::unix::connect_wait(sock, 10s) or - 1;
        if fd < 0 {
            return false;
        }
        std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        self.connected = true;
        return true;
    }

    fn send(line: String) {
        self.stream.send(line + "\n") or discard;
    }

    // A call of `member` with `payload`, under the client id `c-<id>`.
    fn call(id: Int, member: String, payload: String) {
        self.send("{\"call\":\"" + member + "\",\"payload\":" + payload + ",\"id\":\"c-" + to_string(id) + "\"}");
    }

    // The next complete line, or "" after ~4s without one.
    fn next_line() -> String {
        let mut i = 0;
        while i < 20 {
            let nl = std::str::index_of(self.buf, "\n");
            if nl >= 0 {
                let line = self.buf[0..nl];
                self.buf = self.buf[(nl + 1)..len(self.buf)];
                return line;
            }
            let chunk = self.stream.recv(65536) or "";
            if len(chunk) == 0 {
                i = i + 1;
            } else {
                self.buf = self.buf + chunk;
            }
        }
        return "";
    }

    // The reply carrying the client id `c-<id>`.
    fn reply_for(id: Int) -> String {
        let needle = "\"id\":\"c-" + to_string(id) + "\",";
        let mut i = 0;
        while i < 200 {
            let line = self.next_line();
            if len(line) == 0 {
                return "";
            }
            if std::str::contains(line, needle) {
                return line;
            }
            i = i + 1;
        }
        return "";
    }

    // The next line (or "" after the bound): the answer to a line that
    // carries no `id` to echo, such as a refusal of one that is not JSON.
    fn next_reply() -> String {
        return self.next_line();
    }
}

fn field(line: String, name: String) -> String {
    return std::json::find_field_raw(line, name);
}

fn drive(api: Api) {
    // A command answered by its handler's return value, correlated to
    // the request that asked.
    api.call(1, "Head::on_claim", "{\"task\":7,\"who\":\"dev\"}");
    let r1 = api.reply_for(1);
    std::test::assert(std::str::contains(r1, "\"ok\":true"), "claim answered: " + r1);
    std::test::assert_eq_str(field(r1, "value"), "{\"task\":7,\"token\":\"lease-dev\"}", "the handler's return is the reply: " + r1);
    std::test::assert(len(field(r1, "request_id")) > 0, "the exposure assigned a request id: " + r1);

    // A wrong-typed field is refused before dispatch.
    api.call(2, "Head::on_claim", "{\"task\":\"x\",\"who\":\"dev\"}");
    let r2 = api.reply_for(2);
    std::test::assert(std::str::contains(r2, "\"ok\":false"), "malformed refused: " + r2);
    std::test::assert(std::str::contains(r2, "\"kind\":\"malformed\""), "the refusal names malformed: " + r2);
    std::test::assert(std::str::contains(r2, "wrong_type: task"), "the refusal names the field: " + r2);

    // A member the surface does not have.
    api.call(3, "Head::Nope", "{}");
    let r3 = api.reply_for(3);
    std::test::assert(std::str::contains(r3, "\"kind\":\"malformed\"") && std::str::contains(r3, "unknown_member"), "unknown member refused: " + r3);

    // What was a read is an rpc: it answers the field, and a later write
    // moves it.
    api.call(5, "Head::read_stats", "{}");
    let r5 = api.reply_for(5);
    std::test::assert_eq_str(field(r5, "value"), "{\"claims\":1,\"slow\":0}", "the row answers the field: " + r5);
    api.call(6, "Head::on_claim", "{\"task\":8,\"who\":\"ops\"}");
    let r6 = api.reply_for(6);
    std::test::assert(std::str::contains(r6, "\"ok\":true"), "second claim answered: " + r6);
    api.call(7, "Head::read_stats", "{}");
    let r7 = api.reply_for(7);
    std::test::assert_eq_str(field(r7, "value"), "{\"claims\":2,\"slow\":0}", "the field moved: " + r7);
    std::test::assert_eq_str(field(r5, "value"), "{\"claims\":1,\"slow\":0}", "the first copy did not change");

    // Over the bound, the caller is refused and the handler never runs
    // for the refused requests: bound 1, a handler that takes 300ms,
    // three requests at once.
    api.call(9, "Head::on_slow", "{\"n\":1}");
    api.call(10, "Head::on_slow", "{\"n\":2}");
    api.call(11, "Head::on_slow", "{\"n\":3}");
    let r10 = api.reply_for(10);
    std::test::assert(std::str::contains(r10, "\"kind\":\"full\""), "second in flight refused: " + r10);
    let r11 = api.reply_for(11);
    std::test::assert(std::str::contains(r11, "\"kind\":\"full\""), "third in flight refused: " + r11);
    let r9 = api.reply_for(9);
    std::test::assert_eq_str(field(r9, "value"), "{\"n\":1}", "the first slow call answered: " + r9);
    api.call(12, "Head::read_stats", "{}");
    let r12 = api.reply_for(12);
    std::test::assert_eq_str(field(r12, "value"), "{\"claims\":2,\"slow\":1}", "refused requests never reached the handler: " + r12);

    // A line that is not a request.
    api.send("not json");
    let r0 = api.next_reply();
    std::test::assert(std::str::contains(r0, "\"kind\":\"malformed\""), "a non-request line is refused: " + r0);
}

fn main() {
    let hale = if std::env::var_exists("HALE_BIN") { std::env::var("HALE_BIN") } else { "hale" };
    let tag = to_string(std::process::pid());

    // 1. The surface in the source, served over the socket.
    let sock = "/tmp/hale-api-" + tag + ".sock";
    let src = std::io::fs::mktemp("/tmp/hale-1106-", ".hl") or "";
    std::test::assert(src != "", "a scratch source path");
    std::io::fs::write_file(src, app_source(sock)) or discard;
    let built = std::process::run(hale + "\nbuild\n" + src)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert_eq_int(built.code, 0, "the app builds: " + built.stderr);
    let bin = src[0..(len(src) - 3)];
    let p = Proc { };
    std::test::assert(p.start(bin), "the app started");
    let api = Api { };
    std::test::assert(api.connect(sock), "connected to " + sock);
    drive(api);
    p.stop();
    std::test::assert(!std::io::fs::file_exists(sock), "the socket file is unlinked at exit");

    // 2. The zero-code path is gone: `hale run --api` is refused, saying
    //    what to write instead.
    let refused = std::process::run(hale + "\nrun\n--api\n" + sock + "\n" + src)
    or std::process::ProcessOutput { code: -9, signal: 0, stdout: "", stderr: "run failed" };
    std::test::assert(refused.code != 0, "hale run --api is refused");
    std::test::assert(std::str::contains(refused.stderr, "`--api <path>` is retired"), "and says so: " + refused.stderr);

    std::io::fs::unlink(src) or discard;
    std::io::fs::unlink(bin) or discard;
}
