// 04-child-aggregates — one locus, three reads over its children.
//
// An aggregator over leaf children that reads the same
// underlying state through three methods:
//   - total:   sum across all children (aggregate)
//   - count:   number of children (for homogeneous accept,
//              the cardinality)
//   - largest: largest single child value (tail / edge)
//
// All three read self.children, the locus's typed collection
// of accepted coordinatees, in the locus's own arena: no copy
// or extra allocation happens between them.

locus LeafL {
    params {
        value: Int = 0;
    }
    contract {
        expose value: Int;
    }
}

locus AggregatorL {
    params {
        B: Int = 100;
        c: Int = 1;
        sigma: Int = 1;
        phi: Float = 1.0;
    }

    contract {
        consume value: Int;
    }

    accept(c: LeafL) {
        // Default accept body — registers the child. The
        // declaration's type binding is what makes F.8
        // contract-compatibility verifiable: AggregatorL's
        // `consume value: Int` is checked against LeafL's
        // `expose value: Int` at compile time.
    }

    fn total() -> Int {
        let mut total: Int = 0;
        for child in self.children {
            total = total + child.value;
        }
        return total;
    }

    fn count() -> Int {
        let mut count: Int = 0;
        for child in self.children {
            count = count + 1;
        }
        return count;
    }

    fn largest() -> Int {
        let mut max: Int = 0;
        for child in self.children {
            if child.value > max {
                max = child.value;
            }
        }
        return max;
    }

    run() {
        // Bind so leaves persist for the duration of run().
        let _l1 = LeafL { value: 10 };
        let _l2 = LeafL { value: 20 };
        let _l3 = LeafL { value: 30 };

        println("total:   ", self.total());
        println("count:   ", self.count());
        println("largest: ", self.largest());
    }
}

fn main() {
    AggregatorL { };
}
