// dna/core/forge.hl — a code-review host behind an interface (GH #648;
// the boundary declared with #646 stage 0, #649).
//
// GitHub, the Board's surface there, mirrors every pending mutation Review as a pull
// request and every review on it as a verdict. This is the vocabulary of
// a code-review host and nothing of GitHub's: `gh` is one implementation
// (the host's `forge_sync`, behind this since #648), a bare
// remote with no forge is the honest other, and both are declared here
// with the memory forge fixtures use.

// A review opened at the forge for a candidate.
type ReviewRef {
    present: Bool = false;
    ref: String = ""; // the forge's name for it (a pull request number, a url)
    why: String = "";
}

// One verdict a forge reports: who, the outcome, when, and the forge's
// own key for it so it is admitted once.
type ForgeVerdict {
    who: String = "";
    outcome: String = ""; // "approve" | "revise" | "reject" | "comment"
    when: String = "";
    key: String = "";
}

interface Forge {
    fn kind() -> String;
    // Whether the genome's remote has a forge, and what it is called.
    fn present() -> Bool;
    fn name() -> String;
    fn open_review(candidate: String, title: String, body: String) -> ReviewRef;
    // Every verdict on a review, one per line as `who\toutcome\twhen\tkey`.
    fn verdicts(review: String) -> String;
    // GH #1161: every check run the forge reports for the review's
    // candidate `sha`, one per line as `name\tconclusion\tsha\turl`
    // (conclusion "" while it runs): what the host observes as a gate's
    // run, since the forge ran it, not whoever says it did.
    fn checks(review: String, sha: String) -> String;
    fn comment(review: String, text: String) -> Bool;
    fn close_review(review: String, why: String) -> Bool;
    // Phase 3: what became of a review a leg opened at a codebase's forge.
    // `open`, `merged\t<the merge commit>`, `closed` (without merging), or
    // `unknown` when the forge cannot say.
    fn review_state(review: String) -> String;
    // The review's description as the forge holds it now (it carries the
    // leg's last commit as a `leg-commit:` line, see `leg_commit_in`).
    fn review_body(review: String) -> String;
    // Every comment a person made on the review, one per line as
    // `who\tkey\ttext`, the text's newlines spelled `\n`; `key` names a
    // comment once.
    fn review_comments(review: String) -> String;
}

// The line a leg's review carries to name the commit it left the branch at.
const LEG_COMMIT_LINE: String = "leg-commit: ";

// The review's body with the leg's last commit named.
fn with_leg_commit(body: String, sha: String) -> String {
    return body + "\n\n" + LEG_COMMIT_LINE + sha + "\n";
}

// The leg's commit a review body names, "" when it names none.
fn leg_commit_in(body: String) -> String {
    let at = std::str::index_of(body, "\n" + LEG_COMMIT_LINE);
    if at < 0 { return ""; }
    let rest = body[(at + 1 + len(LEG_COMMIT_LINE))..len(body)];
    let nl = std::str::index_of(rest, "\n");
    return std::str::trim(if nl < 0 { rest } else { rest[0..nl] });
}

type MemReview {
    ref: String = "";
    candidate: String = "";
    title: String = "";
    body: String = "";
    verdicts: String = "";
    closed: String = "";
    comments: Int = 0;
    checks: String = "";
    merged: String = "";
    said: String = "";
}

@form(hashmap)
locus MemReviews {
    capacity { pool rows of MemReview indexed_by ref; }
}

// A forge in memory: reviews are rows, verdicts are what the fixture
// posts with `decide`, a merge is what it posts with `merge`, a person's
// comment what it posts with `say`.
locus MemForge {
    params { reviews: MemReviews = MemReviews { }; next: Int = 1; }
    fn kind() -> String { return "memory"; }
    fn present() -> Bool { return true; }
    fn name() -> String { return "memory forge"; }
    fn open_review(candidate: String, title: String, body: String) -> ReviewRef {
        let ref = "#" + to_string(self.next);
        self.next = self.next + 1;
        self.reviews.set(MemReview { ref: ref, candidate: candidate, title: title, body: body });
        return ReviewRef { present: true, ref: ref };
    }
    // A fixture's reviewer decides.
    fn decide(review: String, who: String, outcome: String, when: String) -> Bool {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return false; }
        let key = who + ":" + r.candidate + ":" + outcome;
        let mut n = r;
        n.verdicts = r.verdicts + who + "\t" + outcome + "\t" + when + "\t" + key + "\n";
        self.reviews.set(n);
        return true;
    }
    fn verdicts(review: String) -> String {
        let r = self.reviews.get(review) or MemReview { };
        return r.verdicts;
    }
    // A fixture's CI reports a run.
    fn report(review: String, name: String, conclusion: String, sha: String, url: String) -> Bool {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return false; }
        let mut n = r;
        n.checks = r.checks + name + "\t" + conclusion + "\t" + sha + "\t" + url + "\n";
        self.reviews.set(n);
        return true;
    }
    fn checks(review: String, sha: String) -> String {
        let r = self.reviews.get(review) or MemReview { };
        return r.checks;
    }
    fn comment(review: String, text: String) -> Bool {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return false; }
        let mut n = r;
        n.comments = r.comments + 1;
        self.reviews.set(n);
        return true;
    }
    fn close_review(review: String, why: String) -> Bool {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return false; }
        let mut n = r;
        n.closed = why;
        self.reviews.set(n);
        return true;
    }
    // A fixture's team merges the review at `commit`.
    fn merge(review: String, commit: String) -> Bool {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return false; }
        let mut n = r;
        n.merged = commit;
        self.reviews.set(n);
        return true;
    }
    // A fixture's person comments on the review.
    fn say(review: String, who: String, text: String) -> Bool {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return false; }
        let mut n = r;
        let key = who + ":" + to_string(len(r.said));
        n.said = r.said + who + "\t" + key + "\t" + std::str::replace(text, "\n", "\\n") + "\n";
        self.reviews.set(n);
        return true;
    }
    fn review_state(review: String) -> String {
        let r = self.reviews.get(review) or MemReview { };
        if len(r.ref) == 0 { return "unknown"; }
        if len(r.merged) > 0 { return "merged\t" + r.merged; }
        if len(r.closed) > 0 { return "closed"; }
        return "open";
    }
    fn review_body(review: String) -> String {
        let r = self.reviews.get(review) or MemReview { };
        return r.body;
    }
    fn review_comments(review: String) -> String {
        let r = self.reviews.get(review) or MemReview { };
        return r.said;
    }
}

// No forge: the honest behaviour of a bare remote. Opens nothing, reads
// verdicts from nowhere, and says so.
locus NoForge {
    fn kind() -> String { return "none"; }
    fn present() -> Bool { return false; }
    fn name() -> String { return "none (a bare remote)"; }
    fn open_review(candidate: String, title: String, body: String) -> ReviewRef {
        return ReviewRef { why: "no forge" };
    }
    fn verdicts(review: String) -> String { return ""; }
    fn checks(review: String, sha: String) -> String { return ""; }
    fn comment(review: String, text: String) -> Bool { return false; }
    fn close_review(review: String, why: String) -> Bool { return false; }
    fn review_state(review: String) -> String { return "unknown"; }
    fn review_body(review: String) -> String { return ""; }
    fn review_comments(review: String) -> String { return ""; }
}
