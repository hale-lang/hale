// lib-enum-iface — GH #534 (DNA F.1): a library that matches its OWN
// enum and holds its OWN interface. The enum was clean in-seed and
// broke through `import`: the mangler renamed the enum declaration but
// not the `Color::Red` variant paths (expression and pattern).

type Color = enum { Red, Green, Blue };

fn name(c: Color) -> String {
    return match c {
        Color::Red -> "red",
        Color::Green -> "green",
        Color::Blue -> "blue",
    };
}

fn first() -> String {
    return name(Color::Red);
}

fn pick_color() -> Color {
    return Color::Green;
}

fn is_green(c: Color) -> Bool {
    return match c {
        Color::Green -> true,
        _ -> false,
    };
}

// GH #885: a payload-carrying enum, so the consumer can print one
// of each kind. The two renderings are built by different codegen
// sites (a names array vs a per-variant switch), and both spelled
// the declaration's MANGLED name into the text.
type Reading = enum { Empty, Value(Int) };

fn reading() -> Reading {
    return Reading::Value(7);
}

interface Routing {
    fn pick() -> String;
}

locus First {
    fn pick() -> String { return "first"; }
}

locus Second {
    fn pick() -> String { return "second"; }
}

locus Router {
    params { policy: Routing = First { }; }
    fn which() -> String { return self.policy.pick(); }
}
