// dna/tests/integration_watch_test.hl — integration watches (phase 3).
//
// A grafted organism's genome declares its upstream integrations in its
// hale.toml: a changelog page, owned by `app/dev`, and an OpenAPI document,
// owned by `app/ops` and watched through the surface `hale api import`
// committed. The organization declares one schedule of integration-check per
// integration, convened by its position, and the fixture convenes the
// occurrences itself rather than waiting on the wall clock. The first check
// is the baseline and lands nothing; a moved source lands one reading
// `integration.<name>.changed`, the unified diff (of the page's text, or of
// the drift lines) its receipt, and one concern routed to the owning
// position; a check that finds nothing moved lands nothing. A source that
// cannot be read lands its `unreachable` reading at the third failure in a
// row and no concern, and a declaration that cannot stand is refused.

import "../core" as dna;
import "../operations" as ops;

const CHANGELOG: String = "<!doctype html>
<html><head><title>Changelog</title><script>var built = 1790558458;</script></head>
<body><h1>Changelog</h1>
<!-- rendered at 2026-10-20T10:00:00Z -->
<ul><li>v1.2.0: charges take an idempotency key</li><li>v1.1.0: refunds are partial</li></ul>
</body></html>
";

const CHANGELOG_MOVED: String = "<!doctype html>
<html><head><title>Changelog</title><script>var built = 1790559999;</script></head>
<body><h1>Changelog</h1>
<!-- rendered at 2026-10-21T10:00:00Z -->
<ul><li>v1.3.0: the charge's <b>currency</b> is required &amp; validated</li><li>v1.2.0: charges take an idempotency key</li><li>v1.1.0: refunds are partial</li></ul>
</body></html>
";

const PAY: String = "openapi: 3.0.3
info:
  title: Pay
  version: 1.0.0
paths:
  /charges:
    post:
      operationId: createCharge
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NewCharge'
      responses:
        '200':
          description: ok
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Charge'
components:
  schemas:
    NewCharge:
      type: object
      required: [amount]
      properties:
        amount:
          type: integer
    Charge:
      type: object
      required: [id, amount]
      properties:
        id:
          type: string
        amount:
          type: integer
";

// The document moved upstream: a refund operation added.
const PAY_REFUNDS: String = "  /refunds:
    post:
      operationId: createRefund
      responses:
        '200':
          description: ok
";

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn sh(script: String, dir: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HALE_DNA_DISCOVER=off && eval \"$2\"\nsh\n" + dir + "\n" + script);
}

fn journal(repo: String) -> dna::RoutedJournal {
    return dna::RoutedJournal { record: dna::RecordJournal { repo: repo }, ledger: dna::MemoryLedger { repo: repo } };
}

main locus App {
    params {
        repo: String = "";
        upstream: String = "";
        scratch: String = "";
        d: dna::Dna = dna::Dna { };
    }
    // The rows of `kind` whose entity starts with `prefix`.
    fn rows(kind: String, prefix: String) -> Int {
        let j = journal(self.repo);
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && std::str::starts_with(e.entity, prefix) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    fn last_body(kind: String, prefix: String) -> String {
        let j = journal(self.repo);
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind && std::str::starts_with(e.entity, prefix) { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    // integration-check's and concern-escalate's executions: admitted, and
    // how many of them have settled.
    fn open_executions() -> Int {
        let j = journal(self.repo);
        let mut admitted = "\n";
        let mut open = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            let def = std::json::find_string_field(e.body, "definition");
            if e.kind == "workflow.admitted" && (def == "integration-check" || def == "concern-escalate") { admitted = admitted + e.entity + "\n"; open = open + 1; }
            if e.kind == "workflow.settled" && std::str::contains(admitted, "\n" + e.entity + "\n") { open = open - 1; }
            i = i + 1;
        }
        return open;
    }
    // Wait until `checks` integration-check executions have been admitted
    // and every one of them, and every concern they raised, has settled.
    fn settle(checks: Int, what: String) {
        let mut tries = 0;
        while tries < 600 && (self.admitted_checks() < checks || self.open_executions() > 0) {
            std::time::sleep(100ms);
            tries = tries + 1;
        }
        std::test::assert(self.admitted_checks() >= checks && self.open_executions() == 0, what + ": " + to_string(self.admitted_checks()) + " check(s) admitted, " + to_string(self.open_executions()) + " still open");
    }
    fn admitted_checks() -> Int {
        let j = journal(self.repo);
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == "workflow.admitted" && std::json::find_string_field(e.body, "definition") == "integration-check" { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    // The occurrence the schedule was declared at.
    fn from(id: String) -> Int { return std::json::find_int_field(self.last_body("schedule.declared", id), "from"); }
    // What a check reads of a feed and of a plain page, with no organism.
    fn normalized() {
        let rss = "<?xml version=\"1.0\"?><rss><channel><title>Pay releases</title><lastBuildDate>Tue, 20 Oct 2026 10:00:00 GMT</lastBuildDate>"
            + "<item><title>v1.3.0</title><link>https://example.invalid/r/1.3.0</link><pubDate>Tue, 20 Oct 2026 09:00:00 GMT</pubDate></item>"
            + "<item><title><![CDATA[v1.2.0 & more]]></title><guid>tag:1.2.0</guid></item></channel></rss>";
        std::test::assert_eq_str(dna::feed_entries(rss), "v1.3.0 | https://example.invalid/r/1.3.0\nv1.2.0 & more | tag:1.2.0\n", "an RSS feed is its items, a line each, its dates left out");
        let atom = "<feed xmlns=\"http://www.w3.org/2005/Atom\"><updated>2026-10-20T10:00:00Z</updated><entry><title type=\"text\">v2.0</title><link rel=\"alternate\" href=\"https://example.invalid/v2\"/><id>urn:v2</id><updated>2026-10-20T09:00:00Z</updated></entry></feed>";
        std::test::assert_eq_str(dna::feed_entries(atom), "v2.0 | https://example.invalid/v2\n", "an Atom feed is its entries");
        std::test::assert_eq_str(dna::page_text("# Changelog\r\n\r\n## 1.2.0   \n- refunds\n"), "# Changelog\n## 1.2.0\n- refunds\n", "a page that is not HTML keeps its lines, made plain");
    }
    run() {
        self.normalized();
        // ---- the genome's declarations become schedules, each convened by
        // the position that owns its integration
        self.d.watch_integrations();
        let decl = self.last_body("schedule.declared", "integration.changelog");
        std::test::assert(std::str::contains(decl, "\"definition\": \"integration-check\"") && std::str::contains(decl, "\"convener\": \"position:app/dev\""), "the changelog's check is convened by app/dev: " + decl);
        std::test::assert(std::str::contains(self.last_body("schedule.declared", "integration.pay-api"), "\"convener\": \"position:app/ops\""), "the API's by app/ops: " + self.last_body("schedule.declared", "integration.pay-api"));
        std::test::assert_eq_int(self.rows("schedule.declared", "integration.status"), 1, "the status page's too");
        std::test::assert(std::str::contains(self.last_body("integration.refused", "integration:bad"), "its `source` is one of changelog docs feed openapi"), "a declaration that cannot stand is refused: " + self.last_body("integration.refused", "integration:bad"));
        std::test::assert_eq_int(self.rows("schedule.declared", "integration.bad"), 0, "and declares nothing");
        self.d.watch_integrations();
        std::test::assert_eq_int(self.rows("schedule.declared", "integration."), 3, "an unchanged genome declares nothing again");
        let every = 3600000;
        let mut t = self.from("integration.changelog");
        std::test::assert(t > 0 && t == self.from("integration.pay-api") && t == self.from("integration.status"), "the three were declared at one occurrence");

        // ---- the first check is the baseline: nothing lands
        t = t + every;
        self.d.tick(t);
        self.settle(3, "the baseline checks settle");
        std::test::assert_eq_int(self.rows("integration.observed", "integration:changelog"), 1, "the changelog's baseline is recorded");
        std::test::assert(std::str::contains(self.last_body("integration.observed", "integration:changelog"), "\"outcome\": \"baseline\""), "as the baseline: " + self.last_body("integration.observed", "integration:changelog"));
        std::test::assert_eq_int(self.rows("integration.observed", "integration:pay-api"), 1, "the API's baseline too");
        std::test::assert_eq_int(self.rows("reading.recorded", "integrations/"), 0, "a baseline lands no reading");
        std::test::assert_eq_int(self.rows("concern.raised", "app/"), 0, "and no concern");
        let snapshot = std::json::find_string_field(self.last_body("integration.observed", "integration:changelog"), "digest");
        let page = dna::MemoryReceipts { repo: self.repo }.read(snapshot);
        std::test::assert_eq_str(page, "Changelog\nv1.2.0: charges take an idempotency key\nv1.1.0: refunds are partial\n", "the snapshot is the page's text, its head, script and comment stripped");
        std::test::assert_eq_int(self.rows("integration.unreached", "integration:status"), 1, "the status page was not reached, once");

        // ---- both sources move upstream: one reading and one concern each
        std::io::fs::write_file(self.upstream + "/changelog.html", CHANGELOG_MOVED) or discard;
        std::io::fs::write_file(self.upstream + "/pay.yaml", std::str::replace(PAY, "components:\n", PAY_REFUNDS + "components:\n")) or discard;
        t = t + every;
        self.d.tick(t);
        self.settle(6, "the moved checks settle");
        std::test::assert_eq_int(self.rows("reading.recorded", "integrations/integration.changelog.changed/"), 1, "one reading of the changelog's move");
        let moved = self.last_body("reading.recorded", "integrations/integration.changelog.changed/");
        let payload = std::json::find_string_field(moved, "payload");
        let diff = std::json::find_string_field(payload, "diff");
        std::test::assert(std::str::contains(diff, "--- integration.changelog " + snapshot[0..12]) && std::str::contains(diff, "\n+v1.3.0: the charge's currency is required & validated\n"), "its diff is the page's text, unified: " + diff);
        std::test::assert(!std::str::contains(diff, "1790559999") && !std::str::contains(diff, "rendered at"), "and the volatile parts are not in it: " + diff);
        let receipt = std::json::find_string_field(payload, "receipt");
        std::test::assert_eq_str(dna::MemoryReceipts { repo: self.repo }.read(receipt), diff, "the diff is the reading's receipt, kept in memory");
        std::test::assert_eq_str(std::json::find_string_field(payload, "position"), "position:app/dev", "the reading names the owning position");
        let api = std::json::find_string_field(self.last_body("reading.recorded", "integrations/integration.pay-api.changed/"), "payload");
        std::test::assert_eq_int(self.rows("reading.recorded", "integrations/integration.pay-api.changed/"), 1, "one reading of the API's move");
        std::test::assert(std::str::contains(std::json::find_string_field(api, "diff"), "\n+drift Pay added create_refund\n"), "its diff is of the drift lines: " + api);
        // the concerns, routed to the positions that own the integrations
        std::test::assert_eq_int(self.rows("concern.raised", "app/dev/integration.changelog"), 1, "one concern from the changelog's watch");
        let c = self.last_body("concern.raised", "app/dev/integration.changelog");
        std::test::assert_eq_str(std::json::find_string_field(c, "parent"), "app/dev", "routed to app/dev");
        let reading = "integrations/integration.changelog.changed/" + std::json::find_string_field(moved, "id");
        std::test::assert(std::str::contains(std::json::find_string_field(c, "what"), "reading " + reading + ", its diff the receipt " + receipt), "its words point at the reading and its receipt: " + c);
        std::test::assert_eq_str(std::json::find_string_field(c, "request"), reading, "and its request is the reading: one move, one concern");
        std::test::assert_eq_int(self.rows("concern.raised", "app/ops/integration.pay-api"), 1, "one concern from the API's watch");
        std::test::assert_eq_str(std::json::find_string_field(self.last_body("concern.raised", "app/ops/integration.pay-api"), "parent"), "app/ops", "routed to app/ops");

        // ---- unchanged: nothing lands; the status page's third failure is
        // its one unreachable reading, with no concern
        t = t + every;
        self.d.tick(t);
        self.settle(9, "the unchanged checks settle");
        std::test::assert_eq_int(self.rows("reading.recorded", "integrations/integration.changelog."), 1, "an unmoved changelog lands no reading");
        std::test::assert_eq_int(self.rows("reading.recorded", "integrations/integration.pay-api."), 1, "nor an unmoved API");
        std::test::assert_eq_int(self.rows("integration.observed", "integration:changelog"), 2, "and writes no observation");
        std::test::assert_eq_int(self.rows("concern.raised", "app/"), 2, "and raises no concern");
        std::test::assert_eq_int(self.rows("integration.unreached", "integration:status"), 3, "the status page failed three times in a row");
        std::test::assert_eq_int(self.rows("reading.recorded", "integrations/integration.status.unreachable/"), 1, "its third failure is one unreachable reading");
        std::test::assert(std::str::contains(std::json::find_string_field(self.last_body("reading.recorded", "integrations/integration.status.unreachable/"), "payload"), "no file at "), "naming why");
        std::test::assert_eq_int(self.rows("concern.raised", "app/dev/integration.status"), 0, "and raises no concern");

        dna::scratch_done(self.scratch);
    }
}

fn main() {
    let scratch = dna::scratch_root("integration-watch");
    let made = dna::grafted(scratch, "app");
    std::test::assert_eq_int(made.code, 0, "an organism grafted: " + made.stdout + made.stderr);
    let repo = scratch + "/app";
    std::test::assert_eq_str(dna::memory_fixture(repo), "", "the record is born in memory (GH #1590)");
    // the positions that own the integrations, each held by a person the
    // record knows, and memory's graph caught up with them
    let as_ada = dna::RecordJournal { repo: repo, author: "ada" };
    std::test::assert(as_ada.append(as_ada.revision(), "note.kept", "n-ada", "ada was here").ok, "ada is a person the record knows");
    let as_bo = dna::RecordJournal { repo: repo, author: "bo" };
    std::test::assert(as_bo.append(as_bo.revision(), "note.kept", "n-bo", "bo was here").ok, "bo too");
    std::test::assert_eq_str(ops::graph_seat(journal(repo), "position:app/dev", "ada"), "", "ada holds app/dev");
    std::test::assert_eq_str(ops::graph_seat(journal(repo), "position:app/ops", "bo"), "", "bo holds app/ops");
    let spine = dna::kept_spine_dsn(repo);
    std::test::assert(len(spine) > 0, "the clone reaches memory as the spine");
    let projected = ops::MemoryProjection { root: repo, dsn_env: spine }.apply();
    std::test::assert_eq_str(projected.error, "", "the record projects into memory");

    // upstream: a changelog page and an OpenAPI document, read from files
    let upstream = scratch + "/upstream";
    std::io::fs::mkdir(upstream) or discard;
    std::io::fs::write_file(upstream + "/changelog.html", CHANGELOG) or discard;
    std::io::fs::write_file(upstream + "/pay.yaml", PAY) or discard;
    // the genome: the imported surface committed, and the declarations
    let imported = dna::run_tool("sh\n-c\ncd \"$1\" && mkdir -p integrations && exec \"$2\" api import \"$3\" --as Pay --out integrations/pay.hl\nsh\n" + repo + "\n" + toolchain() + "\n" + upstream + "/pay.yaml");
    std::test::assert_eq_int(imported.code, 0, "the API's surface is imported: " + imported.stdout + imported.stderr);
    let toml = std::io::fs::read_file(repo + "/hale.toml") or "";
    let declared = toml + "\n[dna.integrations.changelog]\nposition = \"app/dev\"\nsource = \"changelog\"\nurl = \"file://" + upstream + "/changelog.html\"\nevery = \"1h\"\n"
        + "\n[dna.integrations.pay-api]\nposition = \"position:app/ops\"\nsource = \"openapi\"\nsurface = \"integrations/pay.hl\"\nevery = \"1h\"\n"
        + "\n[dna.integrations.status]\nposition = \"app/dev\"\nsource = \"docs\"\nurl = \"file://" + upstream + "/status.html\"\nevery = \"1h\"\n"
        + "\n[dna.integrations.bad]\nposition = \"app/dev\"\nsource = \"rss\"\nurl = \"https://example.invalid/feed\"\nevery = \"1h\"\n";
    std::io::fs::write_file(repo + "/hale.toml", declared) or discard;
    let committed = sh("git add -A && git -c user.name=ada -c user.email=ada@dna commit -qm 'watch the upstream integrations'", repo);
    std::test::assert_eq_int(committed.code, 0, "the genome commits its declarations: " + committed.stderr);

    App {
        repo: repo, upstream: upstream, scratch: scratch,
        d: dna::Dna {
            // the organization writes as the spine, as a body's would
            journal: dna::RoutedJournal { record: dna::RecordJournal { repo: repo }, ledger: dna::MemoryLedger { repo: repo, dsn_env: spine } },
            knowledge_client: dna::MemoryKnowledge { repo: repo },
            verification: dna::HaleVerification { receipts: dna::MemoryReceipts { repo: repo } },
            gateway: dna::MutationGateway { workspaces: dna::IsolatedWorktrees { repo: repo } },
            org_id: "watch"
        }
    };
}
