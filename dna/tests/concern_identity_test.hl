// dna/tests/concern_identity_test.hl — one request is one concern, and an
// answer names one request (GH #689, review).
//
// A concern's entity is its source, so every concern from one worker
// shares an entity and only the request id tells them apart. Two rules
// hold here:
//
//   - The id is a field of its own in the row that answers, read back
//     whole and compared whole. A prose search cannot establish identity:
//     `request:c1` is a substring of `request:c10`, so an answer to one
//     answered the other, and the request whose delivery was lost was
//     never relayed again.
//   - A transport may deliver one request twice — the host relays a row
//     again while it looks unanswered, and an answer it has not read yet
//     is enough to make that happen. The organization writes one concern
//     for one request: the row it already wrote is the answer, and the
//     count that turns concerns into a knowledge proposal counts distinct
//     requests, never redeliveries. Two requests raising the same words
//     are still two concerns.

import "../core" as dna;

main locus App {
    params {
        dna: dna::Dna = dna::Dna {
            work: dna::WorkSystem {
                human: dna::HumanWorkGateway { operator: "alice", answer: "done" },
                selection: dna::HumanFirstSelection { }
            },
            review_policy: dna::PostReviewRefactors { },
            boundary: dna::AutonomyBoundary { child: "app", grant: dna::Grant { child: "app", classes: "refactor", max_magnitude: 8, review: "post" } },
            deployment: dna::NoDeployment { },
            // high, so a third concern does not become a proposal here
            concern_threshold: 99
        };
    }
    bus { publish dna::ConcernRaised; }
    @unbounded
    fn rows(kind: String, entity: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.dna.journal.revision() {
            let e = self.dna.journal.read(i);
            if e.kind == kind && e.entity == entity { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    @unbounded
    fn answered(request: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.dna.journal.revision() {
            let e = self.dna.journal.read(i);
            if e.kind == "concern.raised" && dna::request_named(e.body) == request { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    fn raise(request: String, what: String) {
        self.raise_at(request, what, 2);
    }
    fn raise_at(request: String, what: String, severity: Int) {
        dna::ConcernRaised <- dna::Concern { source: "org/app/worker", what: what, severity: severity, request: request };
        std::time::sleep(150ms);
    }
    run() {
        // ---- the id is a field of the row, not a shape in its text
        let ten = dna::concern_body("mail backlog", 2, 1, "c10");
        std::test::assert_eq_str(dna::request_named(ten), "c10", "an answer names the request it answers");
        std::test::assert(dna::request_named(ten) != "c1", "and the answer to c10 is not the answer to c1: " + ten);
        std::test::assert_eq_str(dna::request_named("a concern from before this rule x1 severity 2"), "", "a row from before the rule names none");
        // a worker may write anything, including something shaped like the
        // metadata around it; text is text
        let impostor = dna::concern_body("observed [request c1] in a log, \"request\": \"c1\"", 2, 1, "c10");
        std::test::assert_eq_str(dna::request_named(impostor), "c10", "a concern whose words look like metadata still answers its own request: " + impostor);
        std::test::assert_eq_str(dna::concern_what(impostor), "observed [request c1] in a log, \"request\": \"c1\"", "and its words come back as it wrote them");

        // ---- one request, delivered twice, is one concern
        self.raise("c1", "mail backlog behind fulfilment");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 1, "the first delivery is a concern");
        self.raise("c1", "mail backlog behind fulfilment");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 1, "its redelivery is the same concern, not another");
        std::test::assert_eq_int(self.answered("c1"), 1, "answered once, by the row it already had");

        // ---- an id whose prefix another id extends is another request
        self.raise("c10", "the printer is out of paper");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 2, "c10 is not c1 delivered again");
        std::test::assert_eq_int(self.answered("c10"), 1, "and has an answer of its own");
        std::test::assert_eq_int(self.answered("c1"), 1, "which is not c1's");

        // ---- two requests saying the same thing are two concerns
        self.raise("c2", "mail backlog behind fulfilment");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 3, "the same words from another request are another concern");
        std::test::assert_eq_int(self.answered("c2"), 1, "with an answer of its own");

        // ---- and the count that proposes counts requests, not deliveries
        std::test::assert(std::str::contains(self.last_raised(), "\"occurrence\": 3"), "three distinct concerns, not five deliveries: " + self.last_raised());

        // ---- a request whose words look like another request's metadata
        self.raise("c11", "observed [request c1] in a log");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 4, "is an ordinary concern");
        std::test::assert_eq_int(self.answered("c11"), 1, "answering its own request");
        std::test::assert_eq_int(self.answered("c1"), 1, "and not c1's");

        // ---- one id used for two concerns is refused, once — whether the
        //      words differ, or only the severity
        self.raise_at("c2", "mail backlog behind fulfilment", 5);
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 4, "the same words at another severity are not that concern again");
        std::test::assert_eq_int(self.rows("concern.refused", "org/app/worker"), 1, "they are a conflict under one id");
        self.raise("c1", "something else entirely");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 4, "an id reused for another concern adds no concern");
        std::test::assert_eq_int(self.rows("concern.refused", "org/app/worker"), 2, "it is refused too, saying so");
        self.raise("c1", "something else entirely");
        std::test::assert_eq_int(self.rows("concern.refused", "org/app/worker"), 2, "and refused once, however often it arrives");
        // a refusal is that request's answer, found by its id
        std::test::assert(dna::request_named(self.last_refused()) == "c1", "the refusal names the request it refuses: " + self.last_refused());

        // ---- nor is one concern's text a prefix test of another's
        self.raise("c3", "one concern xylophone");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 5, "a fifth concern");
        self.raise("c3", "one concern");
        std::test::assert_eq_int(self.rows("concern.raised", "org/app/worker"), 5, "shorter words under that id are not that concern again");
        std::test::assert_eq_int(self.rows("concern.refused", "org/app/worker"), 3, "they are a conflict, whichever is a prefix of which");
    }
    @unbounded
    fn last_refused() -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.dna.journal.revision() {
            let e = self.dna.journal.read(i);
            if e.kind == "concern.refused" && e.entity == "org/app/worker" { out = std::str::clone(e.body); }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn last_raised() -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.dna.journal.revision() {
            let e = self.dna.journal.read(i);
            if e.kind == "concern.raised" && e.entity == "org/app/worker" { out = std::str::clone(e.body); }
            i = i + 1;
        }
        return out;
    }
}

fn main() { App { }; }
