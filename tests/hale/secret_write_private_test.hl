// `std::secret::Credential.write_private(path)` (spec/stdlib.md
// § std::secret): the credential written on the sealed side into a NEW
// file created mode 0600 by openat(2) itself, in a directory this user
// owns with no group or world access, outside any git work tree. Nothing
// is revealed; the test reads the file back as the tool would — which is
// also why the reveal rule cannot follow the value past the file
// (spec/semantics.md § "@sealed").

fn sh(argv: String) -> std::process::ProcessOutput {
    return std::process::run(argv) or std::process::ProcessOutput { code: -1, signal: 0, stdout: "", stderr: "run failed" };
}

fn main() {
    // the source: an env var every process has, so no vault is needed
    let c = std::secret::Credential { env_var: "PATH" };
    std::test::assert(c.ready(), "PATH names a credential");

    // a fresh private directory: mktemp -d makes it 0700, under /tmp
    let dir = std::str::trim(sh("mktemp\n-d").stdout);
    std::test::assert(len(dir) > 0, "a private directory");

    std::test::assert(c.write_private(dir + "/token"), "written");
    std::test::assert_eq_str(std::str::trim(sh("stat\n-c\n%a\n" + dir + "/token").stdout), "600", "created 0600");
    std::test::assert_eq_str(std::io::fs::read_file(dir + "/token") or "", std::env::var("PATH"), "the credential, whole");
    std::test::assert(!c.write_private(dir + "/token"), "an existing file is never overwritten");

    // no group or world access at all
    let _open = sh("chmod\n0755\n" + dir);
    std::test::assert(!c.write_private(dir + "/world"), "a world-readable directory is refused");
    let _group = sh("chmod\n0770\n" + dir);
    std::test::assert(!c.write_private(dir + "/group"), "a group-writable directory is refused");
    let _read = sh("chmod\n0750\n" + dir);
    std::test::assert(!c.write_private(dir + "/read"), "a group-readable directory is refused");
    let _back = sh("chmod\n0700\n" + dir);

    // symlinks: the file's own name may not be one (it would be written
    // through), nor may the directory
    let _decoy = sh("mkdir\n-m\n0700\n" + dir + "/decoy");
    let _link = sh("ln\n-s\n" + dir + "/decoy/target\n" + dir + "/link");
    std::test::assert(!c.write_private(dir + "/link"), "a symlinked file name is refused");
    std::test::assert(!std::io::fs::file_exists(dir + "/decoy/target"), "and nothing is written through it");
    let _dlink = sh("ln\n-s\n" + dir + "/decoy\n" + dir + "/dirlink");
    std::test::assert(!c.write_private(dir + "/dirlink/token"), "a symlinked directory is refused");
    std::test::assert(!std::io::fs::file_exists(dir + "/decoy/token"), "and nothing is written in its target");

    // a directory inside a git work tree: a file there could be committed
    let _mk = sh("mkdir\n" + dir + "/repo");
    let _init = sh("git\n-C\n" + dir + "/repo\ninit\n-q");
    let _sub = sh("mkdir\n-m\n0700\n" + dir + "/repo/deep");
    std::test::assert(!c.write_private(dir + "/repo/deep/token"), "a tracked directory is refused");

    // no credential: nothing written
    let none = std::secret::Credential { env_var: "HALE_SECRET_WRITE_PRIVATE_UNSET" };
    std::test::assert(!none.write_private(dir + "/none"), "no credential, no file");
    std::test::assert(!std::io::fs::file_exists(dir + "/none"), "and nothing on disk");

    let _rm = sh("rm\n-rf\n" + dir);
}
