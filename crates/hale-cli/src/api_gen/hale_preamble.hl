// ---- the wire, as every client of a surface speaks it (spec/api.md § The clients) ----
//
// An endpoint is `unix:PATH` (or a path), `http://host:port` for a member's
// call, and `ws://host:port` for a stream. A call sends the surface's digest
// (`digest` in the line over a socket, `Hale-Surface-Digest` over HTTP) and
// is one of five outcomes; TLS is not spoken here.

const API_WAIT_NS: Int = 30000000000;
const API_ID: String = "c-1";
const API_WS_KEY: String = "dGhlIHNhbXBsZSBub25jZQ==";
const API_MASK: Int = 1737075661;

// A refusal: the kind (`malformed`, `digest_mismatch`, `unauthenticated`,
// `unauthorized`, `full`, `shutting_down`, `unavailable`), its reason, the
// roles a refused row requires joined by `,`, and the digest the server holds
// when the kind is `digest_mismatch`.
type ApiRefusal {
    kind: String = "";
    reason: String = "";
    requires: String = "";
    served: String = "";
}

// What came back before it is typed: `outcome` is 0 a result, 1 the handler's
// error, 2 a refusal, 3 the server error, 4 lost; `body` the value or the
// error as JSON; `why` what was lost.
type ApiRaw {
    outcome: Int = 4;
    body: String = "";
    kind: String = "";
    reason: String = "";
    requires: String = "";
    served: String = "";
    why: String = "";
}

fn api_lost(why: String) -> ApiRaw {
    return ApiRaw { outcome: 4, why: why };
}

fn api_refusal(raw: ApiRaw) -> ApiRefusal {
    return ApiRefusal { kind: raw.kind, reason: raw.reason, requires: raw.requires, served: raw.served };
}

// A JSON string token.
fn api_str(s: String) -> String {
    return "\"" + std::json::escape_string(s) + "\"";
}

// The scalar a document holds at `json` itself, read through an object.
fn api_scalar_str(json: String) -> String {
    return std::json::find_string_field("{\"v\":" + json + "}", "v");
}

fn api_scalar_int(json: String) -> Int {
    return std::json::find_int_field("{\"v\":" + json + "}", "v");
}

fn api_scalar_bool(json: String) -> Bool {
    return std::json::find_bool_field("{\"v\":" + json + "}", "v");
}

fn api_scalar_float(json: String) -> Float {
    return std::str::parse_float(json) or 0.0;
}

// The roles of a refusal's `requires` array, joined by `,`.
@unbounded
fn api_roles(array: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first_span(array);
    while !it.done {
        let role = api_scalar_str(array[it.cur_start..it.cur_end]);
        out = if len(out) == 0 { role } else { out + "," + role };
        it = std::json::array_next_span(it, array);
    }
    return out;
}

// The refusal object `{"kind": …, "reason": …, "requires": […], "served": …}`.
fn api_refused(refusal: String, status: Int) -> ApiRaw {
    let kind = std::json::find_string_field(refusal, "kind");
    if kind == "server" {
        return ApiRaw { outcome: 3 };
    }
    return ApiRaw {
        outcome: 2,
        kind: if len(kind) > 0 { kind } else { "malformed" },
        reason: std::json::find_string_field(refusal, "reason"),
        requires: api_roles(std::json::find_field_raw(refusal, "requires")),
        served: std::json::find_string_field(refusal, "served"),
        why: "status " + to_string(status),
    };
}

// ---- over HTTP: POST <endpoint>/call/<member>, the body the request's JSON ----

fn api_http_send(endpoint: String, bearer: String, member: String, payload: String) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let u = std::http::parse_url(endpoint + "/call/" + member) or raise;
    let auth = if len(bearer) > 0 { "Authorization: Bearer " + bearer + "\r\n" } else { "" };
    let headers = auth + "Content-Type: application/json\r\nHale-Surface-Digest: " + SURFACE_DIGEST;
    let req = std::http::ClientRequest { method: "POST", url: u, headers: headers, body: std::bytes::from_string(payload) };
    return std::http::request(req) or raise;
}

fn api_http(endpoint: String, bearer: String, member: String, payload: String) -> ApiRaw {
    let lost = std::http::ClientResponse { status: 0, body: std::bytes::from_string("") };
    let r = api_http_send(endpoint, bearer, member, payload) or std::http::ClientResponse { status: 0, body: std::bytes::from_string(err.kind + " " + err.detail) };
    let text = std::str::from_bytes(r.body);
    if r.status == 0 { return api_lost("the endpoint " + endpoint + " cannot be reached: " + text); }
    if r.status == 200 { return ApiRaw { outcome: 0, body: text }; }
    if r.status == 422 { return ApiRaw { outcome: 1, body: text }; }
    let refusal = std::json::find_field_raw(text, "refusal");
    if len(refusal) == 0 { return api_lost("the endpoint answered " + to_string(r.status) + " with no refusal: " + text); }
    return api_refused(refusal, r.status);
}

// ---- over a Unix socket: one line each way ----

@unbounded
fn api_unix_exchange(path: String, line: String) -> String {
    let fd = std::io::unix::connect(path) or - 1;
    if fd < 0 { return ""; }
    std::io::tcp::__set_recv_timeout_ns(fd, 200000000);
    let s = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
    s.send(line + "\n") or discard;
    let until = std::time::monotonic_ns() + API_WAIT_NS;
    let mut buf = "";
    while std::time::monotonic_ns() < until {
        let nl = std::str::index_of(buf, "\n");
        if nl >= 0 { return buf[0..nl]; }
        let chunk = s.recv(65536) or "";
        if len(chunk) > 0 { buf = buf + chunk; }
    }
    return "";
}

fn api_unix(path: String, member: String, payload: String) -> ApiRaw {
    let line = "{\"call\":" + api_str(member) + ",\"payload\":" + payload + ",\"id\":" + api_str(API_ID) + ",\"digest\":" + api_str(SURFACE_DIGEST) + "}";
    let reply = api_unix_exchange(path, line);
    if len(reply) == 0 { return api_lost("the socket " + path + " gave no answer"); }
    if std::json::find_bool_field(reply, "ok") {
        return ApiRaw { outcome: 0, body: std::json::find_field_raw(reply, "value") };
    }
    let error = std::json::find_field_raw(reply, "error");
    if len(error) > 0 { return ApiRaw { outcome: 1, body: error }; }
    let refusal = std::json::find_field_raw(reply, "refusal");
    if len(refusal) == 0 { return api_lost("the socket answered a line that is no outcome: " + reply); }
    return api_refused(refusal, 0);
}

// One call of a member: its request as JSON in, its outcome out. A bearer is
// named for HTTP (and a hub); a socket's caller is its peer.
fn api_call(endpoint: String, bearer: String, member: String, payload: String) -> ApiRaw {
    if std::str::starts_with(endpoint, "http://") { return api_http(endpoint, bearer, member, payload); }
    if std::str::starts_with(endpoint, "https://") { return api_lost("TLS is not spoken by this client"); }
    if std::str::starts_with(endpoint, "ws://") { return api_lost("a hub endpoint carries streams: subscribe to one"); }
    if std::str::starts_with(endpoint, "unix:") { return api_unix(endpoint[5..len(endpoint)], member, payload); }
    return api_unix(endpoint, member, payload);
}

// ---- the description the exposure serves the caller ----

fn api_get(url: String, bearer: String) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let u = std::http::parse_url(url) or raise;
    let auth = if len(bearer) > 0 { "Authorization: Bearer " + bearer + "\r\n" } else { "" };
    let req = std::http::ClientRequest { method: "GET", url: u, headers: auth + "Accept: application/json", body: std::bytes::from_string("") };
    return std::http::request(req) or raise;
}

// The description the endpoint serves this caller (`{"describe": true}` over a
// socket, `GET /.description` over HTTP and at a hub), as the bytes it
// served; "" when it could not be read.
fn api_describe(endpoint: String, bearer: String) -> String {
    if std::str::starts_with(endpoint, "http://") {
        let r = api_get(endpoint + "/.description", bearer) or std::http::ClientResponse { status: 0, body: std::bytes::from_string("") };
        return if r.status == 200 { std::str::from_bytes(r.body) } else { "" };
    }
    if std::str::starts_with(endpoint, "ws://") {
        let r = api_get("http://" + endpoint[5..len(endpoint)] + "/.description", bearer) or std::http::ClientResponse { status: 0, body: std::bytes::from_string("") };
        return if r.status == 200 { std::str::from_bytes(r.body) } else { "" };
    }
    let path = if std::str::starts_with(endpoint, "unix:") { endpoint[5..len(endpoint)] } else { endpoint };
    return std::json::find_field_raw(api_unix_exchange(path, "{\"describe\":true}"), "value");
}

// Whether the description this caller is served lists `member`: a caller
// whose roles do not admit a member is not told of it.
fn api_lists(endpoint: String, bearer: String, member: String) -> Bool {
    return std::str::contains(api_describe(endpoint, bearer), "\"name\":" + api_str(member));
}

// ---- over a hub: WebSocket text frames, one JSON object each ----

locus ApiWs {
    params {
        stream: std::io::tcp::Stream = std::io::tcp::Stream { conn_fd: -1, owns_fd: false };
        inbuf: Bytes = std::bytes::from_string("");
        open: Bool = false;
        why: String = "";
        text: String = "";
        timed: Bool = false;
    }
    // The upgrade, the credential in `Authorization: Bearer`.
    @unbounded
    fn connect(endpoint: String, bearer: String) -> Bool {
        if !std::str::starts_with(endpoint, "ws://") {
            self.why = "a stream is a hub's: the endpoint is ws://host:port";
            return false;
        }
        let hostport = endpoint[5..len(endpoint)];
        let colon = std::str::index_of(hostport, ":");
        if colon < 0 {
            self.why = "the endpoint " + endpoint + " names no port";
            return false;
        }
        let host = hostport[0..colon];
        let port = std::str::parse_int(hostport[(colon + 1)..len(hostport)]) or 0;
        let fd = std::io::tcp::connect(host, port) or - 1;
        if fd < 0 {
            self.why = "the hub at " + endpoint + " cannot be reached";
            return false;
        }
        std::io::tcp::set_nodelay(fd, true) or discard;
        std::io::tcp::__set_recv_timeout_ns(fd, 100000000);
        self.stream = std::io::tcp::Stream { conn_fd: fd, owns_fd: true };
        let auth = if len(bearer) > 0 { "Authorization: Bearer " + bearer + "\r\n" } else { "" };
        self.stream.send("GET / HTTP/1.1\r\nHost: " + hostport + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + API_WS_KEY + "\r\nSec-WebSocket-Version: 13\r\n" + auth + "\r\n") or discard;
        let until = std::time::monotonic_ns() + API_WAIT_NS;
        let mut head = "";
        while std::time::monotonic_ns() < until && std::str::index_of(head, "\r\n\r\n") < 0 {
            let chunk = self.stream.recv_bytes(1) or std::bytes::from_string("");
            if len(chunk) > 0 { head = head + std::str::from_bytes(chunk); }
        }
        if !std::str::starts_with(head, "HTTP/1.1 101") {
            self.why = "the hub did not upgrade: " + head;
            return false;
        }
        self.open = true;
        return true;
    }
    // One masked text frame (opcode 1), or a control frame's payload.
    fn write_frame(op: Int, text: String) {
        let payload = std::bytes::from_string(text);
        let n = len(payload);
        let mb = std::bytes::BytesBuilder { };
        mb.append_u8(128 + op);
        if n < 126 {
            mb.append_u8(128 + n);
        } else {
            mb.append_u8(128 + 126);
            mb.append_u16_be(n);
        }
        mb.append_u32_le(API_MASK);
        mb.xor_mask(payload, API_MASK);
        let out = mb.finish() or std::bytes::from_string("");
        self.stream.send_bytes(out) or { self.open = false; };
    }
    fn send_text(text: String) {
        self.write_frame(1, text);
    }
    // The next text message within `wait_ns`: "" when none came (the
    // connection is still `open`) or when the connection ended (it is not).
    @unbounded
    fn read_text(wait_ns: Int) -> String {
        let until = std::time::monotonic_ns() + wait_ns;
        while self.open {
            let state = self.parse_one();
            if state == 2 { return self.text; }
            if state == 0 {
                if std::time::monotonic_ns() >= until { return ""; }
                self.timed = false;
                let began = std::time::monotonic_ns();
                let chunk = self.stream.recv_bytes(65536) or self.nothing(err.kind);
                if len(chunk) > 0 {
                    self.inbuf = std::bytes::concat(self.inbuf, chunk);
                } else if !self.timed && std::time::monotonic_ns() - began < 50000000 {
                    // an empty read that came at once is the peer's end; one that
                    // waited out the socket's timeout is a wait that gave nothing
                    self.open = false;
                }
            }
        }
        return "";
    }
    // A read that failed: a timeout is the wait running out, anything else
    // is the connection ending.
    fn nothing(kind: String) -> Bytes {
        self.timed = kind == "timeout" || kind == "would_block";
        if !self.timed { self.open = false; }
        return std::bytes::from_string("");
    }
    // One server frame (unmasked), if the buffer holds one: 0 when it does
    // not, 1 for a control frame (answered here), 2 for a text frame, whose
    // text is `self.text`.
    fn parse_one() -> Int {
        let n = len(self.inbuf);
        if n < 2 { return 0; }
        let b0 = std::bytes::at(self.inbuf, 0) or 0;
        let b1 = std::bytes::at(self.inbuf, 1) or 0;
        let op = b0 % 16;
        let mut plen = b1 % 128;
        let mut off = 2;
        if plen == 126 {
            if n < 4 { return 0; }
            plen = std::bytes::read_u16_be(self.inbuf, 2) or 0;
            off = 4;
        } else if plen == 127 {
            if n < 10 { return 0; }
            plen = std::bytes::read_u64_be(self.inbuf, 2) or 0;
            off = 10;
        }
        if n < off + plen { return 0; }
        let body = std::str::from_bytes(std::bytes::slice(self.inbuf, off, off + plen));
        self.inbuf = std::bytes::slice(self.inbuf, off + plen, n);
        if op == 8 {
            self.write_frame(8, "");
            self.open = false;
            return 1;
        }
        if op == 9 {
            self.write_frame(10, body);
            return 1;
        }
        if op == 1 {
            self.text = body;
            return 2;
        }
        return 1;
    }
}
