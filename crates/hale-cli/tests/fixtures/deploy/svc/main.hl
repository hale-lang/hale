type Beat {
    n: Int;
}

topic Tick {
    payload: Beat;
    subject: "svc.tick";
}

locus Worker {
    bus {
        publish Tick;
    }
    run() {
        Tick <- Beat { n: 1 };
    }
}

main locus App {
    params {
        probes: std::observe::Probes = std::observe::Probes { port: 9090 };
        metrics: std::observe::Scrape = std::observe::Scrape { host: "0.0.0.0", port: 9100 };
    }
    placement {
        metrics: pinned;
    }
    bindings {
        Tick: unix("/tmp/svc.tick.sock");
    }
    run() {
        Worker { };
    }
}

fn main() {
    App { };
}
