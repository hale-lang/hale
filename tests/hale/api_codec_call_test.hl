// tests/hale/api_codec_call_test.hl — a program calls the api codec itself
// (spec/api.md § Codecs, a program's own use of the codec). With no surface
// at all, `T::api_decode(text)` reads the wire a row of `T` would cross, as
// strictly, and `T::api_encode(value)` writes it: nested records, a list, an
// instant, a quantity by its count, an optional field, an enum (a field, and
// whole, whose refusals name `payload`) and a wire map, optional too.

unit cent;
type Money = quantity Int in cent;

type Line { sku: String; qty: Int; }
type Order {
    id: Int;
    lines: bounded[Line; 3];
    total: Money;
    at: Time;
    note: String;
    has_note: Bool;
}

type Status = enum { Open, Held(String), Moved(Int, Int) };
type Check { name: String; ok: Bool; }
type Desk {
    status: Status;
    checks: bounded[Check; 2] indexed_by name;
    spare: bounded[Check; 2] indexed_by name;
    has_spare: Bool;
}

fn main() {
    let text = "{\"id\":7,\"lines\":[{\"sku\":\"a\",\"qty\":2},{\"sku\":\"b\",\"qty\":1}],\"total\":1250,\"at\":\"2026-10-17T09:00:00Z\"}";
    let o = Order::api_decode(text) or {
        std::test::assert(false, "a valid order: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert_eq_int(count(o.lines), 2, "the lines");
    std::test::assert(o.total == 1250 * 1cent, "a quantity by its count");
    std::test::assert(!o.has_note, "an absent optional field");
    std::test::assert_eq_str(Order::api_encode(o), text, "written back as it was read");

    // the same strictness as a served row
    let wrong = Order::api_decode("{\"id\":\"7\"}") or {
        std::test::assert_eq_str(err.kind + ": " + err.field, "wrong_type: id", "a value of the wrong kind");
        Order { id: 0, total: 0 * 1cent, at: `1970-01-01T00:00:00Z`, note: "", has_note: false }
    };
    std::test::assert_eq_int(wrong.id, 0, "refused, the substitute");
    let missing = Line::api_decode("{\"sku\":\"x\"}") or {
        std::test::assert_eq_str(err.kind + ": " + err.field, "missing_field: qty", "a missing field");
        Line { sku: "", qty: -1 }
    };
    std::test::assert_eq_int(missing.qty, -1, "refused, the substitute");
    let long = Order::api_decode("{\"id\":1,\"lines\":[{\"sku\":\"a\",\"qty\":1},{\"sku\":\"b\",\"qty\":1},{\"sku\":\"c\",\"qty\":1},{\"sku\":\"d\",\"qty\":1}],\"total\":0,\"at\":\"2026-10-17T09:00:00Z\"}") or {
        std::test::assert_eq_str(err.kind + ": " + err.field, "too_long: lines", "more lines than the list holds");
        Order { id: 0, total: 0 * 1cent, at: `1970-01-01T00:00:00Z`, note: "", has_note: false }
    };
    std::test::assert_eq_int(long.id, 0, "refused, the substitute");

    // an enum whole: its variant, and its refusals name the payload
    let held = Status::api_decode("{\"Held\":\"at the door\"}") or {
        std::test::assert(false, "a valid status: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert_eq_str(Status::api_encode(held), "{\"Held\":\"at the door\"}", "an enum written back");
    std::test::assert_eq_str(Status::api_encode(Status::Moved(2, -3)), "{\"Moved\":[2,-3]}", "several values");
    std::test::assert_eq_str(Status::api_encode(Status::Open), "\"Open\"", "a payload-free variant");
    let unknown = Status::api_decode("\"Gone\"") or {
        std::test::assert_eq_str(err.kind + ": " + err.field, "wrong_type: payload", "an unknown variant");
        Status::Open
    };
    std::test::assert_eq_str(Status::api_encode(unknown), "\"Open\"", "refused, the substitute");

    // a wire map, and an optional one: absent (no key written), present
    // and empty, present with entries
    let absent = Desk::api_decode("{\"status\":\"Open\",\"checks\":{\"db\":{\"ok\":true}}}") or {
        std::test::assert(false, "a desk with no spare: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert(!absent.has_spare, "an absent optional map");
    std::test::assert_eq_str(Desk::api_encode(absent), "{\"status\":\"Open\",\"checks\":{\"db\":{\"ok\":true}}}", "an absent map is not written");
    let empty = Desk::api_decode("{\"status\":\"Open\",\"spare\":{}}") or {
        std::test::assert(false, "a desk with an empty spare: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert(empty.has_spare, "a present empty optional map");
    std::test::assert_eq_str(Desk::api_encode(empty), "{\"status\":\"Open\",\"checks\":{},\"spare\":{}}", "a present empty map is written");
    let nulled = Desk::api_decode("{\"status\":{\"Moved\":[1,2]},\"spare\":null}") or {
        std::test::assert(false, "a desk with a null spare: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert(!nulled.has_spare, "a null optional map is absent");
    let full = Desk::api_decode("{\"status\":\"Open\",\"spare\":{\"a\":{\"ok\":false},\"b\":{\"ok\":true}}}") or {
        std::test::assert(false, "a desk with a spare: " + err.kind + " " + err.field);
        return;
    };
    std::test::assert(full.has_spare, "a present optional map");
    std::test::assert_eq_int(count(full.spare), 2, "its entries");
    std::test::assert_eq_str(Desk::api_encode(full), "{\"status\":\"Open\",\"checks\":{},\"spare\":{\"a\":{\"ok\":false},\"b\":{\"ok\":true}}}", "written back in order");
    let dup = Desk::api_decode("{\"status\":\"Open\",\"spare\":{\"a\":{\"ok\":false},\"a\":{\"ok\":true}}}") or {
        std::test::assert_eq_str(err.kind + ": " + err.field, "duplicate_key: spare", "a key twice in an optional map");
        Desk { status: Status::Open, has_spare: false }
    };
    std::test::assert(!dup.has_spare, "refused, the substitute");
}
