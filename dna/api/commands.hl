    fn outcome(o: Outcome, ctx: std::api::Context) -> CommandReply {
        return self.submit(
            ctx,
            CommandRequest {
                request_id: o.request_id,
                operation: "dna.attempt.outcome",
                target_kind: "dna.attempt",
                target_id: o.attempt_id,
                subject_digest: lease_of(o.holder, o.token),
                attempt_id: o.attempt_id,
                holder: o.holder,
                token: o.token,
                effect_class: o.effect_class,
                disposition: o.disposition,
                result: o.result,
                result_ref: o.result_ref,
                narrative: o.narrative,
                evidence: if o.evidence == "[]" {
                    ""
                } else {
                    o.evidence
                }, receipts: if o.receipts == "[]" {
                    ""
                } else {
                    o.receipts
                },
                hat_digest: o.hat_digest,
                hat_head: o.hat_head,
                hat_watermark: o.hat_watermark,
                prompt_digest: o.prompt_digest,
                renderer: o.renderer });
    }
    fn renew(r: Renewal, ctx: std::api::Context) -> CommandReply {
