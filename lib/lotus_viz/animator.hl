// animator.hl — transient per-petal animation state.
//
// Tracks Born / Dying / Spotlit / Pulsing animations per
// petal id. Renderer queries this on every frame to derive
// current scale / alpha / color-tint values for each petal.
//
// Ambient sway is global (no per-petal record) — computed
// directly from (now_ns, petal_index) at query time.
//
// Pinned by DESIGN.md § "Animations".

// ---- Animation kinds ----

// 0 = Born — scale grow-in + alpha fade-in
// 1 = Dying — scale shrink + alpha fade-out + droop
// 2 = Spotlit — saturation + glow boost; held until cleared
// 3 = Pulsing — color-tint cycle + subtle scale pulse

// ---- The animation record ----

type Animation {
    petal_id:    String = "";
    kind:        Int    = 0;
    start_ns:    Int    = 0;

    // Spotlit has no natural end — true while in the active
    // spotlight set. Pulsing has remaining_cycles. Born /
    // Dying expire at start_ns + duration_ns.
    duration_ns:    Int = 0;       // 0 for spotlit
    pulse_color_r:  Int = 255;     // pulse tint (rgba)
    pulse_color_g:  Int = 255;
    pulse_color_b:  Int = 255;
    pulse_repeats:  Int = 0;
}

// ---- The animator locus ----
//
// Holds the active animations as a vec. Methods for adding /
// removing / querying. Ticked implicitly by `now_ns` arg on
// every query (no separate run() loop — the renderer's
// frame loop drives time).

@form(vec)
locus AnimationList {
    capacity { heap items of Animation; }
}

locus Animator {
    params {
        animations: AnimationList = AnimationList { };
    }

    // ---- Adding animations ----

    fn start_born(petal_id: String, now_ns: Int) {
        let d_ns = BORN_DURATION_MS * 1_000_000;
        self.animations.push(Animation {
            petal_id:    petal_id,
            kind:        0,
            start_ns:    now_ns,
            duration_ns: d_ns,
        });
    }

    fn start_dying(petal_id: String, now_ns: Int) {
        let d_ns = DYING_DURATION_MS * 1_000_000;
        self.animations.push(Animation {
            petal_id:    petal_id,
            kind:        1,
            start_ns:    now_ns,
            duration_ns: d_ns,
        });
    }

    // Spotlight semantics: clear all existing spotlights and
    // set the new ones. (The agent's spotlight channel
    // replaces the active set rather than adding to it.)
    fn set_spotlight(petal_ids: [String], now_ns: Int) {
        self.clear_kind(2);
        let n = len(petal_ids);
        let mut i = 0;
        while i < n {
            self.animations.push(Animation {
                petal_id:    petal_ids[i],
                kind:        2,
                start_ns:    now_ns,
                duration_ns: 0,
            });
            i = i + 1;
        }
    }

    fn clear_spotlight() {
        self.clear_kind(2);
    }

    fn start_pulse(petal_id: String, r: Int, g: Int, b: Int, repeats: Int, now_ns: Int) {
        let mut cycles = repeats;
        if cycles <= 0 {
            cycles = PULSE_DEFAULT_REPEATS;
        }
        let total_ns = (PULSE_CYCLE_MS * cycles) * 1_000_000;
        self.animations.push(Animation {
            petal_id:       petal_id,
            kind:           3,
            start_ns:       now_ns,
            duration_ns:    total_ns,
            pulse_color_r:  r,
            pulse_color_g:  g,
            pulse_color_b:  b,
            pulse_repeats:  cycles,
        });
    }

    // ---- Per-frame tick: expire animations whose time is up ----
    //
    // Called once per frame from the renderer. Walks the vec
    // and removes finished animations. Spotlit entries never
    // expire here — they're cleared explicitly.

    fn tick(now_ns: Int) {
        let mut i = 0;
        while i < self.animations.len() {
            let a = self.animations.get(i) or raise;
            let mut expired = false;
            if a.kind == 0 || a.kind == 1 || a.kind == 3 {
                if now_ns >= (a.start_ns + a.duration_ns) {
                    expired = true;
                }
            }
            if expired {
                // Swap-remove: replace with last, pop last.
                // Cheap O(1) removal that doesn't preserve
                // order — fine, we don't depend on it.
                let last_idx = self.animations.len() - 1;
                if i != last_idx {
                    let last = self.animations.get(last_idx) or raise;
                    self.animations.set(i, last) or raise;
                }
                let _ = self.animations.pop() or raise;
                // Don't advance i — re-process this slot.
            } else {
                i = i + 1;
            }
        }
    }

    // ---- Queries — renderer reads these per petal per frame ----

    // Current scale factor for this petal. 1.0 in steady state;
    // 0..1 during Born grow-in; 1..0.7 during Dying; subtle
    // pulse oscillation during Pulsing.
    fn scale_for(petal_id: String, now_ns: Int) -> Float {
        let mut scale = 1.0;
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.petal_id == petal_id {
                if a.kind == 0 {
                    // Born: 0 → 1, ease-out-cubic on t.
                    let t = clamp01(elapsed_t(a, now_ns));
                    scale = scale * ease_out_cubic(t);
                }
                if a.kind == 1 {
                    // Dying: 1 → 0.7, ease-in.
                    let t = clamp01(elapsed_t(a, now_ns));
                    scale = scale * (1.0 - (0.3 * ease_in_cubic(t)));
                }
                if a.kind == 3 {
                    // Pulsing: 1.0 → 1.05 → 1.0 per cycle.
                    let cycle_t = pulse_phase(a, now_ns);
                    let bump = 0.05 * sin_approx(cycle_t * two_pi());
                    scale = scale * (1.0 + bump);
                }
            }
            i = i + 1;
        }
        return scale;
    }

    // Alpha multiplier — 1.0 steady; 0..1 during Born fade-in;
    // 1..0 during Dying fade-out.
    fn alpha_for(petal_id: String, now_ns: Int) -> Float {
        let mut alpha = 1.0;
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.petal_id == petal_id {
                if a.kind == 0 {
                    let t = clamp01(elapsed_t(a, now_ns));
                    alpha = alpha * t;
                }
                if a.kind == 1 {
                    let t = clamp01(elapsed_t(a, now_ns));
                    alpha = alpha * (1.0 - t);
                }
            }
            i = i + 1;
        }
        return alpha;
    }

    // Dying petals droop downward — z offset that grows with
    // the dying animation's progress.
    fn z_offset_for(petal_id: String, now_ns: Int) -> Float {
        let mut dz = 0.0;
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.petal_id == petal_id && a.kind == 1 {
                let t = clamp01(elapsed_t(a, now_ns));
                dz = dz + (0.5 * ease_in_cubic(t));   // downward
            }
            i = i + 1;
        }
        return 0.0 - dz;
    }

    // Is this petal currently in the spotlit set?
    fn is_spotlit(petal_id: String) -> Bool {
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.kind == 2 && a.petal_id == petal_id {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // Is ANY petal currently spotlit? (Used by renderer to
    // know whether to apply spotlight de-emphasis to
    // non-spotlit petals.)
    fn any_spotlit() -> Bool {
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.kind == 2 { return true; }
            i = i + 1;
        }
        return false;
    }

    // Pulse-tint mix factor for this petal. 0 if not pulsing;
    // otherwise 0..1 oscillation against the pulse color.
    // Pulse-tint color via pulse_tint_color_for below.
    fn pulse_mix_for(petal_id: String, now_ns: Int) -> Float {
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.kind == 3 && a.petal_id == petal_id {
                let cycle_t = pulse_phase(a, now_ns);
                // 0 → 1 → 0 over each cycle. Use half-sine.
                let mix = sin_approx(cycle_t * pi());
                if mix < 0.0 { return 0.0; }
                return mix;
            }
            i = i + 1;
        }
        return 0.0;
    }

    // Returns the pulse color (rgb) for a pulsing petal, or
    // (255,255,255) if not pulsing — caller should check
    // pulse_mix_for > 0 to know whether to apply.
    fn pulse_tint_color_for(petal_id: String) -> [Int; 3] {
        let n = self.animations.len();
        let mut i = 0;
        while i < n {
            let a = self.animations.get(i) or raise;
            if a.kind == 3 && a.petal_id == petal_id {
                return [a.pulse_color_r, a.pulse_color_g, a.pulse_color_b];
            }
            i = i + 1;
        }
        return [255, 255, 255];
    }

    // Ambient sway: per-petal rotation around stem axis. Uses
    // petal_index to seed phase so the flower doesn't sway
    // in lockstep.
    fn sway_radians(petal_index: Int, now_ns: Int) -> Float {
        let now_s = (now_ns + 0.0) / 1_000_000_000.0;
        let phase = (petal_index + 0.0) * 0.37;   // arbitrary; primes-ish to avoid alignment
        let omega = two_pi() / (SWAY_PERIOD_MS / 1000.0);
        let max_rad = (SWAY_MAX_DEGREES * pi()) / 180.0;
        return max_rad * sin_approx((now_s * omega) + phase);
    }

    // ---- Internal helpers ----

    fn clear_kind(kind: Int) {
        let mut i = 0;
        while i < self.animations.len() {
            let a = self.animations.get(i) or raise;
            if a.kind == kind {
                let last_idx = self.animations.len() - 1;
                if i != last_idx {
                    let last = self.animations.get(last_idx) or raise;
                    self.animations.set(i, last) or raise;
                }
                let _ = self.animations.pop() or raise;
            } else {
                i = i + 1;
            }
        }
    }
}

// ---- Easing helpers ----

fn clamp01(t: Float) -> Float {
    if t < 0.0 { return 0.0; }
    if t > 1.0 { return 1.0; }
    return t;
}

fn elapsed_t(a: Animation, now_ns: Int) -> Float {
    if a.duration_ns <= 0 { return 1.0; }
    let elapsed = now_ns - a.start_ns;
    return (elapsed + 0.0) / (a.duration_ns + 0.0);
}

fn ease_out_cubic(t: Float) -> Float {
    let inv = 1.0 - t;
    return 1.0 - (inv * inv * inv);
}

fn ease_in_cubic(t: Float) -> Float {
    return t * t * t;
}

// Pulse phase: cycle within the current pulse, returns [0, 1).
fn pulse_phase(a: Animation, now_ns: Int) -> Float {
    let cycle_ns = PULSE_CYCLE_MS * 1_000_000;
    let elapsed = now_ns - a.start_ns;
    let in_cycle = elapsed % cycle_ns;
    return (in_cycle + 0.0) / (cycle_ns + 0.0);
}
