// dna/api/project_service/tests/operator_face_test.hl — the operator face
// signs in through the stub issuer, then reads the habitat's state.
//
// The operator face is a project's `ui/` (the habitat's own, here the
// toolchain's copy of it in a project of the fixture) served by the standard
// face under `/app/` over a head that serves under OIDC, the stub issuer
// running as its own process. A visitor who is not signed in is refused as
// the head refuses every read (401), at the page and at the row the page
// calls; after the sign-in the stub's token opens a session, the face serves
// the shell, and the call the generated client makes
// (`Commands::index`, `head-client.js`) answers the record's index.

import "./fixture" as fixture;
import "../../../core" as dna;
import "../../../operations" as ops;
import "../../../oidc" as oidc;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

fn source() -> String {
    let given = if std::env::var_exists("HALE_DNA_SOURCE") {
        std::env::var("HALE_DNA_SOURCE")
    } else {
        "."
    };
    return dna::trim_nl(dna::run_tool("sh\n-c\ncd \"$1\" && pwd\nsh\n" + given).stdout);
}

// The stub provider's program, built from a copy of its sources in the
// fixture's root: the checkout's own directory is never written.
fn stub_binary(root: String) -> String {
    let dir = root + "/oidc";
    let copied = dna::run_tool(
        "sh\n-c\nmkdir -p \"$2/serve\" && cp \"$1/dna/oidc/stub.hl\" \"$2/\" && cp \"$1/dna/oidc/serve/main.hl\" \"$2/serve/\"\nsh\n"
            + source() + "\n" + dir,
    );
    std::test::assert_eq_int(copied.code, 0, "the stub's sources copied: " + copied.stderr);
    let built = dna::run_tool(toolchain() + "\nbuild\n" + dir + "/serve");
    std::test::assert_eq_int(
        built.code,
        0,
        "the stub provider builds: " + built.stdout + built.stderr,
    );
    return dir + "/serve/serve";
}

// `url` with the session in `jar` (a cookie jar file, "" for none).
fn get(url: String, jar: String) -> fixture::HttpResponse {
    return fixture::curl(
        "GET",
        url,
        if len(jar) > 0 { "Cookie: " + cookie_of(jar) } else { "" },
        "",
    );
}

// The row the generated client calls, as it calls it.
fn index_call(face: String, jar: String) -> fixture::HttpResponse {
    return fixture::curl(
        "POST",
        face + "/api/hale/v1/head/surface/call/Commands::index",
        "Content-Type: application/json\nHale-Surface-Digest: fnv1a64:a03807891b4f4f8c\nOrigin: "
            + face + (if len(jar) > 0 { "\nCookie: " + cookie_of(jar) } else { "" }),
        "{\"limit\": 200}",
    );
}

// The session cookie a jar holds, as `name=value`.
fn cookie_of(jar: String) -> String {
    let text = std::io::fs::read_file(jar) or "";
    let at = std::str::index_of(text, "dna_session");
    if at < 0 { return ""; }
    let rest = text[at..len(text)];
    let end = std::str::index_of(rest, "\n");
    let value = std::str::trim(
        std::str::replace(if end < 0 { rest } else { rest[0..end] }, "dna_session\t", ""),
    );
    return "dna_session=" + value;
}

fn main() {
    let root = dna::scratch_root("operator-face");
    let client_secret = dna::hex(std::os::getrandom(16) or b"");
    std::io::fs::mkdir(root + "/vault") or discard;
    std::io::fs::write_file(root + "/vault/oidc-client-dna-local", client_secret) or discard;
    std::io::fs::write_file(root + "/stub.pem", oidc::STUB_KEY) or discard;
    let chmod = dna::run_tool("chmod\n0600\n" + root + "/stub.pem");
    let port = dna::free_port(9);
    let issuer = "http://127.0.0.1:" + to_string(port);
    let stub_argv = "env\n-u\nHALE_VAULT_ADDR\nHALE_VAULT_DIR=" + root
        + "/vault\nHALE_DNA_OIDC_KEY_FILE=" + root + "/stub.pem\nHALE_DNA_OIDC_KEY_X="
        + oidc::STUB_X + "\nHALE_DNA_OIDC_KEY_Y=" + oidc::STUB_Y + "\n" + stub_binary(root) + "\n"
        + to_string(port) + "\ndna-local";
    let stub = std::process::spawn(stub_argv) or std::process::Child { };
    std::test::assert(stub.pid > 0, "the stub provider spawned");
    let watched = dna::run_tool(
        "sh\n-c\n(while kill -0 \"$1\" 2>/dev/null; do sleep 1; done; kill \"$2\" 2>/dev/null) </dev/null >/dev/null 2>&1 &\nsh\n"
            + to_string(std::process::pid()) + "\n" + to_string(stub.pid),
    );
    let mut waited = 0;
    while waited < 100
        && dna::run_tool(
            "curl\n-s\n-f\n-o\n/dev/null\n" + issuer + "/.well-known/openid-configuration",
        ).code != 0
    {
        std::time::sleep(100ms);
        waited = waited + 1;
    }

    std::io::fs::mkdir(root + "/head") or discard;
    let f = fixture::HeadFixture {
        root: root + "/head",
        face_port: dna::free_port(11),
        oidc_env: "HALE_DNA_OIDC_ISSUER=" + issuer
            + "\nHALE_DNA_OIDC_CLIENT=dna-local\nHALE_DNA_OIDC_MEMBER=local-sub=tester\nHALE_DNA_OIDC_KEY="
            + oidc::STUB_SPKI,
    };
    std::io::fs::mkdir(f.home + "/vault") or discard;
    std::io::fs::write_file(f.home + "/vault/oidc-client-dna-local", client_secret) or discard;

    // the project's `ui/` is the habitat's, as the toolchain ships it
    let copied = dna::run_tool(
        "cp\n-r\n" + source() + "/dna/habitat/ui\n" + f.project + "/ui",
    );
    std::test::assert_eq_int(copied.code, 0, "the operator face copied: " + copied.stderr);
    std::io::fs::write_file(
        f.project + "/README.md",
        "# head fixture\n\nIts page is [ui/](./ui/index.html).\n",
    ) or discard;
    let j = f.journal;
    let purpose = j.append(
        j.revision(),
        "graph.node",
        "purpose:shop",
        ops::graph_node_body("purpose", "shop", "Keep the shop honest.", ""),
    );
    std::test::assert(purpose.ok, "the record's purpose landed");
    let added = f.git("add\n-A");
    let committed = f.git("commit\n-q\n-m\nthe operator face");
    f.start_with_project(f.project, 0);
    f.start_face();
    let face = f.face_url();

    // not signed in: the page and the row are the head's refusal
    let bare = get(face + "/app/", "");
    std::test::assert(
        bare.status != 200 && !std::str::contains(bare.body, "id=\"crossing\""),
        "not signed in, the shell is not served: " + to_string(bare.status) + bare.body,
    );
    let refused = index_call(face, "");
    std::test::assert(
        refused.status == 401 && !std::str::contains(refused.body, "Keep the shop honest."),
        "not signed in, the row is refused: " + to_string(refused.status) + refused.body,
    );
    let forged = fixture::curl(
        "POST",
        face + "/api/hale/v1/head/surface/call/Commands::index",
        "Content-Type: application/json\nCookie: dna_session=forged",
        "{\"limit\": 200}",
    );
    std::test::assert_eq_int(forged.status, 401, "a forged session is refused: " + forged.body);

    // signed in through the face: the session opens
    let jar = root + "/jar";
    let signin = dna::run_tool(
        "curl\n-s\n-L\n-c\n" + jar + "\n-b\n" + jar + "\n-o\n/dev/null\n-w\n%{http_code}\n" + face
            + "/?token=" + f.token(),
    );
    std::test::assert(
        len(cookie_of(jar)) > 0,
        "the person signs in through the face: " + signin.stdout,
    );
    let shell = get(face + "/app/", jar);
    std::test::assert(
        shell.status == 200
            && std::str::contains(shell.body, "id=\"crossing\"")
            && std::str::contains(shell.body, "src=\"operator.js\""),
        "signed in, the face serves the operator shell: " + to_string(shell.status) + shell.body,
    );
    let client = get(face + "/app/head-client.js", jar);
    std::test::assert(
        client.status == 200 && std::str::contains(client.body, "export function commandsIndex"),
        "and the generated client of the head's rows",
    );
    let read = index_call(face, jar);
    std::test::assert(
        read.status == 200
            && std::str::contains(read.body, "Keep the shop honest.")
            && std::str::contains(read.body, "\"ok\":true"),
        "the call the client makes answers the record: " + to_string(read.status) + read.body,
    );

    f.stop();
    std::process::kill(stub) or discard;
    dna::scratch_done(root);
}
