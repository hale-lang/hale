// ProposalDispatcher — the mechanical outer loop that validates
// proposals against PermissionGate and routes them to ide.cmd.*
// channels. Single enforcement point for agent-driven mutations.
//
// Shape note: dispatcher is a namespace lotus (no state). The
// iris reference is passed in per call rather than held as a
// field, because Hale v0 doesn't admit forward references
// between sibling fields in a parent's defaults (FRICTION F.4).
// Iris's on_proposal handler is the bus subscriber and forwards
// to dispatcher.handle(self, p).

import "lib/raylib" as ray;

locus ProposalDispatcher {
    params { }

    bus {
        publish ProposalApplied;
        publish ProposalDenied;
        publish SrcOpenCmd;
        publish VizCameraCmd;
        publish VizModeCmd;
    }

    fn handle(iris: Iris, p: Proposal) {
        // ide.cmd.gate.set is always denied for proposals.
        if p.channel == "ide.cmd.gate.set" {
            self.deny(p, "agent cannot mutate gate state");
            return;
        }

        if !is_known_channel(p.channel) {
            self.deny(p, "unknown channel");
            return;
        }

        let pane = pane_for_channel(p.channel);
        let op   = op_for_channel(p.channel);
        if !iris.gate.allows(pane, op) {
            self.deny(p, "pane locked");
            return;
        }

        self.dispatch_to_channel(iris, p);
    }

    fn dispatch_to_channel(iris: Iris, p: Proposal) {
        // source.open — publishes onto SrcOpenCmd. SourcePane
        // subscribes; updates current_path + emits SourceChanged
        // (which VizPane forwards into the active scene).
        if p.channel == "ide.cmd.source.open" {
            let path = std::json::find_string_field(p.payload, "path");
            let line = std::json::find_int_field(p.payload, "line");
            SrcOpenCmd <- SourceOpen { path: path, line: line };
            self.apply(p);
            return;
        }

        // viz.camera — publishes onto VizCameraCmd. VizPane
        // subscribes; calls active_scene.set_camera.
        if p.channel == "ide.cmd.viz.camera" {
            // Phase 3 placeholder: real impl parses position +
            // target Vec3 from payload (needs std::json float
            // support). For now: reset to default camera so the
            // routing path is exercised even if values aren't.
            let _ = iris;
            let _ = p.payload;
            VizCameraCmd <- ray::Camera3D { };
            self.apply(p);
            return;
        }

        // viz.mode — publishes onto VizModeCmd.
        if p.channel == "ide.cmd.viz.mode" {
            let m = std::json::find_string_field(p.payload, "mode");
            VizModeCmd <- VizMode { mode: m };
            self.apply(p);
            return;
        }

        // ide.cmd.viz.scene.<method> — scene-defined channel.
        // Delegates to the active scene's dispatch method. Each
        // scene declares its accepted channels via channels_json()
        // (discoverable through MCP viz.scene_info).
        if dispatch_starts_with(p.channel, "ide.cmd.viz.scene.") {
            iris.viz.active_scene.dispatch(p.channel, p.payload);
            self.apply(p);
            return;
        }

        self.deny(p, "channel known but not yet dispatchable");
    }

    fn apply(p: Proposal) {
        ProposalApplied <- Applied {
            proposal_id: p.id,
            channel:     p.channel,
        };
    }

    fn deny(p: Proposal, why: String) {
        ProposalDenied <- Denial {
            proposal_id: p.id,
            channel:     p.channel,
            why:         why,
        };
    }
}

// ---- Free fn helpers ----

fn is_known_channel(channel: String) -> Bool {
    if channel == "ide.cmd.source.open" { return true; }
    if channel == "ide.cmd.viz.camera"  { return true; }
    if channel == "ide.cmd.viz.mode"    { return true; }
    if dispatch_starts_with(channel, "ide.cmd.viz.scene.") { return true; }
    return false;
}

fn pane_for_channel(channel: String) -> String {
    if dispatch_starts_with(channel, "ide.cmd.source.") { return "source"; }
    if dispatch_starts_with(channel, "ide.cmd.shell.")  { return "shell"; }
    if dispatch_starts_with(channel, "ide.cmd.viz.")    { return "viz"; }
    if dispatch_starts_with(channel, "ide.cmd.agent.")  { return "agent"; }
    return "";
}

fn op_for_channel(channel: String) -> String {
    let _ = channel;
    return "write";
}

fn dispatch_starts_with(s: String, prefix: String) -> Bool {
    let n = len(prefix);
    if len(s) < n { return false; }
    let head = std::str::substring(s, 0, n);
    return head == prefix;
}
