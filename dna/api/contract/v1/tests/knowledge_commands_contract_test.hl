// Contract conformance only. Real Record admission and graph observation are
// exercised by the owning service and live API/browser acceptance harness.
import "../validator" as wire_contract;

locus KnowledgeCommandContractCases {
    params { root: String; }
    fn field(json: String, name: String, raw: String) -> String {
        let b = std::json::Builder { }; b.begin_object();
        let mut it = std::json::object_first(json);
        while !it.done {
            let key = std::json::obj_key_string(it, json);
            if key != name { b.field(key, std::json::obj_value_raw(it, json)); }
            it = std::json::object_next(it, json);
        }
        if len(raw) > 0 { b.field(name, raw); }
        b.end_object(); return b.result();
    }
    fn run_cases() {
        let files = wire_contract::ContractFiles { root: self.root };
        let checked = files.check();
        std::test::assert(checked.ok, checked.error);
        let schema = std::io::fs::read_file(self.root + "/schema.json") or raise;
        let spec = std::io::fs::read_file(self.root + "/openapi.json") or raise;
        let paths = std::json::find_field_raw(spec, "paths");
        let name = "/api/hale/v1/applications/{application_id}/dna/knowledge/commands";
        let route = std::json::find_field_raw(paths, name);
        let post = std::json::find_field_raw(route, "post");
        let get = std::json::find_field_raw(route, "get");
        let responses = std::json::find_field_raw(post, "responses");
        let terminal = self.field(post, "responses", self.field(responses, "200", std::json::find_field_raw(responses, "202")));
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, name, self.field(route, "post", terminal))), schema).ok, "Knowledge POST cannot advertise projected or terminal 200 success");
        let body = "{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"./schema.json#/$defs/CommandRequest\"}}}}";
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, name, self.field(route, "post", self.field(post, "requestBody", body)))), schema).ok, "Knowledge uses its own operation envelope, not the governance namespace");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, name, self.field(route, "get", self.field(get, "parameters", "[]")))), schema).ok, "Knowledge lookup requires exact request_id");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, name, "")), schema).ok, "Knowledge command route cannot be omitted");
        let capability_name = name + "/capability";
        let capability = std::json::find_field_raw(paths, capability_name);
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, capability_name, self.field(capability, "post", post))), schema).ok, "Knowledge capability remains GET only");
        let capability_get = std::json::find_field_raw(capability, "get");
        std::test::assert(!files.knowledge_capability_parameters(self.field(capability_get, "parameters", "[]")).ok, "Knowledge capability advertises operation selection");
        let parameter = std::json::array_first(std::json::find_field_raw(capability_get, "parameters")).element;
        std::test::assert(!files.knowledge_capability_parameters(self.field(capability_get, "parameters", "[" + self.field(parameter, "required", "true") + "]")).ok, "omitted operation retains default link compatibility");
        std::test::assert(!files.knowledge_capability_parameters(self.field(capability_get, "parameters", "[" + parameter + "," + parameter + "]")).ok, "capability query cannot duplicate operation");
        let candidate_name = "/api/hale/v1/applications/{application_id}/dna/reviews/candidate";
        let candidate = std::json::find_field_raw(paths, candidate_name); let candidate_get = std::json::find_field_raw(candidate, "get");
        std::test::assert(!files.candidate_parameters(self.field(candidate_get, "parameters", "[]")).ok, "binding candidate read requires exact Review identity and snapshot");
        let candidate_id = std::json::array_first(std::json::find_field_raw(candidate_get, "parameters")).element;
        std::test::assert(!files.candidate_parameters(self.field(candidate_get, "parameters", "[" + candidate_id + "," + candidate_id + "]")).ok, "binding candidate read cannot substitute duplicate id for snapshot");
        std::test::assert(!files.openapi(self.field(spec, "paths", self.field(paths, candidate_name, "")), schema).ok, "exact binding candidate read cannot be omitted");
        println("Knowledge command contract: fixtures and focused OpenAPI checks passed");
    }
}

fn main() {
    let root = if std::env::var_exists("HALE_API_CONTRACT_ROOT") { std::env::var("HALE_API_CONTRACT_ROOT") } else { "dna/api/contract/v1" };
    let cases = KnowledgeCommandContractCases { root: root }; cases.run_cases();
}
