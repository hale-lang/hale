// AgentBackend interface (F.20). Source of truth: PLUGINS.md §
// "AgentBackend".
//
// Backends are loci satisfying this interface structurally — no
// `impl I for L` declaration. All results stream out via bus
// events (AgentChunk / AgentToolCall / AgentTurnDone / AgentError
// / AgentReady), not return values, so the harness is decoupled
// from any particular backend's transport.

interface AgentBackend {
    fn name() -> String;
    fn model() -> String;
    fn is_ready() -> Bool;
    fn load_history();
    fn submit_user_input(prompt: String);
    fn submit_tool_result(tool_call_id: String, result_json: String);
    fn cancel();
}
