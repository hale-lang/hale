// dna/core/knowledge.hl — semantic memory (#521 comment 1; the
// service that owns the graph is dna/knowledge, GH #583 K1).
//
// `Knowledge` is a locus that owns domain data: ideas, edges, bindings
// and revisions are pure cells in its forms, in exactly one tower
// (I4). Authorship direction IS the classification — parent-authored
// knowledge bound to a child is a GOAL, child-authored bound to a
// parent is a CONCERN, self-authored bound locally is an INITIATIVE —
// computed from the tower, never a tag that can contradict it. Task
// history never becomes knowledge by itself: an Attempt PROPOSES, and
// only the distillation/review path commits a revision. A performer
// receives a bounded ContextPackage with a digest and a revision, not
// the store.

type Idea {
    id: String = "";
    kind: String = "idea"; // "idea" | "concept" | "practice" | "task_concept"
    text: String = "";
    author: String = ""; // a locus path, e.g. "app/support"
    provenance: String = ""; // "declared" | "observed" | "inferred" | "proposed" | "ratified"
    revision: Int = 0;
    accepted: Bool = false;
}

type KnowledgeEdge { from: String = ""; to: String = ""; rel: String = ""; }

type KnowledgeBinding {
    idea: String = "";
    target: String = ""; // locus path the idea is bound to
    author: String = ""; // who bound it
    class: String = ""; // derived: "goal" | "concern" | "initiative"
}

type ContextPackage {
    target: String = "";
    revision: Int = 0;
    digest: String = "";
    included: String = ""; // idea ids, space-separated
    included_n: Int = 0;
    omitted_n: Int = 0; // what this projection left out, stated
    data_class: String = "";
    text: String = ""; // the ideas rendered, one per line, for an objective (GH #583 K2)
    error: String = ""; // why the service could not answer, when it could not
}

fn is_ancestor(a: String, b: String) -> Bool {
    // "app" is an ancestor of "app/support/intake"
    return len(b) > len(a) && std::str::starts_with(b, a + "/");
}

fn classify_binding(author: String, target: String) -> String {
    if author == target { return "initiative"; }
    if is_ancestor(author, target) { return "goal"; }
    if is_ancestor(target, author) { return "concern"; }
    return "lateral"; // siblings do not privately coordinate (H9)
}

@form(vec)
locus IdeaRows { capacity { heap rows of Idea; } }
@form(vec)
locus EdgeRows { capacity { heap rows of KnowledgeEdge; } }
@form(vec)
locus BindingRows { capacity { heap rows of KnowledgeBinding; } }

locus Knowledge {
    params {
        ideas: IdeaRows = IdeaRows { };
        edges: EdgeRows = EdgeRows { };
        bindings: BindingRows = BindingRows { };
        proposals: IdeaRows = IdeaRows { };
        revision: Int = 0;
        refused_lateral: Int = 0;
        refused_distill: Int = 0;
    }
    // Declared knowledge enters as an accepted revision with its
    // provenance kept.
    fn declare(i: Idea) -> Int {
        self.revision = self.revision + 1;
        self.ideas.push(Idea { id: i.id, kind: i.kind, text: i.text, author: i.author, provenance: i.provenance, revision: self.revision, accepted: true });
        return self.revision;
    }
    // An Attempt may PROPOSE; it cannot write.
    fn propose(i: Idea) -> Int {
        self.proposals.push(Idea { id: i.id, kind: i.kind, text: i.text, author: i.author, provenance: "proposed", revision: 0, accepted: false });
        return self.proposals.len() - 1;
    }
    fn proposal_count() -> Int { return self.proposals.len(); }
    // Distillation: an independent reviewer accepts a proposal into a
    // revision. The proposer cannot ratify their own proposal.
    fn distill(proposal: Int, reviewer: String, verdict: String) -> Bool {
        let p = self.proposals.get(proposal) or Idea { };
        if p.id == "" || p.accepted { self.refused_distill = self.refused_distill + 1; return false; }
        if reviewer == p.author { self.refused_distill = self.refused_distill + 1; return false; }
        if verdict != "approve" { return false; }
        self.revision = self.revision + 1;
        self.ideas.push(Idea { id: p.id, kind: p.kind, text: p.text, author: p.author, provenance: "ratified", revision: self.revision, accepted: true });
        self.proposals.set(proposal, Idea { id: p.id, kind: p.kind, text: p.text, author: p.author, provenance: "proposed", revision: self.revision, accepted: true }) or discard;
        return true;
    }
    fn link(from: String, to: String, rel: String) {
        self.edges.push(KnowledgeEdge { from: from, to: to, rel: rel });
    }
    // Binding direction is the classification; lateral is refused.
    fn bind(idea: String, target: String, author: String) -> String {
        let c = classify_binding(author, target);
        if c == "lateral" { self.refused_lateral = self.refused_lateral + 1; return c; }
        self.bindings.push(KnowledgeBinding { idea: idea, target: target, author: author, class: c });
        return c;
    }
    fn accepted_count() -> Int { return self.ideas.len(); }
    // Bounded by the store's size; one substitute struct per row scanned.
    @unbounded
    fn find(id: String) -> Idea {
        let mut i = 0;
        while i < self.ideas.len() {
            let x = self.ideas.get(i) or Idea { };
            if x.id == id { return x; }
            i = i + 1;
        }
        return Idea { };
    }
    // The bounded projection a performer receives: ideas bound to the
    // target or to any of its ancestors (goals flow down, initiatives
    // stay local), capped by `budget`, with the omission counted.
    @unbounded
    fn context_for(target: String, budget: Int, data_class: String) -> ContextPackage {
        let mut included = "";
        let mut omitted_ids = "";
        let mut n = 0;
        let mut omitted = 0;
        let mut i = 0;
        while i < self.bindings.len() {
            let b = self.bindings.get(i) or KnowledgeBinding { };
            let relevant = b.target == target || is_ancestor(b.target, target);
            // The same idea may be bound in several places; the package
            // carries it once.
            let seen = std::str::contains(included, b.idea + " ") || std::str::contains(omitted_ids, b.idea + " ");
            if relevant && !seen {
                let idea = self.find(b.idea);
                if idea.accepted {
                    if n < budget {
                        included = included + idea.id + " ";
                        n = n + 1;
                    } else {
                        omitted = omitted + 1;
                        omitted_ids = omitted_ids + idea.id + " ";
                    }
                }
            }
            i = i + 1;
        }
        let d = hex(std::crypto::sha256(std::bytes::from_string(target + "@" + to_string(self.revision) + ":" + included)));
        return ContextPackage { target: target, revision: self.revision, digest: d, included: included, included_n: n, omitted_n: omitted, data_class: data_class };
    }
}

// ---- the record's half (GH #583 K1) -----------------------------------
//
// A proposal is a document: canonical JSON with a fixed field order,
// filed as a receipt under its sha256, so a digest in the record
// always resolves to recoverable content. What the Review pins, what
// `knowledge.ratified` names, and what the knowledge service applies
// idempotently are all this digest.
fn knowledge_document(i: Idea, target: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("kind", i.kind);
    b.string_field("text", i.text);
    b.string_field("author", i.author);
    b.string_field("target", target);
    b.string_field("provenance", if len(i.provenance) > 0 { i.provenance } else { "proposed" });
    b.end_object();
    return b.result();
}

// The review id a proposal's digest is known by: `k:` and the first
// twelve hex digits.
fn knowledge_review_id(digest: String) -> String {
    let d = if std::str::starts_with(digest, "sha256:") { digest[7..len(digest)] } else { digest };
    return "k:" + d[0..12];
}

// ---- the client (GH #583 K2) ------------------------------------------
//
// What a position's OWNER holds to ask the knowledge service for a
// bounded package: never the editor, which the law keeps away from
// knowledge (`editors_never_learn`). The owner folds the package into
// the objective it hands down and names the package on the request, so
// the editor's `model.called` rows carry its digest and bindings. The
// URL comes from the environment by NAME (`url_env`; the host sets
// HALE_DNA_KNOWLEDGE_URL under `dev`), read at birth. Without a service
// the package is empty and says so; nothing waits on it.
locus KnowledgeClient {
    params {
        url: String = "";
        url_env: String = "";
        budget: Int = 8;
        asked: Int = 0;
        answered: Int = 0;
        last_error: String = "";
    }
    birth() {
        if len(self.url_env) > 0 && std::env::var_exists(self.url_env) { self.url = std::env::var(self.url_env); }
    }
    fn ready() -> Bool { return len(self.url) > 0; }
    // Called once per package request: bounded by the Mutations opened.
    @unbounded
    fn fetch_failed(e: std::http::HttpError) -> std::http::ClientResponse {
        self.last_error = e.kind + " " + e.detail;
        return std::http::ClientResponse { status: 0, body: b"" };
    }
    // The package for a locus path: the ids, the digest and the revision
    // the service computed, and the ideas rendered for an objective. The
    // query — what the work is about — ranks the bounded set (K3); an
    // empty query is ratification order.
    @unbounded
    fn package_for(target: String, query: String) -> ContextPackage {
        if !self.ready() { return ContextPackage { target: target, error: "no knowledge service" }; }
        self.asked = self.asked + 1;
        self.last_error = "";
        let q = if len(query) > 2000 { query[0..2000] } else { query };
        let resp = std::http::get(self.url + "/context?target=" + url_encode(target) + "&budget=" + to_string(self.budget) + (if len(q) > 0 { "&query=" + url_encode(q) } else { "" })) or self.fetch_failed(err);
        if resp.status != 200 {
            if len(self.last_error) == 0 { self.last_error = "http " + to_string(resp.status); }
            return ContextPackage { target: target, error: self.last_error };
        }
        let body = std::str::from_bytes(resp.body);
        self.answered = self.answered + 1;
        let out = std::str::builder_new();
        let ideas = std::json::find_field_raw(body, "ideas");
        if len(ideas) > 0 {
            let mut it = std::json::array_first(ideas);
            while !it.done {
                std::str::builder_append(out, "- " + std::json::find_string_field(it.element, "kind") + ": " + std::json::find_string_field(it.element, "text") + " (" + std::json::find_string_field(it.element, "author") + ")\n");
                it = std::json::array_next(it);
            }
        }
        return ContextPackage {
            target: target,
            revision: std::json::find_int_field(body, "revision"),
            digest: std::json::find_string_field(body, "digest"),
            included: std::json::find_string_field(body, "included"),
            included_n: std::json::find_int_field(body, "included_n"),
            data_class: "internal",
            text: std::str::builder_finish(out)
        };
    }
}

// Every byte that is not a letter, a digit, `-`, `_` or `.` as `%XX`.
@unbounded
fn url_encode(s: String) -> String {
    let out = std::str::builder_new();
    let bytes = std::bytes::from_string(s);
    let n = len(bytes);
    let mut i = 0;
    while i < n {
        let b = (std::bytes::at(bytes, i) or 0);
        let plain = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 || b == 46;
        if plain { std::str::builder_append(out, std::str::from_bytes(std::bytes::slice(bytes, i, i + 1))); }
        else { std::str::builder_append(out, "%" + hex_byte(b)); }
        i = i + 1;
    }
    return std::str::builder_finish(out);
}

fn hex_byte(b: Int) -> String {
    let digits = "0123456789ABCDEF";
    return digits[(b / 16)..(b / 16 + 1)] + digits[(b % 16)..(b % 16 + 1)];
}

// The objective a position hands down, with the package folded in: the
// practices the organization ratified for this target, named by the
// package's digest so the receipt says what the model was given.
fn objective_with(objective: String, p: ContextPackage) -> String {
    if p.included_n == 0 { return objective; }
    return objective + "\n\nPRACTICES (ratified knowledge for " + p.target + ", package " + p.digest + "):\n" + p.text;
}

// What the evidence names: the package, then the ids it included.
fn bindings_of(p: ContextPackage) -> String {
    if p.included_n == 0 { return ""; }
    return "package:" + p.digest + " " + p.included;
}

// The locus path a change is about, in the tower: the organization's
// own seed is `org`; an application is `org/<child>` and a seed inside
// it `org/<child>/<seed>`. Knowledge bound to `org` reaches everything.
fn knowledge_target(change_class: String, child: String, seed: String) -> String {
    if change_class == "organization" { return "org"; }
    if seed == "." || seed == "" { return "org/" + child; }
    return "org/" + child + "/" + seed;
}

// The parent of a locus path, "" for a root: where a concern binds.
fn parent_path(path: String) -> String {
    let mut i = len(path);
    while i > 0 {
        if path[(i - 1)..i] == "/" { return path[0..(i - 1)]; }
        i = i - 1;
    }
    return "";
}
