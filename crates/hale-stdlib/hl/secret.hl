// std::secret — GH #436. Key material an application never holds.
//
// `@sealed` closes the read side: nothing outside a sealed locus can
// read its params. It deliberately leaves the WRITE side open, because
// a parent writing `Signer { key: … }` already holds what it passes —
// sealing the initializer would cost ordinary configuration and buy
// nothing.
//
// So the last step is here rather than in the language: these loci
// take the NAME OF A SOURCE, never the bytes. The application says
// "the key is in $SIGNING_KEY"; the locus reads it during birth. The
// material exists only inside a sealed locus from the moment it enters
// the program, and there is no construction site at which the caller
// held it.
//
// Every privileged operation carries the `secret_use` effect class.
// It is a COMPILER BUILT-IN, not declared here: user effect classes
// intern per-Program, so a stdlib-declared class had no identity an
// application's claims could name — `forbid reaches(plugins,
// effects(secret_use))` silently missed `Signer.sign`, and with the
// application declaring its own classes first the stdlib bit aliased
// onto whichever class sat at that index. An application writes the
// claim and nothing else:
//
//     claims {
//         no_plugin_secrets: forbid reaches(plugins, effects(secret_use));
//         one_op_per_request: bound secret_use <= 1 on paths from handlers;
//     }
//
// SCOPE, stated plainly. This is confinement, not information flow.
// The MAC `sign` returns is derived from the key and is NOT tracked; a
// verdict from `verify` is observable and may be published. What is
// guaranteed is that the key itself never becomes a value the
// application can name. Zeroization is out of scope (#436 defers it):
// the bytes live in this locus's arena for the process lifetime.
//
// GH #989 adds a third source, `vault:`, on `Credential`: a name
// resolved against a local directory or an HTTP vault API instead of
// an env var or a file — see `__StdSecretCredential`'s doc comment
// for the local/HTTP split and why it resolves at USE rather than at
// `birth` like the other two. `Credential` also gains `reveal`/
// `reveal_text`, an intentional, named exception to "never becomes a
// value the application can name" for a PLAIN credential (a
// password, a token) that has to leave as text to be usable — a
// `Signer`'s key still never does.

/// HMAC signing over a key the caller never sees.
///
/// Name a source; never pass a value. `env_var` wins if both are set.
///
///     locus Gateway {
///         params {
///             s: std::secret::Signer =
///                 std::secret::Signer { env_var: "SIGNING_KEY" };
///         }
///         fn go(m: Bytes) -> Bytes { return self.s.sign(m); }
///     }
///
/// `self.s.key` from `Gateway` is a compile error — that is the point.
@sealed locus __StdSecretSigner {
    params {
        env_var: String = "";
        key_file: String = "";
        key: Bytes = b"";
        // How the source encodes the key. "" (default) takes the
        // source's bytes verbatim; "base64" decodes them first.
        // Many venues issue an HMAC secret base64-encoded and require
        // the key to be the DECODED bytes — pointed at such a
        // credential with `decode: ""`, a `Signer` keys under the text
        // of the base64 instead, producing valid-looking MACs under
        // the wrong key that every private call then rejects, with no
        // error anywhere. Naming the encoding closes that silently.
        decode: String = "";
    }

    // `birth` is the ONLY writer of `key`, including the no-source
    // case. Params are constructible by the holder, so without the
    // final `else` a caller could write `Signer { key: b"…" }` and
    // hold the material after all — defeating the one thing this
    // locus exists to prevent. Passing `key:` now yields an empty
    // key and `ready() == false`, which surfaces at startup.
    birth() {
        if len(self.env_var) > 0 {
            self.key = self.decoded(std::env::var(self.env_var));
        } else {
            if len(self.key_file) > 0 {
                // A raw key file is bytes; a `decode`-d one is text
                // (the base64) read as a string, so the transform sees
                // the same material a venue would hand out.
                if len(self.decode) == 0 {
                    self.key = std::io::fs::read_bytes(self.key_file) or b"";
                } else {
                    self.key = self.decoded(std::io::fs::read_file(self.key_file) or "");
                }
            } else {
                self.key = b"";
            }
        }
    }

    // Apply the declared `decode` transform to freshly-loaded source
    // material. An UNRECOGNIZED transform, or input the transform
    // rejects (`base64::decode` returns empty bytes on a non-alphabet
    // char, wrong length, or bad padding), yields an empty key — so
    // `ready()` reports false and the privileged methods refuse,
    // rather than the locus holding a key that is not the one the
    // source names. Fail closed, never silently un-decoded.
    fn decoded(raw: String) -> Bytes {
        if len(self.decode) == 0 {
            return std::bytes::from_string(raw);
        }
        if self.decode == "base64" {
            return std::text::base64::decode(raw);
        }
        return b"";
    }

    /// Was a key actually loaded?
    ///
    /// Gate startup on this. When the source is unavailable the
    /// privileged methods REFUSE — `sign` returns an empty result,
    /// `verify` and `matches` return false — rather than computing
    /// under the empty key, which anyone could forge against. That is
    /// refusal by sentinel, not a startup failure: nothing stops a
    /// misconfigured program from running, only from producing a
    /// privileged result.
    fn ready() -> Bool {
        return len(self.key) > 0;
    }

    // Every privileged method refuses when no key was loaded.
    // Without this, a misconfigured deployment signs under the EMPTY
    // key: `sign` returns a perfectly valid HMAC, and `verify`
    // accepts a forgery anyone can compute. `ready()` reporting false
    // is not enough — nothing consulted it.
    @effects(is: { secret_use })
    fn sign(message: Bytes) -> Bytes {
        if !self.ready() {
            return b"";
        }
        return std::crypto::hmac_sha256(self.key, message);
    }

    @effects(is: { secret_use })
    fn sign_512(message: Bytes) -> Bytes {
        if !self.ready() {
            return b"";
        }
        return std::crypto::hmac_sha512(self.key, message);
    }

    /// Verify without handing the expected MAC back to the caller.
    /// The compare is length-independent in its branch structure but
    /// is NOT a constant-time primitive — see the scope note above.
    @effects(is: { secret_use })
    fn verify(message: Bytes, mac: Bytes) -> Bool {
        if !self.ready() {
            return false;
        }
        let expect = std::crypto::hmac_sha256(self.key, message);
        if len(expect) != len(mac) {
            return false;
        }
        let mut i = 0;
        let mut diff = 0;
        while i < len(expect) {
            let a = std::bytes::read_u8(expect, i) or 0;
            let b = std::bytes::read_u8(mac, i) or 0;
            if a != b {
                diff = diff + 1;
            }
            i = i + 1;
        }
        return diff == 0;
    }
}

/// An opaque credential — a token, password, or API key the program
/// must present or check but must never log, publish, or return.
///
/// `vault:` (GH #989) names a secret in the vault instead of an env
/// var or a file, and behaves differently from both in one respect:
/// `env_var`/`key_file` resolve once, at `birth`, into `value` — a
/// vault resolves FRESH on every privileged call, never cached here,
/// because a vault's whole point is that a value can change without
/// restarting every process that reads it. `env_var` wins if both are
/// set, same precedence as `Signer`.
///
/// Local mode (`HALE_VAULT_ADDR` unset) reads a directory of files
/// keyed by name — `HALE_VAULT_DIR`, or the per-user cache root the
/// toolchain already uses (`std::secret::vault_local_dir()`) — no
/// server, no token, just filesystem permissions as the access
/// control. Set `HALE_VAULT_ADDR`, and it is an HTTP GET to
/// `<addr>/v1/secret/<name>` instead, authenticated with the
/// per-host token in `HALE_VAULT_TOKEN` as a bearer credential.
/// Either way: fail closed. A missing directory, a missing file, a
/// missing token, a non-200, an unreachable address — all empty
/// bytes, never a partial or stale value, same as an unset env var.
@sealed locus __StdSecretCredential {
    params {
        env_var: String = "";
        vault: String = "";
        value: Bytes = b"";
    }

    // As `Signer`: `birth` is the only writer, so a caller cannot
    // seed `value:` at construction and keep a copy. `vault` is not
    // resolved here — see the locus doc comment.
    birth() {
        if len(self.env_var) > 0 {
            self.value =
                std::bytes::from_string(std::env::var(self.env_var));
        } else {
            self.value = b"";
        }
    }

    // `env_var`/`key_file`-shaped sources are already in `self.value`
    // by the time any method runs; a `vault` source is resolved HERE,
    // fresh, every time. Every privileged method goes through this
    // rather than reading `self.value` directly.
    fn __resolved() -> Bytes {
        if len(self.env_var) > 0 {
            return self.value;
        }
        if len(self.vault) > 0 {
            return __std_secret_vault_get(self.vault);
        }
        return b"";
    }

    fn ready() -> Bool {
        return len(self.__resolved()) > 0;
    }

    /// The resolved credential, in the open — for the one statement
    /// that puts it on the wire or compares it. The checker holds every
    /// reveal to that (spec/semantics.md § "@sealed", "a revealed secret
    /// is consumed in its statement"): called in a locus method, its
    /// value reaches a wire write's payload, a comparison of the whole
    /// value or a `@secret` parameter in the same statement, and is
    /// never bound, stored, returned, used to decide a branch or handed
    /// to `std::process`. To compare, prefer `matches`: `==` is not
    /// constant-time. `std::secret`'s guarantee
    /// is that the SOURCE is explicit and fails closed; a raw password
    /// or token still has to leave as text to be usable at all. Named
    /// `reveal` so a caller of it is grep-able.
    @effects(is: { secret_use })
    fn reveal() -> Bytes {
        return self.__resolved();
    }

    @effects(is: { secret_use })
    fn reveal_text() -> String {
        return std::str::from_bytes(self.reveal());
    }

    /// Write the credential to a NEW file at `path` that only this user
    /// can read, for a tool that takes a secret from a file (`gh` through
    /// `GH_TOKEN=$(cat …)`): the secret never crosses an argv or an
    /// environment this process builds, and nothing is revealed here.
    /// The file is created with mode 0600 by openat(2) itself (never
    /// chmod after) and must not exist yet. `path`'s directory must be
    /// this user's own and private (no group or world access), not a
    /// symlink, and must not sit in a git work tree (a `.git` in it or
    /// any ancestor): a file there could be committed. The reveal rule
    /// follows values, not files — reading the file back holds the
    /// secret in the open. `false` when it refuses, when
    /// there is no credential to write, or when the write fails — a
    /// partial file is removed. The caller removes the file when the
    /// tool is done with it.
    @effects(is: { secret_use })
    fn write_private(path: String) -> Bool {
        let value = self.__resolved();
        if len(value) == 0 { return false; }
        std::io::fs::__write_private(path, value) or { return false; };
        return true;
    }

    /// A stable correlation handle: the first 8 bytes of SHA-256,
    /// hex-encoded.
    ///
    /// NOT unconditionally safe to publish, and it is no longer
    /// described that way. An unsalted SHA-256 prefix over a
    /// LOW-ENTROPY credential (a password, a short PIN) is
    /// dictionary-testable, and the handle itself is a stable
    /// cross-process identifier that may be sensitive on its own. It
    /// is a correlation identifier for high-entropy tokens, nothing
    /// stronger.
    ///
    /// It consumes the credential directly, so it carries
    /// `secret_use` like every other privileged method — a claim
    /// keeping plugins away from secret operations would otherwise
    /// not see it.
    @effects(is: { secret_use })
    fn fingerprint() -> String {
        let resolved = self.__resolved();
        if len(resolved) == 0 {
            return "";
        }
        let d = std::crypto::sha256(resolved);
        let mut out = "";
        let mut i = 0;
        while i < 8 {
            out = out + __std_secret_hex(std::bytes::read_u8(d, i) or 0);
            i = i + 1;
        }
        return out;
    }

    // The sharpest of the empty-secret failures: with no credential
    // loaded, the resolved value is empty, `matches(b"")` took the
    // zero-iteration path, and `diff == 0` authenticated. An
    // unavailable credential must reject everything.
    @effects(is: { secret_use })
    fn matches(candidate: Bytes) -> Bool {
        let resolved = self.__resolved();
        if len(resolved) == 0 {
            return false;
        }
        if len(candidate) != len(resolved) {
            return false;
        }
        let mut i = 0;
        let mut diff = 0;
        while i < len(resolved) {
            let a = std::bytes::read_u8(resolved, i) or 0;
            let b = std::bytes::read_u8(candidate, i) or 0;
            if a != b {
                diff = diff + 1;
            }
            i = i + 1;
        }
        return diff == 0;
    }
}

fn __std_secret_hex(b: Int) -> String {
    let digits = "0123456789abcdef";
    let hi = b / 16;
    let lo = b - hi * 16;
    return std::str::substring(digits, hi, hi + 1)
        + std::str::substring(digits, lo, lo + 1);
}

// GH #989: the vault backend behind `vault:` on Credential (and, if
// a later need arises, Signer). Local-file or HTTP, always resolved
// fresh — see the locus doc comment for why a vault source is never
// cached the way env_var/key_file are.
fn __std_secret_vault_get(name: String) -> Bytes {
    if !__std_secret_vault_name_is_safe(name) {
        return b"";
    }
    if std::env::var_exists("HALE_VAULT_ADDR") {
        return __std_secret_vault_http_get(name);
    }
    return __std_secret_vault_local_get(name);
}

// A name that is not `/`, `\`, or `..`-clean is refused before it
// ever reaches a path — fail closed, same as any other unresolvable
// vault entry, rather than an escape out of the vault root
// (`vault: "../../../etc/passwd"`) or wherever an HTTP vault's own
// routing takes a traversal-shaped segment. Exported (as
// `std::secret::vault_name_is_safe`) so a caller building a name
// from something less trusted than a literal — DNA's role names are
// project-derived — can check the SAME rule before it ever gets
// this far, not just rely on this being the last line of defense.
fn __std_secret_vault_name_is_safe(name: String) -> Bool {
    if len(name) == 0 { return false; }
    if std::str::contains(name, "/") { return false; }
    if std::str::contains(name, "\\") { return false; }
    if std::str::contains(name, "..") { return false; }
    return true;
}

fn __std_secret_vault_local_get(name: String) -> Bytes {
    return std::io::fs::read_bytes(__std_secret_vault_local_dir() + "/" + name) or b"";
}

// The local vault directory: `HALE_VAULT_DIR`, or the same
// per-user cache root the toolchain's iris/runtime state already
// uses (`$XDG_CACHE_HOME/hale/vault`, `~/.cache/hale/vault`) — never
// a system path a process cannot write without root. Exported (as
// `std::secret::vault_local_dir`) so a caller that must PROVISION a
// local entry (std::secret's own contract is read-only for `vault:`)
// writes to the exact directory a later read will look in.
fn __std_secret_vault_local_dir() -> String {
    if std::env::var_exists("HALE_VAULT_DIR") {
        return std::env::var("HALE_VAULT_DIR");
    }
    if std::env::var_exists("XDG_CACHE_HOME") {
        return std::env::var("XDG_CACHE_HOME") + "/hale/vault";
    }
    if std::env::var_exists("HOME") {
        return std::env::var("HOME") + "/.cache/hale/vault";
    }
    return "/tmp/hale-vault";
}

fn __std_secret_vault_http_get(name: String) -> Bytes {
    let token = std::env::var("HALE_VAULT_TOKEN");
    if len(token) == 0 {
        return b"";
    }
    let addr = std::env::var("HALE_VAULT_ADDR");
    let empty_url = std::http::Url { };
    let url = std::http::parse_url(addr + "/v1/secret/" + name) or empty_url;
    if len(url.host) == 0 {
        return b"";
    }
    let empty_resp = std::http::ClientResponse { status: 0, headers: "", body: b"" };
    let resp = std::http::request(std::http::ClientRequest {
        method: "GET",
        url: url,
        headers: "Authorization: Bearer " + token,
        body: b"",
    }) or empty_resp;
    if resp.status != 200 {
        return b"";
    }
    return resp.body;
}
