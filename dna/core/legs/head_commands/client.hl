type CommandsRetireKnowledgeOutcome = enum { Result(KnowledgeReply), Refusal(ApiRefusal), ServerError, Lost(String) };

fn commands_retire_knowledge(endpoint: String, bearer: String, request: KnowledgeNodeRetirement) -> CommandsRetireKnowledgeOutcome {
    let raw = api_call(endpoint, bearer, "Commands::retire_knowledge", api_enc_KnowledgeNodeRetirement(request));
    if raw.outcome == 0 { return CommandsRetireKnowledgeOutcome::Result(api_dec_KnowledgeReply(raw.body)); }
    if raw.outcome == 2 { return CommandsRetireKnowledgeOutcome::Refusal(api_refusal(raw)); }
    if raw.outcome == 3 { return CommandsRetireKnowledgeOutcome::ServerError; }
    if raw.outcome == 1 { return CommandsRetireKnowledgeOutcome::Lost("the member has no handler error, and one came: " + raw.body); }
    return CommandsRetireKnowledgeOutcome::Lost(raw.why);
}

