}

fn encode_workflow_outcome(o: WorkflowOutcome) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.int_field("version", WORKFLOW_EVENT_VERSION);
    b.string_field("task_id", o.task_id);
    b.string_field("disposition", o.disposition);
    b.string_field("reason", o.reason);
    b.string_field("parent_task", o.parent_task);
    b.string_field("spawning_step", o.spawning_step);
    b.end_object();
    return b.result();
}

fn decode_workflow_outcome(text: String) -> DecodedWorkflowOutcome {
    let gap = version_gap(text, "workflow outcome");
    if len(gap) > 0 { return DecodedWorkflowOutcome { why: gap }; }
    let absent = missing_field(text, "task_id disposition");
    if len(absent) > 0 { return DecodedWorkflowOutcome { why: "a workflow outcome names its " + absent }; }
    return DecodedWorkflowOutcome {
        ok: true,
        value: WorkflowOutcome {
            task_id: std::json::find_string_field(text, "task_id"),
            disposition: std::json::find_string_field(text, "disposition"),
            reason: std::json::find_string_field(text, "reason"),
            parent_task: std::json::find_string_field(text, "parent_task"),
            spawning_step: std::json::find_string_field(text, "spawning_step")
        }
    };
}
