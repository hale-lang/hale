// The gamma wing: research, fed by the shared metrics subject.
//
// It names delta's payload type rather than declaring its own: two
// ends of one wire subject must agree on the payload, and two
// same-shaped types in two seeds are two types.
import "lib/delta" as delta;

locus Research {
    params { total: Int = 0; }
    bus { subscribe "org.metrics" as on_metric of type delta::Metric; }
    fn on_metric(m: delta::Metric) { self.total = self.total + m.n; }
}
