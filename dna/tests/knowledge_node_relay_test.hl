// The production host's ownership/trust boundary and exact answer matcher.
// The answer-matcher case writes explicitly synthetic acknowledgments; native
// domain outcomes are exercised separately in knowledge_node_recovery_test.
import "../core" as dna;
import "../host" as host;

// What the relay handed to the bus, as the organization's subscriber
// receives it: this program binds no topic, so the publish stays here.
locus Probe {
    params { heard: Int = 0; body: String = ""; }
    bus { subscribe dna::KnowledgeNodeRequested as on_node; }
    fn on_node(r: dna::KnowledgeNodeRequest) {
        let codec = dna::KnowledgeNodeRequestCodec { };
        self.heard = self.heard + 1;
        self.body = codec.started(r);
    }
}

// The relay as a node runs it, live.
fn relay_once(root: String) -> host::NodeRelay {
    let relay = host::NodeRelay { root: root, verb: "test", live: true };
    let n = relay.relay(dna::Memory { repo: root });
    return relay;
}

fn controls(size: Int) -> String {
    let b = std::bytes::BytesBuilder { }; let mut i = 0;
    while i < size { b.append_u8(1); i = i + 1; }
    return std::str::from_bytes(b.snapshot());
}
fn maximum(probe: Probe) {
    let root = "/tmp/dna-node-relay-max-" + to_string(std::process::pid());
    let previous = dna::run_tool("rm\n-rf\n" + root);
    std::io::fs::mkdir(root) or discard;
    let init = dna::run_tool("git\n-C\n" + root + "\ninit\n-q\n-b\nmain");
    std::test::assert_eq_int(init.code, 0, "maximum transport Record");
    let j = dna::GitJournal { repo: root };
    let genesis = j.append_exact(j.revision(), "application.observed", "org", "{}");
    std::test::assert(genesis.ok, "maximum transport genesis");
    let quotes = std::str::repeat("\"", 256);
    let native = dna::KnowledgeNodeRequestCodec { };
    // This fixture tests only process transport, not domain admission or
    // candidate adoption. It retains a fixed digest as an opaque field rather
    // than rebuilding a large Knowledge document in the transport test.
    let r = dna::KnowledgeNodeRequest {
        request_id: "knowledge-command-" + std::str::repeat("a", 64), operation: "dna.knowledge.node.revise",
        kind: "task_concept", name: quotes, text: controls(8192), author: quotes, target: quotes,
        supersedes: dna::digest_of("old"), by: quotes, because: controls(2048), candidate_digest: dna::digest_of("transport-only candidate identity")
    };
    let compact = native.started(r);
    let expanded = std::bytes::BytesBuilder { };
    expanded.append_str(compact[0..(len(compact) - 1)]);
    expanded.append_str(",\"command_payload\":"); expanded.append_str(dna::record_json_quote(compact)); expanded.append_str("}");
    let body = std::str::from_bytes(expanded.snapshot());
    std::test::assert(len(body) > 65536, "outer fact genuinely exceeds the installed process argv bound");
    let input = j.append_exact(j.revision(), "knowledge.node.requested", r.request_id, body);
    std::test::assert(input.ok, "large transport-only request fixture is retained in Record");
    std::test::assert(len(compact) < 64500 && native.matches(compact, r), "all worst-escaped text, rationale and identifier fields fit native transport exactly");
    // the production relay hands the typed request to the bus (GH #986):
    // the canonical request, every field whole, and nothing of the
    // record's admission metadata
    let relay = relay_once(root);
    std::test::assert_eq_int(relay.relayed_count, 1, "maximum native command is actually handed to the bus");
    std::test::assert_eq_str(relay.error, "", "production relay has no transport error");
    let deadline = std::time::now() + dna::wait_secs(10);
    while probe.heard == 0 && std::time::now() <= deadline { std::time::sleep(50ms); }
    std::test::assert_eq_int(probe.heard, 1, "the organization's subscriber receives the request once");
    let got = native.decode(probe.body);
    std::test::assert(native.valid(got) && probe.body == compact, "the bus preserves all eleven fields and candidate digest exactly");
    std::test::assert_eq_int(len(got.text), 8192, "all text bytes");
    std::test::assert_eq_int(len(got.because), 2048, "all rationale bytes");
    eprintln("maximum native payload bytes=", len(compact));
    let removed = dna::run_tool("rm\n-rf\n" + root);
}

fn request(id: String, text: String) -> dna::KnowledgeNodeRequest {
    let codec = dna::KnowledgeNodeRequestCodec { };
    let mut r = dna::KnowledgeNodeRequest {
        request_id: id, operation: "dna.knowledge.node.propose", kind: "concept",
        name: "concept/exact", text: text, author: "org", target: "org", by: "riley", because: "An exact proposal."
    };
    r.candidate_digest = dna::digest_of(codec.document(r));
    return r;
}
fn check() {
    let root = "/tmp/dna-node-relay-" + to_string(std::process::pid());
    let made = dna::run_tool("mkdir\n-p\n" + root + "/dna/org");
    let init = dna::run_tool("git\n-C\n" + root + "\ninit\n-q\n-b\nmain");
    std::test::assert_eq_int(made.code + init.code, 0, "temporary native Record");
    let j = dna::GitJournal { repo: root };
    let codec = dna::KnowledgeNodeRequestCodec { };
    let r = request("command/exact", "The original candidate.");
    let input = j.append_exact(j.revision(), "knowledge.node.requested", r.request_id, codec.started(r));
    std::test::assert(input.ok, "actual native request input");
    let trust = dna::run_tool("git\n-C\n" + root + "\nconfig\ndna.trust\nsigned");
    let owner = dna::run_tool("git\n-C\n" + root + "\nconfig\ndna.owner\nsouth");
    let wrote = host::write_text(root + "/dna/org/owners", "org = north\norg/team = south\n") or false;
    std::test::assert(trust.code == 0 && owner.code == 0 && wrote, "explicit other-owner signed profile");
    let state = relay_once(root);
    std::test::assert_eq_int(state.relayed_count, 0, "another owner's request is not relayed");
    std::test::assert_eq_str(state.relayed, "\n", "another owner's unsigned request is not marked refused by this keyring");
    let refreshed = j.refresh();
    std::test::assert_eq_int(j.revision(), 1, "routing writes no other-owner outcome");
    let local = dna::run_tool("git\n-C\n" + root + "\nconfig\ndna.trust\nlocal");
    let wrong = request("command/exact", "A different candidate under the same key.");
    let wrong_answer = j.append_exact(j.revision(), "knowledge.node.proposed", r.request_id, codec.proposed(wrong));
    std::test::assert(wrong_answer.ok, "synthetic nonmatching answer fixture");
    let not_answered = host::open_projection(root, ".", "", dna::Memory { repo: root });
    std::test::assert(!host::request_answered(not_answered, 0, " knowledge.node.proposed knowledge.node.refused "), "same entity cannot borrow another candidate's acknowledgment");
    let answer = j.append_exact(j.revision(), "knowledge.node.proposed", r.request_id, codec.proposed(r));
    std::test::assert(answer.ok, "synthetic exact answer fixture");
    let answered = host::open_projection(root, ".", "", dna::Memory { repo: root });
    std::test::assert(host::request_answered(answered, 0, " knowledge.node.proposed knowledge.node.refused "), "exact full request acknowledgment stops relay");
    let r2 = request("command/refused", "The refused candidate.");
    let index = j.revision();
    let input2 = j.append_exact(j.revision(), "knowledge.node.requested", r2.request_id, codec.started(r2));
    let plain = j.append_exact(j.revision(), "knowledge.node.refused", r2.request_id, "not a correlated acknowledgment");
    let no_refusal = host::open_projection(root, ".", "", dna::Memory { repo: root });
    std::test::assert(input2.ok && plain.ok && !host::request_answered(no_refusal, index, " knowledge.node.proposed knowledge.node.refused "), "prose refusal cannot answer a native command");
    let refused = j.append_exact(j.revision(), "knowledge.node.refused", r2.request_id, codec.refused(r2, "lateral knowledge binding is not permitted"));
    let refusal = host::open_projection(root, ".", "", dna::Memory { repo: root });
    std::test::assert(refused.ok && host::request_answered(refusal, index, " knowledge.node.proposed knowledge.node.refused "), "exact correlated refusal stops relay");
    let removed = dna::run_tool("rm\n-rf\n" + root);
}
// A plain locus: the host this imports is the `main locus` of its own
// program (GH #986), and a bundle has one.
locus App {
    params { probe: Probe = Probe { }; }
    run() { check(); maximum(self.probe); }
}
fn main() { App { }; }
