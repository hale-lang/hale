// Memory's schema, applied by its owner (GH #985).
//
// `hale habitat migrate` (and birth, `upgrade` and `hale dna memory
// migrate`) runs `memory-migrate`: the schema owner's DSN from
// HALE_DNA_MEMORY_DSN_OWNER, or from the organism's memory allocation in
// the local habitat brought up, applies
// the record's schema and prints the spine's and the head's DSNs. The host
// that runs the organism never holds the owner's DSN: it is handed the
// spine's and checks the schema version before it starts anything on it.

const OWNER_DSN_ENV: String = "HALE_DNA_MEMORY_DSN_OWNER";

// `memory-migrate`: `HALE_DNA_MEMORY_DSN_SPINE=<dsn>` and
// `HALE_DNA_MEMORY_DSN_HEAD=<dsn>` when the schema was applied — and over a
// shared record (HALE_DNA_OWNER_KEYS names its owners) one
// `HALE_DNA_MEMORY_DSN_HEAD_<OWNER>=<dsn>` per owner, the role that owner's
// heads write the Ledger as (GH #1026) — `none: <why>` when there is no
// database to apply it to.
//
// GH #1653: nothing migrates or provisions as a side effect. `derive`
// (`memory-migrate --derive`, what `dev`, `head` and `show` ask) brings no
// service up and applies no schema: it derives the roles' DSNs from the
// owner's DSN, or from the organism's memory allocation when it is already
// up, and a schema that is behind is the store's refusal when it opens,
// naming `hale habitat migrate`. Only the habitat's acts migrate:
// `hale habitat migrate`, and init and upgrade, which are graft's and the
// habitat's until graft lands.
fn memory_migrate_verb(root: String, derive: Bool) -> Answer {
    let mut owner = if std::env::var_exists(OWNER_DSN_ENV) {
        std::env::var(OWNER_DSN_ENV)
    } else {
        ""
    };
    if len(owner) == 0 {
        // its own memory allocation's server, or the habitat's when the
        // habitat's memory keeps its record (`dna::memory_root`)
        let server = dna::memory_root(root);
        let infra = ReferenceInfrastructure { root: server };
        let db = if derive {
            infra.knowledge_database_if_up()
        } else {
            infra.knowledge_database(server)
        };
        if !db.present { return answer("none: " + db.why + "\n"); }
        owner = db.dsn;
    }
    let who = dna::record_identity_at(root);
    if len(who.why) > 0 { return fail("memory migrate: " + who.why); }
    let m = if derive {
        dna::derived_dsns(dna::parse_dsn(owner), who.id)
    } else {
        dna::migrate(dna::parse_dsn(owner), who.id)
    };
    if !m.ok { return fail("memory migrate: " + m.why); }
    let mut out = dna::SPINE_DSN_ENV + "=" + m.spine_dsn + "\n" + dna::HEAD_DSN_ENV + "="
        + m.head_dsn + "\n";
    let mut rest = m.owner_dsns;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let eq = std::str::index_of(line, "=");
        if eq > 0 {
            out = out + dna::HEAD_DSN_ENV + "_" + std::str::upper(line[0..eq]) + "="
                + line[(eq + 1)..len(line)] + "\n";
        }
    }
    // GH #1653: the version a migration moved the schema to, which the
    // habitat records for the allocation
    // and the vault slots it holds, by name (never a value)
    if !derive {
        out = out + "allocation.schema_version=" + to_string(dna::MEMORY_SCHEMA_VERSION) + "\n";
        let key = dna::allocation_key(root);
        // a record on the habitat's memory holds no server's password of its own
        let own_server = dna::memory_root(root) == root;
        out = out + "allocation.vault_slots="
            + (if len(key) > 0 && own_server { postgres_owner_vault(key) + " " } else { "" })
            + dna::role_vault_name(dna::spine_role(who.id)) + " "
            + dna::role_vault_name(dna::head_role(who.id)) + "\n";
    }
    return answer(out);
}

// "" when the spine's DSN reaches a schema at this toolchain's version;
// otherwise why the host refuses to start on it.
fn memory_fence_for(spine: String, root: String) -> String {
    let d = dna::parse_dsn(spine);
    if !d.ok { return "HALE_DNA_MEMORY_DSN_SPINE: " + d.why; }
    let c = dna::pq_conn(d);
    let st = c.open();
    if !st.ok { return "memory: " + st.err.kind + " " + st.err.detail; }
    let why = dna::memory_fence(c, dna::schema_for(record_identity(root)));
    c.close();
    return why;
}

// GH #1653: `database-provision` — the `database` heart role, a tenant
// database of the organism's memory server (`dna::provision_heart_database`):
// `HALE_DNA_DATABASE_DSN=<dsn>` naming its vault slot, and the allocation's
// lines; `none: <why>` with no server. `derive` (what `dev` asks, to hand
// the heart its DSN) provisions nothing: the DSN of the database on memory
// that is up.
fn database_provision_verb(root: String, derive: Bool) -> Answer {
    let mut owner = if std::env::var_exists(OWNER_DSN_ENV) {
        std::env::var(OWNER_DSN_ENV)
    } else {
        ""
    };
    if len(owner) == 0 {
        // the heart's database is a tenant of the server its record is on
        let server = dna::memory_root(root);
        let infra = ReferenceInfrastructure { root: server };
        let db = if derive {
            infra.knowledge_database_if_up()
        } else {
            infra.knowledge_database(server)
        };
        if !db.present { return answer("none: " + db.why + "\n"); }
        owner = db.dsn;
    }
    let key = dna::allocation_key(root);
    let h = if derive {
        dna::heart_dsn(dna::parse_dsn(owner), key)
    } else {
        dna::provision_heart_database(dna::parse_dsn(owner), key)
    };
    if !h.ok { return fail("database provision: " + h.why); }
    let mut out = "HALE_DNA_DATABASE_DSN=" + h.dsn + "\n";
    if !derive {
        out = out + "allocation.schema_version=0\nallocation.vault_slots=" + h.slot + "\n";
    }
    return answer(out);
}

// GH #1653: `heart-handover` — what the habitat hands a habitat-scoped
// heart, one `NAME=value` a line, a secret only ever by its vault slot's
// name: the head's URL (`git config dna.head.url`, the local head's by
// default), the application's identity (the record's), the OIDC issuer
// (`dna.oidc.issuer`, the local stub's by default) and the service client
// the heart signs in as (the application's name, its secret the slot
// `oidc-service-<name>`), and, for each heart role its genome declares,
// that role's: `HALE_DNA_DATABASE_DSN`, and `HALE_DNA_BROKER_URL`,
// `_USER`, `_VAULT`, `_SUBJECTS`, `_NODE_USER` and `_NODE_VAULT`. `derive` provisions
// nothing (what `dev` and `hale habitat handover` ask); without it the
// heart roles are provisioned, at graft.
// `with`: heart roles named beside the ones the habitat allocated (a
// graft names the role it is provisioning before its row is written),
// one word each.
fn heart_handover_verb(root: String, derive: Bool, with: String) -> Answer {
    let id = record_identity(root);
    if len(id) == 0 { return fail("heart handover: the record has no identity yet"); }
    let rec = dna::MemoryRecord { repo: root };
    let head = dna::trim_nl(rec.git("config\n--get\ndna.head.url").stdout);
    let issuer = dna::trim_nl(rec.git("config\n--get\ndna.oidc.issuer").stdout);
    let attached = attached_application(root);
    let client = if len(attached) > 0 {
        dna::nerves_app_name(attached)
    } else {
        dna::nerves_app_name(root[(dna::last_slash(root) + 1)..len(root)])
    };
    let mut out = "HALE_DNA_APPLICATION_ID=" + id + "\n"
        + "HALE_DNA_HEAD_URL=" + (if len(head) > 0 { head } else { "http://127.0.0.1:8792" }) + "\n"
        + "HALE_DNA_OIDC_ISSUER=" + (if len(issuer) > 0 { issuer } else { "http://127.0.0.1:8794" })
        + "\n"
        + "HALE_DNA_OIDC_CLIENT=" + client + "\n"
        + "HALE_DNA_OIDC_CLIENT_VAULT=oidc-service-" + client + "\n";
    let named = " " + with + " ";
    if dna::allocated_role(root, "database") || std::str::contains(named, " database ") {
        let d = database_provision_verb(root, derive);
        if !d.ok { return d; }
        if std::str::starts_with(d.text, "none: ") { return d; }
        out = out + d.text;
    }
    if dna::allocated_role(root, "broker") || std::str::contains(named, " broker ") {
        if std::env::var_exists(dna::NATS_OWNER_URL_ENV)
            && len(std::env::var(dna::NATS_OWNER_URL_ENV)) > 0
        {
            return answer(
                "none: the broker heart role is a user of the organism's own nerves server, which the habitat configures; the operator's NATS is not the habitat's to configure\n",
            );
        }
        // its own server, or the habitat's for an account the habitat's
        // server keeps (`dna::nerves_root`), as the nerves' URLs read it
        let infra = ReferenceInfrastructure { root: dna::nerves_root(root) };
        let server = if derive {
            infra.nerves_if_up()
        } else {
            infra.nerves_server(dna::nerves_root(root)).dsn
        };
        if len(server) == 0 {
            return answer(
                "none: the organism's nerves allocation in the local habitat is not up (`hale habitat migrate "
                    + root + "` brings it up)\n",
            );
        }
        let key = dna::allocation_key(root);
        out = out + "HALE_DNA_BROKER_URL=" + dna::nerves_server_url(server) + "\n"
            + "HALE_DNA_BROKER_USER=" + dna::heart_broker_user(key) + "\n"
            + "HALE_DNA_BROKER_VAULT=" + dna::heart_broker_vault(dna::schema_for(id)) + "\n"
            + "HALE_DNA_BROKER_SUBJECTS=" + dna::heart_broker_subjects(key) + "\n"
            + "HALE_DNA_BROKER_NODE_USER=" + dna::heart_broker_node_user(key) + "\n"
            + "HALE_DNA_BROKER_NODE_VAULT=" + dna::heart_broker_node_vault(dna::schema_for(id))
            + "\n";
    }
    return answer(out);
}
