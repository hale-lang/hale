// dna/operations/graph_holes.hl — the holes, proposed at record birth (GH
// #1091), derived from the graph's edges and nothing else.
//
// The graph an ingest reads lacks exactly what a delivery needs and the
// repository cannot imply: who works where, who signs what, what is to be
// delivered. `init` proposes each hole on its own, one Board Review each,
// and the Board ratifies. A hole is a knowledge proposal whose receipt
// document (`kind: graph`) carries the graph rows it would add, each
// checked against the vocabulary (graph.hl) before it is proposed; the
// existing path ratifies it (`knowledge.ratified`), and the projection
// writes its rows into the graph (memory_tail.hl). The graph is the one
// org chart: what the Board ratifies here is the org chart.
//
// A *part* is one of the repository's processes, or a seed no process
// unfolds into (a UI, a validator). The holes follow the edges:
//
//   board      — a `board` under the purpose;
//   reviewer   — one per part that serves or consumes a contract (`meets`):
//                it `reviews` the part's seed and every contract the part
//                serves or consumes, and so signs a change to any of them;
//   dev, work  — one each per part whose seed a gate guards, or that
//                serves a contract a gate validates (`gates`); and one per
//                validated contract no part of the repository serves. The
//                work is done when the first gate guarding it passes — the
//                wording DNA proposes and the Board amends at ratification;
//   operator   — one per deployment: it `reviews` the deployment, and so
//                signs a change to the file it was read from;
//   roles      — the operational roles the project opts into (the one
//                policy: dna/org/structure.hl, `operational_roles`, none by
//                default), under each deployment, proposed empty, signing
//                nothing;
//   practices  — each item a document marks `derived`, `practice` or `law`,
//                proposed as advice (graph_ingest.hl builds their receipts).
//
// Never the same holder as `dev` for a part's `reviewer`: the positions
// are proposed empty, and the check is where a holder is proposed
// (`hale dna fill`, dna/host/holes.hl) and where memory projects it.

// A work item's node: its name, what it is, and what it is done when.
fn graph_work_body(name: String, text: String, gate: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("kind", "work");
    b.string_field("name", name);
    b.string_field("text", text);
    b.string_field("done_when", gate);
    b.end_object();
    return b.result();
}

type HolesAnswer { proposals: String = ""; count: Int = 0; error: String = ""; }

// One proposal being built: its graph rows (`<kind>\t<entity>\t<body>`
// per line), checked as they are added.
locus HoleDoc {
    params {
        name: String = "";
        target: String = "";
        text: String = "";
        question: String = "";
        rows: String = "";
        error: String = "";
    }
    @unbounded
    fn row(kind: String, entity: String, body: String) {
        let g = if kind == "graph.node" { graph_node_row(entity, body) } else { graph_edge_row(entity, body) };
        if !g.ok && len(self.error) == 0 { self.error = "the hole `" + self.name + "` would write an invalid " + kind + ": " + g.why; }
        self.rows = self.rows + kind + "\t" + entity + "\t" + body + "\n";
    }
    fn node(kind: String, name: String, text: String) -> String {
        let id = graph_node_id(kind, name);
        self.row("graph.node", id, graph_node_body(kind, name, text, ""));
        return id;
    }
    fn unfold(parent: String, child: String) {
        let e = GraphEdge { kind: "unfold" };
        e.member("parent", parent);
        e.member("child", child);
        self.row("graph.edge", e.id(), e.body());
    }
    // The receipt: what the Board ratifies, and what the projection writes.
    @unbounded
    fn document() -> String {
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("author", "hale dna init");
        b.string_field("kind", "graph");
        b.string_field("name", self.name);
        b.string_field("provenance", "proposed");
        b.string_field("question", self.question);
        b.begin_array_field("rows");
        let mut rest = self.rows;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let t1 = std::str::index_of(line, "\t");
            let after = line[(t1 + 1)..len(line)];
            let t2 = std::str::index_of(after, "\t");
            b.begin_object();
            b.string_field("kind", line[0..t1]);
            b.string_field("entity", after[0..t2]);
            b.string_field("body", after[(t2 + 1)..len(after)]);
            b.end_object();
        }
        b.end_array();
        b.string_field("target", self.target);
        b.string_field("text", self.text);
        b.end_object();
        return b.result();
    }
}

// A proposal as the host proposes it: the receipt, the Review's question,
// the group it is listed under, its kind, name and target, one JSON
// object per line.
fn hole_line(doc: String, question: String, group: String, kind: String, name: String, target: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("doc", doc);
    b.string_field("question", question);
    b.string_field("group", group);
    b.string_field("kind", kind);
    b.string_field("name", name);
    b.string_field("target", target);
    b.end_object();
    return b.result() + "\n";
}

// The `<a>\t<b>` lines of `pairs` whose `<a>` is `key`: their `<b>`s, one
// per line.
@unbounded
fn hole_seconds(pairs: String, key: String) -> String {
    let mut out = "";
    let mut rest = pairs;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        if std::str::starts_with(line, key + "\t") { out = out + line[(len(key) + 1)..len(line)] + "\n"; }
    }
    return out;
}

// The first line of `lines`, "" when none.
fn hole_first(lines: String) -> String {
    let nl = std::str::index_of(lines, "\n");
    return if nl < 0 { lines } else { lines[0..nl] };
}

// Whether some `<a>\t<b>` line of `pairs` has `<b>` equal to `second`.
fn hole_has_second(pairs: String, second: String) -> Bool { return std::str::contains(pairs, "\t" + second + "\n"); }

// How a question names a part's kind: a process, or a seed.
fn hole_kind(part: String) -> String { return if std::str::starts_with(part, "seed:") { "seed" } else { "process" }; }

// Every hole of the graph an ingest read, as proposals in the order the
// org chart lists them: the board, each part's positions, each
// deployment's, then the work, then the practices. `roles` is the project's
// opt-in operational roles, space-separated ("" for none).
@unbounded
fn graph_holes(g: GraphIngest, roles: String) -> HolesAnswer {
    let mut out = HolesAnswer { };
    let mut docs = "";
    if len(g.purpose) > 0 {
        let d = HoleDoc { name: "board", target: g.purpose, text: "The Board: whoever holds this organization's authority, and ratifies what it becomes." };
        d.question = "ratify the position `board` under the purpose: it ratifies what this organization becomes";
        d.unfold(g.purpose, d.node("position", "board", d.text));
        if len(d.error) > 0 { return HolesAnswer { error: d.error }; }
        docs = docs + hole_line(d.document(), d.question, "holes", "graph", d.name, d.target);
        out.count = out.count + 1;
    }
    // the parts: the processes in order, then the seeds no process unfolds into
    let mut parts = "";
    let mut procs = g.processes;
    while len(procs) > 1 {
        procs = procs[1..len(procs)];
        let nl = std::str::index_of(procs, "\n");
        parts = parts + "process:" + procs[0..nl] + "\n";
        procs = procs[nl..len(procs)];
    }
    let mut seeds = g.seeds;
    while len(seeds) > 1 {
        seeds = seeds[1..len(seeds)];
        let nl = std::str::index_of(seeds, "\n");
        let seed = "seed:" + seeds[0..nl];
        seeds = seeds[nl..len(seeds)];
        if !hole_has_second(g.unfolds, seed) { parts = parts + seed + "\n"; }
    }
    // a reviewer, and a dev, per part as its edges say
    let mut work = ""; // `<target>\t<name>\t<gate>` per work item, in order
    let mut rest = parts;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let part = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let p = part[(std::str::index_of(part, ":") + 1)..len(part)];
        let seed = if std::str::starts_with(part, "seed:") { part } else { hole_first(hole_seconds(g.unfolds, part)) };
        let serves = hole_seconds(g.served, part);
        let consumes = hole_seconds(g.consumed, part);
        // the gate that is its done-when: its seed's, else a served contract's
        // and what the work is called: the part, or the contract it delivers
        let mut gate = if len(seed) > 0 { hole_first(hole_seconds(g.guards, seed)) } else { "" };
        let mut deliverable = p;
        let mut s2 = serves;
        while len(gate) == 0 && len(s2) > 0 {
            let n2 = std::str::index_of(s2, "\n");
            gate = hole_first(hole_seconds(g.guards, s2[0..n2]));
            if len(gate) > 0 { deliverable = dna::show_name(s2[0..n2]); }
            s2 = s2[(n2 + 1)..len(s2)];
        }
        if len(gate) > 0 {
            let dev = HoleDoc { name: p + "/dev", target: part, text: "Writes " + p + ", bound by its practices." };
            dev.question = "ratify the position `" + p + "/dev` under " + hole_kind(part) + " " + p + ": it writes " + p;
            dev.unfold(part, dev.node("position", p + "/dev", dev.text));
            if len(dev.error) > 0 { return HolesAnswer { error: dev.error }; }
            docs = docs + hole_line(dev.document(), dev.question, "holes", "graph", dev.name, dev.target);
            out.count = out.count + 1;
            work = work + part + "\t" + deliverable + "\t" + gate + "\n";
        }
        if len(serves) > 0 || len(consumes) > 0 {
            let rev = HoleDoc { name: p + "/reviewer", target: part, text: "Signs changes to " + p + " and to what it serves and consumes; never the same holder as " + p + "/dev." };
            let reviewer = rev.node("position", p + "/reviewer", rev.text);
            rev.unfold(part, reviewer);
            let subjects = (if len(seed) > 0 { seed + "\n" } else { "" }) + serves + consumes;
            let mut signs = "";
            let mut shown = "";
            let mut sub = subjects;
            while len(sub) > 0 {
                let n2 = std::str::index_of(sub, "\n");
                let c = sub[0..n2];
                sub = sub[(n2 + 1)..len(sub)];
                if std::str::contains("\n" + signs, "\n" + c + "\n") { continue; }
                signs = signs + c + "\n";
                let e = GraphEdge { kind: "reviews" };
                e.member("position", reviewer);
                e.member("subject", c);
                rev.row("graph.edge", e.id(), e.body());
                if std::str::starts_with(c, "contract:") { shown = shown + (if len(shown) > 0 { ", " } else { "" }) + dna::show_name(c); }
            }
            rev.question = "ratify the position `" + p + "/reviewer` under " + hole_kind(part) + " " + p + ", signing " + (if len(seed) > 0 { "its code" + (if len(shown) > 0 { " and " } else { "" }) } else { "" }) + shown;
            if len(rev.error) > 0 { return HolesAnswer { error: rev.error }; }
            docs = docs + hole_line(rev.document(), rev.question, "holes", "graph", rev.name, rev.target);
            out.count = out.count + 1;
        }
    }
    // a validated contract no part of the repository serves: its own dev and work
    let mut guarded = g.guards;
    while len(guarded) > 0 {
        let nl = std::str::index_of(guarded, "\n");
        let line = guarded[0..nl];
        guarded = guarded[(nl + 1)..len(guarded)];
        let t = std::str::index_of(line, "\t");
        let node = line[0..t];
        if !std::str::starts_with(node, "contract:") || hole_has_second(g.served, node) { continue; }
        let c = dna::show_name(node);
        let dev = HoleDoc { name: c + "/dev", target: node, text: "Writes " + c + ", bound by its practices." };
        dev.question = "ratify the position `" + c + "/dev` under contract " + c + ": it writes " + c;
        dev.unfold(node, dev.node("position", c + "/dev", dev.text));
        if len(dev.error) > 0 { return HolesAnswer { error: dev.error }; }
        docs = docs + hole_line(dev.document(), dev.question, "holes", "graph", dev.name, dev.target);
        out.count = out.count + 1;
        work = work + node + "\t" + c + "\t" + line[(t + 1)..len(line)] + "\n";
    }
    // an operator under each deployment, signing it; and the roles the project opts into, empty
    let mut deps = g.deployments;
    while len(deps) > 0 {
        let nl = std::str::index_of(deps, "\n");
        let deployment = deps[0..nl];
        deps = deps[(nl + 1)..len(deps)];
        let d = dna::show_name(deployment);
        let op = HoleDoc { name: d + "/operator", target: deployment, text: "Runs " + d + "." };
        op.question = "ratify the position `" + op.name + "` under deployment " + d + ": it runs " + d;
        let operator = op.node("position", op.name, op.text);
        op.unfold(deployment, operator);
        let e = GraphEdge { kind: "reviews" };
        e.member("position", operator);
        e.member("subject", deployment);
        op.row("graph.edge", e.id(), e.body());
        if len(op.error) > 0 { return HolesAnswer { error: op.error }; }
        docs = docs + hole_line(op.document(), op.question, "holes", "graph", op.name, op.target);
        out.count = out.count + 1;
        let mut k = 0;
        while len(dna::nth_word(roles, k)) > 0 {
            let role = dna::nth_word(roles, k);
            k = k + 1;
            let h = HoleDoc { name: d + "/" + role, target: deployment, text: "The " + role + " of " + d + "; no artifact implies it, and the Board names who holds it." };
            h.question = "ratify the position `" + h.name + "` under deployment " + d + ", proposed empty: the Board names who holds it";
            h.unfold(deployment, h.node("position", h.name, h.text));
            if len(h.error) > 0 { return HolesAnswer { error: h.error }; }
            docs = docs + hole_line(h.document(), h.question, "holes", "graph", h.name, h.target);
            out.count = out.count + 1;
        }
    }
    // the work, done when the gate guarding it passes
    let mut ws = work;
    while len(ws) > 0 {
        let nl = std::str::index_of(ws, "\n");
        let line = ws[0..nl];
        ws = ws[(nl + 1)..len(ws)];
        let t1 = std::str::index_of(line, "\t");
        let target = line[0..t1];
        let after = line[(t1 + 1)..len(line)];
        let t2 = std::str::index_of(after, "\t");
        let name = after[0..t2];
        let gate = after[(t2 + 1)..len(after)];
        // a gate is shown by its whole name (`ci/api`), not its last segment
        let shown = if std::str::starts_with(gate, "gate:") { gate[5..len(gate)] } else { gate };
        let w = HoleDoc { name: name, target: target, text: "Deliver " + name + "; done when " + shown + " passes." };
        w.question = "ratify the work `" + name + "`: done when " + shown + " passes";
        let id = graph_node_id("work", name);
        w.row("graph.node", id, graph_work_body(name, w.text, gate));
        w.unfold(target, id);
        if len(w.error) > 0 { return HolesAnswer { error: w.error }; }
        docs = docs + hole_line(w.document(), w.question, "holes", "graph", w.name, w.target);
        out.count = out.count + 1;
    }
    // the practices the documents mark, as advice
    let mut ps = g.practices;
    while len(ps) > 0 {
        let nl = std::str::index_of(ps, "\n");
        let doc = ps[0..nl];
        ps = ps[(nl + 1)..len(ps)];
        let name = std::json::find_string_field(doc, "name");
        let law = std::json::find_bool_field(doc, "law");
        let question = "ratify the practice `" + name + "` (" + std::json::find_string_field(doc, "source") + ") " + (if law { "as law, as its document proposes" } else { "as advice" });
        docs = docs + hole_line(doc, question, "practices", "practice", name, std::json::find_string_field(doc, "target"));
        out.count = out.count + 1;
    }
    out.proposals = docs;
    return out;
}
