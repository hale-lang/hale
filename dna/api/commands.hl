// Command HTTP adaptation only. The injected provider owns native authority,
// durable request identity, admission, and command-specific recovery.
import "../operations" as ops;

type CommandContext {
    root: String = "";
    source: Source = Source { };
    principal_mode: String = "";
    principal_name: String = "";
}
type CommandRequest {
    valid: Bool = false;
    request_id: String = "";
    operation: String = "dna.practice.propose";
    operation_version: String = "1";
    application_id: String = "";
    position_id: String = "org";
    target_kind: String = "dna.practice";
    target_id: String = "";
    subject_digest: String = "";
    expected_principal_mode: String = "";
    expected_principal_name: String = "";
    text: String = "";
    rationale: String = "";
    expected_review_state: String = "";
    verdict: String = "";
    comment: String = "";
    // Exact Organization source fields. Deployment enablement is separate;
    // historical Practice/Review payloads leave this branch empty.
    source_head: String = "";
    dependency_source: String = "";
    dependency_digest: String = "";
    record_head: String = "";
    source_text: String = "";
    expected_assignee: String = "";
    new_assignee: String = "";
    // Raising work: the intent's outcome and the position it is for.
    outcome: String = "";
    to: String = "";
    // A leg's claim and outcome (GH #946): typed copies of the wire.
    performer_kind: String = "";
    performer: String = "";
    effect_class: String = "";
    capabilities: String = "";
    data_classes: String = "";
    organizations: String = "";
    ttl: Int = 0;
    attempt_id: String = "";
    holder: String = "";
    token: Int = 0;
    disposition: String = "";
    result: String = "";
    result_ref: String = "";
    // GH #946 hardening: the hat the leg wore, on an outcome ("" and -1 when none)
    hat_digest: String = "";
    hat_head: String = "";
    hat_watermark: Int = -1;
    prompt_digest: String = "";
    renderer: String = "";
    narrative: String = "";
    evidence: String = "";
    receipts: String = "";
    hat_digest: String = "";
    prompt_digest: String = "";
    renderer: String = "";
}
type CommandCapability {
    available: Bool = false;
    authorized: Bool = false;
    reason: String = "";
    recipients: String = "[]";
}
type TaskCommandOutcome { state: String = ""; from: String = ""; to: String = ""; event_id: String = ""; }
type PersonRetirementOutcome { state: String = ""; from: String = ""; to: String = ""; event_id: String = ""; transferred: Int = -1; }
// The admitted ask and, re-derived on every read, the organism's answer to it.
type TaskCreateOutcome { intent_id: String = ""; intent_state: String = ""; task_id: String = ""; event_id: String = ""; }
// A leg's claim or outcome as it reads back (GH #946): the attempt and its lease, or the refusal.
type AttemptCommandOutcome {
    state: String = ""; attempt_id: String = ""; work_id: String = ""; task_id: String = ""; performer_kind: String = "";
    holder: String = ""; token: Int = -1; until: Int = 0; disposition: String = ""; reason: String = ""; event_id: String = "";
}
type OrganizationCommandCapabilities {
    configured: Bool = false;
    proposal: CommandCapability = CommandCapability { };
    review: CommandCapability = CommandCapability { };
}
type OrganizationCommandOutcome {
    proposal_state: String = "pending";
    source_head: String = "";
    source_digest: String = "";
    mutation_id: String = "";
    candidate_commit: String = "";
    application_state: String = "pending";
    application_reason_code: String = "";
    restart_handoff_state: String = "pending";
}
type CommandReceipt {
    command_id: String = "";
    request_id: String = "";
    application_id: String = "";
    operation: String = "dna.practice.propose";
    operation_version: String = "1";
    principal_mode: String = "";
    principal_name: String = "";
    position_id: String = "org";
    target_kind: String = "dna.practice";
    target_id: String = "";
    subject_digest: String = "";
    fingerprint: String = "";
    state: String = "";
    reason: String = "";
    // Only the branch selected by operation may contain values.
    proposal_state: String = "pending";
    verdict_value: String = "";
    verdict_state: String = "";
    candidate_digest: String = "";
    review_id: String = "";
    review_state: String = "unavailable";
    review_outcome: String = "";
    review_subject_digest: String = "";
    activation_state: String = "unknown";
    activation_reason: String = "";
    organization: OrganizationCommandOutcome = OrganizationCommandOutcome { };
    task: TaskCommandOutcome = TaskCommandOutcome { };
    person: PersonRetirementOutcome = PersonRetirementOutcome { };
    task_create: TaskCreateOutcome = TaskCreateOutcome { };
    attempt: AttemptCommandOutcome = AttemptCommandOutcome { };
}
type CommandResult {
    ok: Bool = false;
    code: String = "commands_unavailable";
    source: Source = Source { };
    receipt: CommandReceipt = CommandReceipt { };
}
interface CommandProvider {
    fn supported(operation: String, version: String) -> Bool;
    fn capability(context: CommandContext, operation: String, version: String) -> CommandCapability;
    fn submit(context: CommandContext, command: CommandRequest) -> CommandResult;
    fn lookup(context: CommandContext, request_id: String) -> CommandResult;
}
// Optional capability-only facet. The old command provider keeps its four
// methods; composition binds this facet to the same named provider.
interface OrganizationCapabilityProvider {
    fn organization_capabilities(context: CommandContext) -> OrganizationCommandCapabilities;
}
locus NoOrganizationCapabilities {
    params { }
    fn organization_capabilities(context: CommandContext) -> OrganizationCommandCapabilities { return OrganizationCommandCapabilities { }; }
}
locus NoCommands {
    params { }
    fn supported(operation: String, version: String) -> Bool { return false; }
    fn capability(context: CommandContext, operation: String, version: String) -> CommandCapability { return CommandCapability { }; }
    fn submit(context: CommandContext, command: CommandRequest) -> CommandResult { return CommandResult { code: "commands_unsupported" }; }
    fn lookup(context: CommandContext, request_id: String) -> CommandResult { return CommandResult { code: "commands_unsupported" }; }
}

type CommandHeader {
    valid: Bool = true;
    count: Int = 0;
    value: String = "";
}

locus CommandWire {
    params { }
    fn raw(object: String, key: String) -> String { return std::json::find_field_raw(object, key); }
    fn is_text(raw: String) -> Bool { return len(raw) >= 2 && std::str::starts_with(raw, "\"") && std::str::ends_with(raw, "\""); }
    fn text(object: String, key: String) -> String {
        let raw = self.raw(object, key);
        if !self.is_text(raw) { return ""; }
        let syntax = ops::OrganizationJson { };
        return syntax.decode(raw);
    }
    // Call only after strict syntax validation. Every object has its own
    // allowlist; permissive stdlib cursors alone are not schema validation.
    fn fields(object: String, names: String, expected: Int) -> Bool {
        if !std::str::starts_with(std::str::trim(object), "{") { return false; }
        let mut count = 0;
        let mut it = std::json::object_first(object);
        while !it.done {
            let key = std::json::obj_key_string(it, object);
            if !std::str::contains(" " + names + " ", " " + key + " ") { return false; }
            count = count + 1;
            it = std::json::object_next(it, object);
        }
        return count == expected;
    }
    fn header(headers: String, name: String) -> CommandHeader {
        let size = len(headers);
        if size > 16384 { return CommandHeader { valid: false }; }
        let mut result = CommandHeader { };
        let mut start = 0;
        while start < size {
            let tail = headers[start..size];
            let split = std::str::index_of(tail, "\r\n");
            let line = if split < 0 { tail } else { tail[0..split] };
            let colon = std::str::index_of(line, ":");
            // Obsolete folded headers and malformed names are ambiguous.
            if colon < 1 { return CommandHeader { valid: false }; }
            let key = line[0..colon];
            if key != std::str::trim(key) || std::str::contains(key, " ") || std::str::contains(key, "\t") { return CommandHeader { valid: false }; }
            if std::str::lower(key) == std::str::lower(name) {
                result.count = result.count + 1;
                result.value = std::str::trim(line[(colon + 1)..len(line)]);
            }
            if split < 0 { break; }
            start = start + split + 2;
        }
        return result;
    }
    fn origin_valid(origin: String) -> Bool {
        let scheme = if std::str::starts_with(origin, "https://") { 8 } else if std::str::starts_with(origin, "http://") { 7 } else { 0 };
        let size = len(origin);
        if scheme == 0 || size <= scheme || size > 2048 { return false; }
        let mut i = scheme;
        while i < size {
            let c = std::str::byte_at_unchecked(origin, i);
            if c <= 32 || c >= 127 || c == 47 || c == 92 || c == 64 || c == 63 || c == 35 { return false; }
            i = i + 1;
        }
        return true;
    }

    fn bounded(value: String, maximum: Int, nonempty: Bool, controls: Bool) -> Bool {
        let size = len(value);
        let syntax = ops::OrganizationJson { };
        if size > maximum || (nonempty && size == 0) || !syntax.utf8(value, size) { return false; }
        if controls { return true; }
        let mut i = 0;
        while i < size {
            let c = std::str::byte_at_unchecked(value, i);
            if c < 32 || c == 127 { return false; }
            i = i + 1;
        }
        return true;
    }
    fn known_operation(operation: String, version: String) -> Bool {
        return version == "1" && (operation == "dna.practice.propose" || operation == "dna.review.verdict" || operation == "dna.organization.propose" || operation == "dna.task.reassign" || operation == "dna.person.retire" || operation == "dna.task.create" || operation == "dna.attempt.claim" || operation == "dna.attempt.outcome" || operation == "dna.attempt.renew" || operation == "dna.attempt.release" || operation == "dna.friction.file");
    }
    fn known_request(operation: String, version: String) -> Bool {
        return self.known_operation(operation, version);
    }
    fn verdict_value(value: String) -> Bool { return value == "approve" || value == "reject" || value == "revise"; }
    fn parse(body: String, application_id: String) -> CommandRequest {
        let syntax = ops::OrganizationJson { };
        if len(body) > 32768 || !syntax.valid(body) || !self.fields(body, "request_id operation operation_version context target preconditions arguments", 7) { return CommandRequest { }; }
        let context = self.raw(body, "context");
        let target = self.raw(body, "target");
        let conditions = self.raw(body, "preconditions");
        let arguments = self.raw(body, "arguments");
        let operation = self.text(body, "operation");
        let version = self.text(body, "operation_version");
        if !self.known_request(operation, version) || !self.fields(context, "application_id position_id", 2) || !self.fields(target, "application_id kind id", 3) { return CommandRequest { }; }
        let practice = operation == "dna.practice.propose";
        let organization = operation == "dna.organization.propose";
        let task = operation == "dna.task.reassign";
        let person = operation == "dna.person.retire";
        let create = operation == "dna.task.create";
        let claim = operation == "dna.attempt.claim";
        let submit = operation == "dna.attempt.outcome";
        let renew = operation == "dna.attempt.renew";
        let give_back = operation == "dna.attempt.release";
        let friction = operation == "dna.friction.file";
        if claim {
            if !self.fields(conditions, "record_head principal", 2) || !self.fields(arguments, "performer_kind performer effect_class capabilities data_classes organizations ttl", 7) { return CommandRequest { }; }
        } else if submit {
            // the hat the leg wore rides on the outcome when it wore one: the
            // five fields together, or none of them
            if !self.fields(conditions, "holder token principal", 3) || !(self.fields(arguments, "effect_class disposition result result_ref narrative evidence receipts", 7) || self.fields(arguments, "effect_class disposition result result_ref narrative evidence receipts hat_digest hat_head hat_watermark prompt_digest renderer", 12)) { return CommandRequest { }; }
        } else if renew {
            if !self.fields(conditions, "holder token principal", 3) || !self.fields(arguments, "ttl", 1) { return CommandRequest { }; }
        } else if give_back {
            if !self.fields(conditions, "holder token principal", 3) || !self.fields(arguments, "why", 1) { return CommandRequest { }; }
        } else if friction {
            if !self.fields(conditions, "record_head principal", 2) || !self.fields(arguments, "position attempt_id text", 3) { return CommandRequest { }; }
        } else if create {
            if !self.fields(conditions, "record_head principal", 2) || !self.fields(arguments, "outcome to", 2) { return CommandRequest { }; }
        } else if person {
            if !self.fields(conditions, "subject_digest principal", 2) || !self.fields(arguments, "to", 1) { return CommandRequest { }; }
        } else if task {
            if !self.fields(conditions, "subject_digest principal assignee", 3) || !self.fields(arguments, "to", 1) { return CommandRequest { }; }
        } else if organization {
            if !self.fields(conditions, "base principal", 2) || !self.fields(arguments, "source_text rationale", 2) { return CommandRequest { }; }
        } else if practice {
            if !self.fields(conditions, "subject_digest principal", 2) || !self.fields(arguments, "text rationale", 2) { return CommandRequest { }; }
        } else {
            if !self.fields(conditions, "subject_digest principal review_state", 3) || self.text(conditions, "review_state") != "pending" || !self.fields(arguments, "verdict comment", 2) { return CommandRequest { }; }
        }
        let kind = self.text(target, "kind");
        if self.text(context, "position_id") != "org" || kind != if claim { "dna.work" } else if submit || renew || give_back { "dna.attempt" } else if friction { "dna.friction" } else if create { "dna.record" } else if person { "dna.person" } else if task { "dna.task" } else if organization { "dna.organization.module" } else if practice { "dna.practice" } else { "dna.review" } { return CommandRequest { }; }
        if self.text(context, "application_id") != application_id || self.text(target, "application_id") != application_id || !self.bounded(application_id, 256, true, false) { return CommandRequest { }; }
        let expected = self.raw(conditions, "principal");
        if !self.fields(expected, "mode name", 2) { return CommandRequest { }; }
        let expected_mode = self.text(expected, "mode");
        let expected_name = self.text(expected, "name");
        if (expected_mode != "local" && expected_mode != "oidc") || !self.bounded(expected_name, 256, true, false) { return CommandRequest { }; }
        let request_id = self.text(body, "request_id");
        let target_id = self.text(target, "id");
        let base = self.raw(conditions, "base");
        // A create is conditioned on the Record head it was prepared against;
        // that head is its subject.
        let leased = submit || renew || give_back;
        let token_raw = if leased { std::str::trim(self.raw(conditions, "token")) } else { "0" };
        if leased && !std::str::can_parse_int(token_raw) { return CommandRequest { }; }
        let token = std::str::parse_int(token_raw) or 0;
        let digest = if organization { self.text(base, "module_digest") } else if create || claim || friction { self.text(conditions, "record_head") } else if leased { "lease:" + self.text(conditions, "holder") + "@" + to_string(token) } else { self.text(conditions, "subject_digest") };
        if !self.bounded(request_id, 128, true, false) || !self.bounded(digest, 256, true, false) || !self.bounded(target_id, 256, true, false) { return CommandRequest { }; }
        let mut command = CommandRequest { valid: true, request_id: request_id, operation: operation, application_id: application_id, target_kind: kind, target_id: target_id, subject_digest: digest, expected_principal_mode: expected_mode, expected_principal_name: expected_name };
        if claim || leased || friction {
            if friction {
                command.record_head = digest;
                command.performer = self.text(arguments, "position"); command.attempt_id = self.text(arguments, "attempt_id"); command.result = self.text(arguments, "text");
                if target_id != application_id || !self.is_text(self.raw(arguments, "position")) || !self.is_text(self.raw(arguments, "attempt_id")) || !self.is_text(self.raw(arguments, "text")) { return CommandRequest { }; }
            } else if renew || give_back {
                command.attempt_id = target_id; command.holder = self.text(conditions, "holder"); command.token = token;
                if !self.is_text(self.raw(conditions, "holder")) { return CommandRequest { }; }
                if renew {
                    let ttl_raw = std::str::trim(self.raw(arguments, "ttl"));
                    if !std::str::can_parse_int(ttl_raw) { return CommandRequest { }; }
                    command.ttl = std::str::parse_int(ttl_raw) or 0;
                } else {
                    if !self.is_text(self.raw(arguments, "why")) { return CommandRequest { }; }
                    command.narrative = self.text(arguments, "why");
                }
            } else if claim {
                command.record_head = digest;
                command.performer_kind = self.text(arguments, "performer_kind"); command.performer = self.text(arguments, "performer"); command.effect_class = self.text(arguments, "effect_class");
                command.capabilities = self.words(self.raw(arguments, "capabilities")); command.data_classes = self.words(self.raw(arguments, "data_classes")); command.organizations = self.words(self.raw(arguments, "organizations"));
                let ttl_raw = std::str::trim(self.raw(arguments, "ttl"));
                if !std::str::can_parse_int(ttl_raw) || !self.is_text(self.raw(arguments, "performer_kind")) || !self.is_text(self.raw(arguments, "performer")) || !self.is_text(self.raw(arguments, "effect_class")) { return CommandRequest { }; }
                command.ttl = std::str::parse_int(ttl_raw) or 0;
                if target_id != application_id || command.capabilities == "!" || command.data_classes == "!" || command.organizations == "!" { return CommandRequest { }; }
            } else {
                command.attempt_id = target_id; command.holder = self.text(conditions, "holder"); command.token = token;
                command.effect_class = self.text(arguments, "effect_class");
                command.disposition = self.text(arguments, "disposition"); command.result = self.text(arguments, "result"); command.result_ref = self.text(arguments, "result_ref"); command.narrative = self.text(arguments, "narrative");
                let evidence = std::str::trim(self.raw(arguments, "evidence")); let receipts = std::str::trim(self.raw(arguments, "receipts"));
                if !std::str::starts_with(evidence, "[") || !std::str::starts_with(receipts, "[") || !self.is_text(self.raw(conditions, "holder")) || !self.is_text(self.raw(arguments, "disposition")) || !self.is_text(self.raw(arguments, "effect_class"))
                    || !self.is_text(self.raw(arguments, "result")) || !self.is_text(self.raw(arguments, "result_ref")) || !self.is_text(self.raw(arguments, "narrative")) { return CommandRequest { }; }
                command.evidence = if evidence == "[]" { "" } else { evidence }; command.receipts = if receipts == "[]" { "" } else { receipts };
                if len(self.raw(arguments, "hat_digest")) > 0 {
                    let watermark_raw = std::str::trim(self.raw(arguments, "hat_watermark"));
                    if !self.is_text(self.raw(arguments, "hat_digest")) || !self.is_text(self.raw(arguments, "hat_head")) || !std::str::can_parse_int(watermark_raw)
                        || !self.is_text(self.raw(arguments, "prompt_digest")) || !self.is_text(self.raw(arguments, "renderer")) { return CommandRequest { }; }
                    command.hat_digest = self.text(arguments, "hat_digest"); command.hat_head = self.text(arguments, "hat_head"); command.hat_watermark = std::str::parse_int(watermark_raw) or - 1;
                    command.prompt_digest = self.text(arguments, "prompt_digest"); command.renderer = self.text(arguments, "renderer");
                }
            }
            // the codec's own rules — a lease's token, a disposition the
            // outcome contract carries, bounded evidence — refuse here too
            let attempts = ops::AttemptCommandCodec { };
            let native_context = ops::GovernanceContext { application_id: application_id, principal_mode: expected_mode, principal_name: expected_name };
            if !attempts.valid(native_context, attempt_native(command)) { return CommandRequest { }; }
        } else if create {
            command.record_head = digest; command.outcome = self.text(arguments, "outcome"); command.to = self.text(arguments, "to");
            if target_id != application_id || !self.bounded(command.outcome, 8192, true, true) || !self.bounded(command.to, 256, true, false) { return CommandRequest { }; }
        } else if person {
            command.new_assignee = self.text(arguments, "to");
            if !dna::digest_well_formed(digest) || !self.is_text(self.raw(arguments, "to")) || !self.bounded(command.new_assignee, 256, false, false) || command.new_assignee == target_id { return CommandRequest { }; }
        } else if task {
            command.expected_assignee = self.text(conditions, "assignee"); command.new_assignee = self.text(arguments, "to");
            if !dna::digest_well_formed(digest) || !self.bounded(command.expected_assignee, 256, true, false) || !self.bounded(command.new_assignee, 256, true, false) || command.expected_assignee == command.new_assignee { return CommandRequest { }; }
        } else if organization {
            if !self.fields(base, "source_head module_digest dependency_digest dependency_source record_head", 5) || target_id != "dna/org/main.hl" { return CommandRequest { }; }
            command.source_head = self.text(base, "source_head");
            command.dependency_source = self.text(base, "dependency_source"); command.dependency_digest = self.text(base, "dependency_digest");
            command.record_head = self.text(base, "record_head"); command.source_text = self.text(arguments, "source_text"); command.rationale = self.text(arguments, "rationale");
            let codec = ops::OrganizationCommandCodec { };
            let native_context = ops::GovernanceContext { application_id: application_id, principal_mode: expected_mode, principal_name: expected_name };
            let native = ops::GovernanceCommand { request_id: request_id, operation: operation, application_id: application_id, target_kind: kind, target_id: target_id,
                subject_digest: digest, source_head: command.source_head, dependency_source: command.dependency_source, dependency_digest: command.dependency_digest,
                record_head: command.record_head, source_text: command.source_text, rationale: command.rationale };
            if !codec.valid(native_context, native) { return CommandRequest { }; }
        } else if practice {
            command.text = self.text(arguments, "text"); command.rationale = self.text(arguments, "rationale");
            if target_id != digest || !self.bounded(command.text, 8192, true, true) || !self.bounded(command.rationale, 2048, true, true) { return CommandRequest { }; }
        } else {
            command.expected_review_state = "pending"; command.verdict = self.text(arguments, "verdict"); command.comment = self.text(arguments, "comment");
            if !self.verdict_value(command.verdict) || !self.is_text(self.raw(arguments, "comment")) || !self.bounded(command.comment, 2048, false, true) { return CommandRequest { }; }
        }
        return command;
    }
    fn lookup_id(query: String) -> String {
        if !std::str::starts_with(query, "request_id=") || std::str::contains(query, "&") || len(query) > 1024 { return ""; }
        let http = Http { };
        let id = http.decode(query[11..len(query)]);
        if !id.ok || !self.bounded(id.text, 128, true, false) { return ""; }
        return id.text;
    }
    fn guard(req: std::http::Request, origin: String) -> String {
        if !self.origin_valid(origin) { return "commands_unsupported"; }
        let supplied = self.header(req.headers, "Origin");
        if !supplied.valid || supplied.count != 1 || supplied.value != origin { return "invalid_origin"; }
        let content = self.header(req.headers, "Content-Type");
        if !content.valid || content.count != 1 || std::str::lower(content.value) != "application/json" { return "unsupported_media_type"; }
        let marker = self.header(req.headers, "X-Hale-Command");
        if !marker.valid || marker.count != 1 || marker.value != "1" { return "invalid_command"; }
        let length = self.header(req.headers, "Content-Length");
        let transfer = self.header(req.headers, "Transfer-Encoding");
        if !length.valid || length.count > 1 || !transfer.valid || transfer.count > 0 { return "invalid_command"; }
        if length.count == 1 && length.value != to_string(len(req.body)) { return "invalid_command"; }
        if len(req.body) > 32768 { return "command_too_large"; }
        return "";
    }
    fn capability_json(capability: CommandCapability, origin: String, operation: String) -> String {
        let available = capability.available && self.origin_valid(origin);
        let b = std::json::Builder { };
        b.begin_object();
        b.string_field("profile", operation + ".v1");
        b.bool_field("available", available); b.bool_field("authorized", capability.authorized);
        b.string_field("position_id", "org"); b.string_field("recovery", "record_lifetime");
        if operation == "dna.practice.propose" {
            b.string_field("max_text_bytes", "8192"); b.string_field("max_rationale_bytes", "2048");
        } else { b.string_field("max_comment_bytes", "2048"); }
        b.string_field("reason", if !self.origin_valid(origin) { "Command submission has no configured origin." } else if self.bounded(capability.reason, 512, false, true) { capability.reason } else { "Command capability is unavailable." });
        b.end_object(); return b.result();
    }
    fn organization_capability_json(capability: CommandCapability, origin: String, review: Bool) -> String {
        let usable_origin = self.origin_valid(origin); let b = std::json::Builder { }; b.begin_object();
        b.string_field("profile", if review { "dna.organization.review.verdict.v1" } else { "dna.organization.propose.v1" });
        if review { b.string_field("operation", "dna.review.verdict"); }
