// dna/tests/optimize_test.hl — GH #596 O: the optimize pass.
//
// On a cadence the org chart sets, the substrate reads the record's
// structural signals and asks the leader to walk the machinery, not
// the work. The leader answers with one small proposal or none; the
// record keeps `org.reviewed` either way — "if the state is clean, say
// so" — and a proposal enters as an ask in the leader's name and takes
// the whole road. Two organisms here, keyed apart on the one bus: one
// whose leader finds the state clean, one whose leader proposes a
// secretary (and whose plan of that ask calls it a person's job, so
// nothing is mutated in this fixture).

import "../core" as dna;

const CLEAN: String = "proposal: none\nThe routing catches every ask, no grant contracted, no concern outstanding.";
const SECRETARY: String = "proposal: add a secretary position that triages asks before the leader plans them\nkind: person\nclass: docs\ncount: 1\nAsks keep falling through to the leader for triage; minimal structure says one operator, not a department.";

main locus App {
    params {
        one: dna::Dna = dna::Dna { journal: dna::MemJournal { }, org_id: "one", planned: true };
        lead_one: dna::Leader = dna::Leader {
            name: "leader", org: "one", charter: "You are the architect.",
            models: dna::ModelRouter { quick: dna::FakeModel { name: "quick", answer: CLEAN }, deep: dna::FakeModel { name: "deep", answer: CLEAN } }
        };
        two: dna::Dna = dna::Dna { journal: dna::MemJournal { }, org_id: "two", planned: true };
        // an allowance one pass exhausts: the first pass is paid for, the second is refused
        three: dna::Dna = dna::Dna { journal: dna::MemJournal { }, org_id: "three", planned: true, optimize_every_ms: 60000, budget: dna::Budget { policy: dna::BudgetPolicy { window: "none", allowance_micros: 1 } } };
        lead_three: dna::Leader = dna::Leader {
            name: "leader", org: "three", charter: "You are the architect.",
            models: dna::ModelRouter { quick: dna::FakeModel { name: "quick", answer: CLEAN }, deep: dna::FakeModel { name: "deep", answer: CLEAN } }
        };
        lead_two: dna::Leader = dna::Leader {
            name: "leader", org: "two", charter: "You are the architect.",
            models: dna::ModelRouter { quick: dna::FakeModel { name: "quick", answer: SECRETARY }, deep: dna::FakeModel { name: "deep", answer: SECRETARY } }
        };
    }
    @unbounded
    fn last(j: dna::Journal, kind: String) -> String {
        let mut out = "";
        let mut i = 0;
        while i < j.revision() {
            let e = j.read(i);
            if e.kind == kind { out = e.body; }
            i = i + 1;
        }
        return out;
    }
    @unbounded
    fn count(j: dna::Journal, kind: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < j.revision() {
            if j.read(i).kind == kind { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    run() {
        // ---- the budget admits the pass, as it admits every model-backed piece of work.
        // First, before the other organisms spend: every model call on this
        // one bus is accounted by every organism on it (a fixture hazard,
        // not a product one: production runs one organism per process).
        self.three.tick(61000);
        std::time::sleep(300ms);
        std::test::assert_eq_int(self.three.optimizations, 1, "the first pass ran within the allowance");
        std::test::assert_eq_int(self.count(self.three.journal, "org.reviewed"), 1, "and was answered");
        self.three.tick(121000);
        std::time::sleep(300ms);
        std::test::assert_eq_int(self.three.optimizations, 1, "the second pass was not taken: the window is spent");
        std::test::assert_eq_int(self.count(self.three.journal, "org.reviewed"), 1, "nothing was asked of the leader");
        std::test::assert_eq_int(self.lead_three.optimizations, 1, "the leader was not walked again");
        let refused = self.last(self.three.journal, "optimize.refused");
        std::test::assert(std::str::contains(refused, "budget exhausted") && std::str::contains(refused, "waits for the next window"), "the record says why: " + refused);
        std::test::assert_eq_int(self.count(self.three.journal, "budget.exhausted"), 1, "the window's exhaustion was announced once");

        // ---- the cadence: nothing fires with no cadence set
        self.one.tick(1000);
        self.one.tick(200000);
        std::test::assert_eq_int(self.one.optimizations, 0, "no cadence, no pass");
        // a cadence of 60s: the first pass one window after the start,
        // the next tick within the window does not fire
        self.one.optimize_every_ms = 60000;
        self.one.tick(1000);
        std::test::assert_eq_int(self.one.optimizations, 0, "not before a window has passed");
        self.one.tick(61000);
        self.one.tick(90000);
        std::time::sleep(300ms);
        std::test::assert_eq_int(self.one.optimizations, 1, "one pass after the window, none within the next");
        std::test::assert_eq_int(self.lead_one.optimizations, 1, "the leader walked the machinery once");
        // ---- clean: the record says so, and nothing is born
        let r1 = self.last(self.one.journal, "org.reviewed");
        std::test::assert(std::str::contains(r1, "\"outcome\": \"clean\"") && std::str::contains(r1, "\"proposal\": \"\""), "clean is recorded: " + r1);
        std::test::assert(std::str::contains(r1, "asks planned: 0") && std::str::contains(r1, "record rows: "), "the signals the leader read are in the row: " + r1);
        // the pass is an execution of optimize-walk (GH #995): its own Task,
        // and nothing asked
        std::test::assert_eq_int(self.count(self.one.journal, "workflow.admitted"), 1, "the pass is one execution");
        std::test::assert(std::str::contains(self.last(self.one.journal, "workflow.admitted"), "\"definition\": \"optimize-walk\""), "of optimize-walk: " + self.last(self.one.journal, "workflow.admitted"));
        std::test::assert_eq_int(self.count(self.one.journal, "intent.offered"), 0, "no work for the sake of activity");
        std::test::assert_eq_int(self.lead_two.optimizations, 0, "the other organism's leader heard nothing: keyed apart");

        // ---- a proposal: one small change, entering as an ask in the leader's name
        self.two.optimize();
        std::time::sleep(600ms);
        let r2 = self.last(self.two.journal, "org.reviewed");
        std::test::assert(std::str::contains(r2, "\"outcome\": \"proposed\"") && std::str::contains(r2, "\"proposal\": \"add a secretary position that triages asks before the leader plans them\"") && std::str::contains(r2, "\"by\": \"leader\""), "the proposal is recorded: " + r2);
        std::test::assert_eq_int(self.count(self.two.journal, "workflow.admitted"), 2, "and became one ask beside the pass (card 18: admitted as a workflow)");
        std::test::assert(std::str::contains(self.last(self.two.journal, "workflow.admitted"), "add a secretary position"), "the ask is the proposal: " + self.last(self.two.journal, "workflow.admitted"));
        std::test::assert(std::str::contains(self.last(self.two.journal, "intent.offered"), "add a secretary position"), "offered as intent");
        // the ask took the road every ask takes: planned by the leader —
        // here as a person's job, so it was handed rather than mutated
        std::test::assert_eq_str(self.two.ask_plan_of("t2").kind, "person", "planned as a person's job, the word bound in the admission");
        std::test::assert(std::str::contains(self.last(self.two.journal, "task.handed"), "\"case\": \"t2.s0.p\""), "handed as its case: " + self.last(self.two.journal, "task.handed"));
        std::test::assert_eq_int(self.count(self.one.journal, "intent.offered"), 0, "the clean organism stayed clean");
    }
}
fn main() { App { }; }
