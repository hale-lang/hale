// dna/tests/journal_contention_test.hl — GH #603: an organism's append
// that loses the race at the record's tail goes round with the new tail
// until it lands. Three tries used to be the bound, and a busy second
// writer dropped the organism's own rows in silence. Here another writer
// (a shell loop through memory's own append function, GH #1590) appends
// two hundred rows while the journal appends forty; every row of both
// lands, once.

import "../core" as dna;

const SCRIPT: String = "dsn=\"$1\"; sch=\"$2\"; dir=\"$3\"; n=0\nwhile [ $n -lt 200 ]; do\n  out=$(psql \"$dsn\" -tAq -c \"SET search_path TO $sch, public\" -c \"SELECT record_append(-1, coalesce((SELECT digest FROM record_rows ORDER BY seq DESC LIMIT 1), 'genesis'), 'shell.row', 's$n', 'row $n', 'shell', '', '')\" 2>/dev/null)\n  case \"$out\" in *'\"error\" : \"\"'*) n=$((n+1)) ;; esac\ndone\ntouch \"$dir/shell.done\"\n";

main locus App {
    params {
        j: dna::RecordJournal = dna::RecordJournal { };
    }
    fn count(kind: String) -> Int {
        let mut n = 0;
        let mut i = 0;
        while i < self.j.revision() {
            if self.j.read(i).kind == kind { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    fn has_body(body: String) -> Bool {
        let mut i = 0;
        while i < self.j.revision() {
            if self.j.read(i).body == body { return true; }
            i = i + 1;
        }
        return false;
    }
    run() {
        let repo = dna::scratch_root("jc");
        std::io::fs::mkdir(repo + "/.hale") or discard;
        std::io::fs::mkdir(repo + "/.hale/dna") or discard;
        let init = dna::run_tool("git\n-C\n" + repo + "\ninit\n-q\n-b\nmain");
        std::test::assert_eq_str(dna::memory_fixture(repo), "", "the record is born in memory");
        self.j = dna::RecordJournal { repo: repo, author: "org" };
        let born = self.j.revision();
        let seed = self.j.append(self.j.revision(), "seed", "s", "the first row");
        std::test::assert(seed.ok, "seeded");
        std::io::fs::write_file(repo + "/.hale/dna/appender.sh", SCRIPT) or discard;
        // the other writer, detached: it compare-and-swaps like a host does
        let owner = std::env::var("HALE_DNA_MEMORY_DSN_OWNER");
        let spawn = dna::run_tool("sh\n-c\nnohup sh \"$1\" \"$2\" \"$3\" \"$4\" >/dev/null 2>&1 &\nsh\n" + repo + "/.hale/dna/appender.sh\n" + owner + "\n" + dna::schema_for(dna::record_scope(repo)) + "\n" + repo + "/.hale/dna");
        std::test::assert_eq_int(spawn.code, 0, "the appender started: " + spawn.stderr);
        let mut i = 0;
        while i < 40 {
            let r = self.j.append(self.j.revision(), "org.row", "o" + to_string(i), "org row " + to_string(i));
            std::test::assert(r.ok, "org row " + to_string(i) + " landed (" + r.error + ": " + self.j.last_error() + ")");
            i = i + 1;
        }
        let mut waited = 0;
        while !std::io::fs::file_exists(repo + "/.hale/dna/shell.done") && waited < 1200 {
            std::time::sleep(100ms);
            waited = waited + 1;
        }
        std::test::assert(waited < 1200, "the appender finished");
        let moved = self.j.refresh();
        std::test::assert_eq_int(self.count("shell.row"), 200, "every shell row landed");
        std::test::assert_eq_int(self.count("org.row"), 40, "every org row landed, once");
        std::test::assert_eq_int(self.j.revision(), born + 241, "and nothing else");
        i = 0;
        while i < 40 {
            std::test::assert(self.has_body("org row " + to_string(i)), "org row " + to_string(i) + " is in the record");
            i = i + 1;
        }
        dna::scratch_done(repo);
    }
}
fn main() { App { }; }
