// dna/tests/compose_projects_test.hl — each seed's compose is a project
// of its own, and its database's password is the vault's (GH #989).
//
// Two seeds on one machine used to share one compose project, and then
// two checkouts of one seed did: their containers and database were one.
// Each checkout now runs its seed's compose as a project of its own
// (GH #1653), `hale-dna-<seed>-<checkout>`, with its own volumes and host
// ports; dna/compose.yaml names the seed (`x-hale-dna-seed`) and no
// project, and `upgrade` rewrites an older file to it.
// The database's superuser password is drawn by the bootstrap into the
// vault (`postgres-owner-<seed>`) and into dna/postgres.secrets, which
// compose mounts for the server and git never tracks; no committed file
// holds it. A clone elsewhere is the same seed, whatever its directory
// is called. Nothing here starts a container: `docker compose config`
// shows the project compose resolves, when docker compose is on PATH.

import "../core" as dna;

fn toolchain() -> String {
    if std::env::var_exists("HALE_BIN") { return std::env::var("HALE_BIN"); }
    return "hale";
}

// Run `argv` (newline-separated) in `dir`, with `vault` as the vault, no
// compose project named from outside and no discovery.
fn in_dir(dir: String, vault: String, argv: String) -> dna::RunResult {
    return dna::run_tool("sh\n-c\ncd \"$1\" && export HALE_VAULT_DIR=\"$2\" HALE_DNA_DISCOVER=off && shift 2 && unset COMPOSE_PROJECT_NAME HALE_VAULT_ADDR && exec \"$@\"\nsh\n" + dir + "\n" + vault + "\n" + argv);
}

fn text_of(path: String) -> String { return std::io::fs::read_file(path) or ""; }

fn main() {
    let scratch = dna::scratch_root("compose-projects");
    let vault = scratch + "/vault";
    let a = "twin-a" + to_string(std::process::pid());
    let b = "twin-b" + to_string(std::process::pid());
    let made_a = in_dir(scratch, vault, toolchain() + "\ndna\nnew\n" + a);
    std::test::assert_eq_int(made_a.code, 0, "hale dna new " + a + ": " + made_a.stdout + made_a.stderr);
    let made_b = in_dir(scratch, vault, toolchain() + "\ndna\nnew\n" + b);
    std::test::assert_eq_int(made_b.code, 0, "hale dna new " + b + ": " + made_b.stdout + made_b.stderr);
    let root_a = scratch + "/" + a;
    let root_b = scratch + "/" + b;

    // ---- two seeds, two compose projects; two checkouts of one seed, two
    // more (GH #1653): the project is the checkout's
    let compose_a = text_of(root_a + "/dna/compose.yaml");
    let compose_b = text_of(root_b + "/dna/compose.yaml");
    std::test::assert(std::str::contains(compose_a, "\nx-hale-dna-seed: " + a + "\n") && std::str::contains(compose_b, "\nx-hale-dna-seed: " + b + "\n"), "each seed's compose names its seed: " + compose_a + compose_b);
    std::test::assert(!std::str::contains(compose_a, "\nname: ") && !std::str::contains(compose_a, "127.0.0.1:"), "and no project name or host port of its own: the checkout's are: " + compose_a);

    // ---- the database's password: the vault's, never a committed value
    std::test::assert(!std::str::contains(compose_a, "POSTGRES_PASSWORD:") && std::str::contains(compose_a, "POSTGRES_PASSWORD_FILE: /run/secrets/postgres-owner") && std::str::contains(compose_a, "./postgres.secrets:/run/secrets/postgres-owner:ro"), "the compose file names the password's file, never the password: " + compose_a);
    let pw_a = text_of(root_a + "/dna/postgres.secrets");
    let pw_b = text_of(root_b + "/dna/postgres.secrets");
    std::test::assert(len(pw_a) == 32 && len(pw_b) == 32 && pw_a != pw_b, "each seed's password is drawn, and its own");
    std::test::assert_eq_str(dna::file_mode(root_a + "/dna/postgres.secrets"), "600", "the password's file is yours alone");
    std::test::assert_eq_str(dna::file_mode(vault), "700", "and so is the vault");
    std::test::assert_eq_str(dna::file_mode(vault + "/postgres-owner-" + a), "600", "and its entry");
    let ignored = in_dir(root_a, vault, "git\ncheck-ignore\n-q\ndna/postgres.secrets");
    std::test::assert_eq_int(ignored.code, 0, "and git ignores it");
    let listed = in_dir(root_a, vault, toolchain() + "\ndna\nsecrets\n.");
    std::test::assert(std::str::contains(listed.stdout, "present  postgres-owner-" + a + "  ") && !std::str::contains(listed.stdout, pw_a), "`hale dna secrets` names the entry, never its value: " + listed.stdout + listed.stderr);
    let held = in_dir(root_a, vault, "sh\n-c\ncmp -s \"$HALE_VAULT_DIR/postgres-owner-$1\" dna/postgres.secrets\nsh\n" + a);
    std::test::assert_eq_int(held.code, 0, "the vault's entry and the server's file are one draw");

    // ---- a clone elsewhere, under another directory name, is the same
    // seed: upgrade leaves its compose file as it is, and writes its
    // server's password file from the vault's entry, not a new draw.
    // Git's auto-maintenance after a commit may pack the loose objects
    // and delete them while a local clone copies them file by file
    // ("failed to copy file to ../elsewhere/.git/objects/…"): the seed
    // runs none, and the clone reads through git's object store
    // (`--no-local`), which finds an object loose or packed.
    let committed = in_dir(root_a, vault, "sh\n-c\ngit config user.name riley && git config user.email riley@dna && git config maintenance.auto false && git config gc.auto 0 && git add -A && git commit -q -m seed && git clone -q --no-local . ../elsewhere");
    std::test::assert_eq_int(committed.code, 0, "the seed committed and cloned: " + committed.stderr);
    // the clone reaches the record's memory as a person's does (GH #1590)
    let reached = in_dir(scratch + "/elsewhere", vault, toolchain() + "\ndna\nmemory\nmigrate");
    std::test::assert_eq_int(reached.code, 0, "the clone reaches the record's memory: " + reached.stdout + reached.stderr);
    let cloned = in_dir(scratch + "/elsewhere", vault, toolchain() + "\ndna\nupgrade\n.");
    let drift = in_dir(scratch + "/elsewhere", vault, "git\nstatus\n--porcelain\ndna/compose.yaml");
    std::test::assert(cloned.code == 0 && len(dna::trim_nl(drift.stdout)) == 0 && text_of(scratch + "/elsewhere/dna/compose.yaml") == compose_a, "the clone's compose is the seed's, unchanged: " + cloned.stdout + cloned.stderr + drift.stdout);
    std::test::assert_eq_str(text_of(scratch + "/elsewhere/dna/postgres.secrets"), pw_a, "and its password file is the vault's entry, not a new draw");
    // the clone is another checkout of the same seed: its compose project,
    // its volumes and its host ports are its own (GH #1653)
    let clone_a = scratch + "/elsewhere";
    let p_a = dna::local_compose_project(root_a);
    let p_b = dna::local_compose_project(root_b);
    let p_clone = dna::local_compose_project(clone_a);
    std::test::assert(std::str::starts_with(p_a, "hale-dna-" + a + "-") && std::str::starts_with(p_b, "hale-dna-" + b + "-") && std::str::starts_with(p_clone, "hale-dna-" + a + "-"), "each checkout's project carries its seed: " + p_a + " " + p_b + " " + p_clone);
    std::test::assert(p_a != p_clone && p_a != p_b, "and is the checkout's own: " + p_a + " " + p_clone);
    std::test::assert_eq_str(dna::local_compose_project(root_a), p_a, "the same on every run of the same checkout");
    let argv_a = dna::local_compose(root_a);
    let argv_clone = dna::local_compose(clone_a);
    let ports_a = text_of(root_a + "/" + dna::LOCAL_COMPOSE_FILE);
    let ports_clone = text_of(clone_a + "/" + dna::LOCAL_COMPOSE_FILE);
    std::test::assert(std::str::contains(ports_a, ":5432\"]") && std::str::contains(ports_a, ":4222\"]") && std::str::contains(ports_a, ":9090\"]") && ports_a != ports_clone, "each checkout publishes on host ports of its own: " + ports_a + ports_clone);
    std::test::assert_eq_str(text_of(root_a + "/" + dna::LOCAL_COMPOSE_FILE), ports_a, "chosen once, and kept");
    std::test::assert_eq_int(in_dir(clone_a, vault, "git\ncheck-ignore\n-q\n" + dna::LOCAL_COMPOSE_FILE).code, 0, "and never tracked");
    if dna::run_tool("docker\ncompose\nversion").code == 0 {
        let seen_a = dna::run_tool(argv_a + "\nconfig");
        let seen_clone = dna::run_tool(argv_clone + "\nconfig");
        std::test::assert(std::str::starts_with(seen_a.stdout, "name: " + p_a + "\n") && std::str::starts_with(seen_clone.stdout, "name: " + p_clone + "\n"), "compose resolves each checkout's project: " + seen_a.stdout + seen_a.stderr + seen_clone.stdout + seen_clone.stderr);
        std::test::assert(std::str::contains(seen_a.stdout, "name: " + p_a + "_knowledge-db") && std::str::contains(seen_clone.stdout, "name: " + p_clone + "_knowledge-db"), "and each its own memory volume");
    } else {
        eprintln("compose_projects_test: docker compose is not on PATH; the resolved project names are not checked");
    }

    // ---- an older compose file, rewritten by upgrade (a hard cut)
    let old = std::str::replace(std::str::replace(compose_b, "x-hale-dna-seed: " + b + "\n", "name: hale-dna-" + b + "\n"), "POSTGRES_PASSWORD_FILE: /run/secrets/postgres-owner", "POSTGRES_PASSWORD: dna");
    std::io::fs::write_file(root_b + "/dna/compose.yaml", old) or discard;
    let upgraded = in_dir(root_b, vault, toolchain() + "\ndna\nupgrade\n.");
    let now = text_of(root_b + "/dna/compose.yaml");
    std::test::assert(upgraded.code == 0 && std::str::contains(upgraded.stdout, "rewrote") && now == compose_b, "upgrade rewrites an older compose file to the seed's own project and the vault's password: " + upgraded.stdout + upgraded.stderr);

    dna::scratch_done(scratch);
}
