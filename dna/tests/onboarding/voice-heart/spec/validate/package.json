{
  "name": "voice-spec-validate",
  "private": true,
  "type": "module",
  "description": "Checks the api's canned bodies, a running api or node, and the api's exported surface against voice's contracts.",
  "scripts": {
    "canned": "node validate.mjs ../../build/openapi.bundled.json ../../api/canned",
    "live": "node live.mjs ../../build/openapi.bundled.json",
    "node-live": "node node-live.mjs ../../build/node.bundled.json",
    "bundle": "node bundle.mjs ../../build/openapi.bundled.json ../../api/bundle/Voice.openapi.json ../../api/gaps.json",
    "bundle-negative": "node negative.mjs ../../build/openapi.bundled.json ../../api/bundle/Voice.openapi.json ../../api/gaps.json"
  },
  "dependencies": {
    "ajv": "^8",
    "ajv-formats": "^3"
  }
}
