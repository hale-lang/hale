// dna/core/topics.hl — facts that cross a real boundary.
//
// Most transitions stay inside the owning locus and are read by the
// owner through `release(c)`. Topics exist only where a fact must
// cross an ownership tower, a placement, persistence, observation, or
// the external membrane (#521 "domain facts and topic families").

// Human/external intent entering the organism's membrane.
type IntentOffer { intent_id: String = ""; outcome: String = ""; from: String = ""; to: String = ""; }
topic IntentOffered { payload: IntentOffer; subject: "dna.intent.offered"; }

// A delegated child Task settled. Published by the Task pool owner
// (Metabolism) on behalf of the spawning Step, keyed by the PARENT
// task so only the waiting Step's tower hears it — supersystem
// mediation, not sibling chatter (H9).
type TaskSettlement {
    task_id: String = "";
    parent_task: String = "";
    spawning_step: String = "";
    disposition: String = "";
    detail: String = "";
}
topic TaskSettled { payload: TaskSettlement; subject: "dna.task.settled"; keyed_by parent_task; }

// GH #646 card 05: one transition of a workflow execution, proposed by the
// resident that owns it to the one committer (the journal's owner), and the
// committer's answer. `proposal_id` names the transition, not the message:
// the same transition proposed again carries the same id, is answered from
// what was committed, and the same id with anything else is a conflict
// (dna/WORKFLOW-CONTRACT.md §9).
type TransitionProposal {
    scope: String = ""; // which committer answers
    key: String = ""; // the proposer, and the answer's routing key
    proposal_id: String = "";
    kind: String = ""; // the fact this transition appends
    entity: String = "";
    body: String = ""; // the encoded fact (workflow_events.hl)
}
topic TransitionProposed { payload: TransitionProposal; subject: "dna.transition.proposed"; keyed_by scope; }

type TransitionAnswer {
    scope: String = "";
    key: String = "";
    proposal_id: String = "";
    ok: Bool = false;
    revision: Int = 0;
    why: String = "";
}
topic TransitionAnswered { payload: TransitionAnswer; subject: "dna.transition.answered"; keyed_by key; }

// Upward-only signals (child -> supersystem).
type Pressure { source: String = ""; what: String = ""; count: Int = 0; }
topic PressureRaised { payload: Pressure; subject: "dna.pressure.raised"; }

// GH #689: `request` is the id of the `concern.requested` row this came
// from, "" when it was raised live. A concern's entity is its source, so
// several concerns share one entity and only this id tells the host which
// request an answer answered.
type Concern { source: String = ""; what: String = ""; severity: Int = 0; request: String = ""; }
topic ConcernRaised { payload: Concern; subject: "dna.concern.raised"; }

// What a concern row carries, written as one object rather than as prose
// with a marker appended (GH #689, second review). A concern's text is
// whatever a worker wrote, and text that looks like metadata must not be
// read as metadata: with a marker appended, a concern reading
// `observed [request c1] in a log` answered request c1. Here the text is
// one escaped string field among others, and the reader asks for the
// `request` member of the object — the JSON cursor walks the object's own
// members and never looks inside a string value, so `[request c1]` in the
// text is text.
//
// Rows written before this rule are prose and carry no object; every
// reader below answers "" or 0 for them, and the host matches those by
// counting, as it did before ids existed.
fn concern_body(what: String, severity: Int, occurrence: Int, request: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("what", what);
    b.int_field("severity", severity);
    b.int_field("occurrence", occurrence);
    b.string_field("request", request);
    b.end_object();
    return b.result();
}

// Why a concern under an id already used was refused, as an object, so
// the refusal is that request's answer and can be found by its id.
fn concern_refusal_body(why: String, request: String) -> String {
    let b = std::json::Builder { };
    b.begin_object();
    b.string_field("why", why);
    b.string_field("request", request);
    b.end_object();
    return b.result();
}

fn request_named(body: String) -> String {
    return std::json::find_string_field(body, "request");
}

fn concern_what(body: String) -> String {
    return std::json::find_string_field(body, "what");
}

fn concern_severity(body: String) -> Int {
    return std::json::find_int_field(body, "severity");
}

// Whether a recorded concern row carries the same concern as this one:
// the whole payload a request is allowed to carry, not a prefix of its
// display text. One id used for a second, different concern — other
// words, or the same words at another severity — is a conflict.
fn same_concern(body: String, what: String, severity: Int) -> Bool {
    return concern_what(body) == what && concern_severity(body) == severity;
}

// A person proposes a practice for the whole organization (GH #602): a
// named text the Board ratifies, with who proposed it and what prompted it.
type PracticeRequest {
    request_id: String = "";
    name: String = "";
    text: String = "";
    by: String = "";
    because: String = "";
    supersedes: String = "";
}
topic PracticeRequested { payload: PracticeRequest; subject: "dna.practice.requested"; }

// A scoped native command asks the Body to propose a generic Knowledge node.
// Admission supplies the exact candidate and binding scope; Review still owns
// adoption. request_id is the command's durable identity, not a graph node ID.
type KnowledgeNodeRequest {
    request_id: String = "";
    operation: String = "";
    kind: String = "";
    name: String = "";
    text: String = "";
    author: String = "";
    target: String = "";
    supersedes: String = "";
    by: String = "";
    because: String = "";
    candidate_digest: String = "";
}
topic KnowledgeNodeRequested { payload: KnowledgeNodeRequest; subject: "dna.knowledge.node.requested"; }

// One reviewed change to an existing item's exact locus binding. The scoped
// command and captured grant are distinct from the authoring locus.
type KnowledgeBindingRequest {
    application_id: String = ""; request_id: String = "";
    command_fingerprint: String = ""; authority: String = ""; authority_basis: String = "";
    operation: String = ""; idea_id: String = ""; binding_id: String = "";
    author: String = ""; target: String = ""; by: String = ""; because: String = "";
    binding_basis: String = ""; candidate_digest: String = "";
}
topic KnowledgeBindingRequested { payload: KnowledgeBindingRequest; subject: "dna.knowledge.binding.requested"; }

// One exact directed relationship change under an independently settled Review.
type KnowledgeEdgeRequest {
    application_id: String = "";
    request_id: String = "";
    command_fingerprint: String = "";
    authority: String = "";
    authority_basis: String = "";
    operation: String = "";
    edge_id: String = "";
    from_id: String = "";
    to_id: String = "";
    rel: String = "";
    by: String = "";
    because: String = "";
    edge_basis: String = "";
    candidate_digest: String = "";
}
topic KnowledgeEdgeRequested { payload: KnowledgeEdgeRequest; subject: "dna.knowledge.edge.requested"; }

// The durable Organization source request is re-read by exact identity. Large
// prepared source and retained dependency metadata never travel in argv.
type OrganizationSourceTrigger { request_id: String = ""; }
topic OrganizationSourceRequested { payload: OrganizationSourceTrigger; subject: "dna.organization.source.requested"; }

// Review requests and verdicts cross the membrane (a human answers).
type ReviewRequest {
    review_id: String = "";
    question: String = "";
    subject_digest: String = ""; // exact candidate under review (TOCTOU pin)
    required_authority: String = "";
    // GH #566 F2: what a position deciding it needs — the mutation, its
    // class and disposition under the grant, the base to diff from, the
    // receipts (by digest) and the evidence line
    mutation_id: String = "";
    change_class: String = "";
    seed: String = ""; // the seed the change edits ("" = the genome's)
    disposition: String = "";
    base_commit: String = "";
    diff_text: String = "";
    evidence: String = "";
    magnitude: String = "";
}
topic ReviewRequested { payload: ReviewRequest; subject: "dna.review.requested"; }

type Verdict {
    command_id: String = ""; // durable caller-scoped admission, empty for legacy verdicts
    review_id: String = "";
    subject_digest: String = ""; // must equal the request's, or the verdict is refused
    verdict: String = ""; // "approve" | "revise" | "reject" | "abstain"
    reviewer: String = "";
    authority: String = ""; // the authority the reviewer claims
    comment: String = "";
}
topic ReviewVerdict { payload: Verdict; subject: "dna.review.verdict"; keyed_by review_id; }

// A Review settled (or refused a verdict): the owning Review announces
// it, the assembly journals it. The decision stays with the Review;
// this is the record of it (GH #528 `hale dna status`).
type ReviewSettlement {
    command_id: String = ""; // the exact review.command_decided that precedes this notification
    review_id: String = "";
    outcome: String = ""; // "approve" | "revise" | "reject" | "" when a verdict was refused
    decided_by: String = "";
    refusal: String = ""; // non-empty when a verdict was refused, with the reason
    comment: String = ""; // the deciding verdict's comment: a person's note, a model's reasoning (GH #566 F7)
    // A settled approval approved AGAIN by a verdict the Review admitted
    // in full — digest, authority, independence — so an approved
    // candidate that never applied can be applied. Never set for any
    // other verdict at a settled Review: those are refused.
    reapproval: Bool = false;
}
topic ReviewSettled { payload: ReviewSettlement; subject: "dna.review.settled"; }

// Work routed to the assembly-owned WorkSystem (F.3/F.4/F.5 in
// dna/FRICTION.md: a dynamic child cannot be handed an assembly
// implementation, so the implementations own the Attempts and the
// bus carries the request and the settlement, keyed by work id).
topic WorkRequested { payload: WorkRequest; subject: "dna.work.requested"; }

// GH #596 L: an ask, before it becomes work — the leader says what it
// is. The assembly asks; the leader answers with a plan that only
// splits and classifies, never widens; the assembly journals it as
// `task.planned` and proceeds under the class and target it names.
type PlanRequest {
    org: String = "org"; // keys the exchange with this organism's leader
    task_id: String = "";
    work_id: String = "";
    objective: String = "";
    target: String = "";
    requires: String = "";
    data_class: String = "internal";
}
type Plan {
    org: String = "org";
    task_id: String = "";
    work_id: String = "";
    kind: String = "appendage"; // "organism" | "appendage" | "product" | "person" (not a software change)
    change_class: String = "application";
    target: String = "";
    count: Int = 1; // one change, or several
    narrative: String = "";
    package: String = ""; // the knowledge package the plan read ("" = none)
    by: String = "";
    assignee: String = ""; // who does it, when kind is person (GH #604 rule 4)
    obligation: String = ""; // the class of obligation a person's job discharges (GH #616)
    parsed: Bool = false; // the model's answer named a kind and a class; else the defaults stand
}
topic PlanRequested { payload: PlanRequest; subject: "dna.plan.requested"; keyed_by org; }

// GH #596 O: the optimize pass. On a cadence the org chart sets, the
// substrate reads the record's structural signals and asks the
// leader to walk the machinery, not the work; the leader answers with
// one small proposal or none, and the substrate journals `org.reviewed`
// either way. "If the state is clean, say so."
type OptimizeRequest {
    org: String = "org";
    signals: String = "";
}
type OrgReview {
    org: String = "org";
    proposal: String = ""; // "" = clean
    narrative: String = "";
    package: String = "";
    by: String = "";
}
// The parent supplies a clock; the organism processes it on the same
// owner queue as incoming work. A tick may refresh the journal, whose
// cached view must be complete before another handler reads or appends.
type TickRequest { org: String = "org"; now: Int = 0; }
topic TickRequested { payload: TickRequest; subject: "dna.tick.requested"; keyed_by org; }

topic OptimizeRequested { payload: OptimizeRequest; subject: "dna.optimize.requested"; keyed_by org; }
topic OrgReviewed { payload: OrgReview; subject: "dna.org.reviewed"; keyed_by org; }
topic TaskPlanned { payload: Plan; subject: "dna.task.planned"; keyed_by org; }

type WorkSettlement {
    work_id: String = "";
    disposition: String = "";
    result: String = "";
    attempts: Int = 0;
    history: String = ""; // "a0:human:declined a1:agent:done "
}
topic WorkDone { payload: WorkSettlement; subject: "dna.work.done"; keyed_by work_id; }

// A recorded model call (inside an Attempt; never a Work of its own):
// the evidence list from #521 comment 1. Published by the backend
// that made the call on `ModelCalled`; the assembly journals it.
type ModelEvidence {
    attempt_id: String = "";
    adapter: String = ""; // "openai-chat" | "local" | "fake"
    backend: String = ""; // the router-facing name ("quick", "deep", "private")
    endpoint: String = ""; // where the prompt went (never the credential)
    credential: String = ""; // the credential's fingerprint (a correlation handle), or ""
    requested_model: String = "";
    reported_model: String = ""; // what the endpoint said it ran
    params: String = ""; // decoding knobs as sent, "temperature=0.0 max_tokens=512"
    prompt_digest: String = "";
    context_digest: String = "";
    // GH #611: the prompt and the context as sent. The substrate files
    // them as receipts under the two digests above (a customer-class
    // call stores neither); the `model.called` row carries only the
    // digests.
    prompt: String = "";
    context: String = "";
    knowledge_bindings: String = ""; // ids of the bindings the context was assembled from
    tool_grant: String = ""; // tools offered on this call, "" when none
    response_digest: String = "";
    artifact_digest: String = ""; // digest of what the attempt produced from it, when known
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    elapsed: String = ""; // wall time of the call, as a Duration renders
    cost_micros: Int = 0;
    validation: String = ""; // what was checked on the response ("json", "schema:X", "")
    retry_of: String = ""; // the previous call in this attempt this one retries, or ""
    data_class: String = "";
    ok: Bool = false;
    refused: String = "";
}
topic ModelCalled { payload: ModelEvidence; subject: "dna.model.called"; }

// GH #529 D6: what became of the expression after an apply. The host
// (`hale dna run`) rebuilds and restarts on the organism's request,
// watches the observation window, and reports back on the membrane;
// the organism decides whether the Mutation is retained or rolled back.
type Observation {
    mutation_id: String = "";
    outcome: String = ""; // "healthy" | "crashed" | "build_failed"
    model_hash: String = ""; // the shape hash the restarted expression reports
    detail: String = "";
}
topic ExpressionObserved { payload: Observation; subject: "dna.expression.observed"; }
